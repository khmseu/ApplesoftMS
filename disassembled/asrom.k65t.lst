F1D4:                                                                                 ; --------------------------------
F1D4:                                                                                 ; --------------------------------
F1D4:                                                                                 ; "Call" statement
F1D4:                          
F1D4:                                                                                 ; Effectively performs a "jsr" to the specified
F1D4:                                                                                 ; Address, with the following register contents:
F1D4:                                                                                 ; (A,y) = call address
F1D4:                                                                                 ; (X)   = $9D
F1D4:                          
F1D4:                                                                                 ; The called routine can return with "rts",
F1D4:                                                                                 ; And applesoft will continue with the next
F1D4:                                                                                 ; Statement.
F1D4:                                                                                 ; --------------------------------
F1D4: 20 67 dd                 AS_CALL:              JSR   AS_FRMNUM                  ; Evaluate expression for call address
F1D7: 20 51 e7                                       JSR   AS_GETADR                  ; Convert expression to 16-bit integer
F1DA: 6c 50 00                                       JMP   (AS_LINNUM)                ; In linnum, and jump there.
F1DD:                                                                                 ; --------------------------------
F1DD:                                                                                 ; "In#" statement
F1DD:                          
F1DD:                                                                                 ; Note:  no check for valid slot #, as long
F1DD:                                                                                 ; As value is < 256 it is accepted.
F1DD:                                                                                 ; Monitor masks value to 4 bits (0-15).
F1DD:                                                                                 ; --------------------------------
F1DD:                          AS_IN_NUMBER:
F1DD: 20 f7 e6                                       JSR   AS_GETBYT                  ; Get slot number in x-reg
F1E0: 8a                                             TXA                              ; Monitor will install in vector
F1E1: 4c 8a fe                                       JMP   MON_INPORT                 ; At $38,39.
F1E4:                                                                                 ; --------------------------------
F1E4:                                                                                 ; "Pr#" statement
F1E4:                          
F1E4:                                                                                 ; Note:  no check for valid slot #, as long
F1E4:                                                                                 ; As value is < 256 it is accepted.
F1E4:                                                                                 ; Monitor masks value to 4 bits (0-15).
F1E4:                                                                                 ; --------------------------------
F1E4:                          AS_PR_NUMBER:
F1E4: 20 f7 e6                                       JSR   AS_GETBYT                  ; Get slot number in x-reg
F1E7: 8a                                             TXA                              ; Monitor will install in vector
F1E8: 4c 94 fe                                       JMP   MON_OUTPORT                ; At $36,37
F1EB:                                                                                 ; --------------------------------
F1EB:                                                                                 ; Get two values < 48, with comma separator
F1EB:                          
F1EB:                                                                                 ; Called for "plot x,y"
F1EB:                                                                                 ; And "hlin a,b at y"
F1EB:                                                                                 ; And "vlin a,b at x"
F1EB:                          
F1EB:                                                                                 ; --------------------------------
F1EB:                          AS_PLOTFNS:
F1EB: 20 f7 e6                                       JSR   AS_GETBYT                  ; Get first value in x-reg
F1EE: e0 30                                          CPX   #48                        ; Must be < 48
F1F0: b0 05               F205                       BCS   AS_GOERR                   ; Too large
F1F2: 86 f0                                          STX   AS_FIRST                   ; Save first value
F1F4: a9 2c                                          LDA   #"," & %01111111           ; Must have a comma
F1F6: 20 bf de                                       JSR   AS_SYNCHR
F1F9: 20 f7 e6                                       JSR   AS_GETBYT                  ; Get second value in x-reg
F1FC: e0 30                                          CPX   #48                        ; Must be < 48
