F10A:                                                                                 ; Cornelis bongers described several improvements
F10A:                                                                                 ; To chrget in micro magazine or call a.p.p.l.e.
F10A:                                                                                 ; (I don't remember which or exactly when)
F10A:                                                                                 ; --------------------------------
F10A:                          AS_GENERIC_CHRGET:
F10A: e6 b8                                          INC   AS_TXTPTR
F10C: d0 10               F110                       BNE   AS_L_GENERIC_CHRGET_1
F10E: e6 b9                                          INC   AS_TXTPTR + 1
F110: ad 60 ea                 AS_L_GENERIC_CHRGET_1: LDA   $EA60                      ; <<< Actual address filled in later >>>
F113: c9 3a                                          CMP   #":" & %01111111           ; Eos, also top of numeric range
F115: b0 21               F121                       BCS   AS_L_GENERIC_CHRGET_2      ; Not number, might be eos
F117: c9 20                                          CMP   #" " & %01111111           ; Ignore blanks
F119: f0 0a               F10A                       BEQ   AS_GENERIC_CHRGET
F11B: 38                                             SEC                              ; Test for numeric range in way that
F11C: e9 30                                          SBC   #"0" & %01111111           ; Clears carry if char is digit
F11E: 38                                             SEC                              ; And leaves char in a-reg
F11F: e9 d0                                          SBC   #$D0
F121: 60                       AS_L_GENERIC_CHRGET_2: RTS
