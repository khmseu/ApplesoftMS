D365:                                                                                 ; --------------------------------
D365:                                                                                 ; Called by "next" and "for" to scan through
D365:                                                                                 ; The stack for a frame with the same variable.
D365:                          
D365:                                                                                 ; (Forpnt) = address of variable if "for" or "next"
D365:                                                                                 ; = $Xxff if called from "return"
D365:                                                                                 ; <<< Bug: should be $FFxx >>>
D365:                          
D365:                                                                                 ; Returns .ne. if variable not found,
D365:                                                                                 ; (X) = stack pntr after skipping all frames
D365:                          
D365:                                                                                 ; Equ. if found
D365:                                                                                 ; (X) = stack pntr of frame found
D365:                                                                                 ; --------------------------------
D365:                          AS_GTFORPNT:
D365: ba                                             TSX
D366: e8                                             INX
D367: e8                                             INX
D368: e8                                             INX
D369: e8                                             INX
D36A: bd 01 01                 AS_L_GTFORPNT_1:      LDA   AS_STACK + 1,X             ; "For" frame here?
D36D: c9 81                                          CMP   #AS_TOKEN_FOR
D36F: d0 92               D392                       BNE   AS_L_GTFORPNT_4            ; No
D371: a5 86                                          LDA   AS_FORPNT + 1              ; Yes -- "next" with no variable?
D373: d0 7f               D37F                       BNE   AS_L_GTFORPNT_2            ; No, variable specified
D375: bd 02 01                                       LDA   AS_STACK + 2,X             ; Yes, so use this frame
D378: 85 85                                          STA   AS_FORPNT
D37A: bd 03 01                                       LDA   AS_STACK + 3,X
D37D: 85 86                                          STA   AS_FORPNT + 1
D37F: dd 03 01                 AS_L_GTFORPNT_2:      CMP   AS_STACK + 3,X             ; Is variable in this frame?

Page 21
--------------------------------------------------------------------------------
D382: d0 8b               D38B                       BNE   AS_L_GTFORPNT_3            ; No
D384: a5 85                                          LDA   AS_FORPNT                  ; Look at 2nd byte too
D386: dd 02 01                                       CMP   AS_STACK + 2,X             ; Same variable?
D389: f0 92               D392                       BEQ   AS_L_GTFORPNT_4            ; Yes
D38B: 8a                       AS_L_GTFORPNT_3:      TXA                              ; No, so try next frame (if any)
D38C: 18                                             CLC                              ; 18 Bytes per frame
D38D: 69 12                                          ADC   #18
D38F: aa                                             TAX
D390: d0 6a               D36A                       BNE   AS_L_GTFORPNT_1            ; ...Always?
D392: 60                       AS_L_GTFORPNT_4:      RTS
D393:                                                                                 ; --------------------------------
D393:                                                                                 ; Move block of memory up
D393:                          
D393:                                                                                 ; On entry:
D393:                                                                                 ; (Y,a) = (highds) = destination end+1
D393:                                                                                 ; (Lowtr) = lowest address of source
D393:                                                                                 ; (Hightr) = highest source address+1
D393:                                                                                 ; --------------------------------
D393: 20 e3 d3                 AS_BLTU:              JSR   AS_REASON                  ; Be sure (y,a) < fretop
D396: 85 6d                                          STA   AS_STREND                  ; New top of array storage
D398: 84 6e                                          STY   AS_STREND + 1
D39A: 38                       AS_BLTU2:             SEC
D39B: a5 96                                          LDA   AS_HIGHTR                  ; Compute # of bytes to be moved
D39D: e5 9b                                          SBC   AS_LOWTR                   ; (From lowtr thru hightr-1)
D39F: 85 5e                                          STA   AS_INDEX                   ; Partial page amount
D3A1: a8                                             TAY
D3A2: a5 97                                          LDA   AS_HIGHTR + 1
D3A4: e5 9c                                          SBC   AS_LOWTR + 1
D3A6: aa                                             TAX                              ; # Of whole pages in x-reg
D3A7: e8                                             INX
D3A8: 98                                             TYA                              ; # Bytes in partial page
D3A9: f0 ce               D3CE                       BEQ   AS_L_BLTU2_4               ; No partial page
D3AB: a5 96                                          LDA   AS_HIGHTR                  ; Back up hightr # bytes in partial page
D3AD: 38                                             SEC
D3AE: e5 5e                                          SBC   AS_INDEX
D3B0: 85 96                                          STA   AS_HIGHTR
D3B2: b0 b7               D3B7                       BCS   AS_L_BLTU2_1
D3B4: c6 97                                          DEC   AS_HIGHTR + 1
D3B6: 38                                             SEC
D3B7: a5 94                    AS_L_BLTU2_1:         LDA   AS_HIGHDS                  ; Back up highds # bytes in partial page
D3B9: e5 5e                                          SBC   AS_INDEX
D3BB: 85 94                                          STA   AS_HIGHDS
D3BD: b0 c7               D3C7                       BCS   AS_L_BLTU2_3
D3BF: c6 95                                          DEC   AS_HIGHDS + 1
D3C1: 90 c7               D3C7                       BCC   AS_L_BLTU2_3               ; ...Always
D3C3: b1 96                    AS_L_BLTU2_2:         LDA   (AS_HIGHTR),Y              ; Move the bytes
D3C5: 91 94                                          STA   (AS_HIGHDS),Y
