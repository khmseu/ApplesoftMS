E765: 48                                             PHA
E766: a5 51                                          LDA   MS_Z_LINNUM + 1
E768: 48                                             PHA
E769: 20 51 e7                                       JSR   AS_GETADR                  ; GET ADDRESS PEEKING AT
E76C: a0 00                                          LDY   #0
E76E: b1 50                                          LDA   (MS_Z_LINNUM),Y              ; TAKE A QUICK LOOK

