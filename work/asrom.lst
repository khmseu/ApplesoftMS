E72A: b1 60                                          LDA   (AS_DEST),Y                ; ON STACK
E72C: 48                                             PHA
E72D: a9 00                                          LDA   #0                         ; AND STORE $00 IN ITS PLACE
E72F: 91 60                                          STA   (AS_DEST),Y
E731:                                                                                 ; <<< THAT CAUSES A BUG IF HIMEM = $BFFF, >>>
E731:                                                                                 ; <<< BECAUSE STORING $00 AT $C000 IS NO  >>>
E731:                                                                                 ; <<< USE; $C000 WILL ALWAYS BE LAST CHAR >>>
E731:                                                                                 ; <<< TYPED, SO FIN WON'T TERMINATE UNTIL >>>
E731:                                                                                 ; <<< IT SEES A ZERO AT $C010!            >>>
E731: 20 b7 00                                       JSR   MS_Z_CHRGOT                  ; PRIME THE PUMP
E734: 20 49 ec                                       JSR   AS_FIN                     ; EVALUATE STRING
E737: 68                                             PLA                              ; GET BYTE THAT SHOULD FOLLOW STRING
E738: a0 00                                          LDY   #0                         ; AND PUT IT BACK
E73A: 91 60                                          STA   (AS_DEST),Y
E73C:                                                                                 ; RESTORE TXTPTR
