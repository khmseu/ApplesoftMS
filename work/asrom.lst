F205:                                                                                 ; --------------------------------
F205: 4c 98 e1                 AS_GOERR:             JMP   AS_IQERR                   ; ILLEGAL QUANTITY ERROR
F208:                                                                                 ; --------------------------------
F208:                                                                                 ; GET "A,B AT C" VALUES FOR "HLIN" AND "VLIN"
F208:                          
F208:                                                                                 ; PUT SMALLER OF (A,B) IN FIRST,
F208:                                                                                 ; AND LARGER  OF (A,B) IN H2 AND V2.
F208:                                                                                 ; RETURN WITH (X) = C-VALUE.
F208:                                                                                 ; --------------------------------
