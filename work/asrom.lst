D392: 60                       AS_L_GTFORPNT_4:      RTS
D393:                                                                                 ; --------------------------------
D393:                                                                                 ; Move block of memory up
D393:                          
D393:                                                                                 ; On entry:
D393:                                                                                 ; (Y,a) = (highds) = destination end+1
D393:                                                                                 ; (Lowtr) = lowest address of source
D393:                                                                                 ; (Hightr) = highest source address+1
D393:                                                                                 ; --------------------------------
D393: 20 e3 d3                 AS_BLTU:              JSR   AS_REASON                  ; Be sure (y,a) < fretop
D396: 85 6d                                          STA   MS_Z_006D_STREND                  ; New top of array storage
D398: 84 6e                                          STY   MS_Z_006D_STREND + 1
D39A: 38                       AS_BLTU2:             SEC
D39B: a5 96                                          LDA   MS_Z_0096_HIGHTR                  ; Compute # of bytes to be moved
D39D: e5 9b                                          SBC   MS_Z_009B_LOWTR                   ; (From lowtr thru hightr-1)
D39F: 85 5e                                          STA   MS_Z_005E_INDEX                   ; Partial page amount
D3A1: a8                                             TAY
D3A2: a5 97                                          LDA   MS_Z_0096_HIGHTR + 1
D3A4: e5 9c                                          SBC   MS_Z_009B_LOWTR + 1
D3A6: aa                                             TAX                              ; # Of whole pages in x-reg
D3A7: e8                                             INX
D3A8: 98                                             TYA                              ; # Bytes in partial page
D3A9: f0 ce               D3CE                       BEQ   AS_L_BLTU2_4               ; No partial page
D3AB: a5 96                                          LDA   MS_Z_0096_HIGHTR                  ; Back up hightr # bytes in partial page
D3AD: 38                                             SEC
D3AE: e5 5e                                          SBC   MS_Z_005E_INDEX
D3B0: 85 96                                          STA   MS_Z_0096_HIGHTR
D3B2: b0 b7               D3B7                       BCS   AS_L_BLTU2_1
