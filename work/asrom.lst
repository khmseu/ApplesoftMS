E5F1: 68                                             PLA                              ; NO, FINISHED.  GET LENGTH
E5F2: 18                       AS_L_MOVSTR_1_2:      CLC                              ; AND ADD TO FRESPC, SO
E5F3: 65 71                                          ADC   MS_Z_FRESPC                  ; FRESPC POINTS TO NEXT HIGHER
