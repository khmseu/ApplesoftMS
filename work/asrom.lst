F114: c9 3a                                          CMP   #":" & %01111111           ; Eos, also top of numeric range
F116: b0 22               F122                       BCS   AS_L_GENERIC_CHRGET_2      ; Not number, might be eos
F118: c9 20                                          CMP   #" " & %01111111           ; Ignore blanks
F11A: f0 0b               F10B                       BEQ   AS_GENERIC_CHRGET
F11C: 38                                             SEC                              ; Test for numeric range in way that
F11D: e9 30                                          SBC   #"0" & %01111111           ; Clears carry if char is digit
F11F: 38                                             SEC                              ; And leaves char in a-reg
F120: e9 d0                                          SBC   #$D0
F122: 60                       AS_L_GENERIC_CHRGET_2: RTS
