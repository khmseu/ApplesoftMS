F1EF: e0 30                                          CPX   #48                        ; Must be < 48
F1F1: b0 06               F206                       BCS   AS_GOERR                   ; Too large
F1F3: 86 f0                                          STX   AS_FIRST                   ; Save first value
F1F5: a9 2c                                          LDA   #"," & %01111111           ; Must have a comma
F1F7: 20 c0 de                                       JSR   AS_SYNCHR
F1FA: 20 f8 e6                                       JSR   AS_GETBYT                  ; Get second value in x-reg
F1FD: e0 30                                          CPX   #48                        ; Must be < 48
F1FF: b0 06               F206                       BCS   AS_GOERR                   ; Too large

