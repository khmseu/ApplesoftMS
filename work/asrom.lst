E7A3: 4c bd e7                                       JMP   AS_FADD
E7A6:                                                                                 ; --------------------------------
E7A6:                                                                                 ; FAC = (Y,A) - FAC
E7A6:                                                                                 ; --------------------------------
E7A6: 20 e2 e9                 AS_FSUB:              JSR   AS_LOAD_ARG_FROM_YA
E7A9:                                                                                 ; --------------------------------
E7A9:                                                                                 ; FAC = ARG - FAC
E7A9:                                                                                 ; --------------------------------
E7A9: a5 a2                    MS_FSUBT:             LDA   MS_Z_FACSGN                ; COMPLEMENT FAC AND ADD
E7AB: 49 ff                                          EOR   #$FF
