EBF1:                                                                                 ; QUICK INTEGER FUNCTION
EBF1:                          
EBF1:                                                                                 ; CONVERTS FP VALUE IN FAC TO INTEGER VALUE
EBF1:                                                                                 ; IN FAC+1...FAC+4, BY SHIFTING RIGHT WITH SIGN
EBF1:                                                                                 ; EXTENSION UNTIL FRACTIONAL BITS ARE OUT.
EBF1:                          
EBF1:                                                                                 ; THIS SUBROUTINE ASSUMES THE EXPONENT < 32.
EBF1:                                                                                 ; --------------------------------
EBF1: a5 9d                    AS_QINT:              LDA   MS_Z_FAC                     ; LOOK AT FAC EXPONENT
EBF3: f0 3f               EC3F                       BEQ   AS_QINT_3                  ; FAC=0, SO FINISHED
EBF5: 38                                             SEC                              ; GET -(NUMBER OF FRACTIONAL BITS)
EBF6: e9 a0                                          SBC   #$A0                       ; IN A-REG FOR SHIFT COUNT
EBF8: 24 a2                                          BIT   MS_Z_FACSGN                ; CHECK SIGN OF FAC
EBFA: 10 05               EC05                       BPL   AS_L_QINT_1                ; POSITIVE, CONTINUE
EBFC: aa                                             TAX                              ; NEGATIVE, SO COMPLEMENT MANTISSA
EBFD: a9 ff                                          LDA   #$FF                       ; AND SET SIGN EXTENSION FOR SHIFT
EBFF: 85 a4                                          STA   AS_SHIFT_SIGN_EXT
EC01: 20 a3 e8                                       JSR   AS_COMPLEMENT_FAC_MANTISSA
EC04: 8a                                             TXA                              ; RESTORE BIT COUNT TO A-REG
EC05: a2 9d                    AS_L_QINT_1:          LDX   #MS_Z_FAC                    ; POINT SHIFT SUBROUTINE AT FAC
EC07: c9 f9                                          CMP   #$F9                       ; MORE THAN 7 BITS TO SHIFT?
EC09: 10 11               EC11                       BPL   AS_QINT_2                  ; NO, SHORT SHIFT
EC0B: 20 ef e8                                       JSR   AS_SHIFT_RIGHT             ; YES, USE GENERAL ROUTINE
EC0E: 84 a4                                          STY   AS_SHIFT_SIGN_EXT          ; Y=0, CLEAR SIGN EXTENSION
EC10: 60                       AS_RTS_16:            RTS
EC11:                                                                                 ; --------------------------------
EC11: a8                       AS_QINT_2:            TAY                              ; SAVE SHIFT COUNT

