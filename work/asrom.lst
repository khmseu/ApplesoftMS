E786: 86 85                                          STX   MS_Z_FORPNT                  ; SAVE MASK
E788: a2 00                                          LDX   #0
E78A: 20 b7 00                                       JSR   MS_Z_CHRGOT                  ; ANOTHER PARAMETER?
E78D: f0 92               E792                       BEQ   AS_L_WAIT_1                ; NO, USE $00 FOR EXCLUSIVE-OR
E78F: 20 4b e7                                       JSR   AS_COMBYTE                 ; GET XOR-MASK
