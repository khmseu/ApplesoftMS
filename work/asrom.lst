E5E8: 48                                             PHA                              ; SAVE LENGTH ON STACK
E5E9: 88                       AS_L_MOVSTR_1_1:      DEY                              ; MOVE BYTES FROM (INDEX) TO (FRESPC)
E5EA: b1 5e                                          LDA   (MS_Z_INDEX),Y
