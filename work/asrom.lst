EF5B:                                                                                 ; ODD POLYNOMIAL SUBROUTINE
EF5B:                          
EF5B:                                                                                 ; F(X) = X * P(X^2)
EF5B:                          
EF5B:                                                                                 ; WHERE:  X IS VALUE IN FAC
EF5B:                                                                                 ; Y,A POINTS AT COEFFICIENT TABLE
EF5B:                                                                                 ; FIRST BYTE OF COEFF. TABLE IS N
EF5B:                                                                                 ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
EF5B:                          
EF5B:                                                                                 ; P(X^2) COMPUTED USING NORMAL POLYNOMIAL SUBROUTINE
EF5B:                          
EF5B:                                                                                 ; --------------------------------
EF5B:                          AS_POLYNOMIAL_ODD:
EF5B: 85 ad                                          STA   AS_SERPNT                  ; SAVE ADDRESS OF COEFFICIENT TABLE
EF5D: 84 ae                                          STY   AS_SERPNT + 1
EF5F: 20 20 eb                                       JSR   AS_STORE_FAC_IN_TEMP1_ROUNDED
EF62: a9 93                                          LDA   #MS_Z_TEMPF1                  ; Y=0 ALREADY, SO Y,A POINTS AT TEMP1
EF64: 20 7e e9                                       JSR   AS_FMULT                   ; FORM X^2
EF67: 20 75 ef                                       JSR   AS_SERMAIN                 ; DO SERIES IN X^2
EF6A: a9 93                                          LDA   #<MS_Z_TEMPF1                 ; GET X AGAIN
EF6C: a0 00                                          LDY   #>MS_Z_TEMPF1
EF6E: 4c 7e e9                                       JMP   AS_FMULT                   ; MULTIPLY X BY P(X^2) AND EXIT

