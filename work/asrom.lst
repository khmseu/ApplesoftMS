E75C: a4 a1                                          LDY   MS_Z_FAC + 4
E75E: 84 50                                          STY   MS_Z_LINNUM                  ; TO LINNUM
E760: 85 51                                          STA   MS_Z_LINNUM + 1
E762: 60                                             RTS
