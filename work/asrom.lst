EF71:                                                                                 ; --------------------------------
EF71:                                                                                 ; NORMAL POLYNOMIAL SUBROUTINE
EF71:                          
EF71:                                                                                 ; P(X) = C(0)*X^N + C(1)*X^(N-1) + ... + C(N)
EF71:                          
EF71:                                                                                 ; WHERE:  X IS VALUE IN FAC
EF71:                                                                                 ; Y,A POINTS AT COEFFICIENT TABLE
EF71:                                                                                 ; FIRST BYTE OF COEFF. TABLE IS N
EF71:                                                                                 ; COEFFICIENTS FOLLOW, HIGHEST POWER FIRST
EF71:                          
EF71:                                                                                 ; --------------------------------
EF71:                          AS_POLYNOMIAL:
EF71: 85 ad                                          STA   AS_SERPNT                  ; POINTER TO COEFFICIENT TABLE
EF73: 84 ae                                          STY   AS_SERPNT + 1
EF75:                                                                                 ; --------------------------------
EF75:                          AS_SERMAIN:
EF75: 20 1d eb                                       JSR   AS_STORE_FAC_IN_TEMP2_ROUNDED
EF78: b1 ad                                          LDA   (AS_SERPNT),Y              ; GET N
EF7A: 85 a3                                          STA   AS_SERLEN                  ; SAVE N
EF7C: a4 ad                                          LDY   AS_SERPNT                  ; BUMP PNTR TO HIGHEST COEFFICIENT
EF7E: c8                                             INY                              ; AND GET PNTR INTO Y,A
EF7F: 98                                             TYA
EF80: d0 84               EF84                       BNE   AS_L_SERMAIN_1
EF82: e6 ae                                          INC   AS_SERPNT + 1
EF84: 85 ad                    AS_L_SERMAIN_1:       STA   AS_SERPNT
EF86: a4 ae                                          LDY   AS_SERPNT + 1
EF88: 20 7e e9                 AS_L_SERMAIN_2:       JSR   AS_FMULT                   ; ACCUMULATE SERIES TERMS
EF8B: a5 ad                                          LDA   AS_SERPNT                  ; BUMP PNTR TO NEXT COEFFICIENT
EF8D: a4 ae                                          LDY   AS_SERPNT + 1
EF8F: 18                                             CLC
EF90: 69 05                                          ADC   #5
EF92: 90 95               EF95                       BCC   AS_L_SERMAIN_3
EF94: c8                                             INY
EF95: 85 ad                    AS_L_SERMAIN_3:       STA   AS_SERPNT
