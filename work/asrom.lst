F1D5:                                                                                 ; --------------------------------
F1D5:                                                                                 ; --------------------------------
F1D5:                                                                                 ; "Call" statement
F1D5:                          
F1D5:                                                                                 ; Effectively performs a "jsr" to the specified
F1D5:                                                                                 ; Address, with the following register contents:
F1D5:                                                                                 ; (A,y) = call address
F1D5:                                                                                 ; (X)   = $9D
F1D5:                          
F1D5:                                                                                 ; The called routine can return with "rts",
F1D5:                                                                                 ; And applesoft will continue with the next
F1D5:                                                                                 ; Statement.
F1D5:                                                                                 ; --------------------------------
F1D5: 20 67 dd                 AS_CALL:              JSR   AS_FRMNUM                  ; Evaluate expression for call address
F1D8: 20 52 e7                                       JSR   AS_GETADR                  ; Convert expression to 16-bit integer
F1DB: 6c 50 00                                       JMP   (MS_Z_0050_LINNUM)                ; In linnum, and jump there.
F1DE:                                                                                 ; --------------------------------
F1DE:                                                                                 ; "In#" statement
F1DE:                          
F1DE:                                                                                 ; Note:  no check for valid slot #, as long
F1DE:                                                                                 ; As value is < 256 it is accepted.
F1DE:                                                                                 ; Monitor masks value to 4 bits (0-15).
F1DE:                                                                                 ; --------------------------------
F1DE:                          AS_IN_NUMBER:
F1DE: 20 f8 e6                                       JSR   AS_GETBYT                  ; Get slot number in x-reg
F1E1: 8a                                             TXA                              ; Monitor will install in vector
F1E2: 4c 8b fe                                       JMP   MON_INPORT                 ; At $38,39.
F1E5:                                                                                 ; --------------------------------
F1E5:                                                                                 ; "Pr#" statement
F1E5:                          
F1E5:                                                                                 ; Note:  no check for valid slot #, as long
F1E5:                                                                                 ; As value is < 256 it is accepted.
F1E5:                                                                                 ; Monitor masks value to 4 bits (0-15).
F1E5:                                                                                 ; --------------------------------
F1E5:                          AS_PR_NUMBER:
F1E5: 20 f8 e6                                       JSR   AS_GETBYT                  ; Get slot number in x-reg
F1E8: 8a                                             TXA                              ; Monitor will install in vector
F1E9: 4c 95 fe                                       JMP   MON_OUTPORT                ; At $36,37
F1EC:                                                                                 ; --------------------------------
F1EC:                                                                                 ; Get two values < 48, with comma separator
F1EC:                          
F1EC:                                                                                 ; Called for "plot x,y"
F1EC:                                                                                 ; And "hlin a,b at y"
F1EC:                                                                                 ; And "vlin a,b at x"
F1EC:                          
F1EC:                                                                                 ; --------------------------------
