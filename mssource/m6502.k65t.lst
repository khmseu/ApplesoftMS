0000:              
0000:                      .macro  ACRLF
0000:                      .byte   13
0000:                      .byte   10
0000:                      .endmacro
0000:                      .macro  SYNCHK, Q
0000:                      LDA     #\Q
0000:                      JSR     SYNCHR
0000:                      .endmacro
0000:                      .macro  DT, Q
0000:              IRPC	\Q,(IFDIF (\Q)("),(EXP "\Q"))
0000:                      .endmacro
0000:                      .macro  LDWD, WD
0000:                      LDA     \WD
0000:                      LDY     \WD + 1
0000:                      .endmacro
0000:                      .macro  LDWDI, WD
0000:                      LDA     #\WD & 0o377
0000:                      LDY     #\WD / 0o400
0000:                      .endmacro
0000:                      .macro  LDWX, WD
0000:                      LDA     \WD
0000:                      LDX     \WD + 1
0000:                      .endmacro
0000:                      .macro  LDWXI, WD
0000:                      LDA     #\WD & 0o377
0000:                      LDX     #\WD / 0o400
0000:                      .endmacro
0000:                      .macro  LDXY, WD
0000:                      LDX     \WD
0000:                      LDY     \WD + 1
0000:                      .endmacro
0000:                      .macro  LDXYI, WD
0000:                      LDX     #\WD & 0o377
0000:                      LDY     #\WD / 0o400
0000:                      .endmacro
0000:                      .macro  STWD, WD
0000:                      STA     \WD
0000:                      STY     \WD + 1
0000:                      .endmacro
0000:                      .macro  STWX, WD
0000:                      STA     \WD
0000:                      STX     \WD + 1

