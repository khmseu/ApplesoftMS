E245: a9 ff                LDA     #LOFBUF & 0o377
E247: a0 00                LDY     #LOFBUF / 0o400
E249:                      BEQA    STRLIT               ;SCAN IT AND TURN IT INTO A STRING.
E249: f0 5d   E25D         BEQ     STRLIT
E24B:              
E24B:              ; "STRINI" GET STRING SPACE FOR THE CREATION OF A STRING AND
E24B:              ; CREATES A DESCRIPTOR FOR IT IN "DSCTMP"*
E24B:              
E24B:              STRINI:
E24B:                      LDXY    FACMO                ;GET FACMO TO STORE IN DSCPNT.
E24B: a6 a4                LDX     FACMO
E24D: a4 a5                LDY     FACMO + 1
E24F:                      STXY    DSCPNT               ;RETAIN THE DESCRIPTOR POINTER.
E24F: 86 8f                STX     DSCPNT
E251: 84 90                STY     DSCPNT + 1
E253:              STRSPA:
E253: 20 ca e2             JSR     GETSPA               ;GET STRING SPACE.
E256:                      STXY    DSCTMP + 1           ;SAVE LOCATION.
E256: 86 a2                STX     DSCTMP + 1
E258: 84 a3                STY     DSCTMP + 1 + 1
E25A: 85 a1                STA     DSCTMP               ;SAVE LENGTH.
E25C: 60                   RTS                          ;ALL DONE.
E25D:              
E25D:              ; "STRLT2" TAKES THE STRING LITERAL WHOSE FIRST CHARACTER
E25D:              ; IS POINTED TO BY [Y,A] AND BUILDS A DESCRIPTOR FOR IT.
E25D:              ; THE DESCRIPTOR IS INITIALLY BUILT IN "DSCTMP", BUT "PUTNEW"
E25D:              ; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER
E25D:              ; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN
E25D:              ; ZERO THAT TERMINATE THE STRING SHOULD BE SET UP IN "CHARAC"
E25D:              ; AND "ENDCHR"* IF THE TERMINATOR IS A QUOTE, THE QUOTE IS SKIPPED
E25D:              ; OVER. LEADING QUOTES SHOULD BE SKIPPED BEFORE JSR. ON RETURN
E25D:              ; THE CHARACTER AFTER THE STRING LITERAL IS POINTED TO
E25D:              ; BY [STRNG2]*
E25D:              
E25D:              STRLIT:
E25D: a2 22                LDX     #34                  ;ASSUME STRING ENDS ON QUOTE.
E25F: 86 0d                STX     CHARAC
E261: 86 0e                STX     ENDCHR
E263:              STRLT2:
E263:                      STWD    STRNG1               ;SAVE POINTER TO STRING.
E263: 85 af                STA     STRNG1
E265: 84 b0                STY     STRNG1 + 1
E267:                      STWD    DSCTMP + 1           ;IN CASE NO STRCPY.
E267: 85 a2                STA     DSCTMP + 1
E269: 84 a3                STY     DSCTMP + 1 + 1
E26B: a0 ff                LDY     #255                 ;INITIALIZE CHARACTER COUNT.

