0000:         0000 TIME    =       0                    ;CAPABILITY TO SET AND READ A CLK.
0000:         0000 EXTIO   =       0                    ;EXTERNAL I/O.
0000:         0000 DISKO   =       0                    ;SAVE AND LOAD COMMANDS
0000:         0001 NULCMD  =       1                    ;FOR THE "NULL" COMMAND
0000:         0001 GETCMD  =       1
0000:         0001 RORSW   =       1
0000:         0001 ROMSW   =       1                    ;TELLS IF THIS IS ON ROM.
0000:         000E CLMWID  =       14
0000:         0001 LONGI   =       1                    ;LONG INITIALIZATION SWITCH.
0000:         01FF STKEND  =       511
0000:         0000 BUFPAG  =       0
0000:         0048 LINLEN  =       72                   ;TERMINAL LINE LENGTH.
0000:         0048 BUFLEN  =       72                   ;INPUT BUFFER SIZE.
