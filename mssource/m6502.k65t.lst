EE6B:                      .subttl SINE, COSINE AND TANGENT FUNCTIONS.
EE6B:                      .IF     KIMROM == 0
EE6B:                                                   ;Cosine function.
EE6B:                                                   ;Use COS(x)=SIN(x+pi/2)
EE6B:              COS:
EE6B:                      LDWDI   PI2                  ;Pntr to pi/2.
EE6B: a9 e7                LDA     #PI2 & 0o377
EE6D: a0 ee                LDY     #PI2 / 0o400
EE6F: 20 3f e6             JSR     FADD                 ;Add it in.
EE72:                                                   ;Fall into SIN.
EE72:              
EE72:                                                   ;Sine function.
EE72:                                                   ;Use identities to GET FAC in quadrants i or iv.
EE72:                                                   ;The FAC is divided by 2*pi and the integer part is ignored
EE72:                                                   ;Because SIN(x+2*pi)=SIN(x)* then the argument can be compared
EE72:                                                   ;With pi/2 by comparing the result of the division
EE72:                                                   ;With pi/2/(2*pi)=1/4.
EE72:                                                   ;Identities are then used to GET the result in quadrants
EE72:                                                   ;I or iv. an approximation polynomial is then used to
EE72:                                                   ;Compute SIN(x)*
EE72:              SIN:
EE72: 20 e4 e9             JSR     MOVAF
EE75:                      LDWDI   TWOPI                ;GET pntr to divisor.
EE75: a9 ec                LDA     #TWOPI & 0o377
EE77: a0 ee                LDY     #TWOPI / 0o400
EE79: a6 ae                LDX     ARGSGN               ;GET SIGN of result.
EE7B: 20 df e8             JSR     FDIVF
EE7E: 20 e4 e9             JSR     MOVAF                ;GET result into arg.
EE81: 20 a4 ea             JSR     INT                  ;Integerize FAC.
EE84:                      CLR     ARISGN               ;Always have the same SIGN.
EE84: a9 00                LDA     #0
EE86: 85 af                STA     ARISGN
EE88: 20 2a e6             JSR     FSUBT                ;Keep only the fractional part.
EE8B:                      LDWDI   FR4                  ;GET pntr to 1/4.
EE8B: a9 f1                LDA     #FR4 & 0o377
EE8D: a0 ee                LDY     #FR4 / 0o400
EE8F: 20 27 e6             JSR     FSUB                 ;Compute 1/4-FAC.
EE92: a5 a6                LDA     FACSGN               ;SAVE SIGN FOR later.
EE94: 48                   PHA
EE95: 10 a4   EEA4         BPL     SIN1                 ;First quadrant.
EE97: 20 20 e6             JSR     FADDH                ;Add 1/2 to FAC.
EE9A: a5 a6                LDA     FACSGN               ;SIGN is negative?
EE9C: 30 a7   EEA7         BMI     SIN2
EE9E:                      COM     TANSGN               ;Quadrants ii and iii come here.
EE9E: a5 16                LDA     TANSGN
EEA0: 49 ff                EOR     #0o377
EEA2: 85 16                STA     TANSGN
EEA4:              SIN1:
EEA4: 20 51 ed             JSR     NEGOP                ;IF positive, negate it.
EEA7:              SIN2:
EEA7:                      LDWDI   FR4                  ;Pointer to 1/4.
EEA7: a9 f1                LDA     #FR4 & 0o377
EEA9: a0 ee                LDY     #FR4 / 0o400
EEAB: 20 3f e6             JSR     FADD                 ;Add it in.
EEAE: 68                   PLA                          ;GET original quadrant.
EEAF: 10 b4   EEB4         BPL     SIN3
EEB1: 20 51 ed             JSR     NEGOP                ;IF negative, negate result.
EEB4:              SIN3:
EEB4:                      LDWDI   SINCON
EEB4: a9 f6                LDA     #SINCON & 0o377

