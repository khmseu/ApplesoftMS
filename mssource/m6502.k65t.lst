DFA8:              
DFA8:              ; FORMAT OF ARRAYS IN CORE.
DFA8:              
DFA8:              ; DESCRIPTOR:
DFA8:              ;	LOWBYTE = FIRST CHARACTER.
DFA8:              ;	HIGHBYTE = SECOND CHARACTER (200 BIT IS STRING FLAG)*
DFA8:              ; LENGTH OF ARRAY IN CORE IN BYTES (INCLUDES EVERYTHING)*
DFA8:              ; NUMBER OF DIMENSIONS.
DFA8:              ; FOR EACH DIMENSION STARTING WITH THE FIRST A LIST
DFA8:              ; (2 BYTES EACH) OF THE MAX INDICE+1
DFA8:              ; THE VALUES
DFA8:              
DFA8:              ISARY:
DFA8: a5 10                LDA     DIMFLG
