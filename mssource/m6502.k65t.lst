ED0E:                      .subttl EXPONENTIATION AND SQUARE ROOT FUNCTION.
ED0E:                                                   ;SQUARE ROOT FUNCTION --- SQR(A)
ED0E:                                                   ;USE SQR(X)=X^.5
ED0E:              SQR:
ED0E: 20 e4 e9             JSR     MOVAF                ;MOVE FAC INTO ARG.
ED11:                      LDWDI   FHALF
ED11: a9 e5                LDA     #FHALF & 0o377
ED13: a0 ec                LDY     #FHALF / 0o400
ED15: 20 7a e9             JSR     MOVFM                ;PUT MEMORY INTO FAC.
ED18:                                                   ;LAST THING FETCHED IS FACEXP. INTO ACCX.
ED18:              ;	JMP	FPWRT		;FALL INTO FPWRT.
ED18:              
ED18:                                                   ;EXPONENTIATION ---  X^Y.
ED18:                                                   ;N.B.  0^0=1
ED18:                                                   ;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
ED18:                                                   ;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
ED18:                                                   ;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
ED18:                                                   ;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
ED18:                                                   ;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
ED18:                                                   ;RETURNED BY EXP.
ED18:                                                   ;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X))*
ED18:              FPWRT:
ED18: f0 8a   ED8A         BEQ     EXP                  ;IF FAC=0, JUST EXPONENTIATE THAT.
ED1A: a5 a9                LDA     ARGEXP               ;IS X=0?
ED1C: d0 21   ED21         BNE     FPWRT1
ED1E: 4c d1 e6             JMP     ZEROF1               ;ZERO FAC.
ED21:              FPWRT1:
ED21:                      LDXYI   TEMPF3               ;SAVE FOR LATER IN A TEMP.
ED21: a2 8d                LDX     #TEMPF3 & 0o377
ED23: a0 00                LDY     #TEMPF3 / 0o400
ED25: 20 ac e9             JSR     MOVMF
ED28:                                                   ;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
ED28: a5 ae                LDA     ARGSGN
ED2A: 10 3b   ED3B         BPL     FPWR1                ;NO PROBLEMS IF X.GT.0.
ED2C: 20 a4 ea             JSR     INT                  ;INTEGERIZE THE FAC.
ED2F:                      LDWDI   TEMPF3               ;GET ADDR OF COMPERAND.
ED2F: a9 8d                LDA     #TEMPF3 & 0o377
ED31: a0 00                LDY     #TEMPF3 / 0o400
ED33: 20 33 ea             JSR     FCOMP                ;EQUAL?
ED36: d0 3b   ED3B         BNE     FPWR1                ;LEAVE X NEG. LOG WILL BLOW HIM OUT.
ED38:                                                   ;A=-1 AND Y IS IRRELEVANT.
ED38: 98                   TYA                          ;NEGATE X. MAKE POSITIVE.
ED39: a4 0d                LDY     INTEGR               ;GET EVENNESS.
ED3B:              FPWR1:
ED3B: 20 d6 e9             JSR     MOVFA1               ;ALTERNATE ENTRY POINT.
ED3E: 98                   TYA
ED3F: 48                   PHA                          ;SAVE EVENNESS FOR LATER.
ED40: 20 c2 e7             JSR     LOG                  ;FIND LOG.
ED43:                      LDWDI   TEMPF3               ;MULTIPLY FAC TIMES LOG(X)*
ED43: a9 8d                LDA     #TEMPF3 & 0o377
ED45: a0 00                LDY     #TEMPF3 / 0o400
ED47: 20 00 e8             JSR     FMULT
ED4A: 20 8a ed             JSR     EXP                  ;EXPONENTIATE THE FAC.
ED4D: 68                   PLA
ED4E: 4a                   LSR     A                    ;IS IT EVEN?
ED4F: 90 5b   ED5B         BCC     NEGRTS               ;YES. OR X.GT.0.
ED51:                                                   ;NEGATE THE NUMBER IN FAC.
ED51:              NEGOP:
ED51: a5 a1                LDA     FACEXP
ED53: f0 5b   ED5B         BEQ     NEGRTS

