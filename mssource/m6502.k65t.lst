DD9E:              ; NORMAL FUNCTIONS THAT RETURN STRING RESULTS
DD9E:              ; (E.G., CHR$) MUST POP OFF THAT RETURN ADDR AND
DD9E:              ; RETURN DIRECTLY TO "FRMEVL"*
DD9E:              
DD9E:              ; THE SO-CALLED "FUNNY" FUNCTIONS CAN TAKE MORE THAN ONE ARGUMENT
DD9E:              ; THE FIRST OF WHICH MUST BE STRING AND THE SECOND OF WHICH
DD9E:              ; MUST BE A NUMBER BETWEEN 0 AND 255.
DD9E:              ; THE CLOSED PARENTHESIS MUST BE CHECKED AND RETURN IS DIRECTLY
DD9E:              ; TO "FRMEVL" WITH THE TEXT PNTR POINTING BEYOND THE ")"*
DD9E:              ; THE POINTER TO THE DESCRIPTOR OF THE STRING ARGUMENT
DD9E:              ; IS STORED ON THE STACK UNDERNEATH THE VALUE OF THE
DD9E:              ; INTEGER ARGUMENT.
DD9E:              
DD9E: 20 56 dd             JSR     CHKOPN               ;CHECK FOR AN OPEN PARENTHESE
DDA1: 20 13 dc             JSR     FRMEVL               ;EAT OPEN PAREN AND FIRST ARG.
DDA4: 20 59 dd             JSR     CHKCOM               ;TWO ARGS SO COMMA MUST DELIMIT.
DDA7: 20 04 dc             JSR     CHKSTR               ;MAKE SURE FIRST WAS STRING.
DDAA: 68                   PLA                          ;GET FUNCTION NUMBER.
DDAB: aa                   TAX
DDAC:                      PSHWD   FACMO                ;SAVE POINTER AT STRING DESCRIPTOR
DDAC: a5 a5                LDA     FACMO + 1
DDAE: 48                   PHA
DDAF: a5 a4                LDA     FACMO
DDB1: 48                   PHA
DDB2: 8a                   TXA
DDB3: 48                   PHA                          ;RESAVE FUNCTION NUMBER.
DDB4:                                                   ;THIS MUST BE ON STACK SINCE RECURSIVE.
DDB4: 20 74 e5             JSR     GETBYT               ;[X]=VALUE OF FORMULA.
DDB7: 68                   PLA                          ;GET FUNCTION NUMBER.
DDB8: a8                   TAY
DDB9: 8a                   TXA
DDBA: 48                   PHA
DDBB: 4c c3 dd             JMP     FINGO                ;DISPATCH TO FUNCTION.
DDBE:              OKNORM:
DDBE: 20 4d dd             JSR     PARCHK               ;READ A FORMULA SURROUNDED BY PARENS.
DDC1: 68                   PLA                          ;GET DISPATCH FUNCTION.
DDC2: a8                   TAY
DDC3:              FINGO:
DDC3: b9 de cf             LDA     FUNDSP - 2 * ONEFUN + 256,Y ;MODIFY DISPATCH ADDRESS.
DDC6: 85 95                STA     JMPER + 1
DDC8: b9 df cf             LDA     FUNDSP - 2 * ONEFUN + 257,Y
DDCB: 85 96                STA     JMPER + 2
DDCD: 20 94 00             JSR     JMPER                ;DISPATCH!
DDD0:                                                   ;STRING FUNCTIONS REMOVE THIS RET ADDR.
DDD0: 4c 02 dc             JMP     CHKNUM               ;CHECK IT FOR NUMERICNESS AND RETURN.
DDD3:              
DDD3:              OROP:
DDD3: a0 ff                LDY     #255                 ;MUST ALWAYS COMPLEMENT..
DDD5:                      SKIP2
