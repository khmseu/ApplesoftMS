EE3F:                      LDWDI   RMULZC               ;Multiply by random constant.
EE3F: a9 27                LDA     #RMULZC & 0o377
EE41: a0 ee                LDY     #RMULZC / 0o400
EE43: 20 00 e8             JSR     FMULT
EE46:                      LDWDI   RADDZC
EE46: a9 2b                LDA     #RADDZC & 0o377
EE48: a0 ee                LDY     #RADDZC / 0o400
EE4A: 20 3f e6             JSR     FADD                 ;Add random constant.
EE4D:              RND1:
EE4D: a6 a5                LDX     FACLO
EE4F: a5 a2                LDA     FACHO
EE51: 85 a5                STA     FACLO
EE53: 86 a2                STX     FACHO                ;Reverse ho and lo.
EE55:                      .IF     REALIO == 3
