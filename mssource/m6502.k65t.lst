D68C:                      JEQ     ENDCON               ;Yes - ran off the END.
D68C: d0 91   D691         BNE     * + 5
D68E: 4c 15 d7             JMP     ENDCON
D691: c8                   INY                          ;Put line number in CURLIN.
D692: b1 ba                LDA     (TXTPTR),Y
D694: 85 78                STA     CURLIN
D696: c8                   INY
D697: b1 ba                LDA     (TXTPTR),Y
D699: 85 79                STA     CURLIN + 1
D69B: 98                   TYA
D69C: 65 ba                ADC     TXTPTR
D69E: 85 ba                STA     TXTPTR
D6A0: 90 a4   D6A4         BCC     GONE
D6A2: e6 bb                INC     TXTPTR + 1
D6A4:              GONE:
D6A4: 20 b3 00             JSR     CHRGET               ;GET the statement type.
