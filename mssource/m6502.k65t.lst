DE6B:                      .subttl DIMENSION AND VARIABLE SEARCHING.
DE6B:              
DE6B:              ; THE "DIM" CODE SETS [DIMFLG] AND THEN FALLS INTO THE VARIABLE SEARCH
DE6B:              ; ROUTINE, WHICH LOOKS AT DIMFLG AT THREE DIFFERENT POINTS.
DE6B:              ;	1) IF AN ENTRY IS FOUND, "DIMFLG" BEING ON INDICATES
DE6B:              ;		A "DOUBLY" DIMENSIONED VARIABLE.
DE6B:              ;	2) WHEN A NEW ENTRY IS BEING BUILT "DIMFLG" BEING ON
DE6B:              ;		INDICTAES THE INDICES SHOULD BE USED FOR THE
DE6B:              ;		SIZE OF EACH INDEX. OTHERWISE THE DEFAULT OF TEN
DE6B:              ;		IS USED.
DE6B:              ;	3) WHEN THE BUILD ENTRY CODE FINISHES, ONLY IF "DIMFLG" IS OFF
DE6B:              ;		WILL INDEXING BE DONE.
DE6B:              
DE6B:              DIM3:
DE6B: 20 59 dd             JSR     CHKCOM               ;MUST BE A COMMA
DE6E:              DIM:
DE6E: aa                   TAX                          ;SET [ACCX] NONZERO.
DE6F:                                                   ;[ACCA] MUST BE NONZERO TO WORK RIGHT.
DE6F:              DIM1:
DE6F: 20 7d de             JSR     PTRGT1
DE72:              DIMCON:
DE72: 20 b9 00             JSR     CHRGOT               ;GET LAST CHARACTER.
DE75: d0 6b   DE6B         BNE     DIM3
DE77: 60                   RTS
DE78:              
DE78:              ; ROUTINE TO READ THE VARIABLE NAME AT THE CURRENT TEXT POSITION
DE78:              ; AND  PUT A POINTER TO ITS VALUE IN VARPNT. [TXTPTR]
DE78:              ; POINTS TO THE TERMINATING CHARCTER.. NOT THAT EVALUATING SUBSCRIPTS
DE78:              ; IN A VARIABLE NAME CAN CAUSE RECURSIVE CALLS TO "PTRGET" SO AT
DE78:              ; THAT POINT ALL VALUES MUST BE STORED ON THE STACK.
DE78:              
DE78:              PTRGET:
DE78: a2 00                LDX     #0                   ;MAKE [ACCX]=0.
DE7A: 20 b9 00             JSR     CHRGOT               ;RETRIEVE LAST CHARACTER.
DE7D:              PTRGT1:
DE7D: 86 10                STX     DIMFLG               ;STORE FLAG AWAY.
DE7F:              PTRGT2:
DE7F: 85 84                STA     VARNAM
DE81: 20 b9 00             JSR     CHRGOT               ;GET CURRENT CHARACTER
DE84:                                                   ;MAYBE WITH FUNCTION BIT OFF.
DE84: 20 02 df             JSR     ISLETC               ;CHECK FOR LETTER.
DE87: b0 8c   DE8C         BCS     PTRGT3               ;MUST HAVE A LETTER.
DE89:              INTERR:
DE89: 4c 64 dd             JMP     SNERR
DE8C:              PTRGT3:
DE8C: a2 00                LDX     #0                   ;ASSUME NO SECOND CHARACTER.
DE8E: 86 11                STX     VALTYP               ;DEFAULT IS NUMERIC.
DE90:                      .if     INTPRC != 0
DE90: 86 12                STX     INTFLG
DE92:                      .endif
DE92:                                                   ;ASSUME FLOATING.
DE92: 20 b3 00             JSR     CHRGET               ;GET FOLLOWING CHARACTER.
DE95: 90 9c   DE9C         BCC     ISSEC                ;CARRY RESET BY CHRGET IF NUMERIC.
DE97: 20 02 df             JSR     ISLETC               ;SET CARRY IF NOT ALPHABETIC.
DE9A: 90 a7   DEA7         BCC     NOSEC                ;ALLOW ALPHABETICS.
DE9C:              ISSEC:
DE9C: aa                   TAX                          ;IT IS A NUMBER -- SAVE IN ACCX.
DE9D:              EATEM:
DE9D: 20 b3 00             JSR     CHRGET               ;LOOK AT NEXT CHARACTER.
DEA0: 90 9d   DE9D         BCC     EATEM                ;SKIP NUMERICS.

