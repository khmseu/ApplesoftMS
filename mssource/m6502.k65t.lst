DB98:                      BEQA    STXFOR               ;[FORPNT]=0.
DB98: f0 9d   DB9D         BEQ     STXFOR
DB9A:              GETFOR:
DB9A: 20 78 de             JSR     PTRGET               ;GET a pointer to loop variable
DB9D:              STXFOR:
DB9D:                      STWD    FORPNT               ;Into "FORPNT"*
DB9D: 85 88                STA     FORPNT
