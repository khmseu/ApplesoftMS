D7AA: 4c c1 d7             JMP     RUNC2                ;MUST REPLACE RTS ADDR.
D7AD:              
D7AD:              ; A GOSUB ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
D7AD:              
D7AD:              ; LOW ADDRESS:
D7AD:              ;	THE GOSUTK ONE BYTE
D7AD:              ;	THE LINE NUMBER OF THE GOSUB STATEMENT TWO BYTES
D7AD:              ;	A POINTER INTO THE TEXT OF THE GOSUB TWO BYTES
D7AD:              
D7AD:              ; HIGH ADDRESS.
D7AD:              
D7AD:              ; TOTAL FIVE BYTES.
D7AD:              
D7AD:              GOSUB:
D7AD: a9 03                LDA     #3
D7AF: 20 e1 d2             JSR     GETSTK               ;MAKE SURE THERE IS ROOM.
D7B2:                      PSHWD   TXTPTR               ;PUSH ON THE TEXT POINTER.
