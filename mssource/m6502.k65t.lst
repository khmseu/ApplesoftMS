DB94:                      .subttl THE NEXT CODE IS THE "NEXT CODE"
DB94:              
DB94:              ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
DB94:              
DB94:              ; LOW ADDRESS
DB94:              ;	TOKEN (FORTK) 1 BYTE
DB94:              ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
DB94:              ;	THE STEP 4+ADDPRC BYTES
DB94:              ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
DB94:              ;	THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
DB94:              ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
DB94:              ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
DB94:              ; HIGH ADDRESS
DB94:              
DB94:              ; TOTAL 16+2*ADDPRC BYTES.
DB94:              
DB94:              NEXT:
DB94: d0 9a   DB9A         BNE     GETFOR
DB96: a0 00                LDY     #0                   ;WITHOUT ARG CALL "FNDFOR" WITH
DB98:                      BEQA    STXFOR               ;[FORPNT]=0.
DB98: f0 9d   DB9D         BEQ     STXFOR
DB9A:              GETFOR:
DB9A: 20 78 de             JSR     PTRGET               ;GET A POINTER TO LOOP VARIABLE
DB9D:              STXFOR:
DB9D:                      STWD    FORPNT               ;INTO "FORPNT"*
DB9D: 85 88                STA     FORPNT
DB9F: 84 89                STY     FORPNT + 1
DBA1: 20 70 d2             JSR     FNDFOR               ;FIND THE MATCHING ENTRY IF ANY.
DBA4: f0 aa   DBAA         BEQ     HAVFOR
DBA6: a2 00                LDX     #ERRNF               ;"NEXT WITHOUT FOR"*
DBA8:              ERRGO5:
DBA8: f0 10   DC10         BEQ     ERRGO4
DBAA:              HAVFOR:
DBAA: 9a                   TXS                          ;SETUP STACK. CHOP FIRST.
DBAB: 8a                   TXA
DBAC: 18                   CLC
DBAD: 69 04                ADC     #4                   ;POINT TO INCREMENT
DBAF: 48                   PHA                          ;SAVE THIS POINTER TO RESTORE TO [A]
DBB0: 69 06                ADC     #5 + ADDPRC          ;POINT TO UPPER LIMIT
DBB2: 85 63                STA     INDEX2               ;SAVE AS INDEX
DBB4: 68                   PLA                          ;RESTORE POINTER TO INCREMENT
DBB5: a0 01                LDY     #1                   ;SET HI ADDR OF THING TO MOVE.
DBB7: 20 7a e9             JSR     MOVFM                ;GET QUANTITY INTO THE FAC.
DBBA: ba                   TSX
DBBB: bd 09 01             LDA     257 + 7 + ADDPRC,X   ;SET SIGN CORRECTLY.
DBBE: 85 a6                STA     FACSGN
DBC0:                      LDWD    FORPNT
DBC0: a5 88                LDA     FORPNT
DBC2: a4 89                LDY     FORPNT + 1
DBC4: 20 3f e6             JSR     FADD                 ;ADD INC TO LOOP VARIABLE.
DBC7: 20 a8 e9             JSR     MOVVF                ;PACK THE FAC INTO MEMORY.
DBCA: a0 01                LDY     #1
DBCC: 20 35 ea             JSR     FCOMPN               ;COMPARE FAC WITH UPPER VALUE.
DBCF: ba                   TSX
DBD0: 38                   SEC
