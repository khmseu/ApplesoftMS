00B3:                      .subttl RAM CODE.
00B3:              ; THIS CODE GETS CHANGED THROUGHOUT EXECUTION.
00B3:              ; IT IS MADE TO BE FAST THIS WAY.
00B3:              ; ALSO, [X] AND [Y] ARE NOT DISTURBED
00B3:              
00B3:              ; "CHRGET" USING [TXTPTR] AS THE CURRENT TEXT PNTR
00B3:              ; FETCHES A NEW CHARACTER INTO ACCA AFTER INCREMENTING [TXTPTR]
00B3:              ; AND SETS CONDITION CODES ACCORDING TO WHAT'S IN ACCA.
00B3:              ;	NOT C=	NUMERIC	  ("0" THRU "9")
00B3:              ;	Z=	":" OR END-OF-LINE (A NULL)
00B3:              
00B3:              ; [ACCA] = NEW CHAR.
00B3:              ; [TXTPTR]=[TXTPTR]+1
00B3:              
00B3:              ; THE FOLLOWING EXISTS IN ROM IF ROM EXISTS AND IS LOADED
00B3:              ; DOWN HERE BY INIT. OTHERWISE IT IS JUST LOADED INTO THIS
00B3:              ; RAM LIKE ALL THE REST OF RAM IS LOADED.
00B3:              
00B3:              CHRGET:
00B3: e6 ba                INC     CHRGET + 7           ;INCREMENT THE WHOLE TXTPTR.
00B5: d0 b9   00B9         BNE     CHRGOT
00B7: e6 bb                INC     CHRGET + 8
00B9:              CHRGOT:
00B9: ad 60 ea             LDA     60000                ;A LOAD WITH AN EXT ADDR.
00BC:         00BA TXTPTR  =       CHRGOT + 1
00BC: c9 20                CMP     #" "                 ;SKIP SPACES.
00BE: f0 b3   00B3         BEQ     CHRGET
00C0:              QNUM:
00C0: c9 3a                CMP     #":"                 ;IS IT A ":"?
00C2: b0 ca   00CA         BCS     CHRRTS               ;IT IS .GE. ":"
00C4: 38                   SEC
00C5: e9 30                SBC     #"0"                 ;ALL CHARS .GT. "9" HAVE RET'D SO
00C7: 38                   SEC
00C8: e9 d0                SBC     #256 - "0"           ;SEE IF NUMERIC.
00CA:                                                   ;TURN CARRY ON IF NUMERIC.
00CA:                                                   ;ALSO, SETZ IF NULL.
00CA:              CHRRTS:
00CA: 60                   RTS                          ;RETURN TO CALLER.
00CB:              
00CB:              RNDX:
00CB: 80                   .byte   128                  ;LOADED OR FROM ROM.
00CC: 4f                   .byte   79                   ;THE INITIAL RANDOM NUMBER.
00CD: c7                   .byte   199
00CE: 52                   .byte   82
00CF:                      .if     ADDPRC != 0
00CF: 59                   .byte   89
00D0:                      .endif
00D0:                                                   ;ONE MORE BYTE.
00D0:              
00D0:                      .org    255                  ;PAGE 1 STUFF COMING UP.
00FF:              LOFBUF:
00FF: 00                   .fill   1                    ;THE LOW FAC BUFFER. COPYABLE.
0100:              ;---  PAGE ZERO/ONE BOUNDARY ---*
0100:                                                   ;MUST HAVE 13 CONTIGUOUS BYTES.
0100:              FBUFFR:
0100: 00 00 00 00          .fill   3 * ADDPRC + 13      ;BUFFER FOR "FOUT"*
0104: 00 00 00 00  
0108: 00 00 00 00  
010C: 00 00 00 00  
0110:                                                   ;ON PAGE 1 SO THAT STRING IS NOT COPIED.

