EE3F:                      LDWDI   RMULZC               ;MULTIPLY BY RANDOM CONSTANT.
EE3F: a9 27                LDA     #RMULZC & 0o377
EE41: a0 ee                LDY     #RMULZC / 0o400
EE43: 20 00 e8             JSR     FMULT
