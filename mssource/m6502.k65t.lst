0000:                                  .title  BASIC M6502 8K VER 1.1 BY MICRO-SOFT
0000:                                  .include "M6502.lib.asm"
0000:                          ; 6502 opcode macros
0000:                          .pagesize 60
0000:                          .bytesperline 4
0000:              
0000:              ;Sall
0000:              ;Radix 10			;throughout all but math-pak.
0000:              
0000:              $Z:
0000:                                                   ;Starting point FOR m6502 simulator
0000:                      .org    0                    ;START off at location ZERO.
0000:                      .subttl SWITCHES,MACROS.
0000:              
0000:         0004 REALIO  =       4                    ;5=Stm
0000:                                                   ;4=Apple.
0000:                                                   ;3=Commodore.
0000:                                                   ;2=Osi
0000:                                                   ;1=Mos tech,kim
0000:                                                   ;0=Pdp-10 simulating 6502
0000:         0001 INTPRC  =       1                    ;Integer arrays.
0000:         0001 ADDPRC  =       1                    ;FOR additional precision.
0000:         0000 LNGERR  =       0                    ;Long ERROR messages.
0000:         0000 TIME    =       0                    ;Capability to set and READ a clk.
0000:         0000 EXTIO   =       0                    ;External i/o.
0000:         0000 DISKO   =       0                    ;SAVE and LOAD commands
0000:         0001 NULCMD  =       1                    ;FOR the "null" command
0000:         0001 GETCMD  =       1
0000:         0001 RORSW   =       1
0000:         0001 ROMSW   =       1                    ;Tells IF this is on rom.
0000:         000E CLMWID  =       14
0000:         0001 LONGI   =       1                    ;Long initialization switch.
0000:         01FF STKEND  =       511
0000:         0000 BUFPAG  =       0
0000:         0048 LINLEN  =       72                   ;Terminal line length.
0000:         0048 BUFLEN  =       72                   ;INPUT buffer SIZE.
0000:         2000 ROMLOC  =       0o20000              ;Address of START of pure segment.
0000:         0001 KIMROM  =       1
0000:                      .IF     ROMSW == 0
0000:              KIMROM  =       0
0000:                      .endif
0000:                      .IF     REALIO != 1
0000:         0000 KIMROM  =       0
0000:                      .endif
0000:                      .IF     ROMSW != 0
0000:         4000 RAMLOC  =       0o40000              ;Used only IF ROMSW=1
0000:                      .IF     REALIO == 0
0000:              ROMLOC  =       0o20000              ;START at 8k.
0000:              RAMLOC  =       0o1400
0000:                      .endif
0000:                      .endif
0000:                      .IF     REALIO == 3
0000:              DISKO   =       1
0000:              RAMLOC  =       0o2000
0000:              ROMLOC  =       0o140000
0000:              NULCMD  =       0
0000:              GETCMD  =       1
0000:              LINLEN  =       40
0000:              BUFLEN  =       81
0000:              CQOPEN  =       0o177700

