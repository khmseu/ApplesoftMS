D435: a2 ef                LDX     #BUFLEN - 1
D437:              GDBUFS:
D437: a9 00                LDA     #0                   ;PUT A ZERO AT THE END
D439: 9d 00 02             STA     BUF,X
D43C: 8a                   TXA
D43D: f0 4a   D44A         BEQ     NOCHR
