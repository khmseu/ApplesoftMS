DBA8:              ERRGO5:
DBA8: f0 10   DC10         BEQ     ERRGO4
DBAA:              HAVFOR:
DBAA: 9a                   TXS                          ;Setup stack. chop first.
DBAB: 8a                   TXA
DBAC: 18                   CLC
DBAD: 69 04                ADC     #4                   ;Point to increment
DBAF: 48                   PHA                          ;SAVE this pointer to restore to [a]
DBB0: 69 06                ADC     #5 + ADDPRC          ;Point to upper limit
DBB2: 85 63                STA     INDEX2               ;SAVE as INDEX
DBB4: 68                   PLA                          ;Restore pointer to increment
DBB5: a0 01                LDY     #1                   ;Set hi addr of thing to move.
DBB7: 20 7a e9             JSR     MOVFM                ;GET quantity into the FAC.
DBBA: ba                   TSX
