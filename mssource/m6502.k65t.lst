EF35:                                                   ;USE ARCTAN(X)=PI/2-ARCTAN(1/X) *
EF35:              ATN2:
EF35:                      LDWDI   ATNCON               ;PNTR TO ARCTAN CONSTANTS.
EF35: a9 4f                LDA     #ATNCON & 0o377
EF37: a0 ef                LDY     #ATNCON / 0o400
EF39: 20 dd ed             JSR     POLYX
EF3C: 68                   PLA
EF3D: c9 81                CMP     #0o201               ;WAS ORIGINAL ARGUMENT .LT. 1 ?
EF3F: 90 48   EF48         BCC     ATN3                 ;YES.
EF41:                      LDWDI   PI2
