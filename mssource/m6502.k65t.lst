E17C:                      .subttl SIMPLE-USER-DEFINED-FUNCTION CODE.
E17C:              
E17C:              ; NOTE ONLY SINGLE ARGUMENTS ARE ALLOWED TO FUNCTIONS
E17C:              ; AND FUNCTIONS MUST BE OF THE SINGLE LINE FORM:
E17C:              ;	DEF FNA(X)=X^2+X-2
E17C:              ; NO STRINGS CAN BE INVOLVED WITH THESE FUNCTIONS.
E17C:              
E17C:              ; IDEA: CREATE A SIMPLE VARIABLE ENTRY
E17C:              ; WHOSE FIRST CHARACTER HAS THE 200 BIT SET.
E17C:              ; THE VALUE WILL BE:
E17C:              
E17C:              ;	A TEXT PNTR TO THE FORMULA.
E17C:              ;	A PNTR TO THE ARGUMENT VARIABLE.
E17C:              
E17C:              ; FUNCTION NAMES CAN BE LIKE "FNA4"*
E17C:              
E17C:              ; SUBROUTINE TO SEE IF WE ARE IN DIRECT MODE.
E17C:              ; AND COMPLAIN IF SO.
E17C:              
E17C:              ERRDIR:
E17C: a6 79                LDX     CURLIN + 1           ;DIR MODE HAS [CURLIN]=0,255
E17E: e8                   INX                          ;SO NOW, IS RESULT ZERO?
E17F: d0 23   E123         BNE     DIMRTS               ;YES.
E181: a2 95                LDX     #ERRID               ;INPUT DIRECT ERROR CODE.
E183:                      SKIP2
E183: 2c                   .byte   0o054
E184:              ERRGUF:
E184: a2 e0                LDX     #ERRUF               ;USER DEFINED FUNCTION NEVER DEFINED
E186:              ERRGO1:
E186: 4c 1d d3             JMP     ERROR
E189:              
E189:              DEF:
E189: 20 b7 e1             JSR     GETFNM               ;GET A PNTR TO THE FUNCTION.
E18C: 20 7c e1             JSR     ERRDIR
