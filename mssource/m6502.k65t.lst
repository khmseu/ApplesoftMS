EF8C:                      .subttl SYSTEM INITIALIZATION CODE.
EF8C:              ;RADIX	10		;IN ALL NON-MATH-PACKAGE CODE.
EF8C:              ; THIS INITIALIZES THE BASIC INTERPRETER FOR THE M6502 AND SHOULD BE
EF8C:              ; LOCATED WHERE IT WILL BE WIPED OUT IN RAM IF CODE IS ALL IN RAM.
EF8C:              
EF8C:                      .if     ROMSW == 0
EF8C:                      .fill   1
EF8C:                      .endif
EF8C:                                                   ;SO ZEROING AT TXTTAB DOESN'T PREVENT
EF8C:                                                   ;RESTARTING INIT
