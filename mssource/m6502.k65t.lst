DBD4:                                                   ;OF (CURRENT VALUE-FINAL VALUE)*
DBD4: f0 ed   DBED         BEQ     LOOPDN               ;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
DBD6:                                                   ;THEN LOOP IS DONE.
DBD6: bd 0f 01             LDA     2 * ADDPRC + 12 + 257,X

