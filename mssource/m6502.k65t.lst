0000:                      .subttl INTRODUCTION AND COMPILATION PARAMETERS.
0000:              
0000:              ; --------- ---- -- ---------
0000:              ; COPYRIGHT 1976 BY MICROSOFT
0000:              ; --------- ---- -- ---------
0000:              ; 7/27/78 FIXED BUG WHERE FOR VARIABLE AT BYTE FF MATCHED RETURN SEARCHING
0000:              ; 	FOR GOSUB ENTRY ON STACK IN FNDFOR CALL BY CHANGING STA FORPNT
0000:              ; 	TO STA FORPNT+1. THIS IS A SERIOUS BUG IN ALL VERSIONS.
0000:              ; 7/27/78 FIXED BUG AT NEWSTT UNDER IFN BUFPAG WHEN CHECK OF CURLIN
0000:              ; 	WAS DONE BEFORE CURLIN SET UP SO INPUT RETRIES OF FIRST STATEMENT
0000:              ; 	WAS GIVING SYNTAX ERROR INSTEAD OF REDO FROM START (CODE WAS 12/1/77 FIX)
0000:              ; 7/1/78	SAVED A FEW BYTES IN INIT FOR COMMODORE (14)
0000:              ; 7/1/78 FIXED BUG WHERE REPLACING A LINE OVERFLOWING MEMORY LEFT LINKS
0000:              ; 	IN A BAD STATE. (CODE AT NODEL AND FINI) BUG#4
0000:              ; 7/1/78 FIXED BUG WHERE GARBAGE COLLECTION NEVER(!) COLLECTS TEMPS
0000:              ; 	(STY GRBPNT  AT FNDVAR, LDA GRBPNT ORA GRBPNT+1 AT GRBPAS)
0000:              ; 	THIS WAS COMMODORE BUG #2
0000:              ; 7/1/78 FIXED BUG WHERE DELETE/INSERT OF LINE COULD CAUSE A GARBAGE COLLECTION WITH BAD VARTAB IF OUT OF MEMORY
0000:              ; 	 (LDWD MEMSIZ STWD FRETOP=JSR RUNC CLC ALSO AT NODEL)
0000:              ; 3/9/78 EDIT TO FIX COMMO TRMPOS AND CHANGE LEFT$ AND RIGHT$ TO ALLOW A SECOND ARGUMENT OF 0 AND RETURN A NULL STRING
0000:              ; 2/25/78 FIXED BUG THAT INPFLG WAS SET WRONG WHEN BUFPAG.NE.0
0000:              ; 	INCREASED NUMLEV FROM 19 TO 23
0000:              ; 2/11/78 DISALLOWED SPACES IN RESERVED WORDS. PUT IN SPECIAL CHECK FOR "GO TO"
0000:              ; 2/11/78 FIXED BUG WHERE ROUNDING OF THE FAC BEFORE PUSHING COULD CAUSE A STRING POINTER
0000:              ; 	IN THE FAC TO BE INCREMENTED
0000:              ; 1/24/78 fixed problem where user defined function undefined check fix was smashing error number in [x]
0000:              ; 12/1/77 FIXED PROBLEM WHERE PEEK WAS SMASHING (POKER) CAUSING POKE OF PEEK TO FAIL
0000:              ; 12/1/77 FIXED PROBLEM WHERE PROBLEM WITH VARTXT=LINNUM=BUF-2 CAUSING BUF-1 COMMA TO DISAPPEAR
0000:              ; 12/1/77 FIXED BUFPAG.NE.0 PROBLEM AT NEWSTT AND STOP : CODE WAS STILL
0000:              ; 	ASSUMING TXTPTR+1.EQ.0 IFF STATEMENT WAS DIRECT
0000:              
0000:         0017 NUMLEV  =       23                   ;NUMBER OF STACK LEVELS RESERVED
0000:                                                   ;BY AN EXPLICIT CALL TO "GETSTK"*
0000:         0003 STRSIZ  =       3                    ;# OF LOCS PER STRING DESCRIPTOR.
0000:         0003 NUMTMP  =       3                    ;NUMBER OF STRING TEMPORARIES.
0000:         000F CONTW   =       15                   ;CHARACTER TO SUPPRESS OUTPUT.
