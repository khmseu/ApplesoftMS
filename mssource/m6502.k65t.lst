D31B:                      .subttl ERROR HANDLER, READY, TERMINAL INPUT, COMPACTIFY, NEW, REINIT.
D31B:              OMERR:
D31B: a2 4d                LDX     #ERROM
D31D:              ERROR:
D31D:                      .IF     REALIO != 0
D31D: 46 17                LSR     CNTWFL
D31F:                      .endif
D31F:                                                   ;Force output.
D31F:                      .IF     EXTIO != 0
D31F:                      LDA     CHANNL               ;Close non-terminal channel.
D31F:                      BEQ     ERRCRD
D31F:                      JSR     CQCCHN               ;Close it.
D31F:                      LDA     #0
D31F:                      STA     CHANNL
D31F:                      .endif
D31F:              ERRCRD:
D31F: 20 91 d9             JSR     CRDO                 ;Output crlf.
D322: 20 fb d9             JSR     OUTQST               ;PRINT a question mark
D325:                      .IF     LNGERR == 0
D325:                      LDA     ERRTAB,X             ;GET first CHR of ERR msg.
D325:                      JSR     OUTDO                ;Output it.
D325:                      LDA     ERRTAB + 1,X         ;GET second CHR.
D325:                      JSR     OUTDO
D325:                      .endif
D325:                                                   ;Output it.
D325:                      .IF     LNGERR != 0
D325:              GETERR:
D325: bd 65 d1             LDA     ERRTAB,X
D328: 48                   PHA
D329: 29 7f                AND     #127                 ;GET rid of high bit.
D32B: 20 fd d9             JSR     OUTDO                ;Output it.
D32E: e8                   INX
D32F: 68                   PLA                          ;Last char of message?
D330: 10 25   D325         BPL     GETERR
