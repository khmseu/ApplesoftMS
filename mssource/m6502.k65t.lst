EDDD:                      .subttl POLYNOMIAL EVALUATOR AND THE RANDOM NUMBER GENERATOR.
EDDD:                                                   ;EVALUATE P(X^2)*X
EDDD:                                                   ;POINTER TO DEGREE IS IN [Y,A]*
EDDD:                                                   ;THE CONSTANTS FOLLOW THE DEGREE.
EDDD:                                                   ;FOR X=FAC, COMPUTE:
EDDD:                                                   ; C0*X+C1*X^3+C2*X^5+C3*X^7+...+C(N)*X^(2*N+1)
EDDD:              POLYX:
EDDD:                      STWD    POLYPT               ;RETAIN POLYNOMIAL POINTER FOR LATER.
EDDD: 85 b1                STA     POLYPT
EDDF: 84 b2                STY     POLYPT + 1
EDE1: 20 a2 e9             JSR     MOV1F                ;SAVE FAC IN FACTMP.
EDE4: a9 97                LDA     #TEMPF1
EDE6: 20 00 e8             JSR     FMULT                ;COMPUTE X^2.
EDE9: 20 f7 ed             JSR     POLY1                ;COMPUTE P(X^2)*
EDEC:                      LDWDI   TEMPF1
EDEC: a9 97                LDA     #TEMPF1 & 0o377
EDEE: a0 00                LDY     #TEMPF1 / 0o400
EDF0: 4c 00 e8             JMP     FMULT                ;MULTIPLY BY FAC AGAIN.
EDF3:              
EDF3:                                                   ;POLYNOMIAL EVALUATOR.
EDF3:                                                   ;POINTER TO DEGREE IS IN [Y,A]*
EDF3:                                                   ;COMPUTE:
EDF3:                                                   ; C0+C1*X+C2*X^2+C3*X^3+C4*X^4+...+C(N-1)*X^(N-1)+C(N)*X^N.
EDF3:              POLY:
EDF3:                      STWD    POLYPT
EDF3: 85 b1                STA     POLYPT
EDF5: 84 b2                STY     POLYPT + 1
EDF7:              POLY1:
EDF7: 20 9f e9             JSR     MOV2F                ;SAVE FAC.
EDFA: b1 b1                LDA     (POLYPT),Y
EDFC: 85 a7                STA     DEGREE
EDFE: a4 b1                LDY     POLYPT
EE00: c8                   INY
EE01: 98                   TYA
EE02: d0 06   EE06         BNE     POLY3
EE04: e6 b2                INC     POLYPT + 1
EE06:              POLY3:
EE06: 85 b1                STA     POLYPT
