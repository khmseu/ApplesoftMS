D7A2:                      .subttl RUN,GOTO,GOSUB,RETURN.
D7A2:              RUN:
D7A2:                      JEQ     RUNC                 ;IF no line # argument.
D7A2: d0 a7   D7A7         BNE     * + 5
D7A4: 4c 37 d5             JMP     RUNC
D7A7: 20 3e d5             JSR     CLEARC               ;Clean up -- reset the stack.
D7AA: 4c c1 d7             JMP     RUNC2                ;Must replace rts addr.
D7AD:              
D7AD:              ; A GOSUB entry on the stack has the following format:
D7AD:              
D7AD:              ; Low address:
D7AD:              ;	The GOSUTK one byte
D7AD:              ;	The line number of the GOSUB statement two bytes
D7AD:              ;	A pointer into the text of the GOSUB two bytes
D7AD:              
D7AD:              ; High address.
D7AD:              
D7AD:              ; Total five bytes.
D7AD:              
D7AD:              GOSUB:
D7AD: a9 03                LDA     #3
D7AF: 20 e1 d2             JSR     GETSTK               ;Make sure there is room.
D7B2:                      PSHWD   TXTPTR               ;Push on the text pointer.
D7B2: a5 bb                LDA     TXTPTR + 1
D7B4: 48                   PHA
D7B5: a5 ba                LDA     TXTPTR
D7B7: 48                   PHA
D7B8:                      PSHWD   CURLIN               ;Push on the current line number.
D7B8: a5 79                LDA     CURLIN + 1
D7BA: 48                   PHA
D7BB: a5 78                LDA     CURLIN
D7BD: 48                   PHA
D7BE: a9 8c                LDA     #GOSUTK
D7C0: 48                   PHA                          ;Push on a GOSUB token.
D7C1:              RUNC2:
D7C1: 20 b9 00             JSR     CHRGOT               ;GET character and set codes FOR LINGET.
D7C4: 20 ca d7             JSR     GOTO                 ;Use rts scheme to "NEWSTT"*
D7C7: 4c 72 d6             JMP     NEWSTT
D7CA:              
D7CA:              GOTO:
D7CA: 20 90 d8             JSR     LINGET               ;Pick up the line number in "LINNUM"*
D7CD: 20 2e d8             JSR     REMN                 ;Skip to END of line.
D7D0: a5 79                LDA     CURLIN + 1
D7D2: c5 54                CMP     LINNUM + 1
D7D4: b0 e1   D7E1         BCS     LUK4IT
D7D6: 98                   TYA
D7D7: 38                   SEC
D7D8: 65 ba                ADC     TXTPTR
D7DA: a6 bb                LDX     TXTPTR + 1
D7DC: 90 e5   D7E5         BCC     LUKALL
D7DE: e8                   INX
D7DF:                      BCSA    LUKALL               ;Always goes.
D7DF: b0 e5   D7E5         BCS     LUKALL
D7E1:              LUK4IT:
D7E1:                      LDWX    TXTTAB
D7E1: a5 6a                LDA     TXTTAB
D7E3: a6 6b                LDX     TXTTAB + 1
D7E5:              LUKALL:
D7E5: 20 f5 d4             JSR     FNDLNC               ;[X,a] are all set up.
D7E8:              QFOUND:

