          LINGET -- READ A LINE NUMBER INTO LINNUM
--------------------------------------------------------------------------------
D890:                      .subttl LINGET -- READ A LINE NUMBER INTO LINNUM
D890:              
D890:              ; "LINGET" reads a line number from the current text position.
D890:              
D890:              ; Line numbers range from 0 to 64000-1.
D890:              
D890:              ; The answer is returned in "LINNUM"*
D890:              ; "TXTPTR" is updated to point to the terminating charcter
D890:              ; And [a] = the terminating character with condition
D890:              ; Codes set up to reflect its value.
D890:              
D890:              LINGET:
D890: a2 00                LDX     #0
D892: 86 53                STX     LINNUM               ;Initialize line number to ZERO.
D894: 86 54                STX     LINNUM + 1
D896:              MORLIN:
D896: b0 8f   D88F         BCS     ONGRTS               ;It is not a digit.
D898: e9 2f                SBC     #"0" - 1             ;-1 Since c=0.
D89A: 85 0d                STA     CHARAC               ;SAVE character.
D89C: a5 54                LDA     LINNUM + 1
D89E: 85 61                STA     INDEX
D8A0: c9 19                CMP     #25                  ;Line number will be .lt. 64000?
D8A2: b0 78   D878         BCS     SNERR3
D8A4: a5 53                LDA     LINNUM
D8A6: 0a                   ASL     A                    ;Multiply by 10.
D8A7: 26 61                ROL     INDEX
D8A9: 0a                   ASL     A
D8AA: 26 61                ROL     INDEX
D8AC: 65 53                ADC     LINNUM
D8AE: 85 53                STA     LINNUM
D8B0: a5 61                LDA     INDEX
D8B2: 65 54                ADC     LINNUM + 1
D8B4: 85 54                STA     LINNUM + 1
D8B6: 06 53                ASL     LINNUM
D8B8: 26 54                ROL     LINNUM + 1
D8BA: a5 53                LDA     LINNUM
D8BC: 65 0d                ADC     CHARAC               ;Add in digit.
D8BE: 85 53                STA     LINNUM
D8C0: 90 c4   D8C4         BCC     NXTLGC
D8C2: e6 54                INC     LINNUM + 1
D8C4:              NXTLGC:
D8C4: 20 b3 00             JSR     CHRGET
D8C7: 4c 96 d8             JMP     MORLIN
D8CA:              
D8CA:                      .page

