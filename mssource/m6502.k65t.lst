EACB:                      .subttl FLOATING POINT INPUT ROUTINE.
EACB:                                                   ;Number INPUT is LEFT in FAC.
EACB:                                                   ;At entry [TXTPTR] points to the first character in a text buffer.
EACB:                                                   ;The first character is also in acca. FIN packs the digits
EACB:                                                   ;Into the FAC as an integer and keeps track of where the
EACB:                                                   ;Decimal point is. [DPTFLG] tell whether a dp has been
EACB:                                                   ;Seen. [DECCNT] is the number of digits after the dp.
EACB:                                                   ;At the END [DECCNT] and the exponent are used to
EACB:                                                   ;Determine how many times to multiply or DIVIDE by ten
EACB:                                                   ;To GET the correct number.
EACB:              FIN:
EACB: a0 00                LDY     #0                   ;ZERO FACSGN&SGNFLG.
EACD: a2 0a                LDX     #0o11 + ADDPRC       ;ZERO EXP and ho (and moh)*
EACF:              FINZLP:
EACF: 94 9d                STY     DECCNT,X             ;ZERO mo and lo.
EAD1: ca                   DEX                          ;ZERO TENEXP and EXPSGN
EAD2: 10 cf   EACF         BPL     FINZLP               ;ZERO DECCNT, DPTFLG.
EAD4: 90 e5   EAE5         BCC     FINDGQ               ;Flags still set from CHRGET.
EAD6: c9 2d                CMP     #"-"                 ;A negative SIGN?
EAD8: d0 de   EADE         BNE     QPLUS                ;No, try plus SIGN.
EADA: 86 a7                STX     SGNFLG               ;It's negative. (x=377)*
EADC: f0 e2   EAE2         BEQ     FINC                 ;Always branches.
EADE:              QPLUS:
EADE: c9 2b                CMP     #"+"                 ;Plus SIGN?
EAE0: d0 e7   EAE7         BNE     FIN1                 ;Yes, skip it.
EAE2:              FINC:
EAE2: 20 b3 00             JSR     CHRGET
EAE5:              FINDGQ:
EAE5: 90 42   EB42         BCC     FINDIG
EAE7:              FIN1:
EAE7: c9 2a                CMP     #"*"                 ;The dp?
EAE9: f0 19   EB19         BEQ     FINDP                ;No kidding.
EAEB: c9 45                CMP     #"E"                 ;Exponent follows.
EAED: d0 1f   EB1F         BNE     FINE                 ;No.
EAEF:                                                   ;Here to check FOR SIGN of EXP.
EAEF: 20 b3 00             JSR     CHRGET               ;Yes. GET another.
EAF2: 90 0b   EB0B         BCC     FNEDG1               ;It is a digit. (easier than
EAF4:                                                   ;Backing up pointer.)
EAF4: c9 a4                CMP     #MINUTK              ;Minus?
EAF6: f0 06   EB06         BEQ     FINEC1               ;Negate.
EAF8: c9 2d                CMP     #"-"                 ;Minus SIGN?
EAFA: f0 06   EB06         BEQ     FINEC1
EAFC: c9 a3                CMP     #PLUSTK              ;Plus?
EAFE: f0 08   EB08         BEQ     FINEC
EB00: c9 2b                CMP     #"+"                 ;Plus SIGN?
EB02: f0 08   EB08         BEQ     FINEC
EB04: d0 0d   EB0D         BNE     FINEC2
EB06:              FINEC1:
EB06: 66 a0                ROR     EXPSGN               ;Turn it on.
EB08:              FINEC:
EB08: 20 b3 00             JSR     CHRGET               ;GET another.
EB0B:              FNEDG1:
EB0B: 90 69   EB69         BCC     FINEDG               ;It is a digit.
EB0D:              FINEC2:
EB0D: 24 a0                BIT     EXPSGN
EB0F: 10 1f   EB1F         BPL     FINE
EB11: a9 00                LDA     #0
EB13: 38                   SEC
EB14: e5 9e                SBC     TENEXP
EB16: 4c 21 eb             JMP     FINE1

