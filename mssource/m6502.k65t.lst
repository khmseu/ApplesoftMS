E23B:                      .subttl STRING FUNCTIONS.
E23B:              
E23B:              ; THE STR$ FUNCTION TAKES A NUMBER AND GIVES A STRING
E23B:              ; WITH THE CHARACTERS THE OUTPUT OF THE NUMBER
E23B:              ; WOULD HAVE GIVEN.
E23B:              
E23B:              STR:
E23B: 20 02 dc             JSR     CHKNUM               ;ARG HAS TO BE NUMERIC.
E23E: a0 00                LDY     #0
