D270:                      .subttl GENERAL STORAGE MANAGEMENT ROUTINES.
D270:              
D270:              ; Find a "FOR" entry on the stack via "VARPNT"*
D270:              
D270:         0012 FORSIZ  =       2 * ADDPRC + 16
D270:              FNDFOR:
D270: ba                   TSX                          ;LOAD xreg with stk pntr.
D271:                      .repeat 4
D271: e8                   INX
D272: e8                   INX
D273: e8                   INX
D274: e8                   INX
D275:                      .endrepeat
D275:                                                   ;IGNORE .word NEWSTT AND RTS ADDR.
D275:              FFLOOP:
D275: bd 01 01             LDA     257,X                ;GET stack entry.
D278: c9 81                CMP     #FORTK               ;Is it a "FOR" token?
D27A: d0 9d   D29D         BNE     FFRTS                ;No, no "FOR" loops with this pntr.
D27C: a5 89                LDA     FORPNT + 1           ;GET high.
D27E: d0 8a   D28A         BNE     CMPFOR
D280: bd 02 01             LDA     258,X                ;Pntr is ZERO, so assume this one.
D283: 85 88                STA     FORPNT
D285: bd 03 01             LDA     259,X
D288: 85 89                STA     FORPNT + 1
D28A:              CMPFOR:
D28A: dd 03 01             CMP     259,X
D28D: d0 96   D296         BNE     ADDFRS               ;Not this one.
D28F: a5 88                LDA     FORPNT               ;GET down.
D291: dd 02 01             CMP     258,X
D294: f0 9d   D29D         BEQ     FFRTS                ;We got it! we got it!
D296:              ADDFRS:
D296: 8a                   TXA
D297: 18                   CLC                          ;Add 16 to x.
D298: 69 12                ADC     #FORSIZ
D29A: aa                   TAX                          ;Result back into x.
D29B: d0 75   D275         BNE     FFLOOP
D29D:              FFRTS:
D29D: 60                   RTS                          ;RETURN to caller.
D29E:              
D29E:              ; THIS IS THE .fill TRANSFER ROUTINE.
D29E:              ; It makes space by shoving everything forward.
D29E:              
D29E:              ; On entry:
D29E:              ; [Y,a]=[HIGHDS]    (FOR REASON)*
D29E:              ; [HIGHDS]= destination of [high address]*
D29E:              ; [LOWTR]= lowest addr to be transferred.
D29E:              ; [HIGHTR]= highest addr to be transferred.
D29E:              
D29E:              ; A check is made to ascertain that a reasonable
D29E:              ; Amount of space remains between the bottom
D29E:              ; Of the strings and the highest location transferred into.
D29E:              
D29E:              ; On exit:
D29E:              ; [LOWTR] are unchanged.
D29E:              ; [HIGHTR]=[LOWTR]-200 octal.
D29E:              ; [HIGHDS]=lowest addr transferred into minus 200 octal.
D29E:              
D29E:              BLTU:
D29E: 20 ee d2             JSR     REASON               ;Ascertain that string space won't
D2A1:                                                   ;Be overrun.

Page 37   BASIC M6502 8K VER 1.1 BY MICRO-SOFT
          GENERAL STORAGE MANAGEMENT ROUTINES.
--------------------------------------------------------------------------------
D2A1:                      STWD    STREND
D2A1: 85 70                STA     STREND
D2A3: 84 71                STY     STREND + 1
D2A5:              BLTUC:
D2A5: 38                   SEC                          ;Prepare to subtract.
D2A6: a5 9a                LDA     HIGHTR
D2A8: e5 9f                SBC     LOWTR                ;Compute number of things to move.
D2AA: 85 61                STA     INDEX                ;SAVE FOR later.
D2AC: a8                   TAY
D2AD: a5 9b                LDA     HIGHTR + 1
D2AF: e5 a0                SBC     LOWTR + 1
D2B1: aa                   TAX                          ;Put it in a counter register.
D2B2: e8                   INX                          ;So that counter algorithm works.
D2B3: 98                   TYA                          ;See IF low part of COUNT is ZERO.
D2B4: f0 d9   D2D9         BEQ     DECBLT               ;Yes, go START moving blocks.
D2B6: a5 9a                LDA     HIGHTR               ;No, must modify base addr.
D2B8: 38                   SEC
D2B9: e5 61                SBC     INDEX                ;Borrow is off since [HIGHTR].gt.[LOWTR]*
D2BB: 85 9a                STA     HIGHTR               ;SAVE modified base addr.
D2BD: b0 c2   D2C2         BCS     BLT1                 ;IF no borrow, go shove it.
D2BF: c6 9b                DEC     HIGHTR + 1           ;Borrow implies sub 1 from high order.
D2C1: 38                   SEC
D2C2:              BLT1:
D2C2: a5 98                LDA     HIGHDS               ;Mod base of dest addr.
D2C4: e5 61                SBC     INDEX
D2C6: 85 98                STA     HIGHDS
D2C8: b0 d2   D2D2         BCS     MOREN1               ;No borrow.
D2CA: c6 99                DEC     HIGHDS + 1           ;Decrement high order byte.
D2CC: 90 d2   D2D2         BCC     MOREN1               ;Always skip.
D2CE:              BLTLP:
D2CE: b1 9a                LDA     (HIGHTR),Y           ;Fetch byte to move
D2D0: 91 98                STA     (HIGHDS),Y           ;Move it in, move it out.
D2D2:              MOREN1:
D2D2: 88                   DEY
D2D3: d0 ce   D2CE         BNE     BLTLP
D2D5: b1 9a                LDA     (HIGHTR),Y           ;Move last of the block.
D2D7: 91 98                STA     (HIGHDS),Y
D2D9:              DECBLT:
D2D9: c6 9b                DEC     HIGHTR + 1
D2DB: c6 99                DEC     HIGHDS + 1           ;START on new blocks.
D2DD: ca                   DEX
D2DE: d0 d2   D2D2         BNE     MOREN1
D2E0: 60                   RTS                          ;RETURN to caller.
D2E1:              
D2E1:              ; This routine is used to ascertain that a given
D2E1:              ; Number of locs remain available FOR the stack.
D2E1:              ;    The call is:
D2E1:              ;	Lda #number of 2-byte entries needed.
D2E1:              ;	Jsr	GETSTK
D2E1:              
D2E1:              ; This routine must be called by any routine which puts
D2E1:              ; An arbitrary amount of stuff on the stack
D2E1:              ; I.e., any recursive routine like "FRMEVL"*
D2E1:              ; It is also called by routines such as "GOSUB" and "FOR"
D2E1:              ; Which make permanent entries on the stack.
D2E1:              
D2E1:              ; Routines which merely use and free up the guaranteed
D2E1:              ; NUMLEV locations need not call this.
D2E1:              
D2E1:              ; On exit:

Page 38   BASIC M6502 8K VER 1.1 BY MICRO-SOFT
          GENERAL STORAGE MANAGEMENT ROUTINES.
--------------------------------------------------------------------------------
D2E1:              ;    [A] and [x] have been modified.
D2E1:              
D2E1:              GETSTK:
D2E1: 0a                   ASL     A                    ;Mult [a] by 2. nb, clears c bit.
D2E2: 69 3e                ADC     #2 * NUMLEV + 3 * ADDPRC + 13 ;Make sure 2*NUMLEV+13 locs
D2E4:                                                   ;(13 Because of FBUFFR)
D2E4: b0 1b   D31B         BCS     OMERR                ;Will remain in stack.
D2E6: 85 61                STA     INDEX
D2E8: ba                   TSX                          ;GET stacked.
D2E9: e4 61                CPX     INDEX                ;Compare.
D2EB: 90 1b   D31B         BCC     OMERR                ;IF stack.le.INDEX1, om.
D2ED: 60                   RTS
D2EE:              
D2EE:              ; [Y,a] is a certain address. "REASON" makes sure
D2EE:              ; It is less than [FRETOP]*
D2EE:              
D2EE:              REASON:
D2EE: c4 73                CPY     FRETOP + 1
D2F0: 90 1a   D31A         BCC     REARTS
D2F2: d0 f8   D2F8         BNE     TRYMOR               ;Go garb collect.
D2F4: c5 72                CMP     FRETOP
D2F6: 90 1a   D31A         BCC     REARTS
D2F8:              TRYMOR:
D2F8: 48                   PHA
D2F9: a2 09                LDX     #8 + ADDPRC          ;IF TEMPF2 has ZERO in between.
D2FB: 98                   TYA
D2FC:              REASAV:
D2FC: 48                   PHA
D2FD: b5 97                LDA     HIGHDS - 1,X         ;SAVE HIGHDS on stack.
D2FF: ca                   DEX
D300: 10 fc   D2FC         BPL     REASAV               ;Put 8 of them on stk.
D302: 20 fc e2             JSR     GARBA2               ;Go garb collect.
D305: a2 f7                LDX     #256 - 8 - ADDPRC
D307:              REASTO:
D307: 68                   PLA
D308: 95 a1                STA     HIGHDS + 8 + ADDPRC,X ;Restore after garb collect.
D30A: e8                   INX
D30B: 30 07   D307         BMI     REASTO
D30D: 68                   PLA
D30E: a8                   TAY
D30F: 68                   PLA                          ;Restore a and y.
D310: c4 73                CPY     FRETOP + 1           ;Compare highs
D312: 90 1a   D31A         BCC     REARTS
D314: d0 1b   D31B         BNE     OMERR                ;Higher is bad.
D316: c5 72                CMP     FRETOP               ;And the lows.
D318: b0 1b   D31B         BCS     OMERR
D31A:              REARTS:
D31A: 60                   RTS
D31B:              
D31B:                      .page

