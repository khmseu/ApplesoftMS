001D67  1  4C 81 1D     JMP FADD ;UNPACK AND GO ADD IT.
001D6A  1  20 A6 1F     FSUB: JSR CONUPK ;UNPACK ARGUMENT INTO ARG.
001D6D  1  A5 A5        FSUBT: LDA FACSGN
001D6F  1  49 FF        EOR #255 ;COMPLEMENT IT.
001D71  1  85 A5        STA FACSGN
