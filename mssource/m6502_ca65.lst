00D501  1  D1 9E        CMP (LOWTR),Y
00D503  1  90 18        BCC FLNRTS ;NO SUCH LINE NUMBER.
00D505  1  F0 03        BEQ FNDLO1
00D507  1  88           DEY
00D508  1  D0 09        BNE AFFRTS ;ALWAYS BRANCH.
00D50A  1  A5 53        FNDLO1: LDA LINNUM
00D50C  1  88           DEY
00D50D  1  D1 9E        CMP (LOWTR),Y ;COMPARE LOW ORDERS.
00D50F  1  90 0C        BCC FLNRTS ;NO SUCH NUMBER.
00D511  1  F0 0A        BEQ FLNRTS ;GO TIT.
00D513  1  88           AFFRTS: DEY
00D514  1  B1 9E        LDA (LOWTR),Y ;FETCH LINK.
00D516  1  AA           TAX
00D517  1  88           DEY
00D518  1  B1 9E        LDA (LOWTR),Y
