00DEA5  1  90 05        BCC ISSEC ;CARRY RESET BY CHRGET IF NUMERIC.
00DEA7  1  20 12 DF     JSR ISLETC ;SET CARRY IF NOT ALPHABETIC.
00DEAA  1  90 0B        BCC NOSEC ;ALLOW ALPHABETICS.
00DEAC  1  AA           ISSEC: TAX ;IT IS A NUMBER -- SAVE IN ACCX.
00DEAD  1  20 B2 00     EATEM: JSR CHRGET ;LOOK AT NEXT CHARACTER.
00DEB0  1  90 FB        BCC EATEM ;SKIP NUMERICS.
00DEB2  1  20 12 DF     JSR ISLETC
00DEB5  1  B0 F6        BCS EATEM ;SKIP ALPHABETICS.
