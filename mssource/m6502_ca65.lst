00DC0C  1               ; SUBTTL FORMULA EVALUATION CODE.
00DC0C  1               ;
00DC0C  1               ; THESE ROUTINES CHECK FOR CERTAIN "VALTYP".
00DC0C  1               ; [C] IS NOT PRESERVED.
00DC0C  1               ;
00DC0C  1  20 23 DC     FRMNUM: JSR FRMEVL
00DC0F  1  18           CHKNUM: CLC
00DC10  1  00 02 24 00  .word 512,36
00DC14  1  38           CHKSTR: SEC ;SET CARRY.
00DC15  1  24 11        CHKVAL: BIT VALTYP ;WILL NOT F UP "VALTYP".
00DC17  1  30 03        BMI DOCSTR
00DC19  1  B0 03        BCS CHKERR
00DC1B  1  60           CHKOK: RTS
00DC1C  1  B0 FD        DOCSTR: BCS CHKOK
00DC1E  1  A2 A3        CHKERR: LDX #ERRTM
00DC20  1  4C 1D D3     ERRGO4: JMP ERROR
00DC23  1               ;
00DC23  1               ; THE FORMULA EVALUATOR STARTS WITH
00DC23  1               ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
00DC23  1               ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
00DC23  1               ; THE RESULT IS LEFT IN THE FAC.
00DC23  1               ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
00DC23  1               ;
00DC23  1               ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
00DC23  1               ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR
00DC23  1               ; EACH OPERATOR.
00DC23  1               ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
00DC23  1               ;	THE ADDRESS OF THE OPERATOR ROUTINE.
00DC23  1               ;	THE FLOATING POINT TEMPORARY RESULT.
00DC23  1               ;	THE PRECEDENCE OF THE OPERATOR.
00DC23  1               ;
00DC23  1  A6 B9        FRMEVL: LDX TXTPTR
00DC25  1  D0 02        BNE FRMEV1
00DC27  1  C6 BA        DEC TXTPTR+1
00DC29  1  C6 B9        FRMEV1: DEC TXTPTR
00DC2B  1  A2 00        LDX #0 ;INITIAL DUMMY PRECEDENCE IS 0.
00DC2D  1  00 02 24 00  .word 512,36
00DC31  1  48           LPOPER: PHA ;SAVE LOW PRECEDENCE. (MASK.)
00DC32  1  8A           TXA
00DC33  1  48           PHA ;SAVE HIGH PRECEDENCE.
00DC34  1  A9 01        LDA #1
00DC36  1  20 E1 D2     JSR GETSTK ;MAKE SURE THERE IS ROOM FOR
00DC39  1               ;RECURSIVE CALLS.
00DC39  1  20 0B DD     JSR EVAL ;EVALUATE SOMETHING.
00DC3C  1                ;PREPARE TO BUILD MASK MAYBE.
00DC3C  1  A9 00        LDA #0
00DC3E  1  85 8C        STA OPMASK
00DC40  1  20 B8 00     TSTOP: JSR CHRGOT ;REGET LAST CHARACTER.
