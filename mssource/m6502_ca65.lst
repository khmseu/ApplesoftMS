00126F  1  F0 69        BEQ ERRGO5
001271  1  C8           INY
001272  1  B1 B9        LDA (TXTPTR),Y ;GET HIGH BYTE OF LINE NUMBER.
001274  1  85 7E        STA DATLIN
001276  1  C8           INY
001277  1  B1 B9        LDA (TXTPTR),Y ;GET LOW BYTE.
001279  1  C8           INY
