00DBFA  1  8A           LOOPDN: TXA
00DBFB  1  69 11        ADC #<((2*ADDPRC)+15) ;ADDS 16 WITH CARRY.
00DBFD  1  AA           TAX
00DBFE  1  9A           TXS ;NEW STACK PNTR.
00DBFF  1  20 B8 00     JSR CHRGOT
00DC02  1  C9 2C        CMP #44 ;COMMA AT END?
00DC04  1  D0 F1        BNE NEWSGO
00DC06  1  20 B2 00     JSR CHRGET
