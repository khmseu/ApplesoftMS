00D5D0  1               ;MEMORY DUE TO A BAD LOAD OR BAD
00D5D0  1               ;HARDWARE. LET THE GUY RECOVER
00D5D0  1  B1 9E        LDA (LOWTR),Y ;GET NEXT CHAR. IS IT ZERO?
00D5D2  1  D0 10        BNE QPLOP ;YES. END OF LINE.
00D5D4  1  A8           TAY
00D5D5  1  B1 9E        LDA (LOWTR),Y
00D5D7  1  AA           TAX
00D5D8  1  C8           INY
00D5D9  1  B1 9E        LDA (LOWTR),Y
00D5DB  1  86 9E        STX LOWTR
