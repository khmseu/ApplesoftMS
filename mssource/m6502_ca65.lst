0012DA  1  F0 69        ERRGO5: BEQ ERRGO4
0012DC  1  9A           HAVFOR: TXS ;SETUP STACK. CHOP FIRST.
0012DD  1  8A           TXA
0012DE  1  18           CLC
0012DF  1  69 04        ADC #4 ;POINT TO INCREMENT
0012E1  1  48           PHA ;SAVE THIS POINTER TO RESTORE TO [A]
0012E2  1  69 06        ADC #5+ADDPRC ;POINT TO UPPER LIMIT
0012E4  1  85 63        STA INDEX2 ;SAVE AS INDEX
0012E6  1  68           PLA ;RESTORE POINTER TO INCREMENT
0012E7  1  A0 01        LDY #1 ;SET HI ADDR OF THING TO MOVE.
0012E9  1  20 BF 20     JSR MOVFM ;GET QUANTITY INTO THE FAC.
0012EC  1  BA           TSX
0012ED  1  BD 09 01     LDA 257+7+ADDPRC,X;SET SIGN CORRECTLY.
0012F0  1  85 A5        STA FACSGN
0012F2  1               
0012F2  1  A5 88        LDA FORPNT
