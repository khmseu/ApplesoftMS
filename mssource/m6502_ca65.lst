00ED2D  1               ; PAGE
00ED2D  1               ; SUBTTL	EXPONENTIATION AND SQUARE ROOT FUNCTION.
00ED2D  1               ;SQUARE ROOT FUNCTION --- SQR(A)
00ED2D  1               ;USE SQR(X)=X^.5
00ED2D  1  20 07 EA     SQR: JSR MOVAF ;MOVE FAC INTO ARG.
00ED30  1               
00ED30  1  A9 04        LDA #FHALF&255
00ED32  1  A0 ED        LDY #FHALF/256
00ED34  1  20 9A E9     JSR MOVFM ;PUT MEMORY INTO FAC.
00ED37  1               ;LAST THING FETCHED IS FACEXP. INTO ACCX.
00ED37  1               ;	JMP	FPWRT		;FALL INTO FPWRT.
00ED37  1               
00ED37  1               ;EXPONENTIATION ---  X^Y.
00ED37  1               ;N.B.  0^0=1
00ED37  1               ;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
00ED37  1               ;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
00ED37  1               ;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
00ED37  1               ;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
00ED37  1               ;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
00ED37  1               ;RETURNED BY EXP.
00ED37  1               ;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
00ED37  1  F0 70        FPWRT: BEQ EXP ;IF FAC=0, JUST EXPONENTIATE THAT.
00ED39  1  A5 A8        LDA ARGEXP ;IS X=0?
00ED3B  1  D0 03        BNE FPWRT1
00ED3D  1  4C EE E6     JMP ZEROF1 ;ZERO FAC.
00ED40  1               FPWRT1: ;SAVE FOR LATER IN A TEMP.
00ED40  1  A2 8D        LDX #TEMPF3&255
00ED42  1  A0 00        LDY #TEMPF3/256
00ED44  1  20 CF E9     JSR MOVMF
00ED47  1               ;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
00ED47  1  A5 AD        LDA ARGSGN
00ED49  1  10 0F        BPL FPWR1 ;NO PROBLEMS IF X.GT.0.
00ED4B  1  20 C7 EA     JSR INT ;INTEGERIZE THE FAC.
00ED4E  1                ;GET ADDR OF COMPERAND.
00ED4E  1  A9 8D        LDA #TEMPF3&255
00ED50  1  A0 00        LDY #TEMPF3/256
00ED52  1  20 56 EA     JSR FCOMP ;EQUAL?
00ED55  1  D0 03        BNE FPWR1 ;LEAVE X NEG. LOG WILL BLOW HIM OUT.
00ED57  1               ;A=-1 AND Y IS IRRELEVANT.
00ED57  1  98           TYA ;NEGATE X. MAKE POSITIVE.
00ED58  1  A4 0D        LDY INTEGR ;GET EVENNESS.
00ED5A  1  20 F9 E9     FPWR1: JSR MOVFA1 ;ALTERNATE ENTRY POINT.
00ED5D  1  98           TYA
00ED5E  1  48           PHA ;SAVE EVENNESS FOR LATER.
00ED5F  1  20 DF E7     JSR LOG ;FIND LOG.
00ED62  1                ;MULTIPLY FAC TIMES LOG(X).
00ED62  1  A9 8D        LDA #TEMPF3&255
00ED64  1  A0 00        LDY #TEMPF3/256
00ED66  1  20 1D E8     JSR FMULT
00ED69  1  20 A9 ED     JSR EXP ;EXPONENTIATE THE FAC.
00ED6C  1  68           PLA
00ED6D  1  4A           LSR ;IS IT EVEN?
00ED6E  1  90 0A        BCC NEGRTS ;YES. OR X.GT.0.
00ED70  1               ;NEGATE THE NUMBER IN FAC.
00ED70  1  A5 A0        NEGOP: LDA FACEXP
00ED72  1  F0 06        BEQ NEGRTS
00ED74  1               
00ED74  1  A5 A5        LDA FACSGN
00ED76  1  49 FF        EOR #255
00ED78  1  85 A5        STA FACSGN
00ED7A  1  60           NEGRTS: RTS
00ED7B  1               
00ED7B  1               ; PAGE
00ED7B  1               ; SUBTTL	EXPONENTIATION FUNCTION.
00ED7B  1               ;FIRST SAVE THE ORIGINAL ARGUMENT AND MULTIPLY THE FAC BY
00ED7B  1               ;LOG2(E). THE RESULT IS USED TO DETERMINE IF OVERFLOW
00ED7B  1               ;WILL OCCUR SINCE EXP(X)=2^(X*LOG2(E)) WHERE
00ED7B  1               ;LOG2(E)=LOG(E) BASE 2. THEN SAVE THE INTEGER PART OF
00ED7B  1               ;THIS TO SCALE THE ANSWER AT THE END. SINCE
00ED7B  1               ;2^Y=2^INT(Y)*2^(Y-INT(Y)) AND 2^INT(Y) IS EASY TO COMPUTE.
00ED7B  1               ;NOW COMPUTE 2^(X*LOG2(E)-INT(X*LOG2(E)) BY
00ED7B  1               ;P(LN(2)*(INT(X*LOG2(E))+1)-X) WHERE P IS AN APPROXIMATION
