00247C  1               ;A=-1 AND Y IS IRRELEVANT.
00247C  1  98           TYA ;NEGATE X. MAKE POSITIVE.
00247D  1  A4 0D        LDY INTEGR ;GET EVENNESS.
00247F  1  20 1E 21     FPWR1: JSR MOVFA1 ;ALTERNATE ENTRY POINT.
002482  1  98           TYA
002483  1  48           PHA ;SAVE EVENNESS FOR LATER.
002484  1  20 04 1F     JSR LOG ;FIND LOG.
002487  1                ;MULTIPLY FAC TIMES LOG(X).
