0012C6  1               ; PAGE
0012C6  1               ; SUBTTL	THE NEXT CODE IS THE "NEXT CODE"
0012C6  1               ;
0012C6  1               ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
0012C6  1               ;
0012C6  1               ; LOW ADDRESS
0012C6  1               ;	TOKEN (FORTK) 1 BYTE
0012C6  1               ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
0012C6  1               ;	THE STEP 4+ADDPRC BYTES
0012C6  1               ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
0012C6  1               ;	THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
0012C6  1               ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
0012C6  1               ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
0012C6  1               ; HIGH ADDRESS
0012C6  1               ;
0012C6  1               ; TOTAL 16+2*ADDPRC BYTES.
0012C6  1               ;
0012C6  1  D0 04        NEXT: BNE GETFOR
0012C8  1  A0 00        LDY #0 ;WITHOUT ARG CALL "FNDFOR" WITH
0012CA  1  F0 03        BEQ STXFOR ;[FORPNT]=0.
