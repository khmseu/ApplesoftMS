00DB3E  1  20 2C D8     DATLOP: JSR DATAN ;SKIP SOME TEXT.
00DB41  1  C8           INY
00DB42  1  AA           TAX ;END OF LINE?
00DB43  1  D0 12        BNE NOWLIN ;SHO AIN'T.
00DB45  1  A2 2A        LDX #ERROD ;YES = "NO DATA" ERROR.
00DB47  1  C8           INY
00DB48  1  B1 B9        LDA (TXTPTR),Y
00DB4A  1  F0 69        BEQ ERRGO5
00DB4C  1  C8           INY
00DB4D  1  B1 B9        LDA (TXTPTR),Y ;GET HIGH BYTE OF LINE NUMBER.
00DB4F  1  85 7E        STA DATLIN
00DB51  1  C8           INY
00DB52  1  B1 B9        LDA (TXTPTR),Y ;GET LOW BYTE.
00DB54  1  C8           INY
00DB55  1  85 7F        STA DATLIN+1
00DB57  1  B1 B9        NOWLIN: LDA (TXTPTR),Y ;HOW IS IT?
00DB59  1  AA           TAX
00DB5A  1  20 21 D8     JSR ADDON ;ADD [Y] TO [TXTPTR].
00DB5D  1  E0 7F        CPX #DATATK ;IS IT A "DATA" STATEMENT.
