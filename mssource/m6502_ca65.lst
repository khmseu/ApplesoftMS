00D580  1  20 EF D4     JSR FNDLIN ;FIND LINE .GE. [NUMLIN].
00D583  1  20 B8 00     JSR CHRGOT ;GET LAST CHARACTER.
00D586  1  F0 0C        BEQ LSTEND ;IF END OF LINE, # IS THE END.
00D588  1  C9 81        CMP #MINUTK ;DASH?
00D58A  1  D0 91        BNE FLNRTS ;IF NOT, SYNTAX ERROR.
00D58C  1  20 B2 00     JSR CHRGET ;GET NEXT CHAR.
00D58F  1  20 94 D8     JSR LINGET ;GET END #.
00D592  1  D0 89        BNE FLNRTS ;IF NOT TERMINATOR, ERROR.
00D594  1  68           LSTEND: PLA
00D595  1  68           PLA ;GET RID OF "NEWSTT" RTS ADDR.
00D596  1  A5 53        LDA LINNUM ;SEE IF IT WAS EXISTENT.
00D598  1  05 54        ORA LINNUM+1
