00D5F1  1  C8           RESCR1: INY
00D5F2  1  B9 84 D0     LDA RESLST,Y;END OF ENTRY?
00D5F5  1  10 FA        BPL RESCR1 ;NO, CONTINUE PASSING.
00D5F7  1  30 F5        BMI RESRCH
00D5F9  1  C8           PRIT3: INY
00D5FA  1  B9 84 D0     LDA RESLST,Y
