00D525  1  69 00        ADC #0
00D527  1  85 6D        STA VARTAB+1
00D529  1  20 5B D5     RUNC: JSR STXTPT
00D52C  1  A9 00        LDA #0 ;SET ZERO FLAG
00D52E  1               ;
00D52E  1               ; THIS CODE IS FOR THE CLEAR COMMAND.
00D52E  1               ;
00D52E  1  D0 2A        CLEAR: BNE STKRTS ;SYNTAX ERROR IF NO TERMINATOR.
00D530  1               ;
00D530  1               ; CLEAR INITIALIZES THE VARIABLE AND
00D530  1               ; ARRAY SPACE BY RESETING ARYTAB (THE END OF SIMPLE VARIABLE SPACE)
00D530  1               ; AND STREND (THE END OF ARRAY STORAGE). IT FALLS INTO "STKINI"
00D530  1               ; WHICH RESETS THE STACK.
00D530  1               ;
00D530  1               CLEARC: ;FREE UP STRING SPACE.
00D530  1  A5 76        LDA MEMSIZ
00D532  1  A4 77        LDY MEMSIZ+1
00D534  1               
00D534  1  85 72        STA FRETOP
00D536  1  84 73        STY FRETOP+1
00D538  1               .if EXTIO <> 0
00D538  1               
00D538  1               JSR CQCALL
00D538  1               .endif
00D538  1                ;LIBERATE THE
00D538  1  A5 6C        LDA VARTAB
00D53A  1  A4 6D        LDY VARTAB+1
00D53C  1                ;VARIABLES AND
00D53C  1  85 6E        STA ARYTAB
00D53E  1  84 6F        STY ARYTAB+1
00D540  1                ;ARRAYS.
00D540  1  85 70        STA STREND
00D542  1  84 71        STY STREND+1
00D544  1  20 CF D6     FLOAD: JSR RESTOR ;RESTORE DATA.
00D547  1               ;
00D547  1               ; STKINI RESETS THE STACK POINTER ELIMINATING
00D547  1               ; GOSUB AND FOR CONTEXT. STRING TEMPORARIES ARE FREED
00D547  1               ; UP, SUBFLG IS RESET. CONTINUING IS PROHIBITED.
00D547  1               ; AND A DUMMY ENTRY IS LEFT AT THE BOTTOM OF THE STACK SO "FNDFOR" WILL ALWAYS
00D547  1               ; FIND A NON-"FOR" ENTRY AT THE BOTTOM OF THE STACK.
00D547  1               ;
00D547  1  A2 58        STKINI: LDX #TEMPST ;INITIALIZE STRING TEMPORARIES.
00D549  1  86 55        STX TEMPPT
00D54B  1  68           PLA ;SETUP RETURN ADDRESS.
00D54C  1  A8           TAY
00D54D  1  68           PLA
00D54E  1  A2 FA        LDX #STKEND-257
00D550  1  9A           TXS
00D551  1  48           PHA
00D552  1  98           TYA
00D553  1  48           PHA
00D554  1  A9 00        LDA #0
00D556  1  85 7D        STA OLDTXT+1 ;DISALLOWING CONTINUING
00D558  1  85 14        STA SUBFLG ;ALLOW SUBSCRIPTS.
00D55A  1  60           STKRTS: RTS
00D55B  1               
00D55B  1  18           STXTPT: CLC
00D55C  1  A5 6A        LDA TXTTAB
00D55E  1  69 FF        ADC #255
00D560  1  85 B9        STA TXTPTR
00D562  1  A5 6B        LDA TXTTAB+1
00D564  1  69 FF        ADC #255
00D566  1  85 BA        STA TXTPTR+1 ;SETUP TEXT POINTER.
00D568  1  60           RTS
00D569  1               ; PAGE
00D569  1               ; SUBTTL	THE "LIST" COMMAND.
00D569  1               
00D569  1  90 06        LIST: BCC GOLST ;IT IS A DIGIT.
00D56B  1  F0 04        BEQ GOLST ;IT IS A TERMINATOR.
00D56D  1  C9 81        CMP #MINUTK ;DASH PRECEDING?
00D56F  1  D0 E9        BNE STKRTS ;NO, SO SYNTAX ERROR.
00D571  1  20 88 D8     GOLST: JSR LINGET ;GET LINE NUMBER INTO NUMLIN.
00D574  1  20 E3 D4     JSR FNDLIN ;FIND LINE .GE. [NUMLIN].
00D577  1  20 B8 00     JSR CHRGOT ;GET LAST CHARACTER.
00D57A  1  F0 0C        BEQ LSTEND ;IF END OF LINE, # IS THE END.
00D57C  1  C9 81        CMP #MINUTK ;DASH?
00D57E  1  D0 91        BNE FLNRTS ;IF NOT, SYNTAX ERROR.
00D580  1  20 B2 00     JSR CHRGET ;GET NEXT CHAR.
00D583  1  20 88 D8     JSR LINGET ;GET END #.
00D586  1  D0 89        BNE FLNRTS ;IF NOT TERMINATOR, ERROR.
00D588  1  68           LSTEND: PLA
00D589  1  68           PLA ;GET RID OF "NEWSTT" RTS ADDR.
00D58A  1  A5 53        LDA LINNUM ;SEE IF IT WAS EXISTENT.
00D58C  1  05 54        ORA LINNUM+1
00D58E  1  D0 06        BNE LIST4 ;IT WAS TYPED.
00D590  1  A9 FF        LDA #255
00D592  1  85 53        STA LINNUM
00D594  1  85 54        STA LINNUM+1 ;MAKE IT HUGE.
00D596  1  A0 01        LIST4: LDY #1
00D598  1               .if REALIO-3 = 0
00D598  1               
00D598  1               STY DORES
00D598  1               .endif
00D598  1  B1 9E        LDA (LOWTR),Y ;IS LINK ZERO?
00D59A  1  F0 39        BEQ GRODY ;YES, GO TO READY.
00D59C  1               .if REALIO <> 0
00D59C  1               
00D59C  1  20 DE D6     JSR ISCNTC
00D59F  1               .endif
00D59F  1  20 89 D9     JSR CRDO ;PRINT CRLF TO START WITH.
00D5A2  1  C8           INY
00D5A3  1  B1 9E        LDA (LOWTR),Y
00D5A5  1  AA           TAX
00D5A6  1  C8           INY
00D5A7  1  B1 9E        LDA (LOWTR),Y ;GET LINE NUMBER.
00D5A9  1  C5 54        CMP LINNUM+1 ;SEE IF BEYOND LAST.
00D5AB  1  D0 04        BNE TSTDUN ;GO DETERMINE RELATION.
00D5AD  1  E4 53        CPX LINNUM ;WAS EQUAL SO TEST LOW ORDER.
00D5AF  1  F0 02        BEQ TYPLIN ;EQUAL, SO LIST IT.
00D5B1  1  B0 22        TSTDUN: BCS GRODY ;IF LINE IS GR THAN LAST, THEN DUNE.
00D5B3  1  84 88        TYPLIN: STY LSTPNT
00D5B5  1  20 BC EB     JSR LINPRT ;PRINT AS INT WITHOUT LEADING SPACE.
00D5B8  1  A9 20        LDA #' ' ;ALWAYS PRINT SPACE AFTER NUMBER.
00D5BA  1  A4 88        PRIT4: LDY LSTPNT ;GET POINTER TO LINE BACK.
00D5BC  1  29 7F        AND #127
00D5BE  1  20 F8 D9     PLOOP: JSR OUTDO ;PRINT CHAR.
00D5C1  1               .if REALIO-3 = 0
00D5C1  1               
00D5C1  1               CMP #34
00D5C1  1               BNE PLOOP1
00D5C1  1               
00D5C1  1               LDA DORES
00D5C1  1               EOR #255
00D5C1  1               STA DORES
00D5C1  1               .endif
00D5C1  1  C8           PLOOP1: INY
00D5C2  1  F0 11        BEQ GRODY ;IF WE HAVE PRINTED 256 CHARACTERS
00D5C4  1               ;THE PROGRAM MUST BE MISFORMATED IN
00D5C4  1               ;MEMORY DUE TO A BAD LOAD OR BAD
00D5C4  1               ;HARDWARE. LET THE GUY RECOVER
00D5C4  1  B1 9E        LDA (LOWTR),Y ;GET NEXT CHAR. IS IT ZERO?
00D5C6  1  D0 10        BNE QPLOP ;YES. END OF LINE.
00D5C8  1  A8           TAY
00D5C9  1  B1 9E        LDA (LOWTR),Y
00D5CB  1  AA           TAX
00D5CC  1  C8           INY
00D5CD  1  B1 9E        LDA (LOWTR),Y
00D5CF  1  86 9E        STX LOWTR
00D5D1  1  85 9F        STA LOWTR+1
00D5D3  1  D0 C1        BNE LIST4 ;BRANCH IF SOMETHING TO LIST.
00D5D5  1  4C 38 D3     GRODY: JMP READY
00D5D8  1               ;IS IT A TOKEN?
00D5D8  1  10 E4        QPLOP: BPL PLOOP ;NO, HEAD FOR PRINTER.
00D5DA  1               .if REALIO-3 = 0
00D5DA  1               
00D5DA  1               CMP #PI
00D5DA  1               BEQ PLOOP
00D5DA  1               BIT DORES
00D5DA  1               BMI PLOOP
00D5DA  1               .endif
00D5DA  1  38           SEC
00D5DB  1  E9 7F        SBC #127 ;GET RID OF SIGN BIT AND ADD 1.
00D5DD  1  AA           TAX ;MAKE IT A COUNTER.
00D5DE  1  84 88        STY LSTPNT ;SAVE POINTER TO LINE.
00D5E0  1  A0 FF        LDY #255 ;LOOK AT RES'D WORD LIST.
00D5E2  1  CA           RESRCH: DEX ;IS THIS THE RES'D WORD?
00D5E3  1  F0 08        BEQ PRIT3 ;YES, GO TOSS IT UP..
00D5E5  1  C8           RESCR1: INY
00D5E6  1  B9 80 D0     LDA RESLST,Y;END OF ENTRY?
00D5E9  1  10 FA        BPL RESCR1 ;NO, CONTINUE PASSING.
00D5EB  1  30 F5        BMI RESRCH
00D5ED  1  C8           PRIT3: INY
00D5EE  1  B9 80 D0     LDA RESLST,Y
00D5F1  1  30 C7        BMI PRIT4 ;END OF RESERVED WORD.
00D5F3  1  20 F8 D9     JSR OUTDO ;PRINT IT.
00D5F6  1  D0 F5        BNE PRIT3 ;END OF ENTRY? NO, TYPE REST.
00D5F8  1               ; PAGE
00D5F8  1               ; SUBTTL THE "FOR" STATEMENT.
00D5F8  1               ;
00D5F8  1               ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
00D5F8  1               ;
00D5F8  1               ; LOW ADDRESS
00D5F8  1               ;	TOKEN (FORTK) 1 BYTE
00D5F8  1               ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
00D5F8  1               ;	THE STEP 4+ADDPRC BYTES
00D5F8  1               ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
00D5F8  1               ;	THE UPPER VALUE 4+ADDPRC BYTES
00D5F8  1               ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
00D5F8  1               ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
00D5F8  1               ; HIGH ADDRESS
00D5F8  1               ;
00D5F8  1               ; TOTAL 16+2*ADDPRC BYTES.
00D5F8  1               ;
00D5F8  1               
00D5F8  1  A9 80        FOR: LDA #128 ;DON'T RECOGNIZE
00D5FA  1  85 14        STA SUBFLG ;SUBSCRIPTED VARIABLES.
00D5FC  1  20 C2 D8     JSR LET ;READ THE VARIABLE AND ASSIGN IT
00D5FF  1               ;THE CORRECT INITIAL VALUE AND STORE
00D5FF  1               ;A POINTER TO THE VARIABLE IN VARPNT.
00D5FF  1  20 64 D2     JSR FNDFOR ;PNTR IS IN VARPNT, AND FORPNT.
00D602  1  D0 05        BNE NOTOL ;IF NO MATCH, DON'T ELIMINATE ANYTHING.
00D604  1  8A           TXA ;MAKE IT ARITHMETICAL.
00D605  1  69 0F        ADC #FORSIZ-3 ;ELIMINATE ALMOST ALL.
00D607  1  AA           TAX ;NOTE C=1, THEN PLA, PLA.
00D608  1  9A           TXS ;MANIFEST.
00D609  1  68           NOTOL: PLA ;GET RID OF NEWSTT RETURN ADDRESS
00D60A  1  68           PLA ;IN CASE THIS IS A TOTALLY NEW ENTRY.
00D60B  1  A9 09        LDA #8+ADDPRC
00D60D  1  20 D5 D2     JSR GETSTK ;MAKE SURE 16 BYTES ARE AVAILABLE.
00D610  1  20 20 D8     JSR DATAN ;GET A COUNT IN [Y] OF THE NUMBER OF
00D613  1               ;CHACRACTERS LEFT IN THE "FOR" STATEMENT
00D613  1               ;[TXTPTR] IS UNAFFECTED.
00D613  1  18           CLC ;PREP TO ADD.
00D614  1  98           TYA ;SAVE IT FOR PUSHING.
00D615  1  65 B9        ADC TXTPTR
00D617  1  48           PHA
00D618  1  A5 BA        LDA TXTPTR+1
00D61A  1  69 00        ADC #0
00D61C  1  48           PHA
00D61D  1                ;PUT LINE NUMBER ON STACK.
00D61D  1  A5 79        LDA CURLIN+1
00D61F  1  48           PHA
00D620  1  A5 78        LDA CURLIN
00D622  1  48           PHA
00D623  1                ;"TO" IS NECESSARY.
00D623  1  A9 80        LDA #TOTK
00D625  1  20 68 DD     JSR SYNCHR
00D628  1  20 03 DC     JSR CHKNUM ;VALUE MUST BE A NUMBER.
00D62B  1  20 00 DC     JSR FRMNUM ;GET UPPER VALUE INTO FAC.
00D62E  1  A5 A5        LDA FACSGN ;PACK FAC.
00D630  1  09 7F        ORA #127
00D632  1  25 A1        AND FACHO
00D634  1  85 A1        STA FACHO ;SET PACKED SIGN BIT.
00D636  1               
00D636  1  A9 41        LDA #LDFONE&255
00D638  1  A0 D6        LDY #LDFONE/256
00D63A  1               
00D63A  1  85 61        STA INDEX1
00D63C  1  84 62        STY INDEX1+1
00D63E  1  4C BF DC     JMP FORPSH ;PUT FAC ONTO STACK, PACKED.
00D641  1               LDFONE: ;PUT 1.0 INTO FAC.
00D641  1  A9 A5        LDA #FONE&255
00D643  1  A0 E7        LDY #FONE/256
00D645  1  20 8E E9     JSR MOVFM
00D648  1  20 B8 00     JSR CHRGOT
00D64B  1  C9 81        CMP #STEPTK ;A STEP IS GIVEN?
00D64D  1  D0 06        BNE ONEON ;NO. ASSUME 1.0.
00D64F  1  20 B2 00     JSR CHRGET ;YES. ADVANCE POINTER.
00D652  1  20 00 DC     JSR FRMNUM ;READ THE STEP.
00D655  1  20 1A EA     ONEON: JSR SIGN ;GET SIGN IN ACCA.
00D658  1  20 B4 DC     JSR PUSHF ;PUSH FAC ONTO STACK (THRU A).
00D65B  1                ;PUT PNTR TO VARIABLE ON STACK.
00D65B  1  A5 89        LDA FORPNT+1
00D65D  1  48           PHA
00D65E  1  A5 88        LDA FORPNT
00D660  1  48           PHA
00D661  1  A9 7F        NXTCON: LDA #FORTK ;PUT A FORTK ONTO STACK.
00D663  1  48           PHA
00D664  1               ;	BNEA	NEWSTT		;SIMULATE BNE TO NEWSTT. JUST FALL IN.
00D664  1               ; PAGE
00D664  1               ; SUBTTL	NEW STATEMENT FETCHER.
00D664  1               ;
00D664  1               ; BACK HERE FOR NEW STATEMENT. CHARACTER POINTED TO BY TXTPTR
00D664  1               ; IS ':' OR END-OF-LINE. THE ADDRESS OF THIS LOC IS LEFT
00D664  1               ; ON THE STACK WHEN A STATEMENT IS EXECUTED SO THAT
00D664  1               ; IT CAN MERELY DO A RTS WHEN IT IS DONE.
00D664  1               ;
00D664  1               NEWSTT:
00D664  1               .if REALIO <> 0
00D664  1  20 DE D6     JSR ISCNTC ;LISTEN FOR CONTROL-C.
00D667  1               .endif
00D667  1                ;LOOK AT CURRENT CHARACTER.
00D667  1  A5 B9        LDA TXTPTR
00D669  1  A4 BA        LDY TXTPTR+1
00D66B  1               .if BUFPAG <> 0
