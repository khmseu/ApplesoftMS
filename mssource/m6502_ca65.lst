00D7AB  1               ;
00D7AB  1               ; A GOSUB ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
00D7AB  1               ;
00D7AB  1               ; LOW ADDRESS:
00D7AB  1               ;	THE GOSUTK ONE BYTE
00D7AB  1               ;	THE LINE NUMBER OF THE GOSUB STATEMENT TWO BYTES
00D7AB  1               ;	A POINTER INTO THE TEXT OF THE GOSUB TWO BYTES
00D7AB  1               ;
00D7AB  1               ; HIGH ADDRESS.
00D7AB  1               ;
00D7AB  1               ; TOTAL FIVE BYTES.
00D7AB  1               ;
00D7AB  1  A9 03        GOSUB: LDA #3
