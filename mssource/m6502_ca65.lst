00245C  1               
00245C  1               ;EXPONENTIATION ---  X^Y.
00245C  1               ;N.B.  0^0=1
00245C  1               ;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
00245C  1               ;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
00245C  1               ;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
00245C  1               ;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
00245C  1               ;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
00245C  1               ;RETURNED BY EXP.
00245C  1               ;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
00245C  1  F0 70        FPWRT: BEQ EXP ;IF FAC=0, JUST EXPONENTIATE THAT.
00245E  1  A5 A8        LDA ARGEXP ;IS X=0?
002460  1  D0 03        BNE FPWRT1
002462  1  4C 13 1E     JMP ZEROF1 ;ZERO FAC.
