00E255  1  68           PLA
00E256  1  68           PLA
00E257  1               TIMSTR:
00E257  1  A9 FF        LDA #LOFBUF&255
00E259  1  A0 00        LDY #LOFBUF/256
00E25B  1  F0 12        BEQ STRLIT ;SCAN IT AND TURN IT INTO A STRING.
00E25D  1               ;
00E25D  1               ; "STRINI" GET STRING SPACE FOR THE CREATION OF A STRING AND
00E25D  1               ; CREATES A DESCRIPTOR FOR IT IN "DSCTMP".
00E25D  1               ;
00E25D  1               STRINI: ;GET FACMO TO STORE IN DSCPNT.
00E25D  1  A6 A3        LDX FACMO
00E25F  1  A4 A4        LDY FACMO+1
00E261  1                ;RETAIN THE DESCRIPTOR POINTER.
00E261  1  86 8F        STX DSCPNT
00E263  1  84 90        STY DSCPNT+1
00E265  1  20 DC E2     STRSPA: JSR GETSPA ;GET STRING SPACE.
00E268  1                ;SAVE LOCATION.
00E268  1  86 A1        STX DSCTMP+1
00E26A  1  84 A2        STY DSCTMP+1+1
00E26C  1  85 A0        STA DSCTMP ;SAVE LENGTH.
00E26E  1  60           RTS ;ALL DONE.
00E26F  1               ;
00E26F  1               ; "STRLT2" TAKES THE STRING LITERAL WHOSE FIRST CHARACTER
00E26F  1               ; IS POINTED TO BY [Y,A] AND BUILDS A DESCRIPTOR FOR IT.
00E26F  1               ; THE DESCRIPTOR IS INITIALLY BUILT IN "DSCTMP", BUT "PUTNEW"
00E26F  1               ; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER
00E26F  1               ; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN
00E26F  1               ; ZERO THAT TERMINATE THE STRING SHOULD BE SET UP IN "CHARAC"
00E26F  1               ; AND "ENDCHR". IF THE TERMINATOR IS A QUOTE, THE QUOTE IS SKIPPED
00E26F  1               ; OVER. LEADING QUOTES SHOULD BE SKIPPED BEFORE JSR. ON RETURN
00E26F  1               ; THE CHARACTER AFTER THE STRING LITERAL IS POINTED TO
00E26F  1               ; BY [STRNG2].
00E26F  1               ;
00E26F  1  A2 22        STRLIT: LDX #34 ;ASSUME STRING ENDS ON QUOTE.
00E271  1  86 0D        STX CHARAC
00E273  1  86 0E        STX ENDCHR
