00D5C4  1  A9 20        LDA #' ' ;ALWAYS PRINT SPACE AFTER NUMBER.
00D5C6  1  A4 88        PRIT4: LDY LSTPNT ;GET POINTER TO LINE BACK.
00D5C8  1  29 7F        AND #127
