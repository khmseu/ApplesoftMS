00D4E2  1  60           LISTRT: RTS ;RETURN TO CALLER.
00D4E3  1               ;
00D4E3  1               ; FNDLIN SEARCHES THE PROGRAM TEXT FOR THE LINE
00D4E3  1               ; WHOSE NUMBER IS PASSED IN "LINNUM".
00D4E3  1               ; THERE ARE TWO POSSIBLE RETURNS:
00D4E3  1               ;
00D4E3  1               ;	1) CARRY SET.
00D4E3  1               ;	   LOWTR POINTS TO THE LINK FIELD IN THE LINE
00D4E3  1               ;	   WHICH IS THE ONE SEARCHED FOR.
00D4E3  1               ;
00D4E3  1               ;	2) CARRY NOT SET.
00D4E3  1               ;	   LINE NOT FOUND. [LOWTR] POINTS TO THE LINE IN THE
00D4E3  1               ;	   PROGRAM GREATER THAN THE ONE SOUGHT AFTER.
00D4E3  1               ;
00D4E3  1               FNDLIN: ;LOAD [X,A] WITH [TXTTAB]
00D4E3  1  A5 6A        LDA TXTTAB
00D4E5  1  A6 6B        LDX TXTTAB+1
00D4E7  1  A0 01        FNDLNC: LDY #1
00D4E9  1                ;STORE [X,A] INTO LOWTR
00D4E9  1  85 9E        STA LOWTR
00D4EB  1  86 9F        STX LOWTR+1
00D4ED  1  B1 9E        LDA (LOWTR),Y ;SEE IF LINK IS 0
00D4EF  1  F0 1F        BEQ FLINRT
00D4F1  1  C8           INY
00D4F2  1  C8           INY
00D4F3  1  A5 54        LDA LINNUM+1 ;COMP HIGH ORDERS OF LINE NUMBERS.
00D4F5  1  D1 9E        CMP (LOWTR),Y
00D4F7  1  90 18        BCC FLNRTS ;NO SUCH LINE NUMBER.
00D4F9  1  F0 03        BEQ FNDLO1
00D4FB  1  88           DEY
00D4FC  1  D0 09        BNE AFFRTS ;ALWAYS BRANCH.
00D4FE  1  A5 53        FNDLO1: LDA LINNUM
00D500  1  88           DEY
00D501  1  D1 9E        CMP (LOWTR),Y ;COMPARE LOW ORDERS.
00D503  1  90 0C        BCC FLNRTS ;NO SUCH NUMBER.
00D505  1  F0 0A        BEQ FLNRTS ;GO TIT.
00D507  1  88           AFFRTS: DEY
00D508  1  B1 9E        LDA (LOWTR),Y ;FETCH LINK.
00D50A  1  AA           TAX
00D50B  1  88           DEY
00D50C  1  B1 9E        LDA (LOWTR),Y
00D50E  1  B0 D7        BCS FNDLNC ;ALWAYS BRANCHES.
00D510  1  18           FLINRT: CLC ;C MAY BE HIGH.
00D511  1  60           FLNRTS: RTS ;RETURN TO CALLER.
00D512  1               ;
00D512  1               ; THE "NEW" COMMAND CLEARS THE PROGRAM TEXT AS WELL
00D512  1               ; AS VARIABLE SPACE.
00D512  1               ;
00D512  1  D0 FD        SCRATH: BNE FLNRTS ;MAKE SURE THERE IS A TERMINATOR.
