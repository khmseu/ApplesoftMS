000FB9  1               ; SUBTTL	LINGET -- READ A LINE NUMBER INTO LINNUM
000FB9  1               ;
000FB9  1               ; "LINGET" READS A LINE NUMBER FROM THE CURRENT TEXT POSITION.
000FB9  1               ;
000FB9  1               ; LINE NUMBERS RANGE FROM 0 TO 64000-1.
000FB9  1               ;
