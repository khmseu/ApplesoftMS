00DE7B  1               ; PAGE
00DE7B  1               ; SUBTTL	DIMENSION AND VARIABLE SEARCHING.
00DE7B  1               ;
00DE7B  1               ; THE "DIM" CODE SETS [DIMFLG] AND THEN FALLS INTO THE VARIABLE SEARCH
00DE7B  1               ; ROUTINE, WHICH LOOKS AT DIMFLG AT THREE DIFFERENT POINTS.
00DE7B  1               ;	1) IF AN ENTRY IS FOUND, "DIMFLG" BEING ON INDICATES
00DE7B  1               ;		A "DOUBLY" DIMENSIONED VARIABLE.
00DE7B  1               ;	2) WHEN A NEW ENTRY IS BEING BUILT "DIMFLG" BEING ON
00DE7B  1               ;		INDICTAES THE INDICES SHOULD BE USED FOR THE
00DE7B  1               ;		SIZE OF EACH INDEX. OTHERWISE THE DEFAULT OF TEN
00DE7B  1               ;		IS USED.
00DE7B  1               ;	3) WHEN THE BUILD ENTRY CODE FINISHES, ONLY IF "DIMFLG" IS OFF
00DE7B  1               ;		WILL INDEXING BE DONE.
00DE7B  1               ;
00DE7B  1  20 66 DD     DIM3: JSR CHKCOM ;MUST BE A COMMA
00DE7E  1  AA           DIM: TAX ;SET [ACCX] NONZERO.
00DE7F  1               ;[ACCA] MUST BE NONZERO TO WORK RIGHT.
00DE7F  1  20 8D DE     DIM1: JSR PTRGT1
00DE82  1  20 B8 00     DIMCON: JSR CHRGOT ;GET LAST CHARACTER.
00DE85  1  D0 F4        BNE DIM3
00DE87  1  60           RTS
00DE88  1               ;
00DE88  1               ; ROUTINE TO READ THE VARIABLE NAME AT THE CURRENT TEXT POSITION
00DE88  1               ; AND  PUT A POINTER TO ITS VALUE IN VARPNT. [TXTPTR]
00DE88  1               ; POINTS TO THE TERMINATING CHARCTER.. NOT THAT EVALUATING SUBSCRIPTS
00DE88  1               ; IN A VARIABLE NAME CAN CAUSE RECURSIVE CALLS TO "PTRGET" SO AT
00DE88  1               ; THAT POINT ALL VALUES MUST BE STORED ON THE STACK.
00DE88  1               ;
00DE88  1  A2 00        PTRGET: LDX #0 ;MAKE [ACCX]=0.
00DE8A  1  20 B8 00     JSR CHRGOT ;RETRIEVE LAST CHARACTER.
00DE8D  1  86 10        PTRGT1: STX DIMFLG ;STORE FLAG AWAY.
00DE8F  1  85 84        PTRGT2: STA VARNAM
00DE91  1  20 B8 00     JSR CHRGOT ;GET CURRENT CHARACTER
00DE94  1               ;MAYBE WITH FUNCTION BIT OFF.
00DE94  1  20 12 DF     JSR ISLETC ;CHECK FOR LETTER.
00DE97  1  B0 03        BCS PTRGT3 ;MUST HAVE A LETTER.
00DE99  1  4C 71 DD     INTERR: JMP SNERR
00DE9C  1  A2 00        PTRGT3: LDX #0 ;ASSUME NO SECOND CHARACTER.
00DE9E  1  86 11        STX VALTYP ;DEFAULT IS NUMERIC.
00DEA0  1               .if INTPRC <> 0
00DEA0  1               
