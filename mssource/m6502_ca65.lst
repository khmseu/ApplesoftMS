00229F  1  20 2C 21     JSR MOVAF ;SAVE FAC FOR LATER.
0022A2  1  68           PLA
0022A3  1  20 5C 21     JSR FLOAT ;FLOAT THE VALUE IN ACCA.
0022A6  1  A5 AD        LDA ARGSGN
0022A8  1  45 A5        EOR FACSGN
0022AA  1  85 AE        STA ARISGN ;RESULTANT SIGN.
0022AC  1  A6 A0        LDX FACEXP ;SET SIGNS ON THING TO ADD.
0022AE  1  4C 84 1D     JMP FADDT ;ADD TOGETHER AND RETURN.
0022B1  1               
0022B1  1               ;HERE PACK IN THE NEXT DIGIT OF THE EXPONENT.
0022B1  1               ;MULTIPLY THE OLD EXP BY 10 AND ADD IN THE NEXT
0022B1  1               ;DIGIT. NOTE: EXP OVERFLOW IS NOT CHECKED FOR.
0022B1  1  A5 9D        FINEDG: LDA TENEXP ;GET EXP SO FAR.
0022B3  1  C9 0A        CMP #10 ;WILL RESULT BE .GE. 100?
0022B5  1  90 09        BCC MLEX10
0022B7  1  A9 64        LDA #100 ;GET 100.
0022B9  1  24 9F        BIT EXPSGN
0022BB  1  30 11        BMI MLEXMI ;IF NEG EXP, NO CHK FOR OVERR.
0022BD  1  4C 98 1E     JMP OVERR
0022C0  1  0A           MLEX10: ASL ;MULT BY 2 TWICE
0022C1  1  0A           ASL
0022C2  1  18           CLC ;POSSIBLE SHIFT OUT OF HIGH.
0022C3  1  65 9D        ADC TENEXP ;LIKE MULTIPLYING BY FIVE.
0022C5  1  0A           ASL ;AND NOW BY TEN.
0022C6  1  18           CLC
0022C7  1  A0 00        LDY #0
0022C9  1  71 B9        ADC (TXTPTR),Y
0022CB  1  38           SEC
0022CC  1  E9 30        SBC #'0'
0022CE  1  85 9D        MLEXMI: STA TENEXP ;SAVE RESULT.
0022D0  1  4C 50 22     JMP FINEC
