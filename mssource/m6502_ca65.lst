00D470  1  D0 04        BNE KLOOP1
00D472  1  A9 7F        LDA #PRINTK ;YES, STUFF A "PRINT" TOKEN.
00D474  1  D0 25        BNE STUFFH ;ALWAYS GO TO STUFFH.
00D476  1  C9 30        KLOOP1: CMP #'0' ;SKIP NUMERICS.
00D478  1  90 04        BCC MUSTCR
00D47A  1  C9 3C        CMP #60 ;':' AND ';' ARE ENTERED STRAIGHTAWAY.
00D47C  1  90 1D        BCC STUFFH
00D47E  1  84 B0        MUSTCR: STY BUFPTR ;SAVE BUFFER POINTER.
00D480  1  A0 00        LDY #0 ;LOAD RESLST POINTER.
00D482  1  84 0F        STY COUNT ;ALSO CLEAR COUNT.
00D484  1  88           DEY
00D485  1  86 B9        STX TXTPTR ;SAVE TEXT POINTER FOR LATER USE.
00D487  1  CA           DEX
00D488  1  C8           RESER: INY
00D489  1  E8           RESPUL: INX
00D48A  1  BD 00 02     RESCON: LDA BUFOFS,X
00D48D  1  38           SEC ;PREPARE TO SUBSTARCT.
00D48E  1  F9 80 D0     SBC RESLST,Y ;CHARACTERS EQUAL?
00D491  1  F0 F5        BEQ RESER ;YES, CONTINUE SEARCH.
00D493  1  C9 80        CMP #128 ;NO BUT MAYBE THE END IS HERE.
00D495  1  D0 30        BNE NTHIS ;NO, TRULY UNEQUAL.
00D497  1  05 0F        ORA COUNT
00D499  1  A4 B0        GETBPT: LDY BUFPTR ;GET BUFFER PNTR.
00D49B  1  E8           STUFFH: INX
00D49C  1  C8           INY
00D49D  1  99 FB 01     STA BUF-5,Y
00D4A0  1  B9 FB 01     LDA BUF-5,Y
00D4A3  1  F0 36        BEQ CRDONE ;NULL IMPLIES END OF LINE.
00D4A5  1  38           SEC ;PREPARE TO SUBSTARCT.
00D4A6  1  E9 3A        SBC #':' ;IS IT A ':'?
00D4A8  1  F0 04        BEQ COLIS ;YES, ALLOW CRUNCHING AGAIN.
00D4AA  1  C9 45        CMP #DATATK-':' ;IS IT A DATATK?
00D4AC  1  D0 02        BNE NODATT ;NO, SEE IF IT IS REM TOKEN.
00D4AE  1  85 13        COLIS: STA DORES ;SETUP FLAG.
00D4B0  1  38           NODATT: SEC ;PREP TO SBCQ
00D4B1  1  E9 45        SBC #REMTK-':' ;REM ONLY STOPS ON NULL.
00D4B3  1  D0 A8        BNE KLOOP ;NO, CONTINUE CRUNCHING.
00D4B5  1  85 0E        STA ENDCHR ;REM STOPS ONLY ON NULL, NOT : OR ".
00D4B7  1  BD 00 02     STR1: LDA BUFOFS,X
00D4BA  1  F0 DF        BEQ STUFFH ;YES, END OF LINE, SO DONE.
00D4BC  1  C5 0E        CMP ENDCHR ;END OF GOBBLE?
00D4BE  1  F0 DB        BEQ STUFFH ;YES, DONE WITH STRING.
00D4C0  1  C8           STRNG: INY ;INCREMENT BUFFER POINTER.
00D4C1  1  99 FB 01     STA BUF-5,Y
00D4C4  1  E8           INX
