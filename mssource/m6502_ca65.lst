00D270  1               ; PAGE
00D270  1               ; SUBTTL	GENERAL STORAGE MANAGEMENT ROUTINES.
00D270  1               ;
00D270  1               ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
00D270  1               ;
00D270  1               FORSIZ .set 18
00D270  1  BA           FNDFOR: TSX ;LOAD XREG WITH STK PNTR.
00D271  1  E8           INX
00D272  1  E8           INX
00D273  1  E8           INX
00D274  1  E8           INX
00D275  1  BD 01 01     FFLOOP: LDA 257,X ;GET STACK ENTRY.
00D278  1  C9 7F        CMP #FORTK ;IS IT A "FOR" TOKEN?
00D27A  1  D0 21        BNE FFRTS ;NO, NO "FOR" LOOPS WITH THIS PNTR.
00D27C  1  A5 89        LDA FORPNT+1 ;GET HIGH.
00D27E  1  D0 0A        BNE CMPFOR
00D280  1  BD 02 01     LDA 258,X ;PNTR IS ZERO, SO ASSUME THIS ONE.
00D283  1  85 88        STA FORPNT
00D285  1  BD 03 01     LDA 259,X
00D288  1  85 89        STA FORPNT+1
00D28A  1  DD 03 01     CMPFOR: CMP 259,X
00D28D  1  D0 07        BNE ADDFRS ;NOT THIS ONE.
00D28F  1  A5 88        LDA FORPNT ;GET DOWN.
00D291  1  DD 02 01     CMP 258,X
00D294  1  F0 07        BEQ FFRTS ;WE GOT IT! WE GOT IT!
00D296  1  8A           ADDFRS: TXA
00D297  1  18           CLC ;ADD 16 TO X.
00D298  1  69 12        ADC #FORSIZ
00D29A  1  AA           TAX ;RESULT BACK INTO X.
00D29B  1  D0 D8        BNE FFLOOP
00D29D  1  60           FFRTS: RTS ;RETURN TO CALLER.
00D29E  1               
00D29E  1               ;
00D29E  1               ; THIS IS THE BLOCK TRANSFER ROUTINE.
00D29E  1               ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
00D29E  1               ;
00D29E  1               ; ON ENTRY:
00D29E  1               ; [Y,A]=[HIGHDS]    (FOR REASON).
00D29E  1               ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
00D29E  1               ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
00D29E  1               ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
00D29E  1               ;
00D29E  1               ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
00D29E  1               ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
00D29E  1               ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
00D29E  1               ;
00D29E  1               ; ON EXIT:
00D29E  1               ; [LOWTR] ARE UNCHANGED.
00D29E  1               ; [HIGHTR]=[LOWTR]-200 OCTAL.
00D29E  1               ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
00D29E  1               ;
00D29E  1  20 EE D2     BLTU: JSR REASON ;ASCERTAIN THAT STRING SPACE WON'T
00D2A1  1               ;BE OVERRUN.
00D2A1  1               
00D2A1  1  85 70        STA STREND
00D2A3  1  84 71        STY STREND+1
00D2A5  1  38           BLTUC: SEC ;PREPARE TO SUBTRACT.
00D2A6  1  A5 99        LDA HIGHTR
00D2A8  1  E5 9E        SBC LOWTR ;COMPUTE NUMBER OF THINGS TO MOVE.
00D2AA  1  85 61        STA INDEX ;SAVE FOR LATER.
00D2AC  1  A8           TAY
00D2AD  1  A5 9A        LDA HIGHTR+1
00D2AF  1  E5 9F        SBC LOWTR+1
00D2B1  1  AA           TAX ;PUT IT IN A COUNTER REGISTER.
00D2B2  1  E8           INX ;SO THAT COUNTER ALGORITHM WORKS.
00D2B3  1  98           TYA ;SEE IF LOW PART OF COUNT IS ZERO.
00D2B4  1  F0 23        BEQ DECBLT ;YES, GO START MOVING BLOCKS.
00D2B6  1  A5 99        LDA HIGHTR ;NO, MUST MODIFY BASE ADDR.
