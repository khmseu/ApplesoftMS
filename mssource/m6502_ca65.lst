001D63  1               
001D63  1               ; SUBTTL FLOATING POINT MATH PACKAGE CONFIGURATION.
001D63  1               
001D63  1               ; RADIX	8 ;!!!! ALERT !!!!
001D63  1               ;THROUGHOUT THE MATH PACKAGE.
001D63  1               ; COMMENT %
001D63  1               ; THE FLOATING POINT FORMAT IS AS FOLLOWS:
001D63  1               ;
001D63  1               ; THE SIGN IS THE FIRST BIT OF THE MANTISSA.
001D63  1               ; THE MANTISSA IS 24 BITS LONG.
001D63  1               ; THE BINARY POINT IS TO THE LEFT OF THE MSB.
001D63  1               ; NUMBER = MANTISSA * 2 ^ EXPONENT.
001D63  1               ; THE MANTISSA IS POSITIVE WITH A ONE ASSUMED TO BE WHERE THE SIGN BIT IS.
001D63  1               ; THE SIGN OF THE EXPONENT IS THE FIRST BIT OF THE EXPONENT.
001D63  1               ; THE EXPONENT IS STORED IN EXCESS 200, I.E. WITH A BIAS OF +200.
001D63  1               ; SO, THE EXPONENT IS A SIGNED 8-BIT NUMBER WITH 200 ADDED TO IT.
001D63  1               ; AN EXPONENT OF ZERO MEANS THE NUMBER IS ZERO.
001D63  1               ; THE OTHER BYTES MAY NOT BE ASSUMED TO BE ZERO.
001D63  1               ; TO KEEP THE SAME NUMBER IN THE FAC WHILE SHIFTING,
001D63  1               ; 	TO SHIFT RIGHT, EXP:=EXP+1
001D63  1               ; 	TO SHIFT LEFT,	EXP:=EXP-1
001D63  1               ;
001D63  1               ; IN MEMORY THE NUMBER LOOKS LIKE THIS:
001D63  1               ; 	[THE EXPONENT AS A SIGNED NUMBER +200]
001D63  1               ; 	[THE SIGN BIT IN 7, BITS 2-8 OF MANTISSA ARE IN BITS 6-0].
001D63  1               ; 		(REMEMBER BIT 1 OF MANTISSA IS ALWAYS A ONE.)
001D63  1               ; 	[BITS 9-16 OF THE MANTISSA]
001D63  1               ; 	[BITS 17-24] OF THE MANTISSA]
001D63  1               ;
001D63  1               ; ARITHMETIC ROUTINE CALLING CONVENTIONS:
001D63  1               ;
001D63  1               ; FOR ONE ARGUMENT FUNCTIONS:
001D63  1               ; 	THE ARGUMENT IS IN THE FAC.
001D63  1               ; 	THE RESULT IS LEFT IN THE FAC.
001D63  1               ; FOR TWO ARGUMENT OPERATIONS:
001D63  1               ; 	THE FIRST ARGUMENT IS IN ARG (ARGEXP,HO,MO,LO AND ARGSGN).
001D63  1               ; 	THE SECOND ARGUMENT IS IN THE FAC.
001D63  1               ; 	THE RESULT IS LEFT IN THE FAC.
001D63  1               ;
001D63  1               ; THE 'T' ENTRY POINTS TO THE TWO-ARGUMENT OPERATIONS HAVE BOTH ARGUMENTS
001D63  1               ; SETUP IN THE RESPECTIVE REGISTERS. BEFORE CALLING ARG MAY HAVE BEEN
001D63  1               ; POPPED OFF THE STACK AND INTO ARG, FOR EXAMPLE.
001D63  1               ; THE OTHER ENTRY POINT ASSUMES [Y,A] POINTS TO THE ARGUMENT
001D63  1               ; SOMEWHERE IN MEMORY. IT IS UNPACKED INTO ARG BY "CONUPK".
001D63  1               ;
001D63  1               ; ON THE STACK, THE SGN IS PUSHED ON FIRST, THE LO,MO,HO AND FINALLY EXP.
001D63  1               ; NOTE ALL THINGS ARE KEPT UNPACKED IN ARG, FAC AND ON THE STACK.
001D63  1               ;
001D63  1               ; IT IS ONLY WHEN SOMETHING IS STORED AWAY THAT IT IS PACKED TO FOUR
001D63  1               ; BYTES. THE UNPACKED FORMAT HAS A SGN BYTE REFLECTING THE SIGN OF THE
001D63  1               ; NUMBER (POSITIVE=0, NEGATIVE=-1) A HO,MO AND LO WITH THE HIGH BIT
001D63  1               ; OF THE HO TURNED ON. THE EXP IS THE SAME AS STORED FORMAT.
001D63  1               ; THIS IS DONE FOR SPEED OF OPERATION.
001D63  1               ; %
001D63  1               ; PAGE
001D63  1               ; SUBTTL	FLOATING POINT ADDITION AND SUBTRACTION.
001D63  1               FADDH: ;ENTRY TO ADD 1/2.
001D63  1  A9 29        LDA #FHALF&255
