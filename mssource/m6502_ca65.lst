00E261  1  68           PLA
00E262  1  68           PLA
00E263  1               TIMSTR:
00E263  1  A9 FF        LDA #LOFBUF&255
00E265  1  A0 00        LDY #LOFBUF/256
00E267  1  F0 12        BEQ STRLIT ;SCAN IT AND TURN IT INTO A STRING.
00E269  1               ;
00E269  1               ; "STRINI" GET STRING SPACE FOR THE CREATION OF A STRING AND
00E269  1               ; CREATES A DESCRIPTOR FOR IT IN "DSCTMP".
00E269  1               ;
00E269  1               STRINI: ;GET FACMO TO STORE IN DSCPNT.
00E269  1  A6 A3        LDX FACMO
00E26B  1  A4 A4        LDY FACMO+1
00E26D  1                ;RETAIN THE DESCRIPTOR POINTER.
00E26D  1  86 8F        STX DSCPNT
00E26F  1  84 90        STY DSCPNT+1
00E271  1  20 E8 E2     STRSPA: JSR GETSPA ;GET STRING SPACE.
00E274  1                ;SAVE LOCATION.
00E274  1  86 A1        STX DSCTMP+1
00E276  1  84 A2        STY DSCTMP+1+1
00E278  1  85 A0        STA DSCTMP ;SAVE LENGTH.
00E27A  1  60           RTS ;ALL DONE.
00E27B  1               ;
00E27B  1               ; "STRLT2" TAKES THE STRING LITERAL WHOSE FIRST CHARACTER
00E27B  1               ; IS POINTED TO BY [Y,A] AND BUILDS A DESCRIPTOR FOR IT.
00E27B  1               ; THE DESCRIPTOR IS INITIALLY BUILT IN "DSCTMP", BUT "PUTNEW"
00E27B  1               ; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER
00E27B  1               ; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN
00E27B  1               ; ZERO THAT TERMINATE THE STRING SHOULD BE SET UP IN "CHARAC"
00E27B  1               ; AND "ENDCHR". IF THE TERMINATOR IS A QUOTE, THE QUOTE IS SKIPPED
00E27B  1               ; OVER. LEADING QUOTES SHOULD BE SKIPPED BEFORE JSR. ON RETURN
00E27B  1               ; THE CHARACTER AFTER THE STRING LITERAL IS POINTED TO
00E27B  1               ; BY [STRNG2].
00E27B  1               ;
00E27B  1  A2 22        STRLIT: LDX #34 ;ASSUME STRING ENDS ON QUOTE.
00E27D  1  86 0D        STX CHARAC
00E27F  1  86 0E        STX ENDCHR
00E281  1               STRLT2: ;SAVE POINTER TO STRING.
00E281  1  85 AE        STA STRNG1
00E283  1  84 AF        STY STRNG1+1
00E285  1                ;IN CASE NO STRCPY.
00E285  1  85 A1        STA DSCTMP+1
00E287  1  84 A2        STY DSCTMP+1+1
00E289  1  A0 FF        LDY #255 ;INITIALIZE CHARACTER COUNT.
00E28B  1  C8           STRGET: INY
00E28C  1  B1 AE        LDA (STRNG1),Y ;GET CHARACTER.
00E28E  1  F0 0C        BEQ STRFI1 ;IF ZERO.
00E290  1  C5 0D        CMP CHARAC ;THIS TERMINATOR?
00E292  1  F0 04        BEQ STRFIN ;YES.
00E294  1  C5 0E        CMP ENDCHR
00E296  1  D0 F3        BNE STRGET ;LOOK FURTHER.
00E298  1  C9 22        STRFIN: CMP #34 ;QUOTE?
00E29A  1  F0 01        BEQ STRFI2
00E29C  1  18           STRFI1: CLC ;NO, BACK UP.
00E29D  1  84 A0        STRFI2: STY DSCTMP ;RETAIN COUNT.
00E29F  1  98           TYA
00E2A0  1  65 AE        ADC STRNG1 ;WISHING TO SET [TXTPTR].
00E2A2  1  85 B0        STA STRNG2
