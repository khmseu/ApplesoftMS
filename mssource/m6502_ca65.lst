00DB32  1               ;
00DB32  1               ; SUBROUTINE TO FIND DATA
00DB32  1               ; THE SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO
00DB32  1               ; SKIP OVER STATEMENTS. THE START WORD OF EACH STATEMENT
00DB32  1               ; IS COMPARED WITH "DATATK". EACH NEW LINE NUMBER
00DB32  1               ; IS STORED IN "DATLIN" SO THAT IF AN ERROR OCCURS
00DB32  1               ; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE
00DB32  1               ; NUMBER OF THE ILL-FORMATTED DATA.
00DB32  1               ;
00DB32  1  20 20 D8     DATLOP: JSR DATAN ;SKIP SOME TEXT.
00DB35  1  C8           INY
00DB36  1  AA           TAX ;END OF LINE?
00DB37  1  D0 12        BNE NOWLIN ;SHO AIN'T.
00DB39  1  A2 2A        LDX #ERROD ;YES = "NO DATA" ERROR.
00DB3B  1  C8           INY
00DB3C  1  B1 B9        LDA (TXTPTR),Y
00DB3E  1  F0 69        BEQ ERRGO5
00DB40  1  C8           INY
00DB41  1  B1 B9        LDA (TXTPTR),Y ;GET HIGH BYTE OF LINE NUMBER.
00DB43  1  85 7E        STA DATLIN
00DB45  1  C8           INY
00DB46  1  B1 B9        LDA (TXTPTR),Y ;GET LOW BYTE.
00DB48  1  C8           INY
00DB49  1  85 7F        STA DATLIN+1
00DB4B  1  B1 B9        NOWLIN: LDA (TXTPTR),Y ;HOW IS IT?
00DB4D  1  AA           TAX
00DB4E  1  20 15 D8     JSR ADDON ;ADD [Y] TO [TXTPTR].
00DB51  1  E0 7F        CPX #DATATK ;IS IT A "DATA" STATEMENT.
00DB53  1  D0 DD        BNE DATLOP ;NOT QUITE RIGHT. KEEP LOOKING.
00DB55  1  4C CB DA     JMP DATBK1 ;THIS IS THE ONE !
00DB58  1               VAREND: ;PUT AWAY A NEW DATA PNTR MAYBE.
00DB58  1  A5 82        LDA INPPTR
00DB5A  1  A4 83        LDY INPPTR+1
00DB5C  1  A6 15        LDX INPFLG
00DB5E  1  10 03        BPL VARY0
00DB60  1  4C D9 D6     JMP RESFIN
00DB63  1  A0 00        VARY0: LDY #0
00DB65  1  B1 82        LDA (INPPTR),Y ;LAST DATA CHR COULD HAVE BEEN
00DB67  1               ;COMMA OR COLON BUT SHOULD BE NULL.
00DB67  1  F0 07        BEQ INPRTS ;IT IS NULL.
