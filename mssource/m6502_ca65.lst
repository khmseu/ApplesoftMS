00D5A0  1  85 54        STA LINNUM+1 ;MAKE IT HUGE.
00D5A2  1  A0 01        LIST4: LDY #1
00D5A4  1               .if REALIO-3 = 0
00D5A4  1               
00D5A4  1               STY DORES
00D5A4  1               .endif
00D5A4  1  B1 9E        LDA (LOWTR),Y ;IS LINK ZERO?
00D5A6  1  F0 39        BEQ GRODY ;YES, GO TO READY.
00D5A8  1               .if REALIO <> 0
00D5A8  1               
00D5A8  1  20 EA D6     JSR ISCNTC
00D5AB  1               .endif
00D5AB  1  20 95 D9     JSR CRDO ;PRINT CRLF TO START WITH.
00D5AE  1  C8           INY
00D5AF  1  B1 9E        LDA (LOWTR),Y
00D5B1  1  AA           TAX
00D5B2  1  C8           INY
00D5B3  1  B1 9E        LDA (LOWTR),Y ;GET LINE NUMBER.
00D5B5  1  C5 54        CMP LINNUM+1 ;SEE IF BEYOND LAST.
00D5B7  1  D0 04        BNE TSTDUN ;GO DETERMINE RELATION.
00D5B9  1  E4 53        CPX LINNUM ;WAS EQUAL SO TEST LOW ORDER.
00D5BB  1  F0 02        BEQ TYPLIN ;EQUAL, SO LIST IT.
00D5BD  1  B0 22        TSTDUN: BCS GRODY ;IF LINE IS GR THAN LAST, THEN DUNE.
00D5BF  1  84 88        TYPLIN: STY LSTPNT
