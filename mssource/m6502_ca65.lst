00E63E  1               
00E63E  1               ; SUBTTL FLOATING POINT MATH PACKAGE CONFIGURATION.
00E63E  1               
00E63E  1               ; RADIX	8 ;!!!! ALERT !!!!
00E63E  1               ;THROUGHOUT THE MATH PACKAGE.
00E63E  1               ; COMMENT %
00E63E  1               ; THE FLOATING POINT FORMAT IS AS FOLLOWS:
00E63E  1               ;
00E63E  1               ; THE SIGN IS THE FIRST BIT OF THE MANTISSA.
00E63E  1               ; THE MANTISSA IS 24 BITS LONG.
00E63E  1               ; THE BINARY POINT IS TO THE LEFT OF THE MSB.
00E63E  1               ; NUMBER = MANTISSA * 2 ^ EXPONENT.
00E63E  1               ; THE MANTISSA IS POSITIVE WITH A ONE ASSUMED TO BE WHERE THE SIGN BIT IS.
00E63E  1               ; THE SIGN OF THE EXPONENT IS THE FIRST BIT OF THE EXPONENT.
00E63E  1               ; THE EXPONENT IS STORED IN EXCESS 200, I.E. WITH A BIAS OF +200.
00E63E  1               ; SO, THE EXPONENT IS A SIGNED 8-BIT NUMBER WITH 200 ADDED TO IT.
00E63E  1               ; AN EXPONENT OF ZERO MEANS THE NUMBER IS ZERO.
00E63E  1               ; THE OTHER BYTES MAY NOT BE ASSUMED TO BE ZERO.
00E63E  1               ; TO KEEP THE SAME NUMBER IN THE FAC WHILE SHIFTING,
00E63E  1               ; 	TO SHIFT RIGHT, EXP:=EXP+1
00E63E  1               ; 	TO SHIFT LEFT,	EXP:=EXP-1
00E63E  1               ;
00E63E  1               ; IN MEMORY THE NUMBER LOOKS LIKE THIS:
00E63E  1               ; 	[THE EXPONENT AS A SIGNED NUMBER +200]
00E63E  1               ; 	[THE SIGN BIT IN 7, BITS 2-8 OF MANTISSA ARE IN BITS 6-0].
00E63E  1               ; 		(REMEMBER BIT 1 OF MANTISSA IS ALWAYS A ONE.)
00E63E  1               ; 	[BITS 9-16 OF THE MANTISSA]
00E63E  1               ; 	[BITS 17-24] OF THE MANTISSA]
00E63E  1               ;
00E63E  1               ; ARITHMETIC ROUTINE CALLING CONVENTIONS:
00E63E  1               ;
00E63E  1               ; FOR ONE ARGUMENT FUNCTIONS:
00E63E  1               ; 	THE ARGUMENT IS IN THE FAC.
00E63E  1               ; 	THE RESULT IS LEFT IN THE FAC.
00E63E  1               ; FOR TWO ARGUMENT OPERATIONS:
00E63E  1               ; 	THE FIRST ARGUMENT IS IN ARG (ARGEXP,HO,MO,LO AND ARGSGN).
00E63E  1               ; 	THE SECOND ARGUMENT IS IN THE FAC.
00E63E  1               ; 	THE RESULT IS LEFT IN THE FAC.
00E63E  1               ;
00E63E  1               ; THE 'T' ENTRY POINTS TO THE TWO-ARGUMENT OPERATIONS HAVE BOTH ARGUMENTS
00E63E  1               ; SETUP IN THE RESPECTIVE REGISTERS. BEFORE CALLING ARG MAY HAVE BEEN
00E63E  1               ; POPPED OFF THE STACK AND INTO ARG, FOR EXAMPLE.
00E63E  1               ; THE OTHER ENTRY POINT ASSUMES [Y,A] POINTS TO THE ARGUMENT
00E63E  1               ; SOMEWHERE IN MEMORY. IT IS UNPACKED INTO ARG BY "CONUPK".
00E63E  1               ;
00E63E  1               ; ON THE STACK, THE SGN IS PUSHED ON FIRST, THE LO,MO,HO AND FINALLY EXP.
00E63E  1               ; NOTE ALL THINGS ARE KEPT UNPACKED IN ARG, FAC AND ON THE STACK.
00E63E  1               ;
00E63E  1               ; IT IS ONLY WHEN SOMETHING IS STORED AWAY THAT IT IS PACKED TO FOUR
00E63E  1               ; BYTES. THE UNPACKED FORMAT HAS A SGN BYTE REFLECTING THE SIGN OF THE
00E63E  1               ; NUMBER (POSITIVE=0, NEGATIVE=-1) A HO,MO AND LO WITH THE HIGH BIT
00E63E  1               ; OF THE HO TURNED ON. THE EXP IS THE SAME AS STORED FORMAT.
00E63E  1               ; THIS IS DONE FOR SPEED OF OPERATION.
00E63E  1               ; %
00E63E  1               ; PAGE
00E63E  1               ; SUBTTL	FLOATING POINT ADDITION AND SUBTRACTION.
00E63E  1               FADDH: ;ENTRY TO ADD 1/2.
00E63E  1  A9 04        LDA #FHALF&255
00E640  1  A0 ED        LDY #FHALF/256
00E642  1  4C 5C E6     JMP FADD ;UNPACK AND GO ADD IT.
00E645  1  20 81 E8     FSUB: JSR CONUPK ;UNPACK ARGUMENT INTO ARG.
00E648  1  A5 A5        FSUBT: LDA FACSGN
00E64A  1  49 FF        EOR #255 ;COMPLEMENT IT.
00E64C  1  85 A5        STA FACSGN
00E64E  1  45 AD        EOR ARGSGN ;COMPLEMENT ARISGN.
00E650  1  85 AE        STA ARISGN
00E652  1  A5 A0        LDA FACEXP ;SET CODES ON FACEXP.
00E654  1  4C 5F E6     JMP FADDT ;[Y]=ARGEXP..
