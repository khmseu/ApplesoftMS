00D888  1               ; SUBTTL	LINGET -- READ A LINE NUMBER INTO LINNUM
00D888  1               ;
00D888  1               ; "LINGET" READS A LINE NUMBER FROM THE CURRENT TEXT POSITION.
00D888  1               ;
00D888  1               ; LINE NUMBERS RANGE FROM 0 TO 64000-1.
00D888  1               ;
