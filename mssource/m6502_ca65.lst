00D5FF  1  20 04 DA     JSR OUTDO ;PRINT IT.
00D602  1  D0 F5        BNE PRIT3 ;END OF ENTRY? NO, TYPE REST.
00D604  1               ; PAGE
00D604  1               ; SUBTTL THE "FOR" STATEMENT.
00D604  1               ;
00D604  1               ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
00D604  1               ;
00D604  1               ; LOW ADDRESS
00D604  1               ;	TOKEN (FORTK) 1 BYTE
00D604  1               ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
00D604  1               ;	THE STEP 4+ADDPRC BYTES
00D604  1               ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
00D604  1               ;	THE UPPER VALUE 4+ADDPRC BYTES
00D604  1               ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
00D604  1               ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
00D604  1               ; HIGH ADDRESS
00D604  1               ;
00D604  1               ; TOTAL 16+2*ADDPRC BYTES.
00D604  1               ;
00D604  1               
00D604  1  A9 80        FOR: LDA #128 ;DON'T RECOGNIZE
00D606  1  85 14        STA SUBFLG ;SUBSCRIPTED VARIABLES.
00D608  1  20 CE D8     JSR LET ;READ THE VARIABLE AND ASSIGN IT
00D60B  1               ;THE CORRECT INITIAL VALUE AND STORE
00D60B  1               ;A POINTER TO THE VARIABLE IN VARPNT.
00D60B  1  20 70 D2     JSR FNDFOR ;PNTR IS IN VARPNT, AND FORPNT.
00D60E  1  D0 05        BNE NOTOL ;IF NO MATCH, DON'T ELIMINATE ANYTHING.
00D610  1  8A           TXA ;MAKE IT ARITHMETICAL.
00D611  1  69 0F        ADC #FORSIZ-3 ;ELIMINATE ALMOST ALL.
00D613  1  AA           TAX ;NOTE C=1, THEN PLA, PLA.
00D614  1  9A           TXS ;MANIFEST.
00D615  1  68           NOTOL: PLA ;GET RID OF NEWSTT RETURN ADDRESS
00D616  1  68           PLA ;IN CASE THIS IS A TOTALLY NEW ENTRY.
00D617  1  A9 09        LDA #8+ADDPRC
00D619  1  20 E1 D2     JSR GETSTK ;MAKE SURE 16 BYTES ARE AVAILABLE.
00D61C  1  20 2C D8     JSR DATAN ;GET A COUNT IN [Y] OF THE NUMBER OF
00D61F  1               ;CHACRACTERS LEFT IN THE "FOR" STATEMENT
00D61F  1               ;[TXTPTR] IS UNAFFECTED.
00D61F  1  18           CLC ;PREP TO ADD.
00D620  1  98           TYA ;SAVE IT FOR PUSHING.
00D621  1  65 B9        ADC TXTPTR
00D623  1  48           PHA
00D624  1  A5 BA        LDA TXTPTR+1
00D626  1  69 00        ADC #0
00D628  1  48           PHA
00D629  1                ;PUT LINE NUMBER ON STACK.
00D629  1  A5 79        LDA CURLIN+1
00D62B  1  48           PHA
00D62C  1  A5 78        LDA CURLIN
00D62E  1  48           PHA
00D62F  1                ;"TO" IS NECESSARY.
00D62F  1  A9 80        LDA #TOTK
00D631  1  20 74 DD     JSR SYNCHR
00D634  1  20 0F DC     JSR CHKNUM ;VALUE MUST BE A NUMBER.
00D637  1  20 0C DC     JSR FRMNUM ;GET UPPER VALUE INTO FAC.
00D63A  1  A5 A5        LDA FACSGN ;PACK FAC.
00D63C  1  09 7F        ORA #127
00D63E  1  25 A1        AND FACHO
00D640  1  85 A1        STA FACHO ;SET PACKED SIGN BIT.
00D642  1               
00D642  1  A9 4D        LDA #LDFONE&255
00D644  1  A0 D6        LDY #LDFONE/256
00D646  1               
00D646  1  85 61        STA INDEX1
00D648  1  84 62        STY INDEX1+1
00D64A  1  4C CB DC     JMP FORPSH ;PUT FAC ONTO STACK, PACKED.
00D64D  1               LDFONE: ;PUT 1.0 INTO FAC.
00D64D  1  A9 B1        LDA #FONE&255
00D64F  1  A0 E7        LDY #FONE/256
00D651  1  20 9A E9     JSR MOVFM
00D654  1  20 B8 00     JSR CHRGOT
00D657  1  C9 81        CMP #STEPTK ;A STEP IS GIVEN?
00D659  1  D0 06        BNE ONEON ;NO. ASSUME 1.0.
00D65B  1  20 B2 00     JSR CHRGET ;YES. ADVANCE POINTER.
00D65E  1  20 0C DC     JSR FRMNUM ;READ THE STEP.
00D661  1  20 26 EA     ONEON: JSR SIGN ;GET SIGN IN ACCA.
00D664  1  20 C0 DC     JSR PUSHF ;PUSH FAC ONTO STACK (THRU A).
00D667  1                ;PUT PNTR TO VARIABLE ON STACK.
00D667  1  A5 89        LDA FORPNT+1
