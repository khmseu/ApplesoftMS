000996  1               ; PAGE
000996  1               ; SUBTTL	GENERAL STORAGE MANAGEMENT ROUTINES.
000996  1               ;
000996  1               ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
000996  1               ;
000996  1               FORSIZ .set 18
000996  1  BA           FNDFOR: TSX ;LOAD XREG WITH STK PNTR.
000997  1  E8           INX
000998  1  E8           INX
000999  1  E8           INX
00099A  1  E8           INX
00099B  1  BD 01 01     FFLOOP: LDA 257,X ;GET STACK ENTRY.
00099E  1  C9 7F        CMP #FORTK ;IS IT A "FOR" TOKEN?
0009A0  1  D0 21        BNE FFRTS ;NO, NO "FOR" LOOPS WITH THIS PNTR.
0009A2  1  A5 89        LDA FORPNT+1 ;GET HIGH.
0009A4  1  D0 0A        BNE CMPFOR
0009A6  1  BD 02 01     LDA 258,X ;PNTR IS ZERO, SO ASSUME THIS ONE.
0009A9  1  85 88        STA FORPNT
0009AB  1  BD 03 01     LDA 259,X
0009AE  1  85 89        STA FORPNT+1
0009B0  1  DD 03 01     CMPFOR: CMP 259,X
0009B3  1  D0 07        BNE ADDFRS ;NOT THIS ONE.
0009B5  1  A5 88        LDA FORPNT ;GET DOWN.
0009B7  1  DD 02 01     CMP 258,X
0009BA  1  F0 07        BEQ FFRTS ;WE GOT IT! WE GOT IT!
0009BC  1  8A           ADDFRS: TXA
0009BD  1  18           CLC ;ADD 16 TO X.
0009BE  1  69 12        ADC #FORSIZ
0009C0  1  AA           TAX ;RESULT BACK INTO X.
0009C1  1  D0 D8        BNE FFLOOP
0009C3  1  60           FFRTS: RTS ;RETURN TO CALLER.
0009C4  1               
0009C4  1               ;
0009C4  1               ; THIS IS THE BLOCK TRANSFER ROUTINE.
0009C4  1               ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
0009C4  1               ;
0009C4  1               ; ON ENTRY:
0009C4  1               ; [Y,A]=[HIGHDS]    (FOR REASON).
0009C4  1               ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
0009C4  1               ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
0009C4  1               ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
0009C4  1               ;
0009C4  1               ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
0009C4  1               ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
0009C4  1               ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
0009C4  1               ;
0009C4  1               ; ON EXIT:
0009C4  1               ; [LOWTR] ARE UNCHANGED.
0009C4  1               ; [HIGHTR]=[LOWTR]-200 OCTAL.
0009C4  1               ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
0009C4  1               ;
0009C4  1  20 14 0A     BLTU: JSR REASON ;ASCERTAIN THAT STRING SPACE WON'T
0009C7  1               ;BE OVERRUN.
0009C7  1               
0009C7  1  85 70        STA STREND
0009C9  1  84 71        STY STREND+1
0009CB  1  38           BLTUC: SEC ;PREPARE TO SUBTRACT.
0009CC  1  A5 99        LDA HIGHTR
0009CE  1  E5 9E        SBC LOWTR ;COMPUTE NUMBER OF THINGS TO MOVE.
0009D0  1  85 61        STA INDEX ;SAVE FOR LATER.
0009D2  1  A8           TAY
0009D3  1  A5 9A        LDA HIGHTR+1
0009D5  1  E5 9F        SBC LOWTR+1
0009D7  1  AA           TAX ;PUT IT IN A COUNTER REGISTER.
0009D8  1  E8           INX ;SO THAT COUNTER ALGORITHM WORKS.
0009D9  1  98           TYA ;SEE IF LOW PART OF COUNT IS ZERO.
0009DA  1  F0 23        BEQ DECBLT ;YES, GO START MOVING BLOCKS.
0009DC  1  A5 99        LDA HIGHTR ;NO, MUST MODIFY BASE ADDR.
0009DE  1  38           SEC
0009DF  1  E5 61        SBC INDEX ;BORROW IS OFF SINCE [HIGHTR].GT.[LOWTR].
0009E1  1  85 99        STA HIGHTR ;SAVE MODIFIED BASE ADDR.
0009E3  1  B0 03        BCS BLT1 ;IF NO BORROW, GO SHOVE IT.
0009E5  1  C6 9A        DEC HIGHTR+1 ;BORROW IMPLIES SUB 1 FROM HIGH ORDER.
0009E7  1  38           SEC
0009E8  1  A5 97        BLT1: LDA HIGHDS ;MOD BASE OF DEST ADDR.
0009EA  1  E5 61        SBC INDEX
0009EC  1  85 97        STA HIGHDS
0009EE  1  B0 08        BCS MOREN1 ;NO BORROW.
0009F0  1  C6 98        DEC HIGHDS+1 ;DECREMENT HIGH ORDER BYTE.
0009F2  1  90 04        BCC MOREN1 ;ALWAYS SKIP.
0009F4  1  B1 99        BLTLP: LDA (HIGHTR),Y ;FETCH BYTE TO MOVE
0009F6  1  91 97        STA (HIGHDS),Y ;MOVE IT IN, MOVE IT OUT.
0009F8  1  88           MOREN1: DEY
0009F9  1  D0 F9        BNE BLTLP
0009FB  1  B1 99        LDA (HIGHTR),Y ;MOVE LAST OF THE BLOCK.
0009FD  1  91 97        STA (HIGHDS),Y
0009FF  1  C6 9A        DECBLT: DEC HIGHTR+1
000A01  1  C6 98        DEC HIGHDS+1 ;START ON NEW BLOCKS.
000A03  1  CA           DEX
000A04  1  D0 F2        BNE MOREN1
000A06  1  60           RTS ;RETURN TO CALLER.
000A07  1               
000A07  1               ;
000A07  1               ; THIS ROUTINE IS USED TO ASCERTAIN THAT A GIVEN
000A07  1               ; NUMBER OF LOCS REMAIN AVAILABLE FOR THE STACK.
000A07  1               ;    THE CALL IS:
000A07  1               ;	LDAI	NUMBER OF 2-BYTE ENTRIES NEEDED.
000A07  1               ;	JSR	GETSTK
000A07  1               ;
000A07  1               ; THIS ROUTINE MUST BE CALLED BY ANY ROUTINE WHICH PUTS
000A07  1               ; AN ARBITRARY AMOUNT OF STUFF ON THE STACK,
000A07  1               ; I.E., ANY RECURSIVE ROUTINE LIKE "FRMEVL".
000A07  1               ; IT IS ALSO CALLED BY ROUTINES SUCH AS "GOSUB" AND "FOR"
000A07  1               ; WHICH MAKE PERMANENT ENTRIES ON THE STACK.
000A07  1               ;
000A07  1               ; ROUTINES WHICH MERELY USE AND FREE UP THE GUARANTEED
000A07  1               ; NUMLEV LOCATIONS NEED NOT CALL THIS.
000A07  1               ;
000A07  1               ;
000A07  1               ; ON EXIT:
000A07  1               ;    [A] AND [X] HAVE BEEN MODIFIED.
000A07  1               ;
000A07  1  0A           GETSTK: ASL ;MULT [A] BY 2. NB, CLEARS C BIT.
000A08  1  69 3E        ADC #<((((2*NUMLEV)+3)*ADDPRC)+13) ;MAKE SURE 2*NUMLEV+13 LOCS
000A0A  1               ;(13 BECAUSE OF FBUFFR)
000A0A  1  B0 35        BCS OMERR ;WILL REMAIN IN STACK.
000A0C  1  85 61        STA INDEX
000A0E  1  BA           TSX ;GET STACKED.
000A0F  1  E4 61        CPX INDEX ;COMPARE.
000A11  1  90 2E        BCC OMERR ;IF STACK.LE.INDEX1, OM.
000A13  1  60           RTS
000A14  1               
000A14  1               ;
