000D38  1  AA           TAX ;NOTE C=1, THEN PLA, PLA.
000D39  1  9A           TXS ;MANIFEST.
000D3A  1  68           NOTOL: PLA ;GET RID OF NEWSTT RETURN ADDRESS
000D3B  1  68           PLA ;IN CASE THIS IS A TOTALLY NEW ENTRY.
000D3C  1  A9 09        LDA #8+ADDPRC
000D3E  1  20 07 0A     JSR GETSTK ;MAKE SURE 16 BYTES ARE AVAILABLE.
000D41  1  20 51 0F     JSR DATAN ;GET A COUNT IN [Y] OF THE NUMBER OF
000D44  1               ;CHACRACTERS LEFT IN THE "FOR" STATEMENT
000D44  1               ;[TXTPTR] IS UNAFFECTED.
000D44  1  18           CLC ;PREP TO ADD.
000D45  1  98           TYA ;SAVE IT FOR PUSHING.
000D46  1  65 B9        ADC TXTPTR
000D48  1  48           PHA
