00137E  1  20 B2 00     JSR CHRGET
001381  1  4C 68 13     JMP LOPREL ;GET THE NEXT CANDIDATE.
001384  1  A6 8C        ENDREL: LDX OPMASK ;WERE THERE ANY?
001386  1  D0 2C        BNE FINREL ;YES, HANDLE AS SPECIAL OP.
001388  1  B0 7B        BCS QOP ;NOT AN OPERATOR.
00138A  1  69 01        ADC #GREATK-PLUSTK
00138C  1  90 77        BCC QOP ;NOT AN OPERATOR.
00138E  1  65 11        ADC VALTYP ;[C]=1.
001390  1                ;ONLY IF [A]=0 AND [VALTYP]=-1 (A STR).
001390  1  D0 03        BNE *+5
001392  1  4C 56 1B     JMP CAT
001395  1  69 FF        ADC #255 ;GET BACK ORIGINAL [A].
001397  1  85 61        STA INDEX1
001399  1  0A           ASL ;MULTIPLY BY 2.
00139A  1  65 61        ADC INDEX1 ;BY THREE.
00139C  1  A8           TAY ;SET UP FOR LATER.
00139D  1  68           QPREC: PLA ;GET PREVIOUS PRECEDENCE.
