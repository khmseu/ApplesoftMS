00DBA1  1               ; PAGE
00DBA1  1               ; SUBTTL	THE NEXT CODE IS THE "NEXT CODE"
00DBA1  1               ;
00DBA1  1               ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
00DBA1  1               ;
00DBA1  1               ; LOW ADDRESS
00DBA1  1               ;	TOKEN (FORTK) 1 BYTE
00DBA1  1               ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
00DBA1  1               ;	THE STEP 4+ADDPRC BYTES
00DBA1  1               ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
00DBA1  1               ;	THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
00DBA1  1               ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
00DBA1  1               ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
00DBA1  1               ; HIGH ADDRESS
00DBA1  1               ;
00DBA1  1               ; TOTAL 16+2*ADDPRC BYTES.
00DBA1  1               ;
00DBA1  1  D0 04        NEXT: BNE GETFOR
00DBA3  1  A0 00        LDY #0 ;WITHOUT ARG CALL "FNDFOR" WITH
00DBA5  1  F0 03        BEQ STXFOR ;[FORPNT]=0.
00DBA7  1  20 94 DE     GETFOR: JSR PTRGET ;GET A POINTER TO LOOP VARIABLE
00DBAA  1               STXFOR: ;INTO "FORPNT".
00DBAA  1  85 88        STA FORPNT
00DBAC  1  84 89        STY FORPNT+1
00DBAE  1  20 70 D2     JSR FNDFOR ;FIND THE MATCHING ENTRY IF ANY.
00DBB1  1  F0 04        BEQ HAVFOR
00DBB3  1  A2 00        LDX #ERRNF ;"NEXT WITHOUT FOR".
00DBB5  1  F0 69        ERRGO5: BEQ ERRGO4
00DBB7  1  9A           HAVFOR: TXS ;SETUP STACK. CHOP FIRST.
00DBB8  1  8A           TXA
00DBB9  1  18           CLC
00DBBA  1  69 04        ADC #4 ;POINT TO INCREMENT
00DBBC  1  48           PHA ;SAVE THIS POINTER TO RESTORE TO [A]
00DBBD  1  69 06        ADC #5+ADDPRC ;POINT TO UPPER LIMIT
00DBBF  1  85 63        STA INDEX2 ;SAVE AS INDEX
00DBC1  1  68           PLA ;RESTORE POINTER TO INCREMENT
00DBC2  1  A0 01        LDY #1 ;SET HI ADDR OF THING TO MOVE.
00DBC4  1  20 9A E9     JSR MOVFM ;GET QUANTITY INTO THE FAC.
00DBC7  1  BA           TSX
00DBC8  1  BD 09 01     LDA 257+7+ADDPRC,X;SET SIGN CORRECTLY.
00DBCB  1  85 A5        STA FACSGN
00DBCD  1               
00DBCD  1  A5 88        LDA FORPNT
00DBCF  1  A4 89        LDY FORPNT+1
00DBD1  1  20 5C E6     JSR FADD ;ADD INC TO LOOP VARIABLE.
00DBD4  1  20 CB E9     JSR MOVVF ;PACK THE FAC INTO MEMORY.
00DBD7  1  A0 01        LDY #1
00DBD9  1  20 58 EA     JSR FCOMPN ;COMPARE FAC WITH UPPER VALUE.
00DBDC  1  BA           TSX
00DBDD  1  38           SEC
00DBDE  1  FD 09 01     SBC 257+7+ADDPRC,X;SUBTRACT SIGN OF INC FROM SIGN OF
00DBE1  1               ;OF (CURRENT VALUE-FINAL VALUE).
00DBE1  1  F0 17        BEQ LOOPDN ;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
00DBE3  1               ;THEN LOOP IS DONE.
00DBE3  1  BD 0F 01     LDA 2*ADDPRC+12+257,X
00DBE6  1  85 78        STA CURLIN ;STORE LINE NUMBER OF "FOR" STATEMENT.
00DBE8  1  BD 10 01     LDA 257+13+2*ADDPRC,X
00DBEB  1  85 79        STA CURLIN+1
00DBED  1  BD 12 01     LDA 2*ADDPRC+15+257,X
00DBF0  1  85 B9        STA TXTPTR ;STORE TEXT PNTR INTO "FOR" STATEMENT.
00DBF2  1  BD 11 01     LDA 2*ADDPRC+14+257,X
00DBF5  1  85 BA        STA TXTPTR+1
