002213  1               ; SUBTTL	FLOATING POINT INPUT ROUTINE.
002213  1               ;NUMBER INPUT IS LEFT IN FAC.
002213  1               ;AT ENTRY [TXTPTR] POINTS TO THE FIRST CHARACTER IN A TEXT BUFFER.
002213  1               ;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS
002213  1               ;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE
002213  1               ;DECIMAL POINT IS. [DPTFLG] TELL WHETHER A DP HAS BEEN
002213  1               ;SEEN. [DECCNT] IS THE NUMBER OF DIGITS AFTER THE DP.
002213  1               ;AT THE END [DECCNT] AND THE EXPONENT ARE USED TO
002213  1               ;DETERMINE HOW MANY TIMES TO MULTIPLY OR DIVIDE BY TEN
002213  1               ;TO GET THE CORRECT NUMBER.
002213  1  A0 00        FIN: LDY #0 ;ZERO FACSGN&SGNFLG.
002215  1  A2 0A        LDX #9+ADDPRC ;ZERO EXP AND HO (AND MOH).
002217  1  94 9C        FINZLP: STY DECCNT,X ;ZERO MO AND LO.
002219  1  CA           DEX ;ZERO TENEXP AND EXPSGN
00221A  1  10 FB        BPL FINZLP ;ZERO DECCNT, DPTFLG.
00221C  1  90 0F        BCC FINDGQ ;FLAGS STILL SET FROM CHRGET.
00221E  1  C9 2D        CMP #'-' ;A NEGATIVE SIGN?
002220  1  D0 04        BNE QPLUS ;NO, TRY PLUS SIGN.
002222  1  86 A6        STX SGNFLG ;IT'S NEGATIVE. (X=377).
002224  1  F0 04        BEQ FINC ;ALWAYS BRANCHES.
002226  1  C9 2B        QPLUS: CMP #'+' ;PLUS SIGN?
002228  1  D0 05        BNE FIN1 ;YES, SKIP IT.
00222A  1  20 B2 00     FINC: JSR CHRGET
00222D  1  90 5B        FINDGQ: BCC FINDIG
00222F  1  C9 2A        FIN1: CMP #'*' ;THE DP?
002231  1  F0 2E        BEQ FINDP ;NO KIDDING.
002233  1  C9 45        CMP #'E' ;EXPONENT FOLLOWS.
002235  1  D0 30        BNE FINE ;NO.
002237  1               ;HERE TO CHECK FOR SIGN OF EXP.
002237  1  20 B2 00     JSR CHRGET ;YES. GET ANOTHER.
00223A  1  90 17        BCC FNEDG1 ;IT IS A DIGIT. (EASIER THAN
00223C  1               ;BACKING UP POINTER.)
00223C  1  C9 81        CMP #MINUTK ;MINUS?
00223E  1  F0 0E        BEQ FINEC1 ;NEGATE.
002240  1  C9 2D        CMP #'-' ;MINUS SIGN?
002242  1  F0 0A        BEQ FINEC1
002244  1  C9 81        CMP #PLUSTK ;PLUS?
002246  1  F0 08        BEQ FINEC
002248  1  C9 2B        CMP #'+' ;PLUS SIGN?
00224A  1  F0 04        BEQ FINEC
00224C  1  D0 07        BNE FINEC2
00224E  1  66 9F        FINEC1: ROR EXPSGN ;TURN IT ON.
002250  1  20 B2 00     FINEC: JSR CHRGET ;GET ANOTHER.
002253  1  90 5C        FNEDG1: BCC FINEDG ;IT IS A DIGIT.
002255  1  24 9F        FINEC2: BIT EXPSGN
002257  1  10 0E        BPL FINE
002259  1  A9 00        LDA #0
00225B  1  38           SEC
00225C  1  E5 9D        SBC TENEXP
00225E  1  4C 69 22     JMP FINE1
002261  1  66 9E        FINDP: ROR DPTFLG
002263  1  24 9E        BIT DPTFLG
002265  1  50 C3        BVC FINC
002267  1  A5 9D        FINE: LDA TENEXP
002269  1  38           FINE1: SEC
00226A  1  E5 9C        SBC DECCNT ;GET NUMBER OF PLACES TO SHIFT.
00226C  1  85 9D        STA TENEXP
00226E  1  F0 12        BEQ FINQNG ;NEGATE?
002270  1  10 09        BPL FINMUL ;POSITIVE SO MULTIPLY.
002272  1  20 1B 20     FINDIV: JSR DIV10
002275  1  E6 9D        INC TENEXP ;DONE?
002277  1  D0 F9        BNE FINDIV ;NO.
002279  1  F0 07        BEQ FINQNG ;YES.
00227B  1  20 FF 1F     FINMUL: JSR MUL10
00227E  1  C6 9D        DEC TENEXP ;DONE?
002280  1  D0 F9        BNE FINMUL ;NO
002282  1  A5 A6        FINQNG: LDA SGNFLG
002284  1  30 01        BMI NEGXQS ;IF POSITIVE, RETURN.
002286  1  60           RTS
002287  1  4C 95 24     NEGXQS: JMP NEGOP ;OTHERWISE, NEGATE AND RETURN.
00228A  1               
