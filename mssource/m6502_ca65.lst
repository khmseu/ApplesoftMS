00DB95  1               ; PAGE
00DB95  1               ; SUBTTL	THE NEXT CODE IS THE "NEXT CODE"
00DB95  1               ;
00DB95  1               ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
00DB95  1               ;
00DB95  1               ; LOW ADDRESS
00DB95  1               ;	TOKEN (FORTK) 1 BYTE
00DB95  1               ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
00DB95  1               ;	THE STEP 4+ADDPRC BYTES
00DB95  1               ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
00DB95  1               ;	THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
00DB95  1               ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
00DB95  1               ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
00DB95  1               ; HIGH ADDRESS
00DB95  1               ;
00DB95  1               ; TOTAL 16+2*ADDPRC BYTES.
00DB95  1               ;
00DB95  1  D0 04        NEXT: BNE GETFOR
00DB97  1  A0 00        LDY #0 ;WITHOUT ARG CALL "FNDFOR" WITH
00DB99  1  F0 03        BEQ STXFOR ;[FORPNT]=0.
00DB9B  1  20 88 DE     GETFOR: JSR PTRGET ;GET A POINTER TO LOOP VARIABLE
00DB9E  1               STXFOR: ;INTO "FORPNT".
00DB9E  1  85 88        STA FORPNT
00DBA0  1  84 89        STY FORPNT+1
00DBA2  1  20 64 D2     JSR FNDFOR ;FIND THE MATCHING ENTRY IF ANY.
00DBA5  1  F0 04        BEQ HAVFOR
00DBA7  1  A2 00        LDX #ERRNF ;"NEXT WITHOUT FOR".
00DBA9  1  F0 69        ERRGO5: BEQ ERRGO4
00DBAB  1  9A           HAVFOR: TXS ;SETUP STACK. CHOP FIRST.
00DBAC  1  8A           TXA
00DBAD  1  18           CLC
00DBAE  1  69 04        ADC #4 ;POINT TO INCREMENT
00DBB0  1  48           PHA ;SAVE THIS POINTER TO RESTORE TO [A]
00DBB1  1  69 06        ADC #5+ADDPRC ;POINT TO UPPER LIMIT
00DBB3  1  85 63        STA INDEX2 ;SAVE AS INDEX
00DBB5  1  68           PLA ;RESTORE POINTER TO INCREMENT
00DBB6  1  A0 01        LDY #1 ;SET HI ADDR OF THING TO MOVE.
00DBB8  1  20 8E E9     JSR MOVFM ;GET QUANTITY INTO THE FAC.
00DBBB  1  BA           TSX
00DBBC  1  BD 09 01     LDA 257+7+ADDPRC,X;SET SIGN CORRECTLY.
00DBBF  1  85 A5        STA FACSGN
00DBC1  1               
00DBC1  1  A5 88        LDA FORPNT
00DBC3  1  A4 89        LDY FORPNT+1
00DBC5  1  20 50 E6     JSR FADD ;ADD INC TO LOOP VARIABLE.
00DBC8  1  20 BF E9     JSR MOVVF ;PACK THE FAC INTO MEMORY.
00DBCB  1  A0 01        LDY #1
00DBCD  1  20 4C EA     JSR FCOMPN ;COMPARE FAC WITH UPPER VALUE.
00DBD0  1  BA           TSX
00DBD1  1  38           SEC
00DBD2  1  FD 09 01     SBC 257+7+ADDPRC,X;SUBTRACT SIGN OF INC FROM SIGN OF
00DBD5  1               ;OF (CURRENT VALUE-FINAL VALUE).
00DBD5  1  F0 17        BEQ LOOPDN ;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
00DBD7  1               ;THEN LOOP IS DONE.
00DBD7  1  BD 0F 01     LDA 2*ADDPRC+12+257,X
00DBDA  1  85 78        STA CURLIN ;STORE LINE NUMBER OF "FOR" STATEMENT.
00DBDC  1  BD 10 01     LDA 257+13+2*ADDPRC,X
00DBDF  1  85 79        STA CURLIN+1
00DBE1  1  BD 12 01     LDA 2*ADDPRC+15+257,X
00DBE4  1  85 B9        STA TXTPTR ;STORE TEXT PNTR INTO "FOR" STATEMENT.
00DBE6  1  BD 11 01     LDA 2*ADDPRC+14+257,X
00DBE9  1  85 BA        STA TXTPTR+1
00DBEB  1  4C 64 D6     NEWSGO: JMP NEWSTT ;PROCESS NEXT STATEMENT.
00DBEE  1  8A           LOOPDN: TXA
00DBEF  1  69 11        ADC #<((2*ADDPRC)+15) ;ADDS 16 WITH CARRY.
00DBF1  1  AA           TAX
00DBF2  1  9A           TXS ;NEW STACK PNTR.
00DBF3  1  20 B8 00     JSR CHRGOT
00DBF6  1  C9 2C        CMP #44 ;COMMA AT END?
00DBF8  1  D0 F1        BNE NEWSGO
00DBFA  1  20 B2 00     JSR CHRGET
00DBFD  1  20 9B DB     JSR GETFOR ;DO NEXT BUT DON'T ALLOW BLANK VARIABLE
00DC00  1               ;PNTR. [VARPNT] IS THE STK PNTR WHICH
00DC00  1               ;NEVER MATCHES ANY POINTER.
00DC00  1               ;JSR TO PUT ON DUMMY NEWSTT ADDR.
00DC00  1               
00DC00  1               ; SUBTTL FORMULA EVALUATION CODE.
00DC00  1               ;
00DC00  1               ; THESE ROUTINES CHECK FOR CERTAIN "VALTYP".
00DC00  1               ; [C] IS NOT PRESERVED.
00DC00  1               ;
00DC00  1  20 17 DC     FRMNUM: JSR FRMEVL
00DC03  1  18           CHKNUM: CLC
00DC04  1  00 02 24 00  .word 512,36
00DC08  1  38           CHKSTR: SEC ;SET CARRY.
00DC09  1  24 11        CHKVAL: BIT VALTYP ;WILL NOT F UP "VALTYP".
00DC0B  1  30 03        BMI DOCSTR
00DC0D  1  B0 03        BCS CHKERR
00DC0F  1  60           CHKOK: RTS
00DC10  1  B0 FD        DOCSTR: BCS CHKOK
00DC12  1  A2 A3        CHKERR: LDX #ERRTM
00DC14  1  4C 11 D3     ERRGO4: JMP ERROR
00DC17  1               ;
00DC17  1               ; THE FORMULA EVALUATOR STARTS WITH
00DC17  1               ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
00DC17  1               ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
00DC17  1               ; THE RESULT IS LEFT IN THE FAC.
00DC17  1               ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
00DC17  1               ;
00DC17  1               ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
00DC17  1               ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR
00DC17  1               ; EACH OPERATOR.
00DC17  1               ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
00DC17  1               ;	THE ADDRESS OF THE OPERATOR ROUTINE.
00DC17  1               ;	THE FLOATING POINT TEMPORARY RESULT.
00DC17  1               ;	THE PRECEDENCE OF THE OPERATOR.
00DC17  1               ;
00DC17  1  A6 B9        FRMEVL: LDX TXTPTR
00DC19  1  D0 02        BNE FRMEV1
00DC1B  1  C6 BA        DEC TXTPTR+1
00DC1D  1  C6 B9        FRMEV1: DEC TXTPTR
00DC1F  1  A2 00        LDX #0 ;INITIAL DUMMY PRECEDENCE IS 0.
00DC21  1  00 02 24 00  .word 512,36
00DC25  1  48           LPOPER: PHA ;SAVE LOW PRECEDENCE. (MASK.)
00DC26  1  8A           TXA
