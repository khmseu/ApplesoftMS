0000B2  1               ; PAGE
0000B2  1               ; SUBTTL	RAM CODE.
0000B2  1               ; THIS CODE GETS CHANGED THROUGHOUT EXECUTION.
0000B2  1               ; IT IS MADE TO BE FAST THIS WAY.
0000B2  1               ; ALSO, [X] AND [Y] ARE NOT DISTURBED
0000B2  1               ;
0000B2  1               ; "CHRGET" USING [TXTPTR] AS THE CURRENT TEXT PNTR
0000B2  1               ; FETCHES A NEW CHARACTER INTO ACCA AFTER INCREMENTING [TXTPTR]
0000B2  1               ; AND SETS CONDITION CODES ACCORDING TO WHAT'S IN ACCA.
0000B2  1               ;	NOT C=	NUMERIC	  ('0' THRU '9')
0000B2  1               ;	Z=	':' OR END-OF-LINE (A NULL)
0000B2  1               ;
0000B2  1               ; [ACCA] = NEW CHAR.
0000B2  1               ; [TXTPTR]=[TXTPTR]+1
0000B2  1               ;
0000B2  1               ; THE FOLLOWING EXISTS IN ROM IF ROM EXISTS AND IS LOADED
0000B2  1               ; DOWN HERE BY INIT. OTHERWISE IT IS JUST LOADED INTO THIS
0000B2  1               ; RAM LIKE ALL THE REST OF RAM IS LOADED.
0000B2  1               ;
0000B2  1  E6 B9        CHRGET: INC CHRGET+7 ;INCREMENT THE WHOLE TXTPTR.
0000B4  1  D0 02        BNE CHRGOT
0000B6  1  E6 BA        INC CHRGET+8
0000B8  1  AD 60 EA     CHRGOT: LDA 60000 ;A LOAD WITH AN EXT ADDR.
0000BB  1               .undef TXTPTR
0000BB  1               .define TXTPTR CHRGOT+1
0000BB  1  C9 20        CMP #' ' ;SKIP SPACES.
0000BD  1  F0 F3        BEQ CHRGET
0000BF  1  C9 3A        QNUM: CMP #':' ;IS IT A ':'?
0000C1  1  B0 06        BCS CHRRTS ;IT IS .GE. ':'
0000C3  1  38           SEC
0000C4  1  E9 30        SBC #'0' ;ALL CHARS .GT. '9' HAVE RET'D SO
0000C6  1  38           SEC
0000C7  1  E9 D0        SBC #256-'0' ;SEE IF NUMERIC.
0000C9  1               ;TURN CARRY ON IF NUMERIC.
0000C9  1               ;ALSO, SETZ IF NULL.
0000C9  1  60           CHRRTS: RTS ;RETURN TO CALLER.
