00ED21  1               ; SUBTTL	EXPONENTIATION AND SQUARE ROOT FUNCTION.
00ED21  1               ;SQUARE ROOT FUNCTION --- SQR(A)
00ED21  1               ;USE SQR(X)=X^.5
00ED21  1  20 FB E9     SQR: JSR MOVAF ;MOVE FAC INTO ARG.
00ED24  1               
00ED24  1  A9 F8        LDA #FHALF&255
00ED26  1  A0 EC        LDY #FHALF/256
00ED28  1  20 8E E9     JSR MOVFM ;PUT MEMORY INTO FAC.
00ED2B  1               ;LAST THING FETCHED IS FACEXP. INTO ACCX.
00ED2B  1               ;	JMP	FPWRT		;FALL INTO FPWRT.
00ED2B  1               
00ED2B  1               ;EXPONENTIATION ---  X^Y.
00ED2B  1               ;N.B.  0^0=1
00ED2B  1               ;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
00ED2B  1               ;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
00ED2B  1               ;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
00ED2B  1               ;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
00ED2B  1               ;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
00ED2B  1               ;RETURNED BY EXP.
00ED2B  1               ;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
00ED2B  1  F0 70        FPWRT: BEQ EXP ;IF FAC=0, JUST EXPONENTIATE THAT.
00ED2D  1  A5 A8        LDA ARGEXP ;IS X=0?
00ED2F  1  D0 03        BNE FPWRT1
00ED31  1  4C E2 E6     JMP ZEROF1 ;ZERO FAC.
00ED34  1               FPWRT1: ;SAVE FOR LATER IN A TEMP.
00ED34  1  A2 8D        LDX #TEMPF3&255
00ED36  1  A0 00        LDY #TEMPF3/256
00ED38  1  20 C3 E9     JSR MOVMF
00ED3B  1               ;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
00ED3B  1  A5 AD        LDA ARGSGN
00ED3D  1  10 0F        BPL FPWR1 ;NO PROBLEMS IF X.GT.0.
00ED3F  1  20 BB EA     JSR INT ;INTEGERIZE THE FAC.
00ED42  1                ;GET ADDR OF COMPERAND.
00ED42  1  A9 8D        LDA #TEMPF3&255
00ED44  1  A0 00        LDY #TEMPF3/256
00ED46  1  20 4A EA     JSR FCOMP ;EQUAL?
00ED49  1  D0 03        BNE FPWR1 ;LEAVE X NEG. LOG WILL BLOW HIM OUT.
00ED4B  1               ;A=-1 AND Y IS IRRELEVANT.
00ED4B  1  98           TYA ;NEGATE X. MAKE POSITIVE.
00ED4C  1  A4 0D        LDY INTEGR ;GET EVENNESS.
00ED4E  1  20 ED E9     FPWR1: JSR MOVFA1 ;ALTERNATE ENTRY POINT.
00ED51  1  98           TYA
00ED52  1  48           PHA ;SAVE EVENNESS FOR LATER.
00ED53  1  20 D3 E7     JSR LOG ;FIND LOG.
00ED56  1                ;MULTIPLY FAC TIMES LOG(X).
00ED56  1  A9 8D        LDA #TEMPF3&255
00ED58  1  A0 00        LDY #TEMPF3/256
00ED5A  1  20 11 E8     JSR FMULT
00ED5D  1  20 9D ED     JSR EXP ;EXPONENTIATE THE FAC.
00ED60  1  68           PLA
00ED61  1  4A           LSR ;IS IT EVEN?
00ED62  1  90 0A        BCC NEGRTS ;YES. OR X.GT.0.
00ED64  1               ;NEGATE THE NUMBER IN FAC.
00ED64  1  A5 A0        NEGOP: LDA FACEXP
00ED66  1  F0 06        BEQ NEGRTS
00ED68  1               
00ED68  1  A5 A5        LDA FACSGN
00ED6A  1  49 FF        EOR #255
00ED6C  1  85 A5        STA FACSGN
00ED6E  1  60           NEGRTS: RTS
00ED6F  1               
