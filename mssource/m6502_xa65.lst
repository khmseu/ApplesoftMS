 2263 A:d4f1                                    ;
 2264 A:d4f1                                    ; FNDLIN SEARCHES THE PROGRAM TEXT FOR THE LINE
 2265 A:d4f1                                    ; WHOSE NUMBER IS PASSED IN "LINNUM".
 2266 A:d4f1                                    ; THERE ARE TWO POSSIBLE RETURNS:
 2267 A:d4f1                                    ;
 2268 A:d4f1                                    ; 1) CARRY SET.
 2269 A:d4f1                                    ;    LOWTR POINTS TO THE LINK FIELD IN THE LINE
 2270 A:d4f1                                    ;    WHICH IS THE ONE SEARCHED FOR.
 2271 A:d4f1                                    ;
 2272 A:d4f1                                    ; 2) CARRY NOT SET.
 2273 A:d4f1                                    ;    LINE NOT FOUND. [LOWTR] POINTS TO THE LINE IN THE
 2274 A:d4f1                                    ;    PROGRAM GREATER THAN THE ONE SOUGHT AFTER.
 2275 A:d4f1                                    ;
 2276 A:d4f1                           FNDLIN    
 2276 A:d4f1                                    ;LOAD [X,A] WITH [TXTTAB]
 2277 A:d4f1  a5 6a                              lda TXTTAB
 2278 A:d4f3  a6 6b                              ldx TXTTAB+1
 2279 A:d4f5                           FNDLNC    
 2279 A:d4f5  a0 01                              ldy #1
 2280 A:d4f7                                    ;STORE [X,A] INTO LOWTR
 2281 A:d4f7  85 9e                              sta LOWTR
 2282 A:d4f9  86 9f                              stx LOWTR+1
 2283 A:d4fb  b1 9e                              lda (LOWTR),Y            ;SEE IF LINK IS 0
 2284 A:d4fd  f0 21                              beq FLINRT
 2285 A:d4ff  c8                                 iny 
 2286 A:d500  c8                                 iny 
 2287 A:d501  a5 54                              lda LINNUM+1          ;COMP HIGH ORDERS OF LINE NUMBERS.
 2288 A:d503  d1 9e                              cmp (LOWTR),Y
 2289 A:d505  90 1a                              bcc FLNRTS                ;NO SUCH LINE NUMBER.
 2290 A:d507  f0 05                              beq FNDLO1
 2291 A:d509  88                                 dey 
 2292 A:d50a  d0 0b                              bne AFFRTS                ;ALWAYS BRANCH.
 2293 A:d50c                           FNDLO1    
 2293 A:d50c  a5 53                              lda LINNUM
 2294 A:d50e  88                                 dey 
 2295 A:d50f  d1 9e                              cmp (LOWTR),Y            ;COMPARE LOW ORDERS.
 2296 A:d511  90 0e                              bcc FLNRTS                ;NO SUCH NUMBER.
 2297 A:d513  f0 0c                              beq FLNRTS                ;GO TIT.
 2298 A:d515                           AFFRTS    
 2298 A:d515  88                                 dey 
 2299 A:d516  b1 9e                              lda (LOWTR),Y            ;FETCH LINK.
 2300 A:d518  aa                                 tax 
 2301 A:d519  88                                 dey 
