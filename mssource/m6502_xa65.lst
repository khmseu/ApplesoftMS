 5615 A:e4d0  68                                 pla                    ;GET COUNT BACK.
 5616 A:e4d1                           FRETRT    
 5616 A:e4d1                                    ;SAVE FOR LATER USE.
 5617 A:e4d1  86 61                              stx INDEX1
 5618 A:e4d3  84 62                              sty INDEX1+1
 5619 A:e4d5  60                                 rts 
 5620 A:e4d6                           FRETMS    
 5620 A:e4d6  c4 57                              cpy LASTPT+1          ;LAST ENTRY TO TEMP? 
 5621 A:e4d8  d0 10                              bne FRERTS
