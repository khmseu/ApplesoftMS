 2254 A:d4de                                    ;ITS END WILL LOOK LIKE END OF PROGRAM.

 2257 A:d4de  c6 ba                              dec CHRGOT+1+1

 2260 A:d4e2  85 b9                              sta CHRGOT+1          ;CRUNCHED LINE.
 2261 A:d4e4                           LISTRT    
