 7496 A:eddf  85 af                              sta FACOV
 7497 A:ede1  20 43 e6                           jsr FSUBT
 7498 A:ede4  20 6b ed                           jsr NEGOP                ;NEGATE FAC.

 7500 A:ede7  a9 7b                              lda #EXPCON&255
 7501 A:ede9  a0 ed                              ldy #EXPCON/256
 7502 A:edeb  20 0d ee                           jsr POLY
 7503 A:edee                                    ;MULTIPLY BY POSITIVE 1.0.
 7504 A:edee  a9 00                              lda #0
 7505 A:edf0  85 ae                              sta ARISGN
 7506 A:edf2  68                                 pla                    ;GET SCALE FACTOR.
 7507 A:edf3  20 a9 e8                           jsr MLDEXP                ;MODIFY FACEXP AND CHECK FOR OVERFLOW.
 7508 A:edf6  60                                 rts                    ;HAS TO DO JSR DUE TO PULAS IN MULDIV.

 7511 A:edf7                                    ; PAGE
 7512 A:edf7                                    ; SUBTTL POLYNOMIAL EVALUATOR AND THE RANDOM NUMBER GENERATOR.
 7513 A:edf7                                    ;EVALUATE P(X^2)*X
 7514 A:edf7                                    ;POINTER TO DEGREE IS IN [Y,A].
 7515 A:edf7                                    ;THE CONSTANTS FOLLOW THE DEGREE.
 7516 A:edf7                                    ;FOR X=FAC, COMPUTE:
 7517 A:edf7                                    ; C0*X+C1*X^3+C2*X^5+C3*X^7+...+C(N)*X^(2*N+1)
 7518 A:edf7                           POLYX     
 7518 A:edf7                                    ;RETAIN POLYNOMIAL POINTER FOR LATER.
 7519 A:edf7  85 b0                              sta FBUFPT
 7520 A:edf9  84 b1                              sty FBUFPT+1
 7521 A:edfb  20 c0 e9                           jsr MOV1F                ;SAVE FAC IN FACTMP.
 7522 A:edfe  a9 96                              lda #TEMPF1
 7523 A:ee00  20 18 e8                           jsr FMULT                ;COMPUTE X^2.
 7524 A:ee03  20 11 ee                           jsr POLY1                ;COMPUTE P(X^2).

 7526 A:ee06  a9 96                              lda #TEMPF1&255
 7527 A:ee08  a0 00                              ldy #TEMPF1/256
 7528 A:ee0a  4c 18 e8                           jmp FMULT                ;MULTIPLY BY FAC AGAIN.

 7530 A:ee0d                                    ;POLYNOMIAL EVALUATOR.
 7531 A:ee0d                                    ;POINTER TO DEGREE IS IN [Y,A].
 7532 A:ee0d                                    ;COMPUTE:
 7533 A:ee0d                                    ; C0+C1*X+C2*X^2+C3*X^3+C4*X^4+...+C(N-1)*X^(N-1)+C(N)*X^N.
 7534 A:ee0d                           POLY      
 7534 A:ee0d                                    
 7535 A:ee0d  85 b0                              sta FBUFPT
 7536 A:ee0f  84 b1                              sty FBUFPT+1
 7537 A:ee11                           POLY1     
 7537 A:ee11  20 ba e9                           jsr MOV2F                ;SAVE FAC.
 7538 A:ee14  b1 b0                              lda (FBUFPT),Y
 7539 A:ee16  85 a6                              sta SGNFLG
 7540 A:ee18  a4 b0                              ldy FBUFPT
 7541 A:ee1a  c8                                 iny 
 7542 A:ee1b  98                                 tya 
 7543 A:ee1c  d0 06                              bne POLY3
 7544 A:ee1e  e6 b1                              inc FBUFPT+1
 7545 A:ee20                           POLY3     
 7545 A:ee20  85 b0                              sta FBUFPT
 7546 A:ee22  a4 b1                              ldy FBUFPT+1
 7547 A:ee24                           POLY2     
 7547 A:ee24  20 18 e8                           jsr FMULT
 7548 A:ee27                                    ;GET CURRENT POINTER.
 7549 A:ee27  a5 b0                              lda FBUFPT
 7550 A:ee29  a4 b1                              ldy FBUFPT+1
 7551 A:ee2b  18                                 clc 
 7552 A:ee2c  69 05                              adc #4+1
 7553 A:ee2e  90 05                              bcc POLY4
 7554 A:ee30  c8                                 iny 
 7555 A:ee31                           POLY4     
 7555 A:ee31                                    
 7556 A:ee31  85 b0                              sta FBUFPT
 7557 A:ee33  84 b1                              sty FBUFPT+1
 7558 A:ee35  20 57 e6                           jsr FADD                ;ADD IN CONSTANT.
 7559 A:ee38                                    ;MULTIPLY THE ORIGINAL FAC.
 7560 A:ee38  a9 9b                              lda #TEMPF2&255
 7561 A:ee3a  a0 00                              ldy #TEMPF2/256
 7562 A:ee3c  c6 a6                              dec SGNFLG                ;DONE?
 7563 A:ee3e  d0 e4                              bne POLY2
 7564 A:ee40                           RANDRT    
 7564 A:ee40  60                                 rts                    ;YES.

 7566 A:ee41                                    ;PSUEDO-RANDOM NUMBER GENERATOR.
 7567 A:ee41                                    ;IF ARG=0, THE LAST RANDOM NUMBER GENERATED IS RETURNED.
 7568 A:ee41                                    ;IF ARG .LT. 0, A NEW SEQUENCE OF RANDOM NUMBERS IS
 7569 A:ee41                                    ;STARTED USING THE ARGUMENT.
 7570 A:ee41                                    ;   TO FORM THE NEXT RANDOM NUMBER IN THE SEQUENCE,
 7571 A:ee41                                    ;MULTIPLY THE PREVIOUS RANDOM NUMBER BY A RANDOM CONSTANT
 7572 A:ee41                                    ;AND ADD IN ANOTHER RANDOM CONSTANT. THE THEN HO
 7573 A:ee41                                    ;AND LO BYTES ARE SWITCHED, THE EXPONENT IS PUT WHERE
 7574 A:ee41                                    ;IT WILL BE SHIFTED IN BY NORMAL, AND THE EXPONENT IN THE FAC
 7575 A:ee41                                    ;IS SET TO 200 SO THE RESULT WILL BE LESS THAN 1. THIS
 7576 A:ee41                                    ;IS THEN NORMALIZED AND SAVED FOR THE NEXT TIME.
 7577 A:ee41                                    ;THE HO AND LOW BYTES WERE SWITCHED SO THERE WILL BE A
 7578 A:ee41                                    ;RANDOM CHANCE OF GETTING A NUMBER LESS THAN OR GREATER
 7579 A:ee41                                    ;THAN .5 .

 7581 A:ee41                           RMULZC    
 7581 A:ee41  98                                 .byt 152
 7582 A:ee42  35                                 .byt 53
 7583 A:ee43  44                                 .byt 68
 7584 A:ee44  7a                                 .byt 122
 7585 A:ee45                           RADDZC    
 7585 A:ee45  68                                 .byt 104
 7586 A:ee46  28                                 .byt 40
 7587 A:ee47  b1                                 .byt 177
 7588 A:ee48  46                                 .byt 70

 7590 A:ee49                           RND       
 7590 A:ee49  20 21 ea                           jsr SIGN                ;GET SIGN INTO ACCX.

 7593 A:ee4c  aa                                 tax 

 7595 A:ee4d  30 1c                              bmi RND1                ;START NEW SEQUENCE IF NEGATIVE.

 7613 A:ee4f                           QSETNR    
 7613 A:ee4f                                    ;GET LAST ONE INTO FAC.
 7614 A:ee4f  a9 ca                              lda #RNDX&255
 7615 A:ee51  a0 00                              ldy #RNDX/256
 7616 A:ee53  20 95 e9                           jsr MOVFM

 7619 A:ee56  8a                                 txa 
 7620 A:ee57  f0 e7                              beq RANDRT

 7622 A:ee59                                    ;MULTIPLY BY RANDOM CONSTANT.
 7623 A:ee59  a9 41                              lda #RMULZC&255
 7624 A:ee5b  a0 ee                              ldy #RMULZC/256
 7625 A:ee5d  20 18 e8                           jsr FMULT

