 3060 A:0fbb                                    ; SUBTTL LINGET -- READ A LINE NUMBER INTO LINNUM
 3061 A:0fbb                                    ;
 3062 A:0fbb                                    ; "LINGET" READS A LINE NUMBER FROM THE CURRENT TEXT POSITION.
 3063 A:0fbb                                    ;
 3064 A:0fbb                                    ; LINE NUMBERS RANGE FROM 0 TO 64000-1.
 3065 A:0fbb                                    ;
 3066 A:0fbb                                    ; THE ANSWER IS RETURNED IN "LINNUM".
 3067 A:0fbb                                    ; "TXTPTR" IS UPDATED TO POINT TO THE TERMINATING CHARCTER
 3068 A:0fbb                                    ; AND [A] = THE TERMINATING CHARACTER WITH CONDITION
 3069 A:0fbb                                    ; CODES SET UP TO REFLECT ITS VALUE.
 3070 A:0fbb                                    ;
 3071 A:0fbb                           LINGET    
 3071 A:0fbb  a2 00                              ldx #0
 3072 A:0fbd  86 53                              stx LINNUM                ;INITIALIZE LINE NUMBER TO ZERO.
 3073 A:0fbf  86 54                              stx LINNUM+1
 3074 A:0fc1                           MORLIN    
 3074 A:0fc1  b0 f7                              bcs ONGRTS                ;IT IS NOT A DIGIT.
