 3029 A:d84d  c9 7f                              cmp #127             ;IS TERMINATING CHARACTER A GOTOTK?
 3030 A:d84f  f0 07                              beq OKGOTO                ;YES.
 3031 A:d851                                    ;NO, IT MUST BE "THEN".
 3032 A:d851  a9 81                              lda #129
 3033 A:d853  20 6a dd                           jsr SYNCHR
 3034 A:d856                           OKGOTO    
