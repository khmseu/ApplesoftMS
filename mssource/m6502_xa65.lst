 5017 A:18be                                    ; PAGE
 5018 A:18be                                    ; SUBTTL SIMPLE-USER-DEFINED-FUNCTION CODE.
 5019 A:18be                                    ;
 5020 A:18be                                    ; NOTE ONLY SINGLE ARGUMENTS ARE ALLOWED TO FUNCTIONS
 5021 A:18be                                    ; AND FUNCTIONS MUST BE OF THE SINGLE LINE FORM:
 5022 A:18be                                    ; DEF FNA(X)=X^2+X-2
 5023 A:18be                                    ; NO STRINGS CAN BE INVOLVED WITH THESE FUNCTIONS.
 5024 A:18be                                    ;
 5025 A:18be                                    ; IDEA: CREATE A SIMPLE VARIABLE ENTRY
 5026 A:18be                                    ; WHOSE FIRST CHARACTER HAS THE 200 BIT SET.
 5027 A:18be                                    ; THE VALUE WILL BE:
 5028 A:18be                                    ;
 5029 A:18be                                    ; A TEXT PNTR TO THE FORMULA.
 5030 A:18be                                    ; A PNTR TO THE ARGUMENT VARIABLE.
 5031 A:18be                                    ;
 5032 A:18be                                    ; FUNCTION NAMES CAN BE LIKE "FNA4".
 5033 A:18be                                    ;
 5034 A:18be                                    ;
 5035 A:18be                                    ; SUBROUTINE TO SEE IF WE ARE IN DIRECT MODE.
 5036 A:18be                                    ; AND COMPLAIN IF SO.
 5037 A:18be                                    ;
 5038 A:18be                           ERRDIR    
 5038 A:18be  a6 79                              ldx CURLIN+1          ;DIR MODE HAS [CURLIN]=0,255
 5039 A:18c0  e8                                 inx                    ;SO NOW, IS RESULT ZERO?
 5040 A:18c1  d0 a2                              bne DIMRTS                ;YES.
 5041 A:18c3  a2 16                              ldx #22             ;INPUT DIRECT ERROR CODE.
 5042 A:18c5  00 02 2c 00                        .word 512,44
 5043 A:18c9                           ERRGUF    
 5043 A:18c9  a2 22                              ldx #34             ;USER DEFINED FUNCTION NEVER DEFINED
 5044 A:18cb                           ERRGO1    
 5044 A:18cb  4c 43 0a                           jmp ERROR

 5046 A:18ce                           DEF       
 5046 A:18ce  20 fc 18                           jsr GETFNM                ;GET A PNTR TO THE FUNCTION.
 5047 A:18d1  20 be 18                           jsr ERRDIR
 5048 A:18d4  20 93 14                           jsr CHKOPN                ;MUST HAVE "(".
 5049 A:18d7  a9 80                              lda #128
 5050 A:18d9  85 14                              sta SUBFLG                ;PROHIBIT SUBSCRIPTED VARIABLES.
 5051 A:18db  20 bb 15                           jsr PTRGET                ;GET PNTR TO ARGUMENT.
 5052 A:18de  20 36 13                           jsr CHKNUM                ;IS IT A NUMBER?
 5053 A:18e1  20 8d 14                           jsr CHKCLS                ;MUST HAVE ")"
 5054 A:18e4                                    ;MUST HAVE "=".
 5055 A:18e4  a9 82                              lda #130
 5056 A:18e6  20 9b 14                           jsr SYNCHR

