 4338 A:1546                                    ;
 4339 A:1546                                    ; TIME TO PERFORM A RELATIONAL OPERATOR.
 4340 A:1546                                    ; [DOMASK] CONTAINS THE BITS AS TO WHICH RELATIONAL
 4341 A:1546                                    ; OPERATOR IT WAS. CARRY BIT ON=STRING COMPARE.
 4342 A:1546                                    ;
 4343 A:1546                           DOREL     
 4343 A:1546  20 3c 13                           jsr CHKVAL                ;CHECK FOR MATCH.
 4344 A:1549  b0 15                              bcs STRCMP                ;IT IS A STRING.
 4345 A:154b  a5 ad                              lda ARGSGN                ;PACK ARG FOR FCOMP.
 4346 A:154d  09 7f                              ora #127
 4347 A:154f  25 a9                              and ARGHO
 4348 A:1551  85 a9                              sta ARGHO

 4350 A:1553  a9 a8                              lda #ARGEXP&255
 4351 A:1555  a0 00                              ldy #ARGEXP/256
 4352 A:1557  20 82 21                           jsr FCOMP
 4353 A:155a  aa                                 tax 
 4354 A:155b  4c 91 15                           jmp QCOMP
 4355 A:155e                           STRCMP    
 4355 A:155e                                    ;RESULT WILL BE NUMERIC.
 4356 A:155e  a9 00                              lda #0
 4357 A:1560  85 11                              sta VALTYP
 4358 A:1562  c6 8c                              dec OPMASK                ;TURN OFF VALTYP WHICH WAS STRING.
 4359 A:1564  20 c6 1b                           jsr FREFAC                ;FREE THE FACLO STRING.
 4360 A:1567  85 a0                              sta FAC                ;SAVE FOR LATER.

 4362 A:1569  86 a1                              stx FAC+1
 4363 A:156b  84 a2                              sty FAC+1+1
 4364 A:156d                                    ;GET POINTER TO OTHER STRING.
 4365 A:156d  a5 ab                              lda ARGMO
 4366 A:156f  a4 ac                              ldy ARGMO+1
 4367 A:1571  20 ca 1b                           jsr FRETMP                ;FREES FIRST DESC POINTER.

 4369 A:1574  86 ab                              stx ARGMO
 4370 A:1576  84 ac                              sty ARGMO+1
 4371 A:1578  aa                                 tax                    ;COPY COUNT INTO X.
 4372 A:1579  38                                 sec 
 4373 A:157a  e5 a0                              sbc FAC                ;WHICH IS GREATER. IF 0, ALL SET UP.
 4374 A:157c  f0 0a                              beq STASGN                ;JUST PUT SIGN OF DIFFERENCE AWAY.
 4375 A:157e  a9 01                              lda #1
 4376 A:1580  90 06                              bcc STASGN                ;SIGN IS POSITIVE.
 4377 A:1582  a6 a0                              ldx FAC                ;LENGTH OF FAC IS SHORTER.
 4378 A:1584  a9 ff                              lda #255             ;GET A MINUS 1 FOR NEGATIVES.
 4379 A:1586                           STASGN    
 4379 A:1586  85 a5                              sta FACSGN                ;KEEP FOR LATER.
 4380 A:1588  a0 ff                              ldy #255             ;SET POINTER TO FIRST STRING. (ARG.)
 4381 A:158a  e8                                 inx                    ;TO LOOP PROPERLY.
 4382 A:158b                           NXTCMP    
 4382 A:158b  c8                                 iny 
 4383 A:158c  ca                                 dex                    ;ANY CHARACTERS LEFT TO COMPARE?
 4384 A:158d  d0 09                              bne GETCMP                ;NOT DONE YET.
 4385 A:158f  a6 a5                              ldx FACSGN                ;USE SIGN OF LENGTH DIFFERENCE
 4386 A:1591                                    ;SINCE ALL CHARACTERS ARE THE SAME.
 4387 A:1591                           QCOMP     
 4387 A:1591  30 11                              bmi DOCMP                ;C IS ALWAYS SET THEN.
 4388 A:1593  18                                 clc 
 4389 A:1594  90 0e                              bcc DOCMP                ;ALWAYS BRANCH.
 4390 A:1596                           GETCMP    
 4390 A:1596  b1 ab                              lda (ARGMO),Y            ;GET NEXT CHAR TO COMPARE.
 4391 A:1598  d1 a1                              cmp (FAC+1),Y      ;SAME?
 4392 A:159a  f0 ef                              beq NXTCMP                ;YEP. TRY FURTHER.
 4393 A:159c  a2 ff                              ldx #255             ;SET A POSITIVE DIFFERENCE.
 4394 A:159e  b0 04                              bcs DOCMP                ;PUT STACK BACK TOGETHER.
 4395 A:15a0  a2 01                              ldx #1             ;SET A NEGATIVE DIFFERENCE.
 4396 A:15a2                           DOCMP     
 4396 A:15a2  e8                                 inx                    ;-1 TO 1, 0 TO 2, 1 TO 4.
 4397 A:15a3  8a                                 txa 
 4398 A:15a4  2a                                 rol 
 4399 A:15a5  25 16                              and TANSGN
 4400 A:15a7  f0 04                              beq GOFLOT
 4401 A:15a9  a9 ff                              lda #255             ;MAP 0 TO 0. ALL OTHERS TO -1.
 4402 A:15ab                           GOFLOT    
