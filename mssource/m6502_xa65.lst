 2447 A:d5d0  f0 13                              beq GRODY                ;IF WE HAVE PRINTED 256 CHARACTERS
 2448 A:d5d2                                    ;THE PROGRAM MUST BE MISFORMATED IN
 2449 A:d5d2                                    ;MEMORY DUE TO A BAD LOAD OR BAD
 2450 A:d5d2                                    ;HARDWARE. LET THE GUY RECOVER
 2451 A:d5d2  b1 9e                              lda (LOWTR),Y            ;GET NEXT CHAR. IS IT ZERO?
 2452 A:d5d4  d0 12                              bne QPLOP                ;YES. END OF LINE.
 2453 A:d5d6  a8                                 tay 
 2454 A:d5d7  b1 9e                              lda (LOWTR),Y
 2455 A:d5d9  aa                                 tax 
 2456 A:d5da  c8                                 iny 
 2457 A:d5db  b1 9e                              lda (LOWTR),Y
