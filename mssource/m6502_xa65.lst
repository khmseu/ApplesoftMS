 7466 A:edb0                           EXP       
 7466 A:edb0                                    
 7467 A:edb0                                    ;MULTIPLY BY LOG(E) BASE 2.
 7468 A:edb0  a9 82                              lda #LOGEB2&255
 7469 A:edb2  a0 ed                              ldy #LOGEB2/256
 7470 A:edb4  20 24 e8                           jsr FMULT
 7471 A:edb7  a5 af                              lda FACOV
 7472 A:edb9  69 50                              adc #80
 7473 A:edbb  90 07                              bcc STOLD
 7474 A:edbd  20 25 ea                           jsr INCRND
 7475 A:edc0                           STOLD     
