 7476 A:edb9  a5 a0                              lda FACEXP
 7477 A:edbb  c9 88                              cmp #136             ;IF ABS(FAC) .GE. 128, TOO BIG.
 7478 A:edbd  90 07                              bcc EXP1
 7479 A:edbf                           GOMLDV    
 7479 A:edbf  20 c7 e8                           jsr MLDVEX                ;OVERFLOW OR OVERFLOW.
 7480 A:edc2                           EXP1      
 7480 A:edc2  20 c2 ea                           jsr INT
 7481 A:edc5  a5 0d                              lda CHARAC                ;GET LOW PART.
 7482 A:edc7  18                                 clc 
 7483 A:edc8  69 81                              adc #129
 7484 A:edca  f0 f3                              beq GOMLDV                ;OVERFLOW OR OVERFLOW !!
 7485 A:edcc  38                                 sec 
 7486 A:edcd  e9 01                              sbc #1             ;SUBTRACT 1.
 7487 A:edcf  48                                 pha                    ;SAVE A WHILE.
 7488 A:edd0  a2 05                              ldx #4+1       ;PREP TO SWAP FAC AND ARG.
 7489 A:edd2                           SWAPLP    
 7489 A:edd2  b5 a8                              lda ARGEXP,X
 7490 A:edd4  b4 a0                              ldy FACEXP,X
