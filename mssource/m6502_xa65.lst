 2384 A:0c9c                                    ; SUBTTL THE "LIST" COMMAND.

 2386 A:0c9c                           LIST      
 2386 A:0c9c  90 08                              bcc GOLST                ;IT IS A DIGIT.
 2387 A:0c9e  f0 06                              beq GOLST                ;IT IS A TERMINATOR.
 2388 A:0ca0  c9 81                              cmp #129             ;DASH PRECEDING?
 2389 A:0ca2  d0 e9                              bne STKRTS                ;NO, SO SYNTAX ERROR.
 2390 A:0ca4                           GOLST     
 2390 A:0ca4  20 bb 0f                           jsr LINGET                ;GET LINE NUMBER INTO NUMLIN.
 2391 A:0ca7  20 16 0c                           jsr FNDLIN                ;FIND LINE .GE. [NUMLIN].
 2392 A:0caa  20 b8 00                           jsr CHRGOT                ;GET LAST CHARACTER.
 2393 A:0cad  f0 0e                              beq LSTEND                ;IF END OF LINE, # IS THE END.
 2394 A:0caf  c9 81                              cmp #129             ;DASH?
 2395 A:0cb1  d0 91                              bne FLNRTS                ;IF NOT, SYNTAX ERROR.
 2396 A:0cb3  20 b2 00                           jsr CHRGET                ;GET NEXT CHAR.
 2397 A:0cb6  20 bb 0f                           jsr LINGET                ;GET END #.
 2398 A:0cb9  d0 89                              bne FLNRTS                ;IF NOT TERMINATOR, ERROR.
 2399 A:0cbb                           LSTEND    
 2399 A:0cbb  68                                 pla 
 2400 A:0cbc  68                                 pla                    ;GET RID OF "NEWSTT" RTS ADDR.
 2401 A:0cbd  a5 53                              lda LINNUM                ;SEE IF IT WAS EXISTENT.
 2402 A:0cbf  05 54                              ora LINNUM+1
 2403 A:0cc1  d0 08                              bne LIST4                ;IT WAS TYPED.
 2404 A:0cc3  a9 ff                              lda #255
 2405 A:0cc5  85 53                              sta LINNUM
 2406 A:0cc7  85 54                              sta LINNUM+1          ;MAKE IT HUGE.
 2407 A:0cc9                           LIST4     
 2407 A:0cc9  a0 01                              ldy #1

 2412 A:0ccb  b1 9e                              lda (LOWTR),Y            ;IS LINK ZERO?
 2413 A:0ccd  f0 3b                              beq GRODY                ;YES, GO TO READY.

 2416 A:0ccf  20 e1 ff                           jsr 65505

 2418 A:0cd2  20 bc 10                           jsr CRDO                ;PRINT CRLF TO START WITH.
 2419 A:0cd5  c8                                 iny 
 2420 A:0cd6  b1 9e                              lda (LOWTR),Y
 2421 A:0cd8  aa                                 tax 
 2422 A:0cd9  c8                                 iny 
 2423 A:0cda  b1 9e                              lda (LOWTR),Y            ;GET LINE NUMBER.
 2424 A:0cdc  c5 54                              cmp LINNUM+1          ;SEE IF BEYOND LAST.
 2425 A:0cde  d0 06                              bne TSTDUN                ;GO DETERMINE RELATION.
 2426 A:0ce0  e4 53                              cpx LINNUM                ;WAS EQUAL SO TEST LOW ORDER.
 2427 A:0ce2  f0 04                              beq TYPLIN                ;EQUAL, SO LIST IT.
 2428 A:0ce4                           TSTDUN    
 2428 A:0ce4  b0 24                              bcs GRODY                ;IF LINE IS GR THAN LAST, THEN DUNE.
 2429 A:0ce6                           TYPLIN    
 2429 A:0ce6  84 88                              sty FORPNT
 2430 A:0ce8  20 f4 22                           jsr LINPRT                ;PRINT AS INT WITHOUT LEADING SPACE.
 2431 A:0ceb  a9 20                              lda #" "             ;ALWAYS PRINT SPACE AFTER NUMBER.
 2432 A:0ced                           PRIT4     
 2432 A:0ced  a4 88                              ldy FORPNT                ;GET POINTER TO LINE BACK.
 2433 A:0cef  29 7f                              and #127
 2434 A:0cf1                           PLOOP     
 2434 A:0cf1  20 2b 11                           jsr OUTDO                ;PRINT CHAR.

 2444 A:0cf4                           PLOOP1    
 2444 A:0cf4  c8                                 iny 
 2445 A:0cf5  f0 13                              beq GRODY                ;IF WE HAVE PRINTED 256 CHARACTERS
 2446 A:0cf7                                    ;THE PROGRAM MUST BE MISFORMATED IN
 2447 A:0cf7                                    ;MEMORY DUE TO A BAD LOAD OR BAD
 2448 A:0cf7                                    ;HARDWARE. LET THE GUY RECOVER
 2449 A:0cf7  b1 9e                              lda (LOWTR),Y            ;GET NEXT CHAR. IS IT ZERO?
 2450 A:0cf9  d0 12                              bne QPLOP                ;YES. END OF LINE.
 2451 A:0cfb  a8                                 tay 
 2452 A:0cfc  b1 9e                              lda (LOWTR),Y
 2453 A:0cfe  aa                                 tax 
 2454 A:0cff  c8                                 iny 
 2455 A:0d00  b1 9e                              lda (LOWTR),Y
 2456 A:0d02  86 9e                              stx LOWTR
 2457 A:0d04  85 9f                              sta LOWTR+1
 2458 A:0d06  d0 c1                              bne LIST4                ;BRANCH IF SOMETHING TO LIST.
 2459 A:0d08                           GRODY     
 2459 A:0d08  4c 69 0a                           jmp READY
 2460 A:0d0b                                    ;IS IT A TOKEN?
 2461 A:0d0b                           QPLOP     
 2461 A:0d0b  10 e4                              bpl PLOOP                ;NO, HEAD FOR PRINTER.

 2469 A:0d0d  38                                 sec 
 2470 A:0d0e  e9 7f                              sbc #127             ;GET RID OF SIGN BIT AND ADD 1.
 2471 A:0d10  aa                                 tax                    ;MAKE IT A COUNTER.
 2472 A:0d11  84 88                              sty FORPNT                ;SAVE POINTER TO LINE.
 2473 A:0d13  a0 ff                              ldy #255             ;LOOK AT RES'D WORD LIST.
 2474 A:0d15                           RESRCH    
 2474 A:0d15  ca                                 dex                    ;IS THIS THE RES'D WORD?
 2475 A:0d16  f0 0a                              beq PRIT3                ;YES, GO TOSS IT UP..
 2476 A:0d18                           RESCR1    
 2476 A:0d18  c8                                 iny 
 2477 A:0d19  b9 80 08                           lda RESLST,Y,             ;END OF ENTRY?
 2478 A:0d1c  10 fa                              bpl RESCR1                ;NO, CONTINUE PASSING.
 2479 A:0d1e  30 f5                              bmi RESRCH
 2480 A:0d20                           PRIT3     
 2480 A:0d20  c8                                 iny 
 2481 A:0d21  b9 80 08                           lda RESLST,Y
 2482 A:0d24  30 c7                              bmi PRIT4                ;END OF RESERVED WORD.
 2483 A:0d26  20 2b 11                           jsr OUTDO                ;PRINT IT.
 2484 A:0d29  d0 f5                              bne PRIT3                ;END OF ENTRY? NO, TYPE REST.
 2485 A:0d2b                                    ; PAGE
 2486 A:0d2b                                    ; SUBTTL THE "FOR" STATEMENT.
 2487 A:0d2b                                    ;
 2488 A:0d2b                                    ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2489 A:0d2b                                    ;
 2490 A:0d2b                                    ; LOW ADDRESS
 2491 A:0d2b                                    ; TOKEN (FORTK) 1 BYTE
 2492 A:0d2b                                    ; A POINTER TO THE LOOP VARIABLE 2 BYTES
 2493 A:0d2b                                    ; THE STEP 4+ADDPRC BYTES
 2494 A:0d2b                                    ; A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 2495 A:0d2b                                    ; THE UPPER VALUE 4+ADDPRC BYTES
 2496 A:0d2b                                    ; THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 2497 A:0d2b                                    ; A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 2498 A:0d2b                                    ; HIGH ADDRESS
 2499 A:0d2b                                    ;
 2500 A:0d2b                                    ; TOTAL 16+2*ADDPRC BYTES.
 2501 A:0d2b                                    ;

 2503 A:0d2b                           FOR       
 2503 A:0d2b  a9 80                              lda #128             ;DON'T RECOGNIZE
 2504 A:0d2d  85 14                              sta SUBFLG                ;SUBSCRIPTED VARIABLES.
 2505 A:0d2f  20 f5 0f                           jsr LET                ;READ THE VARIABLE AND ASSIGN IT
 2506 A:0d32                                    ;THE CORRECT INITIAL VALUE AND STORE
 2507 A:0d32                                    ;A POINTER TO THE VARIABLE IN VARPNT.
 2508 A:0d32  20 96 09                           jsr FNDFOR                ;PNTR IS IN VARPNT, AND FORPNT.
 2509 A:0d35  d0 07                              bne NOTOL                ;IF NO MATCH, DON'T ELIMINATE ANYTHING.
 2510 A:0d37  8a                                 txa                    ;MAKE IT ARITHMETICAL.
 2511 A:0d38  69 0f                              adc #18-3       ;ELIMINATE ALMOST ALL.
 2512 A:0d3a  aa                                 tax                    ;NOTE C=1, THEN PLA, PLA.
 2513 A:0d3b  9a                                 txs                    ;MANIFEST.
 2514 A:0d3c                           NOTOL     
