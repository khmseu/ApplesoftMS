 4264 A:14da  e0 07                              cpx #((2*131)-256)+1;IS IT PAST "LASNUM"?
 4265 A:14dc  90 22                              bcc OKNORM                ;NO, MUST BE NORMAL FUNCTION.
 4266 A:14de                                    ;
 4267 A:14de                                    ; MOST FUNCTIONS TAKE A SINGLE ARGUMENT.
 4268 A:14de                                    ; THE RETURN ADDRESS OF THESE FUNCTIONS IS "CHKNUM"
 4269 A:14de                                    ; WHICH ASCERTAINS THAT [VALTYP]=0  (NUMERIC).
 4270 A:14de                                    ; NORMAL FUNCTIONS THAT RETURN STRING RESULTS
 4271 A:14de                                    ; (E.G., CHR$) MUST POP OFF THAT RETURN ADDR AND
 4272 A:14de                                    ; RETURN DIRECTLY TO "FRMEVL".
 4273 A:14de                                    ;
 4274 A:14de                                    ; THE SO-CALLED "FUNNY" FUNCTIONS CAN TAKE MORE THAN ONE ARGUMENT,
 4275 A:14de                                    ; THE FIRST OF WHICH MUST BE STRING AND THE SECOND OF WHICH
 4276 A:14de                                    ; MUST BE A NUMBER BETWEEN 0 AND 255.
 4277 A:14de                                    ; THE CLOSED PARENTHESIS MUST BE CHECKED AND RETURN IS DIRECTLY
 4278 A:14de                                    ; TO "FRMEVL" WITH THE TEXT PNTR POINTING BEYOND THE ")".
 4279 A:14de                                    ; THE POINTER TO THE DESCRIPTOR OF THE STRING ARGUMENT
 4280 A:14de                                    ; IS STORED ON THE STACK UNDERNEATH THE VALUE OF THE
 4281 A:14de                                    ; INTEGER ARGUMENT.
 4282 A:14de                                    ;
 4283 A:14de  20 93 14                           jsr CHKOPN                ;CHECK FOR AN OPEN PARENTHESE
 4284 A:14e1  20 4a 13                           jsr FRMEVL                ;EAT OPEN PAREN AND FIRST ARG.
 4285 A:14e4  20 99 14                           jsr CHKCOM                ;TWO ARGS SO COMMA MUST DELIMIT.
 4286 A:14e7  20 3b 13                           jsr CHKSTR                ;MAKE SURE FIRST WAS STRING.
 4287 A:14ea  68                                 pla                    ;GET FUNCTION NUMBER.
 4288 A:14eb  aa                                 tax 
