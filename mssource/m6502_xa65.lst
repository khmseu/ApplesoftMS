 3782 A:1265                                    ;
 3783 A:1265                                    ; SUBROUTINE TO FIND DATA
 3784 A:1265                                    ; THE SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO
 3785 A:1265                                    ; SKIP OVER STATEMENTS. THE START WORD OF EACH STATEMENT
 3786 A:1265                                    ; IS COMPARED WITH "DATATK". EACH NEW LINE NUMBER
 3787 A:1265                                    ; IS STORED IN "DATLIN" SO THAT IF AN ERROR OCCURS
 3788 A:1265                                    ; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE
 3789 A:1265                                    ; NUMBER OF THE ILL-FORMATTED DATA.
 3790 A:1265                                    ;
 3791 A:1265                           DATLOP    
 3791 A:1265  20 53 0f                           jsr DATAN                ;SKIP SOME TEXT.
 3792 A:1268  c8                                 iny 
 3793 A:1269  aa                                 tax                    ;END OF LINE?
 3794 A:126a  d0 14                              bne NOWLIN                ;SHO AIN'T.
 3795 A:126c  a2 06                              ldx #6             ;YES = "NO DATA" ERROR.
 3796 A:126e  c8                                 iny 
 3797 A:126f  b1 b9                              lda (CHRGOT+1),Y
 3798 A:1271  f0 6b                              beq ERRGO5
 3799 A:1273  c8                                 iny 
 3800 A:1274  b1 b9                              lda (CHRGOT+1),Y      ;GET HIGH BYTE OF LINE NUMBER.
 3801 A:1276  85 7e                              sta DATLIN
 3802 A:1278  c8                                 iny 
 3803 A:1279  b1 b9                              lda (CHRGOT+1),Y      ;GET LOW BYTE.
 3804 A:127b  c8                                 iny 
 3805 A:127c  85 7f                              sta DATLIN+1
 3806 A:127e                           NOWLIN    
 3806 A:127e  b1 b9                              lda (CHRGOT+1),Y      ;HOW IS IT?
 3807 A:1280  aa                                 tax 
 3808 A:1281  20 48 0f                           jsr ADDON                ;ADD [Y] TO [TXTPTR].
 3809 A:1284  e0 7f                              cpx #127             ;IS IT A "DATA" STATEMENT.
 3810 A:1286  d0 dd                              bne DATLOP                ;NOT QUITE RIGHT. KEEP LOOKING.
 3811 A:1288  4c fe 11                           jmp DATBK1                ;THIS IS THE ONE !
 3812 A:128b                           VAREND    
 3812 A:128b                                    ;PUT AWAY A NEW DATA PNTR MAYBE.
 3813 A:128b  a5 82                              lda INPPTR
 3814 A:128d  a4 83                              ldy INPPTR+1
 3815 A:128f  a6 15                              ldx INPFLG
 3816 A:1291  10 05                              bpl VARY0
