 7055 A:2332                           FOUT4     
 7055 A:2332                                    
 7056 A:2332  a9 df                              lda #NZ9999&255
 7057 A:2334  a0 22                              ldy #NZ9999/256
 7058 A:2336  20 82 21                           jsr FCOMP                ;IS NUMBER .GT. 999999.499 ?
 7059 A:2339                                    ;OR 999999999.499?
 7060 A:2339  f0 22                              beq BIGGES
 7061 A:233b  10 16                              bpl FOUT9                ;YES. MAKE IT SMALLER.
 7062 A:233d                           FOUT3     
 7062 A:233d                                    
 7063 A:233d  a9 da                              lda #NZ0999&255
 7064 A:233f  a0 22                              ldy #NZ0999/256
 7065 A:2341  20 82 21                           jsr FCOMP                ;IS NUMBER .GT. 99999.9499 ?
 7066 A:2344                                    ; OR 99999999.9499?
 7067 A:2344  f0 06                              beq FOUT38
 7068 A:2346  10 12                              bpl FOUT5                ;YES. DONE MULTIPLYING.
 7069 A:2348                           FOUT38    
 7069 A:2348  20 06 20                           jsr MUL10                ;MAKE IT BIGGER.
 7070 A:234b  c6 9c                              dec LOWDS
 7071 A:234d  d0 ee                              bne FOUT3                ;SEE IF THAT DOES IT.
 7072 A:234f                                    ;THIS ALWAYS GOES.
 7073 A:234f                           FOUT9     
 7073 A:234f  20 22 20                           jsr DIV10                ;MAKE IT SMALLER.
 7074 A:2352  e6 9c                              inc LOWDS
 7075 A:2354  d0 dc                              bne FOUT4                ;SEE IF THAT DOES IT.
 7076 A:2356                                    ;THIS ALWAYS GOES.

 7078 A:2356                           FOUT5     
