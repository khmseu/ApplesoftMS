 3030 A:d859  c9 7f                              cmp #127             ;IS TERMINATING CHARACTER A GOTOTK?
 3031 A:d85b  f0 07                              beq OKGOTO                ;YES.
 3032 A:d85d                                    ;NO, IT MUST BE "THEN".
 3033 A:d85d  a9 81                              lda #129
 3034 A:d85f  20 76 dd                           jsr SYNCHR
 3035 A:d862                           OKGOTO    
