 5704 A:1c7b  90 b1                              bcc RLEFT3                ;NO, COPY THAT MUCH.
 5705 A:1c7d  a5 a4                              lda FACLO                ;GET LENGTH OF WHAT'S DESIRED.
 5706 A:1c7f  b0 ad                              bcs RLEFT3                ;COPY IT.

