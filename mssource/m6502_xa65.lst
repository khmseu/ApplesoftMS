 4381 A:de61                           STASGN    
 4381 A:de61  85 a5                              sta FACSGN                ;KEEP FOR LATER.
 4382 A:de63  a0 ff                              ldy #255             ;SET POINTER TO FIRST STRING. (ARG.)
 4383 A:de65  e8                                 inx                    ;TO LOOP PROPERLY.
 4384 A:de66                           NXTCMP    
 4384 A:de66  c8                                 iny 
 4385 A:de67  ca                                 dex                    ;ANY CHARACTERS LEFT TO COMPARE?
 4386 A:de68  d0 09                              bne GETCMP                ;NOT DONE YET.
 4387 A:de6a  a6 a5                              ldx FACSGN                ;USE SIGN OF LENGTH DIFFERENCE
 4388 A:de6c                                    ;SINCE ALL CHARACTERS ARE THE SAME.
 4389 A:de6c                           QCOMP     
 4389 A:de6c  30 11                              bmi DOCMP                ;C IS ALWAYS SET THEN.
 4390 A:de6e  18                                 clc 
 4391 A:de6f  90 0e                              bcc DOCMP                ;ALWAYS BRANCH.
 4392 A:de71                           GETCMP    
 4392 A:de71  b1 ab                              lda (ARGMO),Y            ;GET NEXT CHAR TO COMPARE.
 4393 A:de73  d1 a1                              cmp (FAC+1),Y      ;SAME?
 4394 A:de75  f0 ef                              beq NXTCMP                ;YEP. TRY FURTHER.
 4395 A:de77  a2 ff                              ldx #255             ;SET A POSITIVE DIFFERENCE.
 4396 A:de79  b0 04                              bcs DOCMP                ;PUT STACK BACK TOGETHER.
 4397 A:de7b  a2 01                              ldx #1             ;SET A NEGATIVE DIFFERENCE.
 4398 A:de7d                           DOCMP     
 4398 A:de7d  e8                                 inx                    ;-1 TO 1, 0 TO 2, 1 TO 4.
 4399 A:de7e  8a                                 txa 
 4400 A:de7f  2a                                 rol 
 4401 A:de80  25 16                              and TANSGN
 4402 A:de82  f0 04                              beq GOFLOT
 4403 A:de84  a9 ff                              lda #255             ;MAP 0 TO 0. ALL OTHERS TO -1.
 4404 A:de86                           GOFLOT    
 4404 A:de86  4c 3e ea                           jmp FLOAT                ;FLOAT THE ONE-BYTE RESULT INTO FAC.

 4406 A:de89                                    ; PAGE
 4407 A:de89                                    ; SUBTTL DIMENSION AND VARIABLE SEARCHING.
 4408 A:de89                                    ;
 4409 A:de89                                    ; THE "DIM" CODE SETS [DIMFLG] AND THEN FALLS INTO THE VARIABLE SEARCH
 4410 A:de89                                    ; ROUTINE, WHICH LOOKS AT DIMFLG AT THREE DIFFERENT POINTS.
 4411 A:de89                                    ; 1) IF AN ENTRY IS FOUND, "DIMFLG" BEING ON INDICATES
 4412 A:de89                                    ;  A "DOUBLY" DIMENSIONED VARIABLE.
 4413 A:de89                                    ; 2) WHEN A NEW ENTRY IS BEING BUILT "DIMFLG" BEING ON
 4414 A:de89                                    ;  INDICTAES THE INDICES SHOULD BE USED FOR THE
 4415 A:de89                                    ;  SIZE OF EACH INDEX. OTHERWISE THE DEFAULT OF TEN
 4416 A:de89                                    ;  IS USED.
 4417 A:de89                                    ; 3) WHEN THE BUILD ENTRY CODE FINISHES, ONLY IF "DIMFLG" IS OFF
 4418 A:de89                                    ;  WILL INDEXING BE DONE.
 4419 A:de89                                    ;
 4420 A:de89                           DIM3      
 4420 A:de89  20 74 dd                           jsr CHKCOM                ;MUST BE A COMMA
 4421 A:de8c                           DIM       
 4421 A:de8c  aa                                 tax                    ;SET [ACCX] NONZERO.
 4422 A:de8d                                    ;[ACCA] MUST BE NONZERO TO WORK RIGHT.
 4423 A:de8d                           DIM1      
 4423 A:de8d  20 9b de                           jsr PTRGT1
 4424 A:de90                           DIMCON    
 4424 A:de90  20 b8 00                           jsr CHRGOT                ;GET LAST CHARACTER.
 4425 A:de93  d0 f4                              bne DIM3
 4426 A:de95  60                                 rts 
 4427 A:de96                                    ;
 4428 A:de96                                    ; ROUTINE TO READ THE VARIABLE NAME AT THE CURRENT TEXT POSITION
 4429 A:de96                                    ; AND  PUT A POINTER TO ITS VALUE IN VARPNT. [TXTPTR]
 4430 A:de96                                    ; POINTS TO THE TERMINATING CHARCTER.. NOT THAT EVALUATING SUBSCRIPTS
 4431 A:de96                                    ; IN A VARIABLE NAME CAN CAUSE RECURSIVE CALLS TO "PTRGET" SO AT
 4432 A:de96                                    ; THAT POINT ALL VALUES MUST BE STORED ON THE STACK.
 4433 A:de96                                    ;
 4434 A:de96                           PTRGET    
 4434 A:de96  a2 00                              ldx #0             ;MAKE [ACCX]=0.
 4435 A:de98  20 b8 00                           jsr CHRGOT                ;RETRIEVE LAST CHARACTER.
 4436 A:de9b                           PTRGT1    
 4436 A:de9b  86 10                              stx DIMFLG                ;STORE FLAG AWAY.
 4437 A:de9d                           PTRGT2    
 4437 A:de9d  85 84                              sta VARNAM
 4438 A:de9f  20 b8 00                           jsr CHRGOT                ;GET CURRENT CHARACTER
 4439 A:dea2                                    ;MAYBE WITH FUNCTION BIT OFF.
 4440 A:dea2  20 20 df                           jsr ISLETC                ;CHECK FOR LETTER.
 4441 A:dea5  b0 05                              bcs PTRGT3                ;MUST HAVE A LETTER.
 4442 A:dea7                           INTERR    
 4442 A:dea7  4c 7f dd                           jmp SNERR
 4443 A:deaa                           PTRGT3    
 4443 A:deaa  a2 00                              ldx #0             ;ASSUME NO SECOND CHARACTER.
 4444 A:deac  86 11                              stx VALTYP                ;DEFAULT IS NUMERIC.

 4447 A:deae  86 12                              stx INTFLG

 4449 A:deb0  20 b2 00                           jsr CHRGET                ;GET FOLLOWING CHARACTER.
 4450 A:deb3  90 07                              bcc ISSEC                ;CARRY RESET BY CHRGET IF NUMERIC.
 4451 A:deb5  20 20 df                           jsr ISLETC                ;SET CARRY IF NOT ALPHABETIC.
 4452 A:deb8  90 0d                              bcc NOSEC                ;ALLOW ALPHABETICS.
 4453 A:deba                           ISSEC     
 4453 A:deba  aa                                 tax                    ;IT IS A NUMBER -- SAVE IN ACCX.
 4454 A:debb                           EATEM     
 4454 A:debb  20 b2 00                           jsr CHRGET                ;LOOK AT NEXT CHARACTER.
 4455 A:debe  90 fb                              bcc EATEM                ;SKIP NUMERICS.
 4456 A:dec0  20 20 df                           jsr ISLETC
 4457 A:dec3  b0 f6                              bcs EATEM                ;SKIP ALPHABETICS.
 4458 A:dec5                           NOSEC     
 4458 A:dec5  c9 24                              cmp #"$"             ;IS IT A STRING?
 4459 A:dec7  d0 08                              bne NOTSTR                ;IF NOT, [VALTYP]=0.
 4460 A:dec9  a9 ff                              lda #255             ;SET [VALTYP]=255 (STRING !).
 4461 A:decb  85 11                              sta VALTYP

 4464 A:decd  d0 12                              bne TURNON
 4465 A:decf                           NOTSTR    
 4465 A:decf  c9 25                              cmp #"%"
 4466 A:ded1  d0 15                              bne STRNAM
 4467 A:ded3  a5 14                              lda SUBFLG
 4468 A:ded5  d0 d0                              bne INTERR
 4469 A:ded7  a9 80                              lda #128
 4470 A:ded9  85 12                              sta INTFLG
 4471 A:dedb  05 84                              ora VARNAM
 4472 A:dedd  85 84                              sta VARNAM

 4474 A:dedf                           TURNON    
 4474 A:dedf  8a                                 txa 
 4475 A:dee0  09 80                              ora #128             ;TURN ON MSB OF SECOND CHARACTER.
 4476 A:dee2  aa                                 tax 
 4477 A:dee3  20 b2 00                           jsr CHRGET                ;GET CHARACTER AFTER $.

 4482 A:dee6                           STRNAM    
 4482 A:dee6  86 85                              stx VARNAM+1          ;STORE AWAY SECOND CHARACTER.
 4483 A:dee8  38                                 sec 
 4484 A:dee9  05 14                              ora SUBFLG                ;ADD FLAG WHETHER TO ALLOW ARRAYS.
 4485 A:deeb  e9 28                              sbc #40             ;(CHECK FOR "(") WON'T MATCH IF SUBFLG SET. 
 4486 A:deed                                    ;IT IS!
 4487 A:deed  d0 03                              bne *+5
 4488 A:deef  4c c2 df                           jmp ISARY
 4489 A:def2                                    ;ALLOW SUBSCRIPTS AGAIN.
 4490 A:def2  a9 00                              lda #0
 4491 A:def4  85 14                              sta SUBFLG
 4492 A:def6  a5 6c                              lda VARTAB                ;PLACE TO START SEARCH.
 4493 A:def8  a6 6d                              ldx VARTAB+1
 4494 A:defa  a0 00                              ldy #0
 4495 A:defc                           STXFND    
 4495 A:defc  86 9f                              stx LOWTR+1
 4496 A:defe                           LOPFND    
 4496 A:defe  85 9e                              sta LOWTR
 4497 A:df00  e4 6f                              cpx ARYTAB+1          ;AT END OF TABLE YET?
 4498 A:df02  d0 06                              bne LOPFN
 4499 A:df04  c5 6e                              cmp ARYTAB
 4500 A:df06  f0 24                              beq NOTFNS                ;YES. WE COULDN'T FIND IT.
 4501 A:df08                           LOPFN     
 4501 A:df08  a5 84                              lda VARNAM
 4502 A:df0a  d1 9e                              cmp (LOWTR),Y            ;COMPARE HIGH ORDERS.
 4503 A:df0c  d0 0a                              bne NOTIT                ;NO COMPARISON.
 4504 A:df0e  a5 85                              lda VARNAM+1
 4505 A:df10  c8                                 iny 
 4506 A:df11  d1 9e                              cmp (LOWTR),Y            ;AND THE LOW PART?
 4507 A:df13  f0 6c                              beq FINPTR                ;THAT'S IT ! THAT'S IT !
 4508 A:df15  88                                 dey 
 4509 A:df16                           NOTIT     
 4509 A:df16  18                                 clc 
 4510 A:df17  a5 9e                              lda LOWTR
 4511 A:df19  69 07                              adc #6+1       ;MAKES NO DIF AMONG TYPES.
 4512 A:df1b  90 e1                              bcc LOPFND
 4513 A:df1d  e8                                 inx 
 4514 A:df1e  d0 dc                              bne STXFND                ;ALWAYS BRANCHES.

 4516 A:df20                                    ;
 4517 A:df20                                    ; TEST FOR A LETTER. / CARRY OFF= NOT A LETTER.
 4518 A:df20                                    ;     CARRY ON= A LETTER.
 4519 A:df20                                    ;
 4520 A:df20                           ISLETC    
 4520 A:df20  c9 41                              cmp #"A"
 4521 A:df22  90 07                              bcc ISLRTS                ;IF LESS THAN "A", RET.
 4522 A:df24  e9 5b                              sbc #"Z"+1
 4523 A:df26  38                                 sec 
 4524 A:df27  e9 a5                              sbc #256-"Z"-1 ;RESET CARRY IF [A] .GT. "Z".
 4525 A:df29                           ISLRTS    
 4525 A:df29  60                                 rts                    ;RETURN TO CALLER.

 4527 A:df2a                           NOTFNS    
 4527 A:df2a  68                                 pla                    ;CHECK WHO'S CALLING.
 4528 A:df2b  48                                 pha                    ;RESTORE IT.
 4529 A:df2c  c9 00                              cmp #((((ISVRET-1)-ISVRET)-1)/256)*256;IS EVAL CALLING?
 4530 A:df2e  d0 0f                              bne NOTEVL                ;NO, CARRY ON.

 4533 A:df30  ba                                 tsx 
 4534 A:df31  bd 02 01                           lda 258,X
 4535 A:df34  c9 dd                              cmp #(ISVRET-1)/256
 4536 A:df36  d0 07                              bne NOTEVL

 4538 A:df38                           LDZR      
 4538 A:df38                                    ;SET UP PNTR TO SIMULATED ZERO.
 4539 A:df38  a9 0d                              lda #ZERO&255
 4540 A:df3a  a0 ed                              ldy #ZERO/256
 4541 A:df3c  60                                 rts                    ;FOR STRINGS OR NUMERIC.
 4542 A:df3d                                    ;AND FOR INTEGERS TOO.
 4543 A:df3d                           NOTEVL    
 4543 A:df3d                                    

 4563 A:df3d                           QSTAVR    
 4563 A:df3d                                    

 4571 A:df3d                           VAROK     
 4571 A:df3d                                    
 4572 A:df3d  a5 6e                              lda ARYTAB
 4573 A:df3f  a4 6f                              ldy ARYTAB+1
 4574 A:df41                                    ;LOWEST THING TO MOVE.
 4575 A:df41  85 9e                              sta LOWTR
 4576 A:df43  84 9f                              sty LOWTR+1
 4577 A:df45                                    ;GET HIGHEST ADDR TO MOVE.
 4578 A:df45  a5 70                              lda STREND
 4579 A:df47  a4 71                              ldy STREND+1

 4581 A:df49  85 99                              sta HIGHTR
 4582 A:df4b  84 9a                              sty HIGHTR+1
 4583 A:df4d  18                                 clc 
 4584 A:df4e  69 07                              adc #6+1
 4585 A:df50  90 03                              bcc NOTEVE
 4586 A:df52  c8                                 iny 
 4587 A:df53                           NOTEVE    
 4587 A:df53                                    ;PLACE TO STUFF IT.
 4588 A:df53  85 97                              sta HIGHDS
 4589 A:df55  84 98                              sty HIGHDS+1
 4590 A:df57  20 9e d2                           jsr BLTU                ;MOVE IT ALL.
 4591 A:df5a                                    ;NOTE [Y,A] HAS [HIGHDS] FOR REASON.
 4592 A:df5a                                    ;AND SET UP
 4593 A:df5a  a5 97                              lda HIGHDS
 4594 A:df5c  a4 98                              ldy HIGHDS+1
 4595 A:df5e  c8                                 iny 
 4596 A:df5f                                    ;NEW START OF ARRAY TABLE.
 4597 A:df5f  85 6e                              sta ARYTAB
 4598 A:df61  84 6f                              sty ARYTAB+1
 4599 A:df63  a0 00                              ldy #0             ;GET ADDR OF VARIABLE ENTRY.
 4600 A:df65  a5 84                              lda VARNAM
 4601 A:df67  91 9e                              sta (LOWTR),Y
 4602 A:df69  c8                                 iny 
 4603 A:df6a  a5 85                              lda VARNAM+1
 4604 A:df6c  91 9e                              sta (LOWTR),Y            ;STORE NAME OF VARIABLE.
 4605 A:df6e  a9 00                              lda #0
 4606 A:df70  c8                                 iny 
 4607 A:df71  91 9e                              sta (LOWTR),Y
 4608 A:df73  c8                                 iny 
 4609 A:df74  91 9e                              sta (LOWTR),Y
 4610 A:df76  c8                                 iny 
 4611 A:df77  91 9e                              sta (LOWTR),Y
 4612 A:df79  c8                                 iny 
 4613 A:df7a  91 9e                              sta (LOWTR),Y            ;FOURTH ZERO FOR DEF FUNC.

 4616 A:df7c  c8                                 iny 
 4617 A:df7d  91 9e                              sta (LOWTR),Y

 4619 A:df7f                           FINPTR    
 4619 A:df7f  a5 9e                              lda LOWTR
 4620 A:df81  18                                 clc 
 4621 A:df82  69 02                              adc #2
 4622 A:df84  a4 9f                              ldy LOWTR+1
 4623 A:df86  90 03                              bcc FINNOW
 4624 A:df88  c8                                 iny 
 4625 A:df89                           FINNOW    
 4625 A:df89                                    ;THIS IS IT.
 4626 A:df89  85 86                              sta VARPNT
 4627 A:df8b  84 87                              sty VARPNT+1
 4628 A:df8d  60                                 rts 
 4629 A:df8e                                    ; PAGE
 4630 A:df8e                                    ; SUBTTL MULTIPLE DIMENSION CODE.
 4631 A:df8e                           FMAPTR    
