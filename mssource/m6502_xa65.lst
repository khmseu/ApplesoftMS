 4807 A:178e  c8                                 iny 
 4808 A:178f  a5 85                              lda VARNAM+1
 4809 A:1791  91 9e                              sta (LOWTR),Y
 4810 A:1793  10 04                              bpl STOMLT
 4811 A:1795  ca                                 dex 

 4814 A:1796  ca                                 dex 

