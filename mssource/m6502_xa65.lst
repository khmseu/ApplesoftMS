 5571 A:e492                                    ;
 5572 A:e492                                    ; "FRETMP" IS PASSED A STRING DESCRIPTOR PNTR IN [Y,A].
 5573 A:e492                                    ; A CHECK IS MADE TO SEE IF THE STRING DESCRIPTOR POINTS TO THE LAST
 5574 A:e492                                    ; TEMPORARY DESCRIPTOR ALLOCATED BY PUTNEW.
 5575 A:e492                                    ; IF SO, THE TEMPORARY IS FREED UP BY THE UPDATING OF [TEMPPT].
 5576 A:e492                                    ; IF A TEMP IS FREED UP, A FURTHER CHECK SEES IF THE STRING DATA THAT
 5577 A:e492                                    ; THAT STRING TEMP PNT'D TO IS THE LOWEST PART OF STRING SPACE IN USE.
 5578 A:e492                                    ; IF SO, [FRETOP] IS UPDATED TO REFLECT THE FACT THE FACT THAT THE SPACE
 5579 A:e492                                    ; IS NO LONGER IN USE.
 5580 A:e492                                    ; THE ADDR OF THE ACTUAL STRING IS RETURNED IN [Y,X] AND
 5581 A:e492                                    ; ITS LENGTH IN ACCA.
 5582 A:e492                                    ;
 5583 A:e492                           FRESTR    
 5583 A:e492  20 0a dc                           jsr CHKSTR                ;MAKE SURE ITS A STRING.
 5584 A:e495                           FREFAC    
 5584 A:e495                                    ;FREE UP STR PNT'D TO BY FAC.
 5585 A:e495  a5 a3                              lda FACMO
 5586 A:e497  a4 a4                              ldy FACMO+1
 5587 A:e499                           FRETMP    
 5587 A:e499                                    ;GET LENGTH FOR LATER.
 5588 A:e499  85 61                              sta INDEX1
 5589 A:e49b  84 62                              sty INDEX1+1
 5590 A:e49d  20 ca e4                           jsr FRETMS                ;FREE UP THE TEMPORARY DESC.
 5591 A:e4a0  08                                 php                    ;SAVE CODES.
 5592 A:e4a1  a0 00                              ldy #0             ;PREP TO GET STUFF.
 5593 A:e4a3  b1 61                              lda (INDEX1),Y            ;GET COUNT AND
 5594 A:e4a5  48                                 pha                    ;SAVE IT.
 5595 A:e4a6  c8                                 iny 
 5596 A:e4a7  b1 61                              lda (INDEX1),Y
 5597 A:e4a9  aa                                 tax                    ;SAVE LOW ORDER.
 5598 A:e4aa  c8                                 iny 
 5599 A:e4ab  b1 61                              lda (INDEX1),Y
 5600 A:e4ad  a8                                 tay                    ;SAVE HIGH ORDER.
 5601 A:e4ae  68                                 pla 
 5602 A:e4af  28                                 plp                    ;RETURN STATUS.
 5603 A:e4b0  d0 17                              bne FRETRT
 5604 A:e4b2  c4 73                              cpy FRETOP+1          ;STRING IS LAST ONE IN?
 5605 A:e4b4  d0 13                              bne FRETRT
 5606 A:e4b6  e4 72                              cpx FRETOP
 5607 A:e4b8  d0 0f                              bne FRETRT
 5608 A:e4ba  48                                 pha 
 5609 A:e4bb  18                                 clc 
 5610 A:e4bc  65 72                              adc FRETOP
 5611 A:e4be  85 72                              sta FRETOP
 5612 A:e4c0  90 06                              bcc FREPLA
 5613 A:e4c2  e6 73                              inc FRETOP+1
 5614 A:e4c4                           FREPLA    
 5614 A:e4c4  68                                 pla                    ;GET COUNT BACK.
 5615 A:e4c5                           FRETRT    
 5615 A:e4c5                                    ;SAVE FOR LATER USE.
 5616 A:e4c5  86 61                              stx INDEX1
 5617 A:e4c7  84 62                              sty INDEX1+1
 5618 A:e4c9  60                                 rts 
 5619 A:e4ca                           FRETMS    
 5619 A:e4ca  c4 57                              cpy LASTPT+1          ;LAST ENTRY TO TEMP? 
 5620 A:e4cc  d0 10                              bne FRERTS
 5621 A:e4ce  c5 56                              cmp LASTPT
 5622 A:e4d0  d0 0c                              bne FRERTS
 5623 A:e4d2  85 55                              sta TEMPPT
 5624 A:e4d4  e9 03                              sbc #3             ;POINT TO LAST ONE.
 5625 A:e4d6  85 56                              sta LASTPT                ;UPDATE TEMP PNTR.
 5626 A:e4d8  a0 00                              ldy #0             ;ALSO CLEARS ZFLG SO WE DO REST OF FRETMP.
 5627 A:e4da                           FRERTS    
 5627 A:e4da  60                                 rts                    ;ALL DONE.
