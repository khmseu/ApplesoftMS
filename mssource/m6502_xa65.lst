 4570 A:1662  a5 6e                              lda ARYTAB
 4571 A:1664  a4 6f                              ldy ARYTAB+1
 4572 A:1666                                    ;LOWEST THING TO MOVE.
 4573 A:1666  85 9e                              sta LOWTR
 4574 A:1668  84 9f                              sty LOWTR+1
 4575 A:166a                                    ;GET HIGHEST ADDR TO MOVE.
 4576 A:166a  a5 70                              lda STREND
 4577 A:166c  a4 71                              ldy STREND+1

 4579 A:166e  85 99                              sta HIGHTR
 4580 A:1670  84 9a                              sty HIGHTR+1
 4581 A:1672  18                                 clc 
 4582 A:1673  69 07                              adc #6+1
 4583 A:1675  90 03                              bcc NOTEVE
 4584 A:1677  c8                                 iny 
 4585 A:1678                           NOTEVE    
 4585 A:1678                                    ;PLACE TO STUFF IT.
 4586 A:1678  85 97                              sta HIGHDS
 4587 A:167a  84 98                              sty HIGHDS+1
 4588 A:167c  20 c4 09                           jsr BLTU                ;MOVE IT ALL.
 4589 A:167f                                    ;NOTE [Y,A] HAS [HIGHDS] FOR REASON.
 4590 A:167f                                    ;AND SET UP
 4591 A:167f  a5 97                              lda HIGHDS
 4592 A:1681  a4 98                              ldy HIGHDS+1
 4593 A:1683  c8                                 iny 
 4594 A:1684                                    ;NEW START OF ARRAY TABLE.
 4595 A:1684  85 6e                              sta ARYTAB
 4596 A:1686  84 6f                              sty ARYTAB+1
 4597 A:1688  a0 00                              ldy #0             ;GET ADDR OF VARIABLE ENTRY.
 4598 A:168a  a5 84                              lda VARNAM
 4599 A:168c  91 9e                              sta (LOWTR),Y
