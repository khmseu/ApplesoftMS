 3784 A:db40                                    ;
 3785 A:db40                                    ; SUBROUTINE TO FIND DATA
 3786 A:db40                                    ; THE SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO
 3787 A:db40                                    ; SKIP OVER STATEMENTS. THE START WORD OF EACH STATEMENT
 3788 A:db40                                    ; IS COMPARED WITH "DATATK". EACH NEW LINE NUMBER
 3789 A:db40                                    ; IS STORED IN "DATLIN" SO THAT IF AN ERROR OCCURS
 3790 A:db40                                    ; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE
 3791 A:db40                                    ; NUMBER OF THE ILL-FORMATTED DATA.
 3792 A:db40                                    ;
 3793 A:db40                           DATLOP    
 3793 A:db40  20 2e d8                           jsr DATAN                ;SKIP SOME TEXT.
 3794 A:db43  c8                                 iny 
 3795 A:db44  aa                                 tax                    ;END OF LINE?
 3796 A:db45  d0 14                              bne NOWLIN                ;SHO AIN'T.
 3797 A:db47  a2 2a                              ldx #42             ;YES = "NO DATA" ERROR.
 3798 A:db49  c8                                 iny 
 3799 A:db4a  b1 b9                              lda (CHRGOT+1),Y
 3800 A:db4c  f0 6b                              beq ERRGO5
 3801 A:db4e  c8                                 iny 
 3802 A:db4f  b1 b9                              lda (CHRGOT+1),Y      ;GET HIGH BYTE OF LINE NUMBER.
 3803 A:db51  85 7e                              sta DATLIN
 3804 A:db53  c8                                 iny 
 3805 A:db54  b1 b9                              lda (CHRGOT+1),Y      ;GET LOW BYTE.
 3806 A:db56  c8                                 iny 
 3807 A:db57  85 7f                              sta DATLIN+1
 3808 A:db59                           NOWLIN    
 3808 A:db59  b1 b9                              lda (CHRGOT+1),Y      ;HOW IS IT?
 3809 A:db5b  aa                                 tax 
 3810 A:db5c  20 23 d8                           jsr ADDON                ;ADD [Y] TO [TXTPTR].
 3811 A:db5f  e0 7f                              cpx #127             ;IS IT A "DATA" STATEMENT.
 3812 A:db61  d0 dd                              bne DATLOP                ;NOT QUITE RIGHT. KEEP LOOKING.
 3813 A:db63  4c d9 da                           jmp DATBK1                ;THIS IS THE ONE !
 3814 A:db66                           VAREND    
 3814 A:db66                                    ;PUT AWAY A NEW DATA PNTR MAYBE.
 3815 A:db66  a5 82                              lda INPPTR
 3816 A:db68  a4 83                              ldy INPPTR+1
 3817 A:db6a  a6 15                              ldx INPFLG
 3818 A:db6c  10 05                              bpl VARY0
 3819 A:db6e  4c e7 d6                           jmp RESFIN
 3820 A:db71                           VARY0     
 3820 A:db71  a0 00                              ldy #0
