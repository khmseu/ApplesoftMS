 2880 A:d781  00                                 .byt 0

 2882 A:d782                           VARTIO    
 2882 A:d782                                    
 2883 A:d782  a9 53                              lda #LINNUM&255
 2884 A:d784  a0 00                              ldy #LINNUM/256

 2886 A:d786  85 3c                              sta 60
