 4293 A:14f1  48                                 pha 
 4294 A:14f2  8a                                 txa 
 4295 A:14f3  48                                 pha                    ;RESAVE FUNCTION NUMBER.
 4296 A:14f4                                    ;THIS MUST BE ON STACK SINCE RECURSIVE.
 4297 A:14f4  20 be 1c                           jsr GETBYT                ;[X]=VALUE OF FORMULA.
 4298 A:14f7  68                                 pla                    ;GET FUNCTION NUMBER.
 4299 A:14f8  a8                                 tay 
 4300 A:14f9  8a                                 txa 
 4301 A:14fa  48                                 pha 
 4302 A:14fb  4c 03 15                           jmp FINGO                ;DISPATCH TO FUNCTION.
