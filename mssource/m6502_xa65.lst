 5681 A:e532                                    ;
 5682 A:e532                                    ; MID ($,#) RETURNS STRING WITH CHARS FROM # POSITION
 5683 A:e532                                    ; ONWARD. IF # .GT. LEN ($) THEN RETURN NULL STRING.
 5684 A:e532                                    ; MID ($,#,#) RETURNS STRING WITH CHARACTERS FROM
 5685 A:e532                                    ; # POSITION FOR #2 CHARACTERS. IF #2 GOES PAST END OF STRING
 5686 A:e532                                    ; RETURN AS MUCH AS POSSIBLE.
 5687 A:e532                                    ;
 5688 A:e532                           MID       
 5688 A:e532  a9 ff                              lda #255             ;DEFAULT.
 5689 A:e534  85 a4                              sta FACLO                ;SAVE FOR LATER COMPARE.
 5690 A:e536  20 b8 00                           jsr CHRGOT                ;GET CURRENT CHARACTER.
 5691 A:e539  c9 29                              cmp #41             ;IS IT A RIGHT PAREN )?
 5692 A:e53b  f0 0a                              beq MID2                ;NO THIRD PARAM.
 5693 A:e53d  20 74 dd                           jsr CHKCOM                ;MUST HAVE COMMA.
 5694 A:e540  20 99 e5                           jsr GETBYT                ;GET THE LENGTH INTO "FACLO".
 5695 A:e543                           MID2      
 5695 A:e543  20 5c e5                           jsr PREAM                ;CHECK IT OUT.
 5696 A:e546  f0 4f                              beq GOFUC                ;THERE IS NO POSTION 0
 5697 A:e548  ca                                 dex                    ;COMPUTE OFFSET.
 5698 A:e549  8a                                 txa 
