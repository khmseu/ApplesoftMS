 4602 A:1691  91 9e                              sta (LOWTR),Y            ;STORE NAME OF VARIABLE.
 4603 A:1693  a9 00                              lda #0
 4604 A:1695  c8                                 iny 
 4605 A:1696  91 9e                              sta (LOWTR),Y
 4606 A:1698  c8                                 iny 
