 4383 A:de5a                           NXTCMP    
 4383 A:de5a  c8                                 iny 
 4384 A:de5b  ca                                 dex                    ;ANY CHARACTERS LEFT TO COMPARE?
 4385 A:de5c  d0 09                              bne GETCMP                ;NOT DONE YET.
 4386 A:de5e  a6 a5                              ldx FACSGN                ;USE SIGN OF LENGTH DIFFERENCE
 4387 A:de60                                    ;SINCE ALL CHARACTERS ARE THE SAME.
 4388 A:de60                           QCOMP     
 4388 A:de60  30 11                              bmi DOCMP                ;C IS ALWAYS SET THEN.
 4389 A:de62  18                                 clc 
 4390 A:de63  90 0e                              bcc DOCMP                ;ALWAYS BRANCH.
 4391 A:de65                           GETCMP    
 4391 A:de65  b1 ab                              lda (ARGMO),Y            ;GET NEXT CHAR TO COMPARE.
 4392 A:de67  d1 a1                              cmp (FAC+1),Y      ;SAME?
 4393 A:de69  f0 ef                              beq NXTCMP                ;YEP. TRY FURTHER.
 4394 A:de6b  a2 ff                              ldx #255             ;SET A POSITIVE DIFFERENCE.
 4395 A:de6d  b0 04                              bcs DOCMP                ;PUT STACK BACK TOGETHER.
 4396 A:de6f  a2 01                              ldx #1             ;SET A NEGATIVE DIFFERENCE.
 4397 A:de71                           DOCMP     
 4397 A:de71  e8                                 inx                    ;-1 TO 1, 0 TO 2, 1 TO 4.
 4398 A:de72  8a                                 txa 
 4399 A:de73  2a                                 rol 
 4400 A:de74  25 16                              and TANSGN
 4401 A:de76  f0 04                              beq GOFLOT
 4402 A:de78  a9 ff                              lda #255             ;MAP 0 TO 0. ALL OTHERS TO -1.
 4403 A:de7a                           GOFLOT    
 4403 A:de7a  4c 32 ea                           jmp FLOAT                ;FLOAT THE ONE-BYTE RESULT INTO FAC.

 4405 A:de7d                                    ; PAGE
 4406 A:de7d                                    ; SUBTTL DIMENSION AND VARIABLE SEARCHING.
 4407 A:de7d                                    ;
 4408 A:de7d                                    ; THE "DIM" CODE SETS [DIMFLG] AND THEN FALLS INTO THE VARIABLE SEARCH
 4409 A:de7d                                    ; ROUTINE, WHICH LOOKS AT DIMFLG AT THREE DIFFERENT POINTS.
 4410 A:de7d                                    ; 1) IF AN ENTRY IS FOUND, "DIMFLG" BEING ON INDICATES
 4411 A:de7d                                    ;  A "DOUBLY" DIMENSIONED VARIABLE.
 4412 A:de7d                                    ; 2) WHEN A NEW ENTRY IS BEING BUILT "DIMFLG" BEING ON
 4413 A:de7d                                    ;  INDICTAES THE INDICES SHOULD BE USED FOR THE
 4414 A:de7d                                    ;  SIZE OF EACH INDEX. OTHERWISE THE DEFAULT OF TEN
 4415 A:de7d                                    ;  IS USED.
 4416 A:de7d                                    ; 3) WHEN THE BUILD ENTRY CODE FINISHES, ONLY IF "DIMFLG" IS OFF
 4417 A:de7d                                    ;  WILL INDEXING BE DONE.
 4418 A:de7d                                    ;
 4419 A:de7d                           DIM3      
 4419 A:de7d  20 68 dd                           jsr CHKCOM                ;MUST BE A COMMA
 4420 A:de80                           DIM       
 4420 A:de80  aa                                 tax                    ;SET [ACCX] NONZERO.
 4421 A:de81                                    ;[ACCA] MUST BE NONZERO TO WORK RIGHT.
 4422 A:de81                           DIM1      
 4422 A:de81  20 8f de                           jsr PTRGT1
 4423 A:de84                           DIMCON    
 4423 A:de84  20 b8 00                           jsr CHRGOT                ;GET LAST CHARACTER.
 4424 A:de87  d0 f4                              bne DIM3
 4425 A:de89  60                                 rts 
 4426 A:de8a                                    ;
 4427 A:de8a                                    ; ROUTINE TO READ THE VARIABLE NAME AT THE CURRENT TEXT POSITION
 4428 A:de8a                                    ; AND  PUT A POINTER TO ITS VALUE IN VARPNT. [TXTPTR]
 4429 A:de8a                                    ; POINTS TO THE TERMINATING CHARCTER.. NOT THAT EVALUATING SUBSCRIPTS
 4430 A:de8a                                    ; IN A VARIABLE NAME CAN CAUSE RECURSIVE CALLS TO "PTRGET" SO AT
 4431 A:de8a                                    ; THAT POINT ALL VALUES MUST BE STORED ON THE STACK.
 4432 A:de8a                                    ;
 4433 A:de8a                           PTRGET    
 4433 A:de8a  a2 00                              ldx #0             ;MAKE [ACCX]=0.
 4434 A:de8c  20 b8 00                           jsr CHRGOT                ;RETRIEVE LAST CHARACTER.
 4435 A:de8f                           PTRGT1    
 4435 A:de8f  86 10                              stx DIMFLG                ;STORE FLAG AWAY.
 4436 A:de91                           PTRGT2    
 4436 A:de91  85 84                              sta VARNAM
 4437 A:de93  20 b8 00                           jsr CHRGOT                ;GET CURRENT CHARACTER
 4438 A:de96                                    ;MAYBE WITH FUNCTION BIT OFF.
 4439 A:de96  20 14 df                           jsr ISLETC                ;CHECK FOR LETTER.
 4440 A:de99  b0 05                              bcs PTRGT3                ;MUST HAVE A LETTER.
 4441 A:de9b                           INTERR    
 4441 A:de9b  4c 73 dd                           jmp SNERR
 4442 A:de9e                           PTRGT3    
 4442 A:de9e  a2 00                              ldx #0             ;ASSUME NO SECOND CHARACTER.
 4443 A:dea0  86 11                              stx VALTYP                ;DEFAULT IS NUMERIC.

 4446 A:dea2  86 12                              stx INTFLG

 4448 A:dea4  20 b2 00                           jsr CHRGET                ;GET FOLLOWING CHARACTER.
 4449 A:dea7  90 07                              bcc ISSEC                ;CARRY RESET BY CHRGET IF NUMERIC.
 4450 A:dea9  20 14 df                           jsr ISLETC                ;SET CARRY IF NOT ALPHABETIC.
 4451 A:deac  90 0d                              bcc NOSEC                ;ALLOW ALPHABETICS.
 4452 A:deae                           ISSEC     
 4452 A:deae  aa                                 tax                    ;IT IS A NUMBER -- SAVE IN ACCX.
 4453 A:deaf                           EATEM     
 4453 A:deaf  20 b2 00                           jsr CHRGET                ;LOOK AT NEXT CHARACTER.
 4454 A:deb2  90 fb                              bcc EATEM                ;SKIP NUMERICS.
 4455 A:deb4  20 14 df                           jsr ISLETC
 4456 A:deb7  b0 f6                              bcs EATEM                ;SKIP ALPHABETICS.
 4457 A:deb9                           NOSEC     
 4457 A:deb9  c9 24                              cmp #"$"             ;IS IT A STRING?
 4458 A:debb  d0 08                              bne NOTSTR                ;IF NOT, [VALTYP]=0.
 4459 A:debd  a9 ff                              lda #255             ;SET [VALTYP]=255 (STRING !).
 4460 A:debf  85 11                              sta VALTYP

 4463 A:dec1  d0 12                              bne TURNON
 4464 A:dec3                           NOTSTR    
 4464 A:dec3  c9 25                              cmp #"%"
 4465 A:dec5  d0 15                              bne STRNAM
 4466 A:dec7  a5 14                              lda SUBFLG
 4467 A:dec9  d0 d0                              bne INTERR
 4468 A:decb  a9 80                              lda #128
 4469 A:decd  85 12                              sta INTFLG
 4470 A:decf  05 84                              ora VARNAM
 4471 A:ded1  85 84                              sta VARNAM

 4473 A:ded3                           TURNON    
 4473 A:ded3  8a                                 txa 
 4474 A:ded4  09 80                              ora #128             ;TURN ON MSB OF SECOND CHARACTER.
 4475 A:ded6  aa                                 tax 
 4476 A:ded7  20 b2 00                           jsr CHRGET                ;GET CHARACTER AFTER $.

 4481 A:deda                           STRNAM    
 4481 A:deda  86 85                              stx VARNAM+1          ;STORE AWAY SECOND CHARACTER.
 4482 A:dedc  38                                 sec 
 4483 A:dedd  05 14                              ora SUBFLG                ;ADD FLAG WHETHER TO ALLOW ARRAYS.
 4484 A:dedf  e9 28                              sbc #40             ;(CHECK FOR "(") WON'T MATCH IF SUBFLG SET. 
 4485 A:dee1                                    ;IT IS!
 4486 A:dee1  d0 03                              bne *+5
 4487 A:dee3  4c b6 df                           jmp ISARY
 4488 A:dee6                                    ;ALLOW SUBSCRIPTS AGAIN.
 4489 A:dee6  a9 00                              lda #0
 4490 A:dee8  85 14                              sta SUBFLG
 4491 A:deea  a5 6c                              lda VARTAB                ;PLACE TO START SEARCH.
 4492 A:deec  a6 6d                              ldx VARTAB+1
 4493 A:deee  a0 00                              ldy #0
 4494 A:def0                           STXFND    
 4494 A:def0  86 9f                              stx LOWTR+1
 4495 A:def2                           LOPFND    
 4495 A:def2  85 9e                              sta LOWTR
 4496 A:def4  e4 6f                              cpx ARYTAB+1          ;AT END OF TABLE YET?
 4497 A:def6  d0 06                              bne LOPFN
 4498 A:def8  c5 6e                              cmp ARYTAB
 4499 A:defa  f0 24                              beq NOTFNS                ;YES. WE COULDN'T FIND IT.
 4500 A:defc                           LOPFN     
 4500 A:defc  a5 84                              lda VARNAM
 4501 A:defe  d1 9e                              cmp (LOWTR),Y            ;COMPARE HIGH ORDERS.
 4502 A:df00  d0 0a                              bne NOTIT                ;NO COMPARISON.
 4503 A:df02  a5 85                              lda VARNAM+1
 4504 A:df04  c8                                 iny 
 4505 A:df05  d1 9e                              cmp (LOWTR),Y            ;AND THE LOW PART?
 4506 A:df07  f0 6c                              beq FINPTR                ;THAT'S IT ! THAT'S IT !
 4507 A:df09  88                                 dey 
 4508 A:df0a                           NOTIT     
 4508 A:df0a  18                                 clc 
 4509 A:df0b  a5 9e                              lda LOWTR
 4510 A:df0d  69 07                              adc #6+1       ;MAKES NO DIF AMONG TYPES.
 4511 A:df0f  90 e1                              bcc LOPFND
 4512 A:df11  e8                                 inx 
 4513 A:df12  d0 dc                              bne STXFND                ;ALWAYS BRANCHES.

 4515 A:df14                                    ;
 4516 A:df14                                    ; TEST FOR A LETTER. / CARRY OFF= NOT A LETTER.
 4517 A:df14                                    ;     CARRY ON= A LETTER.
 4518 A:df14                                    ;
 4519 A:df14                           ISLETC    
 4519 A:df14  c9 41                              cmp #"A"
 4520 A:df16  90 07                              bcc ISLRTS                ;IF LESS THAN "A", RET.
 4521 A:df18  e9 5b                              sbc #"Z"+1
 4522 A:df1a  38                                 sec 
 4523 A:df1b  e9 a5                              sbc #256-"Z"-1 ;RESET CARRY IF [A] .GT. "Z".
 4524 A:df1d                           ISLRTS    
 4524 A:df1d  60                                 rts                    ;RETURN TO CALLER.

 4526 A:df1e                           NOTFNS    
 4526 A:df1e  68                                 pla                    ;CHECK WHO'S CALLING.
 4527 A:df1f  48                                 pha                    ;RESTORE IT.
 4528 A:df20  c9 00                              cmp #((((ISVRET-1)-ISVRET)-1)/256)*256;IS EVAL CALLING?
 4529 A:df22  d0 0f                              bne NOTEVL                ;NO, CARRY ON.

 4532 A:df24  ba                                 tsx 
 4533 A:df25  bd 02 01                           lda 258,X
 4534 A:df28  c9 dd                              cmp #(ISVRET-1)/256
 4535 A:df2a  d0 07                              bne NOTEVL

 4537 A:df2c                           LDZR      
 4537 A:df2c                                    ;SET UP PNTR TO SIMULATED ZERO.
 4538 A:df2c  a9 01                              lda #ZERO&255
 4539 A:df2e  a0 ed                              ldy #ZERO/256
 4540 A:df30  60                                 rts                    ;FOR STRINGS OR NUMERIC.
 4541 A:df31                                    ;AND FOR INTEGERS TOO.
 4542 A:df31                           NOTEVL    
 4542 A:df31                                    

 4562 A:df31                           QSTAVR    
 4562 A:df31                                    

 4570 A:df31                           VAROK     
 4570 A:df31                                    
 4571 A:df31  a5 6e                              lda ARYTAB
 4572 A:df33  a4 6f                              ldy ARYTAB+1
 4573 A:df35                                    ;LOWEST THING TO MOVE.
 4574 A:df35  85 9e                              sta LOWTR
 4575 A:df37  84 9f                              sty LOWTR+1
 4576 A:df39                                    ;GET HIGHEST ADDR TO MOVE.
 4577 A:df39  a5 70                              lda STREND
 4578 A:df3b  a4 71                              ldy STREND+1

 4580 A:df3d  85 99                              sta HIGHTR
 4581 A:df3f  84 9a                              sty HIGHTR+1
 4582 A:df41  18                                 clc 
 4583 A:df42  69 07                              adc #6+1
 4584 A:df44  90 03                              bcc NOTEVE
 4585 A:df46  c8                                 iny 
 4586 A:df47                           NOTEVE    
 4586 A:df47                                    ;PLACE TO STUFF IT.
 4587 A:df47  85 97                              sta HIGHDS
 4588 A:df49  84 98                              sty HIGHDS+1
 4589 A:df4b  20 92 d2                           jsr BLTU                ;MOVE IT ALL.
 4590 A:df4e                                    ;NOTE [Y,A] HAS [HIGHDS] FOR REASON.
 4591 A:df4e                                    ;AND SET UP
 4592 A:df4e  a5 97                              lda HIGHDS
 4593 A:df50  a4 98                              ldy HIGHDS+1
 4594 A:df52  c8                                 iny 
 4595 A:df53                                    ;NEW START OF ARRAY TABLE.
 4596 A:df53  85 6e                              sta ARYTAB
 4597 A:df55  84 6f                              sty ARYTAB+1
 4598 A:df57  a0 00                              ldy #0             ;GET ADDR OF VARIABLE ENTRY.
 4599 A:df59  a5 84                              lda VARNAM
 4600 A:df5b  91 9e                              sta (LOWTR),Y
 4601 A:df5d  c8                                 iny 
 4602 A:df5e  a5 85                              lda VARNAM+1
 4603 A:df60  91 9e                              sta (LOWTR),Y            ;STORE NAME OF VARIABLE.
 4604 A:df62  a9 00                              lda #0
 4605 A:df64  c8                                 iny 
 4606 A:df65  91 9e                              sta (LOWTR),Y
 4607 A:df67  c8                                 iny 
 4608 A:df68  91 9e                              sta (LOWTR),Y
 4609 A:df6a  c8                                 iny 
 4610 A:df6b  91 9e                              sta (LOWTR),Y
 4611 A:df6d  c8                                 iny 
 4612 A:df6e  91 9e                              sta (LOWTR),Y            ;FOURTH ZERO FOR DEF FUNC.

 4615 A:df70  c8                                 iny 
 4616 A:df71  91 9e                              sta (LOWTR),Y

 4618 A:df73                           FINPTR    
 4618 A:df73  a5 9e                              lda LOWTR
 4619 A:df75  18                                 clc 
 4620 A:df76  69 02                              adc #2
 4621 A:df78  a4 9f                              ldy LOWTR+1
 4622 A:df7a  90 03                              bcc FINNOW
 4623 A:df7c  c8                                 iny 
 4624 A:df7d                           FINNOW    
 4624 A:df7d                                    ;THIS IS IT.
 4625 A:df7d  85 86                              sta VARPNT
 4626 A:df7f  84 87                              sty VARPNT+1
 4627 A:df81  60                                 rts 
 4628 A:df82                                    ; PAGE
 4629 A:df82                                    ; SUBTTL MULTIPLE DIMENSION CODE.
 4630 A:df82                           FMAPTR    
 4630 A:df82  a5 0f                              lda COUNT
 4631 A:df84  0a                                 asl 
 4632 A:df85  69 05                              adc #5             ;POINT TO ENTRIES. C CLR'D BY ASL.
 4633 A:df87  65 9e                              adc LOWTR
 4634 A:df89  a4 9f                              ldy LOWTR+1
 4635 A:df8b  90 03                              bcc JSRGM
 4636 A:df8d  c8                                 iny 
 4637 A:df8e                           JSRGM     
 4637 A:df8e                                    
 4638 A:df8e  85 97                              sta HIGHDS
 4639 A:df90  84 98                              sty HIGHDS+1
 4640 A:df92  60                                 rts 

 4642 A:df93                           N32768    
 4642 A:df93  90 80 00 00                        .byt 144,128,0,0;-32768.

 4644 A:df97                                    ;
 4645 A:df97                                    ; INTIDX READS A FORMULA FROM THE CURRENT POSITION AND
 4646 A:df97                                    ; TURNS IT INTO A POSITIVE INTEGER
 4647 A:df97                                    ; LEAVING THE RESULT IN FACMO&LO. NEGATIVE ARGUMENTS
 4648 A:df97                                    ; ARE NOT ALLOWED.
 4649 A:df97                                    ;
 4650 A:df97                           INTIDX    
 4650 A:df97  20 b2 00                           jsr CHRGET
 4651 A:df9a  20 19 dc                           jsr FRMEVL                ;GET A NUMBER
 4652 A:df9d                           POSINT    
 4652 A:df9d  20 05 dc                           jsr CHKNUM
 4653 A:dfa0  a5 a5                              lda FACSGN
 4654 A:dfa2  30 0f                              bmi NONONO                ;IF NEGATIVE, BLOW HIM OUT.
 4655 A:dfa4                           AYINT     
 4655 A:dfa4  a5 a0                              lda FACEXP
 4656 A:dfa6  c9 90                              cmp #144             ;FAC .GT. 32767?
 4657 A:dfa8  90 0b                              bcc QINTGO
 4658 A:dfaa                                    ;GET ADDR OF -32768.
 4659 A:dfaa  a9 93                              lda #N32768&255
 4660 A:dfac  a0 df                              ldy #N32768/256
 4661 A:dfae  20 51 ea                           jsr FCOMP                ;SEE IF FAC=[[Y,A]].
 4662 A:dfb1                           NONONO    
 4662 A:dfb1  d0 7f                              bne FCERR                ;NO, FAC IS TOO BIG.
 4663 A:dfb3                           QINTGO    
 4663 A:dfb3  4c 91 ea                           jmp QINT                ;GO TO QINT AND SHOVE IT.
 4664 A:dfb6                                    ;
 4665 A:dfb6                                    ; FORMAT OF ARRAYS IN CORE.
 4666 A:dfb6                                    ;
 4667 A:dfb6                                    ; DESCRIPTOR:
 4668 A:dfb6                                    ; LOWBYTE = FIRST CHARACTER.
 4669 A:dfb6                                    ; HIGHBYTE = SECOND CHARACTER (200 BIT IS STRING FLAG).
 4670 A:dfb6                                    ; LENGTH OF ARRAY IN CORE IN BYTES (INCLUDES EVERYTHING).
 4671 A:dfb6                                    ; NUMBER OF DIMENSIONS.
 4672 A:dfb6                                    ; FOR EACH DIMENSION STARTING WITH THE FIRST A LIST
 4673 A:dfb6                                    ; (2 BYTES EACH) OF THE MAX INDICE+1
 4674 A:dfb6                                    ; THE VALUES
 4675 A:dfb6                                    ;
 4676 A:dfb6                           ISARY     
 4676 A:dfb6  a5 10                              lda DIMFLG

 4679 A:dfb8  05 12                              ora INTFLG

 4681 A:dfba  48                                 pha                    ;SAVE [DIMFLG] FOR RECURSION.
 4682 A:dfbb  a5 11                              lda VALTYP
 4683 A:dfbd  48                                 pha                    ;SAVE [VALTYP] FOR RECURSION.
 4684 A:dfbe  a0 00                              ldy #0             ;SET NUMBER OF DIMENSIONS TO ZERO.
 4685 A:dfc0                           INDLOP    
 4685 A:dfc0  98                                 tya                    ;SAVE NUMBER OF DIMS.
 4686 A:dfc1  48                                 pha 
 4687 A:dfc2                                    ;SAVE LOOKS.
 4688 A:dfc2  a5 85                              lda VARNAM+1
 4689 A:dfc4  48                                 pha 
 4690 A:dfc5  a5 84                              lda VARNAM
 4691 A:dfc7  48                                 pha 
 4692 A:dfc8  20 97 df                           jsr INTIDX                ;EVALUATE INDICE INTO FACMO&LO.
 4693 A:dfcb                                    ;GET BACK ALL... WE'RE HOME.
 4694 A:dfcb  68                                 pla 
 4695 A:dfcc  85 84                              sta VARNAM
 4696 A:dfce  68                                 pla 
 4697 A:dfcf  85 85                              sta VARNAM+1
 4698 A:dfd1  68                                 pla                    ;(# OF DIMS).
 4699 A:dfd2  a8                                 tay 
 4700 A:dfd3  ba                                 tsx 
 4701 A:dfd4  bd 02 01                           lda 258,X
 4702 A:dfd7  48                                 pha                    ;PUSH DIMFLG AND VALTYP FURTHER.
 4703 A:dfd8  bd 01 01                           lda 257,X
 4704 A:dfdb  48                                 pha 
 4705 A:dfdc  a5 a3                              lda FACMO                ;PUT INDICE ONTO STACK.
 4706 A:dfde  9d 02 01                           sta 258,X,           ;UNDER DIMFLG AND VALTYP.
 4707 A:dfe1  a5 a4                              lda FACMO+1
 4708 A:dfe3  9d 01 01                           sta 257,X
 4709 A:dfe6  c8                                 iny                    ;INCREMENT # OF DIMS.
 4710 A:dfe7  20 b8 00                           jsr CHRGOT                ;GET TERMINATING CHARACTER.
 4711 A:dfea  c9 2c                              cmp #44             ;A COMMA?
 4712 A:dfec  f0 d2                              beq INDLOP                ;YES.
 4713 A:dfee  84 0f                              sty COUNT                ;SAVE COUNT OF DIMS.
 4714 A:dff0  20 5c dd                           jsr CHKCLS                ;MUST BE CLOSED PAREN.
 4715 A:dff3  68                                 pla 
 4716 A:dff4  85 11                              sta VALTYP                ;GET VALTYP AND
 4717 A:dff6  68                                 pla 

 4720 A:dff7  85 12                              sta INTFLG
 4721 A:dff9  29 7f                              and #127

 4723 A:dffb  85 10                              sta DIMFLG                ;DIMFLG OFF STACK.
 4724 A:dffd  a6 6e                              ldx ARYTAB                ;PLACE TO START SEARCH.
 4725 A:dfff  a5 6f                              lda ARYTAB+1
 4726 A:e001                           LOPFDA    
 4726 A:e001  86 9e                              stx LOWTR
 4727 A:e003  85 9f                              sta LOWTR+1
 4728 A:e005  c5 71                              cmp STREND+1          ;END OF ARRAYS?
 4729 A:e007  d0 06                              bne LOPFDV
 4730 A:e009  e4 70                              cpx STREND
 4731 A:e00b  f0 3e                              beq NOTFDD                ;A FINE THING! NO ARRAY!.
 4732 A:e00d                           LOPFDV    
 4732 A:e00d  a0 00                              ldy #0
 4733 A:e00f  b1 9e                              lda (LOWTR),Y
 4734 A:e011  c8                                 iny 
 4735 A:e012  c5 84                              cmp VARNAM                ;COMPARE HIGH ORDERS.
 4736 A:e014  d0 08                              bne NMARY1                ;NO WAY IS IT THIS. GET OUT OF HERE.
 4737 A:e016  a5 85                              lda VARNAM+1
 4738 A:e018  d1 9e                              cmp (LOWTR),Y            ;LOW ORDERS?
 4739 A:e01a  f0 1b                              beq GOTARY                ;WELL, HERE IT IS !!
 4740 A:e01c                           NMARY1    
 4740 A:e01c  c8                                 iny 
 4741 A:e01d  b1 9e                              lda (LOWTR),Y            ;GET LENGTH.
 4742 A:e01f  18                                 clc 
 4743 A:e020  65 9e                              adc LOWTR
 4744 A:e022  aa                                 tax 
 4745 A:e023  c8                                 iny 
 4746 A:e024  b1 9e                              lda (LOWTR),Y
 4747 A:e026  65 9f                              adc LOWTR+1
 4748 A:e028  90 d7                              bcc LOPFDA                ;ALWAYS BRANCHES.
 4749 A:e02a                           BSERR     
 4749 A:e02a  a2 6b                              ldx #107             ;GET BAD SUB ERROR NUMBER.
 4750 A:e02c  00 02 2c 00                        .word 512,44
 4751 A:e030                           FCERR     
 4751 A:e030  a2 35                              ldx #53             ;TOO BIG. "FUNCTION CALL" ERROR.
 4752 A:e032                           ERRGO3    
 4752 A:e032  4c 11 d3                           jmp ERROR
 4753 A:e035                           GOTARY    
 4753 A:e035  a2 78                              ldx #120             ;PERHAPS A "RE-DIMENSION" ERROR
 4754 A:e037  a5 10                              lda DIMFLG                ;TEST THE DIMFLG
 4755 A:e039  d0 f7                              bne ERRGO3
 4756 A:e03b  20 82 df                           jsr FMAPTR
 4757 A:e03e  a5 0f                              lda COUNT                ;GET NUMBER OF DIMS INPUT.
 4758 A:e040  a0 04                              ldy #4
 4759 A:e042  d1 9e                              cmp (LOWTR),Y            ;# OF DIMS THE SAME?
 4760 A:e044  d0 e4                              bne BSERR                ;SAME SO GO GET DEFINITION.
 4761 A:e046  4c d3 e0                           jmp GETDEF

 4763 A:e049                                    ;
 4764 A:e049                                    ; HERE WHEN VARIABLE IS NOT FOUND IN THE ARRAY TABLE.
 4765 A:e049                                    ;
 4766 A:e049                                    ; BUILDING AN ENTRY.
 4767 A:e049                                    ;
 4768 A:e049                                    ; PUT DOWN THE DESCRIPTOR.
 4769 A:e049                                    ; SETUP NUMBER OF DIMENSIONS.
 4770 A:e049                                    ; MAKE SURE THERE IS ROOM FOR THE NEW ENTRY.
 4771 A:e049                                    ; REMEMBER "VARPNT".
