 6818 A:ea98  24 a5                              bit FACSGN
 6819 A:ea9a  10 0d                              bpl QISHFT
 6820 A:ea9c  aa                                 tax 
 6821 A:ea9d  a9 ff                              lda #255
 6822 A:ea9f  85 a7                              sta BITS                ;PUT 377 IN WHEN SHFTR SHIFTS BYTES.
 6823 A:eaa1  20 3d e7                           jsr NEGFCH                ;TRULY NEGATE QUANTITY IN FAC.
 6824 A:eaa4  8a                                 txa 
