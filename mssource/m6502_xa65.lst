 2262 A:d4e5                                    ;
 2263 A:d4e5                                    ; FNDLIN SEARCHES THE PROGRAM TEXT FOR THE LINE
 2264 A:d4e5                                    ; WHOSE NUMBER IS PASSED IN "LINNUM".
 2265 A:d4e5                                    ; THERE ARE TWO POSSIBLE RETURNS:
 2266 A:d4e5                                    ;
 2267 A:d4e5                                    ; 1) CARRY SET.
 2268 A:d4e5                                    ;    LOWTR POINTS TO THE LINK FIELD IN THE LINE
 2269 A:d4e5                                    ;    WHICH IS THE ONE SEARCHED FOR.
 2270 A:d4e5                                    ;
 2271 A:d4e5                                    ; 2) CARRY NOT SET.
 2272 A:d4e5                                    ;    LINE NOT FOUND. [LOWTR] POINTS TO THE LINE IN THE
 2273 A:d4e5                                    ;    PROGRAM GREATER THAN THE ONE SOUGHT AFTER.
 2274 A:d4e5                                    ;
 2275 A:d4e5                           FNDLIN    
 2275 A:d4e5                                    ;LOAD [X,A] WITH [TXTTAB]
 2276 A:d4e5  a5 6a                              lda TXTTAB
 2277 A:d4e7  a6 6b                              ldx TXTTAB+1
 2278 A:d4e9                           FNDLNC    
 2278 A:d4e9  a0 01                              ldy #1
 2279 A:d4eb                                    ;STORE [X,A] INTO LOWTR
 2280 A:d4eb  85 9e                              sta LOWTR
 2281 A:d4ed  86 9f                              stx LOWTR+1
 2282 A:d4ef  b1 9e                              lda (LOWTR),Y            ;SEE IF LINK IS 0
 2283 A:d4f1  f0 21                              beq FLINRT
 2284 A:d4f3  c8                                 iny 
 2285 A:d4f4  c8                                 iny 
 2286 A:d4f5  a5 54                              lda LINNUM+1          ;COMP HIGH ORDERS OF LINE NUMBERS.
 2287 A:d4f7  d1 9e                              cmp (LOWTR),Y
 2288 A:d4f9  90 1a                              bcc FLNRTS                ;NO SUCH LINE NUMBER.
 2289 A:d4fb  f0 05                              beq FNDLO1
 2290 A:d4fd  88                                 dey 
 2291 A:d4fe  d0 0b                              bne AFFRTS                ;ALWAYS BRANCH.
 2292 A:d500                           FNDLO1    
 2292 A:d500  a5 53                              lda LINNUM
 2293 A:d502  88                                 dey 
 2294 A:d503  d1 9e                              cmp (LOWTR),Y            ;COMPARE LOW ORDERS.
 2295 A:d505  90 0e                              bcc FLNRTS                ;NO SUCH NUMBER.
 2296 A:d507  f0 0c                              beq FLNRTS                ;GO TIT.
 2297 A:d509                           AFFRTS    
