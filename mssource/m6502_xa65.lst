 7476 A:edc2  20 11 ea                           jsr MOVEF                ;TO SAVE IN ARG WITHOUT ROUND.
 7477 A:edc5  a5 a0                              lda FACEXP
 7478 A:edc7  c9 88                              cmp #136             ;IF ABS(FAC) .GE. 128, TOO BIG.
 7479 A:edc9  90 07                              bcc EXP1
 7480 A:edcb                           GOMLDV    
 7480 A:edcb  20 d3 e8                           jsr MLDVEX                ;OVERFLOW OR OVERFLOW.
 7481 A:edce                           EXP1      
 7481 A:edce  20 ce ea                           jsr INT
 7482 A:edd1  a5 0d                              lda CHARAC                ;GET LOW PART.
 7483 A:edd3  18                                 clc 
 7484 A:edd4  69 81                              adc #129
 7485 A:edd6  f0 f3                              beq GOMLDV                ;OVERFLOW OR OVERFLOW !!
 7486 A:edd8  38                                 sec 
 7487 A:edd9  e9 01                              sbc #1             ;SUBTRACT 1.
 7488 A:eddb  48                                 pha                    ;SAVE A WHILE.
 7489 A:eddc  a2 05                              ldx #4+1       ;PREP TO SWAP FAC AND ARG.
 7490 A:edde                           SWAPLP    
 7490 A:edde  b5 a8                              lda ARGEXP,X
 7491 A:ede0  b4 a0                              ldy FACEXP,X
 7492 A:ede2  95 a0                              sta FACEXP,X
 7493 A:ede4  94 a8                              sty ARGEXP,X
 7494 A:ede6  ca                                 dex 
 7495 A:ede7  10 f5                              bpl SWAPLP
