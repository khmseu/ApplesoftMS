 6866 A:eaf5                                    ; PAGE
 6867 A:eaf5                                    ; SUBTTL FLOATING POINT INPUT ROUTINE.
 6868 A:eaf5                                    ;NUMBER INPUT IS LEFT IN FAC.
 6869 A:eaf5                                    ;AT ENTRY [TXTPTR] POINTS TO THE FIRST CHARACTER IN A TEXT BUFFER.
 6870 A:eaf5                                    ;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS
 6871 A:eaf5                                    ;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE
 6872 A:eaf5                                    ;DECIMAL POINT IS. [DPTFLG] TELL WHETHER A DP HAS BEEN
 6873 A:eaf5                                    ;SEEN. [DECCNT] IS THE NUMBER OF DIGITS AFTER THE DP.
 6874 A:eaf5                                    ;AT THE END [DECCNT] AND THE EXPONENT ARE USED TO
 6875 A:eaf5                                    ;DETERMINE HOW MANY TIMES TO MULTIPLY OR DIVIDE BY TEN
 6876 A:eaf5                                    ;TO GET THE CORRECT NUMBER.
 6877 A:eaf5                           FIN       
 6877 A:eaf5  a0 00                              ldy #0             ;ZERO FACSGN&SGNFLG.
 6878 A:eaf7  a2 0a                              ldx #9+1       ;ZERO EXP AND HO (AND MOH).
 6879 A:eaf9                           FINZLP    
 6879 A:eaf9  94 9c                              sty LOWDS,X              ;ZERO MO AND LO.
 6880 A:eafb  ca                                 dex                    ;ZERO TENEXP AND EXPSGN
 6881 A:eafc  10 fb                              bpl FINZLP                ;ZERO DECCNT, DPTFLG.
 6882 A:eafe  90 13                              bcc FINDGQ                ;FLAGS STILL SET FROM CHRGET.
 6883 A:eb00  c9 2d                              cmp #"-"             ;A NEGATIVE SIGN?
 6884 A:eb02  d0 08                              bne QPLUS                ;NO, TRY PLUS SIGN.
 6885 A:eb04  86 a6                              stx SGNFLG                ;IT'S NEGATIVE. (X=377).
 6886 A:eb06  f0 08                              beq FINC                ;ALWAYS BRANCHES.
 6887 A:eb08                           QPLUS     
 6887 A:eb08  c9 2b                              cmp #"+"             ;PLUS SIGN?
 6888 A:eb0a  d0 09                              bne FIN1                ;YES, SKIP IT.
 6889 A:eb0c                           FINC      
 6889 A:eb0c  20 b2 00                           jsr CHRGET
 6890 A:eb0f                           FINDGQ    
 6890 A:eb0f  90 5f                              bcc FINDIG
 6891 A:eb11                           FIN1      
 6891 A:eb11  c9 2a                              cmp #"*"             ;THE DP?
 6892 A:eb13  f0 32                              beq FINDP                ;NO KIDDING.
 6893 A:eb15  c9 45                              cmp #"E"             ;EXPONENT FOLLOWS.
 6894 A:eb17  d0 34                              bne FINE                ;NO.
 6895 A:eb19                                    ;HERE TO CHECK FOR SIGN OF EXP.
 6896 A:eb19  20 b2 00                           jsr CHRGET                ;YES. GET ANOTHER.
 6897 A:eb1c  90 1b                              bcc FNEDG1                ;IT IS A DIGIT. (EASIER THAN
 6898 A:eb1e                                    ;BACKING UP POINTER.)
 6899 A:eb1e  c9 81                              cmp #129             ;MINUS?
 6900 A:eb20  f0 12                              beq FINEC1                ;NEGATE.
 6901 A:eb22  c9 2d                              cmp #"-"             ;MINUS SIGN?
 6902 A:eb24  f0 0e                              beq FINEC1
 6903 A:eb26  c9 81                              cmp #129             ;PLUS?
 6904 A:eb28  f0 0c                              beq FINEC
 6905 A:eb2a  c9 2b                              cmp #"+"             ;PLUS SIGN?
 6906 A:eb2c  f0 08                              beq FINEC
 6907 A:eb2e  d0 0b                              bne FINEC2
 6908 A:eb30                           FINEC1    
 6908 A:eb30  66 9f                              ror LOWTR+1          ;TURN IT ON.
 6909 A:eb32                           FINEC     
 6909 A:eb32  20 b2 00                           jsr CHRGET                ;GET ANOTHER.
 6910 A:eb35                           FNEDG1    
 6910 A:eb35  90 60                              bcc FINEDG                ;IT IS A DIGIT.
 6911 A:eb37                           FINEC2    
 6911 A:eb37  24 9f                              bit LOWTR+1
 6912 A:eb39  10 12                              bpl FINE
 6913 A:eb3b  a9 00                              lda #0
 6914 A:eb3d  38                                 sec 
 6915 A:eb3e  e5 9d                              sbc LOWDS+1
 6916 A:eb40  4c 4b eb                           jmp FINE1
 6917 A:eb43                           FINDP     
 6917 A:eb43  66 9e                              ror LOWTR
 6918 A:eb45  24 9e                              bit LOWTR
 6919 A:eb47  50 c3                              bvc FINC
 6920 A:eb49                           FINE      
 6920 A:eb49  a5 9d                              lda LOWDS+1
 6921 A:eb4b                           FINE1     
 6921 A:eb4b  38                                 sec 
 6922 A:eb4c  e5 9c                              sbc LOWDS                ;GET NUMBER OF PLACES TO SHIFT.
 6923 A:eb4e  85 9d                              sta LOWDS+1
 6924 A:eb50  f0 16                              beq FINQNG                ;NEGATE?
 6925 A:eb52  10 0d                              bpl FINMUL                ;POSITIVE SO MULTIPLY.
 6926 A:eb54                           FINDIV    
 6926 A:eb54  20 fd e8                           jsr DIV10
 6927 A:eb57  e6 9d                              inc LOWDS+1          ;DONE?
 6928 A:eb59  d0 f9                              bne FINDIV                ;NO.
 6929 A:eb5b  f0 0b                              beq FINQNG                ;YES.
 6930 A:eb5d                           FINMUL    
 6930 A:eb5d  20 e1 e8                           jsr MUL10
 6931 A:eb60  c6 9d                              dec LOWDS+1          ;DONE?
 6932 A:eb62  d0 f9                              bne FINMUL                ;NO
 6933 A:eb64                           FINQNG    
 6933 A:eb64  a5 a6                              lda SGNFLG
 6934 A:eb66  30 05                              bmi NEGXQS                ;IF POSITIVE, RETURN.
 6935 A:eb68  60                                 rts 
 6936 A:eb69                           NEGXQS    
 6936 A:eb69  4c 77 ed                           jmp NEGOP                ;OTHERWISE, NEGATE AND RETURN.

 6938 A:eb6c                           FINDIG    
 6938 A:eb6c  48                                 pha 
 6939 A:eb6d  24 9e                              bit LOWTR
 6940 A:eb6f  10 06                              bpl FINDG1
 6941 A:eb71  e6 9c                              inc LOWDS
 6942 A:eb73                           FINDG1    
 6942 A:eb73  20 e1 e8                           jsr MUL10
 6943 A:eb76  68                                 pla                    ;GET IT BACK.
 6944 A:eb77  38                                 sec 
 6945 A:eb78  e9 30                              sbc #"0"
 6946 A:eb7a  20 80 eb                           jsr FINLOG                ;ADD IT IN.
 6947 A:eb7d  4c 0c eb                           jmp FINC

 6949 A:eb80                           FINLOG    
 6949 A:eb80  48                                 pha 
 6950 A:eb81  20 0e ea                           jsr MOVAF                ;SAVE FAC FOR LATER.
 6951 A:eb84  68                                 pla 
 6952 A:eb85  20 3e ea                           jsr FLOAT                ;FLOAT THE VALUE IN ACCA.
 6953 A:eb88  a5 ad                              lda ARGSGN
 6954 A:eb8a  45 a5                              eor FACSGN
 6955 A:eb8c  85 ae                              sta ARISGN                ;RESULTANT SIGN.
 6956 A:eb8e  a6 a0                              ldx FACEXP                ;SET SIGNS ON THING TO ADD.
 6957 A:eb90  4c 66 e6                           jmp FADDT                ;ADD TOGETHER AND RETURN.

 6959 A:eb93                                    ;HERE PACK IN THE NEXT DIGIT OF THE EXPONENT.
 6960 A:eb93                                    ;MULTIPLY THE OLD EXP BY 10 AND ADD IN THE NEXT
 6961 A:eb93                                    ;DIGIT. NOTE: EXP OVERFLOW IS NOT CHECKED FOR.
 6962 A:eb93                           FINEDG    
 6962 A:eb93  a5 9d                              lda LOWDS+1          ;GET EXP SO FAR.
 6963 A:eb95  c9 0a                              cmp #10             ;WILL RESULT BE .GE. 100?
 6964 A:eb97  90 0d                              bcc MLEX10
 6965 A:eb99  a9 64                              lda #100             ;GET 100.
 6966 A:eb9b  24 9f                              bit LOWTR+1
 6967 A:eb9d  30 15                              bmi MLEXMI                ;IF NEG EXP, NO CHK FOR OVERR.
 6968 A:eb9f  4c 7a e7                           jmp OVERR
 6969 A:eba2                           MLEX10    
 6969 A:eba2  0a                                 asl                    ;MULT BY 2 TWICE
 6970 A:eba3  0a                                 asl 
 6971 A:eba4  18                                 clc                    ;POSSIBLE SHIFT OUT OF HIGH.
 6972 A:eba5  65 9d                              adc LOWDS+1          ;LIKE MULTIPLYING BY FIVE.
 6973 A:eba7  0a                                 asl                    ;AND NOW BY TEN.
 6974 A:eba8  18                                 clc 
 6975 A:eba9  a0 00                              ldy #0
 6976 A:ebab  71 b9                              adc (CHRGOT+1),Y
 6977 A:ebad  38                                 sec 
 6978 A:ebae  e9 30                              sbc #"0"
 6979 A:ebb0                           MLEXMI    
 6979 A:ebb0  85 9d                              sta LOWDS+1          ;SAVE RESULT.
 6980 A:ebb2  4c 32 eb                           jmp FINEC
