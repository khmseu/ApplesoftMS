 5303 A:e2f9  90 15                              bcc GARBAG                ;MAKE ROOM FOR MORE.
 5304 A:e2fb  d0 08                              bne STRFRE                ;SAVE NEW FRETOP.
 5305 A:e2fd  c5 70                              cmp STREND                ;COMPARE LOW ORDERS.
 5306 A:e2ff  90 0f                              bcc GARBAG                ;CLEAN UP.
 5307 A:e301                           STRFRE    
 5307 A:e301                                    ;SAVE NEW [FRETOP].
 5308 A:e301  85 72                              sta FRETOP
 5309 A:e303  84 73                              sty FRETOP+1
