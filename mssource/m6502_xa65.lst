 5806 A:1d0c                                    ; PAGE
 5807 A:1d0c                                    ; SUBTTL PEEK, POKE, AND FNWAIT.

 5809 A:1d0c                           GETNUM    
 5809 A:1d0c  20 33 13                           jsr FRMNUM                ;GET ADDRESS.
 5810 A:1d0f  20 18 1d                           jsr GETADR                ;GET THAT LOCATION.
 5811 A:1d12                           COMBYT    
