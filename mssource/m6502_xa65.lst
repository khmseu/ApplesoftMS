 2894 A:d791  a5 6a                              lda TXTTAB
 2895 A:d793  a4 6b                              ldy TXTTAB+1

 2897 A:d795  85 3c                              sta 60
 2898 A:d797  84 3d                              sty 60+1

 2900 A:d799  a5 6c                              lda VARTAB
