 1875 A:d34a  20 03 00                           jsr RDYJSR

 1881 A:d34d                           MAIN      
 1881 A:d34d  20 2a d4                           jsr INLIN                ;GET A LINE FROM TERMINAL.

 1883 A:d350  86 b9                              stx CHRGOT+1
 1884 A:d352  84 ba                              sty CHRGOT+1+1
 1885 A:d354  20 b2 00                           jsr CHRGET
 1886 A:d357  aa                                 tax                    ;SET ZERO FLAG BASED ON [A]
 1887 A:d358                                    ;THIS DISTINGUISHES ":" AND 0
 1888 A:d358  f0 f3                              beq MAIN                ;IF BLANK LINE, GET ANOTHER.
 1889 A:d35a  a2 ff                              ldx #255             ;SET DIRECT LINE NUMBER.
 1890 A:d35c  86 79                              stx CURLIN+1
 1891 A:d35e  90 06                              bcc MAIN1                ;IS A LINE NUMBER. NOT DIRECT.
 1892 A:d360  20 63 d4                           jsr CRUNCH                ;COMPACTIFY.
 1893 A:d363  4c a4 d6                           jmp GONE                ;EXECUTE IT.
 1894 A:d366                           MAIN1     
