 5265 A:e2cb                           PUTNW1    
 5265 A:e2cb  a5 a0                              lda FAC
 5266 A:e2cd  95 00                              sta 0,X
 5267 A:e2cf  a5 a1                              lda FAC+1
 5268 A:e2d1  95 01                              sta 1,X
 5269 A:e2d3  a5 a2                              lda FAC+2
