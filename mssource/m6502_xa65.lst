 2212 A:d494  c8                                 iny 
 2213 A:d495                           RESPUL    
 2213 A:d495  e8                                 inx 
 2214 A:d496                           RESCON    
 2214 A:d496  bd 00 02                           lda 512,X
 2215 A:d499  38                                 sec                    ;PREPARE TO SUBSTARCT.
 2216 A:d49a  f9 84 d0                           sbc RESLST,Y              ;CHARACTERS EQUAL?
 2217 A:d49d  f0 f5                              beq RESER                ;YES, CONTINUE SEARCH.
 2218 A:d49f  c9 80                              cmp #128             ;NO BUT MAYBE THE END IS HERE.
 2219 A:d4a1  d0 30                              bne NTHIS                ;NO, TRULY UNEQUAL.
 2220 A:d4a3  05 0f                              ora COUNT
 2221 A:d4a5                           GETBPT    
 2221 A:d4a5  a4 b0                              ldy FBUFPT                ;GET BUFFER PNTR.
 2222 A:d4a7                           STUFFH    
 2222 A:d4a7  e8                                 inx 
 2223 A:d4a8  c8                                 iny 
 2224 A:d4a9  99 fb 01                           sta 512-5,Y
 2225 A:d4ac  b9 fb 01                           lda 512-5,Y
 2226 A:d4af  f0 36                              beq CRDONE                ;NULL IMPLIES END OF LINE.
 2227 A:d4b1  38                                 sec                    ;PREPARE TO SUBSTARCT.
 2228 A:d4b2  e9 3a                              sbc #":"             ;IS IT A ":"?
 2229 A:d4b4  f0 04                              beq COLIS                ;YES, ALLOW CRUNCHING AGAIN.
 2230 A:d4b6  c9 45                              cmp #127-":"       ;IS IT A DATATK?
 2231 A:d4b8  d0 02                              bne NODATT                ;NO, SEE IF IT IS REM TOKEN.
 2232 A:d4ba                           COLIS     
 2232 A:d4ba  85 13                              sta DORES                ;SETUP FLAG.
 2233 A:d4bc                           NODATT    
 2233 A:d4bc  38                                 sec                    ;PREP TO SBCQ
 2234 A:d4bd  e9 45                              sbc #127-":"       ;REM ONLY STOPS ON NULL.
 2235 A:d4bf  d0 a8                              bne KLOOP                ;NO, CONTINUE CRUNCHING.
 2236 A:d4c1  85 0e                              sta ENDCHR                ;REM STOPS ONLY ON NULL, NOT : OR ".
 2237 A:d4c3                           STR1      
 2237 A:d4c3  bd 00 02                           lda 512,X
 2238 A:d4c6  f0 df                              beq STUFFH                ;YES, END OF LINE, SO DONE.
 2239 A:d4c8  c5 0e                              cmp ENDCHR                ;END OF GOBBLE?
 2240 A:d4ca  f0 db                              beq STUFFH                ;YES, DONE WITH STRING.
 2241 A:d4cc                           STRNG     
 2241 A:d4cc  c8                                 iny                    ;INCREMENT BUFFER POINTER.
 2242 A:d4cd  99 fb 01                           sta 512-5,Y
 2243 A:d4d0  e8                                 inx 
 2244 A:d4d1  d0 f0                              bne STR1                ;PROCESS NEXT CHARACTER.
 2245 A:d4d3                           NTHIS     
 2245 A:d4d3  a6 b9                              ldx CHRGOT+1          ;RESTORE TEXT POINTER.
 2246 A:d4d5  e6 0f                              inc COUNT                ;INCREMENT RES WORD COUNT.
 2247 A:d4d7                           NTHIS1    
 2247 A:d4d7  c8                                 iny 
 2248 A:d4d8  b9 83 d0                           lda RESLST-1,Y,       ;GET RES CHARACTER.
 2249 A:d4db  10 fa                              bpl NTHIS1                ;END OF ENTRY?
 2250 A:d4dd  b9 84 d0                           lda RESLST,Y,             ;YES. IS IT THE END?
 2251 A:d4e0  d0 b4                              bne RESCON                ;NO, TRY THE NEXT WORD.
 2252 A:d4e2  bd 00 02                           lda 512,X            ;YES, END OF TABLE. GET 1ST CHR.
 2253 A:d4e5  10 be                              bpl GETBPT                ;STORE IT AWAY (ALWAYS BRANCHES).
 2254 A:d4e7                           CRDONE    
