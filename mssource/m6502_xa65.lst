 4762 A:e052  4c df e0                           jmp GETDEF

 4764 A:e055                                    ;
 4765 A:e055                                    ; HERE WHEN VARIABLE IS NOT FOUND IN THE ARRAY TABLE.
 4766 A:e055                                    ;
 4767 A:e055                                    ; BUILDING AN ENTRY.
 4768 A:e055                                    ;
 4769 A:e055                                    ; PUT DOWN THE DESCRIPTOR.
 4770 A:e055                                    ; SETUP NUMBER OF DIMENSIONS.
 4771 A:e055                                    ; MAKE SURE THERE IS ROOM FOR THE NEW ENTRY.
 4772 A:e055                                    ; REMEMBER "VARPNT".
 4773 A:e055                                    ; TALLY=4.
 4774 A:e055                                    ; SKIP 2 LOCS FOR LATER FILL IN OF SIZE.
 4775 A:e055                                    ; LOOP: GET AN INDICE
 4776 A:e055                                    ; PUT DOWN NUMBER+1 AND INCREMENT VARPTR.
 4777 A:e055                                    ; TALLY=TALLY*NUMBER+1.
 4778 A:e055                                    ; DECREMENT NUMBER-DIMS.
 4779 A:e055                                    ; BNE LOOP
 4780 A:e055                                    ; CALL "REASON" WITH [Y,A] REFLECTING LAST LOC OF VARIABLE.
 4781 A:e055                                    ; UPDATE STREND.
 4782 A:e055                                    ; ZERO ALL.
 4783 A:e055                                    ; MAKE TALLY INCLUDE MAXDIMS AND DESCRIPTOR.
 4784 A:e055                                    ; PUT DOWN TALLY.
 4785 A:e055                                    ; IF CALLED BY DIMENSION, RETURN.
 4786 A:e055                                    ; OTHERWISE INDEX INTO THE VARIABLE AS IF IT
 4787 A:e055                                    ;  WERE FOUND ON THE INITIAL SEARCH.
 4788 A:e055                                    ;
 4789 A:e055                           NOTFDD    
 4789 A:e055  20 8e df                           jsr FMAPTR                ;FORM ARYPNT.
 4790 A:e058  20 ee d2                           jsr REASON
 4791 A:e05b  a9 00                              lda #0
 4792 A:e05d  a8                                 tay 
 4793 A:e05e  85 b1                              sta FBUFPT+1

 4800 A:e060  a2 05                              ldx #5

 4802 A:e062  a5 84                              lda VARNAM                ;THIS CODE ONLY WORKS FOR INTPRC=1
 4803 A:e064  91 9e                              sta (LOWTR),Y            ;IF ADDPRC=1.

 4806 A:e066  10 03                              bpl NOTFLT
 4807 A:e068  ca                                 dex 

 4809 A:e069                           NOTFLT    
 4809 A:e069  c8                                 iny 
 4810 A:e06a  a5 85                              lda VARNAM+1
 4811 A:e06c  91 9e                              sta (LOWTR),Y
 4812 A:e06e  10 04                              bpl STOMLT
 4813 A:e070  ca                                 dex 

 4816 A:e071  ca                                 dex 

 4818 A:e072                           STOMLT    
 4818 A:e072  86 b0                              stx FBUFPT
 4819 A:e074  a5 0f                              lda COUNT
 4820 A:e076  c8                                 iny 
 4821 A:e077  c8                                 iny 
 4822 A:e078  c8                                 iny 
 4823 A:e079  91 9e                              sta (LOWTR),Y            ;SAVE NUMBER OF DIMENSIONS.
 4824 A:e07b                           LOPPTA    
 4824 A:e07b  a2 0b                              ldx #11             ;DEFAULT SIZE.
 4825 A:e07d  a9 00                              lda #0
 4826 A:e07f  24 10                              bit DIMFLG
 4827 A:e081  50 0a                              bvc NOTDIM                ;NOT IN A DIM STATEMENT.
 4828 A:e083  68                                 pla                    ;GET LOW ORDER OF INDICE.
 4829 A:e084  18                                 clc 
 4830 A:e085  69 01                              adc #1
 4831 A:e087  aa                                 tax 
 4832 A:e088  68                                 pla                    ;GET HIGH PART OF INDICE.
 4833 A:e089  69 00                              adc #0
 4834 A:e08b                           NOTDIM    
 4834 A:e08b  c8                                 iny 
 4835 A:e08c  91 9e                              sta (LOWTR),Y            ;STORE HIGH PART OF INDICE.
 4836 A:e08e  c8                                 iny 
 4837 A:e08f  8a                                 txa 
 4838 A:e090  91 9e                              sta (LOWTR),Y            ;STORE LOW ORDER OF INDICE.
 4839 A:e092  20 41 e1                           jsr UMULT                ;[X,A]=[CURTOL]*[LOWTR,Y]
 4840 A:e095  86 b0                              stx FBUFPT                ;SAVE NEW TALLY.
 4841 A:e097  85 b1                              sta FBUFPT+1
 4842 A:e099  a4 61                              ldy INDEX1
 4843 A:e09b  c6 0f                              dec COUNT                ;ANY MORE INDICES LEFT?
 4844 A:e09d  d0 dc                              bne LOPPTA                ;YES.
 4845 A:e09f  65 98                              adc HIGHDS+1
 4846 A:e0a1  b0 5f                              bcs OMERR1                ;OVERFLOW.
 4847 A:e0a3  85 98                              sta HIGHDS+1          ;COMPUTE WHERE TO ZERO.
 4848 A:e0a5  a8                                 tay 
 4849 A:e0a6  8a                                 txa 
 4850 A:e0a7  65 97                              adc HIGHDS
 4851 A:e0a9  90 05                              bcc GREASE
 4852 A:e0ab  c8                                 iny 
 4853 A:e0ac  f0 54                              beq OMERR1
 4854 A:e0ae                           GREASE    
 4854 A:e0ae  20 ee d2                           jsr REASON                ;GET ROOM.
 4855 A:e0b1                                    ;NEW END OF STORAGE.
 4856 A:e0b1  85 70                              sta STREND
 4857 A:e0b3  84 71                              sty STREND+1
 4858 A:e0b5  a9 00                              lda #0             ;STORING [ACCA] IS FASTER THAN CLEAR.
 4859 A:e0b7  e6 b1                              inc FBUFPT+1
 4860 A:e0b9  a4 b0                              ldy FBUFPT
 4861 A:e0bb  f0 07                              beq DECCUR
 4862 A:e0bd                           ZERITA    
 4862 A:e0bd  88                                 dey 
 4863 A:e0be  91 97                              sta (HIGHDS),Y
 4864 A:e0c0  d0 fb                              bne ZERITA                ;NO. CONTINUE.
 4865 A:e0c2                           DECCUR    
 4865 A:e0c2  c6 98                              dec HIGHDS+1
 4866 A:e0c4  c6 b1                              dec FBUFPT+1
 4867 A:e0c6  d0 f5                              bne ZERITA                ;DO ANOTHER BLOCK.
 4868 A:e0c8  e6 98                              inc HIGHDS+1          ;BUMP BACK UP. WILL USE LATER.
 4869 A:e0ca  38                                 sec 
 4870 A:e0cb  a5 70                              lda STREND                ;RESTORE [ACCA].
 4871 A:e0cd  e5 9e                              sbc LOWTR                ;DETERMINE LENGTH.
 4872 A:e0cf  a0 02                              ldy #2
 4873 A:e0d1  91 9e                              sta (LOWTR),Y            ;LOW.
 4874 A:e0d3  a5 71                              lda STREND+1
 4875 A:e0d5  c8                                 iny 
 4876 A:e0d6  e5 9f                              sbc LOWTR+1
 4877 A:e0d8  91 9e                              sta (LOWTR),Y            ;HIGH.
 4878 A:e0da  a5 10                              lda DIMFLG
 4879 A:e0dc  d0 64                              bne DIMRTS                ;BYE.
 4880 A:e0de  c8                                 iny 
 4881 A:e0df                                    ;
 4882 A:e0df                                    ; AT THIS POINT [LOWTR,Y] POINTS BEYOND THE SIZE TO THE NUMBER OF
 4883 A:e0df                                    ; DIMENSIONS. STRATEGY:
 4884 A:e0df                                    ; NUMDIM=NUMBER OF DIMENSIONS.
 4885 A:e0df                                    ; CURTOL=0.
 4886 A:e0df                                    ; INLPNM:GET A NEW INDICE.
 4887 A:e0df                                    ; MAKE SURE INDICE IS NOT TOO BIG.
 4888 A:e0df                                    ; MULTIPLY CURTOL BY CURMAX.
 4889 A:e0df                                    ; ADD INDICE TO CURTOL.
 4890 A:e0df                                    ; NUMDIM=NUMDIM-1.
 4891 A:e0df                                    ; BNE INLPNM.
 4892 A:e0df                                    ; USE [CURTOL]*4 AS OFFSET.
 4893 A:e0df                                    ;
 4894 A:e0df                           GETDEF    
 4894 A:e0df  b1 9e                              lda (LOWTR),Y
 4895 A:e0e1  85 0f                              sta COUNT                ;SAVE A COUNTER.
 4896 A:e0e3  a9 00                              lda #0             ;ZERO [CURTOL].
 4897 A:e0e5  85 b0                              sta FBUFPT
 4898 A:e0e7                           INLPNM    
 4898 A:e0e7  85 b1                              sta FBUFPT+1
 4899 A:e0e9  c8                                 iny 
 4900 A:e0ea  68                                 pla                    ;GET LOW INDICE.
 4901 A:e0eb  aa                                 tax 
 4902 A:e0ec  85 a3                              sta FACMO
 4903 A:e0ee  68                                 pla                    ;AND THE HIGH PART
 4904 A:e0ef  85 a4                              sta FACMO+1
 4905 A:e0f1  d1 9e                              cmp (LOWTR),Y            ;COMPARE WITH MAX INDICE.
 4906 A:e0f3  90 10                              bcc INLPN2
 4907 A:e0f5  d0 08                              bne BSERR7                ;IF GREATER, "BAD SUBSCRIPT" ERROR.
 4908 A:e0f7  c8                                 iny 
 4909 A:e0f8  8a                                 txa 
 4910 A:e0f9  d1 9e                              cmp (LOWTR),Y
 4911 A:e0fb  90 09                              bcc INLPN1
 4912 A:e0fd                           BSERR7    
 4912 A:e0fd  4c 36 e0                           jmp BSERR
 4913 A:e100                           OMERR1    
 4913 A:e100  4c 1b d3                           jmp OMERR
 4914 A:e103                           INLPN2    
 4914 A:e103  c8                                 iny 
 4915 A:e104                           INLPN1    
 4915 A:e104  a5 b1                              lda FBUFPT+1          ;DON'T MULTIPLY IF CURTOL=0.
 4916 A:e106  05 b0                              ora FBUFPT
 4917 A:e108  18                                 clc                    ;PREPARE TO GET INDICE BACK.
 4918 A:e109  f0 0c                              beq ADDIND                ;GET HIGH PART OF INDICE BACK.
 4919 A:e10b  20 41 e1                           jsr UMULT                ;MULTIPLY [CURTOL] BY [LOWTR,Y,Y+1].
 4920 A:e10e  8a                                 txa 
 4921 A:e10f  65 a3                              adc FACMO                ;ADD IN [INDICE].
 4922 A:e111  aa                                 tax 
 4923 A:e112  98                                 tya 
 4924 A:e113  a4 61                              ldy INDEX1
 4925 A:e115                           ADDIND    
 4925 A:e115  65 a4                              adc FACMO+1
 4926 A:e117  86 b0                              stx FBUFPT
 4927 A:e119  c6 0f                              dec COUNT                ;ANY MORE?
 4928 A:e11b  d0 ca                              bne INLPNM                ;YES.
 4929 A:e11d  85 b1                              sta FBUFPT+1          ;FIX ARRAY BUG ****

 4936 A:e11f  a2 05                              ldx #5
 4937 A:e121  a5 84                              lda VARNAM
 4938 A:e123  10 03                              bpl NOTFL1
 4939 A:e125  ca                                 dex 

 4941 A:e126                           NOTFL1    
 4941 A:e126  a5 85                              lda VARNAM+1
 4942 A:e128  10 04                              bpl STOML1
 4943 A:e12a  ca                                 dex 

 4946 A:e12b  ca                                 dex 

 4948 A:e12c                           STOML1    
 4948 A:e12c  86 67                              stx RESMO
 4949 A:e12e  a9 00                              lda #0
 4950 A:e130  20 4a e1                           jsr UMULTD                ;ON RTS, A&Y=HI . X=LO.
 4951 A:e133  8a                                 txa 
 4952 A:e134  65 97                              adc HIGHDS
 4953 A:e136  85 86                              sta VARPNT
 4954 A:e138  98                                 tya 
 4955 A:e139  65 98                              adc HIGHDS+1
 4956 A:e13b  85 87                              sta VARPNT+1
 4957 A:e13d  a8                                 tay 
 4958 A:e13e  a5 86                              lda VARPNT
 4959 A:e140                           DIMRTS    
 4959 A:e140  60                                 rts                    ;RETURN TO CALLER.
 4960 A:e141                                    ; SUBTTL INTEGER ARITHMETIC ROUTINES.
 4961 A:e141                                    ;TWO BYTE UNSIGNED INTEGER MULTIPLY.
 4962 A:e141                                    ;THIS IS FOR MULTIPLY DIMENSIONED ARRAYS.
 4963 A:e141                                    ; [X,Y]=[X,A]=[CURTOL]*[LOWTR,Y,Y+1].
 4964 A:e141                           UMULT     
 4964 A:e141  84 61                              sty INDEX1
 4965 A:e143  b1 9e                              lda (LOWTR),Y
 4966 A:e145  85 67                              sta RESMO                ;LOW, THEN HIGH.
 4967 A:e147  88                                 dey 
 4968 A:e148  b1 9e                              lda (LOWTR),Y            ;PUT [LOWTR,Y,Y+1] IN FASTER MEMORY.
 4969 A:e14a                           UMULTD    
 4969 A:e14a  85 68                              sta RESMO+1
 4970 A:e14c  a9 10                              lda #16
 4971 A:e14e  85 9c                              sta LOWDS
 4972 A:e150  a2 00                              ldx #0             ;CLR THE ACCS.
 4973 A:e152  a0 00                              ldy #0             ;RESULT INITIALLY ZERO.
 4974 A:e154                           UMULTC    
 4974 A:e154  8a                                 txa 
 4975 A:e155  0a                                 asl                    ;MULTIPLY BY TWO.
 4976 A:e156  aa                                 tax 
 4977 A:e157  98                                 tya 
 4978 A:e158  2a                                 rol 
 4979 A:e159  a8                                 tay 
 4980 A:e15a  b0 a4                              bcs OMERR1                ;TWO MUCH !
 4981 A:e15c  06 b0                              asl FBUFPT
 4982 A:e15e  26 b1                              rol FBUFPT+1
 4983 A:e160  90 0d                              bcc UMLCNT                ;NOTHING IN THIS POSITION TO MULTIPLY.
 4984 A:e162  18                                 clc 
 4985 A:e163  8a                                 txa 
 4986 A:e164  65 67                              adc RESMO
 4987 A:e166  aa                                 tax 
 4988 A:e167  98                                 tya 
 4989 A:e168  65 68                              adc RESMO+1
 4990 A:e16a  a8                                 tay 
 4991 A:e16b  b0 93                              bcs OMERR1                ;MAN, JUST TOO MUCH !
 4992 A:e16d                           UMLCNT    
 4992 A:e16d  c6 9c                              dec LOWDS                ;DONE?
 4993 A:e16f  d0 e3                              bne UMULTC                ;KEEP IT UP.
 4994 A:e171                           UMLRTS    
 4994 A:e171  60                                 rts                    ;YES, ALL DONE.
