 5183 A:e26b                                    ;
 5184 A:e26b                                    ; "STRINI" GET STRING SPACE FOR THE CREATION OF A STRING AND
 5185 A:e26b                                    ; CREATES A DESCRIPTOR FOR IT IN "DSCTMP".
 5186 A:e26b                                    ;
 5187 A:e26b                           STRINI    
 5187 A:e26b                                    ;GET FACMO TO STORE IN DSCPNT.
 5188 A:e26b  a6 a3                              ldx FACMO
 5189 A:e26d  a4 a4                              ldy FACMO+1
