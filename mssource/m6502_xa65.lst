 3060 A:d88a                                    ; PAGE
 3061 A:d88a                                    ; SUBTTL LINGET -- READ A LINE NUMBER INTO LINNUM
 3062 A:d88a                                    ;
 3063 A:d88a                                    ; "LINGET" READS A LINE NUMBER FROM THE CURRENT TEXT POSITION.
 3064 A:d88a                                    ;
 3065 A:d88a                                    ; LINE NUMBERS RANGE FROM 0 TO 64000-1.
 3066 A:d88a                                    ;
 3067 A:d88a                                    ; THE ANSWER IS RETURNED IN "LINNUM".
 3068 A:d88a                                    ; "TXTPTR" IS UPDATED TO POINT TO THE TERMINATING CHARCTER
 3069 A:d88a                                    ; AND [A] = THE TERMINATING CHARACTER WITH CONDITION
 3070 A:d88a                                    ; CODES SET UP TO REFLECT ITS VALUE.
 3071 A:d88a                                    ;
 3072 A:d88a                           LINGET    
 3072 A:d88a  a2 00                              ldx #0
 3073 A:d88c  86 53                              stx LINNUM                ;INITIALIZE LINE NUMBER TO ZERO.
 3074 A:d88e  86 54                              stx LINNUM+1
 3075 A:d890                           MORLIN    
 3075 A:d890  b0 f7                              bcs ONGRTS                ;IT IS NOT A DIGIT.
 3076 A:d892  e9 2f                              sbc #"0"-1       ;-1 SINCE C=0.
 3077 A:d894  85 0d                              sta CHARAC                ;SAVE CHARACTER.
 3078 A:d896  a5 54                              lda LINNUM+1
 3079 A:d898  85 61                              sta INDEX1
 3080 A:d89a  c9 19                              cmp #25             ;LINE NUMBER WILL BE .LT. 64000?
 3081 A:d89c  b0 d4                              bcs SNERR3
 3082 A:d89e  a5 53                              lda LINNUM
 3083 A:d8a0  0a                                 asl                    ;MULTIPLY BY 10.
 3084 A:d8a1  26 61                              rol INDEX1
 3085 A:d8a3  0a                                 asl 
 3086 A:d8a4  26 61                              rol INDEX1
 3087 A:d8a6  65 53                              adc LINNUM
 3088 A:d8a8  85 53                              sta LINNUM
 3089 A:d8aa  a5 61                              lda INDEX1
 3090 A:d8ac  65 54                              adc LINNUM+1
 3091 A:d8ae  85 54                              sta LINNUM+1
 3092 A:d8b0  06 53                              asl LINNUM
 3093 A:d8b2  26 54                              rol LINNUM+1
 3094 A:d8b4  a5 53                              lda LINNUM
 3095 A:d8b6  65 0d                              adc CHARAC                ;ADD IN DIGIT.
 3096 A:d8b8  85 53                              sta LINNUM
 3097 A:d8ba  90 04                              bcc NXTLGC
 3098 A:d8bc  e6 54                              inc LINNUM+1
 3099 A:d8be                           NXTLGC    
