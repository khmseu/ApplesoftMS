 4641 A:16c4                           N32768    
 4641 A:16c4  90 80 00 00                        .byt 144,128,0,0;-32768.

 4643 A:16c8                                    ;
 4644 A:16c8                                    ; INTIDX READS A FORMULA FROM THE CURRENT POSITION AND
 4645 A:16c8                                    ; TURNS IT INTO A POSITIVE INTEGER
 4646 A:16c8                                    ; LEAVING THE RESULT IN FACMO&LO. NEGATIVE ARGUMENTS
 4647 A:16c8                                    ; ARE NOT ALLOWED.
 4648 A:16c8                                    ;
 4649 A:16c8                           INTIDX    
 4649 A:16c8  20 b2 00                           jsr CHRGET
 4650 A:16cb  20 4a 13                           jsr FRMEVL                ;GET A NUMBER
 4651 A:16ce                           POSINT    
 4651 A:16ce  20 36 13                           jsr CHKNUM
 4652 A:16d1  a5 a5                              lda FACSGN
 4653 A:16d3  30 0f                              bmi NONONO                ;IF NEGATIVE, BLOW HIM OUT.
 4654 A:16d5                           AYINT     
 4654 A:16d5  a5 a0                              lda FACEXP
 4655 A:16d7  c9 90                              cmp #144             ;FAC .GT. 32767?
 4656 A:16d9  90 0b                              bcc QINTGO
 4657 A:16db                                    ;GET ADDR OF -32768.
 4658 A:16db  a9 c4                              lda #N32768&255
 4659 A:16dd  a0 16                              ldy #N32768/256
 4660 A:16df  20 82 21                           jsr FCOMP                ;SEE IF FAC=[[Y,A]].
 4661 A:16e2                           NONONO    
 4661 A:16e2  d0 7f                              bne FCERR                ;NO, FAC IS TOO BIG.
 4662 A:16e4                           QINTGO    
 4662 A:16e4  4c c2 21                           jmp QINT                ;GO TO QINT AND SHOVE IT.
 4663 A:16e7                                    ;
 4664 A:16e7                                    ; FORMAT OF ARRAYS IN CORE.
 4665 A:16e7                                    ;
 4666 A:16e7                                    ; DESCRIPTOR:
 4667 A:16e7                                    ; LOWBYTE = FIRST CHARACTER.
 4668 A:16e7                                    ; HIGHBYTE = SECOND CHARACTER (200 BIT IS STRING FLAG).
 4669 A:16e7                                    ; LENGTH OF ARRAY IN CORE IN BYTES (INCLUDES EVERYTHING).
 4670 A:16e7                                    ; NUMBER OF DIMENSIONS.
 4671 A:16e7                                    ; FOR EACH DIMENSION STARTING WITH THE FIRST A LIST
 4672 A:16e7                                    ; (2 BYTES EACH) OF THE MAX INDICE+1
 4673 A:16e7                                    ; THE VALUES
 4674 A:16e7                                    ;
 4675 A:16e7                           ISARY     
 4675 A:16e7  a5 10                              lda DIMFLG

 4678 A:16e9  05 12                              ora INTFLG

 4680 A:16eb  48                                 pha                    ;SAVE [DIMFLG] FOR RECURSION.
 4681 A:16ec  a5 11                              lda VALTYP
 4682 A:16ee  48                                 pha                    ;SAVE [VALTYP] FOR RECURSION.
 4683 A:16ef  a0 00                              ldy #0             ;SET NUMBER OF DIMENSIONS TO ZERO.
 4684 A:16f1                           INDLOP    
 4684 A:16f1  98                                 tya                    ;SAVE NUMBER OF DIMS.
 4685 A:16f2  48                                 pha 
 4686 A:16f3                                    ;SAVE LOOKS.
 4687 A:16f3  a5 85                              lda VARNAM+1
 4688 A:16f5  48                                 pha 
 4689 A:16f6  a5 84                              lda VARNAM
 4690 A:16f8  48                                 pha 
 4691 A:16f9  20 c8 16                           jsr INTIDX                ;EVALUATE INDICE INTO FACMO&LO.
 4692 A:16fc                                    ;GET BACK ALL... WE'RE HOME.
 4693 A:16fc  68                                 pla 
 4694 A:16fd  85 84                              sta VARNAM
 4695 A:16ff  68                                 pla 
 4696 A:1700  85 85                              sta VARNAM+1
 4697 A:1702  68                                 pla                    ;(# OF DIMS).
 4698 A:1703  a8                                 tay 
 4699 A:1704  ba                                 tsx 
 4700 A:1705  bd 02 01                           lda 258,X
 4701 A:1708  48                                 pha                    ;PUSH DIMFLG AND VALTYP FURTHER.
 4702 A:1709  bd 01 01                           lda 257,X
 4703 A:170c  48                                 pha 
 4704 A:170d  a5 a3                              lda FACMO                ;PUT INDICE ONTO STACK.
 4705 A:170f  9d 02 01                           sta 258,X,           ;UNDER DIMFLG AND VALTYP.
 4706 A:1712  a5 a4                              lda FACMO+1
 4707 A:1714  9d 01 01                           sta 257,X
 4708 A:1717  c8                                 iny                    ;INCREMENT # OF DIMS.
 4709 A:1718  20 b8 00                           jsr CHRGOT                ;GET TERMINATING CHARACTER.
 4710 A:171b  c9 2c                              cmp #44             ;A COMMA?
 4711 A:171d  f0 d2                              beq INDLOP                ;YES.
 4712 A:171f  84 0f                              sty COUNT                ;SAVE COUNT OF DIMS.
 4713 A:1721  20 8d 14                           jsr CHKCLS                ;MUST BE CLOSED PAREN.
 4714 A:1724  68                                 pla 
 4715 A:1725  85 11                              sta VALTYP                ;GET VALTYP AND
 4716 A:1727  68                                 pla 

 4719 A:1728  85 12                              sta INTFLG
 4720 A:172a  29 7f                              and #127

 4722 A:172c  85 10                              sta DIMFLG                ;DIMFLG OFF STACK.
 4723 A:172e  a6 6e                              ldx ARYTAB                ;PLACE TO START SEARCH.
 4724 A:1730  a5 6f                              lda ARYTAB+1
 4725 A:1732                           LOPFDA    
 4725 A:1732  86 9e                              stx LOWTR
 4726 A:1734  85 9f                              sta LOWTR+1
 4727 A:1736  c5 71                              cmp STREND+1          ;END OF ARRAYS?
 4728 A:1738  d0 06                              bne LOPFDV
 4729 A:173a  e4 70                              cpx STREND
 4730 A:173c  f0 3e                              beq NOTFDD                ;A FINE THING! NO ARRAY!.
 4731 A:173e                           LOPFDV    
 4731 A:173e  a0 00                              ldy #0
 4732 A:1740  b1 9e                              lda (LOWTR),Y
 4733 A:1742  c8                                 iny 
 4734 A:1743  c5 84                              cmp VARNAM                ;COMPARE HIGH ORDERS.
 4735 A:1745  d0 08                              bne NMARY1                ;NO WAY IS IT THIS. GET OUT OF HERE.
 4736 A:1747  a5 85                              lda VARNAM+1
 4737 A:1749  d1 9e                              cmp (LOWTR),Y            ;LOW ORDERS?
 4738 A:174b  f0 1b                              beq GOTARY                ;WELL, HERE IT IS !!
 4739 A:174d                           NMARY1    
 4739 A:174d  c8                                 iny 
