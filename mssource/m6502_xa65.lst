 1667 A:d270                                    ; PAGE
 1668 A:d270                                    ; SUBTTL GENERAL STORAGE MANAGEMENT ROUTINES.
 1669 A:d270                                    ;
 1670 A:d270                                    ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
 1671 A:d270                                    ;

 1673 A:d270                           FNDFOR    
 1673 A:d270  ba                                 tsx                    ;LOAD XREG WITH STK PNTR.
 1674 A:d271  e8                                 inx 
 1675 A:d272  e8                                 inx 
 1676 A:d273  e8                                 inx 
 1677 A:d274  e8                                 inx 
 1678 A:d275                           FFLOOP    
 1678 A:d275  bd 01 01                           lda 257,X            ;GET STACK ENTRY.
 1679 A:d278  c9 7f                              cmp #127             ;IS IT A "FOR" TOKEN?
 1680 A:d27a  d0 21                              bne FFRTS                ;NO, NO "FOR" LOOPS WITH THIS PNTR.
 1681 A:d27c  a5 89                              lda FORPNT+1          ;GET HIGH.
 1682 A:d27e  d0 0a                              bne CMPFOR
 1683 A:d280  bd 02 01                           lda 258,X            ;PNTR IS ZERO, SO ASSUME THIS ONE.
 1684 A:d283  85 88                              sta FORPNT
 1685 A:d285  bd 03 01                           lda 259,X
 1686 A:d288  85 89                              sta FORPNT+1
 1687 A:d28a                           CMPFOR    
 1687 A:d28a  dd 03 01                           cmp 259,X
 1688 A:d28d  d0 07                              bne ADDFRS                ;NOT THIS ONE.
 1689 A:d28f  a5 88                              lda FORPNT                ;GET DOWN.
 1690 A:d291  dd 02 01                           cmp 258,X
 1691 A:d294  f0 07                              beq FFRTS                ;WE GOT IT! WE GOT IT!
 1692 A:d296                           ADDFRS    
 1692 A:d296  8a                                 txa 
 1693 A:d297  18                                 clc                    ;ADD 16 TO X.
 1694 A:d298  69 12                              adc #18
 1695 A:d29a  aa                                 tax                    ;RESULT BACK INTO X.
 1696 A:d29b  d0 d8                              bne FFLOOP
 1697 A:d29d                           FFRTS     
 1697 A:d29d  60                                 rts                    ;RETURN TO CALLER.

 1699 A:d29e                                    ;
 1700 A:d29e                                    ; THIS IS THE BLOCK TRANSFER ROUTINE.
 1701 A:d29e                                    ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
 1702 A:d29e                                    ;
 1703 A:d29e                                    ; ON ENTRY:
 1704 A:d29e                                    ; [Y,A]=[HIGHDS]    (FOR REASON).
 1705 A:d29e                                    ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
 1706 A:d29e                                    ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
 1707 A:d29e                                    ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
 1708 A:d29e                                    ;
 1709 A:d29e                                    ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
 1710 A:d29e                                    ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
 1711 A:d29e                                    ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
 1712 A:d29e                                    ;
 1713 A:d29e                                    ; ON EXIT:
 1714 A:d29e                                    ; [LOWTR] ARE UNCHANGED.
 1715 A:d29e                                    ; [HIGHTR]=[LOWTR]-200 OCTAL.
 1716 A:d29e                                    ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
 1717 A:d29e                                    ;
 1718 A:d29e                           BLTU      
 1718 A:d29e  20 ee d2                           jsr REASON                ;ASCERTAIN THAT STRING SPACE WON'T
 1719 A:d2a1                                    ;BE OVERRUN.

 1721 A:d2a1  85 70                              sta STREND
 1722 A:d2a3  84 71                              sty STREND+1
 1723 A:d2a5                           BLTUC     
 1723 A:d2a5  38                                 sec                    ;PREPARE TO SUBTRACT.
 1724 A:d2a6  a5 99                              lda HIGHTR
 1725 A:d2a8  e5 9e                              sbc LOWTR                ;COMPUTE NUMBER OF THINGS TO MOVE.
 1726 A:d2aa  85 61                              sta INDEX1                ;SAVE FOR LATER.
 1727 A:d2ac  a8                                 tay 
 1728 A:d2ad  a5 9a                              lda HIGHTR+1
 1729 A:d2af  e5 9f                              sbc LOWTR+1
 1730 A:d2b1  aa                                 tax                    ;PUT IT IN A COUNTER REGISTER.
 1731 A:d2b2  e8                                 inx                    ;SO THAT COUNTER ALGORITHM WORKS.
 1732 A:d2b3  98                                 tya                    ;SEE IF LOW PART OF COUNT IS ZERO.
 1733 A:d2b4  f0 23                              beq DECBLT                ;YES, GO START MOVING BLOCKS.
 1734 A:d2b6  a5 99                              lda HIGHTR                ;NO, MUST MODIFY BASE ADDR.
 1735 A:d2b8  38                                 sec 
 1736 A:d2b9  e5 61                              sbc INDEX1                ;BORROW IS OFF SINCE [HIGHTR].GT.[LOWTR].
 1737 A:d2bb  85 99                              sta HIGHTR                ;SAVE MODIFIED BASE ADDR.
 1738 A:d2bd  b0 03                              bcs BLT1                ;IF NO BORROW, GO SHOVE IT.
 1739 A:d2bf  c6 9a                              dec HIGHTR+1          ;BORROW IMPLIES SUB 1 FROM HIGH ORDER.
 1740 A:d2c1  38                                 sec 
 1741 A:d2c2                           BLT1      
 1741 A:d2c2  a5 97                              lda HIGHDS                ;MOD BASE OF DEST ADDR.
 1742 A:d2c4  e5 61                              sbc INDEX1
 1743 A:d2c6  85 97                              sta HIGHDS
 1744 A:d2c8  b0 08                              bcs MOREN1                ;NO BORROW.
 1745 A:d2ca  c6 98                              dec HIGHDS+1          ;DECREMENT HIGH ORDER BYTE.
 1746 A:d2cc  90 04                              bcc MOREN1                ;ALWAYS SKIP.
 1747 A:d2ce                           BLTLP     
 1747 A:d2ce  b1 99                              lda (HIGHTR),Y            ;FETCH BYTE TO MOVE
 1748 A:d2d0  91 97                              sta (HIGHDS),Y            ;MOVE IT IN, MOVE IT OUT.
 1749 A:d2d2                           MOREN1    
 1749 A:d2d2  88                                 dey 
 1750 A:d2d3  d0 f9                              bne BLTLP
 1751 A:d2d5  b1 99                              lda (HIGHTR),Y            ;MOVE LAST OF THE BLOCK.
 1752 A:d2d7  91 97                              sta (HIGHDS),Y
 1753 A:d2d9                           DECBLT    
 1753 A:d2d9  c6 9a                              dec HIGHTR+1
 1754 A:d2db  c6 98                              dec HIGHDS+1          ;START ON NEW BLOCKS.
 1755 A:d2dd  ca                                 dex 
 1756 A:d2de  d0 f2                              bne MOREN1
 1757 A:d2e0  60                                 rts                    ;RETURN TO CALLER.

 1759 A:d2e1                                    ;
 1760 A:d2e1                                    ; THIS ROUTINE IS USED TO ASCERTAIN THAT A GIVEN
 1761 A:d2e1                                    ; NUMBER OF LOCS REMAIN AVAILABLE FOR THE STACK.
 1762 A:d2e1                                    ;    THE CALL IS:
 1763 A:d2e1                                    ; LDAI NUMBER OF 2-BYTE ENTRIES NEEDED.
 1764 A:d2e1                                    ; JSR GETSTK
 1765 A:d2e1                                    ;
 1766 A:d2e1                                    ; THIS ROUTINE MUST BE CALLED BY ANY ROUTINE WHICH PUTS
 1767 A:d2e1                                    ; AN ARBITRARY AMOUNT OF STUFF ON THE STACK,
 1768 A:d2e1                                    ; I.E., ANY RECURSIVE ROUTINE LIKE "FRMEVL".
 1769 A:d2e1                                    ; IT IS ALSO CALLED BY ROUTINES SUCH AS "GOSUB" AND "FOR"
 1770 A:d2e1                                    ; WHICH MAKE PERMANENT ENTRIES ON THE STACK.
 1771 A:d2e1                                    ;
 1772 A:d2e1                                    ; ROUTINES WHICH MERELY USE AND FREE UP THE GUARANTEED
 1773 A:d2e1                                    ; NUMLEV LOCATIONS NEED NOT CALL THIS.
 1774 A:d2e1                                    ;
 1775 A:d2e1                                    ;
 1776 A:d2e1                                    ; ON EXIT:
 1777 A:d2e1                                    ;    [A] AND [X] HAVE BEEN MODIFIED.
 1778 A:d2e1                                    ;
 1779 A:d2e1                           GETSTK    
 1779 A:d2e1  0a                                 asl                    ;MULT [A] BY 2. NB, CLEARS C BIT.
 1780 A:d2e2  69 3e                              adc #(((2*23)+3)*1)+13;MAKE SURE 2*NUMLEV+13 LOCS
 1781 A:d2e4                                    ;(13 BECAUSE OF FBUFFR)
 1782 A:d2e4  b0 35                              bcs OMERR                ;WILL REMAIN IN STACK.
 1783 A:d2e6  85 61                              sta INDEX1
 1784 A:d2e8  ba                                 tsx                    ;GET STACKED.
 1785 A:d2e9  e4 61                              cpx INDEX1                ;COMPARE.
 1786 A:d2eb  90 2e                              bcc OMERR                ;IF STACK.LE.INDEX1, OM.
 1787 A:d2ed  60                                 rts 

 1789 A:d2ee                                    ;
 1790 A:d2ee                                    ; [Y,A] IS A CERTAIN ADDRESS. "REASON" MAKES SURE
 1791 A:d2ee                                    ; IT IS LESS THAN [FRETOP].
 1792 A:d2ee                                    ;
 1793 A:d2ee                           REASON    
 1793 A:d2ee  c4 73                              cpy FRETOP+1
 1794 A:d2f0  90 28                              bcc REARTS
 1795 A:d2f2  d0 04                              bne TRYMOR                ;GO GARB COLLECT.
 1796 A:d2f4  c5 72                              cmp FRETOP
 1797 A:d2f6  90 22                              bcc REARTS
 1798 A:d2f8                           TRYMOR    
 1798 A:d2f8  48                                 pha 
 1799 A:d2f9  a2 09                              ldx #8+1       ;IF TEMPF2 HAS ZERO IN BETWEEN.
 1800 A:d2fb  98                                 tya 
 1801 A:d2fc                           REASAV    
 1801 A:d2fc  48                                 pha 
 1802 A:d2fd  b5 96                              lda HIGHDS-1,X        ;SAVE HIGHDS ON STACK.
 1803 A:d2ff  ca                                 dex 
 1804 A:d300  10 fa                              bpl REASAV                ;PUT 8 OF THEM ON STK.
 1805 A:d302  20 1c e3                           jsr GARBA2                ;GO GARB COLLECT.
 1806 A:d305  a2 f7                              ldx #256-8-1
 1807 A:d307                           REASTO    
 1807 A:d307  68                                 pla 
 1808 A:d308  95 a0                              sta HIGHDS+8+1,X  ;RESTORE AFTER GARB COLLECT.
 1809 A:d30a  e8                                 inx 
 1810 A:d30b  30 fa                              bmi REASTO
 1811 A:d30d  68                                 pla 
 1812 A:d30e  a8                                 tay 
 1813 A:d30f  68                                 pla                    ;RESTORE A AND Y.
 1814 A:d310  c4 73                              cpy FRETOP+1          ;COMPARE HIGHS
 1815 A:d312  90 06                              bcc REARTS
 1816 A:d314  d0 05                              bne OMERR                ;HIGHER IS BAD.
 1817 A:d316  c5 72                              cmp FRETOP                ;AND THE LOWS.
 1818 A:d318  b0 01                              bcs OMERR
 1819 A:d31a                           REARTS    
 1819 A:d31a  60                                 rts 

