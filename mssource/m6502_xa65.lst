 2393 A:d582  20 f1 d4                           jsr FNDLIN                ;FIND LINE .GE. [NUMLIN].
 2394 A:d585  20 b8 00                           jsr CHRGOT                ;GET LAST CHARACTER.
 2395 A:d588  f0 0e                              beq LSTEND                ;IF END OF LINE, # IS THE END.
 2396 A:d58a  c9 81                              cmp #129             ;DASH?
 2397 A:d58c  d0 91                              bne FLNRTS                ;IF NOT, SYNTAX ERROR.
 2398 A:d58e  20 b2 00                           jsr CHRGET                ;GET NEXT CHAR.
 2399 A:d591  20 96 d8                           jsr LINGET                ;GET END #.
 2400 A:d594  d0 89                              bne FLNRTS                ;IF NOT TERMINATOR, ERROR.
 2401 A:d596                           LSTEND    
 2401 A:d596  68                                 pla 
 2402 A:d597  68                                 pla                    ;GET RID OF "NEWSTT" RTS ADDR.
