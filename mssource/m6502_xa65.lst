 2966 A:d7ea                           GORTS     
 2966 A:d7ea  60                                 rts                    ;PROCESS THE STATEMENT.
 2967 A:d7eb                                    ;
 2968 A:d7eb                                    ; "RETURN" RESTORES THE LINE NUMBER AND TEXT PNTR FROM THE STACK
 2969 A:d7eb                                    ; AND ELIMINATES ALL THE "FOR" ENTRIES IN FRONT OF THE "GOSUB" ENTRY.
 2970 A:d7eb                                    ;
 2971 A:d7eb                           RETURN    
 2971 A:d7eb  d0 fd                              bne GORTS                ;NO TERMINATOR=BLOW HIM UP.
 2972 A:d7ed  a9 ff                              lda #255
 2973 A:d7ef  85 89                              sta FORPNT+1          ;MAKE SURE THE VARIABLE'S PNTR
 2974 A:d7f1                                    ;NEVER GETS MATCHED.
