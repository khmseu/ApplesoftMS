 5680 A:1c57                                    ; MID ($,#) RETURNS STRING WITH CHARS FROM # POSITION
 5681 A:1c57                                    ; ONWARD. IF # .GT. LEN ($) THEN RETURN NULL STRING.
 5682 A:1c57                                    ; MID ($,#,#) RETURNS STRING WITH CHARACTERS FROM
 5683 A:1c57                                    ; # POSITION FOR #2 CHARACTERS. IF #2 GOES PAST END OF STRING
