 5855 A:1d4e                                    ; THE WAIT LOCATION,MASK1,MASK2 STATEMENT WAITS UNTIL THE CONTENTS
 5856 A:1d4e                                    ; OF LOCATION IS NONZERO WHEN XORED WITH MASK2
 5857 A:1d4e                                    ; AND THEN ANDED WITH MASK1. IF MASK2 IS NOT PRESENT, IT
 5858 A:1d4e                                    ; IS ASSUMED TO BE ZERO.

 5860 A:1d4e                           FNWAIT    
 5860 A:1d4e  20 0c 1d                           jsr GETNUM
 5861 A:1d51  86 88                              stx FORPNT
 5862 A:1d53  a2 00                              ldx #0
 5863 A:1d55  20 b8 00                           jsr CHRGOT
 5864 A:1d58  f0 07                              beq STORDO
 5865 A:1d5a  20 12 1d                           jsr COMBYT                ;GET MASK2.
 5866 A:1d5d                           STORDO    
 5866 A:1d5d  86 89                              stx FORPNT+1
 5867 A:1d5f  a0 00                              ldy #0
 5868 A:1d61                           WAITER    
 5868 A:1d61  b1 53                              lda (LINNUM),Y
 5869 A:1d63  45 89                              eor FORPNT+1
 5870 A:1d65  25 88                              and FORPNT
 5871 A:1d67  f0 f8                              beq WAITER
 5872 A:1d69                           ZERRTS    
 5872 A:1d69  60                                 rts                    ;GOT A NONZERO.

 5874 A:1d6a                                    ; SUBTTL FLOATING POINT MATH PACKAGE CONFIGURATION.

 5876 A:1d6a                                    ; RADIX 8 ;!!!! ALERT !!!!
 5877 A:1d6a                                    ;THROUGHOUT THE MATH PACKAGE.
 5878 A:1d6a                                    ; COMMENT %
 5879 A:1d6a                                    ; THE FLOATING POINT FORMAT IS AS FOLLOWS:
 5880 A:1d6a                                    ;
 5881 A:1d6a                                    ; THE SIGN IS THE FIRST BIT OF THE MANTISSA.
 5882 A:1d6a                                    ; THE MANTISSA IS 24 BITS LONG.
 5883 A:1d6a                                    ; THE BINARY POINT IS TO THE LEFT OF THE MSB.
 5884 A:1d6a                                    ; NUMBER = MANTISSA * 2 ^ EXPONENT.
 5885 A:1d6a                                    ; THE MANTISSA IS POSITIVE WITH A ONE ASSUMED TO BE WHERE THE SIGN BIT IS.
 5886 A:1d6a                                    ; THE SIGN OF THE EXPONENT IS THE FIRST BIT OF THE EXPONENT.
 5887 A:1d6a                                    ; THE EXPONENT IS STORED IN EXCESS 200, I.E. WITH A BIAS OF +200.
 5888 A:1d6a                                    ; SO, THE EXPONENT IS A SIGNED 8-BIT NUMBER WITH 200 ADDED TO IT.
 5889 A:1d6a                                    ; AN EXPONENT OF ZERO MEANS THE NUMBER IS ZERO.
 5890 A:1d6a                                    ; THE OTHER BYTES MAY NOT BE ASSUMED TO BE ZERO.
 5891 A:1d6a                                    ; TO KEEP THE SAME NUMBER IN THE FAC WHILE SHIFTING,
 5892 A:1d6a                                    ;  TO SHIFT RIGHT, EXP:=EXP+1
 5893 A:1d6a                                    ;  TO SHIFT LEFT, EXP:=EXP-1
 5894 A:1d6a                                    ;
 5895 A:1d6a                                    ; IN MEMORY THE NUMBER LOOKS LIKE THIS:
 5896 A:1d6a                                    ;  [THE EXPONENT AS A SIGNED NUMBER +200]
 5897 A:1d6a                                    ;  [THE SIGN BIT IN 7, BITS 2-8 OF MANTISSA ARE IN BITS 6-0].
 5898 A:1d6a                                    ;   (REMEMBER BIT 1 OF MANTISSA IS ALWAYS A ONE.)
 5899 A:1d6a                                    ;  [BITS 9-16 OF THE MANTISSA]
 5900 A:1d6a                                    ;  [BITS 17-24] OF THE MANTISSA]
 5901 A:1d6a                                    ;
 5902 A:1d6a                                    ; ARITHMETIC ROUTINE CALLING CONVENTIONS:
 5903 A:1d6a                                    ;
 5904 A:1d6a                                    ; FOR ONE ARGUMENT FUNCTIONS:
 5905 A:1d6a                                    ;  THE ARGUMENT IS IN THE FAC.
 5906 A:1d6a                                    ;  THE RESULT IS LEFT IN THE FAC.
 5907 A:1d6a                                    ; FOR TWO ARGUMENT OPERATIONS:
 5908 A:1d6a                                    ;  THE FIRST ARGUMENT IS IN ARG (ARGEXP,HO,MO,LO AND ARGSGN).
 5909 A:1d6a                                    ;  THE SECOND ARGUMENT IS IN THE FAC.
 5910 A:1d6a                                    ;  THE RESULT IS LEFT IN THE FAC.
 5911 A:1d6a                                    ;
 5912 A:1d6a                                    ; THE "T" ENTRY POINTS TO THE TWO-ARGUMENT OPERATIONS HAVE BOTH ARGUMENTS
 5913 A:1d6a                                    ; SETUP IN THE RESPECTIVE REGISTERS. BEFORE CALLING ARG MAY HAVE BEEN
 5914 A:1d6a                                    ; POPPED OFF THE STACK AND INTO ARG, FOR EXAMPLE.
 5915 A:1d6a                                    ; THE OTHER ENTRY POINT ASSUMES [Y,A] POINTS TO THE ARGUMENT
 5916 A:1d6a                                    ; SOMEWHERE IN MEMORY. IT IS UNPACKED INTO ARG BY "CONUPK".
 5917 A:1d6a                                    ;
 5918 A:1d6a                                    ; ON THE STACK, THE SGN IS PUSHED ON FIRST, THE LO,MO,HO AND FINALLY EXP.
 5919 A:1d6a                                    ; NOTE ALL THINGS ARE KEPT UNPACKED IN ARG, FAC AND ON THE STACK.
 5920 A:1d6a                                    ;
 5921 A:1d6a                                    ; IT IS ONLY WHEN SOMETHING IS STORED AWAY THAT IT IS PACKED TO FOUR
 5922 A:1d6a                                    ; BYTES. THE UNPACKED FORMAT HAS A SGN BYTE REFLECTING THE SIGN OF THE
 5923 A:1d6a                                    ; NUMBER (POSITIVE=0, NEGATIVE=-1) A HO,MO AND LO WITH THE HIGH BIT
 5924 A:1d6a                                    ; OF THE HO TURNED ON. THE EXP IS THE SAME AS STORED FORMAT.
 5925 A:1d6a                                    ; THIS IS DONE FOR SPEED OF OPERATION.
 5926 A:1d6a                                    ; %
 5927 A:1d6a                                    ; PAGE
 5928 A:1d6a                                    ; SUBTTL FLOATING POINT ADDITION AND SUBTRACTION.
 5929 A:1d6a                           FADDH     
 5929 A:1d6a                                    ;ENTRY TO ADD 1/2.
 5930 A:1d6a  a9 30                              lda #FHALF&255
 5931 A:1d6c  a0 24                              ldy #FHALF/256
 5932 A:1d6e  4c 88 1d                           jmp FADD                ;UNPACK AND GO ADD IT.
 5933 A:1d71                           FSUB      
 5933 A:1d71  20 ad 1f                           jsr CONUPK                ;UNPACK ARGUMENT INTO ARG.
