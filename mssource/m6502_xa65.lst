 2486 A:d604  d0 f5                              bne PRIT3                ;END OF ENTRY? NO, TYPE REST.
 2487 A:d606                                    ; PAGE
 2488 A:d606                                    ; SUBTTL THE "FOR" STATEMENT.
 2489 A:d606                                    ;
 2490 A:d606                                    ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2491 A:d606                                    ;
 2492 A:d606                                    ; LOW ADDRESS
 2493 A:d606                                    ; TOKEN (FORTK) 1 BYTE
 2494 A:d606                                    ; A POINTER TO THE LOOP VARIABLE 2 BYTES
 2495 A:d606                                    ; THE STEP 4+ADDPRC BYTES
 2496 A:d606                                    ; A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 2497 A:d606                                    ; THE UPPER VALUE 4+ADDPRC BYTES
 2498 A:d606                                    ; THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 2499 A:d606                                    ; A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 2500 A:d606                                    ; HIGH ADDRESS
 2501 A:d606                                    ;
 2502 A:d606                                    ; TOTAL 16+2*ADDPRC BYTES.
 2503 A:d606                                    ;

 2505 A:d606                           FOR       
 2505 A:d606  a9 80                              lda #128             ;DON'T RECOGNIZE
 2506 A:d608  85 14                              sta SUBFLG                ;SUBSCRIPTED VARIABLES.
 2507 A:d60a  20 d0 d8                           jsr LET                ;READ THE VARIABLE AND ASSIGN IT
 2508 A:d60d                                    ;THE CORRECT INITIAL VALUE AND STORE
 2509 A:d60d                                    ;A POINTER TO THE VARIABLE IN VARPNT.
 2510 A:d60d  20 70 d2                           jsr FNDFOR                ;PNTR IS IN VARPNT, AND FORPNT.
 2511 A:d610  d0 07                              bne NOTOL                ;IF NO MATCH, DON'T ELIMINATE ANYTHING.
 2512 A:d612  8a                                 txa                    ;MAKE IT ARITHMETICAL.
 2513 A:d613  69 0f                              adc #18-3       ;ELIMINATE ALMOST ALL.
 2514 A:d615  aa                                 tax                    ;NOTE C=1, THEN PLA, PLA.
 2515 A:d616  9a                                 txs                    ;MANIFEST.
 2516 A:d617                           NOTOL     
 2516 A:d617  68                                 pla                    ;GET RID OF NEWSTT RETURN ADDRESS
 2517 A:d618  68                                 pla                    ;IN CASE THIS IS A TOTALLY NEW ENTRY.
 2518 A:d619  a9 09                              lda #8+1
 2519 A:d61b  20 e1 d2                           jsr GETSTK                ;MAKE SURE 16 BYTES ARE AVAILABLE.
 2520 A:d61e  20 2e d8                           jsr DATAN                ;GET A COUNT IN [Y] OF THE NUMBER OF
 2521 A:d621                                    ;CHACRACTERS LEFT IN THE "FOR" STATEMENT
 2522 A:d621                                    ;[TXTPTR] IS UNAFFECTED.
 2523 A:d621  18                                 clc                    ;PREP TO ADD.
 2524 A:d622  98                                 tya                    ;SAVE IT FOR PUSHING.
 2525 A:d623  65 b9                              adc CHRGOT+1
 2526 A:d625  48                                 pha 
 2527 A:d626  a5 ba                              lda CHRGOT+1+1
 2528 A:d628  69 00                              adc #0
 2529 A:d62a  48                                 pha 
 2530 A:d62b                                    ;PUT LINE NUMBER ON STACK.
 2531 A:d62b  a5 79                              lda CURLIN+1
 2532 A:d62d  48                                 pha 
 2533 A:d62e  a5 78                              lda CURLIN
 2534 A:d630  48                                 pha 
 2535 A:d631                                    ;"TO" IS NECESSARY.
 2536 A:d631  a9 80                              lda #128
 2537 A:d633  20 76 dd                           jsr SYNCHR
 2538 A:d636  20 11 dc                           jsr CHKNUM                ;VALUE MUST BE A NUMBER.
 2539 A:d639  20 0e dc                           jsr FRMNUM                ;GET UPPER VALUE INTO FAC.
 2540 A:d63c  a5 a5                              lda FACSGN                ;PACK FAC.
 2541 A:d63e  09 7f                              ora #127
 2542 A:d640  25 a1                              and FACHO
 2543 A:d642  85 a1                              sta FACHO                ;SET PACKED SIGN BIT.

 2545 A:d644  a9 4f                              lda #LDFONE&255
 2546 A:d646  a0 d6                              ldy #LDFONE/256

 2548 A:d648  85 61                              sta INDEX1
 2549 A:d64a  84 62                              sty INDEX1+1
 2550 A:d64c  4c cd dc                           jmp FORPSH                ;PUT FAC ONTO STACK, PACKED.
 2551 A:d64f                           LDFONE    
 2551 A:d64f                                    ;PUT 1.0 INTO FAC.
 2552 A:d64f  a9 b8                              lda #FONE&255
 2553 A:d651  a0 e7                              ldy #FONE/256
 2554 A:d653  20 a1 e9                           jsr MOVFM
 2555 A:d656  20 b8 00                           jsr CHRGOT
 2556 A:d659  c9 81                              cmp #129             ;A STEP IS GIVEN?
 2557 A:d65b  d0 08                              bne ONEON                ;NO. ASSUME 1.0.
 2558 A:d65d  20 b2 00                           jsr CHRGET                ;YES. ADVANCE POINTER.
 2559 A:d660  20 0e dc                           jsr FRMNUM                ;READ THE STEP.
 2560 A:d663                           ONEON     
 2560 A:d663  20 2d ea                           jsr SIGN                ;GET SIGN IN ACCA.
 2561 A:d666  20 c2 dc                           jsr PUSHF                ;PUSH FAC ONTO STACK (THRU A).
 2562 A:d669                                    ;PUT PNTR TO VARIABLE ON STACK.
 2563 A:d669  a5 89                              lda FORPNT+1
 2564 A:d66b  48                                 pha 
 2565 A:d66c  a5 88                              lda FORPNT
 2566 A:d66e  48                                 pha 
 2567 A:d66f                           NXTCON    
 2567 A:d66f  a9 7f                              lda #127             ;PUT A FORTK ONTO STACK.
 2568 A:d671  48                                 pha 
 2569 A:d672                                    ; BNEA NEWSTT  ;SIMULATE BNE TO NEWSTT. JUST FALL IN.
 2570 A:d672                                    ; PAGE
 2571 A:d672                                    ; SUBTTL NEW STATEMENT FETCHER.
 2572 A:d672                                    ;
 2573 A:d672                                    ; BACK HERE FOR NEW STATEMENT. CHARACTER POINTED TO BY TXTPTR
 2574 A:d672                                    ; IS ":" OR END-OF-LINE. THE ADDRESS OF THIS LOC IS LEFT
 2575 A:d672                                    ; ON THE STACK WHEN A STATEMENT IS EXECUTED SO THAT
 2576 A:d672                                    ; IT CAN MERELY DO A RTS WHEN IT IS DONE.
 2577 A:d672                                    ;
 2578 A:d672                           NEWSTT    
 2578 A:d672                                    

 2580 A:d672  20 e1 ff                           jsr 65505              ;LISTEN FOR CONTROL-C.

 2582 A:d675                                    ;LOOK AT CURRENT CHARACTER.
 2583 A:d675  a5 b9                              lda CHRGOT+1
 2584 A:d677  a4 ba                              ldy CHRGOT+1+1

 2587 A:d679  c0 02                              cpy #2

 2589 A:d67b  f0 06                              beq DIRCON
 2590 A:d67d                                    ;SAVE IN CASE OF RESTART BY INPUT.
 2591 A:d67d  85 7c                              sta OLDTXT
 2592 A:d67f  84 7d                              sty OLDTXT+1

 2594 A:d681                           DIRCON    
 2594 A:d681                                    

 2596 A:d681  a0 00                              ldy #0

 2600 A:d683  b1 b9                              lda (CHRGOT+1),Y
 2601 A:d685  d0 42                              bne MORSTS                ;NOT NULL -- CHECK WHAT IT IS
 2602 A:d687  a0 02                              ldy #2             ;LOOK AT LINK.
 2603 A:d689  b1 b9                              lda (CHRGOT+1),Y      ;IS LINK 0?
 2604 A:d68b  18                                 clc                    ;CLEAR CARRY FOR ENDCON AND MATH THAT FOLLOWS
 2605 A:d68c                                    ;YES - RAN OFF THE END.
 2606 A:d68c  d0 03                              bne *+5
 2607 A:d68e  4c 15 d7                           jmp ENDCON
 2608 A:d691  c8                                 iny                    ;PUT LINE NUMBER IN CURLIN.
 2609 A:d692  b1 b9                              lda (CHRGOT+1),Y
 2610 A:d694  85 78                              sta CURLIN
 2611 A:d696  c8                                 iny 
 2612 A:d697  b1 b9                              lda (CHRGOT+1),Y
 2613 A:d699  85 79                              sta CURLIN+1
 2614 A:d69b  98                                 tya 
 2615 A:d69c  65 b9                              adc CHRGOT+1
 2616 A:d69e  85 b9                              sta CHRGOT+1
 2617 A:d6a0  90 04                              bcc GONE
 2618 A:d6a2  e6 ba                              inc CHRGOT+1+1
 2619 A:d6a4                           GONE      
 2619 A:d6a4  20 b2 00                           jsr CHRGET                ;GET THE STATEMENT TYPE.
 2620 A:d6a7  20 ad d6                           jsr GONE3
 2621 A:d6aa  4c 72 d6                           jmp NEWSTT
 2622 A:d6ad                           GONE3     
 2622 A:d6ad  f0 3e                              beq ISCRTS                ;IF TERMINATOR, TRY AGAIN.
 2623 A:d6af                                    ;NO NEED TO SET UP CARRY SINCE IT WILL
 2624 A:d6af                                    ;BE ON IF NON-NUMERIC AND NUMERICS
 2625 A:d6af                                    ;WILL CAUSE A SYNTAX ERROR LIKE THEY SHOULD
 2626 A:d6af                           GONE2     
 2626 A:d6af  e9 7f                              sbc #127             ;" ON ... GOTO AND GOSUB" COME HERE.
 2627 A:d6b1  90 13                              bcc GLET
 2628 A:d6b3  c9 01                              cmp #127-127+1
 2629 A:d6b5  b0 19                              bcs SNERRX                ;SOME RES'D WORD BUT NOT
 2630 A:d6b7                                    ;A STATEMENT RES'D WORD.
 2631 A:d6b7  0a                                 asl                    ;MULTIPLY BY TWO.
 2632 A:d6b8  a8                                 tay                    ;MAKE AN INDEX.
 2633 A:d6b9  b9 01 d0                           lda STMDSP+1,Y
 2634 A:d6bc  48                                 pha 
 2635 A:d6bd  b9 00 d0                           lda STMDSP,Y
 2636 A:d6c0  48                                 pha                    ;PUT DISP ADDR ONTO STACK.
 2637 A:d6c1  4c b2 00                           jmp CHRGET
 2638 A:d6c4                           GLET      
 2638 A:d6c4  4c d0 d8                           jmp LET                ;MUST BE A LET
 2639 A:d6c7                           MORSTS    
 2639 A:d6c7  c9 3a                              cmp #":"
 2640 A:d6c9  f0 d9                              beq GONE                ;IF A ":" CONTINUE STATEMENT
 2641 A:d6cb                           SNERR1    
 2641 A:d6cb  4c 7f dd                           jmp SNERR                ;NEITHER 0 OR ":" SO SYNTAX ERROR
 2642 A:d6ce                           SNERRX    
 2642 A:d6ce  c9 04                              cmp #131-127
 2643 A:d6d0  d0 f9                              bne SNERR1
 2644 A:d6d2  20 b2 00                           jsr CHRGET                ;READ IN THE CHARACTER AFTER "GO "

 2646 A:d6d5  a9 80                              lda #128
 2647 A:d6d7  20 76 dd                           jsr SYNCHR
 2648 A:d6da  4c ca d7                           jmp GOTO
 2649 A:d6dd                                    ; PAGE
 2650 A:d6dd                                    ; SUBTTL RESTORE,STOP,END,CONTINUE,NULL,CLEAR.

 2652 A:d6dd                           RESTOR    
 2652 A:d6dd  38                                 sec 
 2653 A:d6de  a5 6a                              lda TXTTAB
 2654 A:d6e0  e9 01                              sbc #1
 2655 A:d6e2  a4 6b                              ldy TXTTAB+1
 2656 A:d6e4  b0 03                              bcs RESFIN
 2657 A:d6e6  88                                 dey 
 2658 A:d6e7                           RESFIN    
 2658 A:d6e7                                    ;READ FINISHES COME TO "RESFIN".
 2659 A:d6e7  85 80                              sta DATPTR
 2660 A:d6e9  84 81                              sty DATPTR+1
 2661 A:d6eb                           ISCRTS    
 2661 A:d6eb  60                                 rts 

 2687 A:d6ec                                    
 2687 A:d6ec  ad 00 c0                           lda 49152
 2688 A:d6ef  c9 83                              cmp #131
 2689 A:d6f1  f0 03                              beq ISCCAP
 2690 A:d6f3  60                                 rts 
 2691 A:d6f4                           ISCCAP    
 2691 A:d6f4  20 51 d4                           jsr INCHR
 2692 A:d6f7  c9 83                              cmp #131

 2694 A:d6f9                           STOP      
 2694 A:d6f9  b0 03                              bcs STOPC                ;MAKE [C] NONZERO AS A FLAG.
 2695 A:d6fb                           END       
 2695 A:d6fb  18                                 clc 
 2696 A:d6fc                           STOPC     
 2696 A:d6fc  d0 42                              bne CONTRT                ;RETURN IF NOT CONT-C OR
 2697 A:d6fe                                    ;IF NO TERMINATOR FOR STOP OR END.
 2698 A:d6fe                                    ;[C]=0 SO WILL NOT PRINT "BREAK".

 2700 A:d6fe  a5 b9                              lda CHRGOT+1
 2701 A:d700  a4 ba                              ldy CHRGOT+1+1

 2704 A:d702  a6 79                              ldx CURLIN+1
 2705 A:d704  e8                                 inx 

 2707 A:d705  f0 0e                              beq DIRIS

 2709 A:d707  85 7c                              sta OLDTXT
 2710 A:d709  84 7d                              sty OLDTXT+1
 2711 A:d70b                           STPEND    
 2711 A:d70b                                    
 2712 A:d70b  a5 78                              lda CURLIN
 2713 A:d70d  a4 79                              ldy CURLIN+1

 2715 A:d70f  85 7a                              sta OLDLIN
 2716 A:d711  84 7b                              sty OLDLIN+1
 2717 A:d713                           DIRIS     
 2717 A:d713  68                                 pla                    ;POP OFF NEWSTT ADDR.
 2718 A:d714  68                                 pla 
 2719 A:d715                           ENDCON    
 2719 A:d715                                    
 2720 A:d715  a9 68                              lda #BRKTXT&255
 2721 A:d717  a0 d2                              ldy #BRKTXT/256

 2724 A:d719  a2 00                              ldx #0
 2725 A:d71b  86 17                              stx CNTWFL

 2727 A:d71d  90 05                              bcc GORDY                ;CARRY CLEAR SO DON'T PRINT "BREAK".
 2728 A:d71f  4c 39 d3                           jmp ERRFIN
 2729 A:d722                           GORDY     
 2729 A:d722  4c 44 d3                           jmp READY                ;TYPE "READY".

 2738 A:d725                           CONT      
 2738 A:d725  d0 19                              bne CONTRT                ;MAKE SURE THERE IS A TERMINATOR.
 2739 A:d727  a2 db                              ldx #219             ;CONTINUE ERROR.
 2740 A:d729  a4 7d                              ldy OLDTXT+1          ;A STORED TXTPTR OF ZERO IS SETUP
 2741 A:d72b                                    ;BY STKINI AND INDICATES THERE IS
 2742 A:d72b                                    ;NOTHING TO CONTINUE.
 2743 A:d72b                                    ;"STOP", "END", TYPING CRLF TO 
 2744 A:d72b  d0 03                              bne *+5
 2745 A:d72d  4c 1d d3                           jmp ERROR
 2746 A:d730                                    ;"INPUT" AND  ^C SETUP OLDTXT.
 2747 A:d730  a5 7c                              lda OLDTXT

 2749 A:d732  85 b9                              sta CHRGOT+1
 2750 A:d734  84 ba                              sty CHRGOT+1+1

 2752 A:d736  a5 7a                              lda OLDLIN
 2753 A:d738  a4 7b                              ldy OLDLIN+1

 2755 A:d73a  85 78                              sta CURLIN
 2756 A:d73c  84 79                              sty CURLIN+1
 2757 A:d73e                           CONTRT    
 2757 A:d73e  60                                 rts                    ;RETURN TO CALLER.

 2771 A:d73f                                    ; PAGE
 2772 A:d73f                                    ; SUBTTL LOAD AND SAVE SUBROUTINES.

 2850 A:d73f                           SAVE      
 2850 A:d73f  38                                 sec 
 2851 A:d740  a5 6c                              lda VARTAB
 2852 A:d742  e5 6a                              sbc TXTTAB
 2853 A:d744  85 53                              sta LINNUM
 2854 A:d746  a5 6d                              lda VARTAB+1
 2855 A:d748  e5 6b                              sbc TXTTAB+1
 2856 A:d74a  85 54                              sta LINNUM+1
 2857 A:d74c  20 82 d7                           jsr VARTIO
 2858 A:d74f  20 cd fe                           jsr 65229
 2859 A:d752  20 91 d7                           jsr PROGIO
 2860 A:d755  4c cd fe                           jmp 65229

 2862 A:d758                           LOAD      
 2862 A:d758  20 82 d7                           jsr VARTIO
 2863 A:d75b  20 fd fe                           jsr 65277
 2864 A:d75e  18                                 clc 
 2865 A:d75f  a5 6a                              lda TXTTAB
 2866 A:d761  65 53                              adc LINNUM
 2867 A:d763  85 6c                              sta VARTAB
 2868 A:d765  a5 6b                              lda TXTTAB+1
 2869 A:d767  65 54                              adc LINNUM+1
 2870 A:d769  85 6d                              sta VARTAB+1
 2871 A:d76b  20 91 d7                           jsr PROGIO
 2872 A:d76e  20 fd fe                           jsr 65277

 2874 A:d771  a9 7b                              lda #TPDONE&255
 2875 A:d773  a0 d7                              ldy #TPDONE/256
 2876 A:d775  20 e1 d9                           jsr STROUT
 2877 A:d778  4c f4 d3                           jmp FINI

 2879 A:d77b                           TPDONE    
