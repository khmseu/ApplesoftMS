 7041 A:2318  a6 a0                              ldx FACEXP

 7043 A:231a  d0 03                              bne *+5
 7044 A:231c  4c 23 24                           jmp FOUT19
 7045 A:231f  a9 00                              lda #0
 7046 A:2321  e0 80                              cpx #128             ;IS NUMBER .LT. 1.0 ?
 7047 A:2323  f0 06                              beq FOUT37                ;NO.
 7048 A:2325  b0 0d                              bcs FOUT7
 7049 A:2327                           FOUT37    
 7049 A:2327                                    ;MULTIPLY BY 10^6.
