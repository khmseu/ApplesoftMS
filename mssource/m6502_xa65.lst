 3783 A:db34                                    ;
 3784 A:db34                                    ; SUBROUTINE TO FIND DATA
 3785 A:db34                                    ; THE SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO
 3786 A:db34                                    ; SKIP OVER STATEMENTS. THE START WORD OF EACH STATEMENT
 3787 A:db34                                    ; IS COMPARED WITH "DATATK". EACH NEW LINE NUMBER
 3788 A:db34                                    ; IS STORED IN "DATLIN" SO THAT IF AN ERROR OCCURS
 3789 A:db34                                    ; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE
 3790 A:db34                                    ; NUMBER OF THE ILL-FORMATTED DATA.
 3791 A:db34                                    ;
 3792 A:db34                           DATLOP    
 3792 A:db34  20 22 d8                           jsr DATAN                ;SKIP SOME TEXT.
 3793 A:db37  c8                                 iny 
 3794 A:db38  aa                                 tax                    ;END OF LINE?
 3795 A:db39  d0 14                              bne NOWLIN                ;SHO AIN'T.
 3796 A:db3b  a2 2a                              ldx #42             ;YES = "NO DATA" ERROR.
 3797 A:db3d  c8                                 iny 
 3798 A:db3e  b1 b9                              lda (CHRGOT+1),Y
 3799 A:db40  f0 6b                              beq ERRGO5
 3800 A:db42  c8                                 iny 
 3801 A:db43  b1 b9                              lda (CHRGOT+1),Y      ;GET HIGH BYTE OF LINE NUMBER.
 3802 A:db45  85 7e                              sta DATLIN
 3803 A:db47  c8                                 iny 
 3804 A:db48  b1 b9                              lda (CHRGOT+1),Y      ;GET LOW BYTE.
 3805 A:db4a  c8                                 iny 
 3806 A:db4b  85 7f                              sta DATLIN+1
 3807 A:db4d                           NOWLIN    
 3807 A:db4d  b1 b9                              lda (CHRGOT+1),Y      ;HOW IS IT?
 3808 A:db4f  aa                                 tax 
 3809 A:db50  20 17 d8                           jsr ADDON                ;ADD [Y] TO [TXTPTR].
 3810 A:db53  e0 7f                              cpx #127             ;IS IT A "DATA" STATEMENT.
 3811 A:db55  d0 dd                              bne DATLOP                ;NOT QUITE RIGHT. KEEP LOOKING.
 3812 A:db57  4c cd da                           jmp DATBK1                ;THIS IS THE ONE !
 3813 A:db5a                           VAREND    
 3813 A:db5a                                    ;PUT AWAY A NEW DATA PNTR MAYBE.
 3814 A:db5a  a5 82                              lda INPPTR
 3815 A:db5c  a4 83                              ldy INPPTR+1
 3816 A:db5e  a6 15                              ldx INPFLG
