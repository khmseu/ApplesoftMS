 5625 A:e4e0  e9 03                              sbc #3             ;POINT TO LAST ONE.
 5626 A:e4e2  85 56                              sta LASTPT                ;UPDATE TEMP PNTR.
 5627 A:e4e4  a0 00                              ldy #0             ;ALSO CLEARS ZFLG SO WE DO REST OF FRETMP.
 5628 A:e4e6                           FRERTS    
