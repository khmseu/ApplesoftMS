 7168 A:ecc6  f0 f8                              beq FOUT11
 7169 A:ecc8  c9 2a                              cmp #"*"
 7170 A:ecca  f0 05                              beq FOUT12                ;RUN INTO DP. STOP.
 7171 A:eccc  c8                                 iny                    ;SOMETHING ELSE. SAVE IT.
