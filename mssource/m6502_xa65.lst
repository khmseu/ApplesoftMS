 2369 A:0c86  48                                 pha 
 2370 A:0c87  a9 00                              lda #0
 2371 A:0c89  85 7d                              sta OLDTXT+1          ;DISALLOWING CONTINUING
 2372 A:0c8b  85 14                              sta SUBFLG                ;ALLOW SUBSCRIPTS.
 2373 A:0c8d                           STKRTS    
 2373 A:0c8d  60                                 rts 

 2375 A:0c8e                           STXTPT    
 2375 A:0c8e  18                                 clc 
 2376 A:0c8f  a5 6a                              lda TXTTAB
 2377 A:0c91  69 ff                              adc #255
