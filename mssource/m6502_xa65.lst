 2255 A:d4ea                                    ;ITS END WILL LOOK LIKE END OF PROGRAM.

 2258 A:d4ea  c6 ba                              dec CHRGOT+1+1

 2261 A:d4ee  85 b9                              sta CHRGOT+1          ;CRUNCHED LINE.
 2262 A:d4f0                           LISTRT    
