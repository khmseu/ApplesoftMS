  389 A:0000                                    ; SUBTTL SOME EXPLANATION.
  390 A:0000                                    ; COMMENT *
  391 A:0000                                    ;
  392 A:0000                                    ; M6502 BASIC CONFIGURES BASIC AS FOLLOWS
  393 A:0000                                    ;
  394 A:0000                                    ; LOW LOCATIONS
  395 A:0000                                    ;  PAGE ZERO
  396 A:0000                                    ;
  397 A:0000                                    ;   STARTUP:
  398 A:0000                                    ;   INITIALLY A JMP TO INITIALIZATION CODE BUT
  399 A:0000                                    ;   CHANGED TO A JMP TO "READY".
  400 A:0000                                    ;   RESTARTING THE MACHINE AT LOC 0 DURING PROGRAM
  401 A:0000                                    ;   EXECUTION CAN LEAVE THINGS MESSED UP.
  402 A:0000                                    ;
  403 A:0000                                    ;   LOC OF FAC TO INTEGER AND INTEGER TO FAC 
  404 A:0000                                    ;   ROUTINES.
  405 A:0000                                    ;
  406 A:0000                                    ;   "DIRECT" MEMORY:
  407 A:0000                                    ;   THESE ARE THE MOST COMMONLY USED LOCATIONS.
  408 A:0000                                    ;   THEY HOLD BOOKKEEPING INFO AND ALL OTHER
  409 A:0000                                    ;   FREQUENTLY USED INFORMATION.
  410 A:0000                                    ;   ALL TEMPORARIES, FLAGS, POINTERS, THE BUFFER AREA,
  411 A:0000                                    ;   THE FLOATING ACCUMULATOR, AND ANYTHING ELSE THAT
  412 A:0000                                    ;   IS USED TO STORE A CHANGING VALUE SHOULD BE LOCATED
  413 A:0000                                    ;   IN THIS AREA. CARE MUST BE MADE IN MOVING LOCATIONS
  414 A:0000                                    ;   IN THIS AREA SINCE THE JUXTAPOSITION OF TWO LOCATIONS
  415 A:0000                                    ;   IS OFTEN DEPENDED UPON.
  416 A:0000                                    ;
  417 A:0000                                    ;   STILL IN RAM WE HAVE THE BEGINNING OF THE "CHRGET"
  418 A:0000                                    ;   SUBROUTINE. IT IS HERE SO [TXTPTR] CAN BE THE
  419 A:0000                                    ;   EXTENDED ADDRESS OF A LOAD INSTRUCTION.
  420 A:0000                                    ;   THIS SAVES HAVING TO BOTHER ANY REGISTERS.
  421 A:0000                                    ;
  422 A:0000                                    ;  PAGE ONE
  423 A:0000                                    ;   THE STACK.
  424 A:0000                                    ;
  425 A:0000                                    ;  STORAGE PAGE TWO AND ON
  426 A:0000                                    ;   IN RAM VERSIONS THESE DATA STRUCTURES COME AT THE
  427 A:0000                                    ;   END OF BASIC. IN ROM VERSON THEY ARE AT RAMLOC WHICH
  428 A:0000                                    ;   CAN EITHER BE ABOVE OR BELOW ROMLOC, WHICH IS WHERE
  429 A:0000                                    ;   BASIC ITSELF RESIDES.
  430 A:0000                                    ;
  431 A:0000                                    ;     A ZERO.
  432 A:0000                                    ;   [TXTTAB] POINTER TO NEXT LINE'S POINTER.
  433 A:0000                                    ;     LINE # OF THIS LINE (2 BYTES).
  434 A:0000                                    ;     CHARACTERS ON THIS LINE.
  435 A:0000                                    ;     ZERO.
  436 A:0000                                    ;     POINTER AT NEXT LINE'S POINTER
  437 A:0000                                    ;      (POINTED TO BY THE ABOVE POINTER).
  438 A:0000                                    ;     ... REPEATS ...
  439 A:0000                                    ;   LAST LINE: POINTER AT ZERO POINTER.
  440 A:0000                                    ;     LINE # OF THIS LINE.
  441 A:0000                                    ;     CHARACTERS ON THIS LINE.
  442 A:0000                                    ;     ZERO.
  443 A:0000                                    ;     DOUBLE ZERO (POINTED TO BY THE ABOVE POINTER).
  444 A:0000                                    ;   [VARTAB] SIMPLE VARIABLES. 6 BYTES PER VALUE.
  445 A:0000                                    ;     2 BYTES GIVE THE NAME, 4 BYTES THE VALUE.
  446 A:0000                                    ;     ... REPEATS ...
  447 A:0000                                    ;   [ARYTAB] ARRAY VARIABLES. 2 BYTES NAME, 2 BYTE
  448 A:0000                                    ;     LENGTH, NUMBER OF DIMENSIONS , EXTENT OF
  449 A:0000                                    ;     EACH DIMENSION (2BYTES/), VALUES
  450 A:0000                                    ;     ... REPEATS ...
  451 A:0000                                    ;   [STREND] FREE SPACE.
  452 A:0000                                    ;     ... REPEATS ...
  453 A:0000                                    ;   [FRETOP] STRING SPACE IN USE.
  454 A:0000                                    ;     ... REPEATS ...
  455 A:0000                                    ;   [MEMSIZ] HIGHEST MACHINE LOCATION.
  456 A:0000                                    ;     UNUSED EXCEPT BY THE VAL FUNCTION.
  457 A:0000                                    ;
  458 A:0000                                    ;   ROM -- CONSTANTS AND CODE.
  459 A:0000                                    ;
  460 A:0000                                    ;  FUNCTION DISPATCH ADDRESSES (AT ROMLOC)
  461 A:0000                                    ;   "FUNDSP" CONTAINS THE ADDRESSES OF THE
  462 A:0000                                    ;   FUNCTION ROUTINES IN THE ORDER OF THE
  463 A:0000                                    ;   FUNCTION NAMES IN THE CRUNCH LIST.
  464 A:0000                                    ;   THE FUNCTIONS THAT TAKE MORE THAN ONE ARGUMENT
  465 A:0000                                    ;   ARE AT THE END. SEE THE EXPLANATION AT "ISFUN".
  466 A:0000                                    ;
  467 A:0000                                    ;  THE OPERATOR LIST
  468 A:0000                                    ;   THE "OPTAB" LIST CONTAINS AN OPERATOR'S PRECEDENCE
  469 A:0000                                    ;   FOLLOWED BY THE ADDRESS OF THE ROUTINE TO PERFORM
  470 A:0000                                    ;   THE OPERATION. THE INDEX INTO THE
  471 A:0000                                    ;   OPERATOR LIST IS MADE BY SUBTRACTING OFF THE CRUNCH VALUE
  472 A:0000                                    ;   OF THE LOWEST NUMBERED OPERATOR. THE ORDER
  473 A:0000                                    ;   OF OPERATORS IN THE CRUNCH LIST AND IN "OPTAB" IS IDENTICAL.
  474 A:0000                                    ;   THE PRECEDENCES ARE ARBITRARY EXCEPT FOR THEIR
  475 A:0000                                    ;   COMPARATIVE SIZES. NOTE THAT THE PRECEDENCE FOR
  476 A:0000                                    ;   UNARY OPERATORS SUCH AS "NOT" AND NEGATION ARE
  477 A:0000                                    ;   SETUP SPECIALLY WITHOUT USING THE LIST.
  478 A:0000                                    ;
  479 A:0000                                    ;  THE RESERVED WORD OR CRUNCH LIST
  480 A:0000                                    ;   WHEN A COMMAND OR PROGRAM LINE IS TYPED IN
  481 A:0000                                    ;   IT IS STORED IN "BUF". AS SOON AS THE WHOLE LINE
  482 A:0000                                    ;   HAS BEEN TYPED IN ("INLIN" RETURNS) "CRUNCH" IS
  483 A:0000                                    ;   CALLED TO CONVERT ALL RESERVED WORDS TO THEIR
  484 A:0000                                    ;   CRUNCHED VALUES. THIS REDUCES THE SIZE OF THE 
  485 A:0000                                    ;   PROGRAM AND SPEEDS UP EXECUTION BY ALLOWING
  486 A:0000                                    ;   LIST DISPATCHES TO PERFORM FUNCTIONS, STATEMENTS,
  487 A:0000                                    ;   AND OPERATIONS. THIS IS BECAUSE ALL THE STATEMENT
  488 A:0000                                    ;   NAMES ARE STORED CONSECUTIVELY IN THE CRUNCH LIST.
  489 A:0000                                    ;   WHEN A MATCH IS FOUND BETWEEN A STRING
  490 A:0000                                    ;   OF CHARACTERS AND A WORD IN THE CRUNCH LIST
  491 A:0000                                    ;   THE ENTIRE TEXT OF THE MATCHED WORD IS TAKEN OUT OF
  492 A:0000                                    ;   THE INPUT LINE AND A RESERVED WORD TOKEN IS PUT
  493 A:0000                                    ;   IN ITS PLACE. A RESERVED WORD TOKEN IS ALWAYS EQUAL
  494 A:0000                                    ;   TO OCTAL 200 PLUS THE POSITION OF THE MATCHED WORD
  495 A:0000                                    ;   IN THE CRUNCH LIST.
  496 A:0000                                    ;
  497 A:0000                                    ;  STATEMENT DISPATCH ADDRESSES
  498 A:0000                                    ;   WHEN A STATEMENT IS TO BE EXECUTED, THE FIRST
  499 A:0000                                    ;   CHARACTER OF THE STATEMENT IS EXAMINED
  500 A:0000                                    ;   TO SEE IF IT IS LESS THAN THE RESERVED
  501 A:0000                                    ;   WORD TOKEN FOR THE LOWEST NUMBERED STATEMENT NAME.
  502 A:0000                                    ;   IF SO, THE "LET" CODE IS CALLED TO
  503 A:0000                                    ;   TREAT THE STATEMENT AS AN ASSIGNMENT STATEMENT.
  504 A:0000                                    ;   OTHERWISE A CHECK IS MADE TO MAKE SURE THE
  505 A:0000                                    ;   RESERVED WORD NUMBER IS NOT TOO LARGE TO BE A
  506 A:0000                                    ;   STATEMENT TYPE NUMBER. IF NOT THE ADDRESS
  507 A:0000                                    ;   TO DISPATCH TO IS FETCHED FROM "STMDSP" (THE STATEMENT
  508 A:0000                                    ;   DISPATCH LIST) USING THE RESERVED WORD
  509 A:0000                                    ;   NUMBER FOR THE STATEMENT TO CALCULATE AN INDEX INTO
  510 A:0000                                    ;   THE LIST.
  511 A:0000                                    ;
  512 A:0000                                    ;  ERROR MESSAGES
  513 A:0000                                    ;   WHEN AN ERROR CONDITION IS DETECTED,
  514 A:0000                                    ;   [ACCX] MUST BE SET UP TO INDICATE WHICH ERROR
  515 A:0000                                    ;   MESSAGE IS APPROPRIATE AND A BRANCH MUST BE MADE
  516 A:0000                                    ;   TO "ERROR". THE STACK WILL BE RESET AND ALL
  517 A:0000                                    ;   PROGRAM CONTEXT WILL BE LOST. VARIABLES
  518 A:0000                                    ;   VALUES AND THE ACTUAL PROGRAM REMAIN INTACT.
  519 A:0000                                    ;   ONLY THE VALUE OF [ACCX] IS IMPORTANT WHEN
  520 A:0000                                    ;   THE BRANCH IS MADE TO ERROR. [ACCX] IS USED AS AN
  521 A:0000                                    ;   INDEX INTO "ERRTAB" WHICH GIVES THE TWO
  522 A:0000                                    ;   CHARACTER ERROR MESSAGE THAT WILL BE PRINTED ON THE
  523 A:0000                                    ;   USER'S TERMINAL.
  524 A:0000                                    ;
  525 A:0000                                    ;
  526 A:0000                                    ;  TEXTUAL MESSAGES
  527 A:0000                                    ;   CONSTANT MESSAGES ARE STORED HERE. UNLESS
  528 A:0000                                    ;   THE CODE TO CHECK IF A STRING MUST BE COPIED
  529 A:0000                                    ;   IS CHANGED THESE STRINGS MUST BE STORED ABOVE
  530 A:0000                                    ;   PAGE ZERO, OR ELSE THEY WILL BE COPIED BEFORE
  531 A:0000                                    ;   THEY ARE PRINTED.
  532 A:0000                                    ;
  533 A:0000                                    ;  FNDFOR 
  534 A:0000                                    ;   MOST SMALL ROUTINES ARE FAIRLY SIMPLE
  535 A:0000                                    ;   AND ARE DOCUMENTED IN PLACE. "FNDFOR" IS
  536 A:0000                                    ;   USED FOR FINDING "FOR" ENTRIES ON
  537 A:0000                                    ;   THE STACK. WHENEVER A "FOR" IS EXECUTED, A
  538 A:0000                                    ;   16-BYTE ENTRY IS PUSHED ONTO THE STACK.
  539 A:0000                                    ;   BEFORE THIS IS DONE, HOWEVER, A CHECK
  540 A:0000                                    ;   MUST BE MADE TO SEE IF THERE
  541 A:0000                                    ;   ARE ANY "FOR" ENTRIES ALREADY ON THE STACK
  542 A:0000                                    ;   FOR THE SAME LOOP VARIABLE. IF SO, THAT "FOR" ENTRY
  543 A:0000                                    ;   AND ALL OTHER "FOR" ENTRIES THAT WERE MADE AFTER IT
  544 A:0000                                    ;   ARE ELIMINATED FROM THE STACK. THIS IS SO A
  545 A:0000                                    ;   PROGRAM THAT JUMPS OUT OF THE MIDDLE
  546 A:0000                                    ;   OF A "FOR" LOOP AND THEN RESTARTS THE LOOP AGAIN
  547 A:0000                                    ;   AND AGAIN WON'T USE UP 18 BYTES OF STACK
  548 A:0000                                    ;   SPACE EVERY TIME. THE "NEXT" CODE ALSO
  549 A:0000                                    ;   CALLS "FNDFOR" TO SEARCH FOR A "FOR" ENTRY WITH
  550 A:0000                                    ;   THE LOOP VARIABLE IN
  551 A:0000                                    ;   THE "NEXT". AT WHATEVER POINT A MATCH IS FOUND
  552 A:0000                                    ;   THE STACK IS RESET. IF NO MATCH IS FOUND A
  553 A:0000                                    ;   "NEXT WITHOUT FOR"  ERROR OCCURS. GOSUB EXECUTION
  554 A:0000                                    ;   ALSO PUTS A 5-BYTE ENTRY ON STACK.
  555 A:0000                                    ;   WHEN A RETURN IS EXECUTED "FNDFOR" IS
  556 A:0000                                    ;   CALLED WITH A VARIABLE POINTER THAT CAN'T
  557 A:0000                                    ;   BE MATCHED. WHEN "FNDFOR" HAS RUN
  558 A:0000                                    ;   THROUGH ALL THE "FOR" ENTRIES ON THE STACK  
  559 A:0000                                    ;   IT RETURNS AND THE RETURN CODE MAKES
  560 A:0000                                    ;   SURE THE ENTRY THAT WAS STOPPED
  561 A:0000                                    ;   ON IS A GOSUB ENTRY. THIS ASSURES THAT
  562 A:0000                                    ;   IF YOU GOSUB TO A SECTION OF CODE
  563 A:0000                                    ;   IN WHICH A FOR LOOP IS ENTERED BUT NEVER
  564 A:0000                                    ;   EXITED THE RETURN WILL STILL BE
  565 A:0000                                    ;   ABLE TO FIND THE MOST RECENT
  566 A:0000                                    ;   GOSUB ENTRY. THE "RETURN" CODE ELIMINATES THE
  567 A:0000                                    ;   "GOSUB" ENTRY AND ALL "FOR" ENTRIES MADE AFTER
  568 A:0000                                    ;   THE GOSUB ENTRY.
  569 A:0000                                    ;
  570 A:0000                                    ;  NON-RUNTIME STUFF
  571 A:0000                                    ;   THE CODE TO INPUT A LINE, CRUNCH IT, GIVE ERRORS,
  572 A:0000                                    ;   FIND A SPECIFIC LINE IN THE PROGRAM,
  573 A:0000                                    ;   PERFORM A "NEW", "CLEAR", AND "LIST" ARE
  574 A:0000                                    ;   ALL IN THIS AREA. GIVEN THE EXPLANATION OF
  575 A:0000                                    ;   PROGRAM STORAGE SET FORTH ABOVE, THESE ARE
  576 A:0000                                    ;   ALL STRAIGHTFORWARD.
  577 A:0000                                    ;
  578 A:0000                                    ;  NEWSTT
  579 A:0000                                    ;   WHENEVER A STATEMENT FINISHES EXECUTION IT
  580 A:0000                                    ;   DOES A "RTS" WHICH TAKES
  581 A:0000                                    ;   EXECUTION BACK TO "NEWSTT". STATEMENTS THAT
  582 A:0000                                    ;   CREATE OR LOOK AT SEMI-PERMANENT STACK ENTRIES
  583 A:0000                                    ;   MUST GET RID OF THE RETURN ADDRESS OF "NEWSTT" AND
  584 A:0000                                    ;   JMP TO "NEWSTT" WHEN DONE. "NEWSTT" ALWAYS
  585 A:0000                                    ;   CHRGETS THE FIRST CHARACTER AFTER THE STATEMENT
  586 A:0000                                    ;   NAME BEFORE DISPATCHING. WHEN RETURNING
  587 A:0000                                    ;   BACK TO "NEWSTT" THE ONLY THING THAT
  588 A:0000                                    ;   MUST BE SET UP IS THE TEXT POINTER IN
  589 A:0000                                    ;   "TXTPTR". "NEWSTT" WILL CHECK TO MAKE SURE
  590 A:0000                                    ;   "TXTPTR" IS POINTING TO A STATEMENT TERMINATOR.
  591 A:0000                                    ;   IF A STATEMENT SHOULDN'T BE PERFORMED UNLESS
  592 A:0000                                    ;   IT IS PROPERLY FORMATTED (I.E. "NEW") IT CAN
  593 A:0000                                    ;   SIMPLY DO A RETURN AFTER READING ALL OF
  594 A:0000                                    ;   ITS ARGUMENTS. SINCE THE ZERO FLAG
  595 A:0000                                    ;   BEING OFF INDICATES THERE IS NOT
  596 A:0000                                    ;   A STATEMENT TERMINATOR "NEWSTT" WILL
  597 A:0000                                    ;   DO THE JMP TO THE "SYNTAX ERROR"
  598 A:0000                                    ;   ROUTINE. IF A STATEMENT SHOULD BE STARTED
  599 A:0000                                    ;   OVER IT CAN DO LDWD OLDTXT, STWD TXTPTR RTS SINCE THE TEXT PNTR
  600 A:0000                                    ;   AT "NEWSTT" IS ALWAYS STORED IN "OLDTXT".
  601 A:0000                                    ;   THE ^C CODE STORES [CURLIN] (THE
  602 A:0000                                    ;   CURRENT LINE NUMBER) IN "OLDLIN" SINCE THE ^C CHECK
  603 A:0000                                    ;   IS MADE BEFORE THE STATEMENT POINTED TO IS
  604 A:0000                                    ;   EXECUTED. "STOP" AND "END" STORE THE TEXT POINTER
  605 A:0000                                    ;   FROM "TXTPTR", WHICH POINTS AT THEIR TERMINATING
  606 A:0000                                    ;   CHARACTER, IN "OLDTXT".
  607 A:0000                                    ;
  608 A:0000                                    ;  STATEMENT CODE
  609 A:0000                                    ;   THE INDIVIDUAL STATEMENT CODE COMES
  610 A:0000                                    ;   NEXT. THE APPROACH USED IN EXECUTING EACH
  611 A:0000                                    ;   STATEMENT IS DOCUMENTED IN THE STATEMENT CODE
  612 A:0000                                    ;   ITSELF.
  613 A:0000                                    ;
  614 A:0000                                    ;  FRMEVL, THE FORMULA EVALUATOR
  615 A:0000                                    ;   GIVEN A TEXT POINTER POINTING TO THE STARTING
  616 A:0000                                    ;   CHARACTER OF A FORMULA, "FRMEVL"
  617 A:0000                                    ;   EVALUATES THE FORMULA AND LEAVES
  618 A:0000                                    ;   THE VALUE IN THE FLOATING ACCUMULATOR (FAC).
  619 A:0000                                    ;   "TXTPTR" IS RETURNED POINTING TO THE FIRST CHARACTER
  620 A:0000                                    ;   THAT COULD NOT BE INTERPRETED AS PART OF THE
  621 A:0000                                    ;   FORMULA. THE ALGORITHM USES THE STACK
  622 A:0000                                    ;   TO STORE TEMPORARY RESULTS:
  623 A:0000                                    ;
  624 A:0000                                    ;    0. PUT A DUMMY PRECEDENCE OF ZERO ON
  625 A:0000                                    ;     THE STACK.
  626 A:0000                                    ;    1. READ LEXEME (CONSTANT,FUNCTION,
  627 A:0000                                    ;     VARIABLE,FORMULA IN PARENS)
  628 A:0000                                    ;     AND TAKE THE LAST PRECEDENCE VALUE
  629 A:0000                                    ;     OFF THE STACK.
  630 A:0000                                    ;    2. SEE IF THE NEXT CHARACTER IS AN OPERATOR.
  631 A:0000                                    ;     IF NOT, CHECK PREVIOUS ONE. THIS MAY CAUSE
  632 A:0000                                    ;     OPERATOR APPLICATION OR AN ACTUAL
  633 A:0000                                    ;     RETURN FROM "FRMEVL".
  634 A:0000                                    ;    3. IF IT IS, SEE WHAT PRECEDENCE IT HAS
  635 A:0000                                    ;     AND COMPARE IT TO THE PRECEDENCE
  636 A:0000                                    ;     OF THE LAST OPERATOR ON THE STACK.
  637 A:0000                                    ;    4. IF = OR LESS REMEMBER THE OPERATOR
  638 A:0000                                    ;     POINTER OF THIS OPERATOR
  639 A:0000                                    ;     AND BRANCH TO "QCHNUM" TO CAUSE
  640 A:0000                                    ;     APPLICATION OF THE LAST OPERATOR.
  641 A:0000                                    ;     EVENTUALLY RETURN TO STEP 2
  642 A:0000                                    ;     BY RETURNING TO JUST AFTER "DOPREC".
  643 A:0000                                    ;    5. IF GREATER PUT THE LAST PRECEDENCE
  644 A:0000                                    ;     BACK ON, SAVE THE OPERATOR ADDRESS,
  645 A:0000                                    ;     CURRENT TEMPORARY RESULT,
  646 A:0000                                    ;     AND PRECEDENCE AND RETURN TO STEP 1.
  647 A:0000                                    ;
  648 A:0000                                    ;   RELATIONAL OPERATORS ARE ALL HANDLED THROUGH
  649 A:0000                                    ;   A COMMON ROUTINE. SPECIAL
  650 A:0000                                    ;   CARE IS TAKEN TO DETECT TYPE MISMATCHES SUCH AS 3+"F".
  651 A:0000                                    ;
  652 A:0000                                    ;  EVAL -- THE ROUTINE TO READ A LEXEME
  653 A:0000                                    ;   "EVAL" CHECKS FOR THE DIFFERENT TYPES OF
  654 A:0000                                    ;   ENTITIES IT IS SUPPOSED TO DETECT.
  655 A:0000                                    ;   LEADING PLUSES ARE IGNORED,
  656 A:0000                                    ;   DIGITS AND "." CAUSE "FIN" (FLOATING INPUT)
  657 A:0000                                    ;   TO BE CALLED. FUNCTION NAMES CAUSE THE
  658 A:0000                                    ;   FORMULA INSIDE THE PARENTHESES TO BE EVALUATED
  659 A:0000                                    ;   AND THE FUNCTION ROUTINE TO BE CALLED. VARIABLE
  660 A:0000                                    ;   NAMES CAUSE "PTRGET" TO BE CALLED TO GET A POINTER
  661 A:0000                                    ;   TO THE VALUE, AND THEN THE VALUE IS PUT INTO
  662 A:0000                                    ;   THE FAC. AN OPEN PARENTHESIS CAUSES "FRMEVL"
  663 A:0000                                    ;   TO BE CALLED (RECURSIVELY), AND THE ")" TO
  664 A:0000                                    ;   BE CHECKED FOR. UNARY OPERATORS (NOT AND
  665 A:0000                                    ;   NEGATION)  PUT THEIR PRECEDENCE ON THE STACK
  666 A:0000                                    ;   AND ENTER FORMULA EVALUATION AT STEP 1, SO
  667 A:0000                                    ;   THAT EVERYTHING UP TO AN OPERATOR GREATER THAN
  668 A:0000                                    ;   THEIR PRECEDENCE OR THE END OF THE FORMULA
  669 A:0000                                    ;   WILL BE EVALUATED.
  670 A:0000                                    ;
  671 A:0000                                    ;  DIMENSION AND VARIABLE SEARCHING
  672 A:0000                                    ;   SPACE IS ALLOCATED FOR VARIABLES AS THEY ARE
  673 A:0000                                    ;   ENCOUNTERED. THUS "DIM" STATEMENTS MUST BE
  674 A:0000                                    ;   EXECUTED TO HAVE EFFECT. 6 BYTES ARE ALLOCATED
  675 A:0000                                    ;   FOR EACH SIMPLE VARIABLE, WHETHER IT IS A STRING,
  676 A:0000                                    ;   NUMBER OR USER DEFINED FUNCTION. THE FIRST TWO
  677 A:0000                                    ;   BYTES GIVE THE NAME OF THE VARIABLE AND THE LAST FOUR
  678 A:0000                                    ;   GIVE ITS VALUE. [VARTAB] GIVES THE FIRST LOCATION
  679 A:0000                                    ;   WHERE A SIMPLE VARIABLE NAME IS FOUND AND [ARYTAB]
  680 A:0000                                    ;   GIVES THE LOCATION TO STOP SEARCHING FOR SIMPLE
  681 A:0000                                    ;   VARIABLES. A "FOR" ENTRY HAS A TEXT POINTER
  682 A:0000                                    ;   AND A POINTER TO A VARIABLE VALUE SO NEITHER
  683 A:0000                                    ;   THE PROGRAM OR THE SIMPLE VARIABLES CAN BE
  684 A:0000                                    ;   MOVED WHILE THERE ARE ACTIVE "FOR" ENTRIES ON THE STACK.
  685 A:0000                                    ;   USER DEFINED FUNCTION VALUES ALSO CONTAIN
  686 A:0000                                    ;   POINTERS INTO SIMPLE VARIABLE SPACE SO NO USER-DEFINED
  687 A:0000                                    ;   FUNCTION VALUES CAN BE RETAINED IF SIMPLE VARIABLES
  688 A:0000                                    ;   ARE MOVED. ADDING A SIMPLE VARIABLE IS JUST
  689 A:0000                                    ;   ADDING SIX TO [ARYTAB] AND [STREND], BLOCK TRANSFERING
  690 A:0000                                    ;   THE ARRAY VARIABLES UP BY SIX AND MAKING SURE THE
  691 A:0000                                    ;   NEW [STREND] IS NOT TOO CLOSE TO THE STRINGS.
  692 A:0000                                    ;   THIS MOVEMENT OF ARRAY VARIABLES MEANS
  693 A:0000                                    ;   THAT NO POINTER TO AN ARRAY WILL STAY VALID WHEN
  694 A:0000                                    ;   NEW SIMPLE VARIABLES CAN BE ENCOUNTERED. THIS IS
  695 A:0000                                    ;   WHY ARRAY VARIABLES ARE NOT ALLOWED FOR "FOR"
  696 A:0000                                    ;   LOOP VARIABLES. SETTING UP A NEW ARRAY VARIABLE
  697 A:0000                                    ;   MERELY INVOLVES BUILDING THE DESCRIPTOR,
  698 A:0000                                    ;   UPDATING [STREND], AND MAKING SURE THERE IS
  699 A:0000                                    ;   STILL ENOUGH ROOM BETWEEN [STREND] AND STRING SPACE.
  700 A:0000                                    ;   "PTRGET", THE ROUTINE WHICH RETURNS A POINTER
  701 A:0000                                    ;   TO A VARIABLE VALUE, HAS TWO IMPORTANT FLAGS. ONE IS
  702 A:0000                                    ;   "DIMFLG" WHICH INDICATES WHETHER "DIM" CALLED "PTRGET"
  703 A:0000                                    ;   OR NOT. IF SO, NO PRIOR ENTRY FOR THE VARIABLE IN
  704 A:0000                                    ;   QUESTION SHOULD BE FOUND, AND THE INDEX INDICATES
  705 A:0000                                    ;   HOW MUCH SPACE TO SET ASIDE. SIMPLE VARIABLES CAN
  706 A:0000                                    ;   BE "DIMENSIONED", BUT THE ONLY EFFECT WILL BE TO
  707 A:0000                                    ;   SET ASIDE SPACE FOR THE VARIABLE IF IT HASN'T BEEN
  708 A:0000                                    ;   ENCOUNTERED YET. THE OTHER IMPORTANT FLAG IS "SUBFLG"
  709 A:0000                                    ;   WHICH INDICATES WHETHER A SUBSCRIPTED VARIABLE SHOULD BE
  710 A:0000                                    ;   ALLOWED IN THE CURRENT CONTEXT. IF [SUBFLG] IS NON-ZERO
  711 A:0000                                    ;   THE OPEN PARENTHESIS FOR A SUBSCRIPTED VARIABLE
  712 A:0000                                    ;   WILL NOT BE SCANNED BY "PTRGET", AND "PTRGET" WILL RETURN
  713 A:0000                                    ;   WITH A TEXT POINTER POINTING TO THE "(", IF
  714 A:0000                                    ;   THERE WAS ONE.
  715 A:0000                                    ;  STRINGS
  716 A:0000                                    ;   IN THE VARIABLE TABLES STRINGS ARE STORED JUST LIKE
  717 A:0000                                    ;   NUMERIC VARIABLES. SIMPLE STRINGS HAVE THREE VALUE
  718 A:0000                                    ;   BYTES WHICH ARE INITIALIZED TO ALL ZEROS (WHICH
  719 A:0000                                    ;   REPRESENTS THE NULL STRING). THE ONLY DIFFERENCE
  720 A:0000                                    ;   IN HANDLING IS THAT WHEN "PTRGET" SEES A "$" AFTER THE
  721 A:0000                                    ;   NAME OF A VARIABLE, "PTRGET" SETS [VALTYP]
  722 A:0000                                    ;   TO NEGATIVE ONE AND TURNS
  723 A:0000                                    ;   ON THE MSB (MOST-SIGNIFIGANT-BIT) OF THE VALUE OF
  724 A:0000                                    ;   THE FIRST CHARACTER OF THE VARIABLE NAME.
  725 A:0000                                    ;   HAVING THIS BIT ON IN THE NAME OF THE VARIABLE ENSURES
  726 A:0000                                    ;   THAT THE SEARCH ROUTINE WILL NOT MATCH
  727 A:0000                                    ;   'A' WITH 'A$' OR 'A$' WITH 'A'. THE MEANING OF
  728 A:0000                                    ;   THE THREE VALUE BYTES ARE:
  729 A:0000                                    ;    LOW
  730 A:0000                                    ;     LENGTH OF THE STRING
  731 A:0000                                    ;     LOW 8 BITS
  732 A:0000                                    ;     HIGH 8 BITS  OF THE ADDRESS
  733 A:0000                                    ;      OF THE CHARACTERS IN THE
  734 A:0000                                    ;      STRING IF LENGTH.NE.0.
  735 A:0000                                    ;      MEANINGLESS OTHERWISE.
  736 A:0000                                    ;    HIGH
  737 A:0000                                    ;   THE VALUE OF A STRING VARIABLE (THESE 3 BYTES)
  738 A:0000                                    ;   IS CALLED THE STRING DESCRIPTOR TO DISTINGUISH
  739 A:0000                                    ;   IT FROM THE ACTUAL STRING DATA. WHENEVER A
  740 A:0000                                    ;   STRING CONSTANT IS ENCOUNTERED IN A FORMULA OR AS
  741 A:0000                                    ;   PART OF AN INPUT STRING, OR AS PART OF DATA, "STRLIT"
  742 A:0000                                    ;   IS CALLED, CAUSING A DESCRIPTOR TO BE BUILT FOR
  743 A:0000                                    ;   THE STRING. WHEN ASSIGNMENT IS MADE TO A STRING POINTING INTO
  744 A:0000                                    ;   "BUF" THE VALUE IS COPIED INTO STRING SPACE SINCE [BUF]
  745 A:0000                                    ;   IS ALWAYS CHANGING.
  746 A:0000                                    ;
  747 A:0000                                    ;   STRING FUNCTIONS AND THE ONE STRING OPERATOR "+"
  748 A:0000                                    ;   ALWAYS RETURN THEIR VALUES IN STRING SPACE.
  749 A:0000                                    ;   ASSIGNING A STRING A CONSTANT VALUE IN A PROGRAM
  750 A:0000                                    ;   THROUGH A "READ" OR ASSIGNMENT STATEMENT
  751 A:0000                                    ;   WILL NOT USE ANY STRING SPACE SINCE
  752 A:0000                                    ;   THE STRING DESCRIPTOR  WILL POINT INTO THE
  753 A:0000                                    ;   PROGRAM ITSELF. IN GENERAL, COPYING IS DONE
  754 A:0000                                    ;   WHEN A STRING VALUE IS IN "BUF", OR IT IS IN STRING
  755 A:0000                                    ;   SPACE AND THERE IS AN ACTIVE POINTER TO IT.
  756 A:0000                                    ;   THUS F$=G$ WILL CAUSE COPYING IF G$ HAS ITS
  757 A:0000                                    ;   STRING DATA IN STRING SPACE. F$=CHR$(7)
  758 A:0000                                    ;   WILL USE ONE BYTE OF STRING SPACE TO STORE THE
  759 A:0000                                    ;   NEW ONE CHARACTER STRING CREATED BY "CHR$", BUT
  760 A:0000                                    ;   THE ASSIGNMENT ITSELF WILL CAUSE NO COPYING SINCE
  761 A:0000                                    ;   THE ONLY POINTER AT THE NEW STRING IS A
  762 A:0000                                    ;   TEMPORARY DESCRIPTOR CREATED BY "FRMEVL" WHICH WILL
  763 A:0000                                    ;   GO AWAY AS SOON AS THE ASSIGNMENT IS DONE.
  764 A:0000                                    ;   IT IS THE NATURE OF GARBAGE COLLECTION THAT
  765 A:0000                                    ;   DISALLOWS HAVING TWO STRING DESCRIPTORS POINT TO THE SAME
  766 A:0000                                    ;   AREA IN STRING SPACE. STRING FUNCTIONS AND OPERATORS
  767 A:0000                                    ;   MUST PROCEED AS FOLLOWS:
  768 A:0000                                    ;    1) FIGURE OUT THE LENGTH OF THEIR RESULT.
  769 A:0000                                    ;
  770 A:0000                                    ;    2) CALL "GETSPA" TO FIND SPACE FOR THEIR
  771 A:0000                                    ;    RESULT. THE ARGUMENTS TO THE FUNCTION
  772 A:0000                                    ;    OR OPERATOR MAY CHANGE SINCE GARBAGE COLLECTION
  773 A:0000                                    ;    MAY BE INVOKED. THE ONLY THING THAT CAN
  774 A:0000                                    ;    BE SAVED DURING THE CALL TO "GETSPA" IS A POINTER
  775 A:0000                                    ;    TO THE DESCRIPTORS OF THE ARGUMENTS.
  776 A:0000                                    ;    3) CONSTRUCT THE RESULT DESCRIPTOR IN "DSCTMP".
  777 A:0000                                    ;    "GETSPA" RETURNS THE LOCATION OF THE AVAILABLE
  778 A:0000                                    ;    SPACE.
  779 A:0000                                    ;    4) CREATE THE NEW VALUE BY COPYING PARTS
  780 A:0000                                    ;    OF THE ARGUMENTS OR WHATEVER.
  781 A:0000                                    ;    5) FREE UP THE ARGUMENTS BY CALLING "FRETMP".
  782 A:0000                                    ;    6) JUMP TO "PUTNEW" TO GET THE DESCRIPTOR IN
  783 A:0000                                    ;    "DSCTMP" TRANSFERRED INTO A NEW STRING TEMPORARY.
  784 A:0000                                    ;
  785 A:0000                                    ;   THE REASON FOR STRING TEMPORARIES IS THAT GARBAGE
  786 A:0000                                    ;   COLLECTION HAS TO KNOW ABOUT ALL ACTIVE STRING DESCRIPTORS
  787 A:0000                                    ;   SO IT KNOWS WHAT IS AND ISN'T IN USE. STRING TEMPORARIES ARE
  788 A:0000                                    ;   USED TO STORE THE DESCRIPTORS OF STRING EXPRESSIONS.
  789 A:0000                                    ;   
  790 A:0000                                    ;   INSTEAD OF HAVING AN ACTUAL VALUE STORED IN THE
  791 A:0000                                    ;   FAC, AND HAVING THE VALUE OF A TEMPORARY RESULT
  792 A:0000                                    ;   BEING SAVED ON THE STACK, AS HAPPENS WITH NUMERIC
  793 A:0000                                    ;   VARIABLES, STRINGS HAVE THE POINTER TO A STRING DESCRIPTOR
  794 A:0000                                    ;   STORED IN THE FAC, AND IT IS THIS POINTER
  795 A:0000                                    ;   THAT GETS SAVED ON THE STACK BY FORMULA EVALUATION.
  796 A:0000                                    ;   STRING FUNCTIONS CANNOT FREE THEIR ARGUMENTS UP RIGHT
  797 A:0000                                    ;   AWAY SINCE "GETSPA" MAY FORCE
  798 A:0000                                    ;   GARBAGE COLLECTION AND THE ARGUMENT STRINGS
  799 A:0000                                    ;   MAY BE OVER-WRITTEN SINCE GARBAGE COLLECTION
  800 A:0000                                    ;   WILL NOT BE ABLE TO FIND AN ACTIVE POINTER TO
  801 A:0000                                    ;   THEM. FUNCTION AND OPERATOR RESULTS ARE BUILT IN
  802 A:0000                                    ;   "DSCTMP" SINCE STRING TEMPORARIES ARE ALLOCATED
  803 A:0000                                    ;   (PUTNEW) AND DEALLOCATED (FRETMP) IN A FIFO ORDERING
  804 A:0000                                    ;   (I.E. A STACK) SO THE NEW TEMPORARY CANNOT
  805 A:0000                                    ;   BE SET UP UNTIL THE OLD ONE(S) ARE FREED. TRYING
  806 A:0000                                    ;   TO BUILD A RESULT IN A TEMPORARY AFTER
  807 A:0000                                    ;   FREEING UP THE ARGUMENT TEMPORARIES COULD RESULT
  808 A:0000                                    ;   IN ONE OF THE ARGUMENT TEMPORARIES BEING OVERWRITTEN
  809 A:0000                                    ;   TOO SOON BY THE NEW RESULT.
  810 A:0000                                    ;
  811 A:0000                                    ;   STRING SPACE IS ALLOCATED AT THE VERY TOP
  812 A:0000                                    ;   OF MEMORY. "MEMSIZ" POINTS BEYOND THE LAST LOCATION OF
  813 A:0000                                    ;   STRING SPACE. STRINGS ARE STORED IN HIGH LOCATIONS
  814 A:0000                                    ;   FIRST. WHENEVER STRING SPACE IS ALLOCATED (GETSPA).
  815 A:0000                                    ;   [FRETOP], WHICH IS INITIALIZED TO [MEMSIZ], IS UPDATED
  816 A:0000                                    ;   TO GIVE THE HIGHEST LOCATION IN STRING SPACE
  817 A:0000                                    ;   THAT IS NOT IN USE. THE RESULT IS THAT
  818 A:0000                                    ;   [FRETOP] GETS SMALLER AND SMALLER, UNTIL SOME
  819 A:0000                                    ;   ALLOCATION WOULD MAKE [FRETOP] LESS THAN OR EQUAL TO
  820 A:0000                                    ;   [STREND]. THIS MEANS STRING SPACE HAS RUN INTO THE
  821 A:0000                                    ;   THE ARRAYS AND THAT GARBAGE COLLECTION MUST BE CALLED.
  822 A:0000                                    ;
  823 A:0000                                    ;   GARBAGE COLLECTION:
  824 A:0000                                    ;    0. [MINPTR]=[STREND] [FRETOP]=[MEMSIZ]
  825 A:0000                                    ;    1. [REMMIN]=0
  826 A:0000                                    ;    2. FOR EACH STRING DESCRIPTOR
  827 A:0000                                    ;    (TEMPORARIES, SIMPLE STRINGS, STRING ARRAYS)
  828 A:0000                                    ;    IF THE STRING IS NOT NULL AND ITS POINTER IS
  829 A:0000                                    ;    .GT.MINPTR AND .LT.FRETOP,
  830 A:0000                                    ;    [MINPTR]=THIS STRING DESCRIPTOR'S POINTER,
  831 A:0000                                    ;    [REMMIN]=POINTER AT THIS STRING DESCRIPTOR.
  832 A:0000                                    ;    END.
  833 A:0000                                    ;    3. IF REMMIN.NE.0 (WE FOUND AN UNCOLLECTED STRING),
  834 A:0000                                    ;    BLOCK TRANSFER THE STRING DATA POINTED
  835 A:0000                                    ;    TO IN THE STRING DESCRIPTOR POINTED TO BY "REMMIN"
  836 A:0000                                    ;    SO THAT THE LAST BYTE OF STRING DATA IS AT
  837 A:0000                                    ;    [FRETOP]. UPDATE [FRETOP] SO THAT IT
  838 A:0000                                    ;    POINTS TO THE LOCATION JUST BELOW THE ONE
  839 A:0000                                    ;    THE STRING DATA WAS MOVED INTO. UPDATE
  840 A:0000                                    ;    THE POINTER IN THE DESCRIPTOR SO IT POINTS
  841 A:0000                                    ;    TO THE NEW LOCATION OF THE STRING DATA.
  842 A:0000                                    ;    GO TO STEP 1.
  843 A:0000                                    ;
  844 A:0000                                    ;   AFTER CALLING GARBAGE COLLECTION "GETSPA" AGAIN CHECKS
  845 A:0000                                    ;   TO SEE IF [ACCA] CHARACTERS ARE AVAILABLE BETWEEN
  846 A:0000                                    ;   [STREND] AND [FRETOP]; IF NOT, AN "OUT OF STRING"
  847 A:0000                                    ;   ERROR IS INVOKED.
  848 A:0000                                    ;
  849 A:0000                                    ;  MATH PACKAGE
  850 A:0000                                    ;   THE MATH PACKAGE CONTAINS FLOATING INPUT (FIN),
  851 A:0000                                    ;   FLOATING OUTPUT (FOUT), FLOATING COMPARE (FCOMP)
  852 A:0000                                    ;   ... AND ALL THE NUMERIC OPERATORS AND FUNCTIONS.
  853 A:0000                                    ;   THE FORMATS, CONVENTIONS AND ENTRY POINTS ARE ALL
  854 A:0000                                    ;   DESCRIBED IN THE MATH PACKAGE ITSELF.
  855 A:0000                                    ;
  856 A:0000                                    ;  INIT -- THE INITIALIZATION ROUTINE
  857 A:0000                                    ;   THE AMOUNT OF MEMORY,
  858 A:0000                                    ;   TERMINAL WIDTH, AND WHICH FUNCTIONS TO BE RETAINED
  859 A:0000                                    ;   ARE ASCERTAINED FROM THE USER. A ZERO IS PUT DOWN
  860 A:0000                                    ;   AT THE FIRST LOCATION NOT USED BY THE MATH-PACKAGE
  861 A:0000                                    ;   AND [TXTTAB] IS SET UP TO POINT AT THE NEXT LOCATION.
  862 A:0000                                    ;   THIS DETERMINES WHERE PROGRAM STORAGE WILL START.
  863 A:0000                                    ;   SPECIAL CHECKS ARE MADE TO MAKE SURE
  864 A:0000                                    ;   ALL QUESTIONS IN "INIT" ARE ANSWERED REASONABLY, SINCE
  865 A:0000                                    ;   ONCE "INIT" FINISHES, THE LOCATIONS IT USES ARE
  866 A:0000                                    ;   USED FOR PROGRAM STORAGE. THE LAST THING "INIT" DOES IS
  867 A:0000                                    ;   CHANGE LOCATION ZERO TO BE A JUMP TO "READY" INSTEAD
  868 A:0000                                    ;   OF "INIT". ONCE THIS IS DONE THERE IS NO WAY TO RESTART
  869 A:0000                                    ;   "INIT".
  870 A:0000                                    ; HIGH LOCATIONS
  871 A:0000                                    ;
  872 A:0000                                    ; *
  873 A:0000                                    ; PAGE
  874 A:0000                                    ; SUBTTL PAGE ZERO.

  877 A:0000                                    
  877 A:0000  4c fb 26                           jmp INIT

  881 A:0003                           RDYJSR    
  881 A:0003  4c fb 26                           jmp INIT

  883 A:0006                           ADRAYI    
  883 A:0006  d5 16                              .word AYINT

  886 A:0008                           ADRGAY    
  886 A:0008  ab 18                              .word GIVAYF

  888 A:000a                                    ;ROUTINE TO CONVERT [Y,A] TO A FLOATING
  889 A:000a                                    ;POINT NUMBER IN THE FAC.

  892 A:000a                           USRPOK    
  892 A:000a  4c 61 17                           jmp FCERR

  894 A:000d                                    ;
  895 A:000d                                    ; THIS IS THE "VOLATILE" STORAGE AREA AND NONE OF IT
  896 A:000d                                    ; CAN BE KEPT IN ROM. ANY CONSTANTS IN THIS AREA CANNOT
  897 A:000d                                    ; BE KEPT IN A ROM, BUT MUST BE LOADED IN BY THE 
  898 A:000d                                    ; PROGRAM INSTRUCTIONS IN ROM.
  899 A:000d                                    ;
  900 A:000d                                    ; --- GENERAL RAM ---:
  901 A:000d                           CHARAC    
  901 A:000d  00                                 .dsb 1              ;A DELIMITING CHARACTER.
  902 A:000e                                    ;A ONE-BYTE INTEGER FROM "QINT".

  904 A:000e                           ENDCHR    
  904 A:000e  00                                 .dsb 1              ;THE OTHER DELIMITING CHARACTER.
  905 A:000f                           COUNT     
  905 A:000f  00                                 .dsb 1              ;A GENERAL COUNTER.

  907 A:0010                                    ; --- FLAGS ---:
  908 A:0010                           DIMFLG    
  908 A:0010  00                                 .dsb 1              ;IN GETTING A POINTER TO A VARIABLE
  909 A:0011                                    ;IT IS IMPORTANT TO REMEMBER WHETHER IT
  910 A:0011                                    ;IS BEING DONE FOR "DIM" OR NOT.
  911 A:0011                                    ;DIMFLG AND VALTYP MUST BE
  912 A:0011                                    ;CONSECUTIVE LOCATIONS.
  913 A:0011                                    ;PLACE TO PRESERVE Y DURING OUT.

  915 A:0011                           VALTYP    
  915 A:0011  00                                 .dsb 1              ;THE TYPE INDICATOR.
  916 A:0012                                    ;0=NUMERIC 1=STRING.

  919 A:0012                           INTFLG    
  919 A:0012  00                                 .dsb 1

  921 A:0013                           DORES     
  921 A:0013  00                                 .dsb 1              ;WHETHER CAN OR CAN'T CRUNCH RES'D WORDS.
  922 A:0014                                    ;TURNED ON WHEN "DATA"
  923 A:0014                                    ;BEING SCANNED BY CRUNCH SO UNQUOTED
  924 A:0014                                    ;STRINGS WON'T BE CRUNCHED.
  925 A:0014                                    ;WHETHER TO DO GARBAGE COLLECTION.

  927 A:0014                           SUBFLG    
  927 A:0014  00                                 .dsb 1              ;FLAG WHETHER SUB'D VARIABLE ALLOWED.
  928 A:0015                                    ;"FOR" AND USER-DEFINED FUNCTION
  929 A:0015                                    ;POINTER FETCHING TURN
  930 A:0015                                    ;THIS ON BEFORE CALLING "PTRGET"
  931 A:0015                                    ;SO ARRAYS WON'T BE DETECTED.
  932 A:0015                                    ;"STKINI" AND "PTRGET" CLEAR IT.
  933 A:0015                                    ;ALSO DISALLOWS INTEGERS THERE.
  934 A:0015                           INPFLG    
  934 A:0015  00                                 .dsb 1              ;FLAGS WHETHER WE ARE DOING "INPUT"
  935 A:0016                                    ;OR "READ".
  936 A:0016                           TANSGN    
  936 A:0016  00                                 .dsb 1              ;USED IN DETERMINING SIGN OF TANGENT.

  939 A:0017                           CNTWFL    
  939 A:0017  00                                 .dsb 1

  941 A:0018                                    ;NON-ZERO MEANS SUPPRESS.
  942 A:0018                                    ;RESET BY "INPUT", READY AND ERRORS.
  943 A:0018                                    ;COMPLEMENTED BY INPUT OF ^O.

  946 A:0018                                     *= 80

  948 A:0050                                    ; --- RAM DEALING WITH TERMINAL HANDLING ---:

  959 A:0050                                    
  959 A:0050  00                                 .dsb 1

  961 A:0051                           LINWID    
  961 A:0051  28                                 .byt 40              ;LENGTH OF LINE (WIDTH).
  962 A:0052                           NCMWID    
  962 A:0052  1e                                 .byt 30              ;POSITION BEYOND WHICH THERE ARE
  963 A:0053                                    ;NO MORE FIELDS.
  964 A:0053                           LINNUM    
  964 A:0053  00                                 .byt 0              ;LOCATION TO STORE LINE NUMBER BEFORE BUF
  965 A:0054                                    ;SO THAT "BLTUC" CAN STORE IT ALL AWAY AT ONCE.
  966 A:0054  2c                                 .byt 44              ;A COMMA (PRELOAD OR FROM ROM)
  967 A:0055                                    ;USED BY INPUT STATEMENT SINCE THE
  968 A:0055                                    ;DATA POINTER ALWAYS STARTS ON A
  969 A:0055                                    ;COMMA OR TERMINATOR.

  974 A:0055                                    ;DIRECT STATEMENTS EXECUTE OUT OF
  975 A:0055                                    ;HERE. REMEMBER "INPUT" SMASHES BUF.
  976 A:0055                                    ;MUST BE ON PAGE ZERO
  977 A:0055                                    ;OR ASSIGNMENT OF STRING
  978 A:0055                                    ;VALUES IN DIRECT STATEMENTS WON'T COPY
  979 A:0055                                    ;INTO STRING SPACE -- WHICH IT MUST.
  980 A:0055                                    ;N.B. TWO NONZERO BYTES MUST PRECEDE "BUFLNM".

  982 A:0055                                    ; --- STORAGE FOR TEMPORARY THINGS ---:
  983 A:0055                           TEMPPT    
  983 A:0055  00                                 .dsb 1              ;POINTER AT FIRST FREE TEMP DESCRIPTOR.
  984 A:0056                                    ;INITIALIZED TO POINT TO TEMPST.
  985 A:0056                           LASTPT    
  985 A:0056  00 ff                              .dsb 2              ;POINTER TO LAST-USED STRING TEMPORARY.
  986 A:0058                           TEMPST    
  986 A:0058  00 ff 03 00 00 64 03 ...           .dsb 3*3        ;STORAGE FOR NUMTMP TEMP DESCRIPTORS.
  987 A:0061                           INDEX1    
  987 A:0061  00 ff                              .dsb 2              ;INDEXES.

  989 A:0063                           INDEX2    
  989 A:0063  00 ff                              .dsb 2
  990 A:0065                           RESHO     
