 4996 A:e172                                    ; SUBTTL FRE FUNCTION AND INTEGER TO FLOATING ROUTINES.
 4997 A:e172                           FRE       
 4997 A:e172  a5 11                              lda VALTYP
 4998 A:e174  f0 05                              beq NOFREF
 4999 A:e176  20 a1 e4                           jsr FREFAC
 5000 A:e179                           NOFREF    
 5000 A:e179  20 1c e3                           jsr GARBA2
 5001 A:e17c  38                                 sec 
 5002 A:e17d  a5 72                              lda FRETOP                ;WE WANT
 5003 A:e17f  e5 70                              sbc STREND                ;[FRETOP]-[STREND].
 5004 A:e181  a8                                 tay 
 5005 A:e182  a5 73                              lda FRETOP+1
 5006 A:e184  e5 71                              sbc STREND+1

 5008 A:e186                           GIVAYF    
 5008 A:e186  a2 00                              ldx #0
 5009 A:e188  86 11                              stx VALTYP

 5011 A:e18a  85 a1                              sta FACHO
 5012 A:e18c  84 a2                              sty FACHO+1
 5013 A:e18e  a2 90                              ldx #144             ;SET EXPONENT TO 2^16.
 5014 A:e190  4c 46 ea                           jmp FLOATS                ;TURN IT TO A FLOATING PNT #.

 5016 A:e193                           POS       
