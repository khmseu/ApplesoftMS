 2340 A:d544  84 73                              sty FRETOP+1

 2345 A:d546                                    ;LIBERATE THE
 2346 A:d546  a5 6c                              lda VARTAB
 2347 A:d548  a4 6d                              ldy VARTAB+1
 2348 A:d54a                                    ;VARIABLES AND
 2349 A:d54a  85 6e                              sta ARYTAB
 2350 A:d54c  84 6f                              sty ARYTAB+1
 2351 A:d54e                                    ;ARRAYS.
