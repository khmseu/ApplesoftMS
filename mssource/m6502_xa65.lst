 7303 A:ed28                                    ; PAGE
 7304 A:ed28                                    ; SUBTTL EXPONENTIATION AND SQUARE ROOT FUNCTION.
 7305 A:ed28                                    ;SQUARE ROOT FUNCTION --- SQR(A)
 7306 A:ed28                                    ;USE SQR(X)=X^.5
 7307 A:ed28                           SQR       
 7307 A:ed28  20 02 ea                           jsr MOVAF                ;MOVE FAC INTO ARG.

 7309 A:ed2b  a9 ff                              lda #FHALF&255
 7310 A:ed2d  a0 ec                              ldy #FHALF/256
 7311 A:ed2f  20 95 e9                           jsr MOVFM                ;PUT MEMORY INTO FAC.
 7312 A:ed32                                    ;LAST THING FETCHED IS FACEXP. INTO ACCX.
 7313 A:ed32                                    ; JMP FPWRT  ;FALL INTO FPWRT.

 7315 A:ed32                                    ;EXPONENTIATION ---  X^Y.
 7316 A:ed32                                    ;N.B.  0^0=1
 7317 A:ed32                                    ;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
 7318 A:ed32                                    ;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
 7319 A:ed32                                    ;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
 7320 A:ed32                                    ;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
 7321 A:ed32                                    ;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
 7322 A:ed32                                    ;RETURNED BY EXP.
 7323 A:ed32                                    ;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
 7324 A:ed32                           FPWRT     
 7324 A:ed32  f0 74                              beq EXP                ;IF FAC=0, JUST EXPONENTIATE THAT.
 7325 A:ed34  a5 a8                              lda ARGEXP                ;IS X=0?
 7326 A:ed36  d0 07                              bne FPWRT1
 7327 A:ed38  4c e9 e6                           jmp ZEROF1                ;ZERO FAC.
 7328 A:ed3b                           FPWRT1    
 7328 A:ed3b                                    ;SAVE FOR LATER IN A TEMP.
 7329 A:ed3b  a2 8d                              ldx #DEFPNT&255
 7330 A:ed3d  a0 00                              ldy #DEFPNT/256
 7331 A:ed3f  20 ca e9                           jsr MOVMF
 7332 A:ed42                                    ;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
 7333 A:ed42  a5 ad                              lda ARGSGN
 7334 A:ed44  10 13                              bpl FPWR1                ;NO PROBLEMS IF X.GT.0.
 7335 A:ed46  20 c2 ea                           jsr INT                ;INTEGERIZE THE FAC.
 7336 A:ed49                                    ;GET ADDR OF COMPERAND.
 7337 A:ed49  a9 8d                              lda #DEFPNT&255
 7338 A:ed4b  a0 00                              ldy #DEFPNT/256
 7339 A:ed4d  20 51 ea                           jsr FCOMP                ;EQUAL?
 7340 A:ed50  d0 07                              bne FPWR1                ;LEAVE X NEG. LOG WILL BLOW HIM OUT.
 7341 A:ed52                                    ;A=-1 AND Y IS IRRELEVANT.
 7342 A:ed52  98                                 tya                    ;NEGATE X. MAKE POSITIVE.
 7343 A:ed53  a4 0d                              ldy CHARAC                ;GET EVENNESS.
 7344 A:ed55                           FPWR1     
 7344 A:ed55  20 f4 e9                           jsr MOVFA1                ;ALTERNATE ENTRY POINT.
 7345 A:ed58  98                                 tya 
 7346 A:ed59  48                                 pha                    ;SAVE EVENNESS FOR LATER.
 7347 A:ed5a  20 da e7                           jsr LOG                ;FIND LOG.
 7348 A:ed5d                                    ;MULTIPLY FAC TIMES LOG(X).
 7349 A:ed5d  a9 8d                              lda #DEFPNT&255
 7350 A:ed5f  a0 00                              ldy #DEFPNT/256
 7351 A:ed61  20 18 e8                           jsr FMULT
 7352 A:ed64  20 a4 ed                           jsr EXP                ;EXPONENTIATE THE FAC.
 7353 A:ed67  68                                 pla 
 7354 A:ed68  4a                                 lsr                    ;IS IT EVEN?
 7355 A:ed69  90 0e                              bcc NEGRTS                ;YES. OR X.GT.0.
 7356 A:ed6b                                    ;NEGATE THE NUMBER IN FAC.
 7357 A:ed6b                           NEGOP     
 7357 A:ed6b  a5 a0                              lda FACEXP
 7358 A:ed6d  f0 0a                              beq NEGRTS

 7360 A:ed6f  a5 a5                              lda FACSGN
 7361 A:ed71  49 ff                              eor #255
 7362 A:ed73  85 a5                              sta FACSGN
 7363 A:ed75                           NEGRTS    
 7363 A:ed75  60                                 rts 

 7365 A:ed76                                    ; PAGE
 7366 A:ed76                                    ; SUBTTL EXPONENTIATION FUNCTION.
 7367 A:ed76                                    ;FIRST SAVE THE ORIGINAL ARGUMENT AND MULTIPLY THE FAC BY
 7368 A:ed76                                    ;LOG2(E). THE RESULT IS USED TO DETERMINE IF OVERFLOW
 7369 A:ed76                                    ;WILL OCCUR SINCE EXP(X)=2^(X*LOG2(E)) WHERE
 7370 A:ed76                                    ;LOG2(E)=LOG(E) BASE 2. THEN SAVE THE INTEGER PART OF
 7371 A:ed76                                    ;THIS TO SCALE THE ANSWER AT THE END. SINCE
 7372 A:ed76                                    ;2^Y=2^INT(Y)*2^(Y-INT(Y)) AND 2^INT(Y) IS EASY TO COMPUTE.
 7373 A:ed76                                    ;NOW COMPUTE 2^(X*LOG2(E)-INT(X*LOG2(E)) BY
 7374 A:ed76                                    ;P(LN(2)*(INT(X*LOG2(E))+1)-X) WHERE P IS AN APPROXIMATION
 7375 A:ed76                                    ;POLYNOMIAL. THE RESULT IS THEN SCALED BY THE POWER OF 2
 7376 A:ed76                                    ;PREVIOUSLY SAVED.

 7378 A:ed76                           LOGEB2    
 7378 A:ed76  81                                 .byt 129              ;LOG(E) BASE 2.
 7379 A:ed77  38                                 .byt 56
 7380 A:ed78  aa                                 .byt 170
