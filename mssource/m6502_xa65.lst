 4319 A:1520  a5 a3                              lda FACMO                ;USE DEMORGAN'S LAW ON HIGH
 4320 A:1522  45 0f                              eor COUNT
 4321 A:1524  85 0d                              sta CHARAC
 4322 A:1526  a5 a4                              lda FACLO                ;AND LOW.
 4323 A:1528  45 0f                              eor COUNT
