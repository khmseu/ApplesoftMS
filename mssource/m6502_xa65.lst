  391 A:0000                                    ; SUBTTL SOME EXPLANATION.
  392 A:0000                                    ; COMMENT *
  393 A:0000                                    ;
  394 A:0000                                    ; M6502 BASIC CONFIGURES BASIC AS FOLLOWS
  395 A:0000                                    ;
  396 A:0000                                    ; LOW LOCATIONS
  397 A:0000                                    ;  PAGE ZERO
  398 A:0000                                    ;
  399 A:0000                                    ;   STARTUP:
  400 A:0000                                    ;   INITIALLY A JMP TO INITIALIZATION CODE BUT
  401 A:0000                                    ;   CHANGED TO A JMP TO "READY".
  402 A:0000                                    ;   RESTARTING THE MACHINE AT LOC 0 DURING PROGRAM
  403 A:0000                                    ;   EXECUTION CAN LEAVE THINGS MESSED UP.
  404 A:0000                                    ;
  405 A:0000                                    ;   LOC OF FAC TO INTEGER AND INTEGER TO FAC 
  406 A:0000                                    ;   ROUTINES.
  407 A:0000                                    ;
  408 A:0000                                    ;   "DIRECT" MEMORY:
  409 A:0000                                    ;   THESE ARE THE MOST COMMONLY USED LOCATIONS.
  410 A:0000                                    ;   THEY HOLD BOOKKEEPING INFO AND ALL OTHER
  411 A:0000                                    ;   FREQUENTLY USED INFORMATION.
  412 A:0000                                    ;   ALL TEMPORARIES, FLAGS, POINTERS, THE BUFFER AREA,
  413 A:0000                                    ;   THE FLOATING ACCUMULATOR, AND ANYTHING ELSE THAT
  414 A:0000                                    ;   IS USED TO STORE A CHANGING VALUE SHOULD BE LOCATED
  415 A:0000                                    ;   IN THIS AREA. CARE MUST BE MADE IN MOVING LOCATIONS
  416 A:0000                                    ;   IN THIS AREA SINCE THE JUXTAPOSITION OF TWO LOCATIONS
  417 A:0000                                    ;   IS OFTEN DEPENDED UPON.
  418 A:0000                                    ;
  419 A:0000                                    ;   STILL IN RAM WE HAVE THE BEGINNING OF THE "CHRGET"
  420 A:0000                                    ;   SUBROUTINE. IT IS HERE SO [TXTPTR] CAN BE THE
  421 A:0000                                    ;   EXTENDED ADDRESS OF A LOAD INSTRUCTION.
  422 A:0000                                    ;   THIS SAVES HAVING TO BOTHER ANY REGISTERS.
  423 A:0000                                    ;
  424 A:0000                                    ;  PAGE ONE
  425 A:0000                                    ;   THE STACK.
  426 A:0000                                    ;
  427 A:0000                                    ;  STORAGE PAGE TWO AND ON
  428 A:0000                                    ;   IN RAM VERSIONS THESE DATA STRUCTURES COME AT THE
  429 A:0000                                    ;   END OF BASIC. IN ROM VERSON THEY ARE AT RAMLOC WHICH
  430 A:0000                                    ;   CAN EITHER BE ABOVE OR BELOW ROMLOC, WHICH IS WHERE
  431 A:0000                                    ;   BASIC ITSELF RESIDES.
  432 A:0000                                    ;
  433 A:0000                                    ;     A ZERO.
  434 A:0000                                    ;   [TXTTAB] POINTER TO NEXT LINE'S POINTER.
  435 A:0000                                    ;     LINE # OF THIS LINE (2 BYTES).
  436 A:0000                                    ;     CHARACTERS ON THIS LINE.
  437 A:0000                                    ;     ZERO.
  438 A:0000                                    ;     POINTER AT NEXT LINE'S POINTER
  439 A:0000                                    ;      (POINTED TO BY THE ABOVE POINTER).
  440 A:0000                                    ;     ... REPEATS ...
  441 A:0000                                    ;   LAST LINE: POINTER AT ZERO POINTER.
  442 A:0000                                    ;     LINE # OF THIS LINE.
  443 A:0000                                    ;     CHARACTERS ON THIS LINE.
  444 A:0000                                    ;     ZERO.
  445 A:0000                                    ;     DOUBLE ZERO (POINTED TO BY THE ABOVE POINTER).
  446 A:0000                                    ;   [VARTAB] SIMPLE VARIABLES. 6 BYTES PER VALUE.
  447 A:0000                                    ;     2 BYTES GIVE THE NAME, 4 BYTES THE VALUE.
  448 A:0000                                    ;     ... REPEATS ...
  449 A:0000                                    ;   [ARYTAB] ARRAY VARIABLES. 2 BYTES NAME, 2 BYTE
  450 A:0000                                    ;     LENGTH, NUMBER OF DIMENSIONS , EXTENT OF
  451 A:0000                                    ;     EACH DIMENSION (2BYTES/), VALUES
  452 A:0000                                    ;     ... REPEATS ...
  453 A:0000                                    ;   [STREND] FREE SPACE.
  454 A:0000                                    ;     ... REPEATS ...
  455 A:0000                                    ;   [FRETOP] STRING SPACE IN USE.
  456 A:0000                                    ;     ... REPEATS ...
  457 A:0000                                    ;   [MEMSIZ] HIGHEST MACHINE LOCATION.
  458 A:0000                                    ;     UNUSED EXCEPT BY THE VAL FUNCTION.
  459 A:0000                                    ;
  460 A:0000                                    ;   ROM -- CONSTANTS AND CODE.
  461 A:0000                                    ;
  462 A:0000                                    ;  FUNCTION DISPATCH ADDRESSES (AT ROMLOC)
  463 A:0000                                    ;   "FUNDSP" CONTAINS THE ADDRESSES OF THE
  464 A:0000                                    ;   FUNCTION ROUTINES IN THE ORDER OF THE
  465 A:0000                                    ;   FUNCTION NAMES IN THE CRUNCH LIST.
  466 A:0000                                    ;   THE FUNCTIONS THAT TAKE MORE THAN ONE ARGUMENT
  467 A:0000                                    ;   ARE AT THE END. SEE THE EXPLANATION AT "ISFUN".
  468 A:0000                                    ;
  469 A:0000                                    ;  THE OPERATOR LIST
  470 A:0000                                    ;   THE "OPTAB" LIST CONTAINS AN OPERATOR'S PRECEDENCE
  471 A:0000                                    ;   FOLLOWED BY THE ADDRESS OF THE ROUTINE TO PERFORM
  472 A:0000                                    ;   THE OPERATION. THE INDEX INTO THE
  473 A:0000                                    ;   OPERATOR LIST IS MADE BY SUBTRACTING OFF THE CRUNCH VALUE
  474 A:0000                                    ;   OF THE LOWEST NUMBERED OPERATOR. THE ORDER
  475 A:0000                                    ;   OF OPERATORS IN THE CRUNCH LIST AND IN "OPTAB" IS IDENTICAL.
  476 A:0000                                    ;   THE PRECEDENCES ARE ARBITRARY EXCEPT FOR THEIR
  477 A:0000                                    ;   COMPARATIVE SIZES. NOTE THAT THE PRECEDENCE FOR
  478 A:0000                                    ;   UNARY OPERATORS SUCH AS "NOT" AND NEGATION ARE
  479 A:0000                                    ;   SETUP SPECIALLY WITHOUT USING THE LIST.
  480 A:0000                                    ;
  481 A:0000                                    ;  THE RESERVED WORD OR CRUNCH LIST
  482 A:0000                                    ;   WHEN A COMMAND OR PROGRAM LINE IS TYPED IN
  483 A:0000                                    ;   IT IS STORED IN "BUF". AS SOON AS THE WHOLE LINE
  484 A:0000                                    ;   HAS BEEN TYPED IN ("INLIN" RETURNS) "CRUNCH" IS
  485 A:0000                                    ;   CALLED TO CONVERT ALL RESERVED WORDS TO THEIR
  486 A:0000                                    ;   CRUNCHED VALUES. THIS REDUCES THE SIZE OF THE 
  487 A:0000                                    ;   PROGRAM AND SPEEDS UP EXECUTION BY ALLOWING
  488 A:0000                                    ;   LIST DISPATCHES TO PERFORM FUNCTIONS, STATEMENTS,
  489 A:0000                                    ;   AND OPERATIONS. THIS IS BECAUSE ALL THE STATEMENT
  490 A:0000                                    ;   NAMES ARE STORED CONSECUTIVELY IN THE CRUNCH LIST.
  491 A:0000                                    ;   WHEN A MATCH IS FOUND BETWEEN A STRING
  492 A:0000                                    ;   OF CHARACTERS AND A WORD IN THE CRUNCH LIST
  493 A:0000                                    ;   THE ENTIRE TEXT OF THE MATCHED WORD IS TAKEN OUT OF
  494 A:0000                                    ;   THE INPUT LINE AND A RESERVED WORD TOKEN IS PUT
  495 A:0000                                    ;   IN ITS PLACE. A RESERVED WORD TOKEN IS ALWAYS EQUAL
  496 A:0000                                    ;   TO OCTAL 200 PLUS THE POSITION OF THE MATCHED WORD
  497 A:0000                                    ;   IN THE CRUNCH LIST.
  498 A:0000                                    ;
  499 A:0000                                    ;  STATEMENT DISPATCH ADDRESSES
  500 A:0000                                    ;   WHEN A STATEMENT IS TO BE EXECUTED, THE FIRST
  501 A:0000                                    ;   CHARACTER OF THE STATEMENT IS EXAMINED
  502 A:0000                                    ;   TO SEE IF IT IS LESS THAN THE RESERVED
  503 A:0000                                    ;   WORD TOKEN FOR THE LOWEST NUMBERED STATEMENT NAME.
  504 A:0000                                    ;   IF SO, THE "LET" CODE IS CALLED TO
  505 A:0000                                    ;   TREAT THE STATEMENT AS AN ASSIGNMENT STATEMENT.
  506 A:0000                                    ;   OTHERWISE A CHECK IS MADE TO MAKE SURE THE
  507 A:0000                                    ;   RESERVED WORD NUMBER IS NOT TOO LARGE TO BE A
  508 A:0000                                    ;   STATEMENT TYPE NUMBER. IF NOT THE ADDRESS
  509 A:0000                                    ;   TO DISPATCH TO IS FETCHED FROM "STMDSP" (THE STATEMENT
  510 A:0000                                    ;   DISPATCH LIST) USING THE RESERVED WORD
  511 A:0000                                    ;   NUMBER FOR THE STATEMENT TO CALCULATE AN INDEX INTO
  512 A:0000                                    ;   THE LIST.
  513 A:0000                                    ;
  514 A:0000                                    ;  ERROR MESSAGES
  515 A:0000                                    ;   WHEN AN ERROR CONDITION IS DETECTED,
  516 A:0000                                    ;   [ACCX] MUST BE SET UP TO INDICATE WHICH ERROR
  517 A:0000                                    ;   MESSAGE IS APPROPRIATE AND A BRANCH MUST BE MADE
  518 A:0000                                    ;   TO "ERROR". THE STACK WILL BE RESET AND ALL
  519 A:0000                                    ;   PROGRAM CONTEXT WILL BE LOST. VARIABLES
  520 A:0000                                    ;   VALUES AND THE ACTUAL PROGRAM REMAIN INTACT.
  521 A:0000                                    ;   ONLY THE VALUE OF [ACCX] IS IMPORTANT WHEN
  522 A:0000                                    ;   THE BRANCH IS MADE TO ERROR. [ACCX] IS USED AS AN
  523 A:0000                                    ;   INDEX INTO "ERRTAB" WHICH GIVES THE TWO
  524 A:0000                                    ;   CHARACTER ERROR MESSAGE THAT WILL BE PRINTED ON THE
  525 A:0000                                    ;   USER'S TERMINAL.
  526 A:0000                                    ;
  527 A:0000                                    ;
  528 A:0000                                    ;  TEXTUAL MESSAGES
  529 A:0000                                    ;   CONSTANT MESSAGES ARE STORED HERE. UNLESS
  530 A:0000                                    ;   THE CODE TO CHECK IF A STRING MUST BE COPIED
  531 A:0000                                    ;   IS CHANGED THESE STRINGS MUST BE STORED ABOVE
  532 A:0000                                    ;   PAGE ZERO, OR ELSE THEY WILL BE COPIED BEFORE
  533 A:0000                                    ;   THEY ARE PRINTED.
  534 A:0000                                    ;
  535 A:0000                                    ;  FNDFOR 
  536 A:0000                                    ;   MOST SMALL ROUTINES ARE FAIRLY SIMPLE
  537 A:0000                                    ;   AND ARE DOCUMENTED IN PLACE. "FNDFOR" IS
  538 A:0000                                    ;   USED FOR FINDING "FOR" ENTRIES ON
  539 A:0000                                    ;   THE STACK. WHENEVER A "FOR" IS EXECUTED, A
  540 A:0000                                    ;   16-BYTE ENTRY IS PUSHED ONTO THE STACK.
  541 A:0000                                    ;   BEFORE THIS IS DONE, HOWEVER, A CHECK
  542 A:0000                                    ;   MUST BE MADE TO SEE IF THERE
  543 A:0000                                    ;   ARE ANY "FOR" ENTRIES ALREADY ON THE STACK
  544 A:0000                                    ;   FOR THE SAME LOOP VARIABLE. IF SO, THAT "FOR" ENTRY
  545 A:0000                                    ;   AND ALL OTHER "FOR" ENTRIES THAT WERE MADE AFTER IT
  546 A:0000                                    ;   ARE ELIMINATED FROM THE STACK. THIS IS SO A
  547 A:0000                                    ;   PROGRAM THAT JUMPS OUT OF THE MIDDLE
  548 A:0000                                    ;   OF A "FOR" LOOP AND THEN RESTARTS THE LOOP AGAIN
  549 A:0000                                    ;   AND AGAIN WON'T USE UP 18 BYTES OF STACK
  550 A:0000                                    ;   SPACE EVERY TIME. THE "NEXT" CODE ALSO
  551 A:0000                                    ;   CALLS "FNDFOR" TO SEARCH FOR A "FOR" ENTRY WITH
  552 A:0000                                    ;   THE LOOP VARIABLE IN
  553 A:0000                                    ;   THE "NEXT". AT WHATEVER POINT A MATCH IS FOUND
  554 A:0000                                    ;   THE STACK IS RESET. IF NO MATCH IS FOUND A
  555 A:0000                                    ;   "NEXT WITHOUT FOR"  ERROR OCCURS. GOSUB EXECUTION
  556 A:0000                                    ;   ALSO PUTS A 5-BYTE ENTRY ON STACK.
  557 A:0000                                    ;   WHEN A RETURN IS EXECUTED "FNDFOR" IS
  558 A:0000                                    ;   CALLED WITH A VARIABLE POINTER THAT CAN'T
  559 A:0000                                    ;   BE MATCHED. WHEN "FNDFOR" HAS RUN
  560 A:0000                                    ;   THROUGH ALL THE "FOR" ENTRIES ON THE STACK  
  561 A:0000                                    ;   IT RETURNS AND THE RETURN CODE MAKES
  562 A:0000                                    ;   SURE THE ENTRY THAT WAS STOPPED
  563 A:0000                                    ;   ON IS A GOSUB ENTRY. THIS ASSURES THAT
  564 A:0000                                    ;   IF YOU GOSUB TO A SECTION OF CODE
  565 A:0000                                    ;   IN WHICH A FOR LOOP IS ENTERED BUT NEVER
  566 A:0000                                    ;   EXITED THE RETURN WILL STILL BE
  567 A:0000                                    ;   ABLE TO FIND THE MOST RECENT
  568 A:0000                                    ;   GOSUB ENTRY. THE "RETURN" CODE ELIMINATES THE
  569 A:0000                                    ;   "GOSUB" ENTRY AND ALL "FOR" ENTRIES MADE AFTER
  570 A:0000                                    ;   THE GOSUB ENTRY.
  571 A:0000                                    ;
  572 A:0000                                    ;  NON-RUNTIME STUFF
  573 A:0000                                    ;   THE CODE TO INPUT A LINE, CRUNCH IT, GIVE ERRORS,
  574 A:0000                                    ;   FIND A SPECIFIC LINE IN THE PROGRAM,
  575 A:0000                                    ;   PERFORM A "NEW", "CLEAR", AND "LIST" ARE
  576 A:0000                                    ;   ALL IN THIS AREA. GIVEN THE EXPLANATION OF
  577 A:0000                                    ;   PROGRAM STORAGE SET FORTH ABOVE, THESE ARE
  578 A:0000                                    ;   ALL STRAIGHTFORWARD.
  579 A:0000                                    ;
  580 A:0000                                    ;  NEWSTT
  581 A:0000                                    ;   WHENEVER A STATEMENT FINISHES EXECUTION IT
  582 A:0000                                    ;   DOES A "RTS" WHICH TAKES
  583 A:0000                                    ;   EXECUTION BACK TO "NEWSTT". STATEMENTS THAT
  584 A:0000                                    ;   CREATE OR LOOK AT SEMI-PERMANENT STACK ENTRIES
  585 A:0000                                    ;   MUST GET RID OF THE RETURN ADDRESS OF "NEWSTT" AND
  586 A:0000                                    ;   JMP TO "NEWSTT" WHEN DONE. "NEWSTT" ALWAYS
  587 A:0000                                    ;   CHRGETS THE FIRST CHARACTER AFTER THE STATEMENT
  588 A:0000                                    ;   NAME BEFORE DISPATCHING. WHEN RETURNING
  589 A:0000                                    ;   BACK TO "NEWSTT" THE ONLY THING THAT
  590 A:0000                                    ;   MUST BE SET UP IS THE TEXT POINTER IN
  591 A:0000                                    ;   "TXTPTR". "NEWSTT" WILL CHECK TO MAKE SURE
  592 A:0000                                    ;   "TXTPTR" IS POINTING TO A STATEMENT TERMINATOR.
  593 A:0000                                    ;   IF A STATEMENT SHOULDN'T BE PERFORMED UNLESS
  594 A:0000                                    ;   IT IS PROPERLY FORMATTED (I.E. "NEW") IT CAN
  595 A:0000                                    ;   SIMPLY DO A RETURN AFTER READING ALL OF
  596 A:0000                                    ;   ITS ARGUMENTS. SINCE THE ZERO FLAG
  597 A:0000                                    ;   BEING OFF INDICATES THERE IS NOT
  598 A:0000                                    ;   A STATEMENT TERMINATOR "NEWSTT" WILL
  599 A:0000                                    ;   DO THE JMP TO THE "SYNTAX ERROR"
  600 A:0000                                    ;   ROUTINE. IF A STATEMENT SHOULD BE STARTED
  601 A:0000                                    ;   OVER IT CAN DO LDWD OLDTXT, STWD TXTPTR RTS SINCE THE TEXT PNTR
  602 A:0000                                    ;   AT "NEWSTT" IS ALWAYS STORED IN "OLDTXT".
  603 A:0000                                    ;   THE ^C CODE STORES [CURLIN] (THE
  604 A:0000                                    ;   CURRENT LINE NUMBER) IN "OLDLIN" SINCE THE ^C CHECK
  605 A:0000                                    ;   IS MADE BEFORE THE STATEMENT POINTED TO IS
  606 A:0000                                    ;   EXECUTED. "STOP" AND "END" STORE THE TEXT POINTER
  607 A:0000                                    ;   FROM "TXTPTR", WHICH POINTS AT THEIR TERMINATING
  608 A:0000                                    ;   CHARACTER, IN "OLDTXT".
  609 A:0000                                    ;
  610 A:0000                                    ;  STATEMENT CODE
  611 A:0000                                    ;   THE INDIVIDUAL STATEMENT CODE COMES
  612 A:0000                                    ;   NEXT. THE APPROACH USED IN EXECUTING EACH
  613 A:0000                                    ;   STATEMENT IS DOCUMENTED IN THE STATEMENT CODE
  614 A:0000                                    ;   ITSELF.
  615 A:0000                                    ;
  616 A:0000                                    ;  FRMEVL, THE FORMULA EVALUATOR
  617 A:0000                                    ;   GIVEN A TEXT POINTER POINTING TO THE STARTING
  618 A:0000                                    ;   CHARACTER OF A FORMULA, "FRMEVL"
  619 A:0000                                    ;   EVALUATES THE FORMULA AND LEAVES
  620 A:0000                                    ;   THE VALUE IN THE FLOATING ACCUMULATOR (FAC).
  621 A:0000                                    ;   "TXTPTR" IS RETURNED POINTING TO THE FIRST CHARACTER
  622 A:0000                                    ;   THAT COULD NOT BE INTERPRETED AS PART OF THE
  623 A:0000                                    ;   FORMULA. THE ALGORITHM USES THE STACK
  624 A:0000                                    ;   TO STORE TEMPORARY RESULTS:
  625 A:0000                                    ;
  626 A:0000                                    ;    0. PUT A DUMMY PRECEDENCE OF ZERO ON
  627 A:0000                                    ;     THE STACK.
  628 A:0000                                    ;    1. READ LEXEME (CONSTANT,FUNCTION,
  629 A:0000                                    ;     VARIABLE,FORMULA IN PARENS)
  630 A:0000                                    ;     AND TAKE THE LAST PRECEDENCE VALUE
  631 A:0000                                    ;     OFF THE STACK.
  632 A:0000                                    ;    2. SEE IF THE NEXT CHARACTER IS AN OPERATOR.
  633 A:0000                                    ;     IF NOT, CHECK PREVIOUS ONE. THIS MAY CAUSE
  634 A:0000                                    ;     OPERATOR APPLICATION OR AN ACTUAL
  635 A:0000                                    ;     RETURN FROM "FRMEVL".
  636 A:0000                                    ;    3. IF IT IS, SEE WHAT PRECEDENCE IT HAS
  637 A:0000                                    ;     AND COMPARE IT TO THE PRECEDENCE
  638 A:0000                                    ;     OF THE LAST OPERATOR ON THE STACK.
  639 A:0000                                    ;    4. IF = OR LESS REMEMBER THE OPERATOR
  640 A:0000                                    ;     POINTER OF THIS OPERATOR
  641 A:0000                                    ;     AND BRANCH TO "QCHNUM" TO CAUSE
  642 A:0000                                    ;     APPLICATION OF THE LAST OPERATOR.
  643 A:0000                                    ;     EVENTUALLY RETURN TO STEP 2
  644 A:0000                                    ;     BY RETURNING TO JUST AFTER "DOPREC".
  645 A:0000                                    ;    5. IF GREATER PUT THE LAST PRECEDENCE
  646 A:0000                                    ;     BACK ON, SAVE THE OPERATOR ADDRESS,
  647 A:0000                                    ;     CURRENT TEMPORARY RESULT,
  648 A:0000                                    ;     AND PRECEDENCE AND RETURN TO STEP 1.
  649 A:0000                                    ;
  650 A:0000                                    ;   RELATIONAL OPERATORS ARE ALL HANDLED THROUGH
  651 A:0000                                    ;   A COMMON ROUTINE. SPECIAL
  652 A:0000                                    ;   CARE IS TAKEN TO DETECT TYPE MISMATCHES SUCH AS 3+"F".
  653 A:0000                                    ;
  654 A:0000                                    ;  EVAL -- THE ROUTINE TO READ A LEXEME
  655 A:0000                                    ;   "EVAL" CHECKS FOR THE DIFFERENT TYPES OF
  656 A:0000                                    ;   ENTITIES IT IS SUPPOSED TO DETECT.
  657 A:0000                                    ;   LEADING PLUSES ARE IGNORED,
  658 A:0000                                    ;   DIGITS AND "." CAUSE "FIN" (FLOATING INPUT)
  659 A:0000                                    ;   TO BE CALLED. FUNCTION NAMES CAUSE THE
  660 A:0000                                    ;   FORMULA INSIDE THE PARENTHESES TO BE EVALUATED
  661 A:0000                                    ;   AND THE FUNCTION ROUTINE TO BE CALLED. VARIABLE
  662 A:0000                                    ;   NAMES CAUSE "PTRGET" TO BE CALLED TO GET A POINTER
  663 A:0000                                    ;   TO THE VALUE, AND THEN THE VALUE IS PUT INTO
  664 A:0000                                    ;   THE FAC. AN OPEN PARENTHESIS CAUSES "FRMEVL"
  665 A:0000                                    ;   TO BE CALLED (RECURSIVELY), AND THE ")" TO
  666 A:0000                                    ;   BE CHECKED FOR. UNARY OPERATORS (NOT AND
  667 A:0000                                    ;   NEGATION)  PUT THEIR PRECEDENCE ON THE STACK
  668 A:0000                                    ;   AND ENTER FORMULA EVALUATION AT STEP 1, SO
  669 A:0000                                    ;   THAT EVERYTHING UP TO AN OPERATOR GREATER THAN
  670 A:0000                                    ;   THEIR PRECEDENCE OR THE END OF THE FORMULA
  671 A:0000                                    ;   WILL BE EVALUATED.
  672 A:0000                                    ;
  673 A:0000                                    ;  DIMENSION AND VARIABLE SEARCHING
  674 A:0000                                    ;   SPACE IS ALLOCATED FOR VARIABLES AS THEY ARE
  675 A:0000                                    ;   ENCOUNTERED. THUS "DIM" STATEMENTS MUST BE
  676 A:0000                                    ;   EXECUTED TO HAVE EFFECT. 6 BYTES ARE ALLOCATED
  677 A:0000                                    ;   FOR EACH SIMPLE VARIABLE, WHETHER IT IS A STRING,
  678 A:0000                                    ;   NUMBER OR USER DEFINED FUNCTION. THE FIRST TWO
  679 A:0000                                    ;   BYTES GIVE THE NAME OF THE VARIABLE AND THE LAST FOUR
  680 A:0000                                    ;   GIVE ITS VALUE. [VARTAB] GIVES THE FIRST LOCATION
  681 A:0000                                    ;   WHERE A SIMPLE VARIABLE NAME IS FOUND AND [ARYTAB]
  682 A:0000                                    ;   GIVES THE LOCATION TO STOP SEARCHING FOR SIMPLE
  683 A:0000                                    ;   VARIABLES. A "FOR" ENTRY HAS A TEXT POINTER
  684 A:0000                                    ;   AND A POINTER TO A VARIABLE VALUE SO NEITHER
  685 A:0000                                    ;   THE PROGRAM OR THE SIMPLE VARIABLES CAN BE
  686 A:0000                                    ;   MOVED WHILE THERE ARE ACTIVE "FOR" ENTRIES ON THE STACK.
  687 A:0000                                    ;   USER DEFINED FUNCTION VALUES ALSO CONTAIN
  688 A:0000                                    ;   POINTERS INTO SIMPLE VARIABLE SPACE SO NO USER-DEFINED
  689 A:0000                                    ;   FUNCTION VALUES CAN BE RETAINED IF SIMPLE VARIABLES
  690 A:0000                                    ;   ARE MOVED. ADDING A SIMPLE VARIABLE IS JUST
  691 A:0000                                    ;   ADDING SIX TO [ARYTAB] AND [STREND], BLOCK TRANSFERING
  692 A:0000                                    ;   THE ARRAY VARIABLES UP BY SIX AND MAKING SURE THE
  693 A:0000                                    ;   NEW [STREND] IS NOT TOO CLOSE TO THE STRINGS.
  694 A:0000                                    ;   THIS MOVEMENT OF ARRAY VARIABLES MEANS
  695 A:0000                                    ;   THAT NO POINTER TO AN ARRAY WILL STAY VALID WHEN
  696 A:0000                                    ;   NEW SIMPLE VARIABLES CAN BE ENCOUNTERED. THIS IS
  697 A:0000                                    ;   WHY ARRAY VARIABLES ARE NOT ALLOWED FOR "FOR"
  698 A:0000                                    ;   LOOP VARIABLES. SETTING UP A NEW ARRAY VARIABLE
  699 A:0000                                    ;   MERELY INVOLVES BUILDING THE DESCRIPTOR,
  700 A:0000                                    ;   UPDATING [STREND], AND MAKING SURE THERE IS
  701 A:0000                                    ;   STILL ENOUGH ROOM BETWEEN [STREND] AND STRING SPACE.
  702 A:0000                                    ;   "PTRGET", THE ROUTINE WHICH RETURNS A POINTER
  703 A:0000                                    ;   TO A VARIABLE VALUE, HAS TWO IMPORTANT FLAGS. ONE IS
  704 A:0000                                    ;   "DIMFLG" WHICH INDICATES WHETHER "DIM" CALLED "PTRGET"
  705 A:0000                                    ;   OR NOT. IF SO, NO PRIOR ENTRY FOR THE VARIABLE IN
  706 A:0000                                    ;   QUESTION SHOULD BE FOUND, AND THE INDEX INDICATES
  707 A:0000                                    ;   HOW MUCH SPACE TO SET ASIDE. SIMPLE VARIABLES CAN
  708 A:0000                                    ;   BE "DIMENSIONED", BUT THE ONLY EFFECT WILL BE TO
  709 A:0000                                    ;   SET ASIDE SPACE FOR THE VARIABLE IF IT HASN'T BEEN
  710 A:0000                                    ;   ENCOUNTERED YET. THE OTHER IMPORTANT FLAG IS "SUBFLG"
  711 A:0000                                    ;   WHICH INDICATES WHETHER A SUBSCRIPTED VARIABLE SHOULD BE
  712 A:0000                                    ;   ALLOWED IN THE CURRENT CONTEXT. IF [SUBFLG] IS NON-ZERO
  713 A:0000                                    ;   THE OPEN PARENTHESIS FOR A SUBSCRIPTED VARIABLE
  714 A:0000                                    ;   WILL NOT BE SCANNED BY "PTRGET", AND "PTRGET" WILL RETURN
  715 A:0000                                    ;   WITH A TEXT POINTER POINTING TO THE "(", IF
  716 A:0000                                    ;   THERE WAS ONE.
  717 A:0000                                    ;  STRINGS
  718 A:0000                                    ;   IN THE VARIABLE TABLES STRINGS ARE STORED JUST LIKE
  719 A:0000                                    ;   NUMERIC VARIABLES. SIMPLE STRINGS HAVE THREE VALUE
  720 A:0000                                    ;   BYTES WHICH ARE INITIALIZED TO ALL ZEROS (WHICH
  721 A:0000                                    ;   REPRESENTS THE NULL STRING). THE ONLY DIFFERENCE
  722 A:0000                                    ;   IN HANDLING IS THAT WHEN "PTRGET" SEES A "$" AFTER THE
  723 A:0000                                    ;   NAME OF A VARIABLE, "PTRGET" SETS [VALTYP]
  724 A:0000                                    ;   TO NEGATIVE ONE AND TURNS
  725 A:0000                                    ;   ON THE MSB (MOST-SIGNIFIGANT-BIT) OF THE VALUE OF
  726 A:0000                                    ;   THE FIRST CHARACTER OF THE VARIABLE NAME.
  727 A:0000                                    ;   HAVING THIS BIT ON IN THE NAME OF THE VARIABLE ENSURES
  728 A:0000                                    ;   THAT THE SEARCH ROUTINE WILL NOT MATCH
  729 A:0000                                    ;   'A' WITH 'A$' OR 'A$' WITH 'A'. THE MEANING OF
  730 A:0000                                    ;   THE THREE VALUE BYTES ARE:
  731 A:0000                                    ;    LOW
  732 A:0000                                    ;     LENGTH OF THE STRING
  733 A:0000                                    ;     LOW 8 BITS
  734 A:0000                                    ;     HIGH 8 BITS  OF THE ADDRESS
  735 A:0000                                    ;      OF THE CHARACTERS IN THE
  736 A:0000                                    ;      STRING IF LENGTH.NE.0.
  737 A:0000                                    ;      MEANINGLESS OTHERWISE.
  738 A:0000                                    ;    HIGH
  739 A:0000                                    ;   THE VALUE OF A STRING VARIABLE (THESE 3 BYTES)
  740 A:0000                                    ;   IS CALLED THE STRING DESCRIPTOR TO DISTINGUISH
  741 A:0000                                    ;   IT FROM THE ACTUAL STRING DATA. WHENEVER A
  742 A:0000                                    ;   STRING CONSTANT IS ENCOUNTERED IN A FORMULA OR AS
  743 A:0000                                    ;   PART OF AN INPUT STRING, OR AS PART OF DATA, "STRLIT"
  744 A:0000                                    ;   IS CALLED, CAUSING A DESCRIPTOR TO BE BUILT FOR
  745 A:0000                                    ;   THE STRING. WHEN ASSIGNMENT IS MADE TO A STRING POINTING INTO
  746 A:0000                                    ;   "BUF" THE VALUE IS COPIED INTO STRING SPACE SINCE [BUF]
  747 A:0000                                    ;   IS ALWAYS CHANGING.
  748 A:0000                                    ;
  749 A:0000                                    ;   STRING FUNCTIONS AND THE ONE STRING OPERATOR "+"
  750 A:0000                                    ;   ALWAYS RETURN THEIR VALUES IN STRING SPACE.
  751 A:0000                                    ;   ASSIGNING A STRING A CONSTANT VALUE IN A PROGRAM
  752 A:0000                                    ;   THROUGH A "READ" OR ASSIGNMENT STATEMENT
  753 A:0000                                    ;   WILL NOT USE ANY STRING SPACE SINCE
  754 A:0000                                    ;   THE STRING DESCRIPTOR  WILL POINT INTO THE
  755 A:0000                                    ;   PROGRAM ITSELF. IN GENERAL, COPYING IS DONE
  756 A:0000                                    ;   WHEN A STRING VALUE IS IN "BUF", OR IT IS IN STRING
  757 A:0000                                    ;   SPACE AND THERE IS AN ACTIVE POINTER TO IT.
  758 A:0000                                    ;   THUS F$=G$ WILL CAUSE COPYING IF G$ HAS ITS
  759 A:0000                                    ;   STRING DATA IN STRING SPACE. F$=CHR$(7)
  760 A:0000                                    ;   WILL USE ONE BYTE OF STRING SPACE TO STORE THE
  761 A:0000                                    ;   NEW ONE CHARACTER STRING CREATED BY "CHR$", BUT
  762 A:0000                                    ;   THE ASSIGNMENT ITSELF WILL CAUSE NO COPYING SINCE
  763 A:0000                                    ;   THE ONLY POINTER AT THE NEW STRING IS A
  764 A:0000                                    ;   TEMPORARY DESCRIPTOR CREATED BY "FRMEVL" WHICH WILL
  765 A:0000                                    ;   GO AWAY AS SOON AS THE ASSIGNMENT IS DONE.
  766 A:0000                                    ;   IT IS THE NATURE OF GARBAGE COLLECTION THAT
  767 A:0000                                    ;   DISALLOWS HAVING TWO STRING DESCRIPTORS POINT TO THE SAME
  768 A:0000                                    ;   AREA IN STRING SPACE. STRING FUNCTIONS AND OPERATORS
  769 A:0000                                    ;   MUST PROCEED AS FOLLOWS:
  770 A:0000                                    ;    1) FIGURE OUT THE LENGTH OF THEIR RESULT.
  771 A:0000                                    ;
  772 A:0000                                    ;    2) CALL "GETSPA" TO FIND SPACE FOR THEIR
  773 A:0000                                    ;    RESULT. THE ARGUMENTS TO THE FUNCTION
  774 A:0000                                    ;    OR OPERATOR MAY CHANGE SINCE GARBAGE COLLECTION
  775 A:0000                                    ;    MAY BE INVOKED. THE ONLY THING THAT CAN
  776 A:0000                                    ;    BE SAVED DURING THE CALL TO "GETSPA" IS A POINTER
  777 A:0000                                    ;    TO THE DESCRIPTORS OF THE ARGUMENTS.
  778 A:0000                                    ;    3) CONSTRUCT THE RESULT DESCRIPTOR IN "DSCTMP".
  779 A:0000                                    ;    "GETSPA" RETURNS THE LOCATION OF THE AVAILABLE
  780 A:0000                                    ;    SPACE.
  781 A:0000                                    ;    4) CREATE THE NEW VALUE BY COPYING PARTS
  782 A:0000                                    ;    OF THE ARGUMENTS OR WHATEVER.
  783 A:0000                                    ;    5) FREE UP THE ARGUMENTS BY CALLING "FRETMP".
  784 A:0000                                    ;    6) JUMP TO "PUTNEW" TO GET THE DESCRIPTOR IN
  785 A:0000                                    ;    "DSCTMP" TRANSFERRED INTO A NEW STRING TEMPORARY.
  786 A:0000                                    ;
  787 A:0000                                    ;   THE REASON FOR STRING TEMPORARIES IS THAT GARBAGE
  788 A:0000                                    ;   COLLECTION HAS TO KNOW ABOUT ALL ACTIVE STRING DESCRIPTORS
  789 A:0000                                    ;   SO IT KNOWS WHAT IS AND ISN'T IN USE. STRING TEMPORARIES ARE
  790 A:0000                                    ;   USED TO STORE THE DESCRIPTORS OF STRING EXPRESSIONS.
  791 A:0000                                    ;   
  792 A:0000                                    ;   INSTEAD OF HAVING AN ACTUAL VALUE STORED IN THE
  793 A:0000                                    ;   FAC, AND HAVING THE VALUE OF A TEMPORARY RESULT
  794 A:0000                                    ;   BEING SAVED ON THE STACK, AS HAPPENS WITH NUMERIC
  795 A:0000                                    ;   VARIABLES, STRINGS HAVE THE POINTER TO A STRING DESCRIPTOR
  796 A:0000                                    ;   STORED IN THE FAC, AND IT IS THIS POINTER
  797 A:0000                                    ;   THAT GETS SAVED ON THE STACK BY FORMULA EVALUATION.
  798 A:0000                                    ;   STRING FUNCTIONS CANNOT FREE THEIR ARGUMENTS UP RIGHT
  799 A:0000                                    ;   AWAY SINCE "GETSPA" MAY FORCE
  800 A:0000                                    ;   GARBAGE COLLECTION AND THE ARGUMENT STRINGS
  801 A:0000                                    ;   MAY BE OVER-WRITTEN SINCE GARBAGE COLLECTION
  802 A:0000                                    ;   WILL NOT BE ABLE TO FIND AN ACTIVE POINTER TO
  803 A:0000                                    ;   THEM. FUNCTION AND OPERATOR RESULTS ARE BUILT IN
  804 A:0000                                    ;   "DSCTMP" SINCE STRING TEMPORARIES ARE ALLOCATED
  805 A:0000                                    ;   (PUTNEW) AND DEALLOCATED (FRETMP) IN A FIFO ORDERING
  806 A:0000                                    ;   (I.E. A STACK) SO THE NEW TEMPORARY CANNOT
  807 A:0000                                    ;   BE SET UP UNTIL THE OLD ONE(S) ARE FREED. TRYING
  808 A:0000                                    ;   TO BUILD A RESULT IN A TEMPORARY AFTER
  809 A:0000                                    ;   FREEING UP THE ARGUMENT TEMPORARIES COULD RESULT
  810 A:0000                                    ;   IN ONE OF THE ARGUMENT TEMPORARIES BEING OVERWRITTEN
  811 A:0000                                    ;   TOO SOON BY THE NEW RESULT.
  812 A:0000                                    ;
  813 A:0000                                    ;   STRING SPACE IS ALLOCATED AT THE VERY TOP
  814 A:0000                                    ;   OF MEMORY. "MEMSIZ" POINTS BEYOND THE LAST LOCATION OF
  815 A:0000                                    ;   STRING SPACE. STRINGS ARE STORED IN HIGH LOCATIONS
  816 A:0000                                    ;   FIRST. WHENEVER STRING SPACE IS ALLOCATED (GETSPA).
  817 A:0000                                    ;   [FRETOP], WHICH IS INITIALIZED TO [MEMSIZ], IS UPDATED
  818 A:0000                                    ;   TO GIVE THE HIGHEST LOCATION IN STRING SPACE
  819 A:0000                                    ;   THAT IS NOT IN USE. THE RESULT IS THAT
  820 A:0000                                    ;   [FRETOP] GETS SMALLER AND SMALLER, UNTIL SOME
  821 A:0000                                    ;   ALLOCATION WOULD MAKE [FRETOP] LESS THAN OR EQUAL TO
  822 A:0000                                    ;   [STREND]. THIS MEANS STRING SPACE HAS RUN INTO THE
  823 A:0000                                    ;   THE ARRAYS AND THAT GARBAGE COLLECTION MUST BE CALLED.
  824 A:0000                                    ;
  825 A:0000                                    ;   GARBAGE COLLECTION:
  826 A:0000                                    ;    0. [MINPTR]=[STREND] [FRETOP]=[MEMSIZ]
  827 A:0000                                    ;    1. [REMMIN]=0
  828 A:0000                                    ;    2. FOR EACH STRING DESCRIPTOR
  829 A:0000                                    ;    (TEMPORARIES, SIMPLE STRINGS, STRING ARRAYS)
  830 A:0000                                    ;    IF THE STRING IS NOT NULL AND ITS POINTER IS
  831 A:0000                                    ;    .GT.MINPTR AND .LT.FRETOP,
  832 A:0000                                    ;    [MINPTR]=THIS STRING DESCRIPTOR'S POINTER,
  833 A:0000                                    ;    [REMMIN]=POINTER AT THIS STRING DESCRIPTOR.
  834 A:0000                                    ;    END.
  835 A:0000                                    ;    3. IF REMMIN.NE.0 (WE FOUND AN UNCOLLECTED STRING),
  836 A:0000                                    ;    BLOCK TRANSFER THE STRING DATA POINTED
  837 A:0000                                    ;    TO IN THE STRING DESCRIPTOR POINTED TO BY "REMMIN"
  838 A:0000                                    ;    SO THAT THE LAST BYTE OF STRING DATA IS AT
  839 A:0000                                    ;    [FRETOP]. UPDATE [FRETOP] SO THAT IT
  840 A:0000                                    ;    POINTS TO THE LOCATION JUST BELOW THE ONE
  841 A:0000                                    ;    THE STRING DATA WAS MOVED INTO. UPDATE
  842 A:0000                                    ;    THE POINTER IN THE DESCRIPTOR SO IT POINTS
  843 A:0000                                    ;    TO THE NEW LOCATION OF THE STRING DATA.
  844 A:0000                                    ;    GO TO STEP 1.
  845 A:0000                                    ;
  846 A:0000                                    ;   AFTER CALLING GARBAGE COLLECTION "GETSPA" AGAIN CHECKS
  847 A:0000                                    ;   TO SEE IF [ACCA] CHARACTERS ARE AVAILABLE BETWEEN
  848 A:0000                                    ;   [STREND] AND [FRETOP]; IF NOT, AN "OUT OF STRING"
  849 A:0000                                    ;   ERROR IS INVOKED.
  850 A:0000                                    ;
  851 A:0000                                    ;  MATH PACKAGE
  852 A:0000                                    ;   THE MATH PACKAGE CONTAINS FLOATING INPUT (FIN),
  853 A:0000                                    ;   FLOATING OUTPUT (FOUT), FLOATING COMPARE (FCOMP)
  854 A:0000                                    ;   ... AND ALL THE NUMERIC OPERATORS AND FUNCTIONS.
  855 A:0000                                    ;   THE FORMATS, CONVENTIONS AND ENTRY POINTS ARE ALL
  856 A:0000                                    ;   DESCRIBED IN THE MATH PACKAGE ITSELF.
  857 A:0000                                    ;
  858 A:0000                                    ;  INIT -- THE INITIALIZATION ROUTINE
  859 A:0000                                    ;   THE AMOUNT OF MEMORY,
  860 A:0000                                    ;   TERMINAL WIDTH, AND WHICH FUNCTIONS TO BE RETAINED
  861 A:0000                                    ;   ARE ASCERTAINED FROM THE USER. A ZERO IS PUT DOWN
  862 A:0000                                    ;   AT THE FIRST LOCATION NOT USED BY THE MATH-PACKAGE
  863 A:0000                                    ;   AND [TXTTAB] IS SET UP TO POINT AT THE NEXT LOCATION.
  864 A:0000                                    ;   THIS DETERMINES WHERE PROGRAM STORAGE WILL START.
  865 A:0000                                    ;   SPECIAL CHECKS ARE MADE TO MAKE SURE
  866 A:0000                                    ;   ALL QUESTIONS IN "INIT" ARE ANSWERED REASONABLY, SINCE
  867 A:0000                                    ;   ONCE "INIT" FINISHES, THE LOCATIONS IT USES ARE
  868 A:0000                                    ;   USED FOR PROGRAM STORAGE. THE LAST THING "INIT" DOES IS
  869 A:0000                                    ;   CHANGE LOCATION ZERO TO BE A JUMP TO "READY" INSTEAD
  870 A:0000                                    ;   OF "INIT". ONCE THIS IS DONE THERE IS NO WAY TO RESTART
  871 A:0000                                    ;   "INIT".
  872 A:0000                                    ; HIGH LOCATIONS
  873 A:0000                                    ;
  874 A:0000                                    ; *
  875 A:0000                                    ; PAGE
  876 A:0000                                    ; SUBTTL PAGE ZERO.

  879 A:0000                                    
  879 A:0000  4c d6 ef                           jmp INIT

  883 A:0003                           RDYJSR    
  883 A:0003  4c d6 ef                           jmp INIT

  885 A:0006                           ADRAYI    
  885 A:0006  b0 df                              .word AYINT

  888 A:0008                           ADRGAY    
  888 A:0008  86 e1                              .word GIVAYF

  890 A:000a                                    ;ROUTINE TO CONVERT [Y,A] TO A FLOATING
  891 A:000a                                    ;POINT NUMBER IN THE FAC.

  894 A:000a                           USRPOK    
  894 A:000a  4c 3c e0                           jmp FCERR

  896 A:000d                                    ;
  897 A:000d                                    ; THIS IS THE "VOLATILE" STORAGE AREA AND NONE OF IT
  898 A:000d                                    ; CAN BE KEPT IN ROM. ANY CONSTANTS IN THIS AREA CANNOT
  899 A:000d                                    ; BE KEPT IN A ROM, BUT MUST BE LOADED IN BY THE 
  900 A:000d                                    ; PROGRAM INSTRUCTIONS IN ROM.
  901 A:000d                                    ;
  902 A:000d                                    ; --- GENERAL RAM ---:
  903 A:000d                           CHARAC    
  903 A:000d  00                                 .dsb 1              ;A DELIMITING CHARACTER.
  904 A:000e                                    ;A ONE-BYTE INTEGER FROM "QINT".

  906 A:000e                           ENDCHR    
  906 A:000e  00                                 .dsb 1              ;THE OTHER DELIMITING CHARACTER.
  907 A:000f                           COUNT     
  907 A:000f  00                                 .dsb 1              ;A GENERAL COUNTER.

  909 A:0010                                    ; --- FLAGS ---:
  910 A:0010                           DIMFLG    
  910 A:0010  00                                 .dsb 1              ;IN GETTING A POINTER TO A VARIABLE
  911 A:0011                                    ;IT IS IMPORTANT TO REMEMBER WHETHER IT
  912 A:0011                                    ;IS BEING DONE FOR "DIM" OR NOT.
  913 A:0011                                    ;DIMFLG AND VALTYP MUST BE
  914 A:0011                                    ;CONSECUTIVE LOCATIONS.
  915 A:0011                                    ;PLACE TO PRESERVE Y DURING OUT.

  917 A:0011                           VALTYP    
  917 A:0011  00                                 .dsb 1              ;THE TYPE INDICATOR.
  918 A:0012                                    ;0=NUMERIC 1=STRING.

  921 A:0012                           INTFLG    
  921 A:0012  00                                 .dsb 1

  923 A:0013                           DORES     
  923 A:0013  00                                 .dsb 1              ;WHETHER CAN OR CAN'T CRUNCH RES'D WORDS.
  924 A:0014                                    ;TURNED ON WHEN "DATA"
  925 A:0014                                    ;BEING SCANNED BY CRUNCH SO UNQUOTED
  926 A:0014                                    ;STRINGS WON'T BE CRUNCHED.
  927 A:0014                                    ;WHETHER TO DO GARBAGE COLLECTION.

  929 A:0014                           SUBFLG    
  929 A:0014  00                                 .dsb 1              ;FLAG WHETHER SUB'D VARIABLE ALLOWED.
  930 A:0015                                    ;"FOR" AND USER-DEFINED FUNCTION
  931 A:0015                                    ;POINTER FETCHING TURN
  932 A:0015                                    ;THIS ON BEFORE CALLING "PTRGET"
  933 A:0015                                    ;SO ARRAYS WON'T BE DETECTED.
  934 A:0015                                    ;"STKINI" AND "PTRGET" CLEAR IT.
  935 A:0015                                    ;ALSO DISALLOWS INTEGERS THERE.
  936 A:0015                           INPFLG    
  936 A:0015  00                                 .dsb 1              ;FLAGS WHETHER WE ARE DOING "INPUT"
  937 A:0016                                    ;OR "READ".
  938 A:0016                           TANSGN    
  938 A:0016  00                                 .dsb 1              ;USED IN DETERMINING SIGN OF TANGENT.

  941 A:0017                           CNTWFL    
  941 A:0017  00                                 .dsb 1

  943 A:0018                                    ;NON-ZERO MEANS SUPPRESS.
  944 A:0018                                    ;RESET BY "INPUT", READY AND ERRORS.
  945 A:0018                                    ;COMPLEMENTED BY INPUT OF ^O.

  948 A:0018                                     *= 80

  950 A:0050                                    ; --- RAM DEALING WITH TERMINAL HANDLING ---:

  961 A:0050                                    
  961 A:0050  00                                 .dsb 1

  963 A:0051                           LINWID    
  963 A:0051  28                                 .byt 40              ;LENGTH OF LINE (WIDTH).
  964 A:0052                           NCMWID    
  964 A:0052  1e                                 .byt 30              ;POSITION BEYOND WHICH THERE ARE
  965 A:0053                                    ;NO MORE FIELDS.
  966 A:0053                           LINNUM    
  966 A:0053  00                                 .byt 0              ;LOCATION TO STORE LINE NUMBER BEFORE BUF
  967 A:0054                                    ;SO THAT "BLTUC" CAN STORE IT ALL AWAY AT ONCE.
  968 A:0054  2c                                 .byt 44              ;A COMMA (PRELOAD OR FROM ROM)
  969 A:0055                                    ;USED BY INPUT STATEMENT SINCE THE
  970 A:0055                                    ;DATA POINTER ALWAYS STARTS ON A
  971 A:0055                                    ;COMMA OR TERMINATOR.

  976 A:0055                                    ;DIRECT STATEMENTS EXECUTE OUT OF
  977 A:0055                                    ;HERE. REMEMBER "INPUT" SMASHES BUF.
  978 A:0055                                    ;MUST BE ON PAGE ZERO
  979 A:0055                                    ;OR ASSIGNMENT OF STRING
  980 A:0055                                    ;VALUES IN DIRECT STATEMENTS WON'T COPY
  981 A:0055                                    ;INTO STRING SPACE -- WHICH IT MUST.
  982 A:0055                                    ;N.B. TWO NONZERO BYTES MUST PRECEDE "BUFLNM".

  984 A:0055                                    ; --- STORAGE FOR TEMPORARY THINGS ---:
  985 A:0055                           TEMPPT    
  985 A:0055  00                                 .dsb 1              ;POINTER AT FIRST FREE TEMP DESCRIPTOR.
  986 A:0056                                    ;INITIALIZED TO POINT TO TEMPST.
  987 A:0056                           LASTPT    
  987 A:0056  00 ff                              .dsb 2              ;POINTER TO LAST-USED STRING TEMPORARY.
  988 A:0058                           TEMPST    
  988 A:0058  00 ff 03 00 00 64 03 ...           .dsb 3*3        ;STORAGE FOR NUMTMP TEMP DESCRIPTORS.
  989 A:0061                           INDEX1    
  989 A:0061  00 ff                              .dsb 2              ;INDEXES.

  991 A:0063                           INDEX2    
  991 A:0063  00 ff                              .dsb 2
  992 A:0065                           RESHO     
  992 A:0065  00                                 .dsb 1              ;RESULT OF MULTIPLIER AND DIVIDER.

  995 A:0066                           RESMOH    
  995 A:0066  00                                 .dsb 1

  997 A:0067                           RESMO     
  997 A:0067  00                                 .dsb 1
  998 A:0068                           RESLO     
  998 A:0068  00                                 .dsb 1
  999 A:0069                                    ;TEMPORARY USED BY "UMULT".

 1001 A:0069  00                                 .byt 0              ;OVERFLOW FOR RES.

 1003 A:006a                                    ; --- POINTERS INTO DYNAMIC DATA STRUCTURES ---;
 1004 A:006a                           TXTTAB    
 1004 A:006a  00 ff                              .dsb 2              ;POINTER TO BEGINNING OF TEXT.
 1005 A:006c                                    ;DOESN'T CHANGE AFTER BEING
 1006 A:006c                                    ;SETUP BY "INIT".
 1007 A:006c                           VARTAB    
 1007 A:006c  00 ff                              .dsb 2              ;POINTER TO START OF SIMPLE
 1008 A:006e                                    ;VARIABLE SPACE.
 1009 A:006e                                    ;UPDATED WHENEVER THE SIZE OF THE
 1010 A:006e                                    ;PROGRAM CHANGES, SET TO [TXTTAB]
 1011 A:006e                                    ;BY "SCRATCH" ("NEW").
 1012 A:006e                           ARYTAB    
 1012 A:006e  00 ff                              .dsb 2              ;POINTER TO BEGINNING OF ARRAY
 1013 A:0070                                    ;TABLE.
 1014 A:0070                                    ;INCREMENTED BY 6 WHENEVER
 1015 A:0070                                    ;A NEW SIMPLE VARIABLE IS FOUND, AND
 1016 A:0070                                    ;SET TO [VARTAB] BY "CLEARC".
 1017 A:0070                           STREND    
 1017 A:0070  00 ff                              .dsb 2              ;END OF STORAGE IN USE.
 1018 A:0072                                    ;INCREASED WHENEVER A NEW ARRAY
 1019 A:0072                                    ;OR SIMPLE VARIABLE IS ENCOUNTERED.
 1020 A:0072                                    ;SET TO [VARTAB] BY "CLEARC".
 1021 A:0072                           FRETOP    
 1021 A:0072  00 ff                              .dsb 2              ;TOP OF STRING FREE SPACE.
 1022 A:0074                           FRESPC    
 1022 A:0074  00 ff                              .dsb 2              ;POINTER TO NEW STRING.
 1023 A:0076                           MEMSIZ    
