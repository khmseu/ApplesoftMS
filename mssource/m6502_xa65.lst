 5275 A:e2dd  84 af                              sty FACOV
 5276 A:e2df  88                                 dey 
 5277 A:e2e0  84 11                              sty VALTYP                ;TYPE IS "STRING".
 5278 A:e2e2  86 56                              stx LASTPT                ;SET POINTER TO LAST-USED TEMP.
 5279 A:e2e4  e8                                 inx 
 5280 A:e2e5  e8                                 inx 
 5281 A:e2e6  e8                                 inx                    ;POINT FURTHER.
 5282 A:e2e7  86 55                              stx TEMPPT                ;SAVE POINTER TO NEXT TEMP IF ANY.
 5283 A:e2e9  60                                 rts                    ;ALL DONE.

 5285 A:e2ea                                    ;
 5286 A:e2ea                                    ; GETSPA - GET SPACE FOR CHARACTER STRING.
 5287 A:e2ea                                    ; MAY FORCE GARBAGE COLLECTION.
 5288 A:e2ea                                    ;
 5289 A:e2ea                                    ; # OF CHARACTERS (BYTES) IN ACCA.
 5290 A:e2ea                                    ; RETURNS WITH POINTER IN [Y,X]. OTHERWISE (IF CAN'T GET
 5291 A:e2ea                                    ; SPACE) BLOWS OFF TO "OUT OF STRING SPACE" TYPE ERROR.
 5292 A:e2ea                                    ; ALSO PRESERVES [ACCA] AND SETS [FRESPC]=[Y,X]=PNTR AT SPACE.
 5293 A:e2ea                                    ;
 5294 A:e2ea                           GETSPA    
 5294 A:e2ea  46 13                              lsr DORES                ;SIGNAL NO GARBAGE COLLECTION YET.
 5295 A:e2ec                           TRYAG2    
 5295 A:e2ec  48                                 pha                    ;SAVE FOR LATER.
 5296 A:e2ed  49 ff                              eor #255
 5297 A:e2ef  38                                 sec                    ;ADD ONE TO COMPLETE NEGATION.
 5298 A:e2f0  65 72                              adc FRETOP
