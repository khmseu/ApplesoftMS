 2109 A:d451                                    

 2136 A:d451  20 0c fd                           jsr 64780
 2137 A:d454  29 7f                              and #127

 2151 A:d456  c9 0f                              cmp #15
 2152 A:d458  d0 08                              bne INCRTS
 2153 A:d45a  48                                 pha 

