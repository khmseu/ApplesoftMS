 2245 A:d4c9  e6 0f                              inc COUNT                ;INCREMENT RES WORD COUNT.
 2246 A:d4cb                           NTHIS1    
 2246 A:d4cb  c8                                 iny 
 2247 A:d4cc  b9 7f d0                           lda RESLST-1,Y,       ;GET RES CHARACTER.
 2248 A:d4cf  10 fa                              bpl NTHIS1                ;END OF ENTRY?
 2249 A:d4d1  b9 80 d0                           lda RESLST,Y,             ;YES. IS IT THE END?
 2250 A:d4d4  d0 b4                              bne RESCON                ;NO, TRY THE NEXT WORD.
 2251 A:d4d6  bd 00 02                           lda 512,X            ;YES, END OF TABLE. GET 1ST CHR.
 2252 A:d4d9  10 be                              bpl GETBPT                ;STORE IT AWAY (ALWAYS BRANCHES).
 2253 A:d4db                           CRDONE    
