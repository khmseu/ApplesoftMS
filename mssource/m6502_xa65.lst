 1666 A:d264                                    ; PAGE
 1667 A:d264                                    ; SUBTTL GENERAL STORAGE MANAGEMENT ROUTINES.
 1668 A:d264                                    ;
 1669 A:d264                                    ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
 1670 A:d264                                    ;

 1672 A:d264                           FNDFOR    
 1672 A:d264  ba                                 tsx                    ;LOAD XREG WITH STK PNTR.
 1673 A:d265  e8                                 inx 
 1674 A:d266  e8                                 inx 
 1675 A:d267  e8                                 inx 
 1676 A:d268  e8                                 inx 
 1677 A:d269                           FFLOOP    
 1677 A:d269  bd 01 01                           lda 257,X            ;GET STACK ENTRY.
 1678 A:d26c  c9 7f                              cmp #127             ;IS IT A "FOR" TOKEN?
 1679 A:d26e  d0 21                              bne FFRTS                ;NO, NO "FOR" LOOPS WITH THIS PNTR.
 1680 A:d270  a5 89                              lda FORPNT+1          ;GET HIGH.
 1681 A:d272  d0 0a                              bne CMPFOR
 1682 A:d274  bd 02 01                           lda 258,X            ;PNTR IS ZERO, SO ASSUME THIS ONE.
 1683 A:d277  85 88                              sta FORPNT
 1684 A:d279  bd 03 01                           lda 259,X
 1685 A:d27c  85 89                              sta FORPNT+1
 1686 A:d27e                           CMPFOR    
 1686 A:d27e  dd 03 01                           cmp 259,X
 1687 A:d281  d0 07                              bne ADDFRS                ;NOT THIS ONE.
 1688 A:d283  a5 88                              lda FORPNT                ;GET DOWN.
 1689 A:d285  dd 02 01                           cmp 258,X
 1690 A:d288  f0 07                              beq FFRTS                ;WE GOT IT! WE GOT IT!
 1691 A:d28a                           ADDFRS    
 1691 A:d28a  8a                                 txa 
 1692 A:d28b  18                                 clc                    ;ADD 16 TO X.
 1693 A:d28c  69 12                              adc #18
 1694 A:d28e  aa                                 tax                    ;RESULT BACK INTO X.
 1695 A:d28f  d0 d8                              bne FFLOOP
 1696 A:d291                           FFRTS     
 1696 A:d291  60                                 rts                    ;RETURN TO CALLER.

 1698 A:d292                                    ;
 1699 A:d292                                    ; THIS IS THE BLOCK TRANSFER ROUTINE.
 1700 A:d292                                    ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
 1701 A:d292                                    ;
 1702 A:d292                                    ; ON ENTRY:
 1703 A:d292                                    ; [Y,A]=[HIGHDS]    (FOR REASON).
 1704 A:d292                                    ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
 1705 A:d292                                    ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
 1706 A:d292                                    ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
 1707 A:d292                                    ;
 1708 A:d292                                    ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
 1709 A:d292                                    ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
 1710 A:d292                                    ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
 1711 A:d292                                    ;
 1712 A:d292                                    ; ON EXIT:
 1713 A:d292                                    ; [LOWTR] ARE UNCHANGED.
 1714 A:d292                                    ; [HIGHTR]=[LOWTR]-200 OCTAL.
 1715 A:d292                                    ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
 1716 A:d292                                    ;
 1717 A:d292                           BLTU      
 1717 A:d292  20 e2 d2                           jsr REASON                ;ASCERTAIN THAT STRING SPACE WON'T
 1718 A:d295                                    ;BE OVERRUN.

 1720 A:d295  85 70                              sta STREND
 1721 A:d297  84 71                              sty STREND+1
 1722 A:d299                           BLTUC     
 1722 A:d299  38                                 sec                    ;PREPARE TO SUBTRACT.
 1723 A:d29a  a5 99                              lda HIGHTR
 1724 A:d29c  e5 9e                              sbc LOWTR                ;COMPUTE NUMBER OF THINGS TO MOVE.
 1725 A:d29e  85 61                              sta INDEX1                ;SAVE FOR LATER.
 1726 A:d2a0  a8                                 tay 
 1727 A:d2a1  a5 9a                              lda HIGHTR+1
 1728 A:d2a3  e5 9f                              sbc LOWTR+1
 1729 A:d2a5  aa                                 tax                    ;PUT IT IN A COUNTER REGISTER.
 1730 A:d2a6  e8                                 inx                    ;SO THAT COUNTER ALGORITHM WORKS.
 1731 A:d2a7  98                                 tya                    ;SEE IF LOW PART OF COUNT IS ZERO.
 1732 A:d2a8  f0 23                              beq DECBLT                ;YES, GO START MOVING BLOCKS.
 1733 A:d2aa  a5 99                              lda HIGHTR                ;NO, MUST MODIFY BASE ADDR.
 1734 A:d2ac  38                                 sec 
 1735 A:d2ad  e5 61                              sbc INDEX1                ;BORROW IS OFF SINCE [HIGHTR].GT.[LOWTR].
 1736 A:d2af  85 99                              sta HIGHTR                ;SAVE MODIFIED BASE ADDR.
 1737 A:d2b1  b0 03                              bcs BLT1                ;IF NO BORROW, GO SHOVE IT.
 1738 A:d2b3  c6 9a                              dec HIGHTR+1          ;BORROW IMPLIES SUB 1 FROM HIGH ORDER.
 1739 A:d2b5  38                                 sec 
 1740 A:d2b6                           BLT1      
 1740 A:d2b6  a5 97                              lda HIGHDS                ;MOD BASE OF DEST ADDR.
 1741 A:d2b8  e5 61                              sbc INDEX1
 1742 A:d2ba  85 97                              sta HIGHDS
 1743 A:d2bc  b0 08                              bcs MOREN1                ;NO BORROW.
 1744 A:d2be  c6 98                              dec HIGHDS+1          ;DECREMENT HIGH ORDER BYTE.
 1745 A:d2c0  90 04                              bcc MOREN1                ;ALWAYS SKIP.
 1746 A:d2c2                           BLTLP     
 1746 A:d2c2  b1 99                              lda (HIGHTR),Y            ;FETCH BYTE TO MOVE
 1747 A:d2c4  91 97                              sta (HIGHDS),Y            ;MOVE IT IN, MOVE IT OUT.
 1748 A:d2c6                           MOREN1    
 1748 A:d2c6  88                                 dey 
 1749 A:d2c7  d0 f9                              bne BLTLP
 1750 A:d2c9  b1 99                              lda (HIGHTR),Y            ;MOVE LAST OF THE BLOCK.
 1751 A:d2cb  91 97                              sta (HIGHDS),Y
 1752 A:d2cd                           DECBLT    
 1752 A:d2cd  c6 9a                              dec HIGHTR+1
 1753 A:d2cf  c6 98                              dec HIGHDS+1          ;START ON NEW BLOCKS.
 1754 A:d2d1  ca                                 dex 
 1755 A:d2d2  d0 f2                              bne MOREN1
 1756 A:d2d4  60                                 rts                    ;RETURN TO CALLER.

 1758 A:d2d5                                    ;
 1759 A:d2d5                                    ; THIS ROUTINE IS USED TO ASCERTAIN THAT A GIVEN
 1760 A:d2d5                                    ; NUMBER OF LOCS REMAIN AVAILABLE FOR THE STACK.
 1761 A:d2d5                                    ;    THE CALL IS:
 1762 A:d2d5                                    ; LDAI NUMBER OF 2-BYTE ENTRIES NEEDED.
 1763 A:d2d5                                    ; JSR GETSTK
 1764 A:d2d5                                    ;
 1765 A:d2d5                                    ; THIS ROUTINE MUST BE CALLED BY ANY ROUTINE WHICH PUTS
 1766 A:d2d5                                    ; AN ARBITRARY AMOUNT OF STUFF ON THE STACK,
 1767 A:d2d5                                    ; I.E., ANY RECURSIVE ROUTINE LIKE "FRMEVL".
 1768 A:d2d5                                    ; IT IS ALSO CALLED BY ROUTINES SUCH AS "GOSUB" AND "FOR"
 1769 A:d2d5                                    ; WHICH MAKE PERMANENT ENTRIES ON THE STACK.
 1770 A:d2d5                                    ;
 1771 A:d2d5                                    ; ROUTINES WHICH MERELY USE AND FREE UP THE GUARANTEED
 1772 A:d2d5                                    ; NUMLEV LOCATIONS NEED NOT CALL THIS.
 1773 A:d2d5                                    ;
 1774 A:d2d5                                    ;
 1775 A:d2d5                                    ; ON EXIT:
 1776 A:d2d5                                    ;    [A] AND [X] HAVE BEEN MODIFIED.
 1777 A:d2d5                                    ;
 1778 A:d2d5                           GETSTK    
 1778 A:d2d5  0a                                 asl                    ;MULT [A] BY 2. NB, CLEARS C BIT.
 1779 A:d2d6  69 3e                              adc #(((2*23)+3)*1)+13;MAKE SURE 2*NUMLEV+13 LOCS
 1780 A:d2d8                                    ;(13 BECAUSE OF FBUFFR)
 1781 A:d2d8  b0 35                              bcs OMERR                ;WILL REMAIN IN STACK.
 1782 A:d2da  85 61                              sta INDEX1
 1783 A:d2dc  ba                                 tsx                    ;GET STACKED.
 1784 A:d2dd  e4 61                              cpx INDEX1                ;COMPARE.
 1785 A:d2df  90 2e                              bcc OMERR                ;IF STACK.LE.INDEX1, OM.
 1786 A:d2e1  60                                 rts 

 1788 A:d2e2                                    ;
 1789 A:d2e2                                    ; [Y,A] IS A CERTAIN ADDRESS. "REASON" MAKES SURE
 1790 A:d2e2                                    ; IT IS LESS THAN [FRETOP].
 1791 A:d2e2                                    ;
 1792 A:d2e2                           REASON    
 1792 A:d2e2  c4 73                              cpy FRETOP+1
 1793 A:d2e4  90 28                              bcc REARTS
 1794 A:d2e6  d0 04                              bne TRYMOR                ;GO GARB COLLECT.
 1795 A:d2e8  c5 72                              cmp FRETOP
 1796 A:d2ea  90 22                              bcc REARTS
 1797 A:d2ec                           TRYMOR    
 1797 A:d2ec  48                                 pha 
 1798 A:d2ed  a2 09                              ldx #8+1       ;IF TEMPF2 HAS ZERO IN BETWEEN.
 1799 A:d2ef  98                                 tya 
 1800 A:d2f0                           REASAV    
 1800 A:d2f0  48                                 pha 
 1801 A:d2f1  b5 96                              lda HIGHDS-1,X        ;SAVE HIGHDS ON STACK.
 1802 A:d2f3  ca                                 dex 
 1803 A:d2f4  10 fa                              bpl REASAV                ;PUT 8 OF THEM ON STK.
 1804 A:d2f6  20 10 e3                           jsr GARBA2                ;GO GARB COLLECT.
 1805 A:d2f9  a2 f7                              ldx #256-8-1
 1806 A:d2fb                           REASTO    
 1806 A:d2fb  68                                 pla 
 1807 A:d2fc  95 a0                              sta HIGHDS+8+1,X  ;RESTORE AFTER GARB COLLECT.
 1808 A:d2fe  e8                                 inx 
 1809 A:d2ff  30 fa                              bmi REASTO
 1810 A:d301  68                                 pla 
 1811 A:d302  a8                                 tay 
 1812 A:d303  68                                 pla                    ;RESTORE A AND Y.
 1813 A:d304  c4 73                              cpy FRETOP+1          ;COMPARE HIGHS
 1814 A:d306  90 06                              bcc REARTS
 1815 A:d308  d0 05                              bne OMERR                ;HIGHER IS BAD.
 1816 A:d30a  c5 72                              cmp FRETOP                ;AND THE LOWS.
 1817 A:d30c  b0 01                              bcs OMERR
 1818 A:d30e                           REARTS    
 1818 A:d30e  60                                 rts 

