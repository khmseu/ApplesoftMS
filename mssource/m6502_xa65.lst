 2406 A:d59e  a9 ff                              lda #255
 2407 A:d5a0  85 53                              sta LINNUM
 2408 A:d5a2  85 54                              sta LINNUM+1          ;MAKE IT HUGE.
 2409 A:d5a4                           LIST4     
 2409 A:d5a4  a0 01                              ldy #1

 2414 A:d5a6  b1 9e                              lda (LOWTR),Y            ;IS LINK ZERO?
 2415 A:d5a8  f0 3b                              beq GRODY                ;YES, GO TO READY.

 2418 A:d5aa  20 e1 ff                           jsr 65505

 2420 A:d5ad  20 97 d9                           jsr CRDO                ;PRINT CRLF TO START WITH.
 2421 A:d5b0  c8                                 iny 
 2422 A:d5b1  b1 9e                              lda (LOWTR),Y
 2423 A:d5b3  aa                                 tax 
 2424 A:d5b4  c8                                 iny 
