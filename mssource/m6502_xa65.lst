 7465 A:eda4                           EXP       
 7465 A:eda4                                    
 7466 A:eda4                                    ;MULTIPLY BY LOG(E) BASE 2.
 7467 A:eda4  a9 76                              lda #LOGEB2&255
 7468 A:eda6  a0 ed                              ldy #LOGEB2/256
 7469 A:eda8  20 18 e8                           jsr FMULT
 7470 A:edab  a5 af                              lda FACOV
 7471 A:edad  69 50                              adc #80
 7472 A:edaf  90 07                              bcc STOLD
