 7497 A:edeb  85 af                              sta FACOV
 7498 A:eded  20 4f e6                           jsr FSUBT
 7499 A:edf0  20 77 ed                           jsr NEGOP                ;NEGATE FAC.

 7501 A:edf3  a9 87                              lda #EXPCON&255
 7502 A:edf5  a0 ed                              ldy #EXPCON/256
 7503 A:edf7  20 19 ee                           jsr POLY
 7504 A:edfa                                    ;MULTIPLY BY POSITIVE 1.0.
 7505 A:edfa  a9 00                              lda #0
 7506 A:edfc  85 ae                              sta ARISGN
 7507 A:edfe  68                                 pla                    ;GET SCALE FACTOR.
 7508 A:edff  20 b5 e8                           jsr MLDEXP                ;MODIFY FACEXP AND CHECK FOR OVERFLOW.
 7509 A:ee02  60                                 rts                    ;HAS TO DO JSR DUE TO PULAS IN MULDIV.

 7512 A:ee03                                    ; PAGE
 7513 A:ee03                                    ; SUBTTL POLYNOMIAL EVALUATOR AND THE RANDOM NUMBER GENERATOR.
 7514 A:ee03                                    ;EVALUATE P(X^2)*X
 7515 A:ee03                                    ;POINTER TO DEGREE IS IN [Y,A].
 7516 A:ee03                                    ;THE CONSTANTS FOLLOW THE DEGREE.
 7517 A:ee03                                    ;FOR X=FAC, COMPUTE:
 7518 A:ee03                                    ; C0*X+C1*X^3+C2*X^5+C3*X^7+...+C(N)*X^(2*N+1)
 7519 A:ee03                           POLYX     
 7519 A:ee03                                    ;RETAIN POLYNOMIAL POINTER FOR LATER.
 7520 A:ee03  85 b0                              sta FBUFPT
 7521 A:ee05  84 b1                              sty FBUFPT+1
 7522 A:ee07  20 cc e9                           jsr MOV1F                ;SAVE FAC IN FACTMP.
 7523 A:ee0a  a9 96                              lda #TEMPF1
 7524 A:ee0c  20 24 e8                           jsr FMULT                ;COMPUTE X^2.
 7525 A:ee0f  20 1d ee                           jsr POLY1                ;COMPUTE P(X^2).

 7527 A:ee12  a9 96                              lda #TEMPF1&255
 7528 A:ee14  a0 00                              ldy #TEMPF1/256
 7529 A:ee16  4c 24 e8                           jmp FMULT                ;MULTIPLY BY FAC AGAIN.

 7531 A:ee19                                    ;POLYNOMIAL EVALUATOR.
 7532 A:ee19                                    ;POINTER TO DEGREE IS IN [Y,A].
 7533 A:ee19                                    ;COMPUTE:
 7534 A:ee19                                    ; C0+C1*X+C2*X^2+C3*X^3+C4*X^4+...+C(N-1)*X^(N-1)+C(N)*X^N.
 7535 A:ee19                           POLY      
 7535 A:ee19                                    
 7536 A:ee19  85 b0                              sta FBUFPT
 7537 A:ee1b  84 b1                              sty FBUFPT+1
 7538 A:ee1d                           POLY1     
 7538 A:ee1d  20 c6 e9                           jsr MOV2F                ;SAVE FAC.
 7539 A:ee20  b1 b0                              lda (FBUFPT),Y
 7540 A:ee22  85 a6                              sta SGNFLG
 7541 A:ee24  a4 b0                              ldy FBUFPT
 7542 A:ee26  c8                                 iny 
 7543 A:ee27  98                                 tya 
 7544 A:ee28  d0 06                              bne POLY3
 7545 A:ee2a  e6 b1                              inc FBUFPT+1
 7546 A:ee2c                           POLY3     
 7546 A:ee2c  85 b0                              sta FBUFPT
 7547 A:ee2e  a4 b1                              ldy FBUFPT+1
 7548 A:ee30                           POLY2     
 7548 A:ee30  20 24 e8                           jsr FMULT
 7549 A:ee33                                    ;GET CURRENT POINTER.
 7550 A:ee33  a5 b0                              lda FBUFPT
 7551 A:ee35  a4 b1                              ldy FBUFPT+1
 7552 A:ee37  18                                 clc 
 7553 A:ee38  69 05                              adc #4+1
 7554 A:ee3a  90 05                              bcc POLY4
 7555 A:ee3c  c8                                 iny 
 7556 A:ee3d                           POLY4     
 7556 A:ee3d                                    
 7557 A:ee3d  85 b0                              sta FBUFPT
 7558 A:ee3f  84 b1                              sty FBUFPT+1
 7559 A:ee41  20 63 e6                           jsr FADD                ;ADD IN CONSTANT.
 7560 A:ee44                                    ;MULTIPLY THE ORIGINAL FAC.
 7561 A:ee44  a9 9b                              lda #TEMPF2&255
 7562 A:ee46  a0 00                              ldy #TEMPF2/256
 7563 A:ee48  c6 a6                              dec SGNFLG                ;DONE?
 7564 A:ee4a  d0 e4                              bne POLY2
 7565 A:ee4c                           RANDRT    
 7565 A:ee4c  60                                 rts                    ;YES.

 7567 A:ee4d                                    ;PSUEDO-RANDOM NUMBER GENERATOR.
 7568 A:ee4d                                    ;IF ARG=0, THE LAST RANDOM NUMBER GENERATED IS RETURNED.
 7569 A:ee4d                                    ;IF ARG .LT. 0, A NEW SEQUENCE OF RANDOM NUMBERS IS
 7570 A:ee4d                                    ;STARTED USING THE ARGUMENT.
 7571 A:ee4d                                    ;   TO FORM THE NEXT RANDOM NUMBER IN THE SEQUENCE,
 7572 A:ee4d                                    ;MULTIPLY THE PREVIOUS RANDOM NUMBER BY A RANDOM CONSTANT
 7573 A:ee4d                                    ;AND ADD IN ANOTHER RANDOM CONSTANT. THE THEN HO
 7574 A:ee4d                                    ;AND LO BYTES ARE SWITCHED, THE EXPONENT IS PUT WHERE
 7575 A:ee4d                                    ;IT WILL BE SHIFTED IN BY NORMAL, AND THE EXPONENT IN THE FAC
 7576 A:ee4d                                    ;IS SET TO 200 SO THE RESULT WILL BE LESS THAN 1. THIS
 7577 A:ee4d                                    ;IS THEN NORMALIZED AND SAVED FOR THE NEXT TIME.
 7578 A:ee4d                                    ;THE HO AND LOW BYTES WERE SWITCHED SO THERE WILL BE A
 7579 A:ee4d                                    ;RANDOM CHANCE OF GETTING A NUMBER LESS THAN OR GREATER
 7580 A:ee4d                                    ;THAN .5 .

 7582 A:ee4d                           RMULZC    
 7582 A:ee4d  98                                 .byt 152
 7583 A:ee4e  35                                 .byt 53
 7584 A:ee4f  44                                 .byt 68
 7585 A:ee50  7a                                 .byt 122
 7586 A:ee51                           RADDZC    
 7586 A:ee51  68                                 .byt 104
 7587 A:ee52  28                                 .byt 40
 7588 A:ee53  b1                                 .byt 177
 7589 A:ee54  46                                 .byt 70

 7591 A:ee55                           RND       
 7591 A:ee55  20 2d ea                           jsr SIGN                ;GET SIGN INTO ACCX.

 7594 A:ee58  aa                                 tax 

 7596 A:ee59  30 1c                              bmi RND1                ;START NEW SEQUENCE IF NEGATIVE.

 7614 A:ee5b                           QSETNR    
 7614 A:ee5b                                    ;GET LAST ONE INTO FAC.
