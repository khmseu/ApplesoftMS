 2224 A:d4a0  b9 fb 01                           lda 512-5,Y
 2225 A:d4a3  f0 36                              beq CRDONE                ;NULL IMPLIES END OF LINE.
 2226 A:d4a5  38                                 sec                    ;PREPARE TO SUBSTARCT.
 2227 A:d4a6  e9 3a                              sbc #":"             ;IS IT A ":"?
 2228 A:d4a8  f0 04                              beq COLIS                ;YES, ALLOW CRUNCHING AGAIN.
 2229 A:d4aa  c9 45                              cmp #127-":"       ;IS IT A DATATK?
 2230 A:d4ac  d0 02                              bne NODATT                ;NO, SEE IF IT IS REM TOKEN.
 2231 A:d4ae                           COLIS     
 2231 A:d4ae  85 13                              sta DORES                ;SETUP FLAG.
 2232 A:d4b0                           NODATT    
 2232 A:d4b0  38                                 sec                    ;PREP TO SBCQ
 2233 A:d4b1  e9 45                              sbc #127-":"       ;REM ONLY STOPS ON NULL.
 2234 A:d4b3  d0 a8                              bne KLOOP                ;NO, CONTINUE CRUNCHING.
 2235 A:d4b5  85 0e                              sta ENDCHR                ;REM STOPS ONLY ON NULL, NOT : OR ".
 2236 A:d4b7                           STR1      
 2236 A:d4b7  bd 00 02                           lda 512,X
 2237 A:d4ba  f0 df                              beq STUFFH                ;YES, END OF LINE, SO DONE.
 2238 A:d4bc  c5 0e                              cmp ENDCHR                ;END OF GOBBLE?
 2239 A:d4be  f0 db                              beq STUFFH                ;YES, DONE WITH STRING.
 2240 A:d4c0                           STRNG     
 2240 A:d4c0  c8                                 iny                    ;INCREMENT BUFFER POINTER.
 2241 A:d4c1  99 fb 01                           sta 512-5,Y
 2242 A:d4c4  e8                                 inx 
