 7304 A:ed34                                    ; PAGE
 7305 A:ed34                                    ; SUBTTL EXPONENTIATION AND SQUARE ROOT FUNCTION.
 7306 A:ed34                                    ;SQUARE ROOT FUNCTION --- SQR(A)
 7307 A:ed34                                    ;USE SQR(X)=X^.5
 7308 A:ed34                           SQR       
 7308 A:ed34  20 0e ea                           jsr MOVAF                ;MOVE FAC INTO ARG.

 7310 A:ed37  a9 0b                              lda #FHALF&255
 7311 A:ed39  a0 ed                              ldy #FHALF/256
 7312 A:ed3b  20 a1 e9                           jsr MOVFM                ;PUT MEMORY INTO FAC.
 7313 A:ed3e                                    ;LAST THING FETCHED IS FACEXP. INTO ACCX.
 7314 A:ed3e                                    ; JMP FPWRT  ;FALL INTO FPWRT.

 7316 A:ed3e                                    ;EXPONENTIATION ---  X^Y.
 7317 A:ed3e                                    ;N.B.  0^0=1
 7318 A:ed3e                                    ;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
 7319 A:ed3e                                    ;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
 7320 A:ed3e                                    ;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
 7321 A:ed3e                                    ;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
 7322 A:ed3e                                    ;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
 7323 A:ed3e                                    ;RETURNED BY EXP.
 7324 A:ed3e                                    ;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
 7325 A:ed3e                           FPWRT     
 7325 A:ed3e  f0 74                              beq EXP                ;IF FAC=0, JUST EXPONENTIATE THAT.
 7326 A:ed40  a5 a8                              lda ARGEXP                ;IS X=0?
 7327 A:ed42  d0 07                              bne FPWRT1
 7328 A:ed44  4c f5 e6                           jmp ZEROF1                ;ZERO FAC.
 7329 A:ed47                           FPWRT1    
 7329 A:ed47                                    ;SAVE FOR LATER IN A TEMP.
 7330 A:ed47  a2 8d                              ldx #DEFPNT&255
 7331 A:ed49  a0 00                              ldy #DEFPNT/256
 7332 A:ed4b  20 d6 e9                           jsr MOVMF
 7333 A:ed4e                                    ;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
 7334 A:ed4e  a5 ad                              lda ARGSGN
 7335 A:ed50  10 13                              bpl FPWR1                ;NO PROBLEMS IF X.GT.0.
 7336 A:ed52  20 ce ea                           jsr INT                ;INTEGERIZE THE FAC.
 7337 A:ed55                                    ;GET ADDR OF COMPERAND.
 7338 A:ed55  a9 8d                              lda #DEFPNT&255
 7339 A:ed57  a0 00                              ldy #DEFPNT/256
 7340 A:ed59  20 5d ea                           jsr FCOMP                ;EQUAL?
 7341 A:ed5c  d0 07                              bne FPWR1                ;LEAVE X NEG. LOG WILL BLOW HIM OUT.
 7342 A:ed5e                                    ;A=-1 AND Y IS IRRELEVANT.
 7343 A:ed5e  98                                 tya                    ;NEGATE X. MAKE POSITIVE.
 7344 A:ed5f  a4 0d                              ldy CHARAC                ;GET EVENNESS.
 7345 A:ed61                           FPWR1     
 7345 A:ed61  20 00 ea                           jsr MOVFA1                ;ALTERNATE ENTRY POINT.
 7346 A:ed64  98                                 tya 
 7347 A:ed65  48                                 pha                    ;SAVE EVENNESS FOR LATER.
 7348 A:ed66  20 e6 e7                           jsr LOG                ;FIND LOG.
 7349 A:ed69                                    ;MULTIPLY FAC TIMES LOG(X).
 7350 A:ed69  a9 8d                              lda #DEFPNT&255
 7351 A:ed6b  a0 00                              ldy #DEFPNT/256
 7352 A:ed6d  20 24 e8                           jsr FMULT
 7353 A:ed70  20 b0 ed                           jsr EXP                ;EXPONENTIATE THE FAC.
 7354 A:ed73  68                                 pla 
 7355 A:ed74  4a                                 lsr                    ;IS IT EVEN?
 7356 A:ed75  90 0e                              bcc NEGRTS                ;YES. OR X.GT.0.
 7357 A:ed77                                    ;NEGATE THE NUMBER IN FAC.
 7358 A:ed77                           NEGOP     
 7358 A:ed77  a5 a0                              lda FACEXP
 7359 A:ed79  f0 0a                              beq NEGRTS

 7361 A:ed7b  a5 a5                              lda FACSGN
 7362 A:ed7d  49 ff                              eor #255
 7363 A:ed7f  85 a5                              sta FACSGN
 7364 A:ed81                           NEGRTS    
 7364 A:ed81  60                                 rts 

 7366 A:ed82                                    ; PAGE
 7367 A:ed82                                    ; SUBTTL EXPONENTIATION FUNCTION.
 7368 A:ed82                                    ;FIRST SAVE THE ORIGINAL ARGUMENT AND MULTIPLY THE FAC BY
 7369 A:ed82                                    ;LOG2(E). THE RESULT IS USED TO DETERMINE IF OVERFLOW
 7370 A:ed82                                    ;WILL OCCUR SINCE EXP(X)=2^(X*LOG2(E)) WHERE
 7371 A:ed82                                    ;LOG2(E)=LOG(E) BASE 2. THEN SAVE THE INTEGER PART OF
 7372 A:ed82                                    ;THIS TO SCALE THE ANSWER AT THE END. SINCE
 7373 A:ed82                                    ;2^Y=2^INT(Y)*2^(Y-INT(Y)) AND 2^INT(Y) IS EASY TO COMPUTE.
 7374 A:ed82                                    ;NOW COMPUTE 2^(X*LOG2(E)-INT(X*LOG2(E)) BY
 7375 A:ed82                                    ;P(LN(2)*(INT(X*LOG2(E))+1)-X) WHERE P IS AN APPROXIMATION
 7376 A:ed82                                    ;POLYNOMIAL. THE RESULT IS THEN SCALED BY THE POWER OF 2
 7377 A:ed82                                    ;PREVIOUSLY SAVED.

 7379 A:ed82                           LOGEB2    
 7379 A:ed82  81                                 .byt 129              ;LOG(E) BASE 2.
 7380 A:ed83  38                                 .byt 56
 7381 A:ed84  aa                                 .byt 170
 7382 A:ed85  3b                                 .byt 59

