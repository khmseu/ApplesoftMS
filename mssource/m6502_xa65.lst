 2355 A:d555                                    ;
 2356 A:d555                                    ; STKINI RESETS THE STACK POINTER ELIMINATING
 2357 A:d555                                    ; GOSUB AND FOR CONTEXT. STRING TEMPORARIES ARE FREED
 2358 A:d555                                    ; UP, SUBFLG IS RESET. CONTINUING IS PROHIBITED.
 2359 A:d555                                    ; AND A DUMMY ENTRY IS LEFT AT THE BOTTOM OF THE STACK SO "FNDFOR" WILL ALWAYS
 2360 A:d555                                    ; FIND A NON-"FOR" ENTRY AT THE BOTTOM OF THE STACK.
 2361 A:d555                                    ;
 2362 A:d555                           STKINI    
 2362 A:d555  a2 58                              ldx #TEMPST               ;INITIALIZE STRING TEMPORARIES.
 2363 A:d557  86 55                              stx TEMPPT
