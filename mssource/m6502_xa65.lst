 4823 A:17a2  a9 00                              lda #0
 4824 A:17a4  24 10                              bit DIMFLG
 4825 A:17a6  50 0a                              bvc NOTDIM                ;NOT IN A DIM STATEMENT.
 4826 A:17a8  68                                 pla                    ;GET LOW ORDER OF INDICE.
 4827 A:17a9  18                                 clc 
