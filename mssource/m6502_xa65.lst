 6864 A:221a                                    ; PAGE
 6865 A:221a                                    ; SUBTTL FLOATING POINT INPUT ROUTINE.
 6866 A:221a                                    ;NUMBER INPUT IS LEFT IN FAC.
 6867 A:221a                                    ;AT ENTRY [TXTPTR] POINTS TO THE FIRST CHARACTER IN A TEXT BUFFER.
 6868 A:221a                                    ;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS
 6869 A:221a                                    ;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE
 6870 A:221a                                    ;DECIMAL POINT IS. [DPTFLG] TELL WHETHER A DP HAS BEEN
 6871 A:221a                                    ;SEEN. [DECCNT] IS THE NUMBER OF DIGITS AFTER THE DP.
 6872 A:221a                                    ;AT THE END [DECCNT] AND THE EXPONENT ARE USED TO
 6873 A:221a                                    ;DETERMINE HOW MANY TIMES TO MULTIPLY OR DIVIDE BY TEN
 6874 A:221a                                    ;TO GET THE CORRECT NUMBER.
 6875 A:221a                           FIN       
 6875 A:221a  a0 00                              ldy #0             ;ZERO FACSGN&SGNFLG.
 6876 A:221c  a2 0a                              ldx #9+1       ;ZERO EXP AND HO (AND MOH).
 6877 A:221e                           FINZLP    
 6877 A:221e  94 9c                              sty LOWDS,X              ;ZERO MO AND LO.
 6878 A:2220  ca                                 dex                    ;ZERO TENEXP AND EXPSGN
 6879 A:2221  10 fb                              bpl FINZLP                ;ZERO DECCNT, DPTFLG.
 6880 A:2223  90 13                              bcc FINDGQ                ;FLAGS STILL SET FROM CHRGET.
 6881 A:2225  c9 2d                              cmp #"-"             ;A NEGATIVE SIGN?
 6882 A:2227  d0 08                              bne QPLUS                ;NO, TRY PLUS SIGN.
 6883 A:2229  86 a6                              stx SGNFLG                ;IT'S NEGATIVE. (X=377).
 6884 A:222b  f0 08                              beq FINC                ;ALWAYS BRANCHES.
 6885 A:222d                           QPLUS     
 6885 A:222d  c9 2b                              cmp #"+"             ;PLUS SIGN?
 6886 A:222f  d0 09                              bne FIN1                ;YES, SKIP IT.
 6887 A:2231                           FINC      
 6887 A:2231  20 b2 00                           jsr CHRGET
 6888 A:2234                           FINDGQ    
 6888 A:2234  90 5f                              bcc FINDIG
 6889 A:2236                           FIN1      
 6889 A:2236  c9 2a                              cmp #"*"             ;THE DP?
 6890 A:2238  f0 32                              beq FINDP                ;NO KIDDING.
 6891 A:223a  c9 45                              cmp #"E"             ;EXPONENT FOLLOWS.
 6892 A:223c  d0 34                              bne FINE                ;NO.
 6893 A:223e                                    ;HERE TO CHECK FOR SIGN OF EXP.
 6894 A:223e  20 b2 00                           jsr CHRGET                ;YES. GET ANOTHER.
 6895 A:2241  90 1b                              bcc FNEDG1                ;IT IS A DIGIT. (EASIER THAN
 6896 A:2243                                    ;BACKING UP POINTER.)
 6897 A:2243  c9 81                              cmp #129             ;MINUS?
 6898 A:2245  f0 12                              beq FINEC1                ;NEGATE.
 6899 A:2247  c9 2d                              cmp #"-"             ;MINUS SIGN?
 6900 A:2249  f0 0e                              beq FINEC1
 6901 A:224b  c9 81                              cmp #129             ;PLUS?
 6902 A:224d  f0 0c                              beq FINEC
 6903 A:224f  c9 2b                              cmp #"+"             ;PLUS SIGN?
 6904 A:2251  f0 08                              beq FINEC
 6905 A:2253  d0 0b                              bne FINEC2
 6906 A:2255                           FINEC1    
 6906 A:2255  66 9f                              ror LOWTR+1          ;TURN IT ON.
 6907 A:2257                           FINEC     
 6907 A:2257  20 b2 00                           jsr CHRGET                ;GET ANOTHER.
 6908 A:225a                           FNEDG1    
 6908 A:225a  90 60                              bcc FINEDG                ;IT IS A DIGIT.
 6909 A:225c                           FINEC2    
 6909 A:225c  24 9f                              bit LOWTR+1
 6910 A:225e  10 12                              bpl FINE
 6911 A:2260  a9 00                              lda #0
 6912 A:2262  38                                 sec 
 6913 A:2263  e5 9d                              sbc LOWDS+1
 6914 A:2265  4c 70 22                           jmp FINE1
 6915 A:2268                           FINDP     
 6915 A:2268  66 9e                              ror LOWTR
 6916 A:226a  24 9e                              bit LOWTR
 6917 A:226c  50 c3                              bvc FINC
 6918 A:226e                           FINE      
 6918 A:226e  a5 9d                              lda LOWDS+1
 6919 A:2270                           FINE1     
 6919 A:2270  38                                 sec 
 6920 A:2271  e5 9c                              sbc LOWDS                ;GET NUMBER OF PLACES TO SHIFT.
 6921 A:2273  85 9d                              sta LOWDS+1
 6922 A:2275  f0 16                              beq FINQNG                ;NEGATE?
 6923 A:2277  10 0d                              bpl FINMUL                ;POSITIVE SO MULTIPLY.
 6924 A:2279                           FINDIV    
 6924 A:2279  20 22 20                           jsr DIV10
 6925 A:227c  e6 9d                              inc LOWDS+1          ;DONE?
 6926 A:227e  d0 f9                              bne FINDIV                ;NO.
 6927 A:2280  f0 0b                              beq FINQNG                ;YES.
 6928 A:2282                           FINMUL    
 6928 A:2282  20 06 20                           jsr MUL10
 6929 A:2285  c6 9d                              dec LOWDS+1          ;DONE?
 6930 A:2287  d0 f9                              bne FINMUL                ;NO
 6931 A:2289                           FINQNG    
 6931 A:2289  a5 a6                              lda SGNFLG
 6932 A:228b  30 05                              bmi NEGXQS                ;IF POSITIVE, RETURN.
 6933 A:228d  60                                 rts 
 6934 A:228e                           NEGXQS    
 6934 A:228e  4c 9c 24                           jmp NEGOP                ;OTHERWISE, NEGATE AND RETURN.

 6936 A:2291                           FINDIG    
 6936 A:2291  48                                 pha 
 6937 A:2292  24 9e                              bit LOWTR
 6938 A:2294  10 06                              bpl FINDG1
 6939 A:2296  e6 9c                              inc LOWDS
 6940 A:2298                           FINDG1    
 6940 A:2298  20 06 20                           jsr MUL10
 6941 A:229b  68                                 pla                    ;GET IT BACK.
 6942 A:229c  38                                 sec 
 6943 A:229d  e9 30                              sbc #"0"
 6944 A:229f  20 a5 22                           jsr FINLOG                ;ADD IT IN.
 6945 A:22a2  4c 31 22                           jmp FINC

 6947 A:22a5                           FINLOG    
 6947 A:22a5  48                                 pha 
 6948 A:22a6  20 33 21                           jsr MOVAF                ;SAVE FAC FOR LATER.
 6949 A:22a9  68                                 pla 
 6950 A:22aa  20 63 21                           jsr FLOAT                ;FLOAT THE VALUE IN ACCA.
 6951 A:22ad  a5 ad                              lda ARGSGN
 6952 A:22af  45 a5                              eor FACSGN
 6953 A:22b1  85 ae                              sta ARISGN                ;RESULTANT SIGN.
 6954 A:22b3  a6 a0                              ldx FACEXP                ;SET SIGNS ON THING TO ADD.
 6955 A:22b5  4c 8b 1d                           jmp FADDT                ;ADD TOGETHER AND RETURN.

 6957 A:22b8                                    ;HERE PACK IN THE NEXT DIGIT OF THE EXPONENT.
 6958 A:22b8                                    ;MULTIPLY THE OLD EXP BY 10 AND ADD IN THE NEXT
 6959 A:22b8                                    ;DIGIT. NOTE: EXP OVERFLOW IS NOT CHECKED FOR.
 6960 A:22b8                           FINEDG    
 6960 A:22b8  a5 9d                              lda LOWDS+1          ;GET EXP SO FAR.
 6961 A:22ba  c9 0a                              cmp #10             ;WILL RESULT BE .GE. 100?
 6962 A:22bc  90 0d                              bcc MLEX10
 6963 A:22be  a9 64                              lda #100             ;GET 100.
 6964 A:22c0  24 9f                              bit LOWTR+1
 6965 A:22c2  30 15                              bmi MLEXMI                ;IF NEG EXP, NO CHK FOR OVERR.
 6966 A:22c4  4c 9f 1e                           jmp OVERR
 6967 A:22c7                           MLEX10    
 6967 A:22c7  0a                                 asl                    ;MULT BY 2 TWICE
 6968 A:22c8  0a                                 asl 
 6969 A:22c9  18                                 clc                    ;POSSIBLE SHIFT OUT OF HIGH.
 6970 A:22ca  65 9d                              adc LOWDS+1          ;LIKE MULTIPLYING BY FIVE.
 6971 A:22cc  0a                                 asl                    ;AND NOW BY TEN.
 6972 A:22cd  18                                 clc 
 6973 A:22ce  a0 00                              ldy #0
 6974 A:22d0  71 b9                              adc (CHRGOT+1),Y
 6975 A:22d2  38                                 sec 
 6976 A:22d3  e9 30                              sbc #"0"
 6977 A:22d5                           MLEXMI    
 6977 A:22d5  85 9d                              sta LOWDS+1          ;SAVE RESULT.
 6978 A:22d7  4c 57 22                           jmp FINEC
