 3843 A:dba2  00                                 .byt 0
 3844 A:dba3                                    ; PAGE
 3845 A:dba3                                    ; SUBTTL THE NEXT CODE IS THE "NEXT CODE"
 3846 A:dba3                                    ;
 3847 A:dba3                                    ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 3848 A:dba3                                    ;
 3849 A:dba3                                    ; LOW ADDRESS
 3850 A:dba3                                    ; TOKEN (FORTK) 1 BYTE
 3851 A:dba3                                    ; A POINTER TO THE LOOP VARIABLE 2 BYTES
 3852 A:dba3                                    ; THE STEP 4+ADDPRC BYTES
 3853 A:dba3                                    ; A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 3854 A:dba3                                    ; THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
 3855 A:dba3                                    ; THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 3856 A:dba3                                    ; A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 3857 A:dba3                                    ; HIGH ADDRESS
 3858 A:dba3                                    ;
 3859 A:dba3                                    ; TOTAL 16+2*ADDPRC BYTES.
 3860 A:dba3                                    ;
 3861 A:dba3                           NEXT      
 3861 A:dba3  d0 06                              bne GETFOR
 3862 A:dba5  a0 00                              ldy #0             ;WITHOUT ARG CALL "FNDFOR" WITH
 3863 A:dba7  f0 05                              beq STXFOR                ;[FORPNT]=0.
 3864 A:dba9                           GETFOR    
 3864 A:dba9  20 96 de                           jsr PTRGET                ;GET A POINTER TO LOOP VARIABLE
 3865 A:dbac                           STXFOR    
 3865 A:dbac                                    ;INTO "FORPNT".
 3866 A:dbac  85 88                              sta FORPNT
 3867 A:dbae  84 89                              sty FORPNT+1
 3868 A:dbb0  20 70 d2                           jsr FNDFOR                ;FIND THE MATCHING ENTRY IF ANY.
 3869 A:dbb3  f0 06                              beq HAVFOR
 3870 A:dbb5  a2 00                              ldx #0             ;"NEXT WITHOUT FOR".
 3871 A:dbb7                           ERRGO5    
 3871 A:dbb7  f0 6b                              beq ERRGO4
 3872 A:dbb9                           HAVFOR    
 3872 A:dbb9  9a                                 txs                    ;SETUP STACK. CHOP FIRST.
 3873 A:dbba  8a                                 txa 
 3874 A:dbbb  18                                 clc 
 3875 A:dbbc  69 04                              adc #4             ;POINT TO INCREMENT
 3876 A:dbbe  48                                 pha                    ;SAVE THIS POINTER TO RESTORE TO [A]
 3877 A:dbbf  69 06                              adc #5+1       ;POINT TO UPPER LIMIT
 3878 A:dbc1  85 63                              sta INDEX2                ;SAVE AS INDEX
 3879 A:dbc3  68                                 pla                    ;RESTORE POINTER TO INCREMENT
 3880 A:dbc4  a0 01                              ldy #1             ;SET HI ADDR OF THING TO MOVE.
 3881 A:dbc6  20 a1 e9                           jsr MOVFM                ;GET QUANTITY INTO THE FAC.
 3882 A:dbc9  ba                                 tsx 
 3883 A:dbca  bd 09 01                           lda 257+7+1,X, ;SET SIGN CORRECTLY.
 3884 A:dbcd  85 a5                              sta FACSGN

 3886 A:dbcf  a5 88                              lda FORPNT
 3887 A:dbd1  a4 89                              ldy FORPNT+1
 3888 A:dbd3  20 63 e6                           jsr FADD                ;ADD INC TO LOOP VARIABLE.
 3889 A:dbd6  20 d2 e9                           jsr MOVVF                ;PACK THE FAC INTO MEMORY.
 3890 A:dbd9  a0 01                              ldy #1
 3891 A:dbdb  20 5f ea                           jsr FCOMPN                ;COMPARE FAC WITH UPPER VALUE.
 3892 A:dbde  ba                                 tsx 
 3893 A:dbdf  38                                 sec 
 3894 A:dbe0  fd 09 01                           sbc 257+7+1,X, ;SUBTRACT SIGN OF INC FROM SIGN OF
 3895 A:dbe3                                    ;OF (CURRENT VALUE-FINAL VALUE).
 3896 A:dbe3  f0 19                              beq LOOPDN                ;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
 3897 A:dbe5                                    ;THEN LOOP IS DONE.
 3898 A:dbe5  bd 0f 01                           lda 2*1+12+257,X
 3899 A:dbe8  85 78                              sta CURLIN                ;STORE LINE NUMBER OF "FOR" STATEMENT.
 3900 A:dbea  bd 10 01                           lda 257+13+2*1,X
 3901 A:dbed  85 79                              sta CURLIN+1
 3902 A:dbef  bd 12 01                           lda 2*1+15+257,X
 3903 A:dbf2  85 b9                              sta CHRGOT+1          ;STORE TEXT PNTR INTO "FOR" STATEMENT.
 3904 A:dbf4  bd 11 01                           lda 2*1+14+257,X
 3905 A:dbf7  85 ba                              sta CHRGOT+1+1
 3906 A:dbf9                           NEWSGO    
 3906 A:dbf9  4c 72 d6                           jmp NEWSTT                ;PROCESS NEXT STATEMENT.
 3907 A:dbfc                           LOOPDN    
 3907 A:dbfc  8a                                 txa 
 3908 A:dbfd  69 11                              adc #(2*1)+15;ADDS 16 WITH CARRY.
 3909 A:dbff  aa                                 tax 
 3910 A:dc00  9a                                 txs                    ;NEW STACK PNTR.
 3911 A:dc01  20 b8 00                           jsr CHRGOT
 3912 A:dc04  c9 2c                              cmp #44             ;COMMA AT END?
 3913 A:dc06  d0 f1                              bne NEWSGO
 3914 A:dc08  20 b2 00                           jsr CHRGET
 3915 A:dc0b  20 a9 db                           jsr GETFOR                ;DO NEXT BUT DON'T ALLOW BLANK VARIABLE
 3916 A:dc0e                                    ;PNTR. [VARPNT] IS THE STK PNTR WHICH
 3917 A:dc0e                                    ;NEVER MATCHES ANY POINTER.
 3918 A:dc0e                                    ;JSR TO PUT ON DUMMY NEWSTT ADDR.

 3920 A:dc0e                                    ; SUBTTL FORMULA EVALUATION CODE.
 3921 A:dc0e                                    ;
 3922 A:dc0e                                    ; THESE ROUTINES CHECK FOR CERTAIN "VALTYP".
 3923 A:dc0e                                    ; [C] IS NOT PRESERVED.
 3924 A:dc0e                                    ;
 3925 A:dc0e                           FRMNUM    
 3925 A:dc0e  20 25 dc                           jsr FRMEVL
 3926 A:dc11                           CHKNUM    
 3926 A:dc11  18                                 clc 
 3927 A:dc12  00 02 24 00                        .word 512,36
 3928 A:dc16                           CHKSTR    
 3928 A:dc16  38                                 sec                    ;SET CARRY.
 3929 A:dc17                           CHKVAL    
 3929 A:dc17  24 11                              bit VALTYP                ;WILL NOT F UP "VALTYP".
 3930 A:dc19  30 05                              bmi DOCSTR
 3931 A:dc1b  b0 05                              bcs CHKERR
 3932 A:dc1d                           CHKOK     
 3932 A:dc1d  60                                 rts 
 3933 A:dc1e                           DOCSTR    
 3933 A:dc1e  b0 fd                              bcs CHKOK
 3934 A:dc20                           CHKERR    
 3934 A:dc20  a2 a3                              ldx #163
 3935 A:dc22                           ERRGO4    
 3935 A:dc22  4c 1d d3                           jmp ERROR
 3936 A:dc25                                    ;
 3937 A:dc25                                    ; THE FORMULA EVALUATOR STARTS WITH
 3938 A:dc25                                    ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
 3939 A:dc25                                    ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
 3940 A:dc25                                    ; THE RESULT IS LEFT IN THE FAC.
 3941 A:dc25                                    ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
 3942 A:dc25                                    ;
 3943 A:dc25                                    ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
 3944 A:dc25                                    ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR 
 3945 A:dc25                                    ; EACH OPERATOR.
 3946 A:dc25                                    ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
 3947 A:dc25                                    ; THE ADDRESS OF THE OPERATOR ROUTINE.
 3948 A:dc25                                    ; THE FLOATING POINT TEMPORARY RESULT.
 3949 A:dc25                                    ; THE PRECEDENCE OF THE OPERATOR.
 3950 A:dc25                                    ;
 3951 A:dc25                           FRMEVL    
 3951 A:dc25  a6 b9                              ldx CHRGOT+1
 3952 A:dc27  d0 04                              bne FRMEV1
 3953 A:dc29  c6 ba                              dec CHRGOT+1+1
 3954 A:dc2b                           FRMEV1    
 3954 A:dc2b  c6 b9                              dec CHRGOT+1
 3955 A:dc2d  a2 00                              ldx #0             ;INITIAL DUMMY PRECEDENCE IS 0.
 3956 A:dc2f  00 02 24 00                        .word 512,36
 3957 A:dc33                           LPOPER    
 3957 A:dc33  48                                 pha                    ;SAVE LOW PRECEDENCE. (MASK.)
 3958 A:dc34  8a                                 txa 
 3959 A:dc35  48                                 pha                    ;SAVE HIGH PRECEDENCE.
 3960 A:dc36  a9 01                              lda #1
 3961 A:dc38  20 e1 d2                           jsr GETSTK                ;MAKE SURE THERE IS ROOM FOR
 3962 A:dc3b                                    ;RECURSIVE CALLS.
 3963 A:dc3b  20 0d dd                           jsr EVAL                ;EVALUATE SOMETHING.
 3964 A:dc3e                                    ;PREPARE TO BUILD MASK MAYBE.
 3965 A:dc3e  a9 00                              lda #0
 3966 A:dc40  85 8c                              sta OPMASK
 3967 A:dc42                           TSTOP     
 3967 A:dc42  20 b8 00                           jsr CHRGOT                ;REGET LAST CHARACTER.
 3968 A:dc45                           LOPREL    
 3968 A:dc45  38                                 sec                    ;PREP TO SUBTRACT.
 3969 A:dc46  e9 82                              sbc #130             ;IS CURRENT CHARACTER A RELATION?
 3970 A:dc48  90 19                              bcc ENDREL                ;NO. RELATIONS ALL THROUGH.
