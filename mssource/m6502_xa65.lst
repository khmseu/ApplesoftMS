 5857 A:e629                                    ; THE WAIT LOCATION,MASK1,MASK2 STATEMENT WAITS UNTIL THE CONTENTS
 5858 A:e629                                    ; OF LOCATION IS NONZERO WHEN XORED WITH MASK2
 5859 A:e629                                    ; AND THEN ANDED WITH MASK1. IF MASK2 IS NOT PRESENT, IT
 5860 A:e629                                    ; IS ASSUMED TO BE ZERO.

 5862 A:e629                           FNWAIT    
 5862 A:e629  20 e7 e5                           jsr GETNUM
 5863 A:e62c  86 88                              stx FORPNT
 5864 A:e62e  a2 00                              ldx #0
 5865 A:e630  20 b8 00                           jsr CHRGOT
 5866 A:e633  f0 07                              beq STORDO
 5867 A:e635  20 ed e5                           jsr COMBYT                ;GET MASK2.
 5868 A:e638                           STORDO    
 5868 A:e638  86 89                              stx FORPNT+1
 5869 A:e63a  a0 00                              ldy #0
 5870 A:e63c                           WAITER    
 5870 A:e63c  b1 53                              lda (LINNUM),Y
 5871 A:e63e  45 89                              eor FORPNT+1
 5872 A:e640  25 88                              and FORPNT
 5873 A:e642  f0 f8                              beq WAITER
 5874 A:e644                           ZERRTS    
 5874 A:e644  60                                 rts                    ;GOT A NONZERO.

 5876 A:e645                                    ; SUBTTL FLOATING POINT MATH PACKAGE CONFIGURATION.

 5878 A:e645                                    ; RADIX 8 ;!!!! ALERT !!!!
 5879 A:e645                                    ;THROUGHOUT THE MATH PACKAGE.
 5880 A:e645                                    ; COMMENT %
 5881 A:e645                                    ; THE FLOATING POINT FORMAT IS AS FOLLOWS:
 5882 A:e645                                    ;
 5883 A:e645                                    ; THE SIGN IS THE FIRST BIT OF THE MANTISSA.
 5884 A:e645                                    ; THE MANTISSA IS 24 BITS LONG.
 5885 A:e645                                    ; THE BINARY POINT IS TO THE LEFT OF THE MSB.
 5886 A:e645                                    ; NUMBER = MANTISSA * 2 ^ EXPONENT.
 5887 A:e645                                    ; THE MANTISSA IS POSITIVE WITH A ONE ASSUMED TO BE WHERE THE SIGN BIT IS.
 5888 A:e645                                    ; THE SIGN OF THE EXPONENT IS THE FIRST BIT OF THE EXPONENT.
 5889 A:e645                                    ; THE EXPONENT IS STORED IN EXCESS 200, I.E. WITH A BIAS OF +200.
 5890 A:e645                                    ; SO, THE EXPONENT IS A SIGNED 8-BIT NUMBER WITH 200 ADDED TO IT.
 5891 A:e645                                    ; AN EXPONENT OF ZERO MEANS THE NUMBER IS ZERO.
 5892 A:e645                                    ; THE OTHER BYTES MAY NOT BE ASSUMED TO BE ZERO.
 5893 A:e645                                    ; TO KEEP THE SAME NUMBER IN THE FAC WHILE SHIFTING,
 5894 A:e645                                    ;  TO SHIFT RIGHT, EXP:=EXP+1
 5895 A:e645                                    ;  TO SHIFT LEFT, EXP:=EXP-1
 5896 A:e645                                    ;
 5897 A:e645                                    ; IN MEMORY THE NUMBER LOOKS LIKE THIS:
 5898 A:e645                                    ;  [THE EXPONENT AS A SIGNED NUMBER +200]
 5899 A:e645                                    ;  [THE SIGN BIT IN 7, BITS 2-8 OF MANTISSA ARE IN BITS 6-0].
 5900 A:e645                                    ;   (REMEMBER BIT 1 OF MANTISSA IS ALWAYS A ONE.)
 5901 A:e645                                    ;  [BITS 9-16 OF THE MANTISSA]
 5902 A:e645                                    ;  [BITS 17-24] OF THE MANTISSA]
 5903 A:e645                                    ;
 5904 A:e645                                    ; ARITHMETIC ROUTINE CALLING CONVENTIONS:
 5905 A:e645                                    ;
 5906 A:e645                                    ; FOR ONE ARGUMENT FUNCTIONS:
 5907 A:e645                                    ;  THE ARGUMENT IS IN THE FAC.
 5908 A:e645                                    ;  THE RESULT IS LEFT IN THE FAC.
 5909 A:e645                                    ; FOR TWO ARGUMENT OPERATIONS:
 5910 A:e645                                    ;  THE FIRST ARGUMENT IS IN ARG (ARGEXP,HO,MO,LO AND ARGSGN).
 5911 A:e645                                    ;  THE SECOND ARGUMENT IS IN THE FAC.
 5912 A:e645                                    ;  THE RESULT IS LEFT IN THE FAC.
 5913 A:e645                                    ;
 5914 A:e645                                    ; THE "T" ENTRY POINTS TO THE TWO-ARGUMENT OPERATIONS HAVE BOTH ARGUMENTS
 5915 A:e645                                    ; SETUP IN THE RESPECTIVE REGISTERS. BEFORE CALLING ARG MAY HAVE BEEN
 5916 A:e645                                    ; POPPED OFF THE STACK AND INTO ARG, FOR EXAMPLE.
 5917 A:e645                                    ; THE OTHER ENTRY POINT ASSUMES [Y,A] POINTS TO THE ARGUMENT
 5918 A:e645                                    ; SOMEWHERE IN MEMORY. IT IS UNPACKED INTO ARG BY "CONUPK".
 5919 A:e645                                    ;
 5920 A:e645                                    ; ON THE STACK, THE SGN IS PUSHED ON FIRST, THE LO,MO,HO AND FINALLY EXP.
 5921 A:e645                                    ; NOTE ALL THINGS ARE KEPT UNPACKED IN ARG, FAC AND ON THE STACK.
 5922 A:e645                                    ;
 5923 A:e645                                    ; IT IS ONLY WHEN SOMETHING IS STORED AWAY THAT IT IS PACKED TO FOUR
 5924 A:e645                                    ; BYTES. THE UNPACKED FORMAT HAS A SGN BYTE REFLECTING THE SIGN OF THE
 5925 A:e645                                    ; NUMBER (POSITIVE=0, NEGATIVE=-1) A HO,MO AND LO WITH THE HIGH BIT
 5926 A:e645                                    ; OF THE HO TURNED ON. THE EXP IS THE SAME AS STORED FORMAT.
 5927 A:e645                                    ; THIS IS DONE FOR SPEED OF OPERATION.
 5928 A:e645                                    ; %
 5929 A:e645                                    ; PAGE
 5930 A:e645                                    ; SUBTTL FLOATING POINT ADDITION AND SUBTRACTION.
 5931 A:e645                           FADDH     
 5931 A:e645                                    ;ENTRY TO ADD 1/2.
 5932 A:e645  a9 0b                              lda #FHALF&255
 5933 A:e647  a0 ed                              ldy #FHALF/256
 5934 A:e649  4c 63 e6                           jmp FADD                ;UNPACK AND GO ADD IT.
 5935 A:e64c                           FSUB      
 5935 A:e64c  20 88 e8                           jsr CONUPK                ;UNPACK ARGUMENT INTO ARG.
 5936 A:e64f                           FSUBT     
 5936 A:e64f  a5 a5                              lda FACSGN
 5937 A:e651  49 ff                              eor #255             ;COMPLEMENT IT.
 5938 A:e653  85 a5                              sta FACSGN
