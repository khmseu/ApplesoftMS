 7704 A:25f4  a0 26                              ldy #FR4/256
 7705 A:25f6  20 88 1d                           jsr FADD
 7706 A:25f9  68                                 pla 
 7707 A:25fa  10 07                              bpl SIN3
 7708 A:25fc  20 9c 24                           jsr NEGOP
 7709 A:25ff                           SIN3      
