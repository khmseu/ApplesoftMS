 4537 A:165d  a9 32                              lda #ZERO&255
 4538 A:165f  a0 24                              ldy #ZERO/256
 4539 A:1661  60                                 rts                    ;FOR STRINGS OR NUMERIC.
 4540 A:1662                                    ;AND FOR INTEGERS TOO.
 4541 A:1662                           NOTEVL    
 4541 A:1662                                    

 4561 A:1662                           QSTAVR    
 4561 A:1662                                    

 4569 A:1662                           VAROK     
