 6003 A:e681  84 a5                              sty FACSGN                ;SIGN IS SIGN OF RESULT.
 6004 A:e683  49 ff                              eor #255             ;SHIFT A NEGATIVE NUMBER OF PLACES.
 6005 A:e685  69 00                              adc #0             ;COMPLETE NEGATION. W/ C=1.
