 1665 A:0996                                    ; PAGE
 1666 A:0996                                    ; SUBTTL GENERAL STORAGE MANAGEMENT ROUTINES.
 1667 A:0996                                    ;
 1668 A:0996                                    ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
 1669 A:0996                                    ;

 1671 A:0996                           FNDFOR    
 1671 A:0996  ba                                 tsx                    ;LOAD XREG WITH STK PNTR.
 1672 A:0997  e8                                 inx 
 1673 A:0998  e8                                 inx 
 1674 A:0999  e8                                 inx 
 1675 A:099a  e8                                 inx 
 1676 A:099b                           FFLOOP    
 1676 A:099b  bd 01 01                           lda 257,X            ;GET STACK ENTRY.
 1677 A:099e  c9 7f                              cmp #127             ;IS IT A "FOR" TOKEN?
 1678 A:09a0  d0 21                              bne FFRTS                ;NO, NO "FOR" LOOPS WITH THIS PNTR.
 1679 A:09a2  a5 89                              lda FORPNT+1          ;GET HIGH.
 1680 A:09a4  d0 0a                              bne CMPFOR
 1681 A:09a6  bd 02 01                           lda 258,X            ;PNTR IS ZERO, SO ASSUME THIS ONE.
 1682 A:09a9  85 88                              sta FORPNT
 1683 A:09ab  bd 03 01                           lda 259,X
 1684 A:09ae  85 89                              sta FORPNT+1
 1685 A:09b0                           CMPFOR    
 1685 A:09b0  dd 03 01                           cmp 259,X
 1686 A:09b3  d0 07                              bne ADDFRS                ;NOT THIS ONE.
 1687 A:09b5  a5 88                              lda FORPNT                ;GET DOWN.
 1688 A:09b7  dd 02 01                           cmp 258,X
 1689 A:09ba  f0 07                              beq FFRTS                ;WE GOT IT! WE GOT IT!
 1690 A:09bc                           ADDFRS    
 1690 A:09bc  8a                                 txa 
 1691 A:09bd  18                                 clc                    ;ADD 16 TO X.
 1692 A:09be  69 12                              adc #18
 1693 A:09c0  aa                                 tax                    ;RESULT BACK INTO X.
 1694 A:09c1  d0 d8                              bne FFLOOP
 1695 A:09c3                           FFRTS     
 1695 A:09c3  60                                 rts                    ;RETURN TO CALLER.

 1697 A:09c4                                    ;
 1698 A:09c4                                    ; THIS IS THE BLOCK TRANSFER ROUTINE.
 1699 A:09c4                                    ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
 1700 A:09c4                                    ;
 1701 A:09c4                                    ; ON ENTRY:
 1702 A:09c4                                    ; [Y,A]=[HIGHDS]    (FOR REASON).
 1703 A:09c4                                    ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
 1704 A:09c4                                    ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
 1705 A:09c4                                    ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
 1706 A:09c4                                    ;
 1707 A:09c4                                    ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
 1708 A:09c4                                    ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
 1709 A:09c4                                    ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
 1710 A:09c4                                    ;
 1711 A:09c4                                    ; ON EXIT:
 1712 A:09c4                                    ; [LOWTR] ARE UNCHANGED.
 1713 A:09c4                                    ; [HIGHTR]=[LOWTR]-200 OCTAL.
 1714 A:09c4                                    ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
 1715 A:09c4                                    ;
 1716 A:09c4                           BLTU      
 1716 A:09c4  20 14 0a                           jsr REASON                ;ASCERTAIN THAT STRING SPACE WON'T
 1717 A:09c7                                    ;BE OVERRUN.

 1719 A:09c7  85 70                              sta STREND
 1720 A:09c9  84 71                              sty STREND+1
 1721 A:09cb                           BLTUC     
 1721 A:09cb  38                                 sec                    ;PREPARE TO SUBTRACT.
 1722 A:09cc  a5 99                              lda HIGHTR
 1723 A:09ce  e5 9e                              sbc LOWTR                ;COMPUTE NUMBER OF THINGS TO MOVE.
 1724 A:09d0  85 61                              sta INDEX1                ;SAVE FOR LATER.
 1725 A:09d2  a8                                 tay 
 1726 A:09d3  a5 9a                              lda HIGHTR+1
 1727 A:09d5  e5 9f                              sbc LOWTR+1
 1728 A:09d7  aa                                 tax                    ;PUT IT IN A COUNTER REGISTER.
 1729 A:09d8  e8                                 inx                    ;SO THAT COUNTER ALGORITHM WORKS.
 1730 A:09d9  98                                 tya                    ;SEE IF LOW PART OF COUNT IS ZERO.
 1731 A:09da  f0 23                              beq DECBLT                ;YES, GO START MOVING BLOCKS.
 1732 A:09dc  a5 99                              lda HIGHTR                ;NO, MUST MODIFY BASE ADDR.
 1733 A:09de  38                                 sec 
 1734 A:09df  e5 61                              sbc INDEX1                ;BORROW IS OFF SINCE [HIGHTR].GT.[LOWTR].
 1735 A:09e1  85 99                              sta HIGHTR                ;SAVE MODIFIED BASE ADDR.
 1736 A:09e3  b0 03                              bcs BLT1                ;IF NO BORROW, GO SHOVE IT.
 1737 A:09e5  c6 9a                              dec HIGHTR+1          ;BORROW IMPLIES SUB 1 FROM HIGH ORDER.
 1738 A:09e7  38                                 sec 
 1739 A:09e8                           BLT1      
 1739 A:09e8  a5 97                              lda HIGHDS                ;MOD BASE OF DEST ADDR.
 1740 A:09ea  e5 61                              sbc INDEX1
 1741 A:09ec  85 97                              sta HIGHDS
 1742 A:09ee  b0 08                              bcs MOREN1                ;NO BORROW.
 1743 A:09f0  c6 98                              dec HIGHDS+1          ;DECREMENT HIGH ORDER BYTE.
 1744 A:09f2  90 04                              bcc MOREN1                ;ALWAYS SKIP.
 1745 A:09f4                           BLTLP     
 1745 A:09f4  b1 99                              lda (HIGHTR),Y            ;FETCH BYTE TO MOVE
 1746 A:09f6  91 97                              sta (HIGHDS),Y            ;MOVE IT IN, MOVE IT OUT.
 1747 A:09f8                           MOREN1    
 1747 A:09f8  88                                 dey 
 1748 A:09f9  d0 f9                              bne BLTLP
 1749 A:09fb  b1 99                              lda (HIGHTR),Y            ;MOVE LAST OF THE BLOCK.
 1750 A:09fd  91 97                              sta (HIGHDS),Y
 1751 A:09ff                           DECBLT    
 1751 A:09ff  c6 9a                              dec HIGHTR+1
 1752 A:0a01  c6 98                              dec HIGHDS+1          ;START ON NEW BLOCKS.
 1753 A:0a03  ca                                 dex 
 1754 A:0a04  d0 f2                              bne MOREN1
 1755 A:0a06  60                                 rts                    ;RETURN TO CALLER.

 1757 A:0a07                                    ;
 1758 A:0a07                                    ; THIS ROUTINE IS USED TO ASCERTAIN THAT A GIVEN
 1759 A:0a07                                    ; NUMBER OF LOCS REMAIN AVAILABLE FOR THE STACK.
 1760 A:0a07                                    ;    THE CALL IS:
 1761 A:0a07                                    ; LDAI NUMBER OF 2-BYTE ENTRIES NEEDED.
 1762 A:0a07                                    ; JSR GETSTK
 1763 A:0a07                                    ;
 1764 A:0a07                                    ; THIS ROUTINE MUST BE CALLED BY ANY ROUTINE WHICH PUTS
 1765 A:0a07                                    ; AN ARBITRARY AMOUNT OF STUFF ON THE STACK,
 1766 A:0a07                                    ; I.E., ANY RECURSIVE ROUTINE LIKE "FRMEVL".
 1767 A:0a07                                    ; IT IS ALSO CALLED BY ROUTINES SUCH AS "GOSUB" AND "FOR"
 1768 A:0a07                                    ; WHICH MAKE PERMANENT ENTRIES ON THE STACK.
 1769 A:0a07                                    ;
 1770 A:0a07                                    ; ROUTINES WHICH MERELY USE AND FREE UP THE GUARANTEED
 1771 A:0a07                                    ; NUMLEV LOCATIONS NEED NOT CALL THIS.
 1772 A:0a07                                    ;
 1773 A:0a07                                    ;
 1774 A:0a07                                    ; ON EXIT:
 1775 A:0a07                                    ;    [A] AND [X] HAVE BEEN MODIFIED.
 1776 A:0a07                                    ;
 1777 A:0a07                           GETSTK    
 1777 A:0a07  0a                                 asl                    ;MULT [A] BY 2. NB, CLEARS C BIT.
 1778 A:0a08  69 3e                              adc #(((2*23)+3)*1)+13;MAKE SURE 2*NUMLEV+13 LOCS
 1779 A:0a0a                                    ;(13 BECAUSE OF FBUFFR)
 1780 A:0a0a  b0 35                              bcs OMERR                ;WILL REMAIN IN STACK.
 1781 A:0a0c  85 61                              sta INDEX1
 1782 A:0a0e  ba                                 tsx                    ;GET STACKED.
 1783 A:0a0f  e4 61                              cpx INDEX1                ;COMPARE.
 1784 A:0a11  90 2e                              bcc OMERR                ;IF STACK.LE.INDEX1, OM.
 1785 A:0a13  60                                 rts 

 1787 A:0a14                                    ;
 1788 A:0a14                                    ; [Y,A] IS A CERTAIN ADDRESS. "REASON" MAKES SURE
 1789 A:0a14                                    ; IT IS LESS THAN [FRETOP].
 1790 A:0a14                                    ;
 1791 A:0a14                           REASON    
 1791 A:0a14  c4 73                              cpy FRETOP+1
 1792 A:0a16  90 28                              bcc REARTS
 1793 A:0a18  d0 04                              bne TRYMOR                ;GO GARB COLLECT.
 1794 A:0a1a  c5 72                              cmp FRETOP
 1795 A:0a1c  90 22                              bcc REARTS
 1796 A:0a1e                           TRYMOR    
 1796 A:0a1e  48                                 pha 
 1797 A:0a1f  a2 09                              ldx #8+1       ;IF TEMPF2 HAS ZERO IN BETWEEN.
 1798 A:0a21  98                                 tya 
 1799 A:0a22                           REASAV    
 1799 A:0a22  48                                 pha 
 1800 A:0a23  b5 96                              lda HIGHDS-1,X        ;SAVE HIGHDS ON STACK.
 1801 A:0a25  ca                                 dex 
 1802 A:0a26  10 fa                              bpl REASAV                ;PUT 8 OF THEM ON STK.
 1803 A:0a28  20 41 1a                           jsr GARBA2                ;GO GARB COLLECT.
 1804 A:0a2b  a2 f7                              ldx #256-8-1
 1805 A:0a2d                           REASTO    
 1805 A:0a2d  68                                 pla 
 1806 A:0a2e  95 a0                              sta HIGHDS+8+1,X  ;RESTORE AFTER GARB COLLECT.
 1807 A:0a30  e8                                 inx 
 1808 A:0a31  30 fa                              bmi REASTO
 1809 A:0a33  68                                 pla 
 1810 A:0a34  a8                                 tay 
 1811 A:0a35  68                                 pla                    ;RESTORE A AND Y.
 1812 A:0a36  c4 73                              cpy FRETOP+1          ;COMPARE HIGHS
 1813 A:0a38  90 06                              bcc REARTS
 1814 A:0a3a  d0 05                              bne OMERR                ;HIGHER IS BAD.
 1815 A:0a3c  c5 72                              cmp FRETOP                ;AND THE LOWS.
 1816 A:0a3e  b0 01                              bcs OMERR
 1817 A:0a40                           REARTS    
 1817 A:0a40  60                                 rts 

