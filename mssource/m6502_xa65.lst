 4962 A:e135                                    ; [X,Y]=[X,A]=[CURTOL]*[LOWTR,Y,Y+1].
 4963 A:e135                           UMULT     
 4963 A:e135  84 61                              sty INDEX1
 4964 A:e137  b1 9e                              lda (LOWTR),Y
