  993 A:0066                           RESMOH    
  993 A:0066  00                                 .dsb 1

  995 A:0067                           RESMO     
  995 A:0067  00                                 .dsb 1
  996 A:0068                           RESLO     
  996 A:0068  00                                 .dsb 1
  997 A:0069                                    ;TEMPORARY USED BY "UMULT".

  999 A:0069  00                                 .byt 0              ;OVERFLOW FOR RES.

 1001 A:006a                                    ; --- POINTERS INTO DYNAMIC DATA STRUCTURES ---;
 1002 A:006a                           TXTTAB    
 1002 A:006a  00 ff                              .dsb 2              ;POINTER TO BEGINNING OF TEXT.
 1003 A:006c                                    ;DOESN'T CHANGE AFTER BEING
 1004 A:006c                                    ;SETUP BY "INIT".
 1005 A:006c                           VARTAB    
 1005 A:006c  00 ff                              .dsb 2              ;POINTER TO START OF SIMPLE
 1006 A:006e                                    ;VARIABLE SPACE.
 1007 A:006e                                    ;UPDATED WHENEVER THE SIZE OF THE
 1008 A:006e                                    ;PROGRAM CHANGES, SET TO [TXTTAB]
 1009 A:006e                                    ;BY "SCRATCH" ("NEW").
 1010 A:006e                           ARYTAB    
 1010 A:006e  00 ff                              .dsb 2              ;POINTER TO BEGINNING OF ARRAY
 1011 A:0070                                    ;TABLE.
 1012 A:0070                                    ;INCREMENTED BY 6 WHENEVER
 1013 A:0070                                    ;A NEW SIMPLE VARIABLE IS FOUND, AND
 1014 A:0070                                    ;SET TO [VARTAB] BY "CLEARC".
 1015 A:0070                           STREND    
 1015 A:0070  00 ff                              .dsb 2              ;END OF STORAGE IN USE.
 1016 A:0072                                    ;INCREASED WHENEVER A NEW ARRAY
 1017 A:0072                                    ;OR SIMPLE VARIABLE IS ENCOUNTERED.
 1018 A:0072                                    ;SET TO [VARTAB] BY "CLEARC".
 1019 A:0072                           FRETOP    
 1019 A:0072  00 ff                              .dsb 2              ;TOP OF STRING FREE SPACE.
 1020 A:0074                           FRESPC    
 1020 A:0074  00 ff                              .dsb 2              ;POINTER TO NEW STRING.
 1021 A:0076                           MEMSIZ    
 1021 A:0076  00 ff                              .dsb 2              ;HIGHEST LOCATION IN MEMORY.

