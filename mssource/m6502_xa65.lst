 2354 A:d549                                    ;
 2355 A:d549                                    ; STKINI RESETS THE STACK POINTER ELIMINATING
 2356 A:d549                                    ; GOSUB AND FOR CONTEXT. STRING TEMPORARIES ARE FREED
 2357 A:d549                                    ; UP, SUBFLG IS RESET. CONTINUING IS PROHIBITED.
 2358 A:d549                                    ; AND A DUMMY ENTRY IS LEFT AT THE BOTTOM OF THE STACK SO "FNDFOR" WILL ALWAYS
 2359 A:d549                                    ; FIND A NON-"FOR" ENTRY AT THE BOTTOM OF THE STACK.
 2360 A:d549                                    ;
 2361 A:d549                           STKINI    
