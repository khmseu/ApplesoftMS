 2905 A:d7a1  60                                 rts 

 2907 A:d7a2                                    ; PAGE
 2908 A:d7a2                                    ; SUBTTL RUN,GOTO,GOSUB,RETURN.
 2909 A:d7a2                           RUN       
 2909 A:d7a2                                    ;IF NO LINE # ARGUMENT.
 2910 A:d7a2  d0 03                              bne *+5
 2911 A:d7a4  4c 37 d5                           jmp RUNC
 2912 A:d7a7  20 3e d5                           jsr CLEARC                ;CLEAN UP -- RESET THE STACK.
 2913 A:d7aa  4c c1 d7                           jmp RUNC2                ;MUST REPLACE RTS ADDR.
 2914 A:d7ad                                    ;
 2915 A:d7ad                                    ; A GOSUB ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2916 A:d7ad                                    ;
 2917 A:d7ad                                    ; LOW ADDRESS:
 2918 A:d7ad                                    ; THE GOSUTK ONE BYTE
 2919 A:d7ad                                    ; THE LINE NUMBER OF THE GOSUB STATEMENT TWO BYTES
 2920 A:d7ad                                    ; A POINTER INTO THE TEXT OF THE GOSUB TWO BYTES
 2921 A:d7ad                                    ;
 2922 A:d7ad                                    ; HIGH ADDRESS.
 2923 A:d7ad                                    ;
 2924 A:d7ad                                    ; TOTAL FIVE BYTES.
 2925 A:d7ad                                    ;
 2926 A:d7ad                           GOSUB     
 2926 A:d7ad  a9 03                              lda #3
 2927 A:d7af  20 e1 d2                           jsr GETSTK                ;MAKE SURE THERE IS ROOM.
 2928 A:d7b2                                    ;PUSH ON THE TEXT POINTER.
 2929 A:d7b2  a5 ba                              lda CHRGOT+1+1
 2930 A:d7b4  48                                 pha 
 2931 A:d7b5  a5 b9                              lda CHRGOT+1
 2932 A:d7b7  48                                 pha 
 2933 A:d7b8                                    ;PUSH ON THE CURRENT LINE NUMBER.
 2934 A:d7b8  a5 79                              lda CURLIN+1
 2935 A:d7ba  48                                 pha 
 2936 A:d7bb  a5 78                              lda CURLIN
 2937 A:d7bd  48                                 pha 
 2938 A:d7be  a9 7f                              lda #127
 2939 A:d7c0  48                                 pha                    ;PUSH ON A GOSUB TOKEN.
 2940 A:d7c1                           RUNC2     
 2940 A:d7c1  20 b8 00                           jsr CHRGOT                ;GET CHARACTER AND SET CODES FOR LINGET.
 2941 A:d7c4  20 ca d7                           jsr GOTO                ;USE RTS SCHEME TO "NEWSTT".
 2942 A:d7c7  4c 72 d6                           jmp NEWSTT

 2944 A:d7ca                           GOTO      
 2944 A:d7ca  20 96 d8                           jsr LINGET                ;PICK UP THE LINE NUMBER IN "LINNUM".
 2945 A:d7cd  20 34 d8                           jsr REMN                ;SKIP TO END OF LINE.
 2946 A:d7d0  a5 79                              lda CURLIN+1
 2947 A:d7d2  c5 54                              cmp LINNUM+1
 2948 A:d7d4  b0 0d                              bcs LUK4IT
 2949 A:d7d6  98                                 tya 
 2950 A:d7d7  38                                 sec 
 2951 A:d7d8  65 b9                              adc CHRGOT+1
 2952 A:d7da  a6 ba                              ldx CHRGOT+1+1
 2953 A:d7dc  90 09                              bcc LUKALL
 2954 A:d7de  e8                                 inx 
 2955 A:d7df  b0 06                              bcs LUKALL                ;ALWAYS GOES.
 2956 A:d7e1                           LUK4IT    
 2956 A:d7e1                                    
 2957 A:d7e1  a5 6a                              lda TXTTAB
 2958 A:d7e3  a6 6b                              ldx TXTTAB+1
 2959 A:d7e5                           LUKALL    
 2959 A:d7e5  20 f5 d4                           jsr FNDLNC                ;[X,A] ARE ALL SET UP.
 2960 A:d7e8                           QFOUND    
 2960 A:d7e8  90 23                              bcc USERR                ;GOTO LINE IS NONEXISTANT.
 2961 A:d7ea  a5 9e                              lda LOWTR
 2962 A:d7ec  e9 01                              sbc #1
 2963 A:d7ee  85 b9                              sta CHRGOT+1
 2964 A:d7f0  a5 9f                              lda LOWTR+1
 2965 A:d7f2  e9 00                              sbc #0
 2966 A:d7f4  85 ba                              sta CHRGOT+1+1
 2967 A:d7f6                           GORTS     
 2967 A:d7f6  60                                 rts                    ;PROCESS THE STATEMENT.
 2968 A:d7f7                                    ;
 2969 A:d7f7                                    ; "RETURN" RESTORES THE LINE NUMBER AND TEXT PNTR FROM THE STACK
 2970 A:d7f7                                    ; AND ELIMINATES ALL THE "FOR" ENTRIES IN FRONT OF THE "GOSUB" ENTRY.
 2971 A:d7f7                                    ;
 2972 A:d7f7                           RETURN    
 2972 A:d7f7  d0 fd                              bne GORTS                ;NO TERMINATOR=BLOW HIM UP.
 2973 A:d7f9  a9 ff                              lda #255
 2974 A:d7fb  85 89                              sta FORPNT+1          ;MAKE SURE THE VARIABLE'S PNTR
 2975 A:d7fd                                    ;NEVER GETS MATCHED.
 2976 A:d7fd  20 70 d2                           jsr FNDFOR                ;GO PAST ALL THE "FOR" ENTRIES.
 2977 A:d800  9a                                 txs 
 2978 A:d801  c9 7f                              cmp #127             ;RETURN WITHOUT GOSUB?
 2979 A:d803  f0 10                              beq RETU1
 2980 A:d805  a2 16                              ldx #22
 2981 A:d807  00 02 2c 00                        .word 512,44
 2982 A:d80b                           USERR     
 2982 A:d80b  a2 5a                              ldx #90             ;NO MATCH SO "US" ERROR.
 2983 A:d80d  4c 1d d3                           jmp ERROR                ;YES.
 2984 A:d810                           SNERR2    
 2984 A:d810  4c 7f dd                           jmp SNERR
 2985 A:d813                           RETU1     
 2985 A:d813  68                                 pla                    ;REMOVE GOSUTK.
 2986 A:d814                                    ;GET LINE NUMBER "GOSUB" WAS FROM.
 2987 A:d814  68                                 pla 
 2988 A:d815  85 78                              sta CURLIN
 2989 A:d817  68                                 pla 
 2990 A:d818  85 79                              sta CURLIN+1
