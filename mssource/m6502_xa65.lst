 2333 A:0c63                           CLEARC    
 2333 A:0c63                                    ;FREE UP STRING SPACE.
 2334 A:0c63  a5 76                              lda MEMSIZ
 2335 A:0c65  a4 77                              ldy MEMSIZ+1

