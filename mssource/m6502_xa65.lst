 4404 A:15ae                                    ; PAGE
 4405 A:15ae                                    ; SUBTTL DIMENSION AND VARIABLE SEARCHING.
 4406 A:15ae                                    ;
 4407 A:15ae                                    ; THE "DIM" CODE SETS [DIMFLG] AND THEN FALLS INTO THE VARIABLE SEARCH
 4408 A:15ae                                    ; ROUTINE, WHICH LOOKS AT DIMFLG AT THREE DIFFERENT POINTS.
 4409 A:15ae                                    ; 1) IF AN ENTRY IS FOUND, "DIMFLG" BEING ON INDICATES
 4410 A:15ae                                    ;  A "DOUBLY" DIMENSIONED VARIABLE.
 4411 A:15ae                                    ; 2) WHEN A NEW ENTRY IS BEING BUILT "DIMFLG" BEING ON
 4412 A:15ae                                    ;  INDICTAES THE INDICES SHOULD BE USED FOR THE
 4413 A:15ae                                    ;  SIZE OF EACH INDEX. OTHERWISE THE DEFAULT OF TEN
 4414 A:15ae                                    ;  IS USED.
 4415 A:15ae                                    ; 3) WHEN THE BUILD ENTRY CODE FINISHES, ONLY IF "DIMFLG" IS OFF
 4416 A:15ae                                    ;  WILL INDEXING BE DONE.
 4417 A:15ae                                    ;
 4418 A:15ae                           DIM3      
 4418 A:15ae  20 99 14                           jsr CHKCOM                ;MUST BE A COMMA
 4419 A:15b1                           DIM       
 4419 A:15b1  aa                                 tax                    ;SET [ACCX] NONZERO.
 4420 A:15b2                                    ;[ACCA] MUST BE NONZERO TO WORK RIGHT.
 4421 A:15b2                           DIM1      
 4421 A:15b2  20 c0 15                           jsr PTRGT1
 4422 A:15b5                           DIMCON    
 4422 A:15b5  20 b8 00                           jsr CHRGOT                ;GET LAST CHARACTER.
 4423 A:15b8  d0 f4                              bne DIM3
 4424 A:15ba  60                                 rts 
 4425 A:15bb                                    ;
 4426 A:15bb                                    ; ROUTINE TO READ THE VARIABLE NAME AT THE CURRENT TEXT POSITION
 4427 A:15bb                                    ; AND  PUT A POINTER TO ITS VALUE IN VARPNT. [TXTPTR]
 4428 A:15bb                                    ; POINTS TO THE TERMINATING CHARCTER.. NOT THAT EVALUATING SUBSCRIPTS
 4429 A:15bb                                    ; IN A VARIABLE NAME CAN CAUSE RECURSIVE CALLS TO "PTRGET" SO AT
 4430 A:15bb                                    ; THAT POINT ALL VALUES MUST BE STORED ON THE STACK.
 4431 A:15bb                                    ;
 4432 A:15bb                           PTRGET    
 4432 A:15bb  a2 00                              ldx #0             ;MAKE [ACCX]=0.
 4433 A:15bd  20 b8 00                           jsr CHRGOT                ;RETRIEVE LAST CHARACTER.
 4434 A:15c0                           PTRGT1    
 4434 A:15c0  86 10                              stx DIMFLG                ;STORE FLAG AWAY.
 4435 A:15c2                           PTRGT2    
 4435 A:15c2  85 84                              sta VARNAM
 4436 A:15c4  20 b8 00                           jsr CHRGOT                ;GET CURRENT CHARACTER
 4437 A:15c7                                    ;MAYBE WITH FUNCTION BIT OFF.
 4438 A:15c7  20 45 16                           jsr ISLETC                ;CHECK FOR LETTER.
 4439 A:15ca  b0 05                              bcs PTRGT3                ;MUST HAVE A LETTER.
 4440 A:15cc                           INTERR    
 4440 A:15cc  4c a4 14                           jmp SNERR
 4441 A:15cf                           PTRGT3    
 4441 A:15cf  a2 00                              ldx #0             ;ASSUME NO SECOND CHARACTER.
 4442 A:15d1  86 11                              stx VALTYP                ;DEFAULT IS NUMERIC.

 4445 A:15d3  86 12                              stx INTFLG

 4447 A:15d5  20 b2 00                           jsr CHRGET                ;GET FOLLOWING CHARACTER.
 4448 A:15d8  90 07                              bcc ISSEC                ;CARRY RESET BY CHRGET IF NUMERIC.
 4449 A:15da  20 45 16                           jsr ISLETC                ;SET CARRY IF NOT ALPHABETIC.
 4450 A:15dd  90 0d                              bcc NOSEC                ;ALLOW ALPHABETICS.
 4451 A:15df                           ISSEC     
 4451 A:15df  aa                                 tax                    ;IT IS A NUMBER -- SAVE IN ACCX.
 4452 A:15e0                           EATEM     
 4452 A:15e0  20 b2 00                           jsr CHRGET                ;LOOK AT NEXT CHARACTER.
 4453 A:15e3  90 fb                              bcc EATEM                ;SKIP NUMERICS.
 4454 A:15e5  20 45 16                           jsr ISLETC
 4455 A:15e8  b0 f6                              bcs EATEM                ;SKIP ALPHABETICS.
 4456 A:15ea                           NOSEC     
 4456 A:15ea  c9 24                              cmp #"$"             ;IS IT A STRING?
 4457 A:15ec  d0 08                              bne NOTSTR                ;IF NOT, [VALTYP]=0.
 4458 A:15ee  a9 ff                              lda #255             ;SET [VALTYP]=255 (STRING !).
 4459 A:15f0  85 11                              sta VALTYP

 4462 A:15f2  d0 12                              bne TURNON
 4463 A:15f4                           NOTSTR    
 4463 A:15f4  c9 25                              cmp #"%"
 4464 A:15f6  d0 15                              bne STRNAM
 4465 A:15f8  a5 14                              lda SUBFLG
 4466 A:15fa  d0 d0                              bne INTERR
 4467 A:15fc  a9 80                              lda #128
 4468 A:15fe  85 12                              sta INTFLG
 4469 A:1600  05 84                              ora VARNAM
 4470 A:1602  85 84                              sta VARNAM

 4472 A:1604                           TURNON    
 4472 A:1604  8a                                 txa 
 4473 A:1605  09 80                              ora #128             ;TURN ON MSB OF SECOND CHARACTER.
 4474 A:1607  aa                                 tax 
 4475 A:1608  20 b2 00                           jsr CHRGET                ;GET CHARACTER AFTER $.

 4480 A:160b                           STRNAM    
 4480 A:160b  86 85                              stx VARNAM+1          ;STORE AWAY SECOND CHARACTER.
 4481 A:160d  38                                 sec 
 4482 A:160e  05 14                              ora SUBFLG                ;ADD FLAG WHETHER TO ALLOW ARRAYS.
 4483 A:1610  e9 28                              sbc #40             ;(CHECK FOR "(") WON'T MATCH IF SUBFLG SET. 
 4484 A:1612                                    ;IT IS!
 4485 A:1612  d0 03                              bne *+5
 4486 A:1614  4c e7 16                           jmp ISARY
 4487 A:1617                                    ;ALLOW SUBSCRIPTS AGAIN.
 4488 A:1617  a9 00                              lda #0
 4489 A:1619  85 14                              sta SUBFLG
 4490 A:161b  a5 6c                              lda VARTAB                ;PLACE TO START SEARCH.
 4491 A:161d  a6 6d                              ldx VARTAB+1
 4492 A:161f  a0 00                              ldy #0
 4493 A:1621                           STXFND    
 4493 A:1621  86 9f                              stx LOWTR+1
 4494 A:1623                           LOPFND    
 4494 A:1623  85 9e                              sta LOWTR
 4495 A:1625  e4 6f                              cpx ARYTAB+1          ;AT END OF TABLE YET?
 4496 A:1627  d0 06                              bne LOPFN
 4497 A:1629  c5 6e                              cmp ARYTAB
 4498 A:162b  f0 24                              beq NOTFNS                ;YES. WE COULDN'T FIND IT.
 4499 A:162d                           LOPFN     
 4499 A:162d  a5 84                              lda VARNAM
 4500 A:162f  d1 9e                              cmp (LOWTR),Y            ;COMPARE HIGH ORDERS.
 4501 A:1631  d0 0a                              bne NOTIT                ;NO COMPARISON.
 4502 A:1633  a5 85                              lda VARNAM+1
 4503 A:1635  c8                                 iny 
 4504 A:1636  d1 9e                              cmp (LOWTR),Y            ;AND THE LOW PART?
 4505 A:1638  f0 6c                              beq FINPTR                ;THAT'S IT ! THAT'S IT !
 4506 A:163a  88                                 dey 
 4507 A:163b                           NOTIT     
 4507 A:163b  18                                 clc 
 4508 A:163c  a5 9e                              lda LOWTR
 4509 A:163e  69 07                              adc #6+1       ;MAKES NO DIF AMONG TYPES.
 4510 A:1640  90 e1                              bcc LOPFND
 4511 A:1642  e8                                 inx 
 4512 A:1643  d0 dc                              bne STXFND                ;ALWAYS BRANCHES.

 4514 A:1645                                    ;
 4515 A:1645                                    ; TEST FOR A LETTER. / CARRY OFF= NOT A LETTER.
 4516 A:1645                                    ;     CARRY ON= A LETTER.
 4517 A:1645                                    ;
 4518 A:1645                           ISLETC    
 4518 A:1645  c9 41                              cmp #"A"
 4519 A:1647  90 07                              bcc ISLRTS                ;IF LESS THAN "A", RET.
 4520 A:1649  e9 5b                              sbc #"Z"+1
 4521 A:164b  38                                 sec 
 4522 A:164c  e9 a5                              sbc #256-"Z"-1 ;RESET CARRY IF [A] .GT. "Z".
 4523 A:164e                           ISLRTS    
 4523 A:164e  60                                 rts                    ;RETURN TO CALLER.

 4525 A:164f                           NOTFNS    
 4525 A:164f  68                                 pla                    ;CHECK WHO'S CALLING.
 4526 A:1650  48                                 pha                    ;RESTORE IT.
 4527 A:1651  c9 00                              cmp #((((ISVRET-1)-ISVRET)-1)/256)*256;IS EVAL CALLING?
 4528 A:1653  d0 0f                              bne NOTEVL                ;NO, CARRY ON.

 4531 A:1655  ba                                 tsx 
 4532 A:1656  bd 02 01                           lda 258,X
 4533 A:1659  c9 14                              cmp #(ISVRET-1)/256
 4534 A:165b  d0 07                              bne NOTEVL

