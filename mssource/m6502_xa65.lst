 7084 A:2363                                    ;IE, IS NUMBER .LT. .01 ?
 7085 A:2363  30 0d                              bmi FOUTPI                ;YES.
 7086 A:2365  c9 0b                              cmp #(3*1)+8;IS IT .GT. 999999 (999999999)?
 7087 A:2367  b0 0a                              bcs FOUT6                ;YES. USE E NOTATION.
