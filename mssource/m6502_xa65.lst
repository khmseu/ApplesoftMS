 6865 A:eae9                                    ; PAGE
 6866 A:eae9                                    ; SUBTTL FLOATING POINT INPUT ROUTINE.
 6867 A:eae9                                    ;NUMBER INPUT IS LEFT IN FAC.
 6868 A:eae9                                    ;AT ENTRY [TXTPTR] POINTS TO THE FIRST CHARACTER IN A TEXT BUFFER.
 6869 A:eae9                                    ;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS
 6870 A:eae9                                    ;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE
 6871 A:eae9                                    ;DECIMAL POINT IS. [DPTFLG] TELL WHETHER A DP HAS BEEN
 6872 A:eae9                                    ;SEEN. [DECCNT] IS THE NUMBER OF DIGITS AFTER THE DP.
 6873 A:eae9                                    ;AT THE END [DECCNT] AND THE EXPONENT ARE USED TO
 6874 A:eae9                                    ;DETERMINE HOW MANY TIMES TO MULTIPLY OR DIVIDE BY TEN
 6875 A:eae9                                    ;TO GET THE CORRECT NUMBER.
 6876 A:eae9                           FIN       
 6876 A:eae9  a0 00                              ldy #0             ;ZERO FACSGN&SGNFLG.
 6877 A:eaeb  a2 0a                              ldx #9+1       ;ZERO EXP AND HO (AND MOH).
 6878 A:eaed                           FINZLP    
 6878 A:eaed  94 9c                              sty LOWDS,X              ;ZERO MO AND LO.
 6879 A:eaef  ca                                 dex                    ;ZERO TENEXP AND EXPSGN
 6880 A:eaf0  10 fb                              bpl FINZLP                ;ZERO DECCNT, DPTFLG.
 6881 A:eaf2  90 13                              bcc FINDGQ                ;FLAGS STILL SET FROM CHRGET.
 6882 A:eaf4  c9 2d                              cmp #"-"             ;A NEGATIVE SIGN?
 6883 A:eaf6  d0 08                              bne QPLUS                ;NO, TRY PLUS SIGN.
 6884 A:eaf8  86 a6                              stx SGNFLG                ;IT'S NEGATIVE. (X=377).
 6885 A:eafa  f0 08                              beq FINC                ;ALWAYS BRANCHES.
 6886 A:eafc                           QPLUS     
 6886 A:eafc  c9 2b                              cmp #"+"             ;PLUS SIGN?
 6887 A:eafe  d0 09                              bne FIN1                ;YES, SKIP IT.
 6888 A:eb00                           FINC      
 6888 A:eb00  20 b2 00                           jsr CHRGET
 6889 A:eb03                           FINDGQ    
 6889 A:eb03  90 5f                              bcc FINDIG
 6890 A:eb05                           FIN1      
 6890 A:eb05  c9 2a                              cmp #"*"             ;THE DP?
 6891 A:eb07  f0 32                              beq FINDP                ;NO KIDDING.
 6892 A:eb09  c9 45                              cmp #"E"             ;EXPONENT FOLLOWS.
 6893 A:eb0b  d0 34                              bne FINE                ;NO.
 6894 A:eb0d                                    ;HERE TO CHECK FOR SIGN OF EXP.
 6895 A:eb0d  20 b2 00                           jsr CHRGET                ;YES. GET ANOTHER.
 6896 A:eb10  90 1b                              bcc FNEDG1                ;IT IS A DIGIT. (EASIER THAN
 6897 A:eb12                                    ;BACKING UP POINTER.)
 6898 A:eb12  c9 81                              cmp #129             ;MINUS?
 6899 A:eb14  f0 12                              beq FINEC1                ;NEGATE.
 6900 A:eb16  c9 2d                              cmp #"-"             ;MINUS SIGN?
 6901 A:eb18  f0 0e                              beq FINEC1
 6902 A:eb1a  c9 81                              cmp #129             ;PLUS?
 6903 A:eb1c  f0 0c                              beq FINEC
 6904 A:eb1e  c9 2b                              cmp #"+"             ;PLUS SIGN?
 6905 A:eb20  f0 08                              beq FINEC
 6906 A:eb22  d0 0b                              bne FINEC2
 6907 A:eb24                           FINEC1    
 6907 A:eb24  66 9f                              ror LOWTR+1          ;TURN IT ON.
 6908 A:eb26                           FINEC     
 6908 A:eb26  20 b2 00                           jsr CHRGET                ;GET ANOTHER.
 6909 A:eb29                           FNEDG1    
 6909 A:eb29  90 60                              bcc FINEDG                ;IT IS A DIGIT.
 6910 A:eb2b                           FINEC2    
 6910 A:eb2b  24 9f                              bit LOWTR+1
 6911 A:eb2d  10 12                              bpl FINE
 6912 A:eb2f  a9 00                              lda #0
 6913 A:eb31  38                                 sec 
 6914 A:eb32  e5 9d                              sbc LOWDS+1
 6915 A:eb34  4c 3f eb                           jmp FINE1
 6916 A:eb37                           FINDP     
 6916 A:eb37  66 9e                              ror LOWTR
 6917 A:eb39  24 9e                              bit LOWTR
 6918 A:eb3b  50 c3                              bvc FINC
 6919 A:eb3d                           FINE      
 6919 A:eb3d  a5 9d                              lda LOWDS+1
 6920 A:eb3f                           FINE1     
 6920 A:eb3f  38                                 sec 
 6921 A:eb40  e5 9c                              sbc LOWDS                ;GET NUMBER OF PLACES TO SHIFT.
 6922 A:eb42  85 9d                              sta LOWDS+1
 6923 A:eb44  f0 16                              beq FINQNG                ;NEGATE?
 6924 A:eb46  10 0d                              bpl FINMUL                ;POSITIVE SO MULTIPLY.
 6925 A:eb48                           FINDIV    
 6925 A:eb48  20 f1 e8                           jsr DIV10
 6926 A:eb4b  e6 9d                              inc LOWDS+1          ;DONE?
 6927 A:eb4d  d0 f9                              bne FINDIV                ;NO.
 6928 A:eb4f  f0 0b                              beq FINQNG                ;YES.
 6929 A:eb51                           FINMUL    
 6929 A:eb51  20 d5 e8                           jsr MUL10
 6930 A:eb54  c6 9d                              dec LOWDS+1          ;DONE?
 6931 A:eb56  d0 f9                              bne FINMUL                ;NO
 6932 A:eb58                           FINQNG    
 6932 A:eb58  a5 a6                              lda SGNFLG
 6933 A:eb5a  30 05                              bmi NEGXQS                ;IF POSITIVE, RETURN.
 6934 A:eb5c  60                                 rts 
 6935 A:eb5d                           NEGXQS    
 6935 A:eb5d  4c 6b ed                           jmp NEGOP                ;OTHERWISE, NEGATE AND RETURN.

 6937 A:eb60                           FINDIG    
 6937 A:eb60  48                                 pha 
 6938 A:eb61  24 9e                              bit LOWTR
 6939 A:eb63  10 06                              bpl FINDG1
 6940 A:eb65  e6 9c                              inc LOWDS
 6941 A:eb67                           FINDG1    
 6941 A:eb67  20 d5 e8                           jsr MUL10
 6942 A:eb6a  68                                 pla                    ;GET IT BACK.
 6943 A:eb6b  38                                 sec 
 6944 A:eb6c  e9 30                              sbc #"0"
 6945 A:eb6e  20 74 eb                           jsr FINLOG                ;ADD IT IN.
 6946 A:eb71  4c 00 eb                           jmp FINC

 6948 A:eb74                           FINLOG    
 6948 A:eb74  48                                 pha 
 6949 A:eb75  20 02 ea                           jsr MOVAF                ;SAVE FAC FOR LATER.
 6950 A:eb78  68                                 pla 
 6951 A:eb79  20 32 ea                           jsr FLOAT                ;FLOAT THE VALUE IN ACCA.
 6952 A:eb7c  a5 ad                              lda ARGSGN
 6953 A:eb7e  45 a5                              eor FACSGN
 6954 A:eb80  85 ae                              sta ARISGN                ;RESULTANT SIGN.
 6955 A:eb82  a6 a0                              ldx FACEXP                ;SET SIGNS ON THING TO ADD.
 6956 A:eb84  4c 5a e6                           jmp FADDT                ;ADD TOGETHER AND RETURN.

 6958 A:eb87                                    ;HERE PACK IN THE NEXT DIGIT OF THE EXPONENT.
 6959 A:eb87                                    ;MULTIPLY THE OLD EXP BY 10 AND ADD IN THE NEXT
 6960 A:eb87                                    ;DIGIT. NOTE: EXP OVERFLOW IS NOT CHECKED FOR.
 6961 A:eb87                           FINEDG    
 6961 A:eb87  a5 9d                              lda LOWDS+1          ;GET EXP SO FAR.
 6962 A:eb89  c9 0a                              cmp #10             ;WILL RESULT BE .GE. 100?
 6963 A:eb8b  90 0d                              bcc MLEX10
 6964 A:eb8d  a9 64                              lda #100             ;GET 100.
 6965 A:eb8f  24 9f                              bit LOWTR+1
 6966 A:eb91  30 15                              bmi MLEXMI                ;IF NEG EXP, NO CHK FOR OVERR.
 6967 A:eb93  4c 6e e7                           jmp OVERR
 6968 A:eb96                           MLEX10    
 6968 A:eb96  0a                                 asl                    ;MULT BY 2 TWICE
 6969 A:eb97  0a                                 asl 
 6970 A:eb98  18                                 clc                    ;POSSIBLE SHIFT OUT OF HIGH.
 6971 A:eb99  65 9d                              adc LOWDS+1          ;LIKE MULTIPLYING BY FIVE.
 6972 A:eb9b  0a                                 asl                    ;AND NOW BY TEN.
 6973 A:eb9c  18                                 clc 
 6974 A:eb9d  a0 00                              ldy #0
 6975 A:eb9f  71 b9                              adc (CHRGOT+1),Y
 6976 A:eba1  38                                 sec 
 6977 A:eba2  e9 30                              sbc #"0"
 6978 A:eba4                           MLEXMI    
 6978 A:eba4  85 9d                              sta LOWDS+1          ;SAVE RESULT.
 6979 A:eba6  4c 26 eb                           jmp FINEC
