 5191 A:e26f  86 8f                              stx DSCPNT
 5192 A:e271  84 90                              sty DSCPNT+1
 5193 A:e273                           STRSPA    
 5193 A:e273  20 ea e2                           jsr GETSPA                ;GET STRING SPACE.
 5194 A:e276                                    ;SAVE LOCATION.
 5195 A:e276  86 a1                              stx FAC+1
 5196 A:e278  84 a2                              sty FAC+1+1
 5197 A:e27a  85 a0                              sta FAC                ;SAVE LENGTH.
 5198 A:e27c  60                                 rts                    ;ALL DONE.
 5199 A:e27d                                    ;
 5200 A:e27d                                    ; "STRLT2" TAKES THE STRING LITERAL WHOSE FIRST CHARACTER
 5201 A:e27d                                    ; IS POINTED TO BY [Y,A] AND BUILDS A DESCRIPTOR FOR IT.
 5202 A:e27d                                    ; THE DESCRIPTOR IS INITIALLY BUILT IN "DSCTMP", BUT "PUTNEW"
 5203 A:e27d                                    ; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER
 5204 A:e27d                                    ; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN
 5205 A:e27d                                    ; ZERO THAT TERMINATE THE STRING SHOULD BE SET UP IN "CHARAC"
 5206 A:e27d                                    ; AND "ENDCHR". IF THE TERMINATOR IS A QUOTE, THE QUOTE IS SKIPPED
 5207 A:e27d                                    ; OVER. LEADING QUOTES SHOULD BE SKIPPED BEFORE JSR. ON RETURN
 5208 A:e27d                                    ; THE CHARACTER AFTER THE STRING LITERAL IS POINTED TO
 5209 A:e27d                                    ; BY [STRNG2].
 5210 A:e27d                                    ;
 5211 A:e27d                           STRLIT    
 5211 A:e27d  a2 22                              ldx #34             ;ASSUME STRING ENDS ON QUOTE.
 5212 A:e27f  86 0d                              stx CHARAC
 5213 A:e281  86 0e                              stx ENDCHR
 5214 A:e283                           STRLT2    
 5214 A:e283                                    ;SAVE POINTER TO STRING.
 5215 A:e283  85 ae                              sta ARISGN
 5216 A:e285  84 af                              sty ARISGN+1
 5217 A:e287                                    ;IN CASE NO STRCPY.
 5218 A:e287  85 a1                              sta FAC+1
 5219 A:e289  84 a2                              sty FAC+1+1
 5220 A:e28b  a0 ff                              ldy #255             ;INITIALIZE CHARACTER COUNT.
 5221 A:e28d                           STRGET    
 5221 A:e28d  c8                                 iny 
 5222 A:e28e  b1 ae                              lda (ARISGN),Y            ;GET CHARACTER.
 5223 A:e290  f0 0e                              beq STRFI1                ;IF ZERO.
 5224 A:e292  c5 0d                              cmp CHARAC                ;THIS TERMINATOR?
 5225 A:e294  f0 06                              beq STRFIN                ;YES.
 5226 A:e296  c5 0e                              cmp ENDCHR
 5227 A:e298  d0 f3                              bne STRGET                ;LOOK FURTHER.
 5228 A:e29a                           STRFIN    
 5228 A:e29a  c9 22                              cmp #34             ;QUOTE?
 5229 A:e29c  f0 03                              beq STRFI2
 5230 A:e29e                           STRFI1    
 5230 A:e29e  18                                 clc                    ;NO, BACK UP.
 5231 A:e29f                           STRFI2    
 5231 A:e29f  84 a0                              sty FAC                ;RETAIN COUNT.
 5232 A:e2a1  98                                 tya 
