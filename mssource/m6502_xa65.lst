 5019 A:e199                                    ; PAGE
 5020 A:e199                                    ; SUBTTL SIMPLE-USER-DEFINED-FUNCTION CODE.
 5021 A:e199                                    ;
 5022 A:e199                                    ; NOTE ONLY SINGLE ARGUMENTS ARE ALLOWED TO FUNCTIONS
 5023 A:e199                                    ; AND FUNCTIONS MUST BE OF THE SINGLE LINE FORM:
 5024 A:e199                                    ; DEF FNA(X)=X^2+X-2
 5025 A:e199                                    ; NO STRINGS CAN BE INVOLVED WITH THESE FUNCTIONS.
 5026 A:e199                                    ;
 5027 A:e199                                    ; IDEA: CREATE A SIMPLE VARIABLE ENTRY
 5028 A:e199                                    ; WHOSE FIRST CHARACTER HAS THE 200 BIT SET.
 5029 A:e199                                    ; THE VALUE WILL BE:
 5030 A:e199                                    ;
 5031 A:e199                                    ; A TEXT PNTR TO THE FORMULA.
 5032 A:e199                                    ; A PNTR TO THE ARGUMENT VARIABLE.
 5033 A:e199                                    ;
 5034 A:e199                                    ; FUNCTION NAMES CAN BE LIKE "FNA4".
 5035 A:e199                                    ;
 5036 A:e199                                    ;
 5037 A:e199                                    ; SUBROUTINE TO SEE IF WE ARE IN DIRECT MODE.
 5038 A:e199                                    ; AND COMPLAIN IF SO.
 5039 A:e199                                    ;
 5040 A:e199                           ERRDIR    
 5040 A:e199  a6 79                              ldx CURLIN+1          ;DIR MODE HAS [CURLIN]=0,255
 5041 A:e19b  e8                                 inx                    ;SO NOW, IS RESULT ZERO?
 5042 A:e19c  d0 a2                              bne DIMRTS                ;YES.
 5043 A:e19e  a2 95                              ldx #149             ;INPUT DIRECT ERROR CODE.
 5044 A:e1a0  00 02 2c 00                        .word 512,44
 5045 A:e1a4                           ERRGUF    
 5045 A:e1a4  a2 e9                              ldx #233             ;USER DEFINED FUNCTION NEVER DEFINED
 5046 A:e1a6                           ERRGO1    
 5046 A:e1a6  4c 1d d3                           jmp ERROR

 5048 A:e1a9                           DEF       
 5048 A:e1a9  20 d7 e1                           jsr GETFNM                ;GET A PNTR TO THE FUNCTION.
 5049 A:e1ac  20 99 e1                           jsr ERRDIR
 5050 A:e1af  20 6e dd                           jsr CHKOPN                ;MUST HAVE "(".
 5051 A:e1b2  a9 80                              lda #128
 5052 A:e1b4  85 14                              sta SUBFLG                ;PROHIBIT SUBSCRIPTED VARIABLES.
 5053 A:e1b6  20 96 de                           jsr PTRGET                ;GET PNTR TO ARGUMENT.
 5054 A:e1b9  20 11 dc                           jsr CHKNUM                ;IS IT A NUMBER?
 5055 A:e1bc  20 68 dd                           jsr CHKCLS                ;MUST HAVE ")"
 5056 A:e1bf                                    ;MUST HAVE "=".
 5057 A:e1bf  a9 82                              lda #130
 5058 A:e1c1  20 76 dd                           jsr SYNCHR

 5060 A:e1c4  48                                 pha 

 5063 A:e1c5  a5 87                              lda VARPNT+1
 5064 A:e1c7  48                                 pha 
 5065 A:e1c8  a5 86                              lda VARPNT
 5066 A:e1ca  48                                 pha 

 5068 A:e1cb  a5 ba                              lda CHRGOT+1+1
 5069 A:e1cd  48                                 pha 
 5070 A:e1ce  a5 b9                              lda CHRGOT+1
 5071 A:e1d0  48                                 pha 
 5072 A:e1d1  20 20 d8                           jsr DATA
 5073 A:e1d4  4c 45 e2                           jmp DEFFIN
 5074 A:e1d7                                    ;
 5075 A:e1d7                                    ; SUBROUTINE TO GET A PNTR TO A FUNCTION NAME.
 5076 A:e1d7                                    ;
 5077 A:e1d7                           GETFNM    
 5077 A:e1d7                                    ;MUST START WITH FN.
 5078 A:e1d7  a9 80                              lda #128
 5079 A:e1d9  20 76 dd                           jsr SYNCHR
 5080 A:e1dc  09 80                              ora #128             ;PUT FUNCTION BIT ON.
 5081 A:e1de  85 14                              sta SUBFLG
 5082 A:e1e0  20 9d de                           jsr PTRGT2                ;GET POINTER TO FUNCTION OR CREATE ANEW.

 5084 A:e1e3  85 8d                              sta DEFPNT
 5085 A:e1e5  84 8e                              sty DEFPNT+1
 5086 A:e1e7  4c 11 dc                           jmp CHKNUM                ;MAKE SURE IT'S NOT A STRING AND RETURN.

 5088 A:e1ea                           FNDOER    
 5088 A:e1ea  20 d7 e1                           jsr GETFNM                ;GET THE FUNCTION'S NAME.

 5090 A:e1ed  a5 8e                              lda DEFPNT+1
 5091 A:e1ef  48                                 pha 
 5092 A:e1f0  a5 8d                              lda DEFPNT
 5093 A:e1f2  48                                 pha 
 5094 A:e1f3  20 62 dd                           jsr PARCHK                ;EVALUATE PARAMETER.
 5095 A:e1f6  20 11 dc                           jsr CHKNUM

 5097 A:e1f9  68                                 pla 
 5098 A:e1fa  85 8d                              sta DEFPNT
 5099 A:e1fc  68                                 pla 
 5100 A:e1fd  85 8e                              sta DEFPNT+1
 5101 A:e1ff  a0 02                              ldy #2
 5102 A:e201  b1 8d                              lda (DEFPNT),Y            ;GET POINTER TO VARIABLE.
 5103 A:e203  85 86                              sta VARPNT                ;SAVE VARIABLE POINTER.
 5104 A:e205  aa                                 tax 
 5105 A:e206  c8                                 iny 
 5106 A:e207  b1 8d                              lda (DEFPNT),Y
 5107 A:e209  f0 99                              beq ERRGUF
 5108 A:e20b  85 87                              sta VARPNT+1

 5110 A:e20d  c8                                 iny 

 5112 A:e20e                           DEFSTF    
 5112 A:e20e  b1 86                              lda (VARPNT),Y
 5113 A:e210  48                                 pha                    ;PUSH IT ALL ON STACK.
 5114 A:e211  88                                 dey                    ;SINCE WE ARE RECURSING MAYBE.
 5115 A:e212  10 fa                              bpl DEFSTF
 5116 A:e214  a4 87                              ldy VARPNT+1
 5117 A:e216  20 d6 e9                           jsr MOVMF                ;PUT CURRENT FAC INTO OUR ARG VARIABLE.
 5118 A:e219                                    ;SAVE TEXT POINTER.
 5119 A:e219  a5 ba                              lda CHRGOT+1+1
 5120 A:e21b  48                                 pha 
 5121 A:e21c  a5 b9                              lda CHRGOT+1
 5122 A:e21e  48                                 pha 
 5123 A:e21f  b1 8d                              lda (DEFPNT),Y            ;PNTR TO FUNCTION.
 5124 A:e221  85 b9                              sta CHRGOT+1
 5125 A:e223  c8                                 iny 
 5126 A:e224  b1 8d                              lda (DEFPNT),Y
 5127 A:e226  85 ba                              sta CHRGOT+1+1
 5128 A:e228                                    ;SAVE VARIABLE POINTER.
 5129 A:e228  a5 87                              lda VARPNT+1
 5130 A:e22a  48                                 pha 
 5131 A:e22b  a5 86                              lda VARPNT
 5132 A:e22d  48                                 pha 
 5133 A:e22e  20 0e dc                           jsr FRMNUM                ;EVALUATE FORMULA AND CHECK NUMERIC.

 5135 A:e231  68                                 pla 
 5136 A:e232  85 8d                              sta DEFPNT
 5137 A:e234  68                                 pla 
 5138 A:e235  85 8e                              sta DEFPNT+1
 5139 A:e237  20 b8 00                           jsr CHRGOT
 5140 A:e23a                                    ;IT DIDN'T TERMINATE. HUH?
 5141 A:e23a  f0 03                              beq *+5
 5142 A:e23c  4c 7f dd                           jmp SNERR
 5143 A:e23f                                    ;RESTORE TEXT PNTR.
 5144 A:e23f  68                                 pla 
 5145 A:e240  85 b9                              sta CHRGOT+1
 5146 A:e242  68                                 pla 
 5147 A:e243  85 ba                              sta CHRGOT+1+1
 5148 A:e245                           DEFFIN    
 5148 A:e245  a0 00                              ldy #0
 5149 A:e247  68                                 pla                    ;GET OLD ARG VALUE OFF STACK
 5150 A:e248  91 8d                              sta (DEFPNT),Y            ;AND PUT IT BACK IN VARIABLE.
 5151 A:e24a  68                                 pla 
 5152 A:e24b  c8                                 iny 
 5153 A:e24c  91 8d                              sta (DEFPNT),Y
 5154 A:e24e  68                                 pla 
 5155 A:e24f  c8                                 iny 
 5156 A:e250  91 8d                              sta (DEFPNT),Y
 5157 A:e252  68                                 pla 
 5158 A:e253  c8                                 iny 
 5159 A:e254  91 8d                              sta (DEFPNT),Y

