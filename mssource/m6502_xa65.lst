 2426 A:d5b7  c5 54                              cmp LINNUM+1          ;SEE IF BEYOND LAST.
 2427 A:d5b9  d0 06                              bne TSTDUN                ;GO DETERMINE RELATION.
 2428 A:d5bb  e4 53                              cpx LINNUM                ;WAS EQUAL SO TEST LOW ORDER.
