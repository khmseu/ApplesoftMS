 3843 A:db97                                    ; PAGE
 3844 A:db97                                    ; SUBTTL THE NEXT CODE IS THE "NEXT CODE"
 3845 A:db97                                    ;
 3846 A:db97                                    ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 3847 A:db97                                    ;
 3848 A:db97                                    ; LOW ADDRESS
 3849 A:db97                                    ; TOKEN (FORTK) 1 BYTE
 3850 A:db97                                    ; A POINTER TO THE LOOP VARIABLE 2 BYTES
 3851 A:db97                                    ; THE STEP 4+ADDPRC BYTES
 3852 A:db97                                    ; A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 3853 A:db97                                    ; THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
 3854 A:db97                                    ; THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 3855 A:db97                                    ; A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 3856 A:db97                                    ; HIGH ADDRESS
 3857 A:db97                                    ;
 3858 A:db97                                    ; TOTAL 16+2*ADDPRC BYTES.
 3859 A:db97                                    ;
 3860 A:db97                           NEXT      
 3860 A:db97  d0 06                              bne GETFOR
 3861 A:db99  a0 00                              ldy #0             ;WITHOUT ARG CALL "FNDFOR" WITH
 3862 A:db9b  f0 05                              beq STXFOR                ;[FORPNT]=0.
 3863 A:db9d                           GETFOR    
 3863 A:db9d  20 8a de                           jsr PTRGET                ;GET A POINTER TO LOOP VARIABLE
 3864 A:dba0                           STXFOR    
 3864 A:dba0                                    ;INTO "FORPNT".
 3865 A:dba0  85 88                              sta FORPNT
 3866 A:dba2  84 89                              sty FORPNT+1
 3867 A:dba4  20 64 d2                           jsr FNDFOR                ;FIND THE MATCHING ENTRY IF ANY.
 3868 A:dba7  f0 06                              beq HAVFOR
 3869 A:dba9  a2 00                              ldx #0             ;"NEXT WITHOUT FOR".
 3870 A:dbab                           ERRGO5    
 3870 A:dbab  f0 6b                              beq ERRGO4
 3871 A:dbad                           HAVFOR    
 3871 A:dbad  9a                                 txs                    ;SETUP STACK. CHOP FIRST.
 3872 A:dbae  8a                                 txa 
 3873 A:dbaf  18                                 clc 
 3874 A:dbb0  69 04                              adc #4             ;POINT TO INCREMENT
 3875 A:dbb2  48                                 pha                    ;SAVE THIS POINTER TO RESTORE TO [A]
 3876 A:dbb3  69 06                              adc #5+1       ;POINT TO UPPER LIMIT
 3877 A:dbb5  85 63                              sta INDEX2                ;SAVE AS INDEX
 3878 A:dbb7  68                                 pla                    ;RESTORE POINTER TO INCREMENT
 3879 A:dbb8  a0 01                              ldy #1             ;SET HI ADDR OF THING TO MOVE.
 3880 A:dbba  20 95 e9                           jsr MOVFM                ;GET QUANTITY INTO THE FAC.
 3881 A:dbbd  ba                                 tsx 
 3882 A:dbbe  bd 09 01                           lda 257+7+1,X, ;SET SIGN CORRECTLY.
 3883 A:dbc1  85 a5                              sta FACSGN

 3885 A:dbc3  a5 88                              lda FORPNT
 3886 A:dbc5  a4 89                              ldy FORPNT+1
 3887 A:dbc7  20 57 e6                           jsr FADD                ;ADD INC TO LOOP VARIABLE.
 3888 A:dbca  20 c6 e9                           jsr MOVVF                ;PACK THE FAC INTO MEMORY.
 3889 A:dbcd  a0 01                              ldy #1
 3890 A:dbcf  20 53 ea                           jsr FCOMPN                ;COMPARE FAC WITH UPPER VALUE.
 3891 A:dbd2  ba                                 tsx 
 3892 A:dbd3  38                                 sec 
 3893 A:dbd4  fd 09 01                           sbc 257+7+1,X, ;SUBTRACT SIGN OF INC FROM SIGN OF
 3894 A:dbd7                                    ;OF (CURRENT VALUE-FINAL VALUE).
 3895 A:dbd7  f0 19                              beq LOOPDN                ;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
 3896 A:dbd9                                    ;THEN LOOP IS DONE.
 3897 A:dbd9  bd 0f 01                           lda 2*1+12+257,X
 3898 A:dbdc  85 78                              sta CURLIN                ;STORE LINE NUMBER OF "FOR" STATEMENT.
 3899 A:dbde  bd 10 01                           lda 257+13+2*1,X
 3900 A:dbe1  85 79                              sta CURLIN+1
 3901 A:dbe3  bd 12 01                           lda 2*1+15+257,X
 3902 A:dbe6  85 b9                              sta CHRGOT+1          ;STORE TEXT PNTR INTO "FOR" STATEMENT.
 3903 A:dbe8  bd 11 01                           lda 2*1+14+257,X
 3904 A:dbeb  85 ba                              sta CHRGOT+1+1
 3905 A:dbed                           NEWSGO    
 3905 A:dbed  4c 66 d6                           jmp NEWSTT                ;PROCESS NEXT STATEMENT.
 3906 A:dbf0                           LOOPDN    
 3906 A:dbf0  8a                                 txa 
 3907 A:dbf1  69 11                              adc #(2*1)+15;ADDS 16 WITH CARRY.
 3908 A:dbf3  aa                                 tax 
 3909 A:dbf4  9a                                 txs                    ;NEW STACK PNTR.
 3910 A:dbf5  20 b8 00                           jsr CHRGOT
 3911 A:dbf8  c9 2c                              cmp #44             ;COMMA AT END?
 3912 A:dbfa  d0 f1                              bne NEWSGO
 3913 A:dbfc  20 b2 00                           jsr CHRGET
 3914 A:dbff  20 9d db                           jsr GETFOR                ;DO NEXT BUT DON'T ALLOW BLANK VARIABLE
 3915 A:dc02                                    ;PNTR. [VARPNT] IS THE STK PNTR WHICH
 3916 A:dc02                                    ;NEVER MATCHES ANY POINTER.
 3917 A:dc02                                    ;JSR TO PUT ON DUMMY NEWSTT ADDR.

 3919 A:dc02                                    ; SUBTTL FORMULA EVALUATION CODE.
 3920 A:dc02                                    ;
 3921 A:dc02                                    ; THESE ROUTINES CHECK FOR CERTAIN "VALTYP".
 3922 A:dc02                                    ; [C] IS NOT PRESERVED.
 3923 A:dc02                                    ;
 3924 A:dc02                           FRMNUM    
 3924 A:dc02  20 19 dc                           jsr FRMEVL
 3925 A:dc05                           CHKNUM    
 3925 A:dc05  18                                 clc 
 3926 A:dc06  00 02 24 00                        .word 512,36
 3927 A:dc0a                           CHKSTR    
 3927 A:dc0a  38                                 sec                    ;SET CARRY.
 3928 A:dc0b                           CHKVAL    
 3928 A:dc0b  24 11                              bit VALTYP                ;WILL NOT F UP "VALTYP".
 3929 A:dc0d  30 05                              bmi DOCSTR
 3930 A:dc0f  b0 05                              bcs CHKERR
 3931 A:dc11                           CHKOK     
 3931 A:dc11  60                                 rts 
 3932 A:dc12                           DOCSTR    
 3932 A:dc12  b0 fd                              bcs CHKOK
 3933 A:dc14                           CHKERR    
 3933 A:dc14  a2 a3                              ldx #163
 3934 A:dc16                           ERRGO4    
 3934 A:dc16  4c 11 d3                           jmp ERROR
 3935 A:dc19                                    ;
 3936 A:dc19                                    ; THE FORMULA EVALUATOR STARTS WITH
 3937 A:dc19                                    ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
 3938 A:dc19                                    ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
 3939 A:dc19                                    ; THE RESULT IS LEFT IN THE FAC.
 3940 A:dc19                                    ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
 3941 A:dc19                                    ;
 3942 A:dc19                                    ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
 3943 A:dc19                                    ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR 
 3944 A:dc19                                    ; EACH OPERATOR.
 3945 A:dc19                                    ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
 3946 A:dc19                                    ; THE ADDRESS OF THE OPERATOR ROUTINE.
 3947 A:dc19                                    ; THE FLOATING POINT TEMPORARY RESULT.
 3948 A:dc19                                    ; THE PRECEDENCE OF THE OPERATOR.
 3949 A:dc19                                    ;
 3950 A:dc19                           FRMEVL    
 3950 A:dc19  a6 b9                              ldx CHRGOT+1
 3951 A:dc1b  d0 04                              bne FRMEV1
 3952 A:dc1d  c6 ba                              dec CHRGOT+1+1
 3953 A:dc1f                           FRMEV1    
 3953 A:dc1f  c6 b9                              dec CHRGOT+1
 3954 A:dc21  a2 00                              ldx #0             ;INITIAL DUMMY PRECEDENCE IS 0.
 3955 A:dc23  00 02 24 00                        .word 512,36
 3956 A:dc27                           LPOPER    
 3956 A:dc27  48                                 pha                    ;SAVE LOW PRECEDENCE. (MASK.)
 3957 A:dc28  8a                                 txa 
 3958 A:dc29  48                                 pha                    ;SAVE HIGH PRECEDENCE.
 3959 A:dc2a  a9 01                              lda #1
 3960 A:dc2c  20 d5 d2                           jsr GETSTK                ;MAKE SURE THERE IS ROOM FOR
 3961 A:dc2f                                    ;RECURSIVE CALLS.
 3962 A:dc2f  20 01 dd                           jsr EVAL                ;EVALUATE SOMETHING.
 3963 A:dc32                                    ;PREPARE TO BUILD MASK MAYBE.
 3964 A:dc32  a9 00                              lda #0
 3965 A:dc34  85 8c                              sta OPMASK
 3966 A:dc36                           TSTOP     
 3966 A:dc36  20 b8 00                           jsr CHRGOT                ;REGET LAST CHARACTER.
 3967 A:dc39                           LOPREL    
 3967 A:dc39  38                                 sec                    ;PREP TO SUBTRACT.
 3968 A:dc3a  e9 82                              sbc #130             ;IS CURRENT CHARACTER A RELATION?
 3969 A:dc3c  90 19                              bcc ENDREL                ;NO. RELATIONS ALL THROUGH.
 3970 A:dc3e  c9 02                              cmp #131-130+1 ;REALLY RELATIONAL?
