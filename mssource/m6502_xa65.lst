 5816 A:1d1e  c9 91                              cmp #145
 5817 A:1d20  b0 96                              bcs GOFUC                ;FUNCTION CALL ERROR.
 5818 A:1d22  20 c2 21                           jsr QINT                ;INTEGERIZE IT.

 5820 A:1d25  a5 a3                              lda FACMO
