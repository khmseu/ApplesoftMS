 2479 A:d5f4  b9 84 d0                           lda RESLST,Y,             ;END OF ENTRY?
 2480 A:d5f7  10 fa                              bpl RESCR1                ;NO, CONTINUE PASSING.
 2481 A:d5f9  30 f5                              bmi RESRCH
 2482 A:d5fb                           PRIT3     
