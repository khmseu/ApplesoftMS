 5019 A:e18d                                    ; SUBTTL SIMPLE-USER-DEFINED-FUNCTION CODE.
 5020 A:e18d                                    ;
 5021 A:e18d                                    ; NOTE ONLY SINGLE ARGUMENTS ARE ALLOWED TO FUNCTIONS
 5022 A:e18d                                    ; AND FUNCTIONS MUST BE OF THE SINGLE LINE FORM:
 5023 A:e18d                                    ; DEF FNA(X)=X^2+X-2
 5024 A:e18d                                    ; NO STRINGS CAN BE INVOLVED WITH THESE FUNCTIONS.
 5025 A:e18d                                    ;
 5026 A:e18d                                    ; IDEA: CREATE A SIMPLE VARIABLE ENTRY
 5027 A:e18d                                    ; WHOSE FIRST CHARACTER HAS THE 200 BIT SET.
 5028 A:e18d                                    ; THE VALUE WILL BE:
 5029 A:e18d                                    ;
 5030 A:e18d                                    ; A TEXT PNTR TO THE FORMULA.
 5031 A:e18d                                    ; A PNTR TO THE ARGUMENT VARIABLE.
 5032 A:e18d                                    ;
 5033 A:e18d                                    ; FUNCTION NAMES CAN BE LIKE "FNA4".
 5034 A:e18d                                    ;
 5035 A:e18d                                    ;
 5036 A:e18d                                    ; SUBROUTINE TO SEE IF WE ARE IN DIRECT MODE.
 5037 A:e18d                                    ; AND COMPLAIN IF SO.
 5038 A:e18d                                    ;
 5039 A:e18d                           ERRDIR    
 5039 A:e18d  a6 79                              ldx CURLIN+1          ;DIR MODE HAS [CURLIN]=0,255
 5040 A:e18f  e8                                 inx                    ;SO NOW, IS RESULT ZERO?
 5041 A:e190  d0 a2                              bne DIMRTS                ;YES.
 5042 A:e192  a2 95                              ldx #149             ;INPUT DIRECT ERROR CODE.
 5043 A:e194  00 02 2c 00                        .word 512,44
 5044 A:e198                           ERRGUF    
 5044 A:e198  a2 e9                              ldx #233             ;USER DEFINED FUNCTION NEVER DEFINED
 5045 A:e19a                           ERRGO1    
 5045 A:e19a  4c 11 d3                           jmp ERROR

 5047 A:e19d                           DEF       
 5047 A:e19d  20 cb e1                           jsr GETFNM                ;GET A PNTR TO THE FUNCTION.
