 4643 A:df9f                           N32768    
 4643 A:df9f  90 80 00 00                        .byt 144,128,0,0;-32768.

 4645 A:dfa3                                    ;
 4646 A:dfa3                                    ; INTIDX READS A FORMULA FROM THE CURRENT POSITION AND
 4647 A:dfa3                                    ; TURNS IT INTO A POSITIVE INTEGER
 4648 A:dfa3                                    ; LEAVING THE RESULT IN FACMO&LO. NEGATIVE ARGUMENTS
 4649 A:dfa3                                    ; ARE NOT ALLOWED.
 4650 A:dfa3                                    ;
 4651 A:dfa3                           INTIDX    
 4651 A:dfa3  20 b2 00                           jsr CHRGET
 4652 A:dfa6  20 25 dc                           jsr FRMEVL                ;GET A NUMBER
 4653 A:dfa9                           POSINT    
 4653 A:dfa9  20 11 dc                           jsr CHKNUM
 4654 A:dfac  a5 a5                              lda FACSGN
 4655 A:dfae  30 0f                              bmi NONONO                ;IF NEGATIVE, BLOW HIM OUT.
 4656 A:dfb0                           AYINT     
 4656 A:dfb0  a5 a0                              lda FACEXP
 4657 A:dfb2  c9 90                              cmp #144             ;FAC .GT. 32767?
 4658 A:dfb4  90 0b                              bcc QINTGO
 4659 A:dfb6                                    ;GET ADDR OF -32768.
 4660 A:dfb6  a9 9f                              lda #N32768&255
 4661 A:dfb8  a0 df                              ldy #N32768/256
 4662 A:dfba  20 5d ea                           jsr FCOMP                ;SEE IF FAC=[[Y,A]].
 4663 A:dfbd                           NONONO    
 4663 A:dfbd  d0 7f                              bne FCERR                ;NO, FAC IS TOO BIG.
 4664 A:dfbf                           QINTGO    
 4664 A:dfbf  4c 9d ea                           jmp QINT                ;GO TO QINT AND SHOVE IT.
 4665 A:dfc2                                    ;
 4666 A:dfc2                                    ; FORMAT OF ARRAYS IN CORE.
 4667 A:dfc2                                    ;
 4668 A:dfc2                                    ; DESCRIPTOR:
 4669 A:dfc2                                    ; LOWBYTE = FIRST CHARACTER.
 4670 A:dfc2                                    ; HIGHBYTE = SECOND CHARACTER (200 BIT IS STRING FLAG).
 4671 A:dfc2                                    ; LENGTH OF ARRAY IN CORE IN BYTES (INCLUDES EVERYTHING).
 4672 A:dfc2                                    ; NUMBER OF DIMENSIONS.
 4673 A:dfc2                                    ; FOR EACH DIMENSION STARTING WITH THE FIRST A LIST
 4674 A:dfc2                                    ; (2 BYTES EACH) OF THE MAX INDICE+1
 4675 A:dfc2                                    ; THE VALUES
 4676 A:dfc2                                    ;
 4677 A:dfc2                           ISARY     
 4677 A:dfc2  a5 10                              lda DIMFLG

 4680 A:dfc4  05 12                              ora INTFLG

 4682 A:dfc6  48                                 pha                    ;SAVE [DIMFLG] FOR RECURSION.
 4683 A:dfc7  a5 11                              lda VALTYP
 4684 A:dfc9  48                                 pha                    ;SAVE [VALTYP] FOR RECURSION.
 4685 A:dfca  a0 00                              ldy #0             ;SET NUMBER OF DIMENSIONS TO ZERO.
 4686 A:dfcc                           INDLOP    
 4686 A:dfcc  98                                 tya                    ;SAVE NUMBER OF DIMS.
 4687 A:dfcd  48                                 pha 
 4688 A:dfce                                    ;SAVE LOOKS.
 4689 A:dfce  a5 85                              lda VARNAM+1
 4690 A:dfd0  48                                 pha 
 4691 A:dfd1  a5 84                              lda VARNAM
 4692 A:dfd3  48                                 pha 
 4693 A:dfd4  20 a3 df                           jsr INTIDX                ;EVALUATE INDICE INTO FACMO&LO.
 4694 A:dfd7                                    ;GET BACK ALL... WE'RE HOME.
 4695 A:dfd7  68                                 pla 
 4696 A:dfd8  85 84                              sta VARNAM
 4697 A:dfda  68                                 pla 
 4698 A:dfdb  85 85                              sta VARNAM+1
 4699 A:dfdd  68                                 pla                    ;(# OF DIMS).
 4700 A:dfde  a8                                 tay 
 4701 A:dfdf  ba                                 tsx 
 4702 A:dfe0  bd 02 01                           lda 258,X
 4703 A:dfe3  48                                 pha                    ;PUSH DIMFLG AND VALTYP FURTHER.
 4704 A:dfe4  bd 01 01                           lda 257,X
 4705 A:dfe7  48                                 pha 
 4706 A:dfe8  a5 a3                              lda FACMO                ;PUT INDICE ONTO STACK.
 4707 A:dfea  9d 02 01                           sta 258,X,           ;UNDER DIMFLG AND VALTYP.
 4708 A:dfed  a5 a4                              lda FACMO+1
 4709 A:dfef  9d 01 01                           sta 257,X
 4710 A:dff2  c8                                 iny                    ;INCREMENT # OF DIMS.
 4711 A:dff3  20 b8 00                           jsr CHRGOT                ;GET TERMINATING CHARACTER.
 4712 A:dff6  c9 2c                              cmp #44             ;A COMMA?
 4713 A:dff8  f0 d2                              beq INDLOP                ;YES.
 4714 A:dffa  84 0f                              sty COUNT                ;SAVE COUNT OF DIMS.
 4715 A:dffc  20 68 dd                           jsr CHKCLS                ;MUST BE CLOSED PAREN.
 4716 A:dfff  68                                 pla 
 4717 A:e000  85 11                              sta VALTYP                ;GET VALTYP AND
 4718 A:e002  68                                 pla 

 4721 A:e003  85 12                              sta INTFLG
 4722 A:e005  29 7f                              and #127

 4724 A:e007  85 10                              sta DIMFLG                ;DIMFLG OFF STACK.
 4725 A:e009  a6 6e                              ldx ARYTAB                ;PLACE TO START SEARCH.
 4726 A:e00b  a5 6f                              lda ARYTAB+1
 4727 A:e00d                           LOPFDA    
 4727 A:e00d  86 9e                              stx LOWTR
 4728 A:e00f  85 9f                              sta LOWTR+1
 4729 A:e011  c5 71                              cmp STREND+1          ;END OF ARRAYS?
 4730 A:e013  d0 06                              bne LOPFDV
 4731 A:e015  e4 70                              cpx STREND
 4732 A:e017  f0 3e                              beq NOTFDD                ;A FINE THING! NO ARRAY!.
 4733 A:e019                           LOPFDV    
 4733 A:e019  a0 00                              ldy #0
 4734 A:e01b  b1 9e                              lda (LOWTR),Y
 4735 A:e01d  c8                                 iny 
 4736 A:e01e  c5 84                              cmp VARNAM                ;COMPARE HIGH ORDERS.
 4737 A:e020  d0 08                              bne NMARY1                ;NO WAY IS IT THIS. GET OUT OF HERE.
 4738 A:e022  a5 85                              lda VARNAM+1
 4739 A:e024  d1 9e                              cmp (LOWTR),Y            ;LOW ORDERS?
 4740 A:e026  f0 1b                              beq GOTARY                ;WELL, HERE IT IS !!
 4741 A:e028                           NMARY1    
 4741 A:e028  c8                                 iny 
 4742 A:e029  b1 9e                              lda (LOWTR),Y            ;GET LENGTH.
 4743 A:e02b  18                                 clc 
 4744 A:e02c  65 9e                              adc LOWTR
 4745 A:e02e  aa                                 tax 
 4746 A:e02f  c8                                 iny 
 4747 A:e030  b1 9e                              lda (LOWTR),Y
 4748 A:e032  65 9f                              adc LOWTR+1
 4749 A:e034  90 d7                              bcc LOPFDA                ;ALWAYS BRANCHES.
 4750 A:e036                           BSERR     
 4750 A:e036  a2 6b                              ldx #107             ;GET BAD SUB ERROR NUMBER.
 4751 A:e038  00 02 2c 00                        .word 512,44
 4752 A:e03c                           FCERR     
 4752 A:e03c  a2 35                              ldx #53             ;TOO BIG. "FUNCTION CALL" ERROR.
 4753 A:e03e                           ERRGO3    
 4753 A:e03e  4c 1d d3                           jmp ERROR
 4754 A:e041                           GOTARY    
 4754 A:e041  a2 78                              ldx #120             ;PERHAPS A "RE-DIMENSION" ERROR
 4755 A:e043  a5 10                              lda DIMFLG                ;TEST THE DIMFLG
 4756 A:e045  d0 f7                              bne ERRGO3
 4757 A:e047  20 8e df                           jsr FMAPTR
 4758 A:e04a  a5 0f                              lda COUNT                ;GET NUMBER OF DIMS INPUT.
 4759 A:e04c  a0 04                              ldy #4
