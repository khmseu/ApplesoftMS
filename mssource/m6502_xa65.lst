 5856 A:e61d                                    ; THE WAIT LOCATION,MASK1,MASK2 STATEMENT WAITS UNTIL THE CONTENTS
 5857 A:e61d                                    ; OF LOCATION IS NONZERO WHEN XORED WITH MASK2
 5858 A:e61d                                    ; AND THEN ANDED WITH MASK1. IF MASK2 IS NOT PRESENT, IT
 5859 A:e61d                                    ; IS ASSUMED TO BE ZERO.

 5861 A:e61d                           FNWAIT    
 5861 A:e61d  20 db e5                           jsr GETNUM
 5862 A:e620  86 88                              stx FORPNT
 5863 A:e622  a2 00                              ldx #0
 5864 A:e624  20 b8 00                           jsr CHRGOT
 5865 A:e627  f0 07                              beq STORDO
 5866 A:e629  20 e1 e5                           jsr COMBYT                ;GET MASK2.
 5867 A:e62c                           STORDO    
 5867 A:e62c  86 89                              stx FORPNT+1
 5868 A:e62e  a0 00                              ldy #0
 5869 A:e630                           WAITER    
 5869 A:e630  b1 53                              lda (LINNUM),Y
 5870 A:e632  45 89                              eor FORPNT+1
 5871 A:e634  25 88                              and FORPNT
 5872 A:e636  f0 f8                              beq WAITER
 5873 A:e638                           ZERRTS    
 5873 A:e638  60                                 rts                    ;GOT A NONZERO.

 5875 A:e639                                    ; SUBTTL FLOATING POINT MATH PACKAGE CONFIGURATION.

 5877 A:e639                                    ; RADIX 8 ;!!!! ALERT !!!!
 5878 A:e639                                    ;THROUGHOUT THE MATH PACKAGE.
 5879 A:e639                                    ; COMMENT %
 5880 A:e639                                    ; THE FLOATING POINT FORMAT IS AS FOLLOWS:
 5881 A:e639                                    ;
 5882 A:e639                                    ; THE SIGN IS THE FIRST BIT OF THE MANTISSA.
 5883 A:e639                                    ; THE MANTISSA IS 24 BITS LONG.
 5884 A:e639                                    ; THE BINARY POINT IS TO THE LEFT OF THE MSB.
 5885 A:e639                                    ; NUMBER = MANTISSA * 2 ^ EXPONENT.
 5886 A:e639                                    ; THE MANTISSA IS POSITIVE WITH A ONE ASSUMED TO BE WHERE THE SIGN BIT IS.
 5887 A:e639                                    ; THE SIGN OF THE EXPONENT IS THE FIRST BIT OF THE EXPONENT.
 5888 A:e639                                    ; THE EXPONENT IS STORED IN EXCESS 200, I.E. WITH A BIAS OF +200.
 5889 A:e639                                    ; SO, THE EXPONENT IS A SIGNED 8-BIT NUMBER WITH 200 ADDED TO IT.
 5890 A:e639                                    ; AN EXPONENT OF ZERO MEANS THE NUMBER IS ZERO.
 5891 A:e639                                    ; THE OTHER BYTES MAY NOT BE ASSUMED TO BE ZERO.
 5892 A:e639                                    ; TO KEEP THE SAME NUMBER IN THE FAC WHILE SHIFTING,
 5893 A:e639                                    ;  TO SHIFT RIGHT, EXP:=EXP+1
 5894 A:e639                                    ;  TO SHIFT LEFT, EXP:=EXP-1
 5895 A:e639                                    ;
 5896 A:e639                                    ; IN MEMORY THE NUMBER LOOKS LIKE THIS:
 5897 A:e639                                    ;  [THE EXPONENT AS A SIGNED NUMBER +200]
 5898 A:e639                                    ;  [THE SIGN BIT IN 7, BITS 2-8 OF MANTISSA ARE IN BITS 6-0].
 5899 A:e639                                    ;   (REMEMBER BIT 1 OF MANTISSA IS ALWAYS A ONE.)
 5900 A:e639                                    ;  [BITS 9-16 OF THE MANTISSA]
 5901 A:e639                                    ;  [BITS 17-24] OF THE MANTISSA]
 5902 A:e639                                    ;
 5903 A:e639                                    ; ARITHMETIC ROUTINE CALLING CONVENTIONS:
 5904 A:e639                                    ;
 5905 A:e639                                    ; FOR ONE ARGUMENT FUNCTIONS:
 5906 A:e639                                    ;  THE ARGUMENT IS IN THE FAC.
 5907 A:e639                                    ;  THE RESULT IS LEFT IN THE FAC.
 5908 A:e639                                    ; FOR TWO ARGUMENT OPERATIONS:
 5909 A:e639                                    ;  THE FIRST ARGUMENT IS IN ARG (ARGEXP,HO,MO,LO AND ARGSGN).
 5910 A:e639                                    ;  THE SECOND ARGUMENT IS IN THE FAC.
 5911 A:e639                                    ;  THE RESULT IS LEFT IN THE FAC.
 5912 A:e639                                    ;
 5913 A:e639                                    ; THE "T" ENTRY POINTS TO THE TWO-ARGUMENT OPERATIONS HAVE BOTH ARGUMENTS
 5914 A:e639                                    ; SETUP IN THE RESPECTIVE REGISTERS. BEFORE CALLING ARG MAY HAVE BEEN
 5915 A:e639                                    ; POPPED OFF THE STACK AND INTO ARG, FOR EXAMPLE.
 5916 A:e639                                    ; THE OTHER ENTRY POINT ASSUMES [Y,A] POINTS TO THE ARGUMENT
 5917 A:e639                                    ; SOMEWHERE IN MEMORY. IT IS UNPACKED INTO ARG BY "CONUPK".
 5918 A:e639                                    ;
 5919 A:e639                                    ; ON THE STACK, THE SGN IS PUSHED ON FIRST, THE LO,MO,HO AND FINALLY EXP.
 5920 A:e639                                    ; NOTE ALL THINGS ARE KEPT UNPACKED IN ARG, FAC AND ON THE STACK.
 5921 A:e639                                    ;
 5922 A:e639                                    ; IT IS ONLY WHEN SOMETHING IS STORED AWAY THAT IT IS PACKED TO FOUR
 5923 A:e639                                    ; BYTES. THE UNPACKED FORMAT HAS A SGN BYTE REFLECTING THE SIGN OF THE
 5924 A:e639                                    ; NUMBER (POSITIVE=0, NEGATIVE=-1) A HO,MO AND LO WITH THE HIGH BIT
 5925 A:e639                                    ; OF THE HO TURNED ON. THE EXP IS THE SAME AS STORED FORMAT.
 5926 A:e639                                    ; THIS IS DONE FOR SPEED OF OPERATION.
 5927 A:e639                                    ; %
 5928 A:e639                                    ; PAGE
 5929 A:e639                                    ; SUBTTL FLOATING POINT ADDITION AND SUBTRACTION.
 5930 A:e639                           FADDH     
 5930 A:e639                                    ;ENTRY TO ADD 1/2.
 5931 A:e639  a9 ff                              lda #FHALF&255
 5932 A:e63b  a0 ec                              ldy #FHALF/256
 5933 A:e63d  4c 57 e6                           jmp FADD                ;UNPACK AND GO ADD IT.
 5934 A:e640                           FSUB      
 5934 A:e640  20 7c e8                           jsr CONUPK                ;UNPACK ARGUMENT INTO ARG.
 5935 A:e643                           FSUBT     
 5935 A:e643  a5 a5                              lda FACSGN
 5936 A:e645  49 ff                              eor #255             ;COMPLEMENT IT.
 5937 A:e647  85 a5                              sta FACSGN
 5938 A:e649  45 ad                              eor ARGSGN                ;COMPLEMENT ARISGN.
 5939 A:e64b  85 ae                              sta ARISGN
 5940 A:e64d  a5 a0                              lda FACEXP                ;SET CODES ON FACEXP.
 5941 A:e64f  4c 5a e6                           jmp FADDT                ;[Y]=ARGEXP..
