 2385 A:d56b                                    ; SUBTTL THE "LIST" COMMAND.

 2387 A:d56b                           LIST      
 2387 A:d56b  90 08                              bcc GOLST                ;IT IS A DIGIT.
 2388 A:d56d  f0 06                              beq GOLST                ;IT IS A TERMINATOR.
 2389 A:d56f  c9 81                              cmp #129             ;DASH PRECEDING?
 2390 A:d571  d0 e9                              bne STKRTS                ;NO, SO SYNTAX ERROR.
 2391 A:d573                           GOLST     
 2391 A:d573  20 8a d8                           jsr LINGET                ;GET LINE NUMBER INTO NUMLIN.
 2392 A:d576  20 e5 d4                           jsr FNDLIN                ;FIND LINE .GE. [NUMLIN].
 2393 A:d579  20 b8 00                           jsr CHRGOT                ;GET LAST CHARACTER.
 2394 A:d57c  f0 0e                              beq LSTEND                ;IF END OF LINE, # IS THE END.
 2395 A:d57e  c9 81                              cmp #129             ;DASH?
 2396 A:d580  d0 91                              bne FLNRTS                ;IF NOT, SYNTAX ERROR.
 2397 A:d582  20 b2 00                           jsr CHRGET                ;GET NEXT CHAR.
 2398 A:d585  20 8a d8                           jsr LINGET                ;GET END #.
 2399 A:d588  d0 89                              bne FLNRTS                ;IF NOT TERMINATOR, ERROR.
 2400 A:d58a                           LSTEND    
 2400 A:d58a  68                                 pla 
 2401 A:d58b  68                                 pla                    ;GET RID OF "NEWSTT" RTS ADDR.
 2402 A:d58c  a5 53                              lda LINNUM                ;SEE IF IT WAS EXISTENT.
 2403 A:d58e  05 54                              ora LINNUM+1
 2404 A:d590  d0 08                              bne LIST4                ;IT WAS TYPED.
 2405 A:d592  a9 ff                              lda #255
 2406 A:d594  85 53                              sta LINNUM
 2407 A:d596  85 54                              sta LINNUM+1          ;MAKE IT HUGE.
 2408 A:d598                           LIST4     
 2408 A:d598  a0 01                              ldy #1

 2413 A:d59a  b1 9e                              lda (LOWTR),Y            ;IS LINK ZERO?
 2414 A:d59c  f0 3b                              beq GRODY                ;YES, GO TO READY.

 2417 A:d59e  20 e1 ff                           jsr 65505

 2419 A:d5a1  20 8b d9                           jsr CRDO                ;PRINT CRLF TO START WITH.
 2420 A:d5a4  c8                                 iny 
 2421 A:d5a5  b1 9e                              lda (LOWTR),Y
 2422 A:d5a7  aa                                 tax 
 2423 A:d5a8  c8                                 iny 
 2424 A:d5a9  b1 9e                              lda (LOWTR),Y            ;GET LINE NUMBER.
 2425 A:d5ab  c5 54                              cmp LINNUM+1          ;SEE IF BEYOND LAST.
 2426 A:d5ad  d0 06                              bne TSTDUN                ;GO DETERMINE RELATION.
 2427 A:d5af  e4 53                              cpx LINNUM                ;WAS EQUAL SO TEST LOW ORDER.
 2428 A:d5b1  f0 04                              beq TYPLIN                ;EQUAL, SO LIST IT.
 2429 A:d5b3                           TSTDUN    
 2429 A:d5b3  b0 24                              bcs GRODY                ;IF LINE IS GR THAN LAST, THEN DUNE.
 2430 A:d5b5                           TYPLIN    
 2430 A:d5b5  84 88                              sty FORPNT
 2431 A:d5b7  20 c3 eb                           jsr LINPRT                ;PRINT AS INT WITHOUT LEADING SPACE.
 2432 A:d5ba  a9 20                              lda #" "             ;ALWAYS PRINT SPACE AFTER NUMBER.
 2433 A:d5bc                           PRIT4     
 2433 A:d5bc  a4 88                              ldy FORPNT                ;GET POINTER TO LINE BACK.
 2434 A:d5be  29 7f                              and #127
 2435 A:d5c0                           PLOOP     
 2435 A:d5c0  20 fa d9                           jsr OUTDO                ;PRINT CHAR.

 2445 A:d5c3                           PLOOP1    
 2445 A:d5c3  c8                                 iny 
 2446 A:d5c4  f0 13                              beq GRODY                ;IF WE HAVE PRINTED 256 CHARACTERS
 2447 A:d5c6                                    ;THE PROGRAM MUST BE MISFORMATED IN
 2448 A:d5c6                                    ;MEMORY DUE TO A BAD LOAD OR BAD
 2449 A:d5c6                                    ;HARDWARE. LET THE GUY RECOVER
 2450 A:d5c6  b1 9e                              lda (LOWTR),Y            ;GET NEXT CHAR. IS IT ZERO?
 2451 A:d5c8  d0 12                              bne QPLOP                ;YES. END OF LINE.
 2452 A:d5ca  a8                                 tay 
 2453 A:d5cb  b1 9e                              lda (LOWTR),Y
 2454 A:d5cd  aa                                 tax 
 2455 A:d5ce  c8                                 iny 
 2456 A:d5cf  b1 9e                              lda (LOWTR),Y
 2457 A:d5d1  86 9e                              stx LOWTR
 2458 A:d5d3  85 9f                              sta LOWTR+1
 2459 A:d5d5  d0 c1                              bne LIST4                ;BRANCH IF SOMETHING TO LIST.
 2460 A:d5d7                           GRODY     
 2460 A:d5d7  4c 38 d3                           jmp READY
 2461 A:d5da                                    ;IS IT A TOKEN?
 2462 A:d5da                           QPLOP     
 2462 A:d5da  10 e4                              bpl PLOOP                ;NO, HEAD FOR PRINTER.

 2470 A:d5dc  38                                 sec 
 2471 A:d5dd  e9 7f                              sbc #127             ;GET RID OF SIGN BIT AND ADD 1.
 2472 A:d5df  aa                                 tax                    ;MAKE IT A COUNTER.
 2473 A:d5e0  84 88                              sty FORPNT                ;SAVE POINTER TO LINE.
 2474 A:d5e2  a0 ff                              ldy #255             ;LOOK AT RES'D WORD LIST.
 2475 A:d5e4                           RESRCH    
 2475 A:d5e4  ca                                 dex                    ;IS THIS THE RES'D WORD?
 2476 A:d5e5  f0 0a                              beq PRIT3                ;YES, GO TOSS IT UP..
 2477 A:d5e7                           RESCR1    
 2477 A:d5e7  c8                                 iny 
 2478 A:d5e8  b9 80 d0                           lda RESLST,Y,             ;END OF ENTRY?
 2479 A:d5eb  10 fa                              bpl RESCR1                ;NO, CONTINUE PASSING.
 2480 A:d5ed  30 f5                              bmi RESRCH
 2481 A:d5ef                           PRIT3     
 2481 A:d5ef  c8                                 iny 
 2482 A:d5f0  b9 80 d0                           lda RESLST,Y
 2483 A:d5f3  30 c7                              bmi PRIT4                ;END OF RESERVED WORD.
 2484 A:d5f5  20 fa d9                           jsr OUTDO                ;PRINT IT.
 2485 A:d5f8  d0 f5                              bne PRIT3                ;END OF ENTRY? NO, TYPE REST.
 2486 A:d5fa                                    ; PAGE
 2487 A:d5fa                                    ; SUBTTL THE "FOR" STATEMENT.
 2488 A:d5fa                                    ;
 2489 A:d5fa                                    ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2490 A:d5fa                                    ;
 2491 A:d5fa                                    ; LOW ADDRESS
 2492 A:d5fa                                    ; TOKEN (FORTK) 1 BYTE
