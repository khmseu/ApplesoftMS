 2432 A:d5c3  20 cf eb                           jsr LINPRT                ;PRINT AS INT WITHOUT LEADING SPACE.
 2433 A:d5c6  a9 20                              lda #" "             ;ALWAYS PRINT SPACE AFTER NUMBER.
 2434 A:d5c8                           PRIT4     
