 2386 A:d577                                    ; SUBTTL THE "LIST" COMMAND.

 2388 A:d577                           LIST      
 2388 A:d577  90 08                              bcc GOLST                ;IT IS A DIGIT.
 2389 A:d579  f0 06                              beq GOLST                ;IT IS A TERMINATOR.
 2390 A:d57b  c9 81                              cmp #129             ;DASH PRECEDING?
 2391 A:d57d  d0 e9                              bne STKRTS                ;NO, SO SYNTAX ERROR.
 2392 A:d57f                           GOLST     
