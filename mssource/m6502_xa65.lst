 4762 A:177a                                    ;
 4763 A:177a                                    ; HERE WHEN VARIABLE IS NOT FOUND IN THE ARRAY TABLE.
 4764 A:177a                                    ;
 4765 A:177a                                    ; BUILDING AN ENTRY.
 4766 A:177a                                    ;
 4767 A:177a                                    ; PUT DOWN THE DESCRIPTOR.
 4768 A:177a                                    ; SETUP NUMBER OF DIMENSIONS.
 4769 A:177a                                    ; MAKE SURE THERE IS ROOM FOR THE NEW ENTRY.
 4770 A:177a                                    ; REMEMBER "VARPNT".
 4771 A:177a                                    ; TALLY=4.
 4772 A:177a                                    ; SKIP 2 LOCS FOR LATER FILL IN OF SIZE.
 4773 A:177a                                    ; LOOP: GET AN INDICE
 4774 A:177a                                    ; PUT DOWN NUMBER+1 AND INCREMENT VARPTR.
 4775 A:177a                                    ; TALLY=TALLY*NUMBER+1.
 4776 A:177a                                    ; DECREMENT NUMBER-DIMS.
 4777 A:177a                                    ; BNE LOOP
 4778 A:177a                                    ; CALL "REASON" WITH [Y,A] REFLECTING LAST LOC OF VARIABLE.
 4779 A:177a                                    ; UPDATE STREND.
 4780 A:177a                                    ; ZERO ALL.
 4781 A:177a                                    ; MAKE TALLY INCLUDE MAXDIMS AND DESCRIPTOR.
 4782 A:177a                                    ; PUT DOWN TALLY.
 4783 A:177a                                    ; IF CALLED BY DIMENSION, RETURN.
 4784 A:177a                                    ; OTHERWISE INDEX INTO THE VARIABLE AS IF IT
 4785 A:177a                                    ;  WERE FOUND ON THE INITIAL SEARCH.
 4786 A:177a                                    ;
 4787 A:177a                           NOTFDD    
 4787 A:177a  20 b3 16                           jsr FMAPTR                ;FORM ARYPNT.
 4788 A:177d  20 14 0a                           jsr REASON
 4789 A:1780  a9 00                              lda #0
 4790 A:1782  a8                                 tay 
 4791 A:1783  85 b1                              sta FBUFPT+1

 4798 A:1785  a2 05                              ldx #5

 4800 A:1787  a5 84                              lda VARNAM                ;THIS CODE ONLY WORKS FOR INTPRC=1
 4801 A:1789  91 9e                              sta (LOWTR),Y            ;IF ADDPRC=1.

 4804 A:178b  10 03                              bpl NOTFLT
 4805 A:178d  ca                                 dex 

