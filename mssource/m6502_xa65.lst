 2913 A:d7a1                                    ;
 2914 A:d7a1                                    ; A GOSUB ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2915 A:d7a1                                    ;
 2916 A:d7a1                                    ; LOW ADDRESS:
 2917 A:d7a1                                    ; THE GOSUTK ONE BYTE
 2918 A:d7a1                                    ; THE LINE NUMBER OF THE GOSUB STATEMENT TWO BYTES
 2919 A:d7a1                                    ; A POINTER INTO THE TEXT OF THE GOSUB TWO BYTES
 2920 A:d7a1                                    ;
 2921 A:d7a1                                    ; HIGH ADDRESS.
 2922 A:d7a1                                    ;
 2923 A:d7a1                                    ; TOTAL FIVE BYTES.
 2924 A:d7a1                                    ;
 2925 A:d7a1                           GOSUB     
 2925 A:d7a1  a9 03                              lda #3
 2926 A:d7a3  20 d5 d2                           jsr GETSTK                ;MAKE SURE THERE IS ROOM.
 2927 A:d7a6                                    ;PUSH ON THE TEXT POINTER.
 2928 A:d7a6  a5 ba                              lda CHRGOT+1+1
 2929 A:d7a8  48                                 pha 
 2930 A:d7a9  a5 b9                              lda CHRGOT+1
 2931 A:d7ab  48                                 pha 
 2932 A:d7ac                                    ;PUSH ON THE CURRENT LINE NUMBER.
 2933 A:d7ac  a5 79                              lda CURLIN+1
 2934 A:d7ae  48                                 pha 
