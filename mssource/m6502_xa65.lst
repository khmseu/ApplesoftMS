 3061 A:d896                                    ; PAGE
 3062 A:d896                                    ; SUBTTL LINGET -- READ A LINE NUMBER INTO LINNUM
 3063 A:d896                                    ;
 3064 A:d896                                    ; "LINGET" READS A LINE NUMBER FROM THE CURRENT TEXT POSITION.
 3065 A:d896                                    ;
 3066 A:d896                                    ; LINE NUMBERS RANGE FROM 0 TO 64000-1.
 3067 A:d896                                    ;
 3068 A:d896                                    ; THE ANSWER IS RETURNED IN "LINNUM".
 3069 A:d896                                    ; "TXTPTR" IS UPDATED TO POINT TO THE TERMINATING CHARCTER
 3070 A:d896                                    ; AND [A] = THE TERMINATING CHARACTER WITH CONDITION
 3071 A:d896                                    ; CODES SET UP TO REFLECT ITS VALUE.
 3072 A:d896                                    ;
 3073 A:d896                           LINGET    
 3073 A:d896  a2 00                              ldx #0
 3074 A:d898  86 53                              stx LINNUM                ;INITIALIZE LINE NUMBER TO ZERO.
 3075 A:d89a  86 54                              stx LINNUM+1
 3076 A:d89c                           MORLIN    
 3076 A:d89c  b0 f7                              bcs ONGRTS                ;IT IS NOT A DIGIT.
 3077 A:d89e  e9 2f                              sbc #"0"-1       ;-1 SINCE C=0.
 3078 A:d8a0  85 0d                              sta CHARAC                ;SAVE CHARACTER.
 3079 A:d8a2  a5 54                              lda LINNUM+1
 3080 A:d8a4  85 61                              sta INDEX1
 3081 A:d8a6  c9 19                              cmp #25             ;LINE NUMBER WILL BE .LT. 64000?
 3082 A:d8a8  b0 d4                              bcs SNERR3
 3083 A:d8aa  a5 53                              lda LINNUM
 3084 A:d8ac  0a                                 asl                    ;MULTIPLY BY 10.
 3085 A:d8ad  26 61                              rol INDEX1
 3086 A:d8af  0a                                 asl 
 3087 A:d8b0  26 61                              rol INDEX1
 3088 A:d8b2  65 53                              adc LINNUM
 3089 A:d8b4  85 53                              sta LINNUM
 3090 A:d8b6  a5 61                              lda INDEX1
 3091 A:d8b8  65 54                              adc LINNUM+1
 3092 A:d8ba  85 54                              sta LINNUM+1
 3093 A:d8bc  06 53                              asl LINNUM
 3094 A:d8be  26 54                              rol LINNUM+1
 3095 A:d8c0  a5 53                              lda LINNUM
 3096 A:d8c2  65 0d                              adc CHARAC                ;ADD IN DIGIT.
 3097 A:d8c4  85 53                              sta LINNUM
 3098 A:d8c6  90 04                              bcc NXTLGC
 3099 A:d8c8  e6 54                              inc LINNUM+1
 3100 A:d8ca                           NXTLGC    
