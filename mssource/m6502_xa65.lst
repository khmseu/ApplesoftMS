 7192 A:241c  a9 00                              lda #0             ;PUT IN TERMINATOR.
 7193 A:241e  99 04 01                           sta FBUFFR-1+5,Y,
 7194 A:2421  f0 0c                              beq FOUT20                ;RETURN. (ALWAYS BRANCHES).
 7195 A:2423                           FOUT19    
