 7461 A:24d4  00                                 .byt 0

 7464 A:24d5                           EXP       
 7464 A:24d5                                    
 7465 A:24d5                                    ;MULTIPLY BY LOG(E) BASE 2.
 7466 A:24d5  a9 a7                              lda #LOGEB2&255
 7467 A:24d7  a0 24                              ldy #LOGEB2/256
 7468 A:24d9  20 49 1f                           jsr FMULT
 7469 A:24dc  a5 af                              lda FACOV
 7470 A:24de  69 50                              adc #80
 7471 A:24e0  90 07                              bcc STOLD
 7472 A:24e2  20 4a 21                           jsr INCRND
 7473 A:24e5                           STOLD     
 7473 A:24e5  85 95                              sta JMPER+2
 7474 A:24e7  20 36 21                           jsr MOVEF                ;TO SAVE IN ARG WITHOUT ROUND.
 7475 A:24ea  a5 a0                              lda FACEXP
 7476 A:24ec  c9 88                              cmp #136             ;IF ABS(FAC) .GE. 128, TOO BIG.
 7477 A:24ee  90 07                              bcc EXP1
 7478 A:24f0                           GOMLDV    
 7478 A:24f0  20 f8 1f                           jsr MLDVEX                ;OVERFLOW OR OVERFLOW.
 7479 A:24f3                           EXP1      
 7479 A:24f3  20 f3 21                           jsr INT
 7480 A:24f6  a5 0d                              lda CHARAC                ;GET LOW PART.
 7481 A:24f8  18                                 clc 
 7482 A:24f9  69 81                              adc #129
 7483 A:24fb  f0 f3                              beq GOMLDV                ;OVERFLOW OR OVERFLOW !!
 7484 A:24fd  38                                 sec 
 7485 A:24fe  e9 01                              sbc #1             ;SUBTRACT 1.
 7486 A:2500  48                                 pha                    ;SAVE A WHILE.
 7487 A:2501  a2 05                              ldx #4+1       ;PREP TO SWAP FAC AND ARG.
 7488 A:2503                           SWAPLP    
 7488 A:2503  b5 a8                              lda ARGEXP,X
 7489 A:2505  b4 a0                              ldy FACEXP,X
 7490 A:2507  95 a0                              sta FACEXP,X
 7491 A:2509  94 a8                              sty ARGEXP,X
 7492 A:250b  ca                                 dex 
 7493 A:250c  10 f5                              bpl SWAPLP
 7494 A:250e  a5 95                              lda JMPER+2
 7495 A:2510  85 af                              sta FACOV
 7496 A:2512  20 74 1d                           jsr FSUBT
 7497 A:2515  20 9c 24                           jsr NEGOP                ;NEGATE FAC.

 7499 A:2518  a9 ac                              lda #EXPCON&255
 7500 A:251a  a0 24                              ldy #EXPCON/256
 7501 A:251c  20 3e 25                           jsr POLY
 7502 A:251f                                    ;MULTIPLY BY POSITIVE 1.0.
 7503 A:251f  a9 00                              lda #0
 7504 A:2521  85 ae                              sta ARISGN
 7505 A:2523  68                                 pla                    ;GET SCALE FACTOR.
 7506 A:2524  20 da 1f                           jsr MLDEXP                ;MODIFY FACEXP AND CHECK FOR OVERFLOW.
 7507 A:2527  60                                 rts                    ;HAS TO DO JSR DUE TO PULAS IN MULDIV.

 7510 A:2528                                    ; PAGE
 7511 A:2528                                    ; SUBTTL POLYNOMIAL EVALUATOR AND THE RANDOM NUMBER GENERATOR.
 7512 A:2528                                    ;EVALUATE P(X^2)*X
 7513 A:2528                                    ;POINTER TO DEGREE IS IN [Y,A].
 7514 A:2528                                    ;THE CONSTANTS FOLLOW THE DEGREE.
 7515 A:2528                                    ;FOR X=FAC, COMPUTE:
 7516 A:2528                                    ; C0*X+C1*X^3+C2*X^5+C3*X^7+...+C(N)*X^(2*N+1)
 7517 A:2528                           POLYX     
 7517 A:2528                                    ;RETAIN POLYNOMIAL POINTER FOR LATER.
 7518 A:2528  85 b0                              sta FBUFPT
 7519 A:252a  84 b1                              sty FBUFPT+1
 7520 A:252c  20 f1 20                           jsr MOV1F                ;SAVE FAC IN FACTMP.
 7521 A:252f  a9 96                              lda #TEMPF1
 7522 A:2531  20 49 1f                           jsr FMULT                ;COMPUTE X^2.
 7523 A:2534  20 42 25                           jsr POLY1                ;COMPUTE P(X^2).

 7525 A:2537  a9 96                              lda #TEMPF1&255
 7526 A:2539  a0 00                              ldy #TEMPF1/256
 7527 A:253b  4c 49 1f                           jmp FMULT                ;MULTIPLY BY FAC AGAIN.

 7529 A:253e                                    ;POLYNOMIAL EVALUATOR.
 7530 A:253e                                    ;POINTER TO DEGREE IS IN [Y,A].
 7531 A:253e                                    ;COMPUTE:
 7532 A:253e                                    ; C0+C1*X+C2*X^2+C3*X^3+C4*X^4+...+C(N-1)*X^(N-1)+C(N)*X^N.
 7533 A:253e                           POLY      
 7533 A:253e                                    
 7534 A:253e  85 b0                              sta FBUFPT
 7535 A:2540  84 b1                              sty FBUFPT+1
 7536 A:2542                           POLY1     
 7536 A:2542  20 eb 20                           jsr MOV2F                ;SAVE FAC.
 7537 A:2545  b1 b0                              lda (FBUFPT),Y
 7538 A:2547  85 a6                              sta SGNFLG
 7539 A:2549  a4 b0                              ldy FBUFPT
 7540 A:254b  c8                                 iny 
 7541 A:254c  98                                 tya 
 7542 A:254d  d0 06                              bne POLY3
 7543 A:254f  e6 b1                              inc FBUFPT+1
 7544 A:2551                           POLY3     
 7544 A:2551  85 b0                              sta FBUFPT
 7545 A:2553  a4 b1                              ldy FBUFPT+1
 7546 A:2555                           POLY2     
 7546 A:2555  20 49 1f                           jsr FMULT
 7547 A:2558                                    ;GET CURRENT POINTER.
 7548 A:2558  a5 b0                              lda FBUFPT
 7549 A:255a  a4 b1                              ldy FBUFPT+1
 7550 A:255c  18                                 clc 
 7551 A:255d  69 05                              adc #4+1
 7552 A:255f  90 05                              bcc POLY4
 7553 A:2561  c8                                 iny 
 7554 A:2562                           POLY4     
 7554 A:2562                                    
 7555 A:2562  85 b0                              sta FBUFPT
 7556 A:2564  84 b1                              sty FBUFPT+1
 7557 A:2566  20 88 1d                           jsr FADD                ;ADD IN CONSTANT.
 7558 A:2569                                    ;MULTIPLY THE ORIGINAL FAC.
 7559 A:2569  a9 9b                              lda #TEMPF2&255
 7560 A:256b  a0 00                              ldy #TEMPF2/256
 7561 A:256d  c6 a6                              dec SGNFLG                ;DONE?
 7562 A:256f  d0 e4                              bne POLY2
 7563 A:2571                           RANDRT    
 7563 A:2571  60                                 rts                    ;YES.

 7565 A:2572                                    ;PSUEDO-RANDOM NUMBER GENERATOR.
 7566 A:2572                                    ;IF ARG=0, THE LAST RANDOM NUMBER GENERATED IS RETURNED.
 7567 A:2572                                    ;IF ARG .LT. 0, A NEW SEQUENCE OF RANDOM NUMBERS IS
 7568 A:2572                                    ;STARTED USING THE ARGUMENT.
 7569 A:2572                                    ;   TO FORM THE NEXT RANDOM NUMBER IN THE SEQUENCE,
 7570 A:2572                                    ;MULTIPLY THE PREVIOUS RANDOM NUMBER BY A RANDOM CONSTANT
 7571 A:2572                                    ;AND ADD IN ANOTHER RANDOM CONSTANT. THE THEN HO
 7572 A:2572                                    ;AND LO BYTES ARE SWITCHED, THE EXPONENT IS PUT WHERE
 7573 A:2572                                    ;IT WILL BE SHIFTED IN BY NORMAL, AND THE EXPONENT IN THE FAC
 7574 A:2572                                    ;IS SET TO 200 SO THE RESULT WILL BE LESS THAN 1. THIS
 7575 A:2572                                    ;IS THEN NORMALIZED AND SAVED FOR THE NEXT TIME.
 7576 A:2572                                    ;THE HO AND LOW BYTES WERE SWITCHED SO THERE WILL BE A
 7577 A:2572                                    ;RANDOM CHANCE OF GETTING A NUMBER LESS THAN OR GREATER
 7578 A:2572                                    ;THAN .5 .

 7580 A:2572                           RMULZC    
 7580 A:2572  98                                 .byt 152
 7581 A:2573  35                                 .byt 53
 7582 A:2574  44                                 .byt 68
 7583 A:2575  7a                                 .byt 122
 7584 A:2576                           RADDZC    
 7584 A:2576  68                                 .byt 104
 7585 A:2577  28                                 .byt 40
 7586 A:2578  b1                                 .byt 177
 7587 A:2579  46                                 .byt 70

 7589 A:257a                           RND       
 7589 A:257a  20 52 21                           jsr SIGN                ;GET SIGN INTO ACCX.

 7592 A:257d  aa                                 tax 

 7594 A:257e  30 1c                              bmi RND1                ;START NEW SEQUENCE IF NEGATIVE.

 7612 A:2580                           QSETNR    
 7612 A:2580                                    ;GET LAST ONE INTO FAC.
 7613 A:2580  a9 ca                              lda #RNDX&255
 7614 A:2582  a0 00                              ldy #RNDX/256
 7615 A:2584  20 c6 20                           jsr MOVFM

 7618 A:2587  8a                                 txa 
 7619 A:2588  f0 e7                              beq RANDRT

 7621 A:258a                                    ;MULTIPLY BY RANDOM CONSTANT.
 7622 A:258a  a9 72                              lda #RMULZC&255
 7623 A:258c  a0 25                              ldy #RMULZC/256
 7624 A:258e  20 49 1f                           jsr FMULT

 7626 A:2591  a9 76                              lda #RADDZC&255
 7627 A:2593  a0 25                              ldy #RADDZC/256
 7628 A:2595  20 88 1d                           jsr FADD                ;ADD RANDOM CONSTANT.
 7629 A:2598                           RND1      
 7629 A:2598  a6 a4                              ldx FACLO
 7630 A:259a  a5 a1                              lda FACHO
 7631 A:259c  85 a4                              sta FACLO
 7632 A:259e  86 a1                              stx FACHO                ;REVERSE HO AND LO.

 7640 A:25a0                           STRNEX    
 7640 A:25a0                                    ;MAKE NUMBER POSITIVE.
 7641 A:25a0  a9 00                              lda #0
 7642 A:25a2  85 a5                              sta FACSGN
 7643 A:25a4  a5 a0                              lda FACEXP                ;PUT EXP WHERE IT WILL
 7644 A:25a6  85 af                              sta FACOV                ;BE SHIFTED IN BY NORMAL.
 7645 A:25a8  a9 80                              lda #128
 7646 A:25aa  85 a0                              sta FACEXP                ;MAKE RESULT BETWEEN 0 AND 1.
 7647 A:25ac  20 f8 1d                           jsr NORMAL                ;NORMALIZE.

 7649 A:25af  a2 ca                              ldx #RNDX&255
 7650 A:25b1  a0 00                              ldy #RNDX/256
 7651 A:25b3                           GMOVMF    
 7651 A:25b3  4c fb 20                           jmp MOVMF                ;PUT NEW ONE INTO MEMORY.

