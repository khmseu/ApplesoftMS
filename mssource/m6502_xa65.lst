 2036 A:d444  9d ff 01                           sta 512-1,X
 2037 A:d447  ca                                 dex 
 2038 A:d448  d0 f5                              bne LOPBHT
 2039 A:d44a                           NOCHR     
 2039 A:d44a  a9 00                              lda #0

 2041 A:d44c  a2 ff                              ldx #(512-1)&255
 2042 A:d44e  a0 01                              ldy #(512-1)/256
 2043 A:d450  60                                 rts 

