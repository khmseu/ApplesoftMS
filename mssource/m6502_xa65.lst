 2162 A:d463                                    ;
 2163 A:d463                                    ; ALL "RESERVED" WORDS ARE TRANSLATED INTO SINGLE
 2164 A:d463                                    ; BYTES WITH THE MSB ON. THIS SAVES SPACE AND TIME 
 2165 A:d463                                    ; BY ALLOWING FOR TABLE DISPATCH DURING EXECUTION.
 2166 A:d463                                    ; THEREFORE ALL STATEMENTS APPEAR TOGETHER IN THE
 2167 A:d463                                    ; RESERVED WORD LIST IN THE SAME ORDER THEY
 2168 A:d463                                    ; APPEAR IN STMDSP.
 2169 A:d463                                    ;
 2170 A:d463                                    ;THE AMOUNT TO OFFSET THE LOW BYTE

 2172 A:d463                                    ;OF THE TEXT POINTER TO GET TO BUF
 2173 A:d463                                    ;AFTER TXTPTR HAS BEEN SETUP TO POINT INTO BUF

 2178 A:d463                           CRUNCH    
 2178 A:d463  a6 b9                              ldx CHRGOT+1          ;SET SOURCE POINTER.
 2179 A:d465  a0 04                              ldy #4             ;SET DESTINATION OFFSET.
 2180 A:d467  84 13                              sty DORES                ;ALLOW CRUNCHING.
 2181 A:d469                           KLOOP     
 2181 A:d469  bd 00 02                           lda 512,X

 2190 A:d46c                           CMPSPC    
 2190 A:d46c  c9 20                              cmp #" "             ;IS IT A SPACE TO SAVE?
 2191 A:d46e  f0 37                              beq STUFFH                ;YES, GO SAVE IT.
 2192 A:d470  85 0e                              sta ENDCHR                ;IF IT'S A QUOTE, THIS WILL
 2193 A:d472                                    ;STOP LOOP WHEN OTHER QUOTE APPEARS.
 2194 A:d472  c9 22                              cmp #34             ;QUOTE SIGN?
 2195 A:d474  f0 56                              beq STRNG                ;YES, DO SPECIAL STRING HANDLING.
 2196 A:d476  24 13                              bit DORES                ;TEST FLAG.
 2197 A:d478  70 2d                              bvs STUFFH                ;NO CRUNCH, JUST STORE.
 2198 A:d47a  c9 3f                              cmp #"?"             ;A QMARK?
 2199 A:d47c  d0 04                              bne KLOOP1
 2200 A:d47e  a9 7f                              lda #127             ;YES, STUFF A "PRINT" TOKEN.
 2201 A:d480  d0 25                              bne STUFFH                ;ALWAYS GO TO STUFFH.
 2202 A:d482                           KLOOP1    
 2202 A:d482  c9 30                              cmp #"0"             ;SKIP NUMERICS.
 2203 A:d484  90 04                              bcc MUSTCR
 2204 A:d486  c9 3c                              cmp #60             ;":" AND ";" ARE ENTERED STRAIGHTAWAY.
 2205 A:d488  90 1d                              bcc STUFFH
 2206 A:d48a                           MUSTCR    
