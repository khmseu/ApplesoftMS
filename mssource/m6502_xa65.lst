 2912 A:0ed2                                    ;
 2913 A:0ed2                                    ; A GOSUB ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2914 A:0ed2                                    ;
 2915 A:0ed2                                    ; LOW ADDRESS:
 2916 A:0ed2                                    ; THE GOSUTK ONE BYTE
 2917 A:0ed2                                    ; THE LINE NUMBER OF THE GOSUB STATEMENT TWO BYTES
 2918 A:0ed2                                    ; A POINTER INTO THE TEXT OF THE GOSUB TWO BYTES
 2919 A:0ed2                                    ;
