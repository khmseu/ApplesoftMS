 2569 A:d666                                    ; PAGE
 2570 A:d666                                    ; SUBTTL NEW STATEMENT FETCHER.
 2571 A:d666                                    ;
 2572 A:d666                                    ; BACK HERE FOR NEW STATEMENT. CHARACTER POINTED TO BY TXTPTR
 2573 A:d666                                    ; IS ":" OR END-OF-LINE. THE ADDRESS OF THIS LOC IS LEFT
