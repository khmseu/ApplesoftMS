 5165 A:1980                                    ; PAGE
 5166 A:1980                                    ; SUBTTL STRING FUNCTIONS.
 5167 A:1980                                    ;
 5168 A:1980                                    ; THE STR$ FUNCTION TAKES A NUMBER AND GIVES A STRING
 5169 A:1980                                    ; WITH THE CHARACTERS THE OUTPUT OF THE NUMBER
 5170 A:1980                                    ; WOULD HAVE GIVEN.
 5171 A:1980                                    ;
 5172 A:1980                           STR       
 5172 A:1980  20 36 13                           jsr CHKNUM                ;ARG HAS TO BE NUMERIC.
 5173 A:1983  a0 00                              ldy #0
 5174 A:1985  20 06 23                           jsr FOUTC                ;DO ITS OUTPUT.
 5175 A:1988  68                                 pla 
 5176 A:1989  68                                 pla 
 5177 A:198a                           TIMSTR    
 5177 A:198a                                    
 5178 A:198a  a9 ff                              lda #LOFBUF&255
 5179 A:198c  a0 00                              ldy #LOFBUF/256
 5180 A:198e  f0 14                              beq STRLIT                ;SCAN IT AND TURN IT INTO A STRING.
 5181 A:1990                                    ;
 5182 A:1990                                    ; "STRINI" GET STRING SPACE FOR THE CREATION OF A STRING AND
 5183 A:1990                                    ; CREATES A DESCRIPTOR FOR IT IN "DSCTMP".
 5184 A:1990                                    ;
 5185 A:1990                           STRINI    
 5185 A:1990                                    ;GET FACMO TO STORE IN DSCPNT.
 5186 A:1990  a6 a3                              ldx FACMO
 5187 A:1992  a4 a4                              ldy FACMO+1
 5188 A:1994                                    ;RETAIN THE DESCRIPTOR POINTER.
 5189 A:1994  86 8f                              stx DSCPNT
 5190 A:1996  84 90                              sty DSCPNT+1
 5191 A:1998                           STRSPA    
 5191 A:1998  20 0f 1a                           jsr GETSPA                ;GET STRING SPACE.
 5192 A:199b                                    ;SAVE LOCATION.
 5193 A:199b  86 a1                              stx FAC+1
 5194 A:199d  84 a2                              sty FAC+1+1
 5195 A:199f  85 a0                              sta FAC                ;SAVE LENGTH.
 5196 A:19a1  60                                 rts                    ;ALL DONE.
 5197 A:19a2                                    ;
 5198 A:19a2                                    ; "STRLT2" TAKES THE STRING LITERAL WHOSE FIRST CHARACTER
 5199 A:19a2                                    ; IS POINTED TO BY [Y,A] AND BUILDS A DESCRIPTOR FOR IT.
 5200 A:19a2                                    ; THE DESCRIPTOR IS INITIALLY BUILT IN "DSCTMP", BUT "PUTNEW"
 5201 A:19a2                                    ; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER
 5202 A:19a2                                    ; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN
 5203 A:19a2                                    ; ZERO THAT TERMINATE THE STRING SHOULD BE SET UP IN "CHARAC"
 5204 A:19a2                                    ; AND "ENDCHR". IF THE TERMINATOR IS A QUOTE, THE QUOTE IS SKIPPED
 5205 A:19a2                                    ; OVER. LEADING QUOTES SHOULD BE SKIPPED BEFORE JSR. ON RETURN
 5206 A:19a2                                    ; THE CHARACTER AFTER THE STRING LITERAL IS POINTED TO
 5207 A:19a2                                    ; BY [STRNG2].
 5208 A:19a2                                    ;
 5209 A:19a2                           STRLIT    
 5209 A:19a2  a2 22                              ldx #34             ;ASSUME STRING ENDS ON QUOTE.
 5210 A:19a4  86 0d                              stx CHARAC
 5211 A:19a6  86 0e                              stx ENDCHR
 5212 A:19a8                           STRLT2    
 5212 A:19a8                                    ;SAVE POINTER TO STRING.
 5213 A:19a8  85 ae                              sta ARISGN
 5214 A:19aa  84 af                              sty ARISGN+1
 5215 A:19ac                                    ;IN CASE NO STRCPY.
 5216 A:19ac  85 a1                              sta FAC+1
 5217 A:19ae  84 a2                              sty FAC+1+1
 5218 A:19b0  a0 ff                              ldy #255             ;INITIALIZE CHARACTER COUNT.
 5219 A:19b2                           STRGET    
 5219 A:19b2  c8                                 iny 
 5220 A:19b3  b1 ae                              lda (ARISGN),Y            ;GET CHARACTER.
