 2207 A:d48c  a0 00                              ldy #0             ;LOAD RESLST POINTER.
 2208 A:d48e  84 0f                              sty COUNT                ;ALSO CLEAR COUNT.
 2209 A:d490  88                                 dey 
 2210 A:d491  86 b9                              stx CHRGOT+1          ;SAVE TEXT POINTER FOR LATER USE.
 2211 A:d493  ca                                 dex 
