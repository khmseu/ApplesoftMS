 4751 A:1763  4c 43 0a                           jmp ERROR
 4752 A:1766                           GOTARY    
 4752 A:1766  a2 12                              ldx #18             ;PERHAPS A "RE-DIMENSION" ERROR
 4753 A:1768  a5 10                              lda DIMFLG                ;TEST THE DIMFLG
 4754 A:176a  d0 f7                              bne ERRGO3
 4755 A:176c  20 b3 16                           jsr FMAPTR
 4756 A:176f  a5 0f                              lda COUNT                ;GET NUMBER OF DIMS INPUT.
 4757 A:1771  a0 04                              ldy #4
