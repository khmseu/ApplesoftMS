 6002 A:e675  84 a5                              sty FACSGN                ;SIGN IS SIGN OF RESULT.
 6003 A:e677  49 ff                              eor #255             ;SHIFT A NEGATIVE NUMBER OF PLACES.
 6004 A:e679  69 00                              adc #0             ;COMPLETE NEGATION. W/ C=1.
 6005 A:e67b  a0 00                              ldy #0             ;ZERO OLDOV.
