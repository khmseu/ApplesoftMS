 5312 A:e307  84 75                              sty FRESPC+1
 5313 A:e309  aa                                 tax                    ;PRESERVE A IN X.
 5314 A:e30a  68                                 pla                    ;GET COUNT BACK IN ACCA.
 5315 A:e30b  60                                 rts                    ;ALL DONE.
 5316 A:e30c                           GARBAG    
 5316 A:e30c  a2 4d                              ldx #77             ;"OUT OF STRING SPACE"
 5317 A:e30e  a5 13                              lda DORES
 5318 A:e310  30 b6                              bmi ERRGO2
 5319 A:e312  20 1c e3                           jsr GARBA2
 5320 A:e315  a9 80                              lda #128
 5321 A:e317  85 13                              sta DORES
