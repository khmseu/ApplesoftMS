 2338 A:0c69  84 73                              sty FRETOP+1

 2343 A:0c6b                                    ;LIBERATE THE
 2344 A:0c6b  a5 6c                              lda VARTAB
 2345 A:0c6d  a4 6d                              ldy VARTAB+1
 2346 A:0c6f                                    ;VARIABLES AND
 2347 A:0c6f  85 6e                              sta ARYTAB
