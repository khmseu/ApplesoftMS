 2215 A:d48e  f9 80 d0                           sbc RESLST,Y              ;CHARACTERS EQUAL?
 2216 A:d491  f0 f5                              beq RESER                ;YES, CONTINUE SEARCH.
 2217 A:d493  c9 80                              cmp #128             ;NO BUT MAYBE THE END IS HERE.
 2218 A:d495  d0 30                              bne NTHIS                ;NO, TRULY UNEQUAL.
 2219 A:d497  05 0f                              ora COUNT
