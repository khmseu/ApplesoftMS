 6810 A:ea91                                    ; SUBTTL GREATEST INTEGER FUNCTION.
 6811 A:ea91                                    ;QUICK GREATEST INTEGER FUNCTION.
 6812 A:ea91                                    ;LEAVES INT(FAC) IN FACHO&MO&LO SIGNED.
