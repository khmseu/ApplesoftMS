 1145 A:00b2                                    ; PAGE
 1146 A:00b2                                    ; SUBTTL RAM CODE.
 1147 A:00b2                                    ; THIS CODE GETS CHANGED THROUGHOUT EXECUTION.
 1148 A:00b2                                    ; IT IS MADE TO BE FAST THIS WAY.
 1149 A:00b2                                    ; ALSO, [X] AND [Y] ARE NOT DISTURBED
 1150 A:00b2                                    ;
 1151 A:00b2                                    ; "CHRGET" USING [TXTPTR] AS THE CURRENT TEXT PNTR
 1152 A:00b2                                    ; FETCHES A NEW CHARACTER INTO ACCA AFTER INCREMENTING [TXTPTR]
 1153 A:00b2                                    ; AND SETS CONDITION CODES ACCORDING TO WHAT'S IN ACCA.
 1154 A:00b2                                    ; NOT C= NUMERIC   ("0" THRU "9")
 1155 A:00b2                                    ; Z= ":" OR END-OF-LINE (A NULL)
 1156 A:00b2                                    ;
 1157 A:00b2                                    ; [ACCA] = NEW CHAR.
 1158 A:00b2                                    ; [TXTPTR]=[TXTPTR]+1
 1159 A:00b2                                    ;
 1160 A:00b2                                    ; THE FOLLOWING EXISTS IN ROM IF ROM EXISTS AND IS LOADED
 1161 A:00b2                                    ; DOWN HERE BY INIT. OTHERWISE IT IS JUST LOADED INTO THIS
 1162 A:00b2                                    ; RAM LIKE ALL THE REST OF RAM IS LOADED.
 1163 A:00b2                                    ;
 1164 A:00b2                           CHRGET    
 1164 A:00b2  e6 b9                              inc CHRGET+7          ;INCREMENT THE WHOLE TXTPTR.
 1165 A:00b4  d0 02                              bne CHRGOT
 1166 A:00b6  e6 ba                              inc CHRGET+8
 1167 A:00b8                           CHRGOT    
 1167 A:00b8  ad 60 ea                           lda 60000              ;A LOAD WITH AN EXT ADDR.

 1169 A:00bb  c9 20                              cmp #" "             ;SKIP SPACES.
 1170 A:00bd  f0 f3                              beq CHRGET
 1171 A:00bf                           QNUM      
 1171 A:00bf  c9 3a                              cmp #":"             ;IS IT A ":"?
 1172 A:00c1  b0 06                              bcs CHRRTS                ;IT IS .GE. ":"
 1173 A:00c3  38                                 sec 
 1174 A:00c4  e9 30                              sbc #"0"             ;ALL CHARS .GT. "9" HAVE RET'D SO
 1175 A:00c6  38                                 sec 
 1176 A:00c7  e9 d0                              sbc #256-"0"       ;SEE IF NUMERIC.
 1177 A:00c9                                    ;TURN CARRY ON IF NUMERIC.
 1178 A:00c9                                    ;ALSO, SETZ IF NULL.
 1179 A:00c9                           CHRRTS    
 1179 A:00c9  60                                 rts                    ;RETURN TO CALLER.

 1181 A:00ca                           RNDX      
 1181 A:00ca  80                                 .byt 128              ;LOADED OR FROM ROM.
 1182 A:00cb  4f                                 .byt 79              ;THE INITIAL RANDOM NUMBER.
 1183 A:00cc  c7                                 .byt 199
 1184 A:00cd  52                                 .byt 82

 1186 A:00ce  59                                 .byt 89

