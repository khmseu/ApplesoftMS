 1895 A:d369  20 63 d4                           jsr CRUNCH
 1896 A:d36c  84 0f                              sty COUNT                ;RETAIN CHARACTER COUNT.
 1897 A:d36e  20 f1 d4                           jsr FNDLIN
 1898 A:d371  90 44                              bcc NODEL                ;NO MATCH, SO DON'T DELETE.
 1899 A:d373  a0 01                              ldy #1
 1900 A:d375  b1 9e                              lda (LOWTR),Y
 1901 A:d377  85 62                              sta INDEX1+1
 1902 A:d379  a5 6c                              lda VARTAB
 1903 A:d37b  85 61                              sta INDEX1
 1904 A:d37d  a5 9f                              lda LOWTR+1          ;SET TRANSFER TO.
 1905 A:d37f  85 64                              sta INDEX2+1
 1906 A:d381  a5 9e                              lda LOWTR
 1907 A:d383  88                                 dey 
 1908 A:d384  f1 9e                              sbc (LOWTR),Y            ;COMPUTE NEGATIVE LENGTH.
 1909 A:d386  18                                 clc 
 1910 A:d387  65 6c                              adc VARTAB                ;COMPUTE NEW VARTAB.
 1911 A:d389  85 6c                              sta VARTAB
 1912 A:d38b  85 63                              sta INDEX2                ;SET LOW OF TRANS TO.
 1913 A:d38d  a5 6d                              lda VARTAB+1
 1914 A:d38f  69 ff                              adc #255
 1915 A:d391  85 6d                              sta VARTAB+1          ;COMPUTE HIGH OF VARTAB.
 1916 A:d393  e5 9f                              sbc LOWTR+1          ;COMPUTE NUMBER OF BLOCKS TO MOVE.
 1917 A:d395  aa                                 tax 
 1918 A:d396  38                                 sec 
 1919 A:d397  a5 9e                              lda LOWTR
 1920 A:d399  e5 6c                              sbc VARTAB                ;COMPUTE OFFSET.
 1921 A:d39b  a8                                 tay 
 1922 A:d39c  b0 03                              bcs QDECT1                ;IF VARTAB.LE.LOWTR,
 1923 A:d39e  e8                                 inx                    ;DECR DUE TO CARRY, AND
 1924 A:d39f  c6 64                              dec INDEX2+1          ;DECREMENT STORE SO CARRY WORKS.
 1925 A:d3a1                           QDECT1    
 1925 A:d3a1  18                                 clc 
 1926 A:d3a2  65 61                              adc INDEX1
 1927 A:d3a4  90 03                              bcc MLOOP
 1928 A:d3a6  c6 62                              dec INDEX1+1
 1929 A:d3a8  18                                 clc                    ;FOR LATER ADCQ
 1930 A:d3a9                           MLOOP     
