 3019 A:d846  f0 e5                              beq REMRTS                ;NULL ALWAYS TERMINATES.
 3020 A:d848  c5 0e                              cmp ENDCHR                ;IS IT THE OTHER TERMINATOR?
 3021 A:d84a  f0 e1                              beq REMRTS                ;YES, IT'S FINISHED.
 3022 A:d84c  c8                                 iny                    ;PROGRESS TO NEXT CHARACTER.
 3023 A:d84d  c9 22                              cmp #34             ;IS IT A QUOTE?
 3024 A:d84f  d0 f3                              bne REMER                ;NO, JUST CONTINUE.
 3025 A:d851  f0 e9                              beq EXCHQT                ;YES, TIME TO TRADE.
 3026 A:d853                                    ; PAGE
 3027 A:d853                                    ; SUBTTL "IF ... THEN" CODE.
 3028 A:d853                           IF        
