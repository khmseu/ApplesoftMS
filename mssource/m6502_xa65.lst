 2212 A:0bbb  bd 00 02                           lda 512,X
 2213 A:0bbe  38                                 sec                    ;PREPARE TO SUBSTARCT.
 2214 A:0bbf  f9 80 08                           sbc RESLST,Y              ;CHARACTERS EQUAL?
 2215 A:0bc2  f0 f5                              beq RESER                ;YES, CONTINUE SEARCH.
 2216 A:0bc4  c9 80                              cmp #128             ;NO BUT MAYBE THE END IS HERE.
 2217 A:0bc6  d0 30                              bne NTHIS                ;NO, TRULY UNEQUAL.
 2218 A:0bc8  05 0f                              ora COUNT
 2219 A:0bca                           GETBPT    
 2219 A:0bca  a4 b0                              ldy FBUFPT                ;GET BUFFER PNTR.
 2220 A:0bcc                           STUFFH    
 2220 A:0bcc  e8                                 inx 
 2221 A:0bcd  c8                                 iny 
 2222 A:0bce  99 fb 01                           sta 512-5,Y
 2223 A:0bd1  b9 fb 01                           lda 512-5,Y
 2224 A:0bd4  f0 36                              beq CRDONE                ;NULL IMPLIES END OF LINE.
 2225 A:0bd6  38                                 sec                    ;PREPARE TO SUBSTARCT.
 2226 A:0bd7  e9 3a                              sbc #":"             ;IS IT A ":"?
 2227 A:0bd9  f0 04                              beq COLIS                ;YES, ALLOW CRUNCHING AGAIN.
 2228 A:0bdb  c9 45                              cmp #127-":"       ;IS IT A DATATK?
 2229 A:0bdd  d0 02                              bne NODATT                ;NO, SEE IF IT IS REM TOKEN.
 2230 A:0bdf                           COLIS     
 2230 A:0bdf  85 13                              sta DORES                ;SETUP FLAG.
 2231 A:0be1                           NODATT    
 2231 A:0be1  38                                 sec                    ;PREP TO SBCQ
 2232 A:0be2  e9 45                              sbc #127-":"       ;REM ONLY STOPS ON NULL.
 2233 A:0be4  d0 a8                              bne KLOOP                ;NO, CONTINUE CRUNCHING.
 2234 A:0be6  85 0e                              sta ENDCHR                ;REM STOPS ONLY ON NULL, NOT : OR ".
 2235 A:0be8                           STR1      
 2235 A:0be8  bd 00 02                           lda 512,X
 2236 A:0beb  f0 df                              beq STUFFH                ;YES, END OF LINE, SO DONE.
 2237 A:0bed  c5 0e                              cmp ENDCHR                ;END OF GOBBLE?
 2238 A:0bef  f0 db                              beq STUFFH                ;YES, DONE WITH STRING.
 2239 A:0bf1                           STRNG     
 2239 A:0bf1  c8                                 iny                    ;INCREMENT BUFFER POINTER.
 2240 A:0bf2  99 fb 01                           sta 512-5,Y
 2241 A:0bf5  e8                                 inx 
 2242 A:0bf6  d0 f0                              bne STR1                ;PROCESS NEXT CHARACTER.
 2243 A:0bf8                           NTHIS     
 2243 A:0bf8  a6 b9                              ldx CHRGOT+1          ;RESTORE TEXT POINTER.
 2244 A:0bfa  e6 0f                              inc COUNT                ;INCREMENT RES WORD COUNT.
 2245 A:0bfc                           NTHIS1    
 2245 A:0bfc  c8                                 iny 
 2246 A:0bfd  b9 7f 08                           lda RESLST-1,Y,       ;GET RES CHARACTER.
 2247 A:0c00  10 fa                              bpl NTHIS1                ;END OF ENTRY?
 2248 A:0c02  b9 80 08                           lda RESLST,Y,             ;YES. IS IT THE END?
 2249 A:0c05  d0 b4                              bne RESCON                ;NO, TRY THE NEXT WORD.
 2250 A:0c07  bd 00 02                           lda 512,X            ;YES, END OF TABLE. GET 1ST CHR.
 2251 A:0c0a  10 be                              bpl GETBPT                ;STORE IT AWAY (ALWAYS BRANCHES).
 2252 A:0c0c                           CRDONE    
 2252 A:0c0c  99 fd 01                           sta 512-3,Y,     ;SO THAT IF THIS IS A DIR STATEMENT
 2253 A:0c0f                                    ;ITS END WILL LOOK LIKE END OF PROGRAM.

 2256 A:0c0f  c6 ba                              dec CHRGOT+1+1

 2259 A:0c13  85 b9                              sta CHRGOT+1          ;CRUNCHED LINE.
 2260 A:0c15                           LISTRT    
 2260 A:0c15  60                                 rts                    ;RETURN TO CALLER.
 2261 A:0c16                                    ;
 2262 A:0c16                                    ; FNDLIN SEARCHES THE PROGRAM TEXT FOR THE LINE
 2263 A:0c16                                    ; WHOSE NUMBER IS PASSED IN "LINNUM".
 2264 A:0c16                                    ; THERE ARE TWO POSSIBLE RETURNS:
 2265 A:0c16                                    ;
 2266 A:0c16                                    ; 1) CARRY SET.
 2267 A:0c16                                    ;    LOWTR POINTS TO THE LINK FIELD IN THE LINE
 2268 A:0c16                                    ;    WHICH IS THE ONE SEARCHED FOR.
 2269 A:0c16                                    ;
 2270 A:0c16                                    ; 2) CARRY NOT SET.
 2271 A:0c16                                    ;    LINE NOT FOUND. [LOWTR] POINTS TO THE LINE IN THE
 2272 A:0c16                                    ;    PROGRAM GREATER THAN THE ONE SOUGHT AFTER.
 2273 A:0c16                                    ;
 2274 A:0c16                           FNDLIN    
 2274 A:0c16                                    ;LOAD [X,A] WITH [TXTTAB]
 2275 A:0c16  a5 6a                              lda TXTTAB
 2276 A:0c18  a6 6b                              ldx TXTTAB+1
 2277 A:0c1a                           FNDLNC    
 2277 A:0c1a  a0 01                              ldy #1
 2278 A:0c1c                                    ;STORE [X,A] INTO LOWTR
 2279 A:0c1c  85 9e                              sta LOWTR
 2280 A:0c1e  86 9f                              stx LOWTR+1
 2281 A:0c20  b1 9e                              lda (LOWTR),Y            ;SEE IF LINK IS 0
 2282 A:0c22  f0 21                              beq FLINRT
 2283 A:0c24  c8                                 iny 
 2284 A:0c25  c8                                 iny 
 2285 A:0c26  a5 54                              lda LINNUM+1          ;COMP HIGH ORDERS OF LINE NUMBERS.
 2286 A:0c28  d1 9e                              cmp (LOWTR),Y
 2287 A:0c2a  90 1a                              bcc FLNRTS                ;NO SUCH LINE NUMBER.
 2288 A:0c2c  f0 05                              beq FNDLO1
 2289 A:0c2e  88                                 dey 
 2290 A:0c2f  d0 0b                              bne AFFRTS                ;ALWAYS BRANCH.
 2291 A:0c31                           FNDLO1    
 2291 A:0c31  a5 53                              lda LINNUM
 2292 A:0c33  88                                 dey 
 2293 A:0c34  d1 9e                              cmp (LOWTR),Y            ;COMPARE LOW ORDERS.
 2294 A:0c36  90 0e                              bcc FLNRTS                ;NO SUCH NUMBER.
 2295 A:0c38  f0 0c                              beq FLNRTS                ;GO TIT.
 2296 A:0c3a                           AFFRTS    
 2296 A:0c3a  88                                 dey 
 2297 A:0c3b  b1 9e                              lda (LOWTR),Y            ;FETCH LINK.
 2298 A:0c3d  aa                                 tax 
 2299 A:0c3e  88                                 dey 
 2300 A:0c3f  b1 9e                              lda (LOWTR),Y
 2301 A:0c41  b0 d7                              bcs FNDLNC                ;ALWAYS BRANCHES.
 2302 A:0c43                           FLINRT    
