 5674 A:e518  4c b4 e2                           jmp PUTNEW
 5675 A:e51b                           RIGHT     
 5675 A:e51b  20 50 e5                           jsr PREAM
 5676 A:e51e  18                                 clc                    ;[LENGTH DES'D]-[LENGTH]-1.
 5677 A:e51f  f1 8f                              sbc (DSCPNT),Y
 5678 A:e521  49 ff                              eor #255             ;NEGATE.
 5679 A:e523  4c f5 e4                           jmp RLEFT
 5680 A:e526                                    ;
 5681 A:e526                                    ; MID ($,#) RETURNS STRING WITH CHARS FROM # POSITION
 5682 A:e526                                    ; ONWARD. IF # .GT. LEN ($) THEN RETURN NULL STRING.
 5683 A:e526                                    ; MID ($,#,#) RETURNS STRING WITH CHARACTERS FROM
 5684 A:e526                                    ; # POSITION FOR #2 CHARACTERS. IF #2 GOES PAST END OF STRING
 5685 A:e526                                    ; RETURN AS MUCH AS POSSIBLE.
 5686 A:e526                                    ;
 5687 A:e526                           MID       
 5687 A:e526  a9 ff                              lda #255             ;DEFAULT.
 5688 A:e528  85 a4                              sta FACLO                ;SAVE FOR LATER COMPARE.
 5689 A:e52a  20 b8 00                           jsr CHRGOT                ;GET CURRENT CHARACTER.
 5690 A:e52d  c9 29                              cmp #41             ;IS IT A RIGHT PAREN )?
 5691 A:e52f  f0 0a                              beq MID2                ;NO THIRD PARAM.
 5692 A:e531  20 68 dd                           jsr CHKCOM                ;MUST HAVE COMMA.
 5693 A:e534  20 8d e5                           jsr GETBYT                ;GET THE LENGTH INTO "FACLO".
 5694 A:e537                           MID2      
 5694 A:e537  20 50 e5                           jsr PREAM                ;CHECK IT OUT.
 5695 A:e53a  f0 4f                              beq GOFUC                ;THERE IS NO POSTION 0
 5696 A:e53c  ca                                 dex                    ;COMPUTE OFFSET.
 5697 A:e53d  8a                                 txa 
 5698 A:e53e  48                                 pha                    ;PRSERVE AWHILE.
 5699 A:e53f  18                                 clc 
 5700 A:e540  a2 00                              ldx #0
 5701 A:e542  f1 8f                              sbc (DSCPNT),Y            ;GET LENGTH OF WHAT'S LEFT.
 5702 A:e544  b0 b6                              bcs RLEFT2                ;GIVE NULL STRING.
 5703 A:e546  49 ff                              eor #255             ;IN SUB C WAS 0 SO JUST COMPLEMENT.
 5704 A:e548  c5 a4                              cmp FACLO                ;GREATER THAN WHAT'S DESIRED?
 5705 A:e54a  90 b1                              bcc RLEFT3                ;NO, COPY THAT MUCH.
 5706 A:e54c  a5 a4                              lda FACLO                ;GET LENGTH OF WHAT'S DESIRED.
 5707 A:e54e  b0 ad                              bcs RLEFT3                ;COPY IT.

