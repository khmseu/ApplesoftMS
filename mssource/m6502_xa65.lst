 7302 A:2459                                    ; PAGE
 7303 A:2459                                    ; SUBTTL EXPONENTIATION AND SQUARE ROOT FUNCTION.
 7304 A:2459                                    ;SQUARE ROOT FUNCTION --- SQR(A)
 7305 A:2459                                    ;USE SQR(X)=X^.5
 7306 A:2459                           SQR       
 7306 A:2459  20 33 21                           jsr MOVAF                ;MOVE FAC INTO ARG.

 7308 A:245c  a9 30                              lda #FHALF&255
 7309 A:245e  a0 24                              ldy #FHALF/256
 7310 A:2460  20 c6 20                           jsr MOVFM                ;PUT MEMORY INTO FAC.
 7311 A:2463                                    ;LAST THING FETCHED IS FACEXP. INTO ACCX.
 7312 A:2463                                    ; JMP FPWRT  ;FALL INTO FPWRT.

 7314 A:2463                                    ;EXPONENTIATION ---  X^Y.
 7315 A:2463                                    ;N.B.  0^0=1
 7316 A:2463                                    ;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
 7317 A:2463                                    ;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
 7318 A:2463                                    ;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
 7319 A:2463                                    ;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
 7320 A:2463                                    ;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
 7321 A:2463                                    ;RETURNED BY EXP.
 7322 A:2463                                    ;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
 7323 A:2463                           FPWRT     
 7323 A:2463  f0 74                              beq EXP                ;IF FAC=0, JUST EXPONENTIATE THAT.
 7324 A:2465  a5 a8                              lda ARGEXP                ;IS X=0?
 7325 A:2467  d0 07                              bne FPWRT1
 7326 A:2469  4c 1a 1e                           jmp ZEROF1                ;ZERO FAC.
 7327 A:246c                           FPWRT1    
 7327 A:246c                                    ;SAVE FOR LATER IN A TEMP.
 7328 A:246c  a2 8d                              ldx #DEFPNT&255
 7329 A:246e  a0 00                              ldy #DEFPNT/256
 7330 A:2470  20 fb 20                           jsr MOVMF
 7331 A:2473                                    ;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
 7332 A:2473  a5 ad                              lda ARGSGN
 7333 A:2475  10 13                              bpl FPWR1                ;NO PROBLEMS IF X.GT.0.
 7334 A:2477  20 f3 21                           jsr INT                ;INTEGERIZE THE FAC.
 7335 A:247a                                    ;GET ADDR OF COMPERAND.
 7336 A:247a  a9 8d                              lda #DEFPNT&255
 7337 A:247c  a0 00                              ldy #DEFPNT/256
 7338 A:247e  20 82 21                           jsr FCOMP                ;EQUAL?
 7339 A:2481  d0 07                              bne FPWR1                ;LEAVE X NEG. LOG WILL BLOW HIM OUT.
 7340 A:2483                                    ;A=-1 AND Y IS IRRELEVANT.
 7341 A:2483  98                                 tya                    ;NEGATE X. MAKE POSITIVE.
 7342 A:2484  a4 0d                              ldy CHARAC                ;GET EVENNESS.
 7343 A:2486                           FPWR1     
 7343 A:2486  20 25 21                           jsr MOVFA1                ;ALTERNATE ENTRY POINT.
 7344 A:2489  98                                 tya 
 7345 A:248a  48                                 pha                    ;SAVE EVENNESS FOR LATER.
 7346 A:248b  20 0b 1f                           jsr LOG                ;FIND LOG.
 7347 A:248e                                    ;MULTIPLY FAC TIMES LOG(X).
 7348 A:248e  a9 8d                              lda #DEFPNT&255
 7349 A:2490  a0 00                              ldy #DEFPNT/256
 7350 A:2492  20 49 1f                           jsr FMULT
 7351 A:2495  20 d5 24                           jsr EXP                ;EXPONENTIATE THE FAC.
 7352 A:2498  68                                 pla 
 7353 A:2499  4a                                 lsr                    ;IS IT EVEN?
 7354 A:249a  90 0e                              bcc NEGRTS                ;YES. OR X.GT.0.
 7355 A:249c                                    ;NEGATE THE NUMBER IN FAC.
 7356 A:249c                           NEGOP     
 7356 A:249c  a5 a0                              lda FACEXP
 7357 A:249e  f0 0a                              beq NEGRTS

 7359 A:24a0  a5 a5                              lda FACSGN
 7360 A:24a2  49 ff                              eor #255
 7361 A:24a4  85 a5                              sta FACSGN
 7362 A:24a6                           NEGRTS    
 7362 A:24a6  60                                 rts 

 7364 A:24a7                                    ; PAGE
 7365 A:24a7                                    ; SUBTTL EXPONENTIATION FUNCTION.
 7366 A:24a7                                    ;FIRST SAVE THE ORIGINAL ARGUMENT AND MULTIPLY THE FAC BY
 7367 A:24a7                                    ;LOG2(E). THE RESULT IS USED TO DETERMINE IF OVERFLOW
 7368 A:24a7                                    ;WILL OCCUR SINCE EXP(X)=2^(X*LOG2(E)) WHERE
 7369 A:24a7                                    ;LOG2(E)=LOG(E) BASE 2. THEN SAVE THE INTEGER PART OF
 7370 A:24a7                                    ;THIS TO SCALE THE ANSWER AT THE END. SINCE
 7371 A:24a7                                    ;2^Y=2^INT(Y)*2^(Y-INT(Y)) AND 2^INT(Y) IS EASY TO COMPUTE.
 7372 A:24a7                                    ;NOW COMPUTE 2^(X*LOG2(E)-INT(X*LOG2(E)) BY
 7373 A:24a7                                    ;P(LN(2)*(INT(X*LOG2(E))+1)-X) WHERE P IS AN APPROXIMATION
 7374 A:24a7                                    ;POLYNOMIAL. THE RESULT IS THEN SCALED BY THE POWER OF 2
 7375 A:24a7                                    ;PREVIOUSLY SAVED.

 7377 A:24a7                           LOGEB2    
 7377 A:24a7  81                                 .byt 129              ;LOG(E) BASE 2.
 7378 A:24a8  38                                 .byt 56
 7379 A:24a9  aa                                 .byt 170
 7380 A:24aa  3b                                 .byt 59

 7382 A:24ab  29                                 .byt 41

 7421 A:24ac                           EXPCON    
 7421 A:24ac  07                                 .byt 7
 7422 A:24ad  71                                 .byt 113
 7423 A:24ae  34                                 .byt 52
 7424 A:24af  58                                 .byt 88
 7425 A:24b0  3e                                 .byt 62
 7426 A:24b1  56                                 .byt 86
 7427 A:24b2  74                                 .byt 116
 7428 A:24b3  16                                 .byt 22
 7429 A:24b4  7e                                 .byt 126
 7430 A:24b5  b3                                 .byt 179
 7431 A:24b6  1b                                 .byt 27
 7432 A:24b7  77                                 .byt 119
 7433 A:24b8  2f                                 .byt 47
 7434 A:24b9  ee                                 .byt 238
 7435 A:24ba  e3                                 .byt 227
 7436 A:24bb  85                                 .byt 133
 7437 A:24bc  7a                                 .byt 122
 7438 A:24bd  1d                                 .byt 29
 7439 A:24be  84                                 .byt 132
 7440 A:24bf  1c                                 .byt 28
 7441 A:24c0  2a                                 .byt 42
 7442 A:24c1  7c                                 .byt 124
 7443 A:24c2  63                                 .byt 99
 7444 A:24c3  59                                 .byt 89
 7445 A:24c4  58                                 .byt 88
 7446 A:24c5  0a                                 .byt 10
 7447 A:24c6  7e                                 .byt 126
 7448 A:24c7  75                                 .byt 117
