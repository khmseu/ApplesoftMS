 2161 A:d457                                    ;
 2162 A:d457                                    ; ALL "RESERVED" WORDS ARE TRANSLATED INTO SINGLE
 2163 A:d457                                    ; BYTES WITH THE MSB ON. THIS SAVES SPACE AND TIME 
 2164 A:d457                                    ; BY ALLOWING FOR TABLE DISPATCH DURING EXECUTION.
 2165 A:d457                                    ; THEREFORE ALL STATEMENTS APPEAR TOGETHER IN THE
 2166 A:d457                                    ; RESERVED WORD LIST IN THE SAME ORDER THEY
 2167 A:d457                                    ; APPEAR IN STMDSP.
 2168 A:d457                                    ;
 2169 A:d457                                    ;THE AMOUNT TO OFFSET THE LOW BYTE

 2171 A:d457                                    ;OF THE TEXT POINTER TO GET TO BUF
 2172 A:d457                                    ;AFTER TXTPTR HAS BEEN SETUP TO POINT INTO BUF

 2177 A:d457                           CRUNCH    
 2177 A:d457  a6 b9                              ldx CHRGOT+1          ;SET SOURCE POINTER.
 2178 A:d459  a0 04                              ldy #4             ;SET DESTINATION OFFSET.
 2179 A:d45b  84 13                              sty DORES                ;ALLOW CRUNCHING.
 2180 A:d45d                           KLOOP     
 2180 A:d45d  bd 00 02                           lda 512,X

 2189 A:d460                           CMPSPC    
 2189 A:d460  c9 20                              cmp #" "             ;IS IT A SPACE TO SAVE?
 2190 A:d462  f0 37                              beq STUFFH                ;YES, GO SAVE IT.
 2191 A:d464  85 0e                              sta ENDCHR                ;IF IT'S A QUOTE, THIS WILL
 2192 A:d466                                    ;STOP LOOP WHEN OTHER QUOTE APPEARS.
 2193 A:d466  c9 22                              cmp #34             ;QUOTE SIGN?
 2194 A:d468  f0 56                              beq STRNG                ;YES, DO SPECIAL STRING HANDLING.
 2195 A:d46a  24 13                              bit DORES                ;TEST FLAG.
 2196 A:d46c  70 2d                              bvs STUFFH                ;NO CRUNCH, JUST STORE.
 2197 A:d46e  c9 3f                              cmp #"?"             ;A QMARK?
 2198 A:d470  d0 04                              bne KLOOP1
 2199 A:d472  a9 7f                              lda #127             ;YES, STUFF A "PRINT" TOKEN.
 2200 A:d474  d0 25                              bne STUFFH                ;ALWAYS GO TO STUFFH.
 2201 A:d476                           KLOOP1    
 2201 A:d476  c9 30                              cmp #"0"             ;SKIP NUMERICS.
 2202 A:d478  90 04                              bcc MUSTCR
 2203 A:d47a  c9 3c                              cmp #60             ;":" AND ";" ARE ENTERED STRAIGHTAWAY.
 2204 A:d47c  90 1d                              bcc STUFFH
 2205 A:d47e                           MUSTCR    
