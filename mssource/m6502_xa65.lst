 2160 A:0b88                                    ;
 2161 A:0b88                                    ; ALL "RESERVED" WORDS ARE TRANSLATED INTO SINGLE
 2162 A:0b88                                    ; BYTES WITH THE MSB ON. THIS SAVES SPACE AND TIME 
 2163 A:0b88                                    ; BY ALLOWING FOR TABLE DISPATCH DURING EXECUTION.
 2164 A:0b88                                    ; THEREFORE ALL STATEMENTS APPEAR TOGETHER IN THE
 2165 A:0b88                                    ; RESERVED WORD LIST IN THE SAME ORDER THEY
 2166 A:0b88                                    ; APPEAR IN STMDSP.
 2167 A:0b88                                    ;
 2168 A:0b88                                    ;THE AMOUNT TO OFFSET THE LOW BYTE

 2170 A:0b88                                    ;OF THE TEXT POINTER TO GET TO BUF
 2171 A:0b88                                    ;AFTER TXTPTR HAS BEEN SETUP TO POINT INTO BUF

 2176 A:0b88                           CRUNCH    
 2176 A:0b88  a6 b9                              ldx CHRGOT+1          ;SET SOURCE POINTER.
 2177 A:0b8a  a0 04                              ldy #4             ;SET DESTINATION OFFSET.
 2178 A:0b8c  84 13                              sty DORES                ;ALLOW CRUNCHING.
 2179 A:0b8e                           KLOOP     
 2179 A:0b8e  bd 00 02                           lda 512,X

 2188 A:0b91                           CMPSPC    
 2188 A:0b91  c9 20                              cmp #" "             ;IS IT A SPACE TO SAVE?
 2189 A:0b93  f0 37                              beq STUFFH                ;YES, GO SAVE IT.
 2190 A:0b95  85 0e                              sta ENDCHR                ;IF IT'S A QUOTE, THIS WILL
 2191 A:0b97                                    ;STOP LOOP WHEN OTHER QUOTE APPEARS.
 2192 A:0b97  c9 22                              cmp #34             ;QUOTE SIGN?
 2193 A:0b99  f0 56                              beq STRNG                ;YES, DO SPECIAL STRING HANDLING.
 2194 A:0b9b  24 13                              bit DORES                ;TEST FLAG.
 2195 A:0b9d  70 2d                              bvs STUFFH                ;NO CRUNCH, JUST STORE.
 2196 A:0b9f  c9 3f                              cmp #"?"             ;A QMARK?
 2197 A:0ba1  d0 04                              bne KLOOP1
 2198 A:0ba3  a9 7f                              lda #127             ;YES, STUFF A "PRINT" TOKEN.
 2199 A:0ba5  d0 25                              bne STUFFH                ;ALWAYS GO TO STUFFH.
 2200 A:0ba7                           KLOOP1    
 2200 A:0ba7  c9 30                              cmp #"0"             ;SKIP NUMERICS.
 2201 A:0ba9  90 04                              bcc MUSTCR
 2202 A:0bab  c9 3c                              cmp #60             ;":" AND ";" ARE ENTERED STRAIGHTAWAY.
 2203 A:0bad  90 1d                              bcc STUFFH
 2204 A:0baf                           MUSTCR    
 2204 A:0baf  84 b0                              sty FBUFPT                ;SAVE BUFFER POINTER.
 2205 A:0bb1  a0 00                              ldy #0             ;LOAD RESLST POINTER.
 2206 A:0bb3  84 0f                              sty COUNT                ;ALSO CLEAR COUNT.
 2207 A:0bb5  88                                 dey 
 2208 A:0bb6  86 b9                              stx CHRGOT+1          ;SAVE TEXT POINTER FOR LATER USE.
 2209 A:0bb8  ca                                 dex 
