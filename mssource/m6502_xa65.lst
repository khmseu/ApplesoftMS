 3841 A:12c7  00                                 .byt 0
 3842 A:12c8                                    ; PAGE
 3843 A:12c8                                    ; SUBTTL THE NEXT CODE IS THE "NEXT CODE"
 3844 A:12c8                                    ;
 3845 A:12c8                                    ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 3846 A:12c8                                    ;
 3847 A:12c8                                    ; LOW ADDRESS
 3848 A:12c8                                    ; TOKEN (FORTK) 1 BYTE
 3849 A:12c8                                    ; A POINTER TO THE LOOP VARIABLE 2 BYTES
 3850 A:12c8                                    ; THE STEP 4+ADDPRC BYTES
 3851 A:12c8                                    ; A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 3852 A:12c8                                    ; THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
 3853 A:12c8                                    ; THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 3854 A:12c8                                    ; A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 3855 A:12c8                                    ; HIGH ADDRESS
 3856 A:12c8                                    ;
 3857 A:12c8                                    ; TOTAL 16+2*ADDPRC BYTES.
 3858 A:12c8                                    ;
 3859 A:12c8                           NEXT      
 3859 A:12c8  d0 06                              bne GETFOR
 3860 A:12ca  a0 00                              ldy #0             ;WITHOUT ARG CALL "FNDFOR" WITH
 3861 A:12cc  f0 05                              beq STXFOR                ;[FORPNT]=0.
 3862 A:12ce                           GETFOR    
 3862 A:12ce  20 bb 15                           jsr PTRGET                ;GET A POINTER TO LOOP VARIABLE
 3863 A:12d1                           STXFOR    
 3863 A:12d1                                    ;INTO "FORPNT".
 3864 A:12d1  85 88                              sta FORPNT
 3865 A:12d3  84 89                              sty FORPNT+1
 3866 A:12d5  20 96 09                           jsr FNDFOR                ;FIND THE MATCHING ENTRY IF ANY.
 3867 A:12d8  f0 06                              beq HAVFOR
 3868 A:12da  a2 00                              ldx #0             ;"NEXT WITHOUT FOR".
 3869 A:12dc                           ERRGO5    
 3869 A:12dc  f0 6b                              beq ERRGO4
 3870 A:12de                           HAVFOR    
 3870 A:12de  9a                                 txs                    ;SETUP STACK. CHOP FIRST.
 3871 A:12df  8a                                 txa 
 3872 A:12e0  18                                 clc 
 3873 A:12e1  69 04                              adc #4             ;POINT TO INCREMENT
 3874 A:12e3  48                                 pha                    ;SAVE THIS POINTER TO RESTORE TO [A]
 3875 A:12e4  69 06                              adc #5+1       ;POINT TO UPPER LIMIT
 3876 A:12e6  85 63                              sta INDEX2                ;SAVE AS INDEX
 3877 A:12e8  68                                 pla                    ;RESTORE POINTER TO INCREMENT
 3878 A:12e9  a0 01                              ldy #1             ;SET HI ADDR OF THING TO MOVE.
 3879 A:12eb  20 c6 20                           jsr MOVFM                ;GET QUANTITY INTO THE FAC.
 3880 A:12ee  ba                                 tsx 
 3881 A:12ef  bd 09 01                           lda 257+7+1,X, ;SET SIGN CORRECTLY.
 3882 A:12f2  85 a5                              sta FACSGN

 3884 A:12f4  a5 88                              lda FORPNT
 3885 A:12f6  a4 89                              ldy FORPNT+1
 3886 A:12f8  20 88 1d                           jsr FADD                ;ADD INC TO LOOP VARIABLE.
 3887 A:12fb  20 f7 20                           jsr MOVVF                ;PACK THE FAC INTO MEMORY.
 3888 A:12fe  a0 01                              ldy #1
 3889 A:1300  20 84 21                           jsr FCOMPN                ;COMPARE FAC WITH UPPER VALUE.
 3890 A:1303  ba                                 tsx 
 3891 A:1304  38                                 sec 
 3892 A:1305  fd 09 01                           sbc 257+7+1,X, ;SUBTRACT SIGN OF INC FROM SIGN OF
 3893 A:1308                                    ;OF (CURRENT VALUE-FINAL VALUE).
 3894 A:1308  f0 19                              beq LOOPDN                ;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
 3895 A:130a                                    ;THEN LOOP IS DONE.
 3896 A:130a  bd 0f 01                           lda 2*1+12+257,X
 3897 A:130d  85 78                              sta CURLIN                ;STORE LINE NUMBER OF "FOR" STATEMENT.
 3898 A:130f  bd 10 01                           lda 257+13+2*1,X
 3899 A:1312  85 79                              sta CURLIN+1
 3900 A:1314  bd 12 01                           lda 2*1+15+257,X
 3901 A:1317  85 b9                              sta CHRGOT+1          ;STORE TEXT PNTR INTO "FOR" STATEMENT.
 3902 A:1319  bd 11 01                           lda 2*1+14+257,X
 3903 A:131c  85 ba                              sta CHRGOT+1+1
 3904 A:131e                           NEWSGO    
 3904 A:131e  4c 97 0d                           jmp NEWSTT                ;PROCESS NEXT STATEMENT.
 3905 A:1321                           LOOPDN    
 3905 A:1321  8a                                 txa 
 3906 A:1322  69 11                              adc #(2*1)+15;ADDS 16 WITH CARRY.
 3907 A:1324  aa                                 tax 
 3908 A:1325  9a                                 txs                    ;NEW STACK PNTR.
 3909 A:1326  20 b8 00                           jsr CHRGOT
 3910 A:1329  c9 2c                              cmp #44             ;COMMA AT END?
 3911 A:132b  d0 f1                              bne NEWSGO
 3912 A:132d  20 b2 00                           jsr CHRGET
 3913 A:1330  20 ce 12                           jsr GETFOR                ;DO NEXT BUT DON'T ALLOW BLANK VARIABLE
 3914 A:1333                                    ;PNTR. [VARPNT] IS THE STK PNTR WHICH
 3915 A:1333                                    ;NEVER MATCHES ANY POINTER.
 3916 A:1333                                    ;JSR TO PUT ON DUMMY NEWSTT ADDR.

 3918 A:1333                                    ; SUBTTL FORMULA EVALUATION CODE.
 3919 A:1333                                    ;
 3920 A:1333                                    ; THESE ROUTINES CHECK FOR CERTAIN "VALTYP".
 3921 A:1333                                    ; [C] IS NOT PRESERVED.
 3922 A:1333                                    ;
 3923 A:1333                           FRMNUM    
 3923 A:1333  20 4a 13                           jsr FRMEVL
 3924 A:1336                           CHKNUM    
 3924 A:1336  18                                 clc 
 3925 A:1337  00 02 24 00                        .word 512,36
 3926 A:133b                           CHKSTR    
 3926 A:133b  38                                 sec                    ;SET CARRY.
 3927 A:133c                           CHKVAL    
 3927 A:133c  24 11                              bit VALTYP                ;WILL NOT F UP "VALTYP".
 3928 A:133e  30 05                              bmi DOCSTR
 3929 A:1340  b0 05                              bcs CHKERR
 3930 A:1342                           CHKOK     
 3930 A:1342  60                                 rts 
 3931 A:1343                           DOCSTR    
 3931 A:1343  b0 fd                              bcs CHKOK
 3932 A:1345                           CHKERR    
 3932 A:1345  a2 18                              ldx #24
 3933 A:1347                           ERRGO4    
 3933 A:1347  4c 43 0a                           jmp ERROR
 3934 A:134a                                    ;
 3935 A:134a                                    ; THE FORMULA EVALUATOR STARTS WITH
 3936 A:134a                                    ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
 3937 A:134a                                    ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
 3938 A:134a                                    ; THE RESULT IS LEFT IN THE FAC.
 3939 A:134a                                    ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
 3940 A:134a                                    ;
 3941 A:134a                                    ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
 3942 A:134a                                    ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR 
 3943 A:134a                                    ; EACH OPERATOR.
 3944 A:134a                                    ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
 3945 A:134a                                    ; THE ADDRESS OF THE OPERATOR ROUTINE.
 3946 A:134a                                    ; THE FLOATING POINT TEMPORARY RESULT.
 3947 A:134a                                    ; THE PRECEDENCE OF THE OPERATOR.
 3948 A:134a                                    ;
 3949 A:134a                           FRMEVL    
 3949 A:134a  a6 b9                              ldx CHRGOT+1
 3950 A:134c  d0 04                              bne FRMEV1
 3951 A:134e  c6 ba                              dec CHRGOT+1+1
 3952 A:1350                           FRMEV1    
 3952 A:1350  c6 b9                              dec CHRGOT+1
 3953 A:1352  a2 00                              ldx #0             ;INITIAL DUMMY PRECEDENCE IS 0.
 3954 A:1354  00 02 24 00                        .word 512,36
 3955 A:1358                           LPOPER    
 3955 A:1358  48                                 pha                    ;SAVE LOW PRECEDENCE. (MASK.)
 3956 A:1359  8a                                 txa 
 3957 A:135a  48                                 pha                    ;SAVE HIGH PRECEDENCE.
 3958 A:135b  a9 01                              lda #1
 3959 A:135d  20 07 0a                           jsr GETSTK                ;MAKE SURE THERE IS ROOM FOR
 3960 A:1360                                    ;RECURSIVE CALLS.
 3961 A:1360  20 32 14                           jsr EVAL                ;EVALUATE SOMETHING.
 3962 A:1363                                    ;PREPARE TO BUILD MASK MAYBE.
 3963 A:1363  a9 00                              lda #0
 3964 A:1365  85 8c                              sta OPMASK
 3965 A:1367                           TSTOP     
 3965 A:1367  20 b8 00                           jsr CHRGOT                ;REGET LAST CHARACTER.
 3966 A:136a                           LOPREL    
 3966 A:136a  38                                 sec                    ;PREP TO SUBTRACT.
 3967 A:136b  e9 82                              sbc #130             ;IS CURRENT CHARACTER A RELATION?
 3968 A:136d  90 19                              bcc ENDREL                ;NO. RELATIONS ALL THROUGH.
 3969 A:136f  c9 02                              cmp #131-130+1 ;REALLY RELATIONAL?
 3970 A:1371  b0 15                              bcs ENDREL                ;NO -- JUST BIG.
 3971 A:1373  c9 01                              cmp #1             ;RESET CARRY FOR ZERO ONLY.
 3972 A:1375  2a                                 rol                    ;0 TO 1, 1 TO 2, 2 TO 4.
 3973 A:1376  49 01                              eor #1
 3974 A:1378  45 8c                              eor OPMASK                ;BRING IN THE OLD BITS.
 3975 A:137a  c5 8c                              cmp OPMASK                ;MAKE SURE THE NEW MASK IS BIGGER.
 3976 A:137c  90 63                              bcc SNERR5                ;SYNTAX ERROR. BECAUSE TWO OF THE SAME.
 3977 A:137e  85 8c                              sta OPMASK                ;SAVE MASK.
 3978 A:1380  20 b2 00                           jsr CHRGET
 3979 A:1383  4c 6a 13                           jmp LOPREL                ;GET THE NEXT CANDIDATE.
 3980 A:1386                           ENDREL    
 3980 A:1386  a6 8c                              ldx OPMASK                ;WERE THERE ANY?
 3981 A:1388  d0 2e                              bne FINREL                ;YES, HANDLE AS SPECIAL OP.
 3982 A:138a  b0 7d                              bcs QOP                ;NOT AN OPERATOR.
 3983 A:138c  69 01                              adc #130-129
 3984 A:138e  90 79                              bcc QOP                ;NOT AN OPERATOR.
 3985 A:1390  65 11                              adc VALTYP                ;[C]=1.
 3986 A:1392                                    ;ONLY IF [A]=0 AND [VALTYP]=-1 (A STR).
 3987 A:1392  d0 03                              bne *+5
 3988 A:1394  4c 5d 1b                           jmp CAT
 3989 A:1397  69 ff                              adc #255             ;GET BACK ORIGINAL [A].
 3990 A:1399  85 61                              sta INDEX1
 3991 A:139b  0a                                 asl                    ;MULTIPLY BY 2.
 3992 A:139c  65 61                              adc INDEX1                ;BY THREE.
 3993 A:139e  a8                                 tay                    ;SET UP FOR LATER.
 3994 A:139f                           QPREC     
 3994 A:139f  68                                 pla                    ;GET PREVIOUS PRECEDENCE.
 3995 A:13a0  d9 62 08                           cmp OPTAB,Y              ;IS OLD PRECEDENCE GREATER OR EQUAL?
 3996 A:13a3  b0 69                              bcs QCHNUM                ;YES, GO OPERATE.
 3997 A:13a5  20 36 13                           jsr CHKNUM                ;CAN'T BE STRING HERE.
 3998 A:13a8                           DOPREC    
 3998 A:13a8  48                                 pha                    ;SAVE OLD PRECEDENCE.
