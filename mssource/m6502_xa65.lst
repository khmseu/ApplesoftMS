 5655 A:e4fa  98                                 tya                    ;ZERO A, THE OFFSET.
 5656 A:e4fb                           RLEFT1    
 5656 A:e4fb  48                                 pha                    ;SAVE OFFSET.
 5657 A:e4fc                           RLEFT2    
 5657 A:e4fc  8a                                 txa 
 5658 A:e4fd                           RLEFT3    
