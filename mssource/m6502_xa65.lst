 4748 A:175b                           BSERR     
 4748 A:175b  a2 10                              ldx #16             ;GET BAD SUB ERROR NUMBER.
 4749 A:175d  00 02 2c 00                        .word 512,44
 4750 A:1761                           FCERR     
 4750 A:1761  a2 08                              ldx #8             ;TOO BIG. "FUNCTION CALL" ERROR.
