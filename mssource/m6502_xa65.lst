 5703 A:e550  b0 b6                              bcs RLEFT2                ;GIVE NULL STRING.
 5704 A:e552  49 ff                              eor #255             ;IN SUB C WAS 0 SO JUST COMPLEMENT.
 5705 A:e554  c5 a4                              cmp FACLO                ;GREATER THAN WHAT'S DESIRED?
 5706 A:e556  90 b1                              bcc RLEFT3                ;NO, COPY THAT MUCH.
 5707 A:e558  a5 a4                              lda FACLO                ;GET LENGTH OF WHAT'S DESIRED.
 5708 A:e55a  b0 ad                              bcs RLEFT3                ;COPY IT.

