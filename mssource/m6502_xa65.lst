 6811 A:ea9d                                    ; SUBTTL GREATEST INTEGER FUNCTION.
 6812 A:ea9d                                    ;QUICK GREATEST INTEGER FUNCTION.
 6813 A:ea9d                                    ;LEAVES INT(FAC) IN FACHO&MO&LO SIGNED.
