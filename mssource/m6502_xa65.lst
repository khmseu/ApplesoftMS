 2906 A:d796                                    ; PAGE
 2907 A:d796                                    ; SUBTTL RUN,GOTO,GOSUB,RETURN.
 2908 A:d796                           RUN       
 2908 A:d796                                    ;IF NO LINE # ARGUMENT.
