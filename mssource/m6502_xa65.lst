 5592 A:e4ac  08                                 php                    ;SAVE CODES.
 5593 A:e4ad  a0 00                              ldy #0             ;PREP TO GET STUFF.
 5594 A:e4af  b1 61                              lda (INDEX1),Y            ;GET COUNT AND
 5595 A:e4b1  48                                 pha                    ;SAVE IT.
 5596 A:e4b2  c8                                 iny 
 5597 A:e4b3  b1 61                              lda (INDEX1),Y
 5598 A:e4b5  aa                                 tax                    ;SAVE LOW ORDER.
 5599 A:e4b6  c8                                 iny 
 5600 A:e4b7  b1 61                              lda (INDEX1),Y
 5601 A:e4b9  a8                                 tay                    ;SAVE HIGH ORDER.
 5602 A:e4ba  68                                 pla 
 5603 A:e4bb  28                                 plp                    ;RETURN STATUS.
 5604 A:e4bc  d0 17                              bne FRETRT
 5605 A:e4be  c4 73                              cpy FRETOP+1          ;STRING IS LAST ONE IN?
 5606 A:e4c0  d0 13                              bne FRETRT
 5607 A:e4c2  e4 72                              cpx FRETOP
 5608 A:e4c4  d0 0f                              bne FRETRT
