 6110                     				;LAST THING FETCHED IS FACEXP. INTO ACCX.
 6111                     ;	JMP	FPWRT		;FALL INTO FPWRT.
 6113                     	;EXPONENTIATION ---  X^Y.
 6114                     	;N.B.  0^0=1
 6115                     	;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
 6116                     	;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
 6117                     	;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
 6118                     	;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
 6119                     	;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
 6120                     	;RETURNED BY EXP.
 6121                     	;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
 6122  ED11  F0 70        FPWRT:	BEQ	EXP		;IF FAC=0, JUST EXPONENTIATE THAT.
 6123  ED13  A5 A8        	LDA	ARGEXP		;IS X=0?
 6124  ED15  D0 03        	BNE	FPWRT1
 6125  ED17  4C CA E6     	JMP	ZEROF1		;ZERO FAC.
 6126  ED1A  A2 8D A0 00  FPWRT1: LDXYI	TEMPF3		;SAVE FOR LATER IN A TEMP.
 6127  ED1E  20 A5 E9     	JSR	MOVMF
 6128                     	;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
 6129  ED21  A5 AD        	LDA	ARGSGN
 6130  ED23  10 0F        	BPL	FPWR1		;NO PROBLEMS IF X.GT.0.
 6131  ED25  20 9D EA     	JSR	INT		;INTEGERIZE THE FAC.
 6132  ED28  A9 8D A0 00  	LDWDI	TEMPF3		;GET ADDR OF COMPERAND.
 6133  ED2C  20 2C EA     	JSR	FCOMP		;EQUAL?
 6134  ED2F  D0 03        	BNE	FPWR1		;LEAVE X NEG. LOG WILL BLOW HIM OUT.
 6135                     				;A=-1 AND Y IS IRRELEVANT.
 6136  ED31  98           	TYA			;NEGATE X. MAKE POSITIVE.
 6137  ED32  A4 0D        	LDY	INTEGR		;GET EVENNESS.
 6138  ED34  20 CF E9     FPWR1:	JSR	MOVFA1		;ALTERNATE ENTRY POINT.
 6139  ED37  98           	TYA
 6140  ED38  48           	PHA			;SAVE EVENNESS FOR LATER.
 6141  ED39  20 BB E7     	JSR	LOG		;FIND LOG.
 6142  ED3C  A9 8D A0 00  	LDWDI	TEMPF3		;MULTIPLY FAC TIMES LOG(X).
 6143  ED40  20 F9 E7     	JSR	FMULT
 6144  ED43  20 83 ED     	JSR	EXP		;EXPONENTIATE THE FAC.
 6145  ED46  68           	PLA
 6146  ED47  4A           	LSR	A,		;IS IT EVEN?
 6147  ED48  90 0A        	BCC	NEGRTS		;YES. OR X.GT.0.
 6148                     	;NEGATE THE NUMBER IN FAC.
 6149  ED4A  A5 A0        NEGOP:	LDA	FACEXP
 6150  ED4C  F0 06        	BEQ	NEGRTS
 6151  ED4E  A5 A5 49 FF  	COM	FACSGN
       ED52  85 A5
 6152  ED54  60           NEGRTS: RTS
 6154                     PAGE
 6155                     SUBTTL	EXPONENTIATION FUNCTION.
 6156                     	;FIRST SAVE THE ORIGINAL ARGUMENT AND MULTIPLY THE FAC BY
 6157                     	;LOG2(E). THE RESULT IS USED TO DETERMINE IF OVERFLOW
 6158                     	;WILL OCCUR SINCE EXP(X)=2^(X*LOG2(E)) WHERE
 6159                     	;LOG2(E)=LOG(E) BASE 2. THEN SAVE THE INTEGER PART OF
 6160                     	;THIS TO SCALE THE ANSWER AT THE END. SINCE
 6161                     	;2^Y=2^INT(Y)*2^(Y-INT(Y)) AND 2^INT(Y) IS EASY TO COMPUTE.
 6162                     	;NOW COMPUTE 2^(X*LOG2(E)-INT(X*LOG2(E)) BY
 6163                     	;P(LN(2)*(INT(X*LOG2(E))+1)-X) WHERE P IS AN APPROXIMATION
 6164                     	;POLYNOMIAL. THE RESULT IS THEN SCALED BY THE POWER OF 2
 6165                     	;PREVIOUSLY SAVED.
