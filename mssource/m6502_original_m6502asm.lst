 2498                     PAGE
 2499                     SUBTTL	LINGET -- READ A LINE NUMBER INTO LINNUM
 2500                     ;
 2501                     ; "LINGET" READS A LINE NUMBER FROM THE CURRENT TEXT POSITION.
 2502                     ;
 2503                     ; LINE NUMBERS RANGE FROM 0 TO 64000-1.
 2504                     ;
 2505                     ; THE ANSWER IS RETURNED IN "LINNUM".
 2506                     ; "TXTPTR" IS UPDATED TO POINT TO THE TERMINATING CHARCTER
 2507                     ; AND [A] = THE TERMINATING CHARACTER WITH CONDITION
 2508                     ; CODES SET UP TO REFLECT ITS VALUE.
 2509                     ;
 2510  D88E  A2 00        LINGET: LDXI	0
 2511  D890  86 53        	STX	LINNUM		;INITIALIZE LINE NUMBER TO ZERO.
 2512  D892  86 54        	STX	LINNUM+1
 2513  D894  B0 F7        MORLIN: BCS	ONGRTS		;IT IS NOT A DIGIT.
 2514  D896  E9 2F        	SBCI	"0"-1		;-1 SINCE C=0.
 2515  D898  85 0D        	STA	CHARAC		;SAVE CHARACTER.
 2516  D89A  A5 54        	LDA	LINNUM+1
 2517  D89C  85 61        	STA	INDEX
 2518  D89E  C9 19        	CMPI	25		;LINE NUMBER WILL BE .LT. 64000?
 2519  D8A0  B0 D4        	BCS	SNERR3
 2520  D8A2  A5 53        	LDA	LINNUM
