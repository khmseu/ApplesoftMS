 6542                     SUBTTL	ARCTANGENT FUNCTION.
 6543                     	;USE IDENTITIES TO GET ARG BETWEEN 0 AND 1 AND THEN USE AN
 6544                     	;APPROXIMATION POLYNOMIAL TO COMPUTE ARCTAN(X).
 6545  EF0C  A5 A5        ATN:	LDA	FACSGN		;WHAT IS SIGN?
 6546  EF0E  48           	PHA			;(MEANWHILE SAVE FOR LATER.)
 6547  EF0F  10 03        	BPL	ATN1
 6548  EF11  20 3E ED     	JSR	NEGOP		;IF NEGATIVE, NEGATE FAC.
 6549                     				;USE ARCTAN(X)=-ARCTAN(-X) .
 6550  EF14  A5 A0        ATN1:	LDA	FACEXP
 6551  EF16  48           	PHA			;SAVE THIS TOO FOR LATER.
 6552  EF17  C9 81        	CMPI	201		;SEE IF FAC .GE. 1.0 .
 6553  EF19  90 07        	BCC	ATN2		;IT IS LESS THAN 1.
 6554  EF1B  A9 81 A0 E7  	LDWDI	FONE		;GET PNTR TO 1.0 .
 6555  EF1F  20 D4 E8     	JSR	FDIV		;COMPUTE RECIPROCAL.
 6556                     				;USE ARCTAN(X)=PI/2-ARCTAN(1/X) .
 6557  EF22  A9 3C A0 EF  ATN2:	LDWDI	ATNCON		;PNTR TO ARCTAN CONSTANTS.
 6558  EF26  20 CA ED     	JSR	POLYX
 6559  EF29  68           	PLA
 6560  EF2A  C9 81        	CMPI	201		;WAS ORIGINAL ARGUMENT .LT. 1 ?
 6561  EF2C  90 07        	BCC	ATN3		;YES.
 6562  EF2E  A9 D4 A0 EE  	LDWDI	PI2
 6563  EF32  20 15 E6     	JSR	FSUB		;SUBTRACT ARCTAGN FROM PI/2.
 6564  EF35  68           ATN3:	PLA			;WAS ORIGINAL ARGUMENT POSITIVE?
 6565  EF36  10 03        	BPL	ATN4		;YES.
 6566  EF38  4C 3E ED     	JMP	NEGOP		;IF NEGATIVE, NEGATE RESULT.
 6567  EF3B  60           ATN4:	RTS			;ALL DONE.
