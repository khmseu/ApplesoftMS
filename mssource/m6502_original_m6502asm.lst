 6104                     SUBTTL	EXPONENTIATION AND SQUARE ROOT FUNCTION.
 6105                     	;SQUARE ROOT FUNCTION --- SQR(A)
 6106                     	;USE SQR(X)=X^.5
 6107  ED07  20 DD E9     SQR:	JSR	MOVAF		;MOVE FAC INTO ARG.
 6108  ED0A  A9 DE A0 EC  	LDWDI	FHALF
