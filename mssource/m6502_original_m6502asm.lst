 2450  D82E  86 0D        	STX	CHARAC		;PRESERVE IT.
 2451  D830  A0 00        	LDYI	0		;THIS MAKES CHARAC=0 AFTER SWAP.
 2452  D832  84 0E        	STY	ENDCHR
 2453  D834  A5 0E        EXCHQT: LDA	ENDCHR
 2454  D836  A6 0D        	LDX	CHARAC
 2455  D838  85 0D        	STA	CHARAC
 2456  D83A  86 0E        	STX	ENDCHR
 2457  D83C  B1 B9        REMER:	LDADY	TXTPTR
 2458  D83E  F0 E8        	BEQ	REMRTS		;NULL ALWAYS TERMINATES.
