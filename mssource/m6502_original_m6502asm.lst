 3171  1326  24           	SKIP1
 3172  1327  38           CHKSTR: SEC			;SET CARRY.
 3173  1328  24 11        CHKVAL: BIT	VALTYP		;WILL NOT F UP "VALTYP".
 3174  132A  30 03        	BMI	DOCSTR
 3175  132C  B0 03        	BCS	CHKERR
 3176  132E  60           CHKOK:	RTS
 3177  132F  B0 FD        DOCSTR: BCS	CHKOK
