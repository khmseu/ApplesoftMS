 1647                     ;
 1648                     ; CHEAD GOES THROUGH PROGRAM STORAGE AND FIXES
 1649                     ; UP ALL THE LINKS. THE END OF EACH LINE IS FOUND
 1650                     ; BY SEARCHING FOR THE ZERO AT THE END.
 1651                     ; THE DOUBLE ZERO LINK IS USED TO DETECT THE END OF THE PROGRAM.
 1652                     ;
 1653  D406  A0 01        CHEAD:	LDYI	1
 1654  D408  B1 61        	LDADY	INDEX		;ARRIVED AT DOUBLE ZEROES?
 1655  D40A  F0 1D        	BEQ	LNKRTS
 1656  D40C  A0 04        	LDYI	4
