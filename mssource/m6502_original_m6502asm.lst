 4259  E24A  60           	RTS			;ALL DONE.
 4260                     ;
 4261                     ; "STRLT2" TAKES THE STRING LITERAL WHOSE FIRST CHARACTER
 4262                     ; IS POINTED TO BY [Y,A] AND BUILDS A DESCRIPTOR FOR IT.
 4263                     ; THE DESCRIPTOR IS INITIALLY BUILT IN "DSCTMP", BUT "PUTNEW"
 4264                     ; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER
 4265                     ; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN
 4266                     ; ZERO THAT TERMINATE THE STRING SHOULD BE SET UP IN "CHARAC"
 4267                     ; AND "ENDCHR". IF THE TERMINATOR IS A QUOTE, THE QUOTE IS SKIPPED
 4268                     ; OVER. LEADING QUOTES SHOULD BE SKIPPED BEFORE JSR. ON RETURN
 4269                     ; THE CHARACTER AFTER THE STRING LITERAL IS POINTED TO
 4270                     ; BY [STRNG2].
 4271                     ;
 4272  E24B  A2 22        STRLIT: LDXI	34		;ASSUME STRING ENDS ON QUOTE.
 4273  E24D  86 0D        	STX	CHARAC
 4274  E24F  86 0E        	STX	ENDCHR
 4275  E251  85 AE 84 AF  STRLT2: STWD	STRNG1		;SAVE POINTER TO STRING.
 4276  E255  85 A1 84 A2  	STWD	DSCTMP+1	;IN CASE NO STRCPY.
 4277  E259  A0 FF        	LDYI	255		;INITIALIZE CHARACTER COUNT.
 4278  E25B  C8           STRGET: INY
