 1646                     ;
 1647                     ; CHEAD GOES THROUGH PROGRAM STORAGE AND FIXES
 1648                     ; UP ALL THE LINKS. THE END OF EACH LINE IS FOUND
 1649                     ; BY SEARCHING FOR THE ZERO AT THE END.
 1650                     ; THE DOUBLE ZERO LINK IS USED TO DETECT THE END OF THE PROGRAM.
 1651                     ;
 1652  D3FA  A0 01        CHEAD:	LDYI	1
 1653  D3FC  B1 61        	LDADY	INDEX		;ARRIVED AT DOUBLE ZEROES?
