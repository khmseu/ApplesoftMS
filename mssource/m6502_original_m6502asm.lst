 1674                     ;
 1675                     ; THIS IS THE LINE INPUT ROUTINE.
 1676                     ; IT READS CHARACTERS INTO BUF USING BACKARROW (UNDERSCORE, OR
 1677                     ; SHIFT O) AS THE DELETE CHARACTER AND @ AS THE
 1678                     ; LINE DELETE CHARACTER. IF MORE THAN BUFLEN CHARACTERS
 1679                     ; ARE TYPED, NO ECHOING IS DONE UNTIL A BACKARROW OR @ OR CR
 1680                     ; IS TYPED. CONTROL-G WILL BE TYPED FOR EACH EXTRA CHARACTER.
 1681                     ; THE ROUTINE IS ENTERED AT INLIN.
 1682                     ;
 1683                     IFE	REALIO-4,<
 1684  D42A  A2 80        INLIN:	LDXI	128		;NO PROMPT CHARACTER
 1685  D42C  86 33        	STX	CQPRMP
 1686  D42E  20 67 FD     	JSR	CQINLN		;GET A LINE ONTO PAGE 2
 1687  D431  E0 EF        	CPXI	BUFLEN-1
 1688  D433  B0 02        	BCS	GDBUFS		;NOT TOO MANY CHARACTERS
 1689  D435  A2 EF        	LDXI	BUFLEN-1
 1690  D437  A9 00        GDBUFS: LDAI	0		;PUT A ZERO AT THE END
 1691  D439  9D 00 02     	STA	BUF,X
 1692  D43C  8A           	TXA
 1693  D43D  F0 0B        	BEQ	NOCHR
 1694  D43F  BD FF 01     LOPBHT: LDA	BUF-1,X
 1695  D442  29 7F        	ANDI	127
