 5695                     PAGE
 5696                     SUBTTL	FLOATING POINT INPUT ROUTINE.
 5697                     	;NUMBER INPUT IS LEFT IN FAC.
 5698                     	;AT ENTRY [TXTPTR] POINTS TO THE FIRST CHARACTER IN A TEXT BUFFER.
 5699                     	;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS
 5700                     	;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE
 5701                     	;DECIMAL POINT IS. [DPTFLG] TELL WHETHER A DP HAS BEEN
 5702                     	;SEEN. [DECCNT] IS THE NUMBER OF DIGITS AFTER THE DP.
 5703                     	;AT THE END [DECCNT] AND THE EXPONENT ARE USED TO
 5704                     	;DETERMINE HOW MANY TIMES TO MULTIPLY OR DIVIDE BY TEN
 5705                     	;TO GET THE CORRECT NUMBER.
 5706  EAC4  A0 00        FIN:	LDYI	0		;ZERO FACSGN&SGNFLG.
 5707  EAC6  A2 0A        	LDXI	11+ADDPRC	;ZERO EXP AND HO (AND MOH).
 5708  EAC8  94 9C        FINZLP: STY	DECCNT,X	;ZERO MO AND LO.
 5709  EACA  CA           	DEX			;ZERO TENEXP AND EXPSGN
 5710  EACB  10 FB        	BPL	FINZLP		;ZERO DECCNT, DPTFLG.
 5711  EACD  90 0F        	BCC	FINDGQ		;FLAGS STILL SET FROM CHRGET.
 5712  EACF  C9 2D        	CMPI	"-"		;A NEGATIVE SIGN?
 5713  EAD1  D0 04        	BNE	QPLUS		;NO, TRY PLUS SIGN.
 5714  EAD3  86 A6        	STX	SGNFLG		;IT'S NEGATIVE. (X=377).
 5715  EAD5  F0 04        	BEQ	FINC		;ALWAYS BRANCHES.
 5716  EAD7  C9 2B        QPLUS:	CMPI	"+"		;PLUS SIGN?
 5717  EAD9  D0 05        	BNE	FIN1		;YES, SKIP IT.
 5718  EADB  20 B2 00     FINC:	JSR	CHRGET
 5719  EADE  90 5B        FINDGQ: BCC	FINDIG
 5720  EAE0  C9 2E        FIN1:	CMPI	"."		;THE DP?
 5721  EAE2  F0 2E        	BEQ	FINDP		;NO KIDDING.
 5722  EAE4  C9 45        	CMPI	"E"		;EXPONENT FOLLOWS.
 5723  EAE6  D0 30        	BNE	FINE		;NO.
 5724                     	;HERE TO CHECK FOR SIGN OF EXP.
 5725  EAE8  20 B2 00     	JSR	CHRGET		;YES. GET ANOTHER.
 5726  EAEB  90 17        	BCC	FNEDG1		;IT IS A DIGIT. (EASIER THAN
 5727                     				;BACKING UP POINTER.)
 5728  EAED  C9 A4        	CMPI	MINUTK		;MINUS?
 5729  EAEF  F0 0E        	BEQ	FINEC1		;NEGATE.
 5730  EAF1  C9 2D        	CMPI	"-"		;MINUS SIGN?
 5731  EAF3  F0 0A        	BEQ	FINEC1
 5732  EAF5  C9 A3        	CMPI	PLUSTK		;PLUS?
 5733  EAF7  F0 08        	BEQ	FINEC
 5734  EAF9  C9 2B        	CMPI	"+"		;PLUS SIGN?
 5735  EAFB  F0 04        	BEQ	FINEC
 5736  EAFD  D0 07        	BNE	FINEC2
 5737  EAFF  66 9F        FINEC1: ROR	EXPSGN		;TURN IT ON.
 5738  EB01  20 B2 00     FINEC:	JSR	CHRGET		;GET ANOTHER.
 5739  EB04  90 5C        FNEDG1: BCC	FINEDG		;IT IS A DIGIT.
 5740  EB06  24 9F        FINEC2: BIT	EXPSGN
 5741  EB08  10 0E        	BPL	FINE
 5742  EB0A  A9 00        	LDAI	0
 5743  EB0C  38           	SEC
 5744  EB0D  E5 9D        	SBC	TENEXP
 5745  EB0F  4C 1A EB     	JMP	FINE1
 5746  EB12  66 9E        FINDP:	ROR	DPTFLG
 5747  EB14  24 9E        	BIT	DPTFLG
 5748  EB16  50 C3        	BVC	FINC
 5749  EB18  A5 9D        FINE:	LDA	TENEXP
 5750  EB1A  38           FINE1:	SEC
 5751  EB1B  E5 9C        	SBC	DECCNT		;GET NUMBER OF PLACES TO SHIFT.
 5752  EB1D  85 9D        	STA	TENEXP
 5753  EB1F  F0 12        	BEQ	FINQNG		;NEGATE?
 5754  EB21  10 09        	BPL	FINMUL		;POSITIVE SO MULTIPLY.
 5755  EB23  20 CF E8     FINDIV: JSR	DIV10
 5756  EB26  E6 9D        	INC	TENEXP		;DONE?
 5757  EB28  D0 F9        	BNE	FINDIV		;NO.
 5758  EB2A  F0 07        	BEQ	FINQNG		;YES.
 5759  EB2C  20 B3 E8     FINMUL: JSR	MUL10
 5760  EB2F  C6 9D        	DEC	TENEXP		;DONE?
 5761  EB31  D0 F9        	BNE	FINMUL		;NO
