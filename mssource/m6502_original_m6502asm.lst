 3282  13DE  A5 A4        	LDA	FACLO		;ENTRY POINT TO SKIP STORING SIGN.
 3283  13E0  48           	PHA
 3284  13E1  A5 A3        	LDA	FACMO
 3285  13E3  48           	PHA
 3286                     IFN	ADDPRC,<
 3287  13E4  A5 A2        	LDA	FACMOH
 3288  13E6  48           	PHA
 3289  13E7  A5 A1        	LDA	FACHO
 3290  13E9  48           	PHA
 3291  13EA  A5 A0        	LDA	FACEXP
