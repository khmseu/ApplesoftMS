 6564  2667  10 03        	BPL	ATN4		;YES.
 6565  2669  4C 6F 24     	JMP	NEGOP		;IF NEGATIVE, NEGATE RESULT.
 6566  266C  60           ATN4:	RTS			;ALL DONE.
