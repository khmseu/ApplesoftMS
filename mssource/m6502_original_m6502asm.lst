 2416                     ; AND ELIMINATES ALL THE "FOR" ENTRIES IN FRONT OF THE "GOSUB" ENTRY.
 2417                     ;
 2418  D7E9  D0 FD        RETURN: BNE	GORTS		;NO TERMINATOR=BLOW HIM UP.
 2419  D7EB  A9 FF        	LDAI	255
