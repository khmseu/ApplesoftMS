                          IFN REALIO-3,<
                          OUTBEL: LDAI	7
                          IFN	REALIO,<
                          	JSR	OUTDO>		;ECHO IT.
                          	BNE	INLINC>		;CYCLE ALWAYS.
                          FININ1: JMP	FININL>		;GO TO FININL FAR, FAR AWAY.
