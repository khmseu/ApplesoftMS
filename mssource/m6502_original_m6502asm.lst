 1819  0BBB  BD 00 02     RESCON: LDA	BUFOFS,X
 1820  0BBE  38           	SEC			;PREPARE TO SUBSTARCT.
 1821  0BBF  F9 80 08     	SBC	RESLST,Y	;CHARACTERS EQUAL?
 1822  0BC2  F0 F5        	BEQ	RESER		;YES, CONTINUE SEARCH.
 1823  0BC4  C9 80        	CMPI	128		;NO BUT MAYBE THE END IS HERE.
 1824  0BC6  D0 30        	BNE	NTHIS		;NO, TRULY UNEQUAL.
 1825  0BC8  05 0F        	ORA	COUNT
 1826  0BCA  A4 B0        GETBPT: LDY	BUFPTR		;GET BUFFER PNTR.
 1827  0BCC  E8           STUFFH: INX
 1828  0BCD  C8           	INY
 1829  0BCE  99 FB 01     	STA	BUF-5,Y
 1830  0BD1  B9 FB 01     	LDA	BUF-5,Y
 1831  0BD4  F0 36        	BEQ	CRDONE		;NULL IMPLIES END OF LINE.
 1832  0BD6  38           	SEC			;PREPARE TO SUBSTARCT.
 1833  0BD7  E9 3A        	SBCI	":"		;IS IT A ":"?
 1834  0BD9  F0 04        	BEQ	COLIS		;YES, ALLOW CRUNCHING AGAIN.
 1835  0BDB  C9 49        	CMPI	DATATK-":"	;IS IT A DATATK?
 1836  0BDD  D0 02        	BNE	NODATT		;NO, SEE IF IT IS REM TOKEN.
 1837  0BDF  85 13        COLIS:	STA	DORES		;SETUP FLAG.
 1838  0BE1  38           NODATT: SEC			;PREP TO SBCQ
 1839  0BE2  E9 54        	SBCI	REMTK-":"	;REM ONLY STOPS ON NULL.
 1840  0BE4  D0 A8        	BNE	KLOOP		;NO, CONTINUE CRUNCHING.
 1841  0BE6  85 0E        	STA	ENDCHR		;REM STOPS ONLY ON NULL, NOT : OR ".
 1842  0BE8  BD 00 02     STR1:	LDA	BUFOFS,X
 1843  0BEB  F0 DF        	BEQ	STUFFH		;YES, END OF LINE, SO DONE.
 1844  0BED  C5 0E        	CMP	ENDCHR		;END OF GOBBLE?
 1845  0BEF  F0 DB        	BEQ	STUFFH		;YES, DONE WITH STRING.
 1846  0BF1  C8           STRNG:	INY			;INCREMENT BUFFER POINTER.
 1847  0BF2  99 FB 01     	STA	BUF-5,Y
 1848  0BF5  E8           	INX
 1849  0BF6  D0 F0        	BNE	STR1		;PROCESS NEXT CHARACTER.
 1850  0BF8  A6 B9        NTHIS:	LDX	TXTPTR		;RESTORE TEXT POINTER.
 1851  0BFA  E6 0F        	INC	COUNT		;INCREMENT RES WORD COUNT.
 1852  0BFC  C8           NTHIS1: INY
 1853  0BFD  B9 7F 08     	LDA	RESLST-1,Y,	;GET RES CHARACTER.
 1854  0C00  10 FA        	BPL	NTHIS1		;END OF ENTRY?
 1855  0C02  B9 80 08     	LDA	RESLST,Y,	;YES. IS IT THE END?
 1856  0C05  D0 B4        	BNE	RESCON		;NO, TRY THE NEXT WORD.
 1857  0C07  BD 00 02     	LDA	BUFOFS,X	;YES, END OF TABLE. GET 1ST CHR.
 1858  0C0A  10 BE        	BPL	GETBPT		;STORE IT AWAY (ALWAYS BRANCHES).
 1859  0C0C  99 FD 01     CRDONE: STA	BUF-3,Y,	;SO THAT IF THIS IS A DIR STATEMENT
 1860                     				;ITS END WILL LOOK LIKE END OF PROGRAM.
 1861                     IFN	<<BUF+BUFLEN>/256>-<<BUF-1>/256>,<
                          	DEC	TXTPTR+1>
 1863  0C0F  A9 FF        	LDAI	<BUF&255>-1	;MAKE TXTPTR POINT TO
 1864  0C11  85 B9        	STA	TXTPTR		;CRUNCHED LINE.
 1865  0C13  60           LISTRT: RTS			;RETURN TO CALLER.
 1866                     ;
 1867                     ; FNDLIN SEARCHES THE PROGRAM TEXT FOR THE LINE
 1868                     ; WHOSE NUMBER IS PASSED IN "LINNUM".
 1869                     ; THERE ARE TWO POSSIBLE RETURNS:
 1870                     ;
 1871                     ;	1) CARRY SET.
 1872                     ;	   LOWTR POINTS TO THE LINK FIELD IN THE LINE
 1873                     ;	   WHICH IS THE ONE SEARCHED FOR.
 1874                     ;
 1875                     ;	2) CARRY NOT SET.
 1876                     ;	   LINE NOT FOUND. [LOWTR] POINTS TO THE LINE IN THE
 1877                     ;	   PROGRAM GREATER THAN THE ONE SOUGHT AFTER.
 1878                     ;
 1879  0C14  A5 6A A6 6B  FNDLIN: LDWX	TXTTAB		;LOAD [X,A] WITH [TXTTAB]
 1880  0C18  A0 01        FNDLNC: LDYI	1
 1881  0C1A  85 9E 86 9F  	STWX	LOWTR		;STORE [X,A] INTO LOWTR
 1882  0C1E  B1 9E        	LDADY	LOWTR		;SEE IF LINK IS 0
 1883  0C20  F0 1F        	BEQ	FLINRT
 1884  0C22  C8           	INY
 1885  0C23  C8           	INY
 1886  0C24  A5 54        	LDA	LINNUM+1	;COMP HIGH ORDERS OF LINE NUMBERS.
 1887  0C26  D1 9E        	CMPDY	LOWTR
 1888  0C28  90 18        	BCC	FLNRTS		;NO SUCH LINE NUMBER.
 1889  0C2A  F0 03        	BEQ	FNDLO1
 1890  0C2C  88           	DEY
 1891  0C2D  D0 09        	BNE	AFFRTS		;ALWAYS BRANCH.
 1892  0C2F  A5 53        FNDLO1: LDA	LINNUM
 1893  0C31  88           	DEY
 1894  0C32  D1 9E        	CMPDY	LOWTR		;COMPARE LOW ORDERS.
 1895  0C34  90 0C        	BCC	FLNRTS		;NO SUCH NUMBER.
 1896  0C36  F0 0A        	BEQ	FLNRTS		;GO TIT.
 1897  0C38  88           AFFRTS: DEY
 1898  0C39  B1 9E        	LDADY	LOWTR		;FETCH LINK.
 1899  0C3B  AA           	TAX
 1900  0C3C  88           	DEY
 1901  0C3D  B1 9E        	LDADY	LOWTR
 1902  0C3F  B0 D7        	BCS	FNDLNC		;ALWAYS BRANCHES.
 1903  0C41  18           FLINRT: CLC			;C MAY BE HIGH.
 1904  0C42  60           FLNRTS: RTS			;RETURN TO CALLER.
 1905                     ;
 1906                     ; THE "NEW" COMMAND CLEARS THE PROGRAM TEXT AS WELL
 1907                     ; AS VARIABLE SPACE.
 1908                     ;
 1909  0C43  D0 FD        SCRATH: BNE	FLNRTS		;MAKE SURE THERE IS A TERMINATOR.
 1910  0C45  A9 00        SCRTCH: LDAI	0		;GET A CLEARER.
 1911  0C47  A8           	TAY			;SET UP INDEX.
 1912  0C48  91 6A        	STADY	TXTTAB		;CLEAR	FIRST LINK.
 1913  0C4A  C8           	INY
 1914  0C4B  91 6A        	STADY	TXTTAB
 1915  0C4D  A5 6A        	LDA	TXTTAB
 1916  0C4F  18           	CLC
 1917  0C50  69 02        	ADCI	2
 1918  0C52  85 6C        	STA	VARTAB		;SETUP [VARTAB].
 1919  0C54  A5 6B        	LDA	TXTTAB+1
 1920  0C56  69 00        	ADCI	0
 1921  0C58  85 6D        	STA	VARTAB+1
 1922  0C5A  20 8C 0C     RUNC:	JSR	STXTPT
 1923  0C5D  A9 00        	LDAI	0		;SET ZERO FLAG
 1924                     ;
 1925                     ; THIS CODE IS FOR THE CLEAR COMMAND.
 1926                     ;
 1927  0C5F  D0 2A        CLEAR:	BNE	STKRTS		;SYNTAX ERROR IF NO TERMINATOR.
 1928                     ;
 1929                     ; CLEAR INITIALIZES THE VARIABLE AND
 1930                     ; ARRAY SPACE BY RESETING ARYTAB (THE END OF SIMPLE VARIABLE SPACE)
 1931                     ; AND STREND (THE END OF ARRAY STORAGE). IT FALLS INTO "STKINI"
 1932                     ; WHICH RESETS THE STACK.
 1933                     ;
 1934  0C61  A5 76 A4 77  CLEARC: LDWD	MEMSIZ		;FREE UP STRING SPACE.
 1935  0C65  85 72 84 73  	STWD	FRETOP
 1936                     IFN	EXTIO,<
                          	JSR	CQCALL>		;CLOSE ALL OPEN FILES.
 1938  0C69  A5 6C A4 6D  	LDWD	VARTAB		;LIBERATE THE
 1939  0C6D  85 6E 84 6F  	STWD	ARYTAB		;VARIABLES AND
 1940  0C71  85 70 84 71  	STWD	STREND		;ARRAYS.
 1941  0C75  20 00 0E     FLOAD:	JSR	RESTOR		;RESTORE DATA.
 1942                     ;
 1943                     ; STKINI RESETS THE STACK POINTER ELIMINATING
 1944                     ; GOSUB AND FOR CONTEXT. STRING TEMPORARIES ARE FREED
 1945                     ; UP, SUBFLG IS RESET. CONTINUING IS PROHIBITED.
 1946                     ; AND A DUMMY ENTRY IS LEFT AT THE BOTTOM OF THE STACK SO "FNDFOR" WILL ALWAYS
 1947                     ; FIND A NON-"FOR" ENTRY AT THE BOTTOM OF THE STACK.
 1948                     ;
 1949  0C78  A2 58        STKINI: LDXI	TEMPST		;INITIALIZE STRING TEMPORARIES.
 1950  0C7A  86 55        	STX	TEMPPT
 1951  0C7C  68           	PLA			;SETUP RETURN ADDRESS.
 1952  0C7D  A8           	TAY
 1953  0C7E  68           	PLA
 1954  0C7F  A2 FA        	LDXI	STKEND-257
 1955  0C81  9A           	TXS
 1956  0C82  48           	PHA
 1957  0C83  98           	TYA
 1958  0C84  48           	PHA
 1959  0C85  A9 00        	LDAI	0
 1960  0C87  85 7D        	STA	OLDTXT+1	;DISALLOWING CONTINUING
 1961  0C89  85 14        	STA	SUBFLG		;ALLOW SUBSCRIPTS.
 1962  0C8B  60           STKRTS: RTS
 1964  0C8C  18           STXTPT: CLC
 1965  0C8D  A5 6A        	LDA	TXTTAB
 1966  0C8F  69 FF        	ADCI	255
 1967  0C91  85 B9        	STA	TXTPTR
 1968  0C93  A5 6B        	LDA	TXTTAB+1
 1969  0C95  69 FF        	ADCI	255
 1970  0C97  85 BA        	STA	TXTPTR+1	;SETUP TEXT POINTER.
 1971  0C99  60           	RTS
 1972                     PAGE
 1973                     SUBTTL	THE "LIST" COMMAND.
 1975  0C9A  90 06        LIST:	BCC	GOLST		;IT IS A DIGIT.
 1976  0C9C  F0 04        	BEQ	GOLST		;IT IS A TERMINATOR.
 1977  0C9E  C9 A2        	CMPI	MINUTK		;DASH PRECEDING?
 1978  0CA0  D0 E9        	BNE	STKRTS		;NO, SO SYNTAX ERROR.
 1979  0CA2  20 B3 0F     GOLST:	JSR	LINGET		;GET LINE NUMBER INTO NUMLIN.
 1980  0CA5  20 14 0C     	JSR	FNDLIN		;FIND LINE .GE. [NUMLIN].
 1981  0CA8  20 B8 00     	JSR	CHRGOT		;GET LAST CHARACTER.
 1982  0CAB  F0 0C        	BEQ	LSTEND		;IF END OF LINE, # IS THE END.
 1983  0CAD  C9 A2        	CMPI	MINUTK		;DASH?
 1984  0CAF  D0 91        	BNE	FLNRTS		;IF NOT, SYNTAX ERROR.
 1985  0CB1  20 B2 00     	JSR	CHRGET		;GET NEXT CHAR.
 1986  0CB4  20 B3 0F     	JSR	LINGET		;GET END #.
 1987  0CB7  D0 89        	BNE	FLNRTS		;IF NOT TERMINATOR, ERROR.
 1988  0CB9  68           LSTEND: PLA
 1989  0CBA  68           	PLA			;GET RID OF "NEWSTT" RTS ADDR.
 1990  0CBB  A5 53        	LDA	LINNUM		;SEE IF IT WAS EXISTENT.
 1991  0CBD  05 54        	ORA	LINNUM+1
 1992  0CBF  D0 06        	BNE	LIST4		;IT WAS TYPED.
 1993  0CC1  A9 FF        	LDAI	255
 1994  0CC3  85 53        	STA	LINNUM
 1995  0CC5  85 54        	STA	LINNUM+1	;MAKE IT HUGE.
 1996  0CC7  A0 01        LIST4:	LDYI	1
 1997                     IFE	REALIO-3,<
                          	STY	DORES>
 1999  0CC9  B1 9E        	LDADY	LOWTR		;IS LINK ZERO?
 2000  0CCB  F0 39        	BEQ	GRODY		;YES, GO TO READY.
 2001                     IFN	REALIO,<
 2002  0CCD  20 0F 0E     	JSR	ISCNTC
 2003  0CD0  20 B4 10     	JSR	CRDO		;PRINT CRLF TO START WITH.
 2004  0CD3  C8           	INY
 2005  0CD4  B1 9E        	LDADY	LOWTR
 2006  0CD6  AA           	TAX
 2007  0CD7  C8           	INY
 2008  0CD8  B1 9E        	LDADY	LOWTR		;GET LINE NUMBER.
 2009  0CDA  C5 54        	CMP	LINNUM+1	;SEE IF BEYOND LAST.
 2010  0CDC  D0 04        	BNE	TSTDUN		;GO DETERMINE RELATION.
 2011  0CDE  E4 53        	CPX	LINNUM		;WAS EQUAL SO TEST LOW ORDER.
 2012  0CE0  F0 02        	BEQ	TYPLIN		;EQUAL, SO LIST IT.
 2013  0CE2  B0 22        TSTDUN: BCS	GRODY		;IF LINE IS GR THAN LAST, THEN DUNE.
 2014  0CE4  84 88        TYPLIN: STY	LSTPNT
 2015  0CE6  20 C3 22     	JSR	LINPRT		;PRINT AS INT WITHOUT LEADING SPACE.
 2016  0CE9  A9 20        	LDAI	" "		;ALWAYS PRINT SPACE AFTER NUMBER.
 2017  0CEB  A4 88        PRIT4:	LDY	LSTPNT		;GET POINTER TO LINE BACK.
 2018  0CED  29 7F        	ANDI	127
 2019  0CEF  20 20 11     PLOOP:	JSR	OUTDO		;PRINT CHAR.
 2020                     IFE	REALIO-3,<
                          	CMPI	34
                          	BNE	PLOOP1
                          	COM	DORES>		;IF QUOTE, COMPLEMENT FLAG.
 2024  0CF2  C8           PLOOP1: INY
 2025  0CF3  F0 11        	BEQ	GRODY		;IF WE HAVE PRINTED 256 CHARACTERS
 2026                     				;THE PROGRAM MUST BE MISFORMATED IN
 2027                     				;MEMORY DUE TO A BAD LOAD OR BAD
 2028                     				;HARDWARE. LET THE GUY RECOVER
 2029  0CF5  B1 9E        	LDADY	LOWTR		;GET NEXT CHAR. IS IT ZERO?
 2030  0CF7  D0 10        	BNE	QPLOP		;YES. END OF LINE.
 2031  0CF9  A8           	TAY
 2032  0CFA  B1 9E        	LDADY	LOWTR
 2033  0CFC  AA           	TAX
 2034  0CFD  C8           	INY
 2035  0CFE  B1 9E        	LDADY	LOWTR
 2036  0D00  86 9E        	STX	LOWTR
 2037  0D02  85 9F        	STA	LOWTR+1
 2038  0D04  D0 C1        	BNE	LIST4		;BRANCH IF SOMETHING TO LIST.
 2039  0D06  4C 69 0A     GRODY:	JMP	READY
 2040                     				;IS IT A TOKEN?
 2041  0D09  10 E4        QPLOP:	BPL	PLOOP		;NO, HEAD FOR PRINTER.
 2042                     IFE	REALIO-3,<
                          	CMPI	PI
                          	BEQ	PLOOP
                          	BIT	DORES		;INSIDE QUOTE MARKS?
                          	BMI	PLOOP>		;YES, JUST TYPE THE CHARACTER.
 2047  0D0B  38           	SEC
 2048  0D0C  E9 7F        	SBCI	127		;GET RID OF SIGN BIT AND ADD 1.
 2049  0D0E  AA           	TAX			;MAKE IT A COUNTER.
 2050  0D0F  84 88        	STY	LSTPNT		;SAVE POINTER TO LINE.
 2051  0D11  A0 FF        	LDYI	255		;LOOK AT RES'D WORD LIST.
 2052  0D13  CA           RESRCH: DEX			;IS THIS THE RES'D WORD?
 2053  0D14  F0 08        	BEQ	PRIT3		;YES, GO TOSS IT UP..
 2054  0D16  C8           RESCR1: INY
 2055  0D17  B9 80 08     	LDA	RESLST,Y,	;END OF ENTRY?
 2056  0D1A  10 FA        	BPL	RESCR1		;NO, CONTINUE PASSING.
 2057  0D1C  30 F5        	BMI	RESRCH
 2058  0D1E  C8           PRIT3:	INY
 2059  0D1F  B9 80 08     	LDA	RESLST,Y
 2060  0D22  30 C7        	BMI	PRIT4		;END OF RESERVED WORD.
 2061  0D24  20 20 11     	JSR	OUTDO		;PRINT IT.
 2062  0D27  D0 F5        	BNE	PRIT3		;END OF ENTRY? NO, TYPE REST.
 2063                     PAGE
 2064                     SUBTTL THE "FOR" STATEMENT.
 2065                     ;
 2066                     ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2067                     ;
 2068                     ; LOW ADDRESS
 2069                     ;	TOKEN (FORTK) 1 BYTE
 2070                     ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
 2071                     ;	THE STEP 4+ADDPRC BYTES
 2072                     ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 2073                     ;	THE UPPER VALUE 4+ADDPRC BYTES
 2074                     ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 2075                     ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 2076                     ; HIGH ADDRESS
 2077                     ;
 2078                     ; TOTAL 16+2*ADDPRC BYTES.
 2079                     ;
 2081  0D29  A9 80        FOR:	LDAI	128		;DON'T RECOGNIZE
 2082  0D2B  85 14        	STA	SUBFLG		;SUBSCRIPTED VARIABLES.
 2083  0D2D  20 ED 0F     	JSR	LET		;READ THE VARIABLE AND ASSIGN IT
 2084                     				;THE CORRECT INITIAL VALUE AND STORE
 2085                     				;A POINTER TO THE VARIABLE IN VARPNT.
 2086  0D30  20 96 09     	JSR	FNDFOR		;PNTR IS IN VARPNT, AND FORPNT.
 2087  0D33  D0 05        	BNE	NOTOL		;IF NO MATCH, DON'T ELIMINATE ANYTHING.
 2088  0D35  8A           	TXA			;MAKE IT ARITHMETICAL.
 2089  0D36  69 0F        	ADCI	FORSIZ-3	;ELIMINATE ALMOST ALL.
 2090  0D38  AA           	TAX			;NOTE C=1, THEN PLA, PLA.
 2091  0D39  9A           	TXS			;MANIFEST.
 2092  0D3A  68           NOTOL:	PLA			;GET RID OF NEWSTT RETURN ADDRESS
 2093  0D3B  68           	PLA			;IN CASE THIS IS A TOTALLY NEW ENTRY.
 2094  0D3C  A9 09        	LDAI	8+ADDPRC
 2095  0D3E  20 07 0A     	JSR	GETSTK		;MAKE SURE 16 BYTES ARE AVAILABLE.
 2096  0D41  20 4E 0F     	JSR	DATAN		;GET A COUNT IN [Y] OF THE NUMBER OF
 2097                     				;CHACRACTERS LEFT IN THE "FOR" STATEMENT
 2098                     				;[TXTPTR] IS UNAFFECTED.
 2099  0D44  18           	CLC			;PREP TO ADD.
 2100  0D45  98           	TYA			;SAVE IT FOR PUSHING.
 2101  0D46  65 B9        	ADC	TXTPTR
 2102  0D48  48           	PHA
 2103  0D49  A5 BA        	LDA	TXTPTR+1
 2104  0D4B  69 00        	ADCI	0
 2105  0D4D  48           	PHA
 2106  0D4E  A5 79 48 A5  	PSHWD	CURLIN		;PUT LINE NUMBER ON STACK.
       0D52  78 48
 2107  0D54  A9 9B 20 7E  	SYNCHK	TOTK		;"TO" IS NECESSARY.
       0D58  14
 2108  0D59  20 25 13     	JSR	CHKNUM		;VALUE MUST BE A NUMBER.
 2109  0D5C  20 22 13     	JSR	FRMNUM		;GET UPPER VALUE INTO FAC.
 2110  0D5F  A5 A5        	LDA	FACSGN		;PACK FAC.
 2111  0D61  09 7F        	ORAI	127
 2112  0D63  25 A1        	AND	FACHO
 2113  0D65  85 A1        	STA	FACHO		;SET PACKED SIGN BIT.
 2114  0D67  A9 72 A0 0D  	LDWDI	LDFONE
 2115  0D6B  85 61 84 62  	STWD	INDEX1
 2116  0D6F  4C DB 13     	JMP	FORPSH		;PUT FAC ONTO STACK, PACKED.
 2117  0D72  A9 B2 A0 1E  LDFONE: LDWDI	FONE		;PUT 1.0 INTO FAC.
 2118  0D76  20 98 20     	JSR	MOVFM
 2119  0D79  20 B8 00     	JSR	CHRGOT
 2120  0D7C  C9 A0        	CMPI	STEPTK		;A STEP IS GIVEN?
 2121  0D7E  D0 06        	BNE	ONEON		;NO. ASSUME 1.0.
 2122  0D80  20 B2 00     	JSR	CHRGET		;YES. ADVANCE POINTER.
 2123  0D83  20 22 13     	JSR	FRMNUM		;READ THE STEP.
 2124  0D86  20 21 21     ONEON:	JSR	SIGN		;GET SIGN IN ACCA.
 2125  0D89  20 D0 13     	JSR	PUSHF		;PUSH FAC ONTO STACK (THRU A).
 2126  0D8C  A5 89 48 A5  	PSHWD	FORPNT		;PUT PNTR TO VARIABLE ON STACK.
       0D90  88 48
 2127  0D92  A9 81        NXTCON: LDAI	FORTK		;PUT A FORTK ONTO STACK.
 2128  0D94  48           	PHA
 2129                     ;	BNEA	NEWSTT		;SIMULATE BNE TO NEWSTT. JUST FALL IN.
 2130                     PAGE
 2131                     SUBTTL	NEW STATEMENT FETCHER.
 2132                     ;
 2133                     ; BACK HERE FOR NEW STATEMENT. CHARACTER POINTED TO BY TXTPTR
 2134                     ; IS ":" OR END-OF-LINE. THE ADDRESS OF THIS LOC IS LEFT
 2135                     ; ON THE STACK WHEN A STATEMENT IS EXECUTED SO THAT
 2136                     ; IT CAN MERELY DO A RTS WHEN IT IS DONE.
 2137                     ;
 2138                     NEWSTT: IFN	REALIO,<
 2139  0D95  20 0F 0E     	JSR	ISCNTC
 2140  0D98  A5 B9 A4 BA  	LDWD	TXTPTR		;LOOK AT CURRENT CHARACTER.
 2141                     IFN	BUFPAG,<
 2142  0D9C  C0 02        	CPYI	BUFPAG
 2143  0D9E  F0 04        	BEQ	DIRCON
 2144  0DA0  85 7C 84 7D  	STWD	OLDTXT		;SAVE IN CASE OF RESTART BY INPUT.
 2145                     IFN	BUFPAG,<DIRCON:>
 2145  0DA4               DIRCON:
 2146  0DA4  A0 00        	LDYI	0
 2147                     IFE	BUFPAG,<DIRCON:>
 2148  0DA6  B1 B9        	LDADY	TXTPTR
 2149  0DA8  D0 40        	BNE	MORSTS		;NOT NULL -- CHECK WHAT IT IS
 2150  0DAA  A0 02        	LDYI	2		;LOOK AT LINK.
 2151  0DAC  B1 B9        	LDADY	TXTPTR		;IS LINK 0?
 2152  0DAE  18           	CLC		;CLEAR CARRY FOR ENDCON AND MATH THAT FOLLOWS
 2153  0DAF  D0 03 4C 38  	JEQ	ENDCON		;YES - RAN OFF THE END.
       0DB3  0E
 2154  0DB4  C8           	INY			;PUT LINE NUMBER IN CURLIN.
 2155  0DB5  B1 B9        	LDADY	TXTPTR
 2156  0DB7  85 78        	STA	CURLIN
 2157  0DB9  C8           	INY
 2158  0DBA  B1 B9        	LDADY	TXTPTR
 2159  0DBC  85 79        	STA	CURLIN+1
 2160  0DBE  98           	TYA
 2161  0DBF  65 B9        	ADC	TXTPTR
 2162  0DC1  85 B9        	STA	TXTPTR
 2163  0DC3  90 02        	BCC	GONE
 2164  0DC5  E6 BA        	INC	TXTPTR+1
 2165  0DC7  20 B2 00     GONE:	JSR	CHRGET		;GET THE STATEMENT TYPE.
 2166  0DCA  20 D0 0D     	JSR	GONE3
 2167  0DCD  4C 95 0D     	JMP	NEWSTT
 2168  0DD0  F0 3C        GONE3:	BEQ	ISCRTS		;IF TERMINATOR, TRY AGAIN.
 2169                     				;NO NEED TO SET UP CARRY SINCE IT WILL
