 4250  E243  F0 12        	BEQA	STRLIT		;SCAN IT AND TURN IT INTO A STRING.
 4251                     ;
 4252                     ; "STRINI" GET STRING SPACE FOR THE CREATION OF A STRING AND
 4253                     ; CREATES A DESCRIPTOR FOR IT IN "DSCTMP".
 4254                     ;
 4255  E245  A6 A3 A4 A4  STRINI: LDXY	FACMO		;GET FACMO TO STORE IN DSCPNT.
 4256  E249  86 8F 84 90  	STXY	DSCPNT		;RETAIN THE DESCRIPTOR POINTER.
 4257  E24D  20 C4 E2     STRSPA: JSR	GETSPA		;GET STRING SPACE.
 4258  E250  86 A1 84 A2  	STXY	DSCTMP+1	;SAVE LOCATION.
 4259  E254  85 A0        	STA	DSCTMP		;SAVE LENGTH.
 4260  E256  60           	RTS			;ALL DONE.
 4261                     ;
 4262                     ; "STRLT2" TAKES THE STRING LITERAL WHOSE FIRST CHARACTER
 4263                     ; IS POINTED TO BY [Y,A] AND BUILDS A DESCRIPTOR FOR IT.
 4264                     ; THE DESCRIPTOR IS INITIALLY BUILT IN "DSCTMP", BUT "PUTNEW"
 4265                     ; TRANSFERS IT INTO A TEMPORARY AND LEAVES A POINTER
 4266                     ; AT THE TEMPORARY IN FACMO&LO. THE CHARACTERS OTHER THAN
 4267                     ; ZERO THAT TERMINATE THE STRING SHOULD BE SET UP IN "CHARAC"
 4268                     ; AND "ENDCHR". IF THE TERMINATOR IS A QUOTE, THE QUOTE IS SKIPPED
 4269                     ; OVER. LEADING QUOTES SHOULD BE SKIPPED BEFORE JSR. ON RETURN
 4270                     ; THE CHARACTER AFTER THE STRING LITERAL IS POINTED TO
 4271                     ; BY [STRNG2].
 4272                     ;
 4273  E257  A2 22        STRLIT: LDXI	34		;ASSUME STRING ENDS ON QUOTE.
 4274  E259  86 0D        	STX	CHARAC
 4275  E25B  86 0E        	STX	ENDCHR
 4276  E25D  85 AE 84 AF  STRLT2: STWD	STRNG1		;SAVE POINTER TO STRING.
 4277  E261  85 A1 84 A2  	STWD	DSCTMP+1	;IN CASE NO STRCPY.
 4278  E265  A0 FF        	LDYI	255		;INITIALIZE CHARACTER COUNT.
 4279  E267  C8           STRGET: INY
 4280  E268  B1 AE        	LDADY	STRNG1		;GET CHARACTER.
 4281  E26A  F0 0C        	BEQ	STRFI1		;IF ZERO.
 4282  E26C  C5 0D        	CMP	CHARAC		;THIS TERMINATOR?
 4283  E26E  F0 04        	BEQ	STRFIN		;YES.
 4284  E270  C5 0E        	CMP	ENDCHR
 4285  E272  D0 F3        	BNE	STRGET		;LOOK FURTHER.
 4286  E274  C9 22        STRFIN: CMPI	34		;QUOTE?
 4287  E276  F0 01        	BEQ	STRFI2
 4288  E278  18           STRFI1: CLC			;NO, BACK UP.
 4289  E279  84 A0        STRFI2: STY	DSCTMP		;RETAIN COUNT.
 4290  E27B  98           	TYA
