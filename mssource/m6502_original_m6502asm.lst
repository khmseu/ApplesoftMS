 2426  D801  F0 0B        	BEQ	RETU1
 2427  D803  A2 16        	LDXI	ERRRG
 2428  D805  2C           	SKIP2
 2429  D806  A2 5A        USERR:	LDXI	ERRUS		;NO MATCH SO "US" ERROR.
 2430  D808  4C 1D D3     	JMP	ERROR		;YES.
