 4239                     ;
 4240                     ; THE STR$ FUNCTION TAKES A NUMBER AND GIVES A STRING
 4241                     ; WITH THE CHARACTERS THE OUTPUT OF THE NUMBER
 4242                     ; WOULD HAVE GIVEN.
 4243                     ;
 4244  E235  20 00 DC     STR:	JSR	CHKNUM		;ARG HAS TO BE NUMERIC.
 4245  E238  A0 00        	LDYI	0
 4246  E23A  20 B0 EB     	JSR	FOUTC		;DO ITS OUTPUT.
 4247  E23D  68           	PLA
 4248  E23E  68           	PLA
