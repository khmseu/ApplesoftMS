 5733  2220  F0 04        	BEQ	FINEC
 5734  2222  D0 07        	BNE	FINEC2
 5735  2224  66 9F        FINEC1: ROR	EXPSGN		;TURN IT ON.
 5736  2226  20 B2 00     FINEC:	JSR	CHRGET		;GET ANOTHER.
 5737  2229  90 5C        FNEDG1: BCC	FINEDG		;IT IS A DIGIT.
