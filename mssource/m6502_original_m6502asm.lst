 2527  0FD7  85 54        	STA	LINNUM+1
 2528  0FD9  06 53        	ASL	LINNUM
 2529  0FDB  26 54        	ROL	LINNUM+1
 2530  0FDD  A5 53        	LDA	LINNUM
 2531  0FDF  65 0D        	ADC	CHARAC		;ADD IN DIGIT.
 2532  0FE1  85 53        	STA	LINNUM
 2533  0FE3  90 02        	BCC	NXTLGC
 2534  0FE5  E6 54        	INC	LINNUM+1
