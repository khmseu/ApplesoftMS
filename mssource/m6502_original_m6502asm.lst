 6410                     	;SINE FUNCTION.
 6411                     	;USE IDENTITIES TO GET FAC IN QUADRANTS I OR IV.
 6412                     	;THE FAC IS DIVIDED BY 2*PI AND THE INTEGER PART IS IGNORED
 6413                     	;BECAUSE SIN(X+2*PI)=SIN(X). THEN THE ARGUMENT CAN BE COMPARED
 6414                     	;WITH PI/2 BY COMPARING THE RESULT OF THE DIVISION
 6415                     	;WITH PI/2/(2*PI)=1/4.
 6416                     	;IDENTITIES ARE THEN USED TO GET THE RESULT IN QUADRANTS
 6417                     	;I OR IV. AN APPROXIMATION POLYNOMIAL IS THEN USED TO
 6418                     	;COMPUTE SIN(X).
 6419  EE5F  20 D1 E9     SIN:	JSR	MOVAF
 6420  EE62  A9 D9 A0 EE  	LDWDI	TWOPI		;GET PNTR TO DIVISOR.
 6421  EE66  A6 AD        	LDX	ARGSGN		;GET SIGN OF RESULT.
 6422  EE68  20 CC E8     	JSR	FDIVF
 6423  EE6B  20 D1 E9     	JSR	MOVAF		;GET RESULT INTO ARG.
 6424  EE6E  20 91 EA     	JSR	INT		;INTEGERIZE FAC.
 6425  EE71  A9 00 85 AE  	CLR	ARISGN		;ALWAYS HAVE THE SAME SIGN.
 6426  EE75  20 18 E6     	JSR	FSUBT		;KEEP ONLY THE FRACTIONAL PART.
 6427  EE78  A9 DE A0 EE  	LDWDI	FR4		;GET PNTR TO 1/4.
 6428  EE7C  20 15 E6     	JSR	FSUB		;COMPUTE 1/4-FAC.
 6429  EE7F  A5 A5        	LDA	FACSGN		;SAVE SIGN FOR LATER.
 6430  EE81  48           	PHA
 6431  EE82  10 0D        	BPL	SIN1		;FIRST QUADRANT.
 6432  EE84  20 0E E6     	JSR	FADDH		;ADD 1/2 TO FAC.
 6433  EE87  A5 A5        	LDA	FACSGN		;SIGN IS NEGATIVE?
 6434  EE89  30 09        	BMI	SIN2
 6435  EE8B  A5 16 49 FF  	COM	TANSGN		;QUADRANTS II AND III COME HERE.
       EE8F  85 16
 6436  EE91  20 3E ED     SIN1:	JSR	NEGOP		;IF POSITIVE, NEGATE IT.
 6437  EE94  A9 DE A0 EE  SIN2:	LDWDI	FR4		;POINTER TO 1/4.
 6438  EE98  20 2C E6     	JSR	FADD		;ADD IT IN.
 6439  EE9B  68           	PLA			;GET ORIGINAL QUADRANT.
 6440  EE9C  10 03        	BPL	SIN3
