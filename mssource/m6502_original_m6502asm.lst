 2065                     PAGE
 2066                     SUBTTL THE "FOR" STATEMENT.
 2067                     ;
 2068                     ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2069                     ;
 2070                     ; LOW ADDRESS
 2071                     ;	TOKEN (FORTK) 1 BYTE
 2072                     ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
 2073                     ;	THE STEP 4+ADDPRC BYTES
 2074                     ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 2075                     ;	THE UPPER VALUE 4+ADDPRC BYTES
 2076                     ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 2077                     ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 2078                     ; HIGH ADDRESS
 2079                     ;
 2080                     ; TOTAL 16+2*ADDPRC BYTES.
 2081                     ;
 2083  D604  A9 80        FOR:	LDAI	128		;DON'T RECOGNIZE
 2084  D606  85 14        	STA	SUBFLG		;SUBSCRIPTED VARIABLES.
 2085  D608  20 C8 D8     	JSR	LET		;READ THE VARIABLE AND ASSIGN IT
 2086                     				;THE CORRECT INITIAL VALUE AND STORE
 2087                     				;A POINTER TO THE VARIABLE IN VARPNT.
 2088  D60B  20 70 D2     	JSR	FNDFOR		;PNTR IS IN VARPNT, AND FORPNT.
 2089  D60E  D0 05        	BNE	NOTOL		;IF NO MATCH, DON'T ELIMINATE ANYTHING.
 2090  D610  8A           	TXA			;MAKE IT ARITHMETICAL.
 2091  D611  69 0F        	ADCI	FORSIZ-3	;ELIMINATE ALMOST ALL.
 2092  D613  AA           	TAX			;NOTE C=1, THEN PLA, PLA.
 2093  D614  9A           	TXS			;MANIFEST.
 2094  D615  68           NOTOL:	PLA			;GET RID OF NEWSTT RETURN ADDRESS
 2095  D616  68           	PLA			;IN CASE THIS IS A TOTALLY NEW ENTRY.
 2096  D617  A9 09        	LDAI	8+ADDPRC
 2097  D619  20 E1 D2     	JSR	GETSTK		;MAKE SURE 16 BYTES ARE AVAILABLE.
 2098  D61C  20 29 D8     	JSR	DATAN		;GET A COUNT IN [Y] OF THE NUMBER OF
 2099                     				;CHACRACTERS LEFT IN THE "FOR" STATEMENT
 2100                     				;[TXTPTR] IS UNAFFECTED.
