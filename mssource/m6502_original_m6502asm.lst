 5697                     	;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS
 5698                     	;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE
 5699                     	;DECIMAL POINT IS. [DPTFLG] TELL WHETHER A DP HAS BEEN
 5700                     	;SEEN. [DECCNT] IS THE NUMBER OF DIGITS AFTER THE DP.
 5701                     	;AT THE END [DECCNT] AND THE EXPONENT ARE USED TO
 5702                     	;DETERMINE HOW MANY TIMES TO MULTIPLY OR DIVIDE BY TEN
 5703                     	;TO GET THE CORRECT NUMBER.
 5704  21E9  A0 00        FIN:	LDYI	0		;ZERO FACSGN&SGNFLG.
 5705  21EB  A2 0A        	LDXI	11+ADDPRC	;ZERO EXP AND HO (AND MOH).
 5706  21ED  94 9C        FINZLP: STY	DECCNT,X	;ZERO MO AND LO.
 5707  21EF  CA           	DEX			;ZERO TENEXP AND EXPSGN
 5708  21F0  10 FB        	BPL	FINZLP		;ZERO DECCNT, DPTFLG.
 5709  21F2  90 0F        	BCC	FINDGQ		;FLAGS STILL SET FROM CHRGET.
 5710  21F4  C9 2D        	CMPI	"-"		;A NEGATIVE SIGN?
 5711  21F6  D0 04        	BNE	QPLUS		;NO, TRY PLUS SIGN.
 5712  21F8  86 A6        	STX	SGNFLG		;IT'S NEGATIVE. (X=377).
 5713  21FA  F0 04        	BEQ	FINC		;ALWAYS BRANCHES.
 5714  21FC  C9 2B        QPLUS:	CMPI	"+"		;PLUS SIGN?
 5715  21FE  D0 05        	BNE	FIN1		;YES, SKIP IT.
 5716  2200  20 B2 00     FINC:	JSR	CHRGET
 5717  2203  90 5B        FINDGQ: BCC	FINDIG
 5718  2205  C9 2E        FIN1:	CMPI	"."		;THE DP?
 5719  2207  F0 2E        	BEQ	FINDP		;NO KIDDING.
 5720  2209  C9 45        	CMPI	"E"		;EXPONENT FOLLOWS.
 5721  220B  D0 30        	BNE	FINE		;NO.
 5722                     	;HERE TO CHECK FOR SIGN OF EXP.
 5723  220D  20 B2 00     	JSR	CHRGET		;YES. GET ANOTHER.
 5724  2210  90 17        	BCC	FNEDG1		;IT IS A DIGIT. (EASIER THAN
 5725                     				;BACKING UP POINTER.)
