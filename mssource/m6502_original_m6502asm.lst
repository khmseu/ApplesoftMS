 2497                     PAGE
 2498                     SUBTTL	LINGET -- READ A LINE NUMBER INTO LINNUM
 2499                     ;
 2500                     ; "LINGET" READS A LINE NUMBER FROM THE CURRENT TEXT POSITION.
 2501                     ;
 2502                     ; LINE NUMBERS RANGE FROM 0 TO 64000-1.
 2503                     ;
 2504                     ; THE ANSWER IS RETURNED IN "LINNUM".
 2505                     ; "TXTPTR" IS UPDATED TO POINT TO THE TERMINATING CHARCTER
 2506                     ; AND [A] = THE TERMINATING CHARACTER WITH CONDITION
 2507                     ; CODES SET UP TO REFLECT ITS VALUE.
 2508                     ;
 2509  D882  A2 00        LINGET: LDXI	0
 2510  D884  86 53        	STX	LINNUM		;INITIALIZE LINE NUMBER TO ZERO.
 2511  D886  86 54        	STX	LINNUM+1
 2512  D888  B0 F7        MORLIN: BCS	ONGRTS		;IT IS NOT A DIGIT.
 2513  D88A  E9 2F        	SBCI	"0"-1		;-1 SINCE C=0.
 2514  D88C  85 0D        	STA	CHARAC		;SAVE CHARACTER.
 2515  D88E  A5 54        	LDA	LINNUM+1
 2516  D890  85 61        	STA	INDEX
 2517  D892  C9 19        	CMPI	25		;LINE NUMBER WILL BE .LT. 64000?
 2518  D894  B0 D4        	BCS	SNERR3
 2519  D896  A5 53        	LDA	LINNUM
 2520  D898  0A           	ASL	A,		;MULTIPLY BY 10.
 2521  D899  26 61        	ROL	INDEX
 2522  D89B  0A           	ASL	A
 2523  D89C  26 61        	ROL	INDEX
 2524  D89E  65 53        	ADC	LINNUM
