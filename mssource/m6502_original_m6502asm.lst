 6305                     	;COMPUTE:
 6306                     	; C0+C1*X+C2*X^2+C3*X^3+C4*X^4+...+C(N-1)*X^(N-1)+C(N)*X^N.
 6307  EDEC  85 B0 84 B1  POLY:	STWD	POLYPT
