 2487  D878  D0 91        	BNE	SNERR2
 2488  D87A  C6 A4        ONGLOP: DEC	FACLO
 2489  D87C  D0 04        	BNE	ONGLP1		;SKIP ANOTHER LINE NUMBER.
 2490  D87E  68           	PLA			;GET DISPATCH CHARACTER.
 2491  D87F  4C AD D6     	JMP	GONE2
 2492  D882  20 B2 00     ONGLP1: JSR	CHRGET		;ADVANCE AND SET CODES.
 2493  D885  20 8E D8     	JSR	LINGET
 2494  D888  C9 2C        	CMPI	44		;IS IT A COMMA?
 2495  D88A  F0 EE        	BEQ	ONGLOP
 2496  D88C  68           	PLA			;REMOVE STACK ENTRY (TOKEN).
