 3036  DB0F  F0 03 4C 1A  	JNE	TRMNOK
       DB13  DA
 3037  DB14  A5 B9 A4 BA  TRMOK:	LDWD	TXTPTR
 3038  DB18  85 82 84 83  	STWD	INPPTR		;SAVE FOR MORE READS.
 3039  DB1C  A5 8A A4 8B  	LDWD	VARTXT
 3040  DB20  85 B9 84 BA  	STWD	TXTPTR		;POINT TO VARIABLE LIST.
 3041  DB24  20 B8 00     	JSR	CHRGOT		;LOOK AT LAST VARIABLE LIST CHARACTER.
 3042  DB27  F0 2C        	BEQ	VAREND		;THAT'S THE END OF THE LIST.
 3043  DB29  20 57 DD     	JSR	CHKCOM		;NOT END. CHECK FOR COMMA.
 3044  DB2C  4C 8E DA     	JMP	INLOOP
 3045                     ;
 3046                     ; SUBROUTINE TO FIND DATA
 3047                     ; THE SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO
 3048                     ; SKIP OVER STATEMENTS. THE START WORD OF EACH STATEMENT
 3049                     ; IS COMPARED WITH "DATATK". EACH NEW LINE NUMBER
 3050                     ; IS STORED IN "DATLIN" SO THAT IF AN ERROR OCCURS
 3051                     ; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE
 3052                     ; NUMBER OF THE ILL-FORMATTED DATA.
 3053                     ;
 3054  DB2F  20 29 D8     DATLOP: JSR	DATAN		;SKIP SOME TEXT.
 3055  DB32  C8           	INY
 3056  DB33  AA           	TAX			;END OF LINE?
 3057  DB34  D0 12        	BNE	NOWLIN		;SHO AIN'T.
 3058  DB36  A2 2A        	LDXI	ERROD		;YES = "NO DATA" ERROR.
 3059  DB38  C8           	INY
 3060  DB39  B1 B9        	LDADY	TXTPTR
 3061  DB3B  F0 69        	BEQ	ERRGO5
 3062  DB3D  C8           	INY
 3063  DB3E  B1 B9        	LDADY	TXTPTR		;GET HIGH BYTE OF LINE NUMBER.
 3064  DB40  85 7E        	STA	DATLIN
 3065  DB42  C8           	INY
 3066  DB43  B1 B9        	LDADY	TXTPTR		;GET LOW BYTE.
 3067  DB45  C8           	INY
 3068  DB46  85 7F        	STA	DATLIN+1
 3069  DB48  B1 B9        NOWLIN: LDADY	TXTPTR		;HOW IS IT?
 3070  DB4A  AA           	TAX
 3071  DB4B  20 1E D8     	JSR	ADDON		;ADD [Y] TO [TXTPTR].
 3072  DB4E  E0 83        	CPXI	DATATK		;IS IT A "DATA" STATEMENT.
 3073  DB50  D0 DD        	BNE	DATLOP		;NOT QUITE RIGHT. KEEP LOOKING.
 3074  DB52  4C C8 DA     	JMP	DATBK1		;THIS IS THE ONE !
 3075  DB55  A5 82 A4 83  VAREND: LDWD	INPPTR		;PUT AWAY A NEW DATA PNTR MAYBE.
 3076  DB59  A6 15        	LDX	INPFLG
 3077  DB5B  10 03        	BPL	VARY0
 3078  DB5D  4C E5 D6     	JMP	RESFIN
 3079  DB60  A0 00        VARY0:	LDYI	0
 3080  DB62  B1 82        	LDADY	INPPTR		;LAST DATA CHR COULD HAVE BEEN
 3081                     				;COMMA OR COLON BUT SHOULD BE NULL.
 3082  DB64  F0 07        	BEQ	INPRTS		;IT IS NULL.
 3083                     IFN	EXTIO,<
                          	LDA	CHANNL		;IF NOT TERMINAL, NO TYPE.
                          	BNE	INPRTS>
 3086  DB66  A9 6E A0 DB  	LDWDI	EXIGNT
 3087  DB6A  4C D9 D9     	JMP	STROUT		;TYPE "?EXTRA IGNORED"
 3088  DB6D  60           INPRTS: RTS			;DO NEXT STATEMENT.
 3089  DB6E  3F 45 58 54  EXIGNT: DT"?EXTRA IGNORED"
       DB72  52 41 20 49
       DB76  47 4E 4F 52
       DB7A  45 44
 3090  DB7C  0D 0A        	ACRLF
 3091  DB7E  00           	0
 3092  DB7F  3F 52 45 44  TRYAGN: DT"?REDO FROM START"
       DB83  4F 20 46 52
       DB87  4F 4D 20 53
       DB8B  54 41 52 54
 3093  DB8F  0D 0A        	ACRLF
 3094  DB91  00           	0
 3095                     PAGE
 3096                     SUBTTL	THE NEXT CODE IS THE "NEXT CODE"
 3097                     ;
 3098                     ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 3099                     ;
 3100                     ; LOW ADDRESS
 3101                     ;	TOKEN (FORTK) 1 BYTE
 3102                     ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
 3103                     ;	THE STEP 4+ADDPRC BYTES
 3104                     ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 3105                     ;	THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
 3106                     ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 3107                     ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 3108                     ; HIGH ADDRESS
 3109                     ;
 3110                     ; TOTAL 16+2*ADDPRC BYTES.
 3111                     ;
 3112  DB92  D0 04        NEXT:	BNE	GETFOR
 3113  DB94  A0 00        	LDYI	0		;WITHOUT ARG CALL "FNDFOR" WITH
 3114  DB96  F0 03        	BEQA	STXFOR		;[FORPNT]=0.
 3115  DB98  20 76 DE     GETFOR: JSR	PTRGET		;GET A POINTER TO LOOP VARIABLE
 3116  DB9B  85 88 84 89  STXFOR: STWD	FORPNT		;INTO "FORPNT".
 3117  DB9F  20 70 D2     	JSR	FNDFOR		;FIND THE MATCHING ENTRY IF ANY.
 3118  DBA2  F0 04        	BEQ	HAVFOR
 3119  DBA4  A2 00        	LDXI	ERRNF		;"NEXT WITHOUT FOR".
 3120  DBA6  F0 66        ERRGO5: BEQ	ERRGO4
 3121  DBA8  9A           HAVFOR: TXS			;SETUP STACK. CHOP FIRST.
 3122  DBA9  8A           	TXA
 3123  DBAA  18           	CLC
 3124  DBAB  69 04        	ADCI	4		;POINT TO INCREMENT
 3125  DBAD  48           	PHA			;SAVE THIS POINTER TO RESTORE TO [A]
 3126  DBAE  69 06        	ADCI	5+ADDPRC	;POINT TO UPPER LIMIT
 3127  DBB0  85 63        	STA	INDEX2		;SAVE AS INDEX
 3128  DBB2  68           	PLA			;RESTORE POINTER TO INCREMENT
 3129  DBB3  A0 01        	LDYI	1		;SET HI ADDR OF THING TO MOVE.
 3130  DBB5  20 73 E9     	JSR	MOVFM		;GET QUANTITY INTO THE FAC.
 3131  DBB8  BA           	TSX
 3132  DBB9  BD 09 01     	LDA	257+7+ADDPRC,X, ;SET SIGN CORRECTLY.
 3133  DBBC  85 A5        	STA	FACSGN
 3134  DBBE  A5 88 A4 89  	LDWD	FORPNT
 3135  DBC2  20 38 E6     	JSR	FADD		;ADD INC TO LOOP VARIABLE.
 3136  DBC5  20 A1 E9     	JSR	MOVVF		;PACK THE FAC INTO MEMORY.
 3137  DBC8  A0 01        	LDYI	1
 3138  DBCA  20 2E EA     	JSR	FCOMPN		;COMPARE FAC WITH UPPER VALUE.
 3139  DBCD  BA           	TSX
 3140  DBCE  38           	SEC
 3141  DBCF  FD 09 01     	SBC	257+7+ADDPRC,X, ;SUBTRACT SIGN OF INC FROM SIGN OF
 3142                     				;OF (CURRENT VALUE-FINAL VALUE).
 3143  DBD2  F0 17        	BEQ	LOOPDN		;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
 3144                     				;THEN LOOP IS DONE.
 3145  DBD4  BD 0F 01     	LDA	2*ADDPRC+12+257,X
 3146  DBD7  85 78        	STA	CURLIN		;STORE LINE NUMBER OF "FOR" STATEMENT.
 3147  DBD9  BD 10 01     	LDA	257+13+<2*ADDPRC>,X
 3148  DBDC  85 79        	STA	CURLIN+1
 3149  DBDE  BD 12 01     	LDA	2*ADDPRC+15+257,X
 3150  DBE1  85 B9        	STA	TXTPTR		;STORE TEXT PNTR INTO "FOR" STATEMENT.
 3151  DBE3  BD 11 01     	LDA	2*ADDPRC+14+257,X
 3152  DBE6  85 BA        	STA	TXTPTR+1
 3153  DBE8  4C 70 D6     NEWSGO: JMP	NEWSTT		;PROCESS NEXT STATEMENT.
 3154  DBEB  8A           LOOPDN: TXA
 3155  DBEC  69 11        	ADCI	2*ADDPRC+15		;ADDS 16 WITH CARRY.
 3156  DBEE  AA           	TAX
 3157  DBEF  9A           	TXS			;NEW STACK PNTR.
 3158  DBF0  20 B8 00     	JSR	CHRGOT
 3159  DBF3  C9 2C        	CMPI	44		;COMMA AT END?
 3160  DBF5  D0 F1        	BNE	NEWSGO
 3161  DBF7  20 B2 00     	JSR	CHRGET
 3162  DBFA  20 98 DB     	JSR	GETFOR		;DO NEXT BUT DON'T ALLOW BLANK VARIABLE
 3163                     				;PNTR. [VARPNT] IS THE STK PNTR WHICH
 3164                     				;NEVER MATCHES ANY POINTER.
 3165                     				;JSR TO PUT ON DUMMY NEWSTT ADDR.
 3166                     SUBTTL FORMULA EVALUATION CODE.
 3167                     ;
 3168                     ; THESE ROUTINES CHECK FOR CERTAIN "VALTYP".
 3169                     ; [C] IS NOT PRESERVED.
 3170                     ;
 3171  DBFD  20 11 DC     FRMNUM: JSR	FRMEVL
 3172  DC00  18           CHKNUM: CLC
 3173  DC01  24           	SKIP1
 3174  DC02  38           CHKSTR: SEC			;SET CARRY.
 3175  DC03  24 11        CHKVAL: BIT	VALTYP		;WILL NOT F UP "VALTYP".
 3176  DC05  30 03        	BMI	DOCSTR
 3177  DC07  B0 03        	BCS	CHKERR
 3178  DC09  60           CHKOK:	RTS
 3179  DC0A  B0 FD        DOCSTR: BCS	CHKOK
 3180  DC0C  A2 A3        CHKERR: LDXI	ERRTM
 3181  DC0E  4C 1D D3     ERRGO4: JMP	ERROR
 3182                     ;
 3183                     ; THE FORMULA EVALUATOR STARTS WITH
 3184                     ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
 3185                     ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
 3186                     ; THE RESULT IS LEFT IN THE FAC.
 3187                     ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
 3188                     ;
 3189                     ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
 3190                     ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR
 3191                     ; EACH OPERATOR.
 3192                     ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
 3193                     ;	THE ADDRESS OF THE OPERATOR ROUTINE.
 3194                     ;	THE FLOATING POINT TEMPORARY RESULT.
 3195                     ;	THE PRECEDENCE OF THE OPERATOR.
 3196                     ;
 3197  DC11  A6 B9        FRMEVL: LDX	TXTPTR
 3198  DC13  D0 02        	BNE	FRMEV1
 3199  DC15  C6 BA        	DEC	TXTPTR+1
 3200  DC17  C6 B9        FRMEV1: DEC	TXTPTR
 3201  DC19  A2 00        	LDXI	0		;INITIAL DUMMY PRECEDENCE IS 0.
 3202  DC1B  24           	SKIP1
 3203  DC1C  48           LPOPER: PHA			;SAVE LOW PRECEDENCE. (MASK.)
 3204  DC1D  8A           	TXA
 3205  DC1E  48           	PHA			;SAVE HIGH PRECEDENCE.
 3206  DC1F  A9 01        	LDAI	1
 3207  DC21  20 E1 D2     	JSR	GETSTK		;MAKE SURE THERE IS ROOM FOR
 3208                     				;RECURSIVE CALLS.
 3209  DC24  20 F6 DC     	JSR	EVAL		;EVALUATE SOMETHING.
 3210  DC27  A9 00 85 8C  	CLR	OPMASK		;PREPARE TO BUILD MASK MAYBE.
 3211  DC2B  20 B8 00     TSTOP:	JSR	CHRGOT		;REGET LAST CHARACTER.
 3212  DC2E  38           LOPREL: SEC			;PREP TO SUBTRACT.
 3213  DC2F  E9 AA        	SBCI	GREATK		;IS CURRENT CHARACTER A RELATION?
 3214  DC31  90 17        	BCC	ENDREL		;NO. RELATIONS ALL THROUGH.
 3215  DC33  C9 03        	CMPI	LESSTK-GREATK+1 ;REALLY RELATIONAL?
 3216  DC35  B0 13        	BCS	ENDREL		;NO -- JUST BIG.
 3217  DC37  C9 01        	CMPI	1		;RESET CARRY FOR ZERO ONLY.
 3218  DC39  2A           	ROL	A,		;0 TO 1, 1 TO 2, 2 TO 4.
 3219  DC3A  49 01        	EORI	1
 3220  DC3C  45 8C        	EOR	OPMASK		;BRING IN THE OLD BITS.
 3221  DC3E  C5 8C        	CMP	OPMASK		;MAKE SURE THE NEW MASK IS BIGGER.
 3222  DC40  90 61        	BCC	SNERR5		;SYNTAX ERROR. BECAUSE TWO OF THE SAME.
 3223  DC42  85 8C        	STA	OPMASK		;SAVE MASK.
 3224  DC44  20 B2 00     	JSR	CHRGET
 3225  DC47  4C 2E DC     	JMP	LOPREL		;GET THE NEXT CANDIDATE.
 3226  DC4A  A6 8C        ENDREL: LDX	OPMASK		;WERE THERE ANY?
 3227  DC4C  D0 2C        	BNE	FINREL		;YES, HANDLE AS SPECIAL OP.
 3228  DC4E  B0 7B        	BCS	QOP		;NOT AN OPERATOR.
 3229  DC50  69 07        	ADCI	GREATK-PLUSTK
 3230  DC52  90 77        	BCC	QOP		;NOT AN OPERATOR.
 3231  DC54  65 11        	ADC	VALTYP		;[C]=1.
 3232  DC56  D0 03 4C 0D  	JEQ	CAT		;ONLY IF [A]=0 AND [VALTYP]=-1 (A STR).
       DC5A  E4
 3233  DC5B  69 FF        	ADCI	^O377		;GET BACK ORIGINAL [A].
 3234  DC5D  85 61        	STA	INDEX1
 3235  DC5F  0A           	ASL	A,		;MULTIPLY BY 2.
 3236  DC60  65 61        	ADC	INDEX1		;BY THREE.
 3237  DC62  A8           	TAY			;SET UP FOR LATER.
 3238  DC63  68           QPREC:	PLA			;GET PREVIOUS PRECEDENCE.
 3239  DC64  D9 66 D0     	CMP	OPTAB,Y		;IS OLD PRECEDENCE GREATER OR EQUAL?
 3240  DC67  B0 67        	BCS	QCHNUM		;YES, GO OPERATE.
 3241  DC69  20 00 DC     	JSR	CHKNUM		;CAN'T BE STRING HERE.
 3242  DC6C  48           DOPREC: PHA			;SAVE OLD PRECEDENCE.
 3243  DC6D  20 93 DC     NEGPRC: JSR	DOPRE1		;SET A RETURN ADDRESS FOR OP.
 3244  DC70  68           	PLA			;PULL OFF PREVIOUS PRECEDENCE.
 3245  DC71  A4 8A        	LDY	OPPTR		;GET POINTER TO OP.
 3246  DC73  10 17        	BPL	QPREC1		;THAT'S A REAL OPERATOR.
 3247  DC75  AA           	TAX			;DONE ?
 3248  DC76  F0 56        	BEQ	QOPGO		;DONE !
 3249  DC78  D0 5F        	BNE	PULSTK
 3250  DC7A  46 11        FINREL: LSR	VALTYP		;GET VALUE TYPE INTO "C".
 3251  DC7C  8A           	TXA
 3252  DC7D  2A           	ROL	A,		;PUT VALTYP INTO LOW ORDER BIT OF MASK.
 3253  DC7E  A6 B9        	LDX	TXTPTR		;DECREMENT TEXT POINTER.
 3254  DC80  D0 02        	BNE	FINRE2
 3255  DC82  C6 BA        	DEC	TXTPTR+1
 3256  DC84  C6 B9        FINRE2: DEC	TXTPTR
 3257  DC86  A0 1B        	LDYI	PTDORL-OPTAB	;MAKE [YREG] POINT AT OPERATOR ENTRY.
 3258  DC88  85 8C        	STA	OPMASK		;SAVE THE OPERATION MASK.
 3259  DC8A  D0 D7        	BNE	QPREC		;SAVE IT ALL. BR ALWAYS.
 3260                     				;NOTE B7(VALTYP)=0 SO CHKNUM CALL IS OK.
 3261  DC8C  D9 66 D0     QPREC1: CMP	OPTAB,Y		;LAST PRECEDENCE IS GREATER?
 3262  DC8F  B0 48        	BCS	PULSTK		;YES, GO OPERATE.
 3263  DC91  90 D9        	BCC	DOPREC		;NO SAVE ARGUMENT AND GET OTHER OPERAND.
 3264  DC93  B9 68 D0     DOPRE1: LDA	OPTAB+2,Y
 3265  DC96  48           	PHA			;DISP ADDR GOES ONTO STACK.
 3266  DC97  B9 67 D0     	LDA	OPTAB+1,Y
 3267  DC9A  48           	PHA
 3268  DC9B  20 A6 DC     	JSR	PUSHF1		;SAVE FAC ON STACK UNPACKED.
 3269  DC9E  A5 8C        	LDA	OPMASK		;[ACCA] MAY BE MASK FOR REL.
 3270  DCA0  4C 1C DC     	JMP	LPOPER
 3271  DCA3  4C 62 DD     SNERR5: JMP	SNERR		;GO TO AN ERROR.
 3272  DCA6  A5 A5        PUSHF1: LDA	FACSGN
 3273  DCA8  BE 66 D0     	LDX	OPTAB,Y,	;GET HIGH PRECEDENCE.
 3274  DCAB  A8           PUSHF:	TAY			;GET POINTER INTO STACK.
 3275  DCAC  68           	PLA
 3276  DCAD  85 61        	STA	INDEX1
 3277  DCAF  E6 61        	INC	INDEX1
