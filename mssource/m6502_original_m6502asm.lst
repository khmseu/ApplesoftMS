 1537  D328  48           	PHA
 1538  D329  29 7F        	ANDI	127		;GET RID OF HIGH BIT.
 1539  D32B  20 FB D9     	JSR	OUTDO		;OUTPUT IT.
 1540  D32E  E8           	INX
 1541  D32F  68           	PLA			;LAST CHAR OF MESSAGE?
 1542  D330  10 F3        	BPL	GETERR
 1543  D332  20 53 D5     TYPERR: JSR	STKINI		;RESET THE STACK AND FLAGS.
 1544  D335  A9 55 A0 D2  	LDWDI	ERR		;GET PNTR TO " ERROR".
 1545  D339  20 D9 D9     ERRFIN: JSR	STROUT		;OUTPUT IT.
 1546  D33C  A4 79        	LDY	CURLIN+1
 1547  D33E  C8           	INY			;WAS NUMBER 64000?
 1548  D33F  F0 03        	BEQ	READY		;YES, DON'T TYPE LINE NUMBER.
 1549  D341  20 93 EB     	JSR	INPRT
