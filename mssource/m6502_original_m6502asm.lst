 1591  D389  AA           	TAX
 1592  D38A  38           	SEC
 1593  D38B  A5 9E        	LDA	LOWTR
 1594  D38D  E5 6C        	SBC	VARTAB		;COMPUTE OFFSET.
 1595  D38F  A8           	TAY
