 4576                     ;
 4577                     ; "FRETMP" IS PASSED A STRING DESCRIPTOR PNTR IN [Y,A].
 4578                     ; A CHECK IS MADE TO SEE IF THE STRING DESCRIPTOR POINTS TO THE LAST
 4579                     ; TEMPORARY DESCRIPTOR ALLOCATED BY PUTNEW.
 4580                     ; IF SO, THE TEMPORARY IS FREED UP BY THE UPDATING OF [TEMPPT].
 4581                     ; IF A TEMP IS FREED UP, A FURTHER CHECK SEES IF THE STRING DATA THAT
 4582                     ; THAT STRING TEMP PNT'D TO IS THE LOWEST PART OF STRING SPACE IN USE.
 4583                     ; IF SO, [FRETOP] IS UPDATED TO REFLECT THE FACT THE FACT THAT THE SPACE
 4584                     ; IS NO LONGER IN USE.
 4585                     ; THE ADDR OF THE ACTUAL STRING IS RETURNED IN [Y,X] AND
 4586                     ; ITS LENGTH IN ACCA.
 4587                     ;
 4588  1B98  20 27 13     FRESTR: JSR	CHKSTR		;MAKE SURE ITS A STRING.
 4589  1B9B  A5 A3 A4 A4  FREFAC: LDWD	FACMO		;FREE UP STR PNT'D TO BY FAC.
 4590  1B9F  85 61 84 62  FRETMP: STWD	INDEX		;GET LENGTH FOR LATER.
 4591  1BA3  20 D0 1B     	JSR	FRETMS		;FREE UP THE TEMPORARY DESC.
 4592  1BA6  08           	PHP			;SAVE CODES.
 4593  1BA7  A0 00        	LDYI	0		;PREP TO GET STUFF.
 4594  1BA9  B1 61        	LDADY	INDEX		;GET COUNT AND
 4595  1BAB  48           	PHA			;SAVE IT.
 4596  1BAC  C8           	INY
 4597  1BAD  B1 61        	LDADY	INDEX
 4598  1BAF  AA           	TAX			;SAVE LOW ORDER.
 4599  1BB0  C8           	INY
 4600  1BB1  B1 61        	LDADY	INDEX
 4601  1BB3  A8           	TAY			;SAVE HIGH ORDER.
 4602  1BB4  68           	PLA
 4603  1BB5  28           	PLP			;RETURN STATUS.
 4604  1BB6  D0 13        	BNE	FRETRT
 4605  1BB8  C4 73        	CPY	FRETOP+1	;STRING IS LAST ONE IN?
 4606  1BBA  D0 0F        	BNE	FRETRT
 4607  1BBC  E4 72        	CPX	FRETOP
 4608  1BBE  D0 0B        	BNE	FRETRT
 4609  1BC0  48           	PHA
 4610  1BC1  18           	CLC
 4611  1BC2  65 72        	ADC	FRETOP
 4612  1BC4  85 72        	STA	FRETOP
