                          	BEQ	OKCHAR		;SAVE ALL BUT ATN.
                          	CMPI	"N"
                          	BNE	ASKAGN		;BAD INPUT.
                          				;SAVE NOTHING.
                          OKCHAR: LDXYI	FCERR
                          	STXY	ATNFIX		;GET RID OF ATN FUNCTION.
                          	LDXYI	ATN		;UNTIL WE KNOW THAT WE SHOULD DEL MORE.
                          	CMPI	"A"
                          	BEQ	HAVFNS		;JUST GET RID OF ATN.
                          	LDXYI	FCERR
                          	STXY	COSFIX		;GET RID OF THE REST.
                          	STXY	TANFIX
                          	STXY	SINFIX
