 1521  D31D  46 17        	LSR	CNTWFL
 1522                     IFN	EXTIO,<
                          	LDA	CHANNL		;CLOSE NON-TERMINAL CHANNEL.
                          	BEQ	ERRCRD
                          	JSR	CQCCHN		;CLOSE IT.
                          	LDAI	0
                          	STA	CHANNL>
