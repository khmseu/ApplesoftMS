  944                     PAGE
  945                     SUBTTL	RAM CODE.
  946                     ; THIS CODE GETS CHANGED THROUGHOUT EXECUTION.
  947                     ; IT IS MADE TO BE FAST THIS WAY.
  948                     ; ALSO, [X] AND [Y] ARE NOT DISTURBED
  949                     ;
  950                     ; "CHRGET" USING [TXTPTR] AS THE CURRENT TEXT PNTR
  951                     ; FETCHES A NEW CHARACTER INTO ACCA AFTER INCREMENTING [TXTPTR]
  952                     ; AND SETS CONDITION CODES ACCORDING TO WHAT'S IN ACCA.
  953                     ;	NOT C=	NUMERIC	  ("0" THRU "9")
  954                     ;	Z=	":" OR END-OF-LINE (A NULL)
  955                     ;
  956                     ; [ACCA] = NEW CHAR.
  957                     ; [TXTPTR]=[TXTPTR]+1
  958                     ;
  959                     ; THE FOLLOWING EXISTS IN ROM IF ROM EXISTS AND IS LOADED
  960                     ; DOWN HERE BY INIT. OTHERWISE IT IS JUST LOADED INTO THIS
  961                     ; RAM LIKE ALL THE REST OF RAM IS LOADED.
  962                     ;
  963  00B2  E6 B9        CHRGET: INC	CHRGET+7	;INCREMENT THE WHOLE TXTPTR.
  964  00B4  D0 02        	BNE	CHRGOT
  965  00B6  E6 BA        	INC	CHRGET+8
  966  00B8  AD 60 EA     CHRGOT: LDA	60000		;A LOAD WITH AN EXT ADDR.
  967  00B9               TXTPTR= CHRGOT+1
  968  00BB  C9 20        	CMPI	" "		;SKIP SPACES.
  969  00BD  F0 F3        	BEQ	CHRGET
  970  00BF  C9 3A        QNUM:	CMPI	":"		;IS IT A ":"?
  971  00C1  B0 06        	BCS	CHRRTS		;IT IS .GE. ":"
  972  00C3  38           	SEC
  973  00C4  E9 30        	SBCI	"0"		;ALL CHARS .GT. "9" HAVE RET'D SO
  974  00C6  38           	SEC
  975  00C7  E9 D0        	SBCI	256-"0"		;SEE IF NUMERIC.
  976                     				;TURN CARRY ON IF NUMERIC.
  977                     				;ALSO, SETZ IF NULL.
  978  00C9  60           CHRRTS: RTS			;RETURN TO CALLER.
  980  00CA  80           RNDX:	128			;LOADED OR FROM ROM.
  981  00CB  4F           	79			;THE INITIAL RANDOM NUMBER.
  982  00CC  C7           	199
  983  00CD  52           	82
  984                     IFN	ADDPRC,<89>		;ONE MORE BYTE.
  984  00CE  59           89
  986  00CF               ORG	255			;PAGE 1 STUFF COMING UP.
  987  00FF               LOFBUF: BLOCK	1		;THE LOW FAC BUFFER. COPYABLE.
  988                     ;---  PAGE ZERO/ONE BOUNDARY ---.
  989                     				;MUST HAVE 13 CONTIGUOUS BYTES.
  990  0100               FBUFFR: BLOCK	3*ADDPRC+13	;BUFFER FOR "FOUT".
  991                     				;ON PAGE 1 SO THAT STRING IS NOT COPIED.
  993                     ;STACK IS LOCATED HERE. IE FROM THE END OF FBUFFR TO STKEND.
