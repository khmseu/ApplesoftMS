 4282  E262  F0 04        	BEQ	STRFIN		;YES.
 4283  E264  C5 0E        	CMP	ENDCHR
 4284  E266  D0 F3        	BNE	STRGET		;LOOK FURTHER.
 4285  E268  C9 22        STRFIN: CMPI	34		;QUOTE?
 4286  E26A  F0 01        	BEQ	STRFI2
