 2115  D636  A9 41 A0 D6  	LDWDI	LDFONE
 2116  D63A  85 61 84 62  	STWD	INDEX1
 2117  D63E  4C AA DC     	JMP	FORPSH		;PUT FAC ONTO STACK, PACKED.
 2118  D641  A9 81 A0 E7  LDFONE: LDWDI	FONE		;PUT 1.0 INTO FAC.
 2119  D645  20 67 E9     	JSR	MOVFM
