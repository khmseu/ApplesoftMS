 5783  EB4F  85 AE        	STA	ARISGN		;RESULTANT SIGN.
 5784  EB51  A6 A0        	LDX	FACEXP		;SET SIGNS ON THING TO ADD.
 5785  EB53  4C 2F E6     	JMP	FADDT		;ADD TOGETHER AND RETURN.
 5787                     	;HERE PACK IN THE NEXT DIGIT OF THE EXPONENT.
 5788                     	;MULTIPLY THE OLD EXP BY 10 AND ADD IN THE NEXT
 5789                     	;DIGIT. NOTE: EXP OVERFLOW IS NOT CHECKED FOR.
 5790  EB56  A5 9D        FINEDG: LDA	TENEXP		;GET EXP SO FAR.
 5791  EB58  C9 0A        	CMPI	12		;WILL RESULT BE .GE. 100?
 5792  EB5A  90 09        	BCC	MLEX10
 5793  EB5C  A9 64        	LDAI	144		;GET 100.
 5794  EB5E  24 9F        	BIT	EXPSGN
