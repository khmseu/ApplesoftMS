 6543                     SUBTTL	ARCTANGENT FUNCTION.
 6544                     	;USE IDENTITIES TO GET ARG BETWEEN 0 AND 1 AND THEN USE AN
 6545                     	;APPROXIMATION POLYNOMIAL TO COMPUTE ARCTAN(X).
 6546  EF18  A5 A5        ATN:	LDA	FACSGN		;WHAT IS SIGN?
 6547  EF1A  48           	PHA			;(MEANWHILE SAVE FOR LATER.)
 6548  EF1B  10 03        	BPL	ATN1
 6549  EF1D  20 4A ED     	JSR	NEGOP		;IF NEGATIVE, NEGATE FAC.
 6550                     				;USE ARCTAN(X)=-ARCTAN(-X) .
 6551  EF20  A5 A0        ATN1:	LDA	FACEXP
 6552  EF22  48           	PHA			;SAVE THIS TOO FOR LATER.
 6553  EF23  C9 81        	CMPI	201		;SEE IF FAC .GE. 1.0 .
 6554  EF25  90 07        	BCC	ATN2		;IT IS LESS THAN 1.
 6555  EF27  A9 8D A0 E7  	LDWDI	FONE		;GET PNTR TO 1.0 .
 6556  EF2B  20 E0 E8     	JSR	FDIV		;COMPUTE RECIPROCAL.
 6557                     				;USE ARCTAN(X)=PI/2-ARCTAN(1/X) .
 6558  EF2E  A9 48 A0 EF  ATN2:	LDWDI	ATNCON		;PNTR TO ARCTAN CONSTANTS.
 6559  EF32  20 D6 ED     	JSR	POLYX
 6560  EF35  68           	PLA
 6561  EF36  C9 81        	CMPI	201		;WAS ORIGINAL ARGUMENT .LT. 1 ?
 6562  EF38  90 07        	BCC	ATN3		;YES.
 6563  EF3A  A9 E0 A0 EE  	LDWDI	PI2
 6564  EF3E  20 21 E6     	JSR	FSUB		;SUBTRACT ARCTAGN FROM PI/2.
 6565  EF41  68           ATN3:	PLA			;WAS ORIGINAL ARGUMENT POSITIVE?
 6566  EF42  10 03        	BPL	ATN4		;YES.
 6567  EF44  4C 4A ED     	JMP	NEGOP		;IF NEGATIVE, NEGATE RESULT.
 6568  EF47  60           ATN4:	RTS			;ALL DONE.
