 5750  2242  85 9D        	STA	TENEXP
 5751  2244  F0 12        	BEQ	FINQNG		;NEGATE?
 5752  2246  10 09        	BPL	FINMUL		;POSITIVE SO MULTIPLY.
 5753  2248  20 F4 1F     FINDIV: JSR	DIV10
 5754  224B  E6 9D        	INC	TENEXP		;DONE?
 5755  224D  D0 F9        	BNE	FINDIV		;NO.
