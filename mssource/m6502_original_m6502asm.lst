 2949  DA7C  4C 2A D4     GINLIN: JMP	INLIN
 2950  DA7F  A6 80 A4 81  READ:	LDXY	DATPTR		;GET LAST DATA LOCATION.
 2951  DA83  A9           	XWD	^O1000,^O251	;LDAI TYA TO MAKE IT NONZERO.
 2952                     IFE	BUFPAG,<
                          INPCON: >
 2954  DA84  98           	TYA
 2955                     IFN	BUFPAG,<
 2956  DA85  2C           	SKIP2
 2957  DA86  A9 00        INPCON: LDAI	0
 2958  DA88  85 15        INPCO1: STA	INPFLG		;STORE THE FLAG.
 2959                     ;
 2960                     ; IN THE PROCESSING OF DATA AND READ STATEMENTS:
 2961                     ; ONE POINTER POINTS TO THE DATA (IE, THE NUMBERS BEING FETCHED)
 2962                     ; AND ANOTHER POINTS TO THE LIST OF VARIABLES.
 2963                     ;
 2964                     ; THE POINTER INTO THE DATA ALWAYS STARTS POINTING TO A
 2965                     ; TERMINATOR -- A , : OR END-OF-LINE.
 2966                     ;
 2967                     ; AT THIS POINT TXTPTR POINTS TO LIST OF VARIABLES AND
 2968                     ; [Y,X] POINTS TO DATA OR INPUT LINE.
 2969                     ;
 2970  DA8A  86 82 84 83  	STXY	INPPTR
 2971  DA8E  20 76 DE     INLOOP: JSR	PTRGET		;READ VARIABLE LIST.
 2972  DA91  85 88 84 89  	STWD	FORPNT		;SAVE POINTER FOR "LET" STRING STUFFING.
 2973                     				;RETURNS PNTR TOP VAR IN VARPNT.
 2974  DA95  A5 B9 A4 BA  	LDWD	TXTPTR		;SAVE TEXT PNTR.
 2975  DA99  85 8A 84 8B  	STWD	VARTXT
 2976  DA9D  A6 82 A4 83  	LDXY	INPPTR
 2977  DAA1  86 B9 84 BA  	STXY	TXTPTR
 2978  DAA5  20 B8 00     	JSR	CHRGOT		;GET IT AND SET Z IF TERM.
 2979  DAA8  D0 1E        	BNE	DATBK1
 2980  DAAA  24 15        	BIT	INPFLG
 2981                     IFN	GETCMD,<
 2982  DAAC  50 0E        	BVC	QDATA
