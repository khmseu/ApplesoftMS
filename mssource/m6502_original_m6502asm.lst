 5695                     SUBTTL	FLOATING POINT INPUT ROUTINE.
 5696                     	;NUMBER INPUT IS LEFT IN FAC.
 5697                     	;AT ENTRY [TXTPTR] POINTS TO THE FIRST CHARACTER IN A TEXT BUFFER.
 5698                     	;THE FIRST CHARACTER IS ALSO IN ACCA. FIN PACKS THE DIGITS
 5699                     	;INTO THE FAC AS AN INTEGER AND KEEPS TRACK OF WHERE THE
 5700                     	;DECIMAL POINT IS. [DPTFLG] TELL WHETHER A DP HAS BEEN
 5701                     	;SEEN. [DECCNT] IS THE NUMBER OF DIGITS AFTER THE DP.
 5702                     	;AT THE END [DECCNT] AND THE EXPONENT ARE USED TO
 5703                     	;DETERMINE HOW MANY TIMES TO MULTIPLY OR DIVIDE BY TEN
 5704                     	;TO GET THE CORRECT NUMBER.
 5705  EAB8  A0 00        FIN:	LDYI	0		;ZERO FACSGN&SGNFLG.
 5706  EABA  A2 0A        	LDXI	11+ADDPRC	;ZERO EXP AND HO (AND MOH).
 5707  EABC  94 9C        FINZLP: STY	DECCNT,X	;ZERO MO AND LO.
 5708  EABE  CA           	DEX			;ZERO TENEXP AND EXPSGN
 5709  EABF  10 FB        	BPL	FINZLP		;ZERO DECCNT, DPTFLG.
 5710  EAC1  90 0F        	BCC	FINDGQ		;FLAGS STILL SET FROM CHRGET.
 5711  EAC3  C9 2D        	CMPI	"-"		;A NEGATIVE SIGN?
 5712  EAC5  D0 04        	BNE	QPLUS		;NO, TRY PLUS SIGN.
 5713  EAC7  86 A6        	STX	SGNFLG		;IT'S NEGATIVE. (X=377).
 5714  EAC9  F0 04        	BEQ	FINC		;ALWAYS BRANCHES.
 5715  EACB  C9 2B        QPLUS:	CMPI	"+"		;PLUS SIGN?
 5716  EACD  D0 05        	BNE	FIN1		;YES, SKIP IT.
 5717  EACF  20 B2 00     FINC:	JSR	CHRGET
 5718  EAD2  90 5B        FINDGQ: BCC	FINDIG
 5719  EAD4  C9 2E        FIN1:	CMPI	"."		;THE DP?
 5720  EAD6  F0 2E        	BEQ	FINDP		;NO KIDDING.
 5721  EAD8  C9 45        	CMPI	"E"		;EXPONENT FOLLOWS.
 5722  EADA  D0 30        	BNE	FINE		;NO.
 5723                     	;HERE TO CHECK FOR SIGN OF EXP.
 5724  EADC  20 B2 00     	JSR	CHRGET		;YES. GET ANOTHER.
 5725  EADF  90 17        	BCC	FNEDG1		;IT IS A DIGIT. (EASIER THAN
 5726                     				;BACKING UP POINTER.)
 5727  EAE1  C9 A2        	CMPI	MINUTK		;MINUS?
 5728  EAE3  F0 0E        	BEQ	FINEC1		;NEGATE.
 5729  EAE5  C9 2D        	CMPI	"-"		;MINUS SIGN?
 5730  EAE7  F0 0A        	BEQ	FINEC1
