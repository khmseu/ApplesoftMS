 3270  13CB  A5 A5        PUSHF1: LDA	FACSGN
 3271  13CD  BE 62 08     	LDX	OPTAB,Y,	;GET HIGH PRECEDENCE.
 3272  13D0  A8           PUSHF:	TAY			;GET POINTER INTO STACK.
 3273  13D1  68           	PLA
