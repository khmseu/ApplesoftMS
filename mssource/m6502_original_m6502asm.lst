 4624  1BDC  85 56        	STA	LASTPT		;UPDATE TEMP PNTR.
 4625  1BDE  A0 00        	LDYI	0		;ALSO CLEARS ZFLG SO WE DO REST OF FRETMP.
 4626  1BE0  60           FRERTS: RTS			;ALL DONE.
