 4250                     ;
 4251                     ; "STRINI" GET STRING SPACE FOR THE CREATION OF A STRING AND
 4252                     ; CREATES A DESCRIPTOR FOR IT IN "DSCTMP".
 4253                     ;
 4254  E239  A6 A3 A4 A4  STRINI: LDXY	FACMO		;GET FACMO TO STORE IN DSCPNT.
 4255  E23D  86 8F 84 90  	STXY	DSCPNT		;RETAIN THE DESCRIPTOR POINTER.
 4256  E241  20 B8 E2     STRSPA: JSR	GETSPA		;GET STRING SPACE.
 4257  E244  86 A1 84 A2  	STXY	DSCTMP+1	;SAVE LOCATION.
