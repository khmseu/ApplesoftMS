                          	JSR	IODONE		;BAD. CLOSE CHANNEL.
                          	JMP	DATA		;SKIP REST OF INPUT.
                          BUFFUL:>
 2935  DA61  AD 00 02     	LDA	BUF		;ANYTHING INPUT?
 2936  DA64  D0 14        	BNE	INPCON		;YES, CONTINUE.
 2937                     IFN	EXTIO,<
                          	LDA	CHANNL		;BLANK LINE MEANS GET ANOTHER.
                          	BNE	GETAGN>		;IF NOT TERMINAL.
 2940  DA66  18           	CLC			;MAKE SURE DONT PRINT BREAK
 2941  DA67  4C FD D6     	JMP	STPEND		;NO, STOP.
 2942  DA6A               QINLIN:
 2943                     IFN	EXTIO,<
                          	LDA	CHANNL
                          	BNE	GINLIN>
 2946  DA6A  20 ED D9     	JSR	OUTQST
 2947  DA6D  20 EA D9     	JSR	OUTSPC
 2948  DA70  4C 1E D4     GINLIN: JMP	INLIN
 2949  DA73  A6 80 A4 81  READ:	LDXY	DATPTR		;GET LAST DATA LOCATION.
 2950  DA77  A9           	XWD	^O1000,^O251	;LDAI TYA TO MAKE IT NONZERO.
 2951                     IFE	BUFPAG,<
                          INPCON: >
 2953  DA78  98           	TYA
 2954                     IFN	BUFPAG,<
 2955  DA79  2C           	SKIP2
 2956  DA7A  A9 00        INPCON: LDAI	0
 2957  DA7C  85 15        INPCO1: STA	INPFLG		;STORE THE FLAG.
 2958                     ;
 2959                     ; IN THE PROCESSING OF DATA AND READ STATEMENTS:
 2960                     ; ONE POINTER POINTS TO THE DATA (IE, THE NUMBERS BEING FETCHED)
 2961                     ; AND ANOTHER POINTS TO THE LIST OF VARIABLES.
 2962                     ;
 2963                     ; THE POINTER INTO THE DATA ALWAYS STARTS POINTING TO A
 2964                     ; TERMINATOR -- A , : OR END-OF-LINE.
 2965                     ;
 2966                     ; AT THIS POINT TXTPTR POINTS TO LIST OF VARIABLES AND
 2967                     ; [Y,X] POINTS TO DATA OR INPUT LINE.
 2968                     ;
 2969  DA7E  86 82 84 83  	STXY	INPPTR
 2970  DA82  20 6A DE     INLOOP: JSR	PTRGET		;READ VARIABLE LIST.
 2971  DA85  85 88 84 89  	STWD	FORPNT		;SAVE POINTER FOR "LET" STRING STUFFING.
 2972                     				;RETURNS PNTR TOP VAR IN VARPNT.
 2973  DA89  A5 B9 A4 BA  	LDWD	TXTPTR		;SAVE TEXT PNTR.
 2974  DA8D  85 8A 84 8B  	STWD	VARTXT
 2975  DA91  A6 82 A4 83  	LDXY	INPPTR
 2976  DA95  86 B9 84 BA  	STXY	TXTPTR
 2977  DA99  20 B8 00     	JSR	CHRGOT		;GET IT AND SET Z IF TERM.
 2978  DA9C  D0 1E        	BNE	DATBK1
 2979  DA9E  24 15        	BIT	INPFLG
 2980                     IFN	GETCMD,<
 2981  DAA0  50 0E        	BVC	QDATA
