 5798  EB66  0A           	ASL	A
 5799  EB67  18           	CLC			;POSSIBLE SHIFT OUT OF HIGH.
 5800  EB68  65 9D        	ADC	TENEXP		;LIKE MULTIPLYING BY FIVE.
 5801  EB6A  0A           	ASL	A,		;AND NOW BY TEN.
 5802  EB6B  18           	CLC
 5803  EB6C  A0 00        	LDYI	0
 5804  EB6E  71 B9        	ADCDY	TXTPTR
 5805  EB70  38           	SEC
