 2987                     IFE	BUFPAG,<
                          	BEQA	DATBK>
 2989                     IFN	BUFPAG,<
 2990  DAAE  D0 08        	BNEA	DATBK
 2991  DAB0  30 71        QDATA:	BMI	DATLOP		;SEARCH FOR ANOTHER DATA STATEMENT.
 2992                     IFN	EXTIO,<
                          	LDA	CHANNL
                          	BNE	GETNTH>
 2995  DAB2  20 ED D9     	JSR	OUTQST
 2996  DAB5  20 6A DA     GETNTH: JSR	QINLIN		;GET ANOTHER LINE.
 2997  DAB8  86 B9 84 BA  DATBK:	STXY	TXTPTR		;SET FOR "CHRGET".
 2998  DABC  20 B2 00     DATBK1: JSR	CHRGET
 2999  DABF  24 11        	BIT	VALTYP		;GET VALUE TYPE.
 3000  DAC1  10 31        	BPL	NUMINS		;INPUT A NUMBER IF NUMERIC.
 3001                     IFN	GETCMD,<
 3002  DAC3  24 15        	BIT	INPFLG		;GET?
 3003  DAC5  50 09        	BVC	SETQUT		;NO, GO SET QUOTE.
 3004  DAC7  E8           	INX
 3005  DAC8  86 B9        	STX	TXTPTR
 3006  DACA  A9 00        	LDAI	0		;ZERO TERMINATORS.
 3007  DACC  85 0D        	STA	CHARAC
 3008  DACE  F0 0C        	BEQA	RESETC
 3009  DAD0  85 0D        SETQUT: STA	CHARAC		;ASSUME QUOTED STRING.
 3010  DAD2  C9 22        	CMPI	34		;TERMINATORS OK?
 3011  DAD4  F0 07        	BEQ	NOWGET		;YES.
 3012  DAD6  A9 3A        	LDAI	":"		;SET TERMINATORS TO ":" AND
 3013  DAD8  85 0D        	STA	CHARAC
 3014  DADA  A9 2C        	LDAI	44		;COMMA.
 3015  DADC  18           RESETC: CLC
 3016  DADD  85 0E        NOWGET: STA	ENDCHR
 3017  DADF  A5 B9 A4 BA  	LDWD	TXTPTR
 3018  DAE3  69 00        	ADCI	0		;C IS SET PROPERLY ABOVE.
 3019  DAE5  90 01        	BCC	NOWGE1
 3020  DAE7  C8           	INY
 3021  DAE8  20 51 E2     NOWGE1: JSR	STRLT2		;MAKE A STRING DESCRIPTOR FOR THE VALUE
 3022                     				;AND COPY IF NECESSARY.
 3023  DAEB  20 A7 E5     	JSR	ST2TXT		;SET TEXT POINTER.
 3024  DAEE  20 F1 D8     	JSR	INPCOM		;DO ASSIGNMENT.
 3025  DAF1  4C FC DA     	JMP	STRDN2
 3026  DAF4  20 B8 EA     NUMINS: JSR	FIN
 3027                     IFE	INTPRC,<
                          	JSR	MOVVF>
 3029                     IFN	INTPRC,<
 3030  DAF7  A5 12        	LDA	INTFLG		;SET CODES ON FLAG.
 3031  DAF9  20 D9 D8     	JSR	QINTGR
 3032  DAFC  20 B8 00     STRDN2: JSR	CHRGOT		;READ LAST CHARACTER.
 3033  DAFF  F0 07        	BEQ	TRMOK		;":" OR EOL IS OK.
