  943                     PAGE
  944                     SUBTTL	RAM CODE.
  945                     ; THIS CODE GETS CHANGED THROUGHOUT EXECUTION.
  946                     ; IT IS MADE TO BE FAST THIS WAY.
  947                     ; ALSO, [X] AND [Y] ARE NOT DISTURBED
  948                     ;
  949                     ; "CHRGET" USING [TXTPTR] AS THE CURRENT TEXT PNTR
  950                     ; FETCHES A NEW CHARACTER INTO ACCA AFTER INCREMENTING [TXTPTR]
  951                     ; AND SETS CONDITION CODES ACCORDING TO WHAT'S IN ACCA.
  952                     ;	NOT C=	NUMERIC	  ("0" THRU "9")
  953                     ;	Z=	":" OR END-OF-LINE (A NULL)
  954                     ;
  955                     ; [ACCA] = NEW CHAR.
  956                     ; [TXTPTR]=[TXTPTR]+1
  957                     ;
  958                     ; THE FOLLOWING EXISTS IN ROM IF ROM EXISTS AND IS LOADED
  959                     ; DOWN HERE BY INIT. OTHERWISE IT IS JUST LOADED INTO THIS
  960                     ; RAM LIKE ALL THE REST OF RAM IS LOADED.
  961                     ;
  962  00B2  E6 B9        CHRGET: INC	CHRGET+7	;INCREMENT THE WHOLE TXTPTR.
  963  00B4  D0 02        	BNE	CHRGOT
  964  00B6  E6 BA        	INC	CHRGET+8
  965  00B8  AD 60 EA     CHRGOT: LDA	60000		;A LOAD WITH AN EXT ADDR.
  966  00B9               TXTPTR= CHRGOT+1
  967  00BB  C9 20        	CMPI	" "		;SKIP SPACES.
  968  00BD  F0 F3        	BEQ	CHRGET
  969  00BF  C9 3A        QNUM:	CMPI	":"		;IS IT A ":"?
  970  00C1  B0 06        	BCS	CHRRTS		;IT IS .GE. ":"
  971  00C3  38           	SEC
  972  00C4  E9 30        	SBCI	"0"		;ALL CHARS .GT. "9" HAVE RET'D SO
  973  00C6  38           	SEC
  974  00C7  E9 D0        	SBCI	256-"0"		;SEE IF NUMERIC.
  975                     				;TURN CARRY ON IF NUMERIC.
  976                     				;ALSO, SETZ IF NULL.
  977  00C9  60           CHRRTS: RTS			;RETURN TO CALLER.
  979  00CA  80           RNDX:	128			;LOADED OR FROM ROM.
  980  00CB  4F           	79			;THE INITIAL RANDOM NUMBER.
  981  00CC  C7           	199
  982  00CD  52           	82
  983                     IFN	ADDPRC,<89>		;ONE MORE BYTE.
  983  00CE  59           89
  985  00CF               ORG	255			;PAGE 1 STUFF COMING UP.
  986  00FF               LOFBUF: BLOCK	1		;THE LOW FAC BUFFER. COPYABLE.
  987                     ;---  PAGE ZERO/ONE BOUNDARY ---.
  988                     				;MUST HAVE 13 CONTIGUOUS BYTES.
  989  0100               FBUFFR: BLOCK	3*ADDPRC+13	;BUFFER FOR "FOUT".
  990                     				;ON PAGE 1 SO THAT STRING IS NOT COPIED.
  992                     ;STACK IS LOCATED HERE. IE FROM THE END OF FBUFFR TO STKEND.
