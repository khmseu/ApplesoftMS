 1365                     PAGE
 1366                     SUBTTL	GENERAL STORAGE MANAGEMENT ROUTINES.
 1367                     ;
 1368                     ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
 1369                     ;
 1370  0012               FORSIZ==2*ADDPRC+16
 1371  0996  BA           FNDFOR: TSX			;LOAD XREG WITH STK PNTR.
 1372  0997  E8 E8 E8 E8  	REPEAT	4,<INX>		;IGNORE ADR(NEWSTT) AND RTS ADDR.
 1373  099B  BD 01 01     FFLOOP: LDA	257,X		;GET STACK ENTRY.
 1374  099E  C9 81        	CMPI	FORTK		;IS IT A "FOR" TOKEN?
 1375  09A0  D0 21        	BNE	FFRTS		;NO, NO "FOR" LOOPS WITH THIS PNTR.
 1376  09A2  A5 89        	LDA	FORPNT+1	;GET HIGH.
 1377  09A4  D0 0A        	BNE	CMPFOR
 1378  09A6  BD 02 01     	LDA	258,X		;PNTR IS ZERO, SO ASSUME THIS ONE.
 1379  09A9  85 88        	STA	FORPNT
 1380  09AB  BD 03 01     	LDA	259,X
 1381  09AE  85 89        	STA	FORPNT+1
 1382  09B0  DD 03 01     CMPFOR: CMP	259,X
 1383  09B3  D0 07        	BNE	ADDFRS		;NOT THIS ONE.
 1384  09B5  A5 88        	LDA	FORPNT		;GET DOWN.
 1385  09B7  DD 02 01     	CMP	258,X
 1386  09BA  F0 07        	BEQ	FFRTS		;WE GOT IT! WE GOT IT!
 1387  09BC  8A           ADDFRS: TXA
 1388  09BD  18           	CLC			;ADD 16 TO X.
 1389  09BE  69 12        	ADCI	FORSIZ
 1390  09C0  AA           	TAX			;RESULT BACK INTO X.
 1391  09C1  D0 D8        	BNE	FFLOOP
 1392  09C3  60           FFRTS:	RTS			;RETURN TO CALLER.
 1394                     ;
 1395                     ; THIS IS THE BLOCK TRANSFER ROUTINE.
 1396                     ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
 1397                     ;
 1398                     ; ON ENTRY:
 1399                     ; [Y,A]=[HIGHDS]    (FOR REASON).
 1400                     ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
 1401                     ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
 1402                     ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
 1403                     ;
 1404                     ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
 1405                     ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
 1406                     ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
 1407                     ;
 1408                     ; ON EXIT:
 1409                     ; [LOWTR] ARE UNCHANGED.
 1410                     ; [HIGHTR]=[LOWTR]-200 OCTAL.
 1411                     ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
 1412                     ;
 1413  09C4  20 14 0A     BLTU:	JSR	REASON		;ASCERTAIN THAT STRING SPACE WON'T
 1414                     				;BE OVERRUN.
 1415  09C7  85 70 84 71  	STWD	STREND
 1416  09CB  38           BLTUC:	SEC			;PREPARE TO SUBTRACT.
 1417  09CC  A5 99        	LDA	HIGHTR
 1418  09CE  E5 9E        	SBC	LOWTR		;COMPUTE NUMBER OF THINGS TO MOVE.
 1419  09D0  85 61        	STA	INDEX		;SAVE FOR LATER.
 1420  09D2  A8           	TAY
 1421  09D3  A5 9A        	LDA	HIGHTR+1
 1422  09D5  E5 9F        	SBC	LOWTR+1
 1423  09D7  AA           	TAX			;PUT IT IN A COUNTER REGISTER.
 1424  09D8  E8           	INX			;SO THAT COUNTER ALGORITHM WORKS.
 1425  09D9  98           	TYA			;SEE IF LOW PART OF COUNT IS ZERO.
 1426  09DA  F0 23        	BEQ	DECBLT		;YES, GO START MOVING BLOCKS.
 1427  09DC  A5 99        	LDA	HIGHTR		;NO, MUST MODIFY BASE ADDR.
 1428  09DE  38           	SEC
 1429  09DF  E5 61        	SBC	INDEX		;BORROW IS OFF SINCE [HIGHTR].GT.[LOWTR].
 1430  09E1  85 99        	STA	HIGHTR		;SAVE MODIFIED BASE ADDR.
 1431  09E3  B0 03        	BCS	BLT1		;IF NO BORROW, GO SHOVE IT.
 1432  09E5  C6 9A        	DEC	HIGHTR+1	;BORROW IMPLIES SUB 1 FROM HIGH ORDER.
