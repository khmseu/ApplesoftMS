 3911                     ;	PUT DOWN NUMBER+1 AND INCREMENT VARPTR.
 3912                     ;	TALLY=TALLY*NUMBER+1.
 3913                     ;	DECREMENT NUMBER-DIMS.
 3914                     ;	BNE LOOP
