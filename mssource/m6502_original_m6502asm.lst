 3180                     ;
 3181                     ; THE FORMULA EVALUATOR STARTS WITH
 3182                     ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
 3183                     ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
 3184                     ; THE RESULT IS LEFT IN THE FAC.
 3185                     ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
 3186                     ;
 3187                     ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
 3188                     ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR
 3189                     ; EACH OPERATOR.
 3190                     ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
 3191                     ;	THE ADDRESS OF THE OPERATOR ROUTINE.
 3192                     ;	THE FLOATING POINT TEMPORARY RESULT.
 3193                     ;	THE PRECEDENCE OF THE OPERATOR.
 3194                     ;
 3195  1336  A6 B9        FRMEVL: LDX	TXTPTR
 3196  1338  D0 02        	BNE	FRMEV1
 3197  133A  C6 BA        	DEC	TXTPTR+1
 3198  133C  C6 B9        FRMEV1: DEC	TXTPTR
 3199  133E  A2 00        	LDXI	0		;INITIAL DUMMY PRECEDENCE IS 0.
 3200  1340  24           	SKIP1
 3201  1341  48           LPOPER: PHA			;SAVE LOW PRECEDENCE. (MASK.)
 3202  1342  8A           	TXA
 3203  1343  48           	PHA			;SAVE HIGH PRECEDENCE.
 3204  1344  A9 01        	LDAI	1
 3205  1346  20 07 0A     	JSR	GETSTK		;MAKE SURE THERE IS ROOM FOR
 3206                     				;RECURSIVE CALLS.
 3207  1349  20 1B 14     	JSR	EVAL		;EVALUATE SOMETHING.
 3208  134C  A9 00 85 8C  	CLR	OPMASK		;PREPARE TO BUILD MASK MAYBE.
 3209  1350  20 B8 00     TSTOP:	JSR	CHRGOT		;REGET LAST CHARACTER.
 3210  1353  38           LOPREL: SEC			;PREP TO SUBTRACT.
 3211  1354  E9 A8        	SBCI	GREATK		;IS CURRENT CHARACTER A RELATION?
 3212  1356  90 17        	BCC	ENDREL		;NO. RELATIONS ALL THROUGH.
 3213  1358  C9 03        	CMPI	LESSTK-GREATK+1 ;REALLY RELATIONAL?
 3214  135A  B0 13        	BCS	ENDREL		;NO -- JUST BIG.
 3215  135C  C9 01        	CMPI	1		;RESET CARRY FOR ZERO ONLY.
 3216  135E  2A           	ROL	A,		;0 TO 1, 1 TO 2, 2 TO 4.
 3217  135F  49 01        	EORI	1
 3218  1361  45 8C        	EOR	OPMASK		;BRING IN THE OLD BITS.
 3219  1363  C5 8C        	CMP	OPMASK		;MAKE SURE THE NEW MASK IS BIGGER.
 3220  1365  90 61        	BCC	SNERR5		;SYNTAX ERROR. BECAUSE TWO OF THE SAME.
 3221  1367  85 8C        	STA	OPMASK		;SAVE MASK.
 3222  1369  20 B2 00     	JSR	CHRGET
 3223  136C  4C 53 13     	JMP	LOPREL		;GET THE NEXT CANDIDATE.
 3224  136F  A6 8C        ENDREL: LDX	OPMASK		;WERE THERE ANY?
 3225  1371  D0 2C        	BNE	FINREL		;YES, HANDLE AS SPECIAL OP.
 3226  1373  B0 7B        	BCS	QOP		;NOT AN OPERATOR.
 3227  1375  69 07        	ADCI	GREATK-PLUSTK
 3228  1377  90 77        	BCC	QOP		;NOT AN OPERATOR.
 3229  1379  65 11        	ADC	VALTYP		;[C]=1.
 3230  137B  D0 03 4C 32  	JEQ	CAT		;ONLY IF [A]=0 AND [VALTYP]=-1 (A STR).
       137F  1B
 3231  1380  69 FF        	ADCI	^O377		;GET BACK ORIGINAL [A].
 3232  1382  85 61        	STA	INDEX1
 3233  1384  0A           	ASL	A,		;MULTIPLY BY 2.
 3234  1385  65 61        	ADC	INDEX1		;BY THREE.
 3235  1387  A8           	TAY			;SET UP FOR LATER.
 3236  1388  68           QPREC:	PLA			;GET PREVIOUS PRECEDENCE.
 3237  1389  D9 62 08     	CMP	OPTAB,Y		;IS OLD PRECEDENCE GREATER OR EQUAL?
 3238  138C  B0 67        	BCS	QCHNUM		;YES, GO OPERATE.
 3239  138E  20 25 13     	JSR	CHKNUM		;CAN'T BE STRING HERE.
 3240  1391  48           DOPREC: PHA			;SAVE OLD PRECEDENCE.
 3241  1392  20 B8 13     NEGPRC: JSR	DOPRE1		;SET A RETURN ADDRESS FOR OP.
 3242  1395  68           	PLA			;PULL OFF PREVIOUS PRECEDENCE.
 3243  1396  A4 8A        	LDY	OPPTR		;GET POINTER TO OP.
 3244  1398  10 17        	BPL	QPREC1		;THAT'S A REAL OPERATOR.
 3245  139A  AA           	TAX			;DONE ?
 3246  139B  F0 56        	BEQ	QOPGO		;DONE !
 3247  139D  D0 5F        	BNE	PULSTK
 3248  139F  46 11        FINREL: LSR	VALTYP		;GET VALUE TYPE INTO "C".
 3249  13A1  8A           	TXA
 3250  13A2  2A           	ROL	A,		;PUT VALTYP INTO LOW ORDER BIT OF MASK.
 3251  13A3  A6 B9        	LDX	TXTPTR		;DECREMENT TEXT POINTER.
 3252  13A5  D0 02        	BNE	FINRE2
 3253  13A7  C6 BA        	DEC	TXTPTR+1
 3254  13A9  C6 B9        FINRE2: DEC	TXTPTR
 3255  13AB  A0 1B        	LDYI	PTDORL-OPTAB	;MAKE [YREG] POINT AT OPERATOR ENTRY.
 3256  13AD  85 8C        	STA	OPMASK		;SAVE THE OPERATION MASK.
 3257  13AF  D0 D7        	BNE	QPREC		;SAVE IT ALL. BR ALWAYS.
 3258                     				;NOTE B7(VALTYP)=0 SO CHKNUM CALL IS OK.
 3259  13B1  D9 62 08     QPREC1: CMP	OPTAB,Y		;LAST PRECEDENCE IS GREATER?
 3260  13B4  B0 48        	BCS	PULSTK		;YES, GO OPERATE.
 3261  13B6  90 D9        	BCC	DOPREC		;NO SAVE ARGUMENT AND GET OTHER OPERAND.
 3262  13B8  B9 64 08     DOPRE1: LDA	OPTAB+2,Y
 3263  13BB  48           	PHA			;DISP ADDR GOES ONTO STACK.
 3264  13BC  B9 63 08     	LDA	OPTAB+1,Y
 3265  13BF  48           	PHA
 3266  13C0  20 CB 13     	JSR	PUSHF1		;SAVE FAC ON STACK UNPACKED.
 3267  13C3  A5 8C        	LDA	OPMASK		;[ACCA] MAY BE MASK FOR REL.
 3268  13C5  4C 41 13     	JMP	LPOPER
