  942                     PAGE
  943                     SUBTTL	RAM CODE.
  944                     ; THIS CODE GETS CHANGED THROUGHOUT EXECUTION.
  945                     ; IT IS MADE TO BE FAST THIS WAY.
  946                     ; ALSO, [X] AND [Y] ARE NOT DISTURBED
  947                     ;
  948                     ; "CHRGET" USING [TXTPTR] AS THE CURRENT TEXT PNTR
  949                     ; FETCHES A NEW CHARACTER INTO ACCA AFTER INCREMENTING [TXTPTR]
  950                     ; AND SETS CONDITION CODES ACCORDING TO WHAT'S IN ACCA.
  951                     ;	NOT C=	NUMERIC	  ("0" THRU "9")
  952                     ;	Z=	":" OR END-OF-LINE (A NULL)
  953                     ;
  954                     ; [ACCA] = NEW CHAR.
  955                     ; [TXTPTR]=[TXTPTR]+1
  956                     ;
  957                     ; THE FOLLOWING EXISTS IN ROM IF ROM EXISTS AND IS LOADED
  958                     ; DOWN HERE BY INIT. OTHERWISE IT IS JUST LOADED INTO THIS
  959                     ; RAM LIKE ALL THE REST OF RAM IS LOADED.
  960                     ;
  961  00B2  E6 B9        CHRGET: INC	CHRGET+7	;INCREMENT THE WHOLE TXTPTR.
  962  00B4  D0 02        	BNE	CHRGOT
  963  00B6  E6 BA        	INC	CHRGET+8
  964  00B8  AD 60 EA     CHRGOT: LDA	60000		;A LOAD WITH AN EXT ADDR.
  965  00B9               TXTPTR= CHRGOT+1
  966  00BB  C9 20        	CMPI	" "		;SKIP SPACES.
  967  00BD  F0 F3        	BEQ	CHRGET
  968  00BF  C9 3A        QNUM:	CMPI	":"		;IS IT A ":"?
  969  00C1  B0 06        	BCS	CHRRTS		;IT IS .GE. ":"
  970  00C3  38           	SEC
  971  00C4  E9 30        	SBCI	"0"		;ALL CHARS .GT. "9" HAVE RET'D SO
  972  00C6  38           	SEC
  973  00C7  E9 D0        	SBCI	256-"0"		;SEE IF NUMERIC.
  974                     				;TURN CARRY ON IF NUMERIC.
  975                     				;ALSO, SETZ IF NULL.
  976  00C9  60           CHRRTS: RTS			;RETURN TO CALLER.
  978  00CA  80           RNDX:	128			;LOADED OR FROM ROM.
  979  00CB  4F           	79			;THE INITIAL RANDOM NUMBER.
