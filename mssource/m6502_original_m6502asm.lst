 3044                     ; SUBROUTINE TO FIND DATA
 3045                     ; THE SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO
 3046                     ; SKIP OVER STATEMENTS. THE START WORD OF EACH STATEMENT
 3047                     ; IS COMPARED WITH "DATATK". EACH NEW LINE NUMBER
 3048                     ; IS STORED IN "DATLIN" SO THAT IF AN ERROR OCCURS
 3049                     ; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE
 3050                     ; NUMBER OF THE ILL-FORMATTED DATA.
 3051                     ;
 3052  1254  20 4E 0F     DATLOP: JSR	DATAN		;SKIP SOME TEXT.
 3053  1257  C8           	INY
 3054  1258  AA           	TAX			;END OF LINE?
 3055  1259  D0 12        	BNE	NOWLIN		;SHO AIN'T.
 3056  125B  A2 06        	LDXI	ERROD		;YES = "NO DATA" ERROR.
 3057  125D  C8           	INY
 3058  125E  B1 B9        	LDADY	TXTPTR
 3059  1260  F0 69        	BEQ	ERRGO5
 3060  1262  C8           	INY
 3061  1263  B1 B9        	LDADY	TXTPTR		;GET HIGH BYTE OF LINE NUMBER.
 3062  1265  85 7E        	STA	DATLIN
 3063  1267  C8           	INY
 3064  1268  B1 B9        	LDADY	TXTPTR		;GET LOW BYTE.
 3065  126A  C8           	INY
 3066  126B  85 7F        	STA	DATLIN+1
 3067  126D  B1 B9        NOWLIN: LDADY	TXTPTR		;HOW IS IT?
 3068  126F  AA           	TAX
