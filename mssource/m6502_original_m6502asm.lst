 5769  EB3E  10 02        	BPL	FINDG1
 5770  EB40  E6 9C        	INC	DECCNT
 5771  EB42  20 B3 E8     FINDG1: JSR	MUL10
 5772  EB45  68           	PLA			;GET IT BACK.
 5773  EB46  38           	SEC
 5774  EB47  E9 30        	SBCI	"0"
 5775  EB49  20 4F EB     	JSR	FINLOG		;ADD IT IN.
 5776  EB4C  4C DB EA     	JMP	FINC
 5778  EB4F  48           FINLOG: PHA
 5779  EB50  20 DD E9     	JSR	MOVAF		;SAVE FAC FOR LATER.
 5780  EB53  68           	PLA
 5781  EB54  20 0D EA     	JSR	FLOAT		;FLOAT THE VALUE IN ACCA.
 5782  EB57  A5 AD        	LDA	ARGSGN
 5783  EB59  45 A5        	EOR	FACSGN
 5784  EB5B  85 AE        	STA	ARISGN		;RESULTANT SIGN.
 5785  EB5D  A6 A0        	LDX	FACEXP		;SET SIGNS ON THING TO ADD.
 5786  EB5F  4C 3B E6     	JMP	FADDT		;ADD TOGETHER AND RETURN.
 5788                     	;HERE PACK IN THE NEXT DIGIT OF THE EXPONENT.
 5789                     	;MULTIPLY THE OLD EXP BY 10 AND ADD IN THE NEXT
 5790                     	;DIGIT. NOTE: EXP OVERFLOW IS NOT CHECKED FOR.
 5791  EB62  A5 9D        FINEDG: LDA	TENEXP		;GET EXP SO FAR.
 5792  EB64  C9 0A        	CMPI	12		;WILL RESULT BE .GE. 100?
 5793  EB66  90 09        	BCC	MLEX10
 5794  EB68  A9 64        	LDAI	144		;GET 100.
 5795  EB6A  24 9F        	BIT	EXPSGN
 5796  EB6C  30 11        	BMI	MLEXMI		;IF NEG EXP, NO CHK FOR OVERR.
 5797  EB6E  4C 4F E7     	JMP	OVERR
 5798  EB71  0A           MLEX10: ASL	A,		;MULT BY 2 TWICE
 5799  EB72  0A           	ASL	A
 5800  EB73  18           	CLC			;POSSIBLE SHIFT OUT OF HIGH.
 5801  EB74  65 9D        	ADC	TENEXP		;LIKE MULTIPLYING BY FIVE.
 5802  EB76  0A           	ASL	A,		;AND NOW BY TEN.
 5803  EB77  18           	CLC
 5804  EB78  A0 00        	LDYI	0
 5805  EB7A  71 B9        	ADCDY	TXTPTR
 5806  EB7C  38           	SEC
 5807  EB7D  E9 30        	SBCI	"0"
 5808  EB7F  85 9D        MLEXMI: STA	TENEXP		;SAVE RESULT.
 5809  EB81  4C 01 EB     	JMP	FINEC
