 1586  D389  85 6C        	STA	VARTAB
 1587  D38B  85 63        	STA	INDEX2		;SET LOW OF TRANS TO.
 1588  D38D  A5 6D        	LDA	VARTAB+1
 1589  D38F  69 FF        	ADCI	255
