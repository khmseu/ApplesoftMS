 4137                     ;
 4138                     ; NOTE ONLY SINGLE ARGUMENTS ARE ALLOWED TO FUNCTIONS
 4139                     ; AND FUNCTIONS MUST BE OF THE SINGLE LINE FORM:
 4140                     ;	DEF FNA(X)=X^2+X-2
