 1591  D393  E5 9F        	SBC	LOWTR+1		;COMPUTE NUMBER OF BLOCKS TO MOVE.
 1592  D395  AA           	TAX
 1593  D396  38           	SEC
 1594  D397  A5 9E        	LDA	LOWTR
 1595  D399  E5 6C        	SBC	VARTAB		;COMPUTE OFFSET.
 1596  D39B  A8           	TAY
 1597  D39C  B0 03        	BCS	QDECT1		;IF VARTAB.LE.LOWTR,
 1598  D39E  E8           	INX			;DECR DUE TO CARRY, AND
 1599  D39F  C6 64        	DEC	INDEX2+1	;DECREMENT STORE SO CARRY WORKS.
