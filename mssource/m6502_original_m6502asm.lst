 1601  D3A2  65 61        	ADC	INDEX1
 1602  D3A4  90 03        	BCC	MLOOP
 1603  D3A6  C6 62        	DEC	INDEX1+1
 1604  D3A8  18           	CLC			;FOR LATER ADCQ
