 1367                     PAGE
 1368                     SUBTTL	GENERAL STORAGE MANAGEMENT ROUTINES.
 1369                     ;
 1370                     ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
 1371                     ;
 1372  0012               FORSIZ==2*ADDPRC+16
 1373  D270  BA           FNDFOR: TSX			;LOAD XREG WITH STK PNTR.
 1374  D271  E8 E8 E8 E8  	REPEAT	4,<INX>		;IGNORE ADR(NEWSTT) AND RTS ADDR.
 1375  D275  BD 01 01     FFLOOP: LDA	257,X		;GET STACK ENTRY.
 1376  D278  C9 81        	CMPI	FORTK		;IS IT A "FOR" TOKEN?
 1377  D27A  D0 21        	BNE	FFRTS		;NO, NO "FOR" LOOPS WITH THIS PNTR.
 1378  D27C  A5 89        	LDA	FORPNT+1	;GET HIGH.
 1379  D27E  D0 0A        	BNE	CMPFOR
 1380  D280  BD 02 01     	LDA	258,X		;PNTR IS ZERO, SO ASSUME THIS ONE.
 1381  D283  85 88        	STA	FORPNT
 1382  D285  BD 03 01     	LDA	259,X
 1383  D288  85 89        	STA	FORPNT+1
 1384  D28A  DD 03 01     CMPFOR: CMP	259,X
 1385  D28D  D0 07        	BNE	ADDFRS		;NOT THIS ONE.
 1386  D28F  A5 88        	LDA	FORPNT		;GET DOWN.
 1387  D291  DD 02 01     	CMP	258,X
 1388  D294  F0 07        	BEQ	FFRTS		;WE GOT IT! WE GOT IT!
 1389  D296  8A           ADDFRS: TXA
 1390  D297  18           	CLC			;ADD 16 TO X.
 1391  D298  69 12        	ADCI	FORSIZ
 1392  D29A  AA           	TAX			;RESULT BACK INTO X.
 1393  D29B  D0 D8        	BNE	FFLOOP
 1394  D29D  60           FFRTS:	RTS			;RETURN TO CALLER.
 1396                     ;
 1397                     ; THIS IS THE BLOCK TRANSFER ROUTINE.
 1398                     ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
 1399                     ;
 1400                     ; ON ENTRY:
 1401                     ; [Y,A]=[HIGHDS]    (FOR REASON).
 1402                     ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
 1403                     ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
 1404                     ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
 1405                     ;
 1406                     ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
 1407                     ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
 1408                     ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
 1409                     ;
 1410                     ; ON EXIT:
 1411                     ; [LOWTR] ARE UNCHANGED.
 1412                     ; [HIGHTR]=[LOWTR]-200 OCTAL.
 1413                     ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
 1414                     ;
 1415  D29E  20 EE D2     BLTU:	JSR	REASON		;ASCERTAIN THAT STRING SPACE WON'T
 1416                     				;BE OVERRUN.
 1417  D2A1  85 70 84 71  	STWD	STREND
 1418  D2A5  38           BLTUC:	SEC			;PREPARE TO SUBTRACT.
 1419  D2A6  A5 99        	LDA	HIGHTR
 1420  D2A8  E5 9E        	SBC	LOWTR		;COMPUTE NUMBER OF THINGS TO MOVE.
 1421  D2AA  85 61        	STA	INDEX		;SAVE FOR LATER.
 1422  D2AC  A8           	TAY
 1423  D2AD  A5 9A        	LDA	HIGHTR+1
 1424  D2AF  E5 9F        	SBC	LOWTR+1
 1425  D2B1  AA           	TAX			;PUT IT IN A COUNTER REGISTER.
 1426  D2B2  E8           	INX			;SO THAT COUNTER ALGORITHM WORKS.
 1427  D2B3  98           	TYA			;SEE IF LOW PART OF COUNT IS ZERO.
 1428  D2B4  F0 23        	BEQ	DECBLT		;YES, GO START MOVING BLOCKS.
 1429  D2B6  A5 99        	LDA	HIGHTR		;NO, MUST MODIFY BASE ADDR.
 1430  D2B8  38           	SEC
 1431  D2B9  E5 61        	SBC	INDEX		;BORROW IS OFF SINCE [HIGHTR].GT.[LOWTR].
 1432  D2BB  85 99        	STA	HIGHTR		;SAVE MODIFIED BASE ADDR.
 1433  D2BD  B0 03        	BCS	BLT1		;IF NO BORROW, GO SHOVE IT.
 1434  D2BF  C6 9A        	DEC	HIGHTR+1	;BORROW IMPLIES SUB 1 FROM HIGH ORDER.
 1435  D2C1  38           	SEC
 1436  D2C2  A5 97        BLT1:	LDA	HIGHDS		;MOD BASE OF DEST ADDR.
 1437  D2C4  E5 61        	SBC	INDEX
 1438  D2C6  85 97        	STA	HIGHDS
 1439  D2C8  B0 08        	BCS	MOREN1		;NO BORROW.
 1440  D2CA  C6 98        	DEC	HIGHDS+1	;DECREMENT HIGH ORDER BYTE.
 1441  D2CC  90 04        	BCC	MOREN1		;ALWAYS SKIP.
 1442  D2CE  B1 99        BLTLP:	LDADY	HIGHTR		;FETCH BYTE TO MOVE
 1443  D2D0  91 97        	STADY	HIGHDS		;MOVE IT IN, MOVE IT OUT.
 1444  D2D2  88           MOREN1: DEY
 1445  D2D3  D0 F9        	BNE	BLTLP
 1446  D2D5  B1 99        	LDADY	HIGHTR		;MOVE LAST OF THE BLOCK.
 1447  D2D7  91 97        	STADY	HIGHDS
 1448  D2D9  C6 9A        DECBLT: DEC	HIGHTR+1
 1449  D2DB  C6 98        	DEC	HIGHDS+1	;START ON NEW BLOCKS.
 1450  D2DD  CA           	DEX
 1451  D2DE  D0 F2        	BNE	MOREN1
 1452  D2E0  60           	RTS			;RETURN TO CALLER.
 1454                     ;
 1455                     ; THIS ROUTINE IS USED TO ASCERTAIN THAT A GIVEN
 1456                     ; NUMBER OF LOCS REMAIN AVAILABLE FOR THE STACK.
 1457                     ;    THE CALL IS:
 1458                     ;	LDAI	NUMBER OF 2-BYTE ENTRIES NEEDED.
 1459                     ;	JSR	GETSTK
 1460                     ;
 1461                     ; THIS ROUTINE MUST BE CALLED BY ANY ROUTINE WHICH PUTS
 1462                     ; AN ARBITRARY AMOUNT OF STUFF ON THE STACK,
 1463                     ; I.E., ANY RECURSIVE ROUTINE LIKE "FRMEVL".
 1464                     ; IT IS ALSO CALLED BY ROUTINES SUCH AS "GOSUB" AND "FOR"
 1465                     ; WHICH MAKE PERMANENT ENTRIES ON THE STACK.
 1466                     ;
 1467                     ; ROUTINES WHICH MERELY USE AND FREE UP THE GUARANTEED
 1468                     ; NUMLEV LOCATIONS NEED NOT CALL THIS.
 1469                     ;
 1470                     ;
 1471                     ; ON EXIT:
 1472                     ;    [A] AND [X] HAVE BEEN MODIFIED.
 1473                     ;
 1474  D2E1  0A           GETSTK: ASL	A,		;MULT [A] BY 2. NB, CLEARS C BIT.
 1475  D2E2  69 3E        	ADCI	2*NUMLEV+<3*ADDPRC>+13	;MAKE SURE 2*NUMLEV+13 LOCS
 1476                     				;(13 BECAUSE OF FBUFFR)
 1477  D2E4  B0 35        	BCS	OMERR		;WILL REMAIN IN STACK.
 1478  D2E6  85 61        	STA	INDEX
 1479  D2E8  BA           	TSX			;GET STACKED.
 1480  D2E9  E4 61        	CPX	INDEX		;COMPARE.
 1481  D2EB  90 2E        	BCC	OMERR		;IF STACK.LE.INDEX1, OM.
 1482  D2ED  60           	RTS
 1484                     ;
 1485                     ; [Y,A] IS A CERTAIN ADDRESS. "REASON" MAKES SURE
 1486                     ; IT IS LESS THAN [FRETOP].
 1487                     ;
 1488  D2EE  C4 73        REASON: CPY	FRETOP+1
 1489  D2F0  90 28        	BCC	REARTS
 1490  D2F2  D0 04        	BNE	TRYMOR		;GO GARB COLLECT.
 1491  D2F4  C5 72        	CMP	FRETOP
 1492  D2F6  90 22        	BCC	REARTS
 1493  D2F8  48           TRYMOR: PHA
 1494  D2F9  A2 09        	LDXI	8+ADDPRC	;IF TEMPF2 HAS ZERO IN BETWEEN.
 1495  D2FB  98           	TYA
 1496  D2FC  48           REASAV: PHA
 1497  D2FD  B5 96        	LDA	HIGHDS-1,X	;SAVE HIGHDS ON STACK.
 1498  D2FF  CA           	DEX
 1499  D300  10 FA        	BPL	REASAV		;PUT 8 OF THEM ON STK.
 1500  D302  20 F6 E2     	JSR	GARBA2		;GO GARB COLLECT.
 1501  D305  A2 F7        	LDXI	256-8-ADDPRC
 1502  D307  68           REASTO: PLA
 1503  D308  95 A0        	STA	HIGHDS+8+ADDPRC,X	;RESTORE AFTER GARB COLLECT.
 1504  D30A  E8           	INX
 1505  D30B  30 FA        	BMI	REASTO
 1506  D30D  68           	PLA
 1507  D30E  A8           	TAY
 1508  D30F  68           	PLA			;RESTORE A AND Y.
 1509  D310  C4 73        	CPY	FRETOP+1	;COMPARE HIGHS
 1510  D312  90 06        	BCC	REARTS
 1511  D314  D0 05        	BNE	OMERR		;HIGHER IS BAD.
 1512  D316  C5 72        	CMP	FRETOP		;AND THE LOWS.
 1513  D318  B0 01        	BCS	OMERR
 1514  D31A  60           REARTS: RTS
 1516                     PAGE
 1517                     SUBTTL	ERROR HANDLER, READY, TERMINAL INPUT, COMPACTIFY, NEW, REINIT.
 1518  D31B  A2 4D        OMERR:	LDXI	ERROM
 1519  D31D               ERROR:
