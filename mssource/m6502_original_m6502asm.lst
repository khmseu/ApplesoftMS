 5751  EB11  85 9D        	STA	TENEXP
 5752  EB13  F0 12        	BEQ	FINQNG		;NEGATE?
 5753  EB15  10 09        	BPL	FINMUL		;POSITIVE SO MULTIPLY.
 5754  EB17  20 C3 E8     FINDIV: JSR	DIV10
 5755  EB1A  E6 9D        	INC	TENEXP		;DONE?
 5756  EB1C  D0 F9        	BNE	FINDIV		;NO.
