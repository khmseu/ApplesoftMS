 6544  263D  A5 A5        ATN:	LDA	FACSGN		;WHAT IS SIGN?
 6545  263F  48           	PHA			;(MEANWHILE SAVE FOR LATER.)
 6546  2640  10 03        	BPL	ATN1
 6547  2642  20 6F 24     	JSR	NEGOP		;IF NEGATIVE, NEGATE FAC.
 6548                     				;USE ARCTAN(X)=-ARCTAN(-X) .
 6549  2645  A5 A0        ATN1:	LDA	FACEXP
 6550  2647  48           	PHA			;SAVE THIS TOO FOR LATER.
 6551  2648  C9 81        	CMPI	201		;SEE IF FAC .GE. 1.0 .
 6552  264A  90 07        	BCC	ATN2		;IT IS LESS THAN 1.
 6553  264C  A9 B2 A0 1E  	LDWDI	FONE		;GET PNTR TO 1.0 .
 6554  2650  20 05 20     	JSR	FDIV		;COMPUTE RECIPROCAL.
 6555                     				;USE ARCTAN(X)=PI/2-ARCTAN(1/X) .
 6556  2653  A9 6D A0 26  ATN2:	LDWDI	ATNCON		;PNTR TO ARCTAN CONSTANTS.
 6557  2657  20 FB 24     	JSR	POLYX
 6558  265A  68           	PLA
