 1466                     ; NUMLEV LOCATIONS NEED NOT CALL THIS.
 1467                     ;
 1468                     ;
 1469                     ; ON EXIT:
 1470                     ;    [A] AND [X] HAVE BEEN MODIFIED.
 1471                     ;
 1472  0A07  0A           GETSTK: ASL	A,		;MULT [A] BY 2. NB, CLEARS C BIT.
 1473  0A08  69 3E        	ADCI	2*NUMLEV+<3*ADDPRC>+13	;MAKE SURE 2*NUMLEV+13 LOCS
