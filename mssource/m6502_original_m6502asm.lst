 3600                     SUBTTL	DIMENSION AND VARIABLE SEARCHING.
 3601                     ;
 3602                     ; THE "DIM" CODE SETS [DIMFLG] AND THEN FALLS INTO THE VARIABLE SEARCH
 3603                     ; ROUTINE, WHICH LOOKS AT DIMFLG AT THREE DIFFERENT POINTS.
 3604                     ;	1) IF AN ENTRY IS FOUND, "DIMFLG" BEING ON INDICATES
 3605                     ;		A "DOUBLY" DIMENSIONED VARIABLE.
 3606                     ;	2) WHEN A NEW ENTRY IS BEING BUILT "DIMFLG" BEING ON
 3607                     ;		INDICTAES THE INDICES SHOULD BE USED FOR THE
 3608                     ;		SIZE OF EACH INDEX. OTHERWISE THE DEFAULT OF TEN
 3609                     ;		IS USED.
 3610                     ;	3) WHEN THE BUILD ENTRY CODE FINISHES, ONLY IF "DIMFLG" IS OFF
 3611                     ;		WILL INDEXING BE DONE.
 3612                     ;
 3613  DE5D  20 4B DD     DIM3:	JSR	CHKCOM		;MUST BE A COMMA
 3614  DE60  AA           DIM:	TAX			;SET [ACCX] NONZERO.
 3615                     				;[ACCA] MUST BE NONZERO TO WORK RIGHT.
 3616  DE61  20 6F DE     DIM1:	JSR	PTRGT1
 3617  DE64  20 B8 00     DIMCON: JSR	CHRGOT		;GET LAST CHARACTER.
 3618  DE67  D0 F4        	BNE	DIM3
 3619  DE69  60           	RTS
 3620                     ;
 3621                     ; ROUTINE TO READ THE VARIABLE NAME AT THE CURRENT TEXT POSITION
 3622                     ; AND  PUT A POINTER TO ITS VALUE IN VARPNT. [TXTPTR]
 3623                     ; POINTS TO THE TERMINATING CHARCTER.. NOT THAT EVALUATING SUBSCRIPTS
 3624                     ; IN A VARIABLE NAME CAN CAUSE RECURSIVE CALLS TO "PTRGET" SO AT
 3625                     ; THAT POINT ALL VALUES MUST BE STORED ON THE STACK.
 3626                     ;
 3627  DE6A  A2 00        PTRGET: LDXI	0		;MAKE [ACCX]=0.
 3628  DE6C  20 B8 00     	JSR	CHRGOT		;RETRIEVE LAST CHARACTER.
 3629  DE6F  86 10        PTRGT1: STX	DIMFLG		;STORE FLAG AWAY.
