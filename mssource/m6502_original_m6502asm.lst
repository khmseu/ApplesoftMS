 6109                     				;LAST THING FETCHED IS FACEXP. INTO ACCX.
 6110                     ;	JMP	FPWRT		;FALL INTO FPWRT.
 6112                     	;EXPONENTIATION ---  X^Y.
 6113                     	;N.B.  0^0=1
 6114                     	;FIRST CHECK IF Y=0. IF SO, THE RESULT IS 1.
 6115                     	;NEXT CHECK IF X=0. IF SO THE RESULT IS 0.
 6116                     	;THEN CHECK IF X.GT.0. IF NOT CHECK THAT Y IS AN INTEGER.
 6117                     	;IF SO, NEGATE X, SO THAT LOG DOESN'T GIVE FCERR.
 6118                     	;IF X IS NEGATIVE AND Y IS ODD, NEGATE THE RESULT
 6119                     	;RETURNED BY EXP.
 6120                     	;TO COMPUTE THE RESULT USE X^Y=EXP((Y*LOG(X)).
 6121  ED05  F0 70        FPWRT:	BEQ	EXP		;IF FAC=0, JUST EXPONENTIATE THAT.
 6122  ED07  A5 A8        	LDA	ARGEXP		;IS X=0?
 6123  ED09  D0 03        	BNE	FPWRT1
 6124  ED0B  4C BE E6     	JMP	ZEROF1		;ZERO FAC.
 6125  ED0E  A2 8D A0 00  FPWRT1: LDXYI	TEMPF3		;SAVE FOR LATER IN A TEMP.
 6126  ED12  20 99 E9     	JSR	MOVMF
 6127                     	;Y=0 ALREADY. GOOD IN CASE NO ONE CALLS INT.
 6128  ED15  A5 AD        	LDA	ARGSGN
 6129  ED17  10 0F        	BPL	FPWR1		;NO PROBLEMS IF X.GT.0.
 6130  ED19  20 91 EA     	JSR	INT		;INTEGERIZE THE FAC.
 6131  ED1C  A9 8D A0 00  	LDWDI	TEMPF3		;GET ADDR OF COMPERAND.
 6132  ED20  20 20 EA     	JSR	FCOMP		;EQUAL?
 6133  ED23  D0 03        	BNE	FPWR1		;LEAVE X NEG. LOG WILL BLOW HIM OUT.
 6134                     				;A=-1 AND Y IS IRRELEVANT.
 6135  ED25  98           	TYA			;NEGATE X. MAKE POSITIVE.
 6136  ED26  A4 0D        	LDY	INTEGR		;GET EVENNESS.
 6137  ED28  20 C3 E9     FPWR1:	JSR	MOVFA1		;ALTERNATE ENTRY POINT.
 6138  ED2B  98           	TYA
 6139  ED2C  48           	PHA			;SAVE EVENNESS FOR LATER.
 6140  ED2D  20 AF E7     	JSR	LOG		;FIND LOG.
 6141  ED30  A9 8D A0 00  	LDWDI	TEMPF3		;MULTIPLY FAC TIMES LOG(X).
 6142  ED34  20 ED E7     	JSR	FMULT
 6143  ED37  20 77 ED     	JSR	EXP		;EXPONENTIATE THE FAC.
 6144  ED3A  68           	PLA
 6145  ED3B  4A           	LSR	A,		;IS IT EVEN?
 6146  ED3C  90 0A        	BCC	NEGRTS		;YES. OR X.GT.0.
 6147                     	;NEGATE THE NUMBER IN FAC.
 6148  ED3E  A5 A0        NEGOP:	LDA	FACEXP
 6149  ED40  F0 06        	BEQ	NEGRTS
 6150  ED42  A5 A5 49 FF  	COM	FACSGN
       ED46  85 A5
 6151  ED48  60           NEGRTS: RTS
 6153                     PAGE
 6154                     SUBTTL	EXPONENTIATION FUNCTION.
 6155                     	;FIRST SAVE THE ORIGINAL ARGUMENT AND MULTIPLY THE FAC BY
 6156                     	;LOG2(E). THE RESULT IS USED TO DETERMINE IF OVERFLOW
 6157                     	;WILL OCCUR SINCE EXP(X)=2^(X*LOG2(E)) WHERE
 6158                     	;LOG2(E)=LOG(E) BASE 2. THEN SAVE THE INTEGER PART OF
 6159                     	;THIS TO SCALE THE ANSWER AT THE END. SINCE
 6160                     	;2^Y=2^INT(Y)*2^(Y-INT(Y)) AND 2^INT(Y) IS EASY TO COMPUTE.
 6161                     	;NOW COMPUTE 2^(X*LOG2(E)-INT(X*LOG2(E)) BY
 6162                     	;P(LN(2)*(INT(X*LOG2(E))+1)-X) WHERE P IS AN APPROXIMATION
 6163                     	;POLYNOMIAL. THE RESULT IS THEN SCALED BY THE POWER OF 2
 6164                     	;PREVIOUSLY SAVED.
 6166  ED49  81           LOGEB2: 201			;LOG(E) BASE 2.
