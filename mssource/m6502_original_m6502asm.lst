 4005                     ;
 4006                     ; AT THIS POINT [LOWTR,Y] POINTS BEYOND THE SIZE TO THE NUMBER OF
 4007                     ; DIMENSIONS. STRATEGY:
 4008                     ;	NUMDIM=NUMBER OF DIMENSIONS.
 4009                     ;	CURTOL=0.
 4010                     ; INLPNM:GET A NEW INDICE.
 4011                     ;	MAKE SURE INDICE IS NOT TOO BIG.
 4012                     ;	MULTIPLY CURTOL BY CURMAX.
 4013                     ;	ADD INDICE TO CURTOL.
 4014                     ;	NUMDIM=NUMDIM-1.
 4015                     ;	BNE	INLPNM.
 4016                     ;	USE [CURTOL]*4 AS OFFSET.
 4017                     ;
