 2423  D7F2  9A           	TXS
 2424  D7F3  C9 8C        	CMPI	GOSUTK		;RETURN WITHOUT GOSUB?
 2425  D7F5  F0 0B        	BEQ	RETU1
 2426  D7F7  A2 16        	LDXI	ERRRG
 2427  D7F9  2C           	SKIP2
