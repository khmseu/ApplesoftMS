 1366                     PAGE
 1367                     SUBTTL	GENERAL STORAGE MANAGEMENT ROUTINES.
 1368                     ;
 1369                     ; FIND A "FOR" ENTRY ON THE STACK VIA "VARPNT".
 1370                     ;
 1371  0012               FORSIZ==2*ADDPRC+16
 1372  D264  BA           FNDFOR: TSX			;LOAD XREG WITH STK PNTR.
 1373  D265  E8 E8 E8 E8  	REPEAT	4,<INX>		;IGNORE ADR(NEWSTT) AND RTS ADDR.
 1374  D269  BD 01 01     FFLOOP: LDA	257,X		;GET STACK ENTRY.
 1375  D26C  C9 81        	CMPI	FORTK		;IS IT A "FOR" TOKEN?
 1376  D26E  D0 21        	BNE	FFRTS		;NO, NO "FOR" LOOPS WITH THIS PNTR.
 1377  D270  A5 89        	LDA	FORPNT+1	;GET HIGH.
 1378  D272  D0 0A        	BNE	CMPFOR
 1379  D274  BD 02 01     	LDA	258,X		;PNTR IS ZERO, SO ASSUME THIS ONE.
 1380  D277  85 88        	STA	FORPNT
 1381  D279  BD 03 01     	LDA	259,X
 1382  D27C  85 89        	STA	FORPNT+1
 1383  D27E  DD 03 01     CMPFOR: CMP	259,X
 1384  D281  D0 07        	BNE	ADDFRS		;NOT THIS ONE.
 1385  D283  A5 88        	LDA	FORPNT		;GET DOWN.
 1386  D285  DD 02 01     	CMP	258,X
 1387  D288  F0 07        	BEQ	FFRTS		;WE GOT IT! WE GOT IT!
 1388  D28A  8A           ADDFRS: TXA
 1389  D28B  18           	CLC			;ADD 16 TO X.
 1390  D28C  69 12        	ADCI	FORSIZ
 1391  D28E  AA           	TAX			;RESULT BACK INTO X.
 1392  D28F  D0 D8        	BNE	FFLOOP
 1393  D291  60           FFRTS:	RTS			;RETURN TO CALLER.
 1395                     ;
 1396                     ; THIS IS THE BLOCK TRANSFER ROUTINE.
 1397                     ; IT MAKES SPACE BY SHOVING EVERYTHING FORWARD.
 1398                     ;
 1399                     ; ON ENTRY:
 1400                     ; [Y,A]=[HIGHDS]    (FOR REASON).
 1401                     ; [HIGHDS]= DESTINATION OF [HIGH ADDRESS].
 1402                     ; [LOWTR]= LOWEST ADDR TO BE TRANSFERRED.
 1403                     ; [HIGHTR]= HIGHEST ADDR TO BE TRANSFERRED.
 1404                     ;
 1405                     ; A CHECK IS MADE TO ASCERTAIN THAT A REASONABLE
 1406                     ; AMOUNT OF SPACE REMAINS BETWEEN THE BOTTOM
 1407                     ; OF THE STRINGS AND THE HIGHEST LOCATION TRANSFERRED INTO.
 1408                     ;
 1409                     ; ON EXIT:
 1410                     ; [LOWTR] ARE UNCHANGED.
 1411                     ; [HIGHTR]=[LOWTR]-200 OCTAL.
 1412                     ; [HIGHDS]=LOWEST ADDR TRANSFERRED INTO MINUS 200 OCTAL.
 1413                     ;
 1414  D292  20 E2 D2     BLTU:	JSR	REASON		;ASCERTAIN THAT STRING SPACE WON'T
 1415                     				;BE OVERRUN.
 1416  D295  85 70 84 71  	STWD	STREND
 1417  D299  38           BLTUC:	SEC			;PREPARE TO SUBTRACT.
 1418  D29A  A5 99        	LDA	HIGHTR
 1419  D29C  E5 9E        	SBC	LOWTR		;COMPUTE NUMBER OF THINGS TO MOVE.
 1420  D29E  85 61        	STA	INDEX		;SAVE FOR LATER.
 1421  D2A0  A8           	TAY
 1422  D2A1  A5 9A        	LDA	HIGHTR+1
 1423  D2A3  E5 9F        	SBC	LOWTR+1
 1424  D2A5  AA           	TAX			;PUT IT IN A COUNTER REGISTER.
 1425  D2A6  E8           	INX			;SO THAT COUNTER ALGORITHM WORKS.
 1426  D2A7  98           	TYA			;SEE IF LOW PART OF COUNT IS ZERO.
 1427  D2A8  F0 23        	BEQ	DECBLT		;YES, GO START MOVING BLOCKS.
 1428  D2AA  A5 99        	LDA	HIGHTR		;NO, MUST MODIFY BASE ADDR.
 1429  D2AC  38           	SEC
 1430  D2AD  E5 61        	SBC	INDEX		;BORROW IS OFF SINCE [HIGHTR].GT.[LOWTR].
 1431  D2AF  85 99        	STA	HIGHTR		;SAVE MODIFIED BASE ADDR.
 1432  D2B1  B0 03        	BCS	BLT1		;IF NO BORROW, GO SHOVE IT.
 1433  D2B3  C6 9A        	DEC	HIGHTR+1	;BORROW IMPLIES SUB 1 FROM HIGH ORDER.
 1434  D2B5  38           	SEC
 1435  D2B6  A5 97        BLT1:	LDA	HIGHDS		;MOD BASE OF DEST ADDR.
 1436  D2B8  E5 61        	SBC	INDEX
 1437  D2BA  85 97        	STA	HIGHDS
 1438  D2BC  B0 08        	BCS	MOREN1		;NO BORROW.
 1439  D2BE  C6 98        	DEC	HIGHDS+1	;DECREMENT HIGH ORDER BYTE.
 1440  D2C0  90 04        	BCC	MOREN1		;ALWAYS SKIP.
 1441  D2C2  B1 99        BLTLP:	LDADY	HIGHTR		;FETCH BYTE TO MOVE
 1442  D2C4  91 97        	STADY	HIGHDS		;MOVE IT IN, MOVE IT OUT.
 1443  D2C6  88           MOREN1: DEY
 1444  D2C7  D0 F9        	BNE	BLTLP
 1445  D2C9  B1 99        	LDADY	HIGHTR		;MOVE LAST OF THE BLOCK.
 1446  D2CB  91 97        	STADY	HIGHDS
 1447  D2CD  C6 9A        DECBLT: DEC	HIGHTR+1
 1448  D2CF  C6 98        	DEC	HIGHDS+1	;START ON NEW BLOCKS.
 1449  D2D1  CA           	DEX
 1450  D2D2  D0 F2        	BNE	MOREN1
 1451  D2D4  60           	RTS			;RETURN TO CALLER.
 1453                     ;
 1454                     ; THIS ROUTINE IS USED TO ASCERTAIN THAT A GIVEN
 1455                     ; NUMBER OF LOCS REMAIN AVAILABLE FOR THE STACK.
 1456                     ;    THE CALL IS:
 1457                     ;	LDAI	NUMBER OF 2-BYTE ENTRIES NEEDED.
 1458                     ;	JSR	GETSTK
 1459                     ;
 1460                     ; THIS ROUTINE MUST BE CALLED BY ANY ROUTINE WHICH PUTS
 1461                     ; AN ARBITRARY AMOUNT OF STUFF ON THE STACK,
 1462                     ; I.E., ANY RECURSIVE ROUTINE LIKE "FRMEVL".
 1463                     ; IT IS ALSO CALLED BY ROUTINES SUCH AS "GOSUB" AND "FOR"
 1464                     ; WHICH MAKE PERMANENT ENTRIES ON THE STACK.
 1465                     ;
 1466                     ; ROUTINES WHICH MERELY USE AND FREE UP THE GUARANTEED
 1467                     ; NUMLEV LOCATIONS NEED NOT CALL THIS.
 1468                     ;
 1469                     ;
 1470                     ; ON EXIT:
 1471                     ;    [A] AND [X] HAVE BEEN MODIFIED.
 1472                     ;
 1473  D2D5  0A           GETSTK: ASL	A,		;MULT [A] BY 2. NB, CLEARS C BIT.
 1474  D2D6  69 3E        	ADCI	2*NUMLEV+<3*ADDPRC>+13	;MAKE SURE 2*NUMLEV+13 LOCS
 1475                     				;(13 BECAUSE OF FBUFFR)
 1476  D2D8  B0 35        	BCS	OMERR		;WILL REMAIN IN STACK.
 1477  D2DA  85 61        	STA	INDEX
 1478  D2DC  BA           	TSX			;GET STACKED.
 1479  D2DD  E4 61        	CPX	INDEX		;COMPARE.
 1480  D2DF  90 2E        	BCC	OMERR		;IF STACK.LE.INDEX1, OM.
 1481  D2E1  60           	RTS
 1483                     ;
 1484                     ; [Y,A] IS A CERTAIN ADDRESS. "REASON" MAKES SURE
 1485                     ; IT IS LESS THAN [FRETOP].
 1486                     ;
 1487  D2E2  C4 73        REASON: CPY	FRETOP+1
 1488  D2E4  90 28        	BCC	REARTS
 1489  D2E6  D0 04        	BNE	TRYMOR		;GO GARB COLLECT.
 1490  D2E8  C5 72        	CMP	FRETOP
 1491  D2EA  90 22        	BCC	REARTS
 1492  D2EC  48           TRYMOR: PHA
 1493  D2ED  A2 09        	LDXI	8+ADDPRC	;IF TEMPF2 HAS ZERO IN BETWEEN.
 1494  D2EF  98           	TYA
 1495  D2F0  48           REASAV: PHA
 1496  D2F1  B5 96        	LDA	HIGHDS-1,X	;SAVE HIGHDS ON STACK.
 1497  D2F3  CA           	DEX
 1498  D2F4  10 FA        	BPL	REASAV		;PUT 8 OF THEM ON STK.
 1499  D2F6  20 EA E2     	JSR	GARBA2		;GO GARB COLLECT.
 1500  D2F9  A2 F7        	LDXI	256-8-ADDPRC
 1501  D2FB  68           REASTO: PLA
 1502  D2FC  95 A0        	STA	HIGHDS+8+ADDPRC,X	;RESTORE AFTER GARB COLLECT.
 1503  D2FE  E8           	INX
 1504  D2FF  30 FA        	BMI	REASTO
 1505  D301  68           	PLA
 1506  D302  A8           	TAY
 1507  D303  68           	PLA			;RESTORE A AND Y.
 1508  D304  C4 73        	CPY	FRETOP+1	;COMPARE HIGHS
 1509  D306  90 06        	BCC	REARTS
 1510  D308  D0 05        	BNE	OMERR		;HIGHER IS BAD.
 1511  D30A  C5 72        	CMP	FRETOP		;AND THE LOWS.
 1512  D30C  B0 01        	BCS	OMERR
 1513  D30E  60           REARTS: RTS
 1515                     PAGE
 1516                     SUBTTL	ERROR HANDLER, READY, TERMINAL INPUT, COMPACTIFY, NEW, REINIT.
