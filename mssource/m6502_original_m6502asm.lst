 4004                     ;
 4005                     ; AT THIS POINT [LOWTR,Y] POINTS BEYOND THE SIZE TO THE NUMBER OF
 4006                     ; DIMENSIONS. STRATEGY:
 4007                     ;	NUMDIM=NUMBER OF DIMENSIONS.
 4008                     ;	CURTOL=0.
 4009                     ; INLPNM:GET A NEW INDICE.
 4010                     ;	MAKE SURE INDICE IS NOT TOO BIG.
 4011                     ;	MULTIPLY CURTOL BY CURMAX.
 4012                     ;	ADD INDICE TO CURTOL.
 4013                     ;	NUMDIM=NUMDIM-1.
 4014                     ;	BNE	INLPNM.
