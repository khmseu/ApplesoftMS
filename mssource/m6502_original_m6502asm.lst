 6411                     	;SINE FUNCTION.
 6412                     	;USE IDENTITIES TO GET FAC IN QUADRANTS I OR IV.
 6413                     	;THE FAC IS DIVIDED BY 2*PI AND THE INTEGER PART IS IGNORED
 6414                     	;BECAUSE SIN(X+2*PI)=SIN(X). THEN THE ARGUMENT CAN BE COMPARED
 6415                     	;WITH PI/2 BY COMPARING THE RESULT OF THE DIVISION
 6416                     	;WITH PI/2/(2*PI)=1/4.
 6417                     	;IDENTITIES ARE THEN USED TO GET THE RESULT IN QUADRANTS
 6418                     	;I OR IV. AN APPROXIMATION POLYNOMIAL IS THEN USED TO
 6419                     	;COMPUTE SIN(X).
 6420  EE6B  20 DD E9     SIN:	JSR	MOVAF
 6421  EE6E  A9 E5 A0 EE  	LDWDI	TWOPI		;GET PNTR TO DIVISOR.
 6422  EE72  A6 AD        	LDX	ARGSGN		;GET SIGN OF RESULT.
 6423  EE74  20 D8 E8     	JSR	FDIVF
 6424  EE77  20 DD E9     	JSR	MOVAF		;GET RESULT INTO ARG.
 6425  EE7A  20 9D EA     	JSR	INT		;INTEGERIZE FAC.
 6426  EE7D  A9 00 85 AE  	CLR	ARISGN		;ALWAYS HAVE THE SAME SIGN.
 6427  EE81  20 24 E6     	JSR	FSUBT		;KEEP ONLY THE FRACTIONAL PART.
 6428  EE84  A9 EA A0 EE  	LDWDI	FR4		;GET PNTR TO 1/4.
 6429  EE88  20 21 E6     	JSR	FSUB		;COMPUTE 1/4-FAC.
 6430  EE8B  A5 A5        	LDA	FACSGN		;SAVE SIGN FOR LATER.
 6431  EE8D  48           	PHA
 6432  EE8E  10 0D        	BPL	SIN1		;FIRST QUADRANT.
 6433  EE90  20 1A E6     	JSR	FADDH		;ADD 1/2 TO FAC.
 6434  EE93  A5 A5        	LDA	FACSGN		;SIGN IS NEGATIVE?
 6435  EE95  30 09        	BMI	SIN2
 6436  EE97  A5 16 49 FF  	COM	TANSGN		;QUADRANTS II AND III COME HERE.
       EE9B  85 16
 6437  EE9D  20 4A ED     SIN1:	JSR	NEGOP		;IF POSITIVE, NEGATE IT.
 6438  EEA0  A9 EA A0 EE  SIN2:	LDWDI	FR4		;POINTER TO 1/4.
 6439  EEA4  20 38 E6     	JSR	FADD		;ADD IT IN.
 6440  EEA7  68           	PLA			;GET ORIGINAL QUADRANT.
 6441  EEA8  10 03        	BPL	SIN3
 6442  EEAA  20 4A ED     	JSR	NEGOP		;IF NEGATIVE, NEGATE RESULT.
 6443  EEAD  A9 EF A0 EE  SIN3:	LDWDI	SINCON
