 1673                     ;
 1674                     ; THIS IS THE LINE INPUT ROUTINE.
 1675                     ; IT READS CHARACTERS INTO BUF USING BACKARROW (UNDERSCORE, OR
 1676                     ; SHIFT O) AS THE DELETE CHARACTER AND @ AS THE
 1677                     ; LINE DELETE CHARACTER. IF MORE THAN BUFLEN CHARACTERS
 1678                     ; ARE TYPED, NO ECHOING IS DONE UNTIL A BACKARROW OR @ OR CR
 1679                     ; IS TYPED. CONTROL-G WILL BE TYPED FOR EACH EXTRA CHARACTER.
 1680                     ; THE ROUTINE IS ENTERED AT INLIN.
 1681                     ;
 1682                     IFE	REALIO-4,<
 1683  D41E  A2 80        INLIN:	LDXI	128		;NO PROMPT CHARACTER
 1684  D420  86 33        	STX	CQPRMP
 1685  D422  20 67 FD     	JSR	CQINLN		;GET A LINE ONTO PAGE 2
 1686  D425  E0 EF        	CPXI	BUFLEN-1
 1687  D427  B0 02        	BCS	GDBUFS		;NOT TOO MANY CHARACTERS
 1688  D429  A2 EF        	LDXI	BUFLEN-1
 1689  D42B  A9 00        GDBUFS: LDAI	0		;PUT A ZERO AT THE END
 1690  D42D  9D 00 02     	STA	BUF,X
 1691  D430  8A           	TXA
