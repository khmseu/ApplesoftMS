 3094                     SUBTTL	THE NEXT CODE IS THE "NEXT CODE"
 3095                     ;
 3096                     ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 3097                     ;
 3098                     ; LOW ADDRESS
 3099                     ;	TOKEN (FORTK) 1 BYTE
 3100                     ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
 3101                     ;	THE STEP 4+ADDPRC BYTES
 3102                     ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 3103                     ;	THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
 3104                     ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 3105                     ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 3106                     ; HIGH ADDRESS
 3107                     ;
 3108                     ; TOTAL 16+2*ADDPRC BYTES.
 3109                     ;
 3110  12B7  D0 04        NEXT:	BNE	GETFOR
 3111  12B9  A0 00        	LDYI	0		;WITHOUT ARG CALL "FNDFOR" WITH
 3112  12BB  F0 03        	BEQA	STXFOR		;[FORPNT]=0.
 3113  12BD  20 9B 15     GETFOR: JSR	PTRGET		;GET A POINTER TO LOOP VARIABLE
 3114  12C0  85 88 84 89  STXFOR: STWD	FORPNT		;INTO "FORPNT".
 3115  12C4  20 96 09     	JSR	FNDFOR		;FIND THE MATCHING ENTRY IF ANY.
 3116  12C7  F0 04        	BEQ	HAVFOR
 3117  12C9  A2 00        	LDXI	ERRNF		;"NEXT WITHOUT FOR".
 3118  12CB  F0 66        ERRGO5: BEQ	ERRGO4
 3119  12CD  9A           HAVFOR: TXS			;SETUP STACK. CHOP FIRST.
 3120  12CE  8A           	TXA
 3121  12CF  18           	CLC
 3122  12D0  69 04        	ADCI	4		;POINT TO INCREMENT
 3123  12D2  48           	PHA			;SAVE THIS POINTER TO RESTORE TO [A]
 3124  12D3  69 06        	ADCI	5+ADDPRC	;POINT TO UPPER LIMIT
 3125  12D5  85 63        	STA	INDEX2		;SAVE AS INDEX
 3126  12D7  68           	PLA			;RESTORE POINTER TO INCREMENT
 3127  12D8  A0 01        	LDYI	1		;SET HI ADDR OF THING TO MOVE.
 3128  12DA  20 98 20     	JSR	MOVFM		;GET QUANTITY INTO THE FAC.
 3129  12DD  BA           	TSX
 3130  12DE  BD 09 01     	LDA	257+7+ADDPRC,X, ;SET SIGN CORRECTLY.
 3131  12E1  85 A5        	STA	FACSGN
 3132  12E3  A5 88 A4 89  	LDWD	FORPNT
 3133  12E7  20 5D 1D     	JSR	FADD		;ADD INC TO LOOP VARIABLE.
 3134  12EA  20 C6 20     	JSR	MOVVF		;PACK THE FAC INTO MEMORY.
 3135  12ED  A0 01        	LDYI	1
 3136  12EF  20 53 21     	JSR	FCOMPN		;COMPARE FAC WITH UPPER VALUE.
 3137  12F2  BA           	TSX
 3138  12F3  38           	SEC
 3139  12F4  FD 09 01     	SBC	257+7+ADDPRC,X, ;SUBTRACT SIGN OF INC FROM SIGN OF
 3140                     				;OF (CURRENT VALUE-FINAL VALUE).
 3141  12F7  F0 17        	BEQ	LOOPDN		;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
 3142                     				;THEN LOOP IS DONE.
 3143  12F9  BD 0F 01     	LDA	2*ADDPRC+12+257,X
 3144  12FC  85 78        	STA	CURLIN		;STORE LINE NUMBER OF "FOR" STATEMENT.
 3145  12FE  BD 10 01     	LDA	257+13+<2*ADDPRC>,X
 3146  1301  85 79        	STA	CURLIN+1
 3147  1303  BD 12 01     	LDA	2*ADDPRC+15+257,X
 3148  1306  85 B9        	STA	TXTPTR		;STORE TEXT PNTR INTO "FOR" STATEMENT.
 3149  1308  BD 11 01     	LDA	2*ADDPRC+14+257,X
 3150  130B  85 BA        	STA	TXTPTR+1
 3151  130D  4C 95 0D     NEWSGO: JMP	NEWSTT		;PROCESS NEXT STATEMENT.
 3152  1310  8A           LOOPDN: TXA
 3153  1311  69 11        	ADCI	2*ADDPRC+15		;ADDS 16 WITH CARRY.
 3154  1313  AA           	TAX
 3155  1314  9A           	TXS			;NEW STACK PNTR.
 3156  1315  20 B8 00     	JSR	CHRGOT
 3157  1318  C9 2C        	CMPI	44		;COMMA AT END?
 3158  131A  D0 F1        	BNE	NEWSGO
 3159  131C  20 B2 00     	JSR	CHRGET
 3160  131F  20 BD 12     	JSR	GETFOR		;DO NEXT BUT DON'T ALLOW BLANK VARIABLE
 3161                     				;PNTR. [VARPNT] IS THE STK PNTR WHICH
 3162                     				;NEVER MATCHES ANY POINTER.
