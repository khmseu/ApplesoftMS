 2415                     ;
 2416                     ; "RETURN" RESTORES THE LINE NUMBER AND TEXT PNTR FROM THE STACK
 2417                     ; AND ELIMINATES ALL THE "FOR" ENTRIES IN FRONT OF THE "GOSUB" ENTRY.
 2418                     ;
 2419  D7F5  D0 FD        RETURN: BNE	GORTS		;NO TERMINATOR=BLOW HIM UP.
 2420  D7F7  A9 FF        	LDAI	255
