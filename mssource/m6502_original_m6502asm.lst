 3072  1277  4C ED 11     	JMP	DATBK1		;THIS IS THE ONE !
 3073  127A  A5 82 A4 83  VAREND: LDWD	INPPTR		;PUT AWAY A NEW DATA PNTR MAYBE.
 3074  127E  A6 15        	LDX	INPFLG
 3075  1280  10 03        	BPL	VARY0
 3076  1282  4C 0A 0E     	JMP	RESFIN
