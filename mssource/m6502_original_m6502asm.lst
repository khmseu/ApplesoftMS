 2064                     PAGE
 2065                     SUBTTL THE "FOR" STATEMENT.
 2066                     ;
 2067                     ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 2068                     ;
 2069                     ; LOW ADDRESS
 2070                     ;	TOKEN (FORTK) 1 BYTE
 2071                     ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
 2072                     ;	THE STEP 4+ADDPRC BYTES
 2073                     ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 2074                     ;	THE UPPER VALUE 4+ADDPRC BYTES
 2075                     ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 2076                     ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 2077                     ; HIGH ADDRESS
 2078                     ;
 2079                     ; TOTAL 16+2*ADDPRC BYTES.
 2080                     ;
 2082  D5F8  A9 80        FOR:	LDAI	128		;DON'T RECOGNIZE
 2083  D5FA  85 14        	STA	SUBFLG		;SUBSCRIPTED VARIABLES.
 2084  D5FC  20 BC D8     	JSR	LET		;READ THE VARIABLE AND ASSIGN IT
 2085                     				;THE CORRECT INITIAL VALUE AND STORE
 2086                     				;A POINTER TO THE VARIABLE IN VARPNT.
 2087  D5FF  20 64 D2     	JSR	FNDFOR		;PNTR IS IN VARPNT, AND FORPNT.
 2088  D602  D0 05        	BNE	NOTOL		;IF NO MATCH, DON'T ELIMINATE ANYTHING.
 2089  D604  8A           	TXA			;MAKE IT ARITHMETICAL.
 2090  D605  69 0F        	ADCI	FORSIZ-3	;ELIMINATE ALMOST ALL.
 2091  D607  AA           	TAX			;NOTE C=1, THEN PLA, PLA.
 2092  D608  9A           	TXS			;MANIFEST.
 2093  D609  68           NOTOL:	PLA			;GET RID OF NEWSTT RETURN ADDRESS
 2094  D60A  68           	PLA			;IN CASE THIS IS A TOTALLY NEW ENTRY.
 2095  D60B  A9 09        	LDAI	8+ADDPRC
 2096  D60D  20 D5 D2     	JSR	GETSTK		;MAKE SURE 16 BYTES ARE AVAILABLE.
 2097  D610  20 1D D8     	JSR	DATAN		;GET A COUNT IN [Y] OF THE NUMBER OF
 2098                     				;CHACRACTERS LEFT IN THE "FOR" STATEMENT
 2099                     				;[TXTPTR] IS UNAFFECTED.
 2100  D613  18           	CLC			;PREP TO ADD.
 2101  D614  98           	TYA			;SAVE IT FOR PUSHING.
