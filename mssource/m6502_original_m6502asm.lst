 3035  DB03  F0 03 4C 0E  	JNE	TRMNOK
       DB07  DA
 3036  DB08  A5 B9 A4 BA  TRMOK:	LDWD	TXTPTR
 3037  DB0C  85 82 84 83  	STWD	INPPTR		;SAVE FOR MORE READS.
 3038  DB10  A5 8A A4 8B  	LDWD	VARTXT
 3039  DB14  85 B9 84 BA  	STWD	TXTPTR		;POINT TO VARIABLE LIST.
 3040  DB18  20 B8 00     	JSR	CHRGOT		;LOOK AT LAST VARIABLE LIST CHARACTER.
 3041  DB1B  F0 2C        	BEQ	VAREND		;THAT'S THE END OF THE LIST.
 3042  DB1D  20 4B DD     	JSR	CHKCOM		;NOT END. CHECK FOR COMMA.
 3043  DB20  4C 82 DA     	JMP	INLOOP
 3044                     ;
 3045                     ; SUBROUTINE TO FIND DATA
 3046                     ; THE SEARCH IS MADE BY USING THE EXECUTION CODE FOR DATA TO
 3047                     ; SKIP OVER STATEMENTS. THE START WORD OF EACH STATEMENT
 3048                     ; IS COMPARED WITH "DATATK". EACH NEW LINE NUMBER
 3049                     ; IS STORED IN "DATLIN" SO THAT IF AN ERROR OCCURS
 3050                     ; WHILE READING DATA THE ERROR MESSAGE CAN GIVE THE LINE
 3051                     ; NUMBER OF THE ILL-FORMATTED DATA.
 3052                     ;
 3053  DB23  20 1D D8     DATLOP: JSR	DATAN		;SKIP SOME TEXT.
 3054  DB26  C8           	INY
 3055  DB27  AA           	TAX			;END OF LINE?
 3056  DB28  D0 12        	BNE	NOWLIN		;SHO AIN'T.
 3057  DB2A  A2 2A        	LDXI	ERROD		;YES = "NO DATA" ERROR.
 3058  DB2C  C8           	INY
 3059  DB2D  B1 B9        	LDADY	TXTPTR
 3060  DB2F  F0 69        	BEQ	ERRGO5
 3061  DB31  C8           	INY
 3062  DB32  B1 B9        	LDADY	TXTPTR		;GET HIGH BYTE OF LINE NUMBER.
 3063  DB34  85 7E        	STA	DATLIN
 3064  DB36  C8           	INY
 3065  DB37  B1 B9        	LDADY	TXTPTR		;GET LOW BYTE.
 3066  DB39  C8           	INY
 3067  DB3A  85 7F        	STA	DATLIN+1
 3068  DB3C  B1 B9        NOWLIN: LDADY	TXTPTR		;HOW IS IT?
 3069  DB3E  AA           	TAX
 3070  DB3F  20 12 D8     	JSR	ADDON		;ADD [Y] TO [TXTPTR].
 3071  DB42  E0 83        	CPXI	DATATK		;IS IT A "DATA" STATEMENT.
 3072  DB44  D0 DD        	BNE	DATLOP		;NOT QUITE RIGHT. KEEP LOOKING.
 3073  DB46  4C BC DA     	JMP	DATBK1		;THIS IS THE ONE !
 3074  DB49  A5 82 A4 83  VAREND: LDWD	INPPTR		;PUT AWAY A NEW DATA PNTR MAYBE.
 3075  DB4D  A6 15        	LDX	INPFLG
 3076  DB4F  10 03        	BPL	VARY0
 3077  DB51  4C D9 D6     	JMP	RESFIN
 3078  DB54  A0 00        VARY0:	LDYI	0
 3079  DB56  B1 82        	LDADY	INPPTR		;LAST DATA CHR COULD HAVE BEEN
 3080                     				;COMMA OR COLON BUT SHOULD BE NULL.
 3081  DB58  F0 07        	BEQ	INPRTS		;IT IS NULL.
 3082                     IFN	EXTIO,<
                          	LDA	CHANNL		;IF NOT TERMINAL, NO TYPE.
                          	BNE	INPRTS>
 3085  DB5A  A9 62 A0 DB  	LDWDI	EXIGNT
 3086  DB5E  4C CD D9     	JMP	STROUT		;TYPE "?EXTRA IGNORED"
 3087  DB61  60           INPRTS: RTS			;DO NEXT STATEMENT.
 3088  DB62  3F 45 58 54  EXIGNT: DT"?EXTRA IGNORED"
       DB66  52 41 20 49
       DB6A  47 4E 4F 52
       DB6E  45 44
 3089  DB70  0D 0A        	ACRLF
 3090  DB72  00           	0
 3091  DB73  3F 52 45 44  TRYAGN: DT"?REDO FROM START"
       DB77  4F 20 46 52
       DB7B  4F 4D 20 53
       DB7F  54 41 52 54
 3092  DB83  0D 0A        	ACRLF
 3093  DB85  00           	0
 3094                     PAGE
 3095                     SUBTTL	THE NEXT CODE IS THE "NEXT CODE"
 3096                     ;
 3097                     ; A "FOR" ENTRY ON THE STACK HAS THE FOLLOWING FORMAT:
 3098                     ;
 3099                     ; LOW ADDRESS
 3100                     ;	TOKEN (FORTK) 1 BYTE
 3101                     ;	A POINTER TO THE LOOP VARIABLE 2 BYTES
 3102                     ;	THE STEP 4+ADDPRC BYTES
 3103                     ;	A BYTE REFLECTING THE SIGN OF THE INCREMENT 1 BYTE
 3104                     ;	THE UPPER VALUE (PACKED) 4+ADDPRC BYTES
 3105                     ;	THE LINE NUMBER OF THE "FOR" STATEMENT 2 BYTES
 3106                     ;	A TEXT POINTER INTO THE "FOR" STATEMENT 2 BYTES
 3107                     ; HIGH ADDRESS
 3108                     ;
 3109                     ; TOTAL 16+2*ADDPRC BYTES.
 3110                     ;
 3111  DB86  D0 04        NEXT:	BNE	GETFOR
 3112  DB88  A0 00        	LDYI	0		;WITHOUT ARG CALL "FNDFOR" WITH
 3113  DB8A  F0 03        	BEQA	STXFOR		;[FORPNT]=0.
 3114  DB8C  20 6A DE     GETFOR: JSR	PTRGET		;GET A POINTER TO LOOP VARIABLE
 3115  DB8F  85 88 84 89  STXFOR: STWD	FORPNT		;INTO "FORPNT".
 3116  DB93  20 64 D2     	JSR	FNDFOR		;FIND THE MATCHING ENTRY IF ANY.
 3117  DB96  F0 04        	BEQ	HAVFOR
 3118  DB98  A2 00        	LDXI	ERRNF		;"NEXT WITHOUT FOR".
 3119  DB9A  F0 66        ERRGO5: BEQ	ERRGO4
 3120  DB9C  9A           HAVFOR: TXS			;SETUP STACK. CHOP FIRST.
 3121  DB9D  8A           	TXA
 3122  DB9E  18           	CLC
 3123  DB9F  69 04        	ADCI	4		;POINT TO INCREMENT
 3124  DBA1  48           	PHA			;SAVE THIS POINTER TO RESTORE TO [A]
 3125  DBA2  69 06        	ADCI	5+ADDPRC	;POINT TO UPPER LIMIT
 3126  DBA4  85 63        	STA	INDEX2		;SAVE AS INDEX
 3127  DBA6  68           	PLA			;RESTORE POINTER TO INCREMENT
 3128  DBA7  A0 01        	LDYI	1		;SET HI ADDR OF THING TO MOVE.
 3129  DBA9  20 67 E9     	JSR	MOVFM		;GET QUANTITY INTO THE FAC.
 3130  DBAC  BA           	TSX
 3131  DBAD  BD 09 01     	LDA	257+7+ADDPRC,X, ;SET SIGN CORRECTLY.
 3132  DBB0  85 A5        	STA	FACSGN
 3133  DBB2  A5 88 A4 89  	LDWD	FORPNT
 3134  DBB6  20 2C E6     	JSR	FADD		;ADD INC TO LOOP VARIABLE.
 3135  DBB9  20 95 E9     	JSR	MOVVF		;PACK THE FAC INTO MEMORY.
 3136  DBBC  A0 01        	LDYI	1
 3137  DBBE  20 22 EA     	JSR	FCOMPN		;COMPARE FAC WITH UPPER VALUE.
 3138  DBC1  BA           	TSX
 3139  DBC2  38           	SEC
 3140  DBC3  FD 09 01     	SBC	257+7+ADDPRC,X, ;SUBTRACT SIGN OF INC FROM SIGN OF
 3141                     				;OF (CURRENT VALUE-FINAL VALUE).
 3142  DBC6  F0 17        	BEQ	LOOPDN		;IF SIGN (FINAL-CURRENT)-SIGN STEP=0
 3143                     				;THEN LOOP IS DONE.
 3144  DBC8  BD 0F 01     	LDA	2*ADDPRC+12+257,X
 3145  DBCB  85 78        	STA	CURLIN		;STORE LINE NUMBER OF "FOR" STATEMENT.
 3146  DBCD  BD 10 01     	LDA	257+13+<2*ADDPRC>,X
 3147  DBD0  85 79        	STA	CURLIN+1
 3148  DBD2  BD 12 01     	LDA	2*ADDPRC+15+257,X
 3149  DBD5  85 B9        	STA	TXTPTR		;STORE TEXT PNTR INTO "FOR" STATEMENT.
 3150  DBD7  BD 11 01     	LDA	2*ADDPRC+14+257,X
 3151  DBDA  85 BA        	STA	TXTPTR+1
 3152  DBDC  4C 64 D6     NEWSGO: JMP	NEWSTT		;PROCESS NEXT STATEMENT.
 3153  DBDF  8A           LOOPDN: TXA
 3154  DBE0  69 11        	ADCI	2*ADDPRC+15		;ADDS 16 WITH CARRY.
 3155  DBE2  AA           	TAX
 3156  DBE3  9A           	TXS			;NEW STACK PNTR.
 3157  DBE4  20 B8 00     	JSR	CHRGOT
 3158  DBE7  C9 2C        	CMPI	44		;COMMA AT END?
 3159  DBE9  D0 F1        	BNE	NEWSGO
 3160  DBEB  20 B2 00     	JSR	CHRGET
 3161  DBEE  20 8C DB     	JSR	GETFOR		;DO NEXT BUT DON'T ALLOW BLANK VARIABLE
 3162                     				;PNTR. [VARPNT] IS THE STK PNTR WHICH
 3163                     				;NEVER MATCHES ANY POINTER.
 3164                     				;JSR TO PUT ON DUMMY NEWSTT ADDR.
 3165                     SUBTTL FORMULA EVALUATION CODE.
 3166                     ;
 3167                     ; THESE ROUTINES CHECK FOR CERTAIN "VALTYP".
 3168                     ; [C] IS NOT PRESERVED.
 3169                     ;
 3170  DBF1  20 05 DC     FRMNUM: JSR	FRMEVL
 3171  DBF4  18           CHKNUM: CLC
 3172  DBF5  24           	SKIP1
 3173  DBF6  38           CHKSTR: SEC			;SET CARRY.
 3174  DBF7  24 11        CHKVAL: BIT	VALTYP		;WILL NOT F UP "VALTYP".
 3175  DBF9  30 03        	BMI	DOCSTR
 3176  DBFB  B0 03        	BCS	CHKERR
 3177  DBFD  60           CHKOK:	RTS
 3178  DBFE  B0 FD        DOCSTR: BCS	CHKOK
 3179  DC00  A2 A3        CHKERR: LDXI	ERRTM
 3180  DC02  4C 11 D3     ERRGO4: JMP	ERROR
 3181                     ;
 3182                     ; THE FORMULA EVALUATOR STARTS WITH
 3183                     ; [TXTPTR] POINTING TO THE FIRST CHARACTER OF THE FORMULA.
 3184                     ; AT THE END [TXTPTR] POINTS TO THE TERMINATOR.
 3185                     ; THE RESULT IS LEFT IN THE FAC.
 3186                     ; ON RETURN [A] DOES NOT REFLECT THE TERMINATOR.
 3187                     ;
 3188                     ; THE FORMULA EVALUATOR USES THE OPERATOR LIST (OPTAB)
 3189                     ; TO DETERMINE PRECEDENCE AND DISPATCH ADDRESSES FOR
 3190                     ; EACH OPERATOR.
 3191                     ; A TEMPORARY RESULT ON THE STACK HAS THE FOLLOWING FORMAT.
 3192                     ;	THE ADDRESS OF THE OPERATOR ROUTINE.
 3193                     ;	THE FLOATING POINT TEMPORARY RESULT.
 3194                     ;	THE PRECEDENCE OF THE OPERATOR.
 3195                     ;
 3196  DC05  A6 B9        FRMEVL: LDX	TXTPTR
 3197  DC07  D0 02        	BNE	FRMEV1
 3198  DC09  C6 BA        	DEC	TXTPTR+1
 3199  DC0B  C6 B9        FRMEV1: DEC	TXTPTR
 3200  DC0D  A2 00        	LDXI	0		;INITIAL DUMMY PRECEDENCE IS 0.
 3201  DC0F  24           	SKIP1
 3202  DC10  48           LPOPER: PHA			;SAVE LOW PRECEDENCE. (MASK.)
 3203  DC11  8A           	TXA
 3204  DC12  48           	PHA			;SAVE HIGH PRECEDENCE.
 3205  DC13  A9 01        	LDAI	1
 3206  DC15  20 D5 D2     	JSR	GETSTK		;MAKE SURE THERE IS ROOM FOR
 3207                     				;RECURSIVE CALLS.
 3208  DC18  20 EA DC     	JSR	EVAL		;EVALUATE SOMETHING.
 3209  DC1B  A9 00 85 8C  	CLR	OPMASK		;PREPARE TO BUILD MASK MAYBE.
 3210  DC1F  20 B8 00     TSTOP:	JSR	CHRGOT		;REGET LAST CHARACTER.
 3211  DC22  38           LOPREL: SEC			;PREP TO SUBTRACT.
 3212  DC23  E9 A8        	SBCI	GREATK		;IS CURRENT CHARACTER A RELATION?
 3213  DC25  90 17        	BCC	ENDREL		;NO. RELATIONS ALL THROUGH.
 3214  DC27  C9 03        	CMPI	LESSTK-GREATK+1 ;REALLY RELATIONAL?
 3215  DC29  B0 13        	BCS	ENDREL		;NO -- JUST BIG.
 3216  DC2B  C9 01        	CMPI	1		;RESET CARRY FOR ZERO ONLY.
 3217  DC2D  2A           	ROL	A,		;0 TO 1, 1 TO 2, 2 TO 4.
 3218  DC2E  49 01        	EORI	1
 3219  DC30  45 8C        	EOR	OPMASK		;BRING IN THE OLD BITS.
 3220  DC32  C5 8C        	CMP	OPMASK		;MAKE SURE THE NEW MASK IS BIGGER.
 3221  DC34  90 61        	BCC	SNERR5		;SYNTAX ERROR. BECAUSE TWO OF THE SAME.
 3222  DC36  85 8C        	STA	OPMASK		;SAVE MASK.
 3223  DC38  20 B2 00     	JSR	CHRGET
 3224  DC3B  4C 22 DC     	JMP	LOPREL		;GET THE NEXT CANDIDATE.
 3225  DC3E  A6 8C        ENDREL: LDX	OPMASK		;WERE THERE ANY?
 3226  DC40  D0 2C        	BNE	FINREL		;YES, HANDLE AS SPECIAL OP.
 3227  DC42  B0 7B        	BCS	QOP		;NOT AN OPERATOR.
 3228  DC44  69 07        	ADCI	GREATK-PLUSTK
 3229  DC46  90 77        	BCC	QOP		;NOT AN OPERATOR.
 3230  DC48  65 11        	ADC	VALTYP		;[C]=1.
 3231  DC4A  D0 03 4C 01  	JEQ	CAT		;ONLY IF [A]=0 AND [VALTYP]=-1 (A STR).
       DC4E  E4
 3232  DC4F  69 FF        	ADCI	^O377		;GET BACK ORIGINAL [A].
 3233  DC51  85 61        	STA	INDEX1
 3234  DC53  0A           	ASL	A,		;MULTIPLY BY 2.
 3235  DC54  65 61        	ADC	INDEX1		;BY THREE.
 3236  DC56  A8           	TAY			;SET UP FOR LATER.
 3237  DC57  68           QPREC:	PLA			;GET PREVIOUS PRECEDENCE.
 3238  DC58  D9 62 D0     	CMP	OPTAB,Y		;IS OLD PRECEDENCE GREATER OR EQUAL?
 3239  DC5B  B0 67        	BCS	QCHNUM		;YES, GO OPERATE.
 3240  DC5D  20 F4 DB     	JSR	CHKNUM		;CAN'T BE STRING HERE.
 3241  DC60  48           DOPREC: PHA			;SAVE OLD PRECEDENCE.
 3242  DC61  20 87 DC     NEGPRC: JSR	DOPRE1		;SET A RETURN ADDRESS FOR OP.
 3243  DC64  68           	PLA			;PULL OFF PREVIOUS PRECEDENCE.
 3244  DC65  A4 8A        	LDY	OPPTR		;GET POINTER TO OP.
 3245  DC67  10 17        	BPL	QPREC1		;THAT'S A REAL OPERATOR.
 3246  DC69  AA           	TAX			;DONE ?
 3247  DC6A  F0 56        	BEQ	QOPGO		;DONE !
 3248  DC6C  D0 5F        	BNE	PULSTK
 3249  DC6E  46 11        FINREL: LSR	VALTYP		;GET VALUE TYPE INTO "C".
 3250  DC70  8A           	TXA
 3251  DC71  2A           	ROL	A,		;PUT VALTYP INTO LOW ORDER BIT OF MASK.
 3252  DC72  A6 B9        	LDX	TXTPTR		;DECREMENT TEXT POINTER.
 3253  DC74  D0 02        	BNE	FINRE2
 3254  DC76  C6 BA        	DEC	TXTPTR+1
 3255  DC78  C6 B9        FINRE2: DEC	TXTPTR
 3256  DC7A  A0 1B        	LDYI	PTDORL-OPTAB	;MAKE [YREG] POINT AT OPERATOR ENTRY.
 3257  DC7C  85 8C        	STA	OPMASK		;SAVE THE OPERATION MASK.
 3258  DC7E  D0 D7        	BNE	QPREC		;SAVE IT ALL. BR ALWAYS.
 3259                     				;NOTE B7(VALTYP)=0 SO CHKNUM CALL IS OK.
 3260  DC80  D9 62 D0     QPREC1: CMP	OPTAB,Y		;LAST PRECEDENCE IS GREATER?
 3261  DC83  B0 48        	BCS	PULSTK		;YES, GO OPERATE.
 3262  DC85  90 D9        	BCC	DOPREC		;NO SAVE ARGUMENT AND GET OTHER OPERAND.
 3263  DC87  B9 64 D0     DOPRE1: LDA	OPTAB+2,Y
 3264  DC8A  48           	PHA			;DISP ADDR GOES ONTO STACK.
 3265  DC8B  B9 63 D0     	LDA	OPTAB+1,Y
 3266  DC8E  48           	PHA
 3267  DC8F  20 9A DC     	JSR	PUSHF1		;SAVE FAC ON STACK UNPACKED.
 3268  DC92  A5 8C        	LDA	OPMASK		;[ACCA] MAY BE MASK FOR REL.
 3269  DC94  4C 10 DC     	JMP	LPOPER
 3270  DC97  4C 56 DD     SNERR5: JMP	SNERR		;GO TO AN ERROR.
 3271  DC9A  A5 A5        PUSHF1: LDA	FACSGN
 3272  DC9C  BE 62 D0     	LDX	OPTAB,Y,	;GET HIGH PRECEDENCE.
 3273  DC9F  A8           PUSHF:	TAY			;GET POINTER INTO STACK.
 3274  DCA0  68           	PLA
 3275  DCA1  85 61        	STA	INDEX1
 3276  DCA3  E6 61        	INC	INDEX1
 3277  DCA5  68           	PLA
 3278  DCA6  85 62        	STA	INDEX1+1
 3279  DCA8  98           	TYA
 3280                     				;STORE FAC ON STACK UNPACKED.
 3281  DCA9  48           	PHA			;START WITH SIGN SET UP.
 3282  DCAA  20 E0 E9     FORPSH: JSR	ROUND		;PUT ROUNDED FAC ON STACK.
