 2984                     IFE	REALIO-4,<
 2985  DAB1  29 7F        	ANDI	127
 2986  DAB3  8D 00 02     	STA	BUF		;MAKE IT FIRST CHARACTER.
 2987  DAB6  A2 FF A0 01  	LDXYI	<BUF-1>		;POINT JUST BEFORE IT.
 2988                     IFE	BUFPAG,<
                          	BEQA	DATBK>
 2990                     IFN	BUFPAG,<
 2991  DABA  D0 08        	BNEA	DATBK
 2992  DABC  30 71        QDATA:	BMI	DATLOP		;SEARCH FOR ANOTHER DATA STATEMENT.
 2993                     IFN	EXTIO,<
                          	LDA	CHANNL
                          	BNE	GETNTH>
 2996  DABE  20 F9 D9     	JSR	OUTQST
 2997  DAC1  20 76 DA     GETNTH: JSR	QINLIN		;GET ANOTHER LINE.
 2998  DAC4  86 B9 84 BA  DATBK:	STXY	TXTPTR		;SET FOR "CHRGET".
 2999  DAC8  20 B2 00     DATBK1: JSR	CHRGET
 3000  DACB  24 11        	BIT	VALTYP		;GET VALUE TYPE.
 3001  DACD  10 31        	BPL	NUMINS		;INPUT A NUMBER IF NUMERIC.
 3002                     IFN	GETCMD,<
 3003  DACF  24 15        	BIT	INPFLG		;GET?
 3004  DAD1  50 09        	BVC	SETQUT		;NO, GO SET QUOTE.
 3005  DAD3  E8           	INX
 3006  DAD4  86 B9        	STX	TXTPTR
 3007  DAD6  A9 00        	LDAI	0		;ZERO TERMINATORS.
 3008  DAD8  85 0D        	STA	CHARAC
 3009  DADA  F0 0C        	BEQA	RESETC
 3010  DADC  85 0D        SETQUT: STA	CHARAC		;ASSUME QUOTED STRING.
 3011  DADE  C9 22        	CMPI	34		;TERMINATORS OK?
 3012  DAE0  F0 07        	BEQ	NOWGET		;YES.
 3013  DAE2  A9 3A        	LDAI	":"		;SET TERMINATORS TO ":" AND
 3014  DAE4  85 0D        	STA	CHARAC
 3015  DAE6  A9 2C        	LDAI	44		;COMMA.
 3016  DAE8  18           RESETC: CLC
 3017  DAE9  85 0E        NOWGET: STA	ENDCHR
 3018  DAEB  A5 B9 A4 BA  	LDWD	TXTPTR
 3019  DAEF  69 00        	ADCI	0		;C IS SET PROPERLY ABOVE.
 3020  DAF1  90 01        	BCC	NOWGE1
 3021  DAF3  C8           	INY
 3022  DAF4  20 5D E2     NOWGE1: JSR	STRLT2		;MAKE A STRING DESCRIPTOR FOR THE VALUE
 3023                     				;AND COPY IF NECESSARY.
 3024  DAF7  20 B3 E5     	JSR	ST2TXT		;SET TEXT POINTER.
 3025  DAFA  20 FD D8     	JSR	INPCOM		;DO ASSIGNMENT.
 3026  DAFD  4C 08 DB     	JMP	STRDN2
 3027  DB00  20 C4 EA     NUMINS: JSR	FIN
 3028                     IFE	INTPRC,<
                          	JSR	MOVVF>
 3030                     IFN	INTPRC,<
 3031  DB03  A5 12        	LDA	INTFLG		;SET CODES ON FLAG.
 3032  DB05  20 E5 D8     	JSR	QINTGR
 3033  DB08  20 B8 00     STRDN2: JSR	CHRGOT		;READ LAST CHARACTER.
 3034  DB0B  F0 07        	BEQ	TRMOK		;":" OR EOL IS OK.
