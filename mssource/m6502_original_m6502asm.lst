 5736  EAF3  66 9F        FINEC1: ROR	EXPSGN		;TURN IT ON.
 5737  EAF5  20 B2 00     FINEC:	JSR	CHRGET		;GET ANOTHER.
 5738  EAF8  90 5C        FNEDG1: BCC	FINEDG		;IT IS A DIGIT.
 5739  EAFA  24 9F        FINEC2: BIT	EXPSGN
